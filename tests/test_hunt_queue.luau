return function(t)
	local test, shared = t.test, t.shared
	local HuntQueue = shared("HuntQueue")
	local QueueConfig = shared("QueueConfig")

	local function fresh()
		return HuntQueue.new({ Size = 4, Seconds = 20, StartWhenFull = true })
	end

	test("queue: config is sane", function()
		assert(QueueConfig.Size == 4 and QueueConfig.Seconds == 20)
		assert(QueueConfig.Bonus.Chance > 0 and QueueConfig.Bonus.Chance < 0.5)
		assert(QueueConfig.FriendLuck.PerFriend * QueueConfig.FriendLuck.MaxFriends <= 0.3 + 1e-9, "friend bonus at most +30%")
	end)

	test("queue: join starts a 20 s timer; later joiners share it", function()
		local s = fresh()
		local q = HuntQueue.join(s, "u:1", { 1 }, 100)
		assert(q and q.StartsAt == 120)
		local q2 = HuntQueue.join(s, "u:2", { 2 }, 110)
		assert(q2 == q, "same queue")
		assert(q.StartsAt == 120, "timer not reset by later joiners")
		assert(HuntQueue.count(q) == 2)
		local v = HuntQueue.view(s, q, 108)
		assert(v and v.Remaining == 12 and v.Count == 2 and v.Max == 4)
	end)

	test("queue: double join refused", function()
		local s = fresh()
		HuntQueue.join(s, "u:1", { 1 }, 0)
		local q, why = HuntQueue.join(s, "u:1", { 1 }, 1)
		assert(q == nil and why == "AlreadyQueued")
		local q2, why2 = HuntQueue.join(s, "p:x", { 5, 1 }, 1)
		assert(q2 == nil and why2 == "AlreadyQueued", "a party holding a queued player")
		assert(select(2, HuntQueue.join(s, "p:y", { 1, 2, 3, 4, 5 }, 1)) == "TooBig")
		assert(select(2, HuntQueue.join(s, "p:z", {}, 1)) == "Empty")
	end)

	test("queue: starts after 20 s with whoever is there", function()
		local s = fresh()
		HuntQueue.join(s, "u:1", { 1 }, 0)
		assert(#HuntQueue.popDue(s, 19.9) == 0)
		local due = HuntQueue.popDue(s, 20)
		assert(#due == 1 and HuntQueue.count(due[1]) == 1, "a single player still gets a hunt")
		assert(#s.Queues == 0)
	end)

	test("queue: 4 cap; full queue is due at once; the 5th starts the next queue", function()
		local s = fresh()
		for uid = 1, 4 do
			HuntQueue.join(s, "u:" .. uid, { uid }, uid)
		end
		local q5 = HuntQueue.join(s, "u:5", { 5 }, 6)
		assert(q5 and q5.StartsAt == 26, "fifth joiner opened a new queue with its own timer")
		assert(#s.Queues == 2)
		local due = HuntQueue.popDue(s, 6)
		assert(#due == 1 and HuntQueue.count(due[1]) == 4, "full queue goes now")
		assert(#s.Queues == 1 and s.Queues[1] == q5)
		local s2 = HuntQueue.new({ Size = 4, Seconds = 20, StartWhenFull = false })
		for uid = 1, 4 do
			HuntQueue.join(s2, "u:" .. uid, { uid }, 0)
		end
		assert(#HuntQueue.popDue(s2, 5) == 0, "waits for the timer when StartWhenFull is off")
	end)

	test("queue: a party joins together and never splits", function()
		local s = fresh()
		HuntQueue.join(s, "u:1", { 1 }, 0)
		HuntQueue.join(s, "u:2", { 2 }, 0)
		HuntQueue.join(s, "u:3", { 3 }, 0)
		local qp = HuntQueue.join(s, "p:A", { 10, 11 }, 1)
		assert(qp and qp ~= s.Queues[1], "party of 2 does not fit 3/4: next queue")
		assert(HuntQueue.count(s.Queues[1]) == 3 and HuntQueue.count(qp) == 2)
		local q4 = HuntQueue.join(s, "u:4", { 4 }, 2)
		assert(q4 == s.Queues[1], "a single fills the earlier queue")
		local qq, g = HuntQueue.find(s, 11)
		assert(qq == qp and g and g.Key == "p:A")
		local members = HuntQueue.leaveGroup(s, "p:A")
		assert(#members == 2 and #s.Queues == 1, "party cancelled together; empty queue dropped")
	end)

	test("queue: leaver mid-countdown", function()
		local s = fresh()
		local q = HuntQueue.join(s, "u:1", { 1 }, 0)
		HuntQueue.join(s, "u:2", { 2 }, 5)
		assert(HuntQueue.leave(s, 1) == q)
		assert(HuntQueue.count(q) == 1 and q.StartsAt == 20, "the others keep the timer")
		assert(HuntQueue.leave(s, 1) == nil, "leaving twice is a no-op")
		HuntQueue.leave(s, 2)
		assert(#s.Queues == 0, "empty queue dropped")
		local q2 = HuntQueue.join(s, "u:3", { 3 }, 30)
		assert(q2 and q2.StartsAt == 50, "fresh timer for the next joiner")
		-- a party member leaving keeps the rest of the party queued
		HuntQueue.join(s, "p:B", { 7, 8 }, 31)
		HuntQueue.leave(s, 7)
		local _, g = HuntQueue.find(s, 8)
		assert(g and #g.Members == 1)
	end)

	test("queue: leaving and rejoining keeps the running countdown", function()
		local s = fresh()
		local q = HuntQueue.join(s, "u:1", { 1 }, 100)
		assert(q and q.StartsAt == 120)
		HuntQueue.leave(s, 1)
		assert(#s.Queues == 0, "the queue emptied and was dropped")
		local q2 = HuntQueue.join(s, "u:1", { 1 }, 105)
		assert(q2 and q2.StartsAt == 120, "rejoin keeps the old start time, not 105 + 20")
		-- a cancelled party keeps it too
		HuntQueue.leaveGroup(s, "u:1")
		local q3 = HuntQueue.join(s, "u:1", { 1 }, 110)
		assert(q3 and q3.StartsAt == 120)
		-- never sooner than RejoinMinSeconds from now
		HuntQueue.leave(s, 1)
		local q4 = HuntQueue.join(s, "u:1", { 1 }, 119)
		assert(q4 and q4.StartsAt == 119 + HuntQueue.RejoinMinSeconds)
		-- after the old start time has passed, a rejoin gets a fresh timer
		HuntQueue.leave(s, 1)
		local q5 = HuntQueue.join(s, "u:1", { 1 }, 200)
		assert(q5 and q5.StartsAt == 220, "expired: fresh 20 s")
		-- a forgotten player (left the server) starts fresh
		HuntQueue.leave(s, 1)
		HuntQueue.forget(s, 1)
		local q6 = HuntQueue.join(s, "u:1", { 1 }, 201)
		assert(q6 and q6.StartsAt == 221)
	end)

	test("queue: a failed start is restored at the front", function()
		local s = fresh()
		HuntQueue.join(s, "u:1", { 1 }, 0)
		HuntQueue.join(s, "u:2", { 2 }, 0)
		local due = HuntQueue.popDue(s, 20)
		HuntQueue.join(s, "u:2", { 2 }, 21) -- player 2 re-queued meanwhile
		HuntQueue.restore(s, due[1], 25)
		assert(s.Queues[1] == due[1] and due[1].StartsAt == 25)
		local members = HuntQueue.members(due[1])
		assert(#members == 1 and members[1] == 1, "no duplicate of player 2")
	end)

	test("queue: common tier, bonus eligibility", function()
		local order = { "Gravel", "Quarry", "Cavern" }
		assert(HuntQueue.commonTier(order, { { Gravel = true, Quarry = true }, { Gravel = true, Quarry = true, Cavern = true } }) == "Quarry")
		assert(HuntQueue.commonTier(order, { { Gravel = true }, { Quarry = true } }) == "Gravel")
		assert(HuntQueue.commonTier(order, {}) == "Cavern")
		assert(HuntQueue.bonusEligible(5, false, false, 5))
		assert(not HuntQueue.bonusEligible(4, false, false, 5))
		assert(not HuntQueue.bonusEligible(9, true, false, 5), "finder never")
		assert(not HuntQueue.bonusEligible(9, false, true, 5), "practice never")
	end)
end
