local ServerScriptService = game:GetService("ServerScriptService")
local KeyedMutex = require(ServerScriptService.Server.Util.KeyedMutex)

describe("KeyedMutex (saves for one player never overlap)", function()
	it("a second job for the same player waits for the first to finish", function()
		local order = {}
		local mutex = KeyedMutex.new(function(s)
			task.wait(s / 100)
		end)
		local done = 0
		task.spawn(function()
			mutex:run("p1", function()
				table.insert(order, "autosave start")
				task.wait(0.05)
				table.insert(order, "autosave end")
			end)
			done += 1
		end)
		task.spawn(function()
			mutex:run("p1", function()
				table.insert(order, "leave save")
			end)
			done += 1
		end)
		while done < 2 do
			task.wait(0.01)
		end
		expect(order[1]).toBe("autosave start")
		expect(order[2]).toBe("autosave end")
		expect(order[3]).toBe("leave save")
	end)
	it("different players don't block each other", function()
		local mutex = KeyedMutex.new(function(s)
			task.wait(s / 100)
		end)
		local bRan = false
		task.spawn(function()
			mutex:run("a", function()
				task.wait(0.1)
			end)
		end)
		task.wait(0.01)
		expect(mutex:isBusy("a")).toBeTruthy()
		mutex:run("b", function()
			bRan = true
		end)
		expect(bRan).toBeTruthy()
		expect(mutex:isBusy("a")).toBeTruthy()
	end)
	it("an error inside still unlocks", function()
		local mutex = KeyedMutex.new(function() end)
		local ok = mutex:run("a", function()
			error("boom")
		end)
		expect(ok).toBeFalsy()
		expect(mutex:isBusy("a")).toBeFalsy()
	end)
end)
