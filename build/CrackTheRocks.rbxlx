      <Item class="ModuleScript" referent="166">
        <Properties>
          <string name="Name">PetFlair</string>
          <string name="Source"><![CDATA[--!strict
-- Pet flair rules (Find The Pet owner picks), pure: no Roblox services, unit-tested in tests/test_pet_flair.luau.
--   * rarity size and sparkle look (Config.Pets.RarityScale / Config.Pets.Sparkle)
--   * pet index: first-find coin reward, "all species found" and the Pet Master title (Config.PetIndex)
--   * rare hatch announcements: which rarities, the sanitised payload, a rate limiter (Config.RareHatch)
--   * the lobby name tag lines (best pet tower floor + title)

local Config = require(script.Parent.Config)
local SpeciesPool = require(script.Parent.SpeciesPool)
local TowerConfig = require(script.Parent.TowerConfig)

local PetFlair = {}

-- Size multiplier for a rarity (unknown rarity = 1).
function PetFlair.rarityScale(rarity: any): number
	local v = (Config.Pets.RarityScale :: any)[rarity]
	return if type(v) == "number" and v > 0 then v else 1
end

-- Evolve stage from a spec's Evolve field (0 = never evolved), and how much bigger it draws the pet.
function PetFlair.evolveStage(evolve: any): number
	local e = tonumber(evolve)
	if not e or e ~= e then
		return 0
	end
	return math.clamp(math.floor(e), 0, TowerConfig.Evolve.MaxStage)
end
function PetFlair.evolveScale(evolve: any): number
	return 1 + TowerConfig.Evolve.Scale * PetFlair.evolveStage(evolve)
end

-- Sparkle look for a rarity, or nil when this rarity does not sparkle or the viewer chose Low Effects.
function PetFlair.sparkle(rarity: any, lowEffects: boolean?): { Color: Color3, TimeScale: number }?
	if lowEffects then
		return nil
	end
	return (Config.Pets.Sparkle :: any)[rarity]
end

-- Every species id the game knows (sorted, so the order is stable).
function PetFlair.species(): { string }
	local list: { string } = {}
	for id, m in Config.Minerals :: { [string]: any } do
		if not m.TowerOnly and not m.Retired and SpeciesPool.released(id, os.time()) then -- tower-only, retired and unreleased weekly pets are not in the index
			table.insert(list, id)
		end
	end
	table.sort(list)
	return list
end

-- How many species of the current index (PetFlair.species: released hunt pets) this discovery index (species ->
-- count) has found at least once. Tower-only pets and weekly pets not released yet do not count, so the count can
-- never pass the total ("36/35") or give the title early.
function PetFlair.foundCount(index: any): number
	if type(index) ~= "table" then
		return 0
	end
	local n = 0
	for _, id in PetFlair.species() do
		local v = index[id]
		if type(v) == "number" and v > 0 then
			n += 1
		end
	end
	return n
end

function PetFlair.allFound(index: any): boolean
	local total = #PetFlair.species()
	return total > 0 and PetFlair.foundCount(index) >= total
end

-- The title a profile has earned ("" = none). `earned` is the saved Pet Master flag (profile PetMaster, set by
-- Profiles the first time allFound is true): a weekly pet released later never takes an earned title away.
function PetFlair.title(index: any, earned: boolean?): string
	return if earned == true or PetFlair.allFound(index) then Config.PetIndex.MasterTitle else ""
end

-- Coins for hatching `species`, read BEFORE the hatch is counted: the reward only when this known species is not in
-- the index yet. The caller counts the hatch in the same profile write, so a second call returns 0 (idempotent).
function PetFlair.firstFindReward(index: any, species: any): number
	if type(index) ~= "table" or type(species) ~= "string" or (Config.Minerals :: any)[species] == nil then
		return 0
	end
	local v = index[species]
	if type(v) == "number" and v > 0 then
		return 0
	end
	return Config.PetIndex.FirstFindCoins
end

function PetFlair.shouldAnnounce(rarity: any): boolean
	return (Config.Pets.AnnounceRarities :: any)[rarity] == true
end

export type Payload = { Name: string, Pet: string, Rarity: string }

local function clean(s: any, max: number): string?
	if type(s) ~= "string" then
		return nil
	end
	local t = string.gsub(s, "[%c]", "")
	t = string.match(t, "^%s*(.-)%s*$") or ""
	if t == "" then
		return nil
	end
	if #t > max then
		-- cut on a UTF-8 character boundary
		local cut = max
		while cut > 0 do
			local b = string.byte(t, cut + 1)
			if not b or b < 0x80 or b >= 0xC0 then
				break
			end
			cut -= 1
		end
		t = string.sub(t, 1, cut)
	end
	return t
end

-- The only data a rare hatch message carries: display name, pet display name, rarity. nil when anything is off
-- (also used to check messages arriving from other servers).
function PetFlair.payload(name: any, pet: any, rarity: any): Payload?
	local n = clean(name, Config.RareHatch.NameMax)
	local p = clean(pet, Config.RareHatch.PetMax)
	-- a SHINY pet of any rarity is announced too (its display name starts with "Shiny ", GeodeGen.displayName)
	if not n or not p or type(rarity) ~= "string" or not (PetFlair.shouldAnnounce(rarity) or PetFlair.isShinyName(p)) then
		return nil
	end
	return { Name = n, Pet = p, Rarity = rarity }
end

-- Key that recognises our own message when MessagingService delivers it back to this server.
function PetFlair.echoKey(p: Payload): string
	return p.Name .. "\0" .. p.Pet .. "\0" .. p.Rarity
end

-- The banner line ("Ava hatched a LEGENDARY Golden Void Dragon!"). A Legendary (the 1 in 1000 chase pets, the Void
-- Dragon among them) opens with "WOW!" so the whole server notices.
function PetFlair.bannerLine(p: Payload): string
	local r = string.upper(p.Rarity)
	local article = if string.match(r, "^[AEIOU]") then "an" else "a"
	local line = p.Name .. " hatched " .. article .. " " .. r .. " " .. p.Pet .. "!"
	return if p.Rarity == "Legendary" then "WOW! " .. line else line
end

function PetFlair.isShinyName(pet: any): boolean
	return type(pet) == "string" and string.sub(pet, 1, 6) == "Shiny "
end

-- Rate limiter: at most one pass per `gap` seconds overall and per `keyGap` seconds per key.
export type Limiter = { Gap: number, KeyGap: number, Last: number, Keys: { [string]: number } }

function PetFlair.newLimiter(gap: number, keyGap: number?): Limiter
	return { Gap = gap, KeyGap = keyGap or 0, Last = -math.huge, Keys = {} }
end

function PetFlair.allow(l: Limiter, key: string, now: number): boolean
	if now - l.Last < l.Gap then
		return false
	end
	if l.KeyGap > 0 then
		local k = l.Keys[key]
		if k and now - k < l.KeyGap then
			return false
		end
		for other, t in l.Keys do
			if now - t >= l.KeyGap then
				l.Keys[other] = nil -- forget old keys so the table never grows
			end
		end
		l.Keys[key] = now
	end
	l.Last = now
	return true
end

-- Hatch reveal timing (Config.Hatch). The reveal animation runs on its own clock from 0 to HatchAnim.End; the
-- window SlowFrom..SlowTo (wobble, cracks, pop) is stretched or squeezed to the rarity's Slow seconds.
PetFlair.HatchAnim = { SlowFrom = 0.4, SlowTo = 1.55, End = 2.6, Pop = 1.0 }

export type HatchTiming = { Pre: number, Slow: number, Post: number, Glow: boolean, Total: number, SlowMo: boolean }

function PetFlair.hatchTiming(rarity: any): HatchTiming
	local slow = (Config.Hatch.SlowRarities :: any)[rarity] == true
	local h = if slow then Config.Hatch.Slow else Config.Hatch.Normal
	return { Pre = h.Pre, Slow = h.Slow, Post = h.Post, Glow = h.Glow, Total = h.Pre + h.Slow + h.Post, SlowMo = slow }
end

-- Seconds the server keeps a round in its Reveal phase for this rarity.
function PetFlair.revealSeconds(rarity: any): number
	return PetFlair.hatchTiming(rarity).Total + Config.Hatch.Hold
end

-- The longest reveal any rarity has (notices that must wait until after any reveal).
function PetFlair.longestReveal(): number
	local best = 0
	for _, r in Config.Rarities do
		best = math.max(best, PetFlair.revealSeconds(r))
	end
	return best
end

-- Real seconds since the reveal started -> animation time (continuous, never past HatchAnim.End).
function PetFlair.hatchWarp(h: HatchTiming, t: number): number
	local A = PetFlair.HatchAnim
	if t <= 0 then
		return 0
	elseif t < h.Pre then
		return t / h.Pre * A.SlowFrom
	elseif t < h.Pre + h.Slow then
		return A.SlowFrom + (t - h.Pre) / h.Slow * (A.SlowTo - A.SlowFrom)
	elseif t < h.Total then
		return A.SlowTo + (t - h.Pre - h.Slow) / h.Post * (A.End - A.SlowTo)
	end
	return A.End
end

-- Real seconds at which the pet pops out, for this timing.
function PetFlair.hatchPopAt(h: HatchTiming): number
	local A = PetFlair.HatchAnim
	return h.Pre + (A.Pop - A.SlowFrom) / (A.SlowTo - A.SlowFrom) * h.Slow
end

-- Lines under the player's name on the lobby name tag: the title first, then the best tower floor (0 = none).
-- Pet Battle line under a lobby name (carter 2026-10-14: others should see how strong you are and want that):
-- team power, trophies, and a crown with the win streak from 3 wins in a row. nil when there is nothing to show.
function PetFlair.battleLine(power: any, trophies: any, streak: any): string?
	local parts = {}
	local p, t, s = tonumber(power), tonumber(trophies), tonumber(streak)
	if p and p > 0 and p == p then
		table.insert(parts, "\u{26A1}" .. math.floor(p))
	end
	if t and t > 0 and t == t then
		table.insert(parts, "\u{1F3C6}" .. math.floor(t))
	end
	if s and s >= 3 and s == s then
		table.insert(parts, "\u{1F451}" .. math.floor(s) .. " streak")
	end
	return if #parts > 0 then table.concat(parts, "  ") else nil
end

function PetFlair.tagLines(towerBest: any, title: any, battle: string?): { string }
	local lines = {}
	if type(title) == "string" and title ~= "" then
		table.insert(lines, title)
	end
	local f = tonumber(towerBest)
	if f and f >= 1 and f == f then
		-- "Best": it is the record, not the floor the player is on now (owner video: read as the current floor)
		table.insert(lines, "Best floor " .. math.floor(f))
	end
	if battle then
		table.insert(lines, battle)
	end
	return lines
end

return PetFlair
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="167">
        <Properties>
          <string name="Name">PetFxRules</string>
          <string name="Source"><![CDATA[--!strict
-- Pet effects rules, pure: no Roblox services, unit-tested in tests/test_pet_fx.luau. Client PetFx draws what these
-- say; nothing here touches the world or the server.
--   * look(rarity, species, modifier): the aura tier and how much of each piece a pet gets. The tiers climb
--     Common 0, Uncommon 1, Rare 2, Epic 3, Legendary 4, chase pet 5 (Config.Minerals Chase = true), Void Dragon 6.
--     Golden and Rainbow pets keep their tier and swap the colour (gold, or a hue that cycles).
--   * lod(distance, lowEffects): how much of a one-shot burst to show (1 full, 0.5 half, 0 skip).
--   * budget: a token bucket that caps particles emitted per second for the whole client (phones).
--   * squash(k): the happy bounce, two hops with stretch on take-off and squash on landing, volume kept.
--   * hit(element, crit): the fight hit spark burst (count, size, colour) and whether a CRIT! pop shows.

local Config = require(script.Parent.Config)

local PetFxRules = {}

PetFxRules.VOID_SPECIES = "CosmicDragon" -- the Void Dragon, the rarest pet (1 in 1000)
PetFxRules.TOP_TIER = 6

local TIER_OF: { [string]: number } = { Common = 0, Uncommon = 1, Rare = 2, Epic = 3, Legendary = 4 }

-- What each tier gets. Ring = ground ring diameter per pet scale (0 = none); Alpha = ring transparency;
-- Motes = rising sparkle rate; Orbs = little lights circling the pet; Light = glow brightness;
-- Pillar = soft light column (chase pets and up); Trail = sparkles per second while the pet walks.
export type Look = {
	Tier: number,
	Ring: number,
	Alpha: number,
	Motes: number,
	Orbs: number,
	Light: number,
	Pillar: boolean,
	Trail: number,
	Color: Color3,
	Accent: Color3,
	Rainbow: boolean,
	Void: boolean,
}

local TIERS = {
	[0] = { Ring = 0, Alpha = 1, Motes = 0, Orbs = 0, Light = 0, Pillar = false, Trail = 0 },
	[1] = { Ring = 2.6, Alpha = 0.65, Motes = 0, Orbs = 0, Light = 0, Pillar = false, Trail = 2 },
	[2] = { Ring = 2.9, Alpha = 0.62, Motes = 2, Orbs = 0, Light = 0, Pillar = false, Trail = 4 },
	[3] = { Ring = 3.2, Alpha = 0.58, Motes = 3, Orbs = 2, Light = 0.4, Pillar = false, Trail = 6 },
	[4] = { Ring = 3.5, Alpha = 0.54, Motes = 5, Orbs = 3, Light = 0.7, Pillar = false, Trail = 8 },
	[5] = { Ring = 3.8, Alpha = 0.5, Motes = 6, Orbs = 4, Light = 0.9, Pillar = true, Trail = 10 },
	[6] = { Ring = 4.2, Alpha = 0.46, Motes = 8, Orbs = 5, Light = 1.1, Pillar = true, Trail = 12 },
}

local GOLD = Color3.fromRGB(255, 205, 70)
local GOLD_LIGHT = Color3.fromRGB(255, 244, 190)
local VOID = Color3.fromRGB(150, 70, 255)
local VOID_RIM = Color3.fromRGB(240, 140, 255)

function PetFxRules.tier(rarity: any, species: any, _modifier: any): number
	if species == PetFxRules.VOID_SPECIES then
		return 6
	end
	local sp: any = if type(species) == "string" then (Config.Minerals :: any)[species] else nil
	if sp and sp.Chase == true then
		return 5
	end
	return TIER_OF[tostring(rarity)] or 0
end

function PetFxRules.look(rarity: any, species: any, modifier: any): Look
	local tier = PetFxRules.tier(rarity, species, modifier)
	local base = TIERS[tier]
	local rc: Color3? = (Config.RarityColors :: any)[tostring(rarity)]
	local color = rc or (Config.RarityColors :: any).Common
	local sp: any = if type(species) == "string" then (Config.Minerals :: any)[species] else nil
	local accent: Color3 = if sp and type(sp.Rim) == "userdata" then sp.Rim else color
	if tier == 5 then
		color = accent -- a chase pet glows in its own rim colour
	elseif tier == 6 then
		color, accent = VOID, VOID_RIM
	end
	if modifier == "Golden" then
		color, accent = GOLD, GOLD_LIGHT
	end
	local fancy = modifier == "Golden" or modifier == "Rainbow"
	return {
		Tier = tier,
		-- a Golden / Rainbow Common still gets a small ring so the variant shows
		Ring = if base.Ring == 0 and fancy then TIERS[1].Ring else base.Ring,
		Alpha = if base.Ring == 0 and fancy then TIERS[1].Alpha else base.Alpha,
		Motes = base.Motes,
		Orbs = base.Orbs,
		Light = base.Light,
		Pillar = base.Pillar,
		Trail = if fancy then math.max(base.Trail, 4) else base.Trail,
		Color = color,
		Accent = accent,
		Rainbow = modifier == "Rainbow",
		Void = tier == 6,
	}
end

-- One-shot bursts: full near the camera, half further out, skipped far away. Low Effects shows a third.
PetFxRules.NEAR = 45
PetFxRules.FAR = 90
function PetFxRules.lod(distance: number, lowEffects: boolean?): number
	local k = if distance < PetFxRules.NEAR then 1 elseif distance < PetFxRules.FAR then 0.5 else 0
	return if lowEffects then k / 3 else k
end

-- Count after the level of detail: never more than asked, at least 1 when anything shows.
function PetFxRules.scaled(count: number, k: number): number
	if k <= 0 or count <= 0 then
		return 0
	end
	return math.max(1, math.floor(count * k + 0.5))
end

-- Whole-client particle budget for bursts (a phone stays smooth even in a 4-pet brawl).
export type Budget = { Rate: number, Cap: number, Tokens: number, At: number }
PetFxRules.BUDGET_RATE = 160 -- particles per second refilled
PetFxRules.BUDGET_CAP = 120 -- most particles one moment can spend

function PetFxRules.newBudget(rate: number?, cap: number?): Budget
	local c = cap or PetFxRules.BUDGET_CAP
	return { Rate = rate or PetFxRules.BUDGET_RATE, Cap = c, Tokens = c, At = 0 }
end

-- Asks for `want` particles at time `now`; returns how many may be emitted (0..want) and spends them.
function PetFxRules.spend(b: Budget, want: number, now: number): number
	if now > b.At then
		b.Tokens = math.min(b.Cap, b.Tokens + (now - b.At) * b.Rate)
		b.At = now
	end
	local give = math.clamp(math.floor(math.min(want, b.Tokens)), 0, math.max(0, want))
	b.Tokens -= give
	return give
end

-- Happy bounce: two hops over BOUNCE_TIME. Returns (height in studs per pet scale, sideways scale, up scale).
-- Stretch while rising, squash on each landing, and sideways = 1 / sqrt(up) so the pet keeps its volume.
PetFxRules.BOUNCE_TIME = 0.7
local HOPS = 2
function PetFxRules.squash(k: number): (number, number, number)
	if k <= 0 or k >= 1 then
		return 0, 1, 1
	end
	local h = k * HOPS
	local i = math.floor(h)
	local f = h - i
	local amp = if i == 0 then 1 else 0.6 -- the second hop is smaller
	local height = math.sin(f * math.pi) * 0.9 * amp
	local up: number
	if f < 0.15 then
		up = 1 - 0.18 * amp * (1 - f / 0.15) -- crouch before the jump / landing squash
	elseif f < 0.5 then
		up = 1 + 0.12 * amp * math.sin((f - 0.15) / 0.35 * math.pi) -- stretch on the way up
	elseif f > 0.85 then
		up = 1 - 0.18 * amp * ((f - 0.85) / 0.15) -- squash as the feet land
	else
		up = 1
	end
	return height, 1 / math.sqrt(up), up
end

-- Fight hit sparks. Element colours match the pet element traits in client PetFx.
PetFxRules.ELEMENT_COLORS = {
	Fire = Color3.fromRGB(255, 140, 40),
	Ice = Color3.fromRGB(150, 220, 255),
	Nature = Color3.fromRGB(130, 230, 90),
	Storm = Color3.fromRGB(255, 240, 110),
	Earth = Color3.fromRGB(205, 165, 110),
	Cosmic = Color3.fromRGB(210, 150, 255),
}
local WHITE = Color3.new(1, 1, 1)
export type Hit = { Count: number, Size: number, Speed: number, Color: Color3, Pop: boolean, Flash: number }
function PetFxRules.hit(element: any, crit: boolean?): Hit
	local c = (PetFxRules.ELEMENT_COLORS :: any)[tostring(element)] or WHITE
	if crit then
		return { Count = 18, Size = 0.5, Speed = 16, Color = c, Pop = true, Flash = 2.4 }
	end
	return { Count = 8, Size = 0.32, Speed = 10, Color = c, Pop = false, Flash = 1.2 }
end

-- KO poof and level-up blast sizes (particles before LOD and budget).
PetFxRules.KO_COUNT = 16
PetFxRules.LEVEL_COUNT = 24

return PetFxRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="168">
        <Properties>
          <string name="Name">PetModel</string>
          <string name="Source"><![CDATA[--!strict
-- Procedural low-poly pets (Find The Pet). One chunky, toy-like body per species Kind (Config.Minerals[id].Kind):
-- big head, big glossy eyes, SmoothPlastic, and the few parts that make each animal readable at a glance
-- (raptor tail and little arms, ostrich neck and legs, wolf ears and bushy tail, griffin beak and wings, wyvern
-- horns and ice spikes, mammoth trunk and tusks, T-Rex lava cracks, phoenix flame tail, dragon stars, pterodactyl
-- crest and wide wings). Everything derives from the stored specimen record (Mineral = species, Formation = pose,
-- Modifier = variant, Rarity, Mass, Seed), so the same pet looks the same in the hatch reveal, results, book,
-- gallery and following its owner.
--
-- Frame: the pivot is the centre of the feet on the ground (y = 0); the pet faces -Z (Roblox LookVector), so
-- CFrame.lookAt(pos, pos + dir) makes it face `dir`. Every part is anchored, never collides, not queryable.
-- About 18-30 parts per pet. REPLACE: real mesh per species when the owner uploads them (docs/BRIEF.txt).

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Config = require(script.Parent.Config)
local GeodeGen = require(script.Parent.GeodeGen)
local PetFlair = require(script.Parent.PetFlair)
local PetSkins = require(script.Parent.PetSkins)

local PetModel = {}

export type Opts = {
	Scale: number?, -- overrides the mass scale (1 = about 2.4 studs tall)
	Lod: boolean?, -- fewer small pieces (gallery shelves, followers)
	Tiny: boolean?, -- fewest pieces (implies Lod)
	NoLight: boolean?, -- no PointLight (many pets in one view)
	NoFx: boolean?, -- no sparkles, aura ring or beams
}

local GOLD = Color3.fromRGB(255, 196, 64)
local INK = Color3.fromRGB(30, 28, 38)
local WHITE = Color3.new(1, 1, 1)
local BLUSH = Color3.fromRGB(255, 150, 172)
local ORANGE = Color3.fromRGB(255, 160, 50)
local BEAK = Color3.fromRGB(255, 205, 70)
local BONE = Color3.fromRGB(238, 232, 212)
local SOCKET = Color3.fromRGB(52, 46, 54)
local SILVER = Color3.fromRGB(206, 212, 226)
local COSMIC = { Color3.fromRGB(170, 90, 255), Color3.fromRGB(80, 150, 255), Color3.fromRGB(230, 120, 255) }

local SPECIES = { "Raptor", "Ostrich", "DireWolf", "Griffin", "FrostWyvern", "Mammoth", "LavaTRex", "Phoenix", "CosmicDragon", "StarPterodactyl" }
local KINDS = {
	raptor = true, ostrich = true, wolf = true, griffin = true, wyvern = true,
	mammoth = true, trex = true, phoenix = true, dragon = true, pterodactyl = true,
}

-- The species entry for a specimen; an unknown id (old saves, decorative examples) maps to a fixed species.
local function species(id: any): { [string]: any }
	local m = (Config.Minerals :: any)[id]
	if m then
		return m
	end
	local h = 0
	for i = 1, #tostring(id) do
		h = (h * 31 + string.byte(tostring(id), i)) % 1000003
	end
	return (Config.Minerals :: any)[SPECIES[h % #SPECIES + 1]] or { Kind = "raptor", Crystal = Color3.fromRGB(110, 190, 90), Rim = Color3.fromRGB(250, 210, 90) }
end
PetModel.species = species

-- body/accent are recoloured by variants; glow = neon pieces (keep their colour except Golden/Rainbow);
-- fixed = eyes, shines, cheeks, beaks, sockets (never recoloured)
type Role = "body" | "accent" | "glow" | "fixed"

-- Real meshes (owner's Studio models): a Model named "Pet_<species id>" inside a folder "PetModels" in ReplicatedStorage
-- (preferred) or Workspace. When one exists it is used instead of the procedural body; otherwise the stand-in below.
local TEMPLATE_HEIGHT = 2.4 -- studs: procedural pets at Scale 1 are about this tall
local VARIANT_TINT: { [string]: Color3 } = {
	Golden = Color3.fromRGB(255, 196, 64),
	Skeleton = Color3.fromRGB(238, 232, 212),
	SilverCosmic = Color3.fromRGB(206, 212, 226),
}

local function template(id: any): Model?
	for _, root in { game:GetService("ReplicatedStorage"), game:GetService("Workspace") } do
		local folder = root:FindFirstChild("PetModels")
		local m = folder and folder:FindFirstChild("Pet_" .. tostring(id))
		if m and m:IsA("Model") then
			return m
		end
	end
	return nil
end

-- Rare and better pets sparkle (Config.Pets.Sparkle). Tagged "PetSparkle" so the client (PetSparkle) can turn every
-- one off locally when the viewer picks Low Effects. Never on Tiny pets or with NoFx.
local function addRaritySparkle(part: BasePart?, rarity: any, o: Opts)
	if not part or o.NoFx == true or o.Tiny == true then
		return
	end
	local look = PetFlair.sparkle(rarity)
	if not look then
		return
	end
	local sp = Instance.new("Sparkles")
	sp.Name = "RaritySparkle"
	sp.SparkleColor = look.Color
	sp.TimeScale = look.TimeScale
	sp.Parent = part
	CollectionService:AddTag(sp, "PetSparkle")
end

-- Shiny pets (LaunchPerks.Shiny, 1 in 100): a white-pink star shimmer and a soft twinkle light. Same Low Effects tag.
local function addShinyFx(part: BasePart?, spec: { [string]: any }, o: Opts)
	if not part or spec.Shiny ~= true or o.NoFx == true or o.Tiny == true then
		return
	end
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "ShinyShimmer"
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 150, 230))
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.45), NumberSequenceKeypoint.new(1, 0) })
	pe.Lifetime = NumberRange.new(0.6, 1.1)
	pe.Rate = 9
	pe.Speed = NumberRange.new(0.3, 0.9)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-90, 90)
	pe.Parent = part
	CollectionService:AddTag(pe, "PetSparkle")
	local pl = Instance.new("PointLight")
	pl.Name = "ShinyGlow"
	pl.Color = Color3.fromRGB(255, 200, 245)
	pl.Brightness = 0.8
	pl.Range = 6
	pl.Shadows = false
	pl.Parent = part
	CollectionService:AddTag(pl, "PetSparkle")
end

-- Evolved pets (PvpService evolve) glow: a soft force-field shell around the body in the stage colour, plus sparkles.
local EVOLVE_GLOW = { Color3.fromRGB(120, 230, 255), Color3.fromRGB(255, 200, 70) }
local function addEvolveGlow(model: Model, spec: { [string]: any }, o: Opts)
	local stage = PetFlair.evolveStage(spec.Evolve)
	if stage <= 0 then
		return
	end
	model:SetAttribute("Evolve", stage)
	if o.Tiny == true then
		return
	end
	local cf, size = model:GetBoundingBox()
	local col = EVOLVE_GLOW[math.clamp(stage, 1, #EVOLVE_GLOW)]
	local aura = Instance.new("Part")
	aura.Name = "EvolveAura"
	aura.Shape = Enum.PartType.Ball
	local d = math.max(size.X, size.Y, size.Z) * 1.1
	aura.Size = Vector3.new(d, d, d)
	aura.CFrame = cf
	aura.Color = col
	aura.Material = Enum.Material.ForceField
	aura.Transparency = 0.2
	aura.Anchored = true
	aura.CanCollide = false
	aura.CanQuery = false
	aura.CanTouch = false
	aura.CastShadow = false
	aura.Parent = model
	if o.NoFx ~= true then
		local sp = Instance.new("Sparkles")
		sp.Name = "EvolveSparkle"
		sp.SparkleColor = col
		sp.Parent = aura
		CollectionService:AddTag(sp, "PetSparkle")
	end
end

-- Whether a mesh pet faces +Z of `frame` (back to front): its Head bone sits behind its Tail bone (or Body bone when
-- there is no tail). nil-safe: no bones = false.
function PetModel.faceFlip(model: Model, frame: CFrame): boolean
	local head: Vector3?, back: Vector3?, body: Vector3? = nil, nil, nil
	for _, d in model:GetDescendants() do
		if d:IsA("Bone") then
			local key = d.Name:match("_(%a+)$") or d.Name
			if key == "Head" then
				head = frame:PointToObjectSpace(d.WorldPosition)
			elseif key == "Tail" then
				back = frame:PointToObjectSpace(d.WorldPosition)
			elseif key == "Body" then
				body = frame:PointToObjectSpace(d.WorldPosition)
			end
		end
	end
	local b = back or body
	return head ~= nil and b ~= nil and head.Z > b.Z + 0.05
end

local function fromTemplate(tmpl: Model, spec: { [string]: any }, s: number, o: Opts): Model
	local model = tmpl:Clone()
	model.Name = "CT_Pet_" .. tostring(spec.Mineral)
	for _, d in model:GetDescendants() do
		if d:IsA("BaseScript") then
			d:Destroy() -- motion scripts belong to the owner's preview, never to copies
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	local _, size = model:GetBoundingBox()
	local h = math.max(size.Y, 0.1)
	pcall(function()
		model:ScaleTo(math.max(0.05, model:GetScale() * TEMPLATE_HEIGHT * s * ((tmpl:GetAttribute("SizeBoost") :: number?) or 1) / h))
	end)
	local tint: Color3? = VARIANT_TINT[spec.Modifier]
	-- painted variant skins (shared/PetSkins): same mesh, other texture, eyes stay dark; used instead of the flat
	-- tint for any variant the species has one for (a flat tint has to drop the texture, eyes and all)
	local skins = PetSkins[tostring(spec.Mineral)]
	local skin: string? = if skins and spec.Modifier then skins[tostring(spec.Modifier)] else nil
	if type(skin) == "string" and skin ~= "" then
		for _, d in model:GetDescendants() do
			if d:IsA("MeshPart") then
				d.TextureID = skin
				if spec.Modifier == "Golden" or spec.Modifier == "SilverCosmic" then
					d.Reflectance = 0.1
				end
			end
		end
		tint = nil
	end
	local i = 0
	for _, d in model:GetDescendants() do
		if type(skin) == "string" and skin ~= "" then
			break
		end
		if d:IsA("BasePart") and d.Material ~= Enum.Material.Neon then
			i += 1
			if spec.Modifier == "Rainbow" then
				d.Color = Color3.fromHSV(((spec.Seed or 1) * 0.07 + i * 0.13) % 1, 0.85, 1) -- vivid, not pastel (a one-mesh pet at 0.55 read as a pale ghost)
			elseif tint then
				d.Color = tint
				if spec.Modifier ~= "Skeleton" then
					d.Reflectance = 0.2
				end
			end
			if d:IsA("MeshPart") and (tint or spec.Modifier == "Rainbow") then
				d.TextureID = "" -- a texture would hide the variant colour
			end
		end
	end
	local cf, box = model:GetBoundingBox()
	local floor = cf.Position.Y - box.Y / 2
	local feet = CFrame.new(cf.Position.X, floor, cf.Position.Z) * (cf - cf.Position)
	-- the pet must face -Z (followers, reveal, fights all use CFrame.lookAt): a mesh imported back to front (Studio
	-- check 2026-10-15: Bramblebat, Ashwing) is turned round here, judged by its head bone in front of its tail bone
	local flip = PetModel.faceFlip(model, feet)
	if flip then
		feet *= CFrame.Angles(0, math.pi, 0)
		model:SetAttribute("FaceFlipped", true)
	end
	if model.PrimaryPart then
		-- with a PrimaryPart the pivot comes from PivotOffset (WorldPivot is ignored), so put it at the feet too
		model.PrimaryPart.PivotOffset = model.PrimaryPart.CFrame:ToObjectSpace(feet)
	else
		model.WorldPivot = feet
	end
	model:PivotTo(CFrame.new())
	local rc: Color3? = (Config.RarityColors :: any)[spec.Rarity]
	local body = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if rc and spec.Rarity ~= "Common" and o.NoLight ~= true and o.NoFx ~= true and body then
		local pl = Instance.new("PointLight")
		pl.Color = rc
		pl.Brightness = if spec.Rarity == "Legendary" then 1.4 else 0.7
		pl.Range = 5 * s + 2
		pl.Shadows = false
		CollectionService:AddTag(pl, "PetSparkle") -- Low Effects turns it off (client PetSparkle)
		pl.Parent = body
	end
	model:SetAttribute("Radius", math.max(box.X, box.Z) / 2)
	model:SetAttribute("CentreY", box.Y / 2)
	model:SetAttribute("Height", box.Y)
	model:SetAttribute("Kind", species(spec.Mineral).Kind)
	-- followers get renamed (Pet_<uid>_n), so PetMotion reads the species from here to pick the body type (gait)
	model:SetAttribute("Species", tostring(spec.Mineral))
	model:SetAttribute("Mesh", true)
	addRaritySparkle(body, spec.Rarity, o)
	addShinyFx(body, spec, o)
	if RunService:IsServer() then
		-- bone motion does not replicate: each client starts PetMotion on tagged server pets (client PetDisplay)
		CollectionService:AddTag(model, "PetDisplay")
	end
	return model
end

function PetModel.build(spec: { [string]: any }, opts: Opts?): Model
	local o: Opts = opts or {}
	-- rarer pets are a bit bigger everywhere they are drawn (Config.Pets.RarityScale)
	-- evolved pets are bigger again (PetFlair.evolveScale)
	local s = (o.Scale or GeodeGen.visualScale(spec.Mass or 1)) * PetFlair.rarityScale(spec.Rarity) * PetFlair.evolveScale(spec.Evolve)
	local tmpl = template(spec.Mineral)
	if tmpl then
		local m = fromTemplate(tmpl, spec, s, o)
		addEvolveGlow(m, spec, o)
		return m
	end
	local tiny = o.Tiny == true
	local lod = o.Lod == true or tiny
	local sp = species(spec.Mineral)
	local kind: string = if KINDS[sp.Kind] then sp.Kind else "raptor"
	local base: Color3 = sp.Crystal
	local rim: Color3 = sp.Rim
	local trait = spec.Modifier
	local form = spec.Formation
	local rarity = spec.Rarity
	local rng = Random.new((spec.Seed or 1) * 3 + 11)
	local hue0 = rng:NextNumber(0, 1)

	local model = Instance.new("Model")
	model.Name = "CT_Pet_" .. tostring(spec.Mineral)
	local n = 0

	-- paint: variants recolour body/accent pieces; glow keeps its colour; eyes, cheeks, beaks are fixed
	local function paint(c: Color3, role: Role): Color3
		if role == "fixed" then
			return c
		end
		if trait == "Rainbow" then
			return Color3.fromHSV((hue0 + n * 0.13) % 1, if role == "glow" then 0.7 else 0.55, 1)
		elseif trait == "Golden" then
			return c:Lerp(GOLD, if role == "body" then 0.82 elseif role == "accent" then 0.6 else 0.4)
		elseif role == "glow" then
			return c
		elseif trait == "Skeleton" then
			return if role == "body" then BONE else BONE:Lerp(INK, 0.1)
		elseif trait == "SilverCosmic" then
			return if role == "body" then SILVER else SILVER:Lerp(COSMIC[1], 0.35)
		end
		return c
	end

	-- add: one piece in unit space (scaled by s). shape: ball (ellipsoid), block, cyl.
	local function add(name: string, shape: string, size: Vector3, cf: CFrame, color: Color3, role: Role, neon: boolean?): BasePart
		n += 1
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * s
		p.CFrame = CFrame.new(cf.Position * s) * cf.Rotation
		p.Color = paint(color, role)
		p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
		if role == "body" or role == "accent" then
			if trait == "Golden" then
				p.Reflectance = 0.2
			elseif trait == "SilverCosmic" then
				p.Reflectance = 0.25
			end
		end
		if shape == "ball" then
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.Sphere
			m.Parent = p
		elseif shape == "cyl" then
			p.Shape = Enum.PartType.Cylinder
		end
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local V = Vector3.new
	local A = CFrame.Angles
	local R45 = math.rad(45)

	-- pose (Formation): Cluster = Sitting, Spire = Standing (taller), TwinCore = Waving, HollowBloom = Sleepy
	local up = if form == "Spire" then 0.15 else 0
	local sleepy = form == "HollowBloom"
	local waving = form == "TwinCore"
	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x, y + up, z) -- body-space: lifted by the standing pose
	end
	local function gr(x: number, y: number, z: number): CFrame
		return CFrame.new(x, y, z) -- ground-space: feet and legs
	end

	local dark = base:Lerp(INK, 0.25)

	-- body: the main torso (ribs and specks are placed on it)
	local bodyPart: BasePart? = nil
	local bodyCF = CFrame.new()
	local bodySize = V(1, 1, 1)
	local function torso(size: Vector3, cf: CFrame, col: Color3?): BasePart
		local p = add("Body", "ball", size, cf, col or base, "body")
		bodyPart = p
		bodyCF = cf
		bodySize = size
		return p
	end

	-- head: everything on it is placed in head space so the sleepy tilt carries the face
	local H = CFrame.new()
	local headSize = V(1.5, 1.3, 1.35)
	local function head(size: Vector3, x: number, y: number, z: number, col: Color3?, role: Role?): BasePart
		H = CFrame.new(x, y + up, z) * A(if sleepy then 0.12 else 0, 0, if sleepy then 0.2 else 0)
		headSize = size
		return add("Head", "ball", size, H, col or base, role or "body")
	end
	local function hp(x: number, y: number, z: number, rx: number?, ry: number?, rz: number?): CFrame
		return H * CFrame.new(x, y, z) * A(rx or 0, ry or 0, rz or 0)
	end
	-- z of the head's front surface at (x, y) in head space
	local function front(x: number, y: number): number
		local u = (x / (headSize.X / 2)) ^ 2 + (y / (headSize.Y / 2)) ^ 2
		return -(headSize.Z / 2) * math.sqrt(math.max(0.05, 1 - u))
	end

	-- face: big glossy eyes with shines (closed lines when sleepy), blush cheeks; Skeleton adds dark sockets
	local function face(eyeY: number, eyeScale: number?, spread: number?)
		local k = math.min(headSize.X, headSize.Y) / 1.45 * (eyeScale or 1)
		local ex = headSize.X * (spread or 0.21)
		local ez = front(ex, eyeY)
		for side = -1, 1, 2 do
			local x = side * ex
			if trait == "Skeleton" and not tiny then
				add("Socket", "ball", V(0.5 * k, 0.58 * k, 0.1), hp(x, eyeY, ez + 0.02), SOCKET, "fixed")
			end
			if sleepy then
				add("Eye", "block", V(0.3 * k, 0.06, 0.06), hp(x, eyeY - 0.02, ez - 0.03, 0, 0, side * -0.15), INK, "fixed")
			else
				add("Eye", "ball", V(0.36 * k, 0.44 * k, 0.12), hp(x, eyeY, ez - 0.02), INK, "fixed")
				add("Shine", "ball", V(0.13 * k, 0.13 * k, 0.05), hp(x + 0.07 * k, eyeY + 0.1 * k, ez - 0.08), WHITE, "fixed", true)
			end
			if not lod then
				local cx, cy = side * headSize.X * 0.33, eyeY - headSize.Y * 0.2
				add("Cheek", "ball", V(0.24 * k, 0.13 * k, 0.06), hp(cx, cy, front(cx, cy) + 0.01), BLUSH, "fixed")
			end
		end
	end

	-- shared limb helpers
	local function biped(thigh: Vector3, x: number, footCol: Color3)
		for side = -1, 1, 2 do
			add("Thigh", "ball", thigh, gr(side * x, thigh.Y / 2 + 0.05 + up * 0.5, 0.05), base, "body")
			add("Foot", "ball", V(thigh.X * 0.85, 0.18, thigh.Z * 0.95), gr(side * x, 0.09, -0.15), footCol, "body")
		end
	end
	local function quad(leg: Vector3, x: number, zf: number, zb: number, col: Color3)
		for _, z in { zf, zb } do
			for side = -1, 1, 2 do
				add("Leg", "ball", V(leg.X, leg.Y + up, leg.Z), gr(side * x, (leg.Y + up) / 2 + 0.02, z), col, "body")
			end
		end
	end
	-- arms: little forward paws; the waving pose raises the right one
	local function arms(size: Vector3, x: number, y: number, z: number, col: Color3)
		for side = -1, 1, 2 do
			local cf = if waving and side == 1
				then at(x + 0.18, y + 0.42, z + 0.1) * A(0, 0, math.rad(-150))
				else at(side * x, y, z) * A(-0.8, 0, side * 0.2)
			add("Arm", "ball", size, cf, col, "body")
		end
	end
	-- wings: a flat membrane rooted at the shoulders, raised and swept back; waving lifts the right one higher
	local function wings(size: Vector3, x: number, y: number, z: number, col: Color3, shape: string, tilt: number?)
		for side = -1, 1, 2 do
			local lift = if waving and side == 1 then 0.5 else 0
			local t = (tilt or 0.55) + lift
			add("Wing", shape, size, at(side * x, y + lift * 0.25, z) * A(0.3, side * 0.45, side * -t), col, "accent")
		end
	end
	local function spike(name: string, sz: number, cf: CFrame, col: Color3, role: Role, neon: boolean?): BasePart
		return add(name, "block", V(0.1, sz, sz), cf * A(R45, 0, 0), col, role, neon)
	end
	local function star(cf: CFrame, sz: number, col: Color3)
		add("Star", "block", V(sz, sz, 0.05), cf * A(0, 0, R45), col, "glow", true)
	end

	local radius = 0.95 -- footprint (aura ring, viewport framing)

	if kind == "raptor" then
		biped(V(0.42, 0.6, 0.5), 0.32, dark)
		torso(V(1.15, 1.2, 1.15), at(0, 1.0, 0.05) * A(-0.15, 0, 0))
		add("Belly", "ball", V(0.72, 0.8, 0.3), at(0, 0.95, -0.46), rim:Lerp(WHITE, 0.4), "accent")
		arms(V(0.18, 0.38, 0.18), 0.42, 1.15, -0.45, base)
		add("Tail", "ball", V(0.42, 0.42, 1.25), at(0, 0.75, 0.85) * A(0.45, 0, 0), base, "body")
		if not lod then
			add("TailTip", "ball", V(0.26, 0.26, 0.5), at(0, 0.45, 1.42) * A(0.6, 0, 0), base, "body")
		end
		head(V(1.45, 1.25, 1.4), 0, 2.0, -0.2)
		add("Snout", "ball", V(0.85, 0.52, 0.7), hp(0, -0.27, -0.52), base:Lerp(WHITE, 0.15), "body")
		face(0.1)
		spike("Spike", 0.34, hp(0, 0.6, 0.15), rim, "accent")
		if not tiny then
			spike("Spike", 0.3, at(0, 1.6, 0.45), rim, "accent")
			spike("Spike", 0.26, at(0, 1.25, 0.66), rim, "accent")
		end
	elseif kind == "trex" then
		biped(V(0.55, 0.7, 0.65), 0.4, dark)
		torso(V(1.4, 1.3, 1.35), at(0, 1.05, 0.1) * A(-0.12, 0, 0))
		add("Belly", "ball", V(0.66, 0.85, 0.3), at(0, 1.0, -0.52), base:Lerp(rim, 0.6), "accent")
		arms(V(0.14, 0.26, 0.14), 0.45, 1.25, -0.55, base)
		add("Tail", "ball", V(0.55, 0.55, 1.4), at(0, 0.75, 0.95) * A(0.4, 0, 0), base, "body")
		head(V(1.75, 1.4, 1.75), 0, 2.1, -0.3)
		add("Jaw", "ball", V(1.25, 0.55, 0.9), hp(0, -0.38, -0.62), base:Lerp(WHITE, 0.08), "body")
		if not lod then
			for side = -1, 1, 2 do
				add("Fang", "block", V(0.12, 0.12, 0.06), hp(side * 0.28, -0.6, -0.98, 0, 0, R45), WHITE, "fixed")
			end
		end
		face(0.18)
		-- lava cracks
		add("Crack", "block", V(0.13, 0.55, 0.12), at(0.38, 1.25, -0.47) * A(0, 0, 0.5), rim, "glow", true)
		add("Crack", "block", V(0.12, 0.12, 0.6), hp(0, 0.66, 0.05, 0, 0.3, 0), rim, "glow", true)
		add("Crack", "block", V(0.13, 0.5, 0.12), hp(0.5, 0.35, front(0.5, 0.35) + 0.02, 0, 0, -0.6), rim, "glow", true)
		if not lod then
			add("Crack", "block", V(0.13, 0.5, 0.12), at(-0.4, 0.88, -0.45) * A(0, 0, -0.4), rim, "glow", true)
			add("Crack", "block", V(0.08, 0.08, 0.6), at(0, 1.02, 0.9) * A(0.4, 0.3, 0), rim, "glow", true)
		end
		radius = 1.05
	elseif kind == "ostrich" then
		for side = -1, 1, 2 do
			add("Leg", "ball", V(0.2, 0.95 + up, 0.2), gr(side * 0.28, (0.95 + up) / 2 + 0.03, 0.05), rim, "accent")
			add("Foot", "ball", V(0.3, 0.14, 0.42), gr(side * 0.28, 0.07, -0.1), rim:Lerp(INK, 0.2), "accent")
		end
		torso(V(1.5, 1.1, 1.55), at(0, 1.25, 0.1))
		wings(V(0.4, 0.75, 0.95), 0.62, 1.3, 0.15, base:Lerp(WHITE, 0.08), "ball", 0.2)
		add("Plume", "ball", V(0.85, 0.65, 0.55), at(0, 1.55, 0.85), WHITE:Lerp(base, 0.08), "accent")
		if not lod then
			add("Plume", "ball", V(0.5, 0.45, 0.4), at(0, 1.82, 0.98), WHITE:Lerp(base, 0.08), "accent")
		end
		add("Ruff", "ball", V(0.72, 0.38, 0.72), at(0, 1.72, -0.42), base, "body")
		add("Neck", "ball", V(0.32, 1.05, 0.32), at(0, 2.08, -0.45), rim, "accent")
		head(V(1.1, 1.0, 1.05), 0, 2.72, -0.5, rim:Lerp(WHITE, 0.25), "accent")
		add("Beak", "ball", V(0.52, 0.18, 0.5), hp(0, -0.17, -0.5), ORANGE:Lerp(WHITE, 0.4), "fixed")
		face(0.06, 1.3, 0.23)
		if not tiny then
			add("Tuft", "ball", V(0.18, 0.32, 0.18), hp(0.04, 0.52, 0.02, 0, 0, -0.3), base, "body")
		end
	elseif kind == "wolf" then
		quad(V(0.32, 0.7, 0.32), 0.32, -0.45, 0.72, base)
		torso(V(1.15, 1.0, 1.7), at(0, 0.95, 0.15))
		add("Chest", "ball", V(0.8, 0.75, 0.45), at(0, 1.05, -0.6), rim, "accent")
		add("Tail", "ball", V(0.5, 0.5, 1.1), at(0, 1.3, 1.05) * A(-0.7, 0, 0), base, "body")
		add("TailTip", "ball", V(0.4, 0.4, 0.45), at(0, 1.62, 1.42) * A(-0.7, 0, 0), rim, "accent")
		head(V(1.4, 1.2, 1.25), 0, 1.85, -0.65)
		add("Snout", "ball", V(0.6, 0.42, 0.62), hp(0, -0.26, -0.56), rim, "accent")
		add("Nose", "ball", V(0.18, 0.13, 0.12), hp(0, -0.13, -0.86), INK, "fixed")
		face(0.1)
		for side = -1, 1, 2 do
			add("Ear", "block", V(0.48, 0.48, 0.16), hp(side * 0.42, 0.56, 0.05, 0, 0, R45), base, "body")
			if not tiny then
				add("EarInner", "block", V(0.26, 0.26, 0.06), hp(side * 0.42, 0.58, -0.04, 0, 0, R45), INK, "fixed")
			end
		end
		radius = 1.1
	elseif kind == "griffin" then
		quad(V(0.32, 0.7, 0.32), 0.33, -0.4, 0.75, base)
		torso(V(1.2, 1.0, 1.65), at(0, 0.95, 0.2))
		add("Chest", "ball", V(0.95, 0.85, 0.5), at(0, 1.15, -0.5), rim, "accent")
		local feather = base:Lerp(WHITE, 0.35)
		wings(V(0.12, 0.95, 1.2), 0.62, 1.72, 0.35, feather, "block", 0.5)
		if not lod then
			for side = -1, 1, 2 do
				add("Feathers", "block", V(0.1, 0.6, 1.0), at(side * 0.95, 2.08, 0.5) * A(0.3, side * 0.45, side * -0.75), dark, "accent")
			end
		end
		add("Tail", "ball", V(0.15, 0.15, 0.85), at(0, 1.05, 1.1) * A(-0.5, 0, 0), base, "body")
		add("TailTuft", "ball", V(0.32, 0.32, 0.32), at(0, 1.3, 1.45), dark, "body")
		head(V(1.3, 1.2, 1.2), 0, 1.92, -0.62, rim, "accent")
		add("Beak", "ball", V(0.42, 0.34, 0.52), hp(0, -0.2, -0.6), BEAK, "fixed")
		add("BeakTip", "ball", V(0.2, 0.24, 0.2), hp(0, -0.34, -0.8), BEAK:Lerp(ORANGE, 0.5), "fixed")
		face(0.12)
		radius = 1.15
	elseif kind == "wyvern" then
		biped(V(0.5, 0.55, 0.6), 0.38, dark)
		torso(V(1.25, 1.25, 1.2), at(0, 0.95, 0.05))
		add("Belly", "ball", V(0.8, 0.85, 0.3), at(0, 0.9, -0.5), rim, "accent")
		wings(V(0.1, 1.0, 1.1), 0.72, 1.6, 0.45, rim:Lerp(base, 0.35), "block")
		add("Tail", "ball", V(0.38, 0.38, 1.1), at(0, 0.5, 0.85) * A(0.4, 0, 0), base, "body")
		head(V(1.5, 1.3, 1.35), 0, 2.0, -0.12)
		add("Snout", "ball", V(0.75, 0.5, 0.6), hp(0, -0.26, -0.52), base:Lerp(WHITE, 0.15), "body")
		face(0.1)
		for side = -1, 1, 2 do
			add("Horn", "block", V(0.14, 0.5, 0.14), hp(side * 0.38, 0.68, 0.18, 0.5, 0, side * -0.3), rim, "accent")
		end
		-- icy spikes along the spine
		spike("Ice", 0.3, hp(0, 0.6, 0.38), rim:Lerp(WHITE, 0.3), "accent").Transparency = 0.15
		spike("Ice", 0.34, at(0, 1.55, 0.55), rim:Lerp(WHITE, 0.3), "accent").Transparency = 0.15
		if not lod then
			spike("Ice", 0.28, at(0, 1.12, 0.68), rim:Lerp(WHITE, 0.3), "accent").Transparency = 0.15
			spike("Ice", 0.22, at(0, 0.3, 1.38), rim:Lerp(WHITE, 0.3), "accent").Transparency = 0.15
		end
		radius = 1.1
	elseif kind == "mammoth" then
		quad(V(0.45, 0.75, 0.45), 0.42, -0.4, 0.7, dark)
		torso(V(1.6, 1.35, 1.75), at(0, 1.15, 0.15))
		add("Shag", "ball", V(1.72, 0.55, 1.86), at(0, 0.78, 0.15), dark, "body")
		if not tiny then
			add("Hump", "ball", V(0.95, 0.6, 0.95), at(0, 1.78, -0.05), dark, "body")
		end
		head(V(1.45, 1.35, 1.25), 0, 1.92, -0.7)
		for side = -1, 1, 2 do
			add("Ear", "ball", V(0.7, 0.8, 0.15), hp(side * 0.75, 0.05, 0.12, 0, side * 0.4, 0), dark, "body")
			add("Tusk", "ball", V(0.16, 0.16, 0.8), hp(side * 0.32, -0.48, -0.78, 0.6, side * -0.3, 0), rim, "accent")
		end
		add("Trunk", "ball", V(0.42, 0.62, 0.42), hp(0, -0.28, -0.6), base, "body")
		add("Trunk", "ball", V(0.34, 0.55, 0.34), hp(0, -0.72, -0.72), base, "body")
		if not lod then
			add("TrunkTip", "ball", V(0.28, 0.28, 0.32), hp(0, -1.0, -0.84), base, "body")
		end
		if not tiny then
			add("Tuft", "ball", V(0.6, 0.42, 0.6), hp(0, 0.62, 0.05), dark, "body")
		end
		face(0.14, 0.95, 0.23)
		radius = 1.2
	elseif kind == "phoenix" then
		for side = -1, 1, 2 do
			add("Leg", "ball", V(0.12, 0.42 + up, 0.12), gr(side * 0.25, (0.42 + up) / 2 + 0.04, 0), BEAK, "fixed")
			add("Foot", "ball", V(0.3, 0.08, 0.35), gr(side * 0.25, 0.04, -0.08), BEAK, "fixed")
		end
		torso(V(1.25, 1.25, 1.25), at(0, 1.0, 0.05))
		add("Belly", "ball", V(0.8, 0.8, 0.3), at(0, 0.95, -0.5), rim, "accent")
		wings(V(0.22, 0.85, 0.65), 0.7, 1.12, 0.1, base:Lerp(rim, 0.3), "ball", 0.35)
		local flames = { rim, ORANGE, Color3.fromRGB(255, 90, 40) }
		for i = 1, 3 do
			local x = (i - 2) * 0.32
			add("Flame", "ball", V(0.24, 0.24, 1.25), at(x, 1.05 + (if i == 2 then 0.12 else 0), 0.95) * A(-0.6, x * 1.1, 0), flames[i], "glow", true)
		end
		head(V(1.35, 1.25, 1.25), 0, 2.0, -0.1)
		add("Beak", "ball", V(0.32, 0.22, 0.38), hp(0, -0.16, -0.66), BEAK, "fixed")
		face(0.1)
		for i = 1, (if lod then 2 else 3) do
			local x = (i - 2) * 0.2
			add("Crest", "ball", V(0.18, 0.55, 0.18), hp(x, 0.75 - math.abs(x) * 0.4, 0.12, -0.3, 0, -x * 1.2), flames[i], "glow", true)
		end
	elseif kind == "dragon" then
		biped(V(0.5, 0.5, 0.6), 0.38, dark)
		torso(V(1.3, 1.25, 1.2), at(0, 0.95, 0.05))
		add("Belly", "ball", V(0.8, 0.85, 0.3), at(0, 0.9, -0.5), rim, "accent")
		arms(V(0.25, 0.4, 0.25), 0.6, 1.0, -0.35, base)
		wings(V(0.1, 0.95, 1.15), 0.72, 1.62, 0.5, rim:Lerp(base, 0.4), "block")
		add("Tail", "ball", V(0.36, 0.36, 1.1), at(0, 0.45, 0.85) * A(0.35, 0, 0), base, "body")
		if not lod then
			add("TailTip", "block", V(0.08, 0.3, 0.3), at(0, 0.25, 1.38) * A(R45, 0, 0), rim, "accent")
		end
		head(V(1.55, 1.35, 1.4), 0, 2.0, -0.12)
		add("Snout", "ball", V(0.8, 0.5, 0.6), hp(0, -0.26, -0.55), base:Lerp(WHITE, 0.2), "body")
		face(0.12)
		for side = -1, 1, 2 do
			add("Horn", "block", V(0.15, 0.48, 0.15), hp(side * 0.4, 0.7, 0.15, 0.45, 0, side * -0.35), rim, "accent")
		end
		-- starry speckles
		local gold = Color3.fromRGB(255, 240, 150)
		star(at(0.32, 1.22, -0.68), 0.16, WHITE)
		star(hp(-0.48, 0.38, front(-0.48, 0.38) - 0.02), 0.14, gold)
		if not lod then
			star(at(-0.62, 1.15, -0.4), 0.12, gold)
		end
	elseif kind == "pterodactyl" then
		biped(V(0.26, 0.42, 0.28), 0.25, dark)
		torso(V(1.0, 1.1, 1.0), at(0, 0.92, 0.05))
		add("Belly", "ball", V(0.62, 0.72, 0.28), at(0, 0.88, -0.4), base:Lerp(WHITE, 0.35), "accent")
		for side = -1, 1, 2 do
			local lift = if waving and side == 1 then 0.35 else 0
			local wcf = at(side * 1.15, 1.42 + lift * 0.6, 0.18) * A(0, side * -0.25, side * (0.32 + lift))
			add("Wing", "ball", V(1.75, 0.8, 0.1), wcf * CFrame.new(0, -0.12, 0), dark, "accent")
			if not lod then
				add("WingEdge", "ball", V(1.75, 0.13, 0.15), wcf * CFrame.new(0, 0.25, 0), rim, "accent")
			end
			star(wcf * CFrame.new(side * 0.35, -0.1, -0.08), 0.15, rim)
		end
		add("Tail", "ball", V(0.14, 0.14, 0.6), at(0, 0.62, 0.62) * A(0.4, 0, 0), base, "body")
		head(V(1.3, 1.15, 1.2), 0, 1.92, -0.1)
		add("Beak", "ball", V(0.36, 0.3, 1.05), hp(0, -0.22, -0.82, 0.12, 0, 0), rim, "accent")
		add("Crest", "ball", V(0.14, 0.45, 0.95), hp(0, 0.42, 0.55, -0.5, 0, 0), rim, "accent")
		face(0.12)
		radius = 1.4
	end

	-- Skeleton: dark rib stripes around the torso (rings follow the ellipsoid so they sit on its surface)
	if trait == "Skeleton" and not tiny and bodyPart then
		local long = bodySize.Z > bodySize.Y * 1.2
		for i = 1, 3 do
			local t = (i - 2) * 0.24 + (if long then -0.1 else 0.05)
			local f = math.sqrt(math.max(0.05, 1 - (t * 2) ^ 2)) * 1.04
			if long then
				add("Rib", "ball", V(bodySize.X * f, bodySize.Y * f, 0.09), bodyCF * CFrame.new(0, 0, t * bodySize.Z), SOCKET, "fixed")
			else
				add("Rib", "ball", V(bodySize.X * f, 0.09, bodySize.Z * f), bodyCF * CFrame.new(0, t * bodySize.Y, 0), SOCKET, "fixed")
			end
		end
	end

	-- SilverCosmic: purple / blue neon specks on the torso and head
	if trait == "SilverCosmic" and not tiny then
		for i = 1, (if lod then 2 else 4) do
			local onHead = i % 2 == 0
			local cf0 = if onHead then H else bodyCF
			local size = if onHead then headSize else bodySize
			local d = V(rng:NextNumber(-0.8, 0.8), rng:NextNumber(-0.3, 0.8), -1 - rng:NextNumber(0, 0.6)).Unit
			local r = 1 / math.sqrt((d.X / (size.X / 2)) ^ 2 + (d.Y / (size.Y / 2)) ^ 2 + (d.Z / (size.Z / 2)) ^ 2)
			if onHead then
				d = V(if math.abs(d.X) < 0.45 then d.X + 0.6 else d.X, d.Y, d.Z).Unit -- keep specks off the eyes
				r = 1 / math.sqrt((d.X / (size.X / 2)) ^ 2 + (d.Y / (size.Y / 2)) ^ 2 + (d.Z / (size.Z / 2)) ^ 2)
			end
			add("Speck", "ball", V(0.12, 0.12, 0.12), cf0 * CFrame.new(d * r), COSMIC[i % #COSMIC + 1], "fixed", true)
		end
	end

	-- glints (show in viewports) and sparkles for the special variants
	local special = trait == "Golden" or trait == "Rainbow" or trait == "SilverCosmic"
	if special and not tiny then
		local hy = H.Position.Y
		for i = 1, 2 do
			local g = add("Glint", "block", V(0.12, 0.12, 0.04), CFrame.new((i * 2 - 3) * (headSize.X * 0.5 + 0.12), hy + 0.55 - i * 0.2, H.Position.Z - 0.3) * A(0, 0, R45), WHITE, "fixed", true)
			g.Transparency = 0.1
		end
	end
	if (trait == "Rainbow" or trait == "SilverCosmic") and o.NoFx ~= true and not lod and bodyPart then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = if trait == "Rainbow" then Color3.fromHSV(hue0, 0.4, 1) else COSMIC[1]
		CollectionService:AddTag(sparkles, "PetSparkle") -- Low Effects turns it off (client PetSparkle)
		sparkles.Parent = bodyPart
	end

	-- rarity: Uncommon+ soft aura ring and light in the rarity colour; Legendary adds gold beams
	local rc: Color3? = (Config.RarityColors :: any)[rarity]
	if rc and rarity ~= "Common" and o.NoFx ~= true and not tiny then
		local ring = add("Aura", "cyl", V(0.05, 2.2 * radius, 2.2 * radius), CFrame.new(0, 0.03, 0) * A(0, 0, math.rad(90)), rc, "fixed", true)
		ring.Transparency = 0.55
		if o.NoLight ~= true and bodyPart then
			local pl = Instance.new("PointLight")
			pl.Color = rc
			pl.Brightness = if rarity == "Legendary" then 1.4 else 0.7
			pl.Range = 5 * s + 2
			pl.Shadows = false
			CollectionService:AddTag(pl, "PetSparkle")
			pl.Parent = bodyPart
		end
		if rarity == "Legendary" and not lod then
			-- beams don't render in ViewportFrames (RevealView draws its own rays) and add nothing to the bounding box
			for i = 1, 3 do
				local a = i / 3 * math.pi * 2
				local a0 = Instance.new("Attachment")
				a0.Position = Vector3.new(0, math.cos(a) * 0.8, math.sin(a) * 0.8) * s
				a0.Parent = ring
				local a1 = Instance.new("Attachment")
				a1.Position = Vector3.new(5, math.cos(a) * 0.9, math.sin(a) * 0.9) * s -- ring local X is world up
				a1.Parent = ring
				local b = Instance.new("Beam")
				b.Attachment0 = a0
				b.Attachment1 = a1
				b.Color = ColorSequence.new(GOLD)
				b.Transparency = NumberSequence.new(0.35, 1)
				b.LightEmission = 1
				b.FaceCamera = true
				b.Width0 = 0.35 * s
				b.Width1 = 0.1 * s
				b.Segments = 1
				CollectionService:AddTag(b, "PetSparkle")
				b.Parent = ring
			end
		end
	end

	model:SetAttribute("Radius", radius * s)
	model:SetAttribute("CentreY", bodyCF.Position.Y * s)
	model:SetAttribute("Height", (H.Position.Y + headSize.Y / 2) * s)
	model:SetAttribute("Kind", kind)
	model.WorldPivot = CFrame.new()
	addRaritySparkle(bodyPart, rarity, o)
	addShinyFx(bodyPart, spec, o)
	addEvolveGlow(model, spec, o)
	return model
end

-- Scales a built pet so its bounding box is `height` studs tall and its footprint is at most `maxWidth` across
-- (wide-winged pets like the Griffin would otherwise dwarf their owner), and refreshes the Radius / CentreY / Height
-- attributes to the new size. Returns the scale factor applied.
function PetModel.fitHeight(model: Model, height: number, maxWidth: number?): number
	local _, size = model:GetBoundingBox()
	if size.Y < 0.05 then
		return 1
	end
	local k = height / size.Y
	local wide = math.max(size.X, size.Z) * k
	if maxWidth and wide > maxWidth then
		k *= maxWidth / wide
	end
	local ok = pcall(function()
		model:ScaleTo(model:GetScale() * k)
	end)
	if not ok then
		return 1
	end
	for _, name in { "Radius", "CentreY", "Height" } do
		local v = model:GetAttribute(name)
		if type(v) == "number" then
			model:SetAttribute(name, v * k)
		end
	end
	return k
end

-- Display name of a species ("Frost Wyvern"), falling back to the id.
function PetModel.name(mineral: any): string
	local m = (Config.Minerals :: any)[mineral]
	return if m then m.Name else tostring(mineral)
end

return PetModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="169">
        <Properties>
          <string name="Name">PetPose</string>
          <string name="Source"><![CDATA[--!strict
-- Pure pose maths for the real pet meshes (tests/test_pet_pose.luau). ReplicatedStorage.PetMotion (tools/owner/
-- PetMotion.luau) is the thin Roblox side: it finds the bones, works out where the pet faces and what it looks at,
-- calls PetPose.step every frame and writes the channels to the bones. Everything that decides HOW a pet moves is here.
--
-- Channels (radians unless noted; + pitch = nose / tip DOWN, + yaw = toward +X, wing + = tips up, mirrored L/R):
--   rootY studs up, rootZ studs forward, rootP, rootYaw, rootR, legFL, legFR, legBL, legBR, tailP, tailY,
--   headP, headY, headR, arms, wing.
--
-- Body types (gaits) so pets stop all walking the same:
--   quad   dogs, cats, deer, griffins: diagonal trot.
--   biped  raptors, T-Rex, ostriches: two legs, leans forward, head pumps with each step.
--   heavy  mammoth, bear, panda, turtle, golem: slow wide steps, side-to-side sway, small bob.
--   hopper bunny, frog, owl: moves in hops (legs together), never trots.
--   waddle penguin: tiny steps, big side-to-side rock.
-- Steps follow how fast the pet really moves (no feet sliding over the ground) up to a cap, and the shared clips
-- (PetClips) scale their root moves with the pet's height, so a small pet does not jump three times its size.
-- Owner rules: no mouth or beak opening (there is no jaw channel), no roar.

local PetClips = require(script.Parent.PetClips)

local PetPose = {}

PetPose.CH = { "rootY", "rootZ", "rootP", "rootYaw", "rootR", "legFL", "legFR", "legBL", "legBR",
	"tailP", "tailY", "headP", "headY", "headR", "arms", "wing" }
local CH = PetPose.CH

PetPose.Clips = PetClips
PetPose.CLIP_HEIGHT = 2.4 -- studs: the pet height the clips were made for
PetPose.LEG_MAX = 0.5 -- radians: single-bone legs stretch the hip past this, so every leg channel is clamped to it
PetPose.HOP_TIME = 0.95 -- hatch / celebrate / spin hop length (s)
PetPose.SIT_AFTER = 7 -- seconds standing still before a pet sits
PetPose.SIT_DROP_MAX = 0.3 -- studs a sitting pet lowers at most
PetPose.FADE = 0.2 -- clip cross-fade (s)
PetPose.WING_MIN = -0.3 -- wing angle limits (rad); bigger angles stretch the wing skin
PetPose.WING_MAX = 0.7
PetPose.WING_SPEED = 4.5 -- rad/s: fastest a wing may swing

export type Gait = {
	cycle: number, -- ground covered per full step cycle, in pet heights
	swing: number, -- leg swing (radians)
	bob: number, -- body bob per step, in pet heights
	roll: number, -- side roll per step (radians)
	twist: number, -- body yaw per step (radians)
	lean: number, -- forward lean while moving (radians)
	headPump: number, -- head nod per step (radians)
	minRate: number, -- step clock while moving with no measurable speed (rad/s)
	maxRate: number, -- step clock cap (rad/s): faster than this the pet slides a little instead of buzzing
	hop: boolean?, -- moves in hops (legs together) instead of steps
	hopHeight: number?, -- hop height, in pet heights
}

PetPose.GAITS = {
	quad = { cycle = 0.85, swing = 0.42, bob = 0.03, roll = 0.045, twist = 0.05, lean = 0.07, headPump = 0.05, minRate = 9, maxRate = 17 },
	biped = { cycle = 0.8, swing = 0.45, bob = 0.04, roll = 0.06, twist = 0.07, lean = 0.12, headPump = 0.1, minRate = 9, maxRate = 18 },
	heavy = { cycle = 0.6, swing = 0.3, bob = 0.015, roll = 0.08, twist = 0.04, lean = 0.03, headPump = 0.04, minRate = 6, maxRate = 12 },
	hopper = { cycle = 0.9, swing = 0.4, bob = 0, roll = 0.02, twist = 0.02, lean = 0.05, headPump = 0.06, minRate = 8, maxRate = 14, hop = true, hopHeight = 0.12 },
	waddle = { cycle = 0.35, swing = 0.22, bob = 0.012, roll = 0.24, twist = 0.12, lean = 0.02, headPump = 0.03, minRate = 10, maxRate = 18 },
} :: { [string]: Gait }

-- Species id -> gait, for the pets whose body is not what Config Kind says (Kind is the old procedural stand-in body).
PetPose.SPECIES_GAIT = {
	-- two legs (Studio rig check 2026-10-15): raptors, rexes, birds
	Raptor = "biped", Ostrich = "biped", LavaTRex = "biped", Mosswhip = "biped", Shiverclaw = "biped", Emberclaw = "biped",
	Nebuclaw = "biped", Thornhoof = "biped", Flarestrut = "biped", GalaxyStrut = "biped", Puffquill = "biped",
	Phoenix = "biped", Zapstar = "biped", Hailwing = "biped", Embergeist = "biped", Voltwing = "biped",
	Bramblebat = "biped", Ashwing = "biped", StarPterodactyl = "biped",
	-- big and slow
	Mammoth = "heavy", Pebblehorn = "heavy", Oakmaw = "heavy", Yetiboo = "heavy", Obsidihorn = "heavy", Magmaw = "heavy",
	LunarTusk = "heavy", Panda = "heavy", Mossback = "heavy",
	Turtle = "heavy",
	Bunny = "hopper", Frog = "hopper", Moonhoot = "hopper", AuroraHoot = "hopper",
	Waddlefrost = "waddle",
} :: { [string]: string }
-- Words in a display name or model name that give the body away (checked when the id is not listed above).
local NAME_GAIT = {
	{ "bear", "heavy" }, { "panda", "heavy" }, { "turtle", "heavy" }, { "golem", "heavy" }, { "tusk", "heavy" },
	{ "mammoth", "heavy" }, { "bunny", "hopper" }, { "rabbit", "hopper" }, { "frog", "hopper" }, { "owl", "hopper" },
	{ "hoot", "hopper" }, { "penguin", "waddle" }, { "waddle", "waddle" }, { "raptor", "biped" }, { "rex", "biped" },
	{ "ostrich", "biped" }, { "strut", "biped" },
}
local KIND_GAIT = { raptor = "biped", ostrich = "biped", trex = "biped", mammoth = "heavy" }

-- The gait name for a pet. `id` = species id, `name` = display or model name, `kind` = Config Kind, `backLegs` =
-- whether the rig has LegBL/LegBR (nil = unknown). A model attribute "Gait" (checked by PetMotion first) wins over all.
function PetPose.gaitFor(id: string?, name: string?, kind: string?, backLegs: boolean?): string
	if id and PetPose.SPECIES_GAIT[id] then
		return PetPose.SPECIES_GAIT[id]
	end
	local low = string.lower((name or "") .. " " .. (id or ""))
	for _, pair in NAME_GAIT do
		if string.find(low, pair[1], 1, true) then
			return pair[2]
		end
	end
	if backLegs == false then
		return "biped"
	end
	if kind and KIND_GAIT[kind] and backLegs == nil then
		return KIND_GAIT[kind]
	end
	return "quad"
end

local function smooth01(x: number): number
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end
PetPose.smooth01 = smooth01

-- Channel values of clip c at time t (loops wrap, one-shots clamp), eased between keys.
function PetPose.sampleClip(c: any, t: number, out: { [string]: number })
	local keys = c.keys
	t = if c.loop then t % c.dur else math.clamp(t, 0, c.dur)
	local a, b, k = keys[#keys], keys[#keys], 0
	for i = 1, #keys - 1 do
		if t >= keys[i].t and t <= keys[i + 1].t then
			a, b = keys[i], keys[i + 1]
			k = smooth01((t - a.t) / math.max(b.t - a.t, 1e-6))
			break
		end
	end
	for _, ch in CH do
		local va, vb = a[ch] or 0, b[ch] or 0
		out[ch] = va + (vb - va) * k
	end
end

-- One hop: height (in clip studs), squash (+ = crouched), pitch (+ = nose down).
function PetPose.hopCurve(p: number): (number, number, number)
	if p < 0.18 then -- anticipation crouch
		local k = smooth01(p / 0.18)
		return -0.12 * k, k, 0.12 * k
	elseif p < 0.62 then -- airborne: fast up, hang, fall
		local k = (p - 0.18) / 0.44
		return 0.9 * math.sin(k * math.pi) - 0.12 * (1 - k) * (1 - k), 0, -0.22 * math.cos(k * math.pi)
	elseif p < 0.74 then -- landing squash
		local k = math.sin((p - 0.62) / 0.12 * math.pi)
		return -0.1 * k, 0.8 * k, 0.1 * k
	else -- settle with a small overshoot
		local k = math.min(1, (p - 0.74) / 0.21)
		return 0.03 * math.sin(k * math.pi) * (1 - k), 0, -0.03 * math.sin(k * math.pi * 2) * (1 - k)
	end
end

-- Step clock speed (rad/s) for a pet moving at `speed` studs/s. One full cycle (2 pi) covers gait.cycle * height
-- studs, so the feet keep up with the ground; with no measured speed (pets walking on the spot in a viewport) it is
-- the gait's minRate times walkRate. Capped at maxRate.
function PetPose.stepRate(g: Gait, speed: number, height: number, walkRate: number?): number
	local base = g.minRate * math.clamp(walkRate or 1, 0.5, 2)
	if speed <= 0.5 then
		return base
	end
	local r = 2 * math.pi * speed / math.max(g.cycle * height, 0.2)
	return math.clamp(r, g.minRate * 0.6, g.maxRate)
end

export type Input = {
	moving: boolean, -- the owner is walking (model attribute Moving)
	speed: number, -- measured ground speed, studs/s (0 = unknown / on the spot)
	height: number, -- pet height, studs
	gait: string,
	rigged: boolean, -- has bones (else a gentle whole-body bob)
	anim: string?, -- looping clip name (model attribute Anim), nil = procedural idle / walk
	walkRate: number?,
	sleepy: boolean?,
	aimYaw: number?, -- head turn toward a LookAt point (nil = nothing to look at)
	aimPitch: number?,
	yaw: number, -- current facing yaw (radians), for the tail follow-through on turns
}

export type State = { [string]: any }

function PetPose.new(seed: number?): State
	local r = seed or 0
	return {
		t = (r * 7.31) % 10, walk = 0, ph = 0, still = 0, sit = 0, sleep = 0,
		lookW = 0, lookYaw = 0, lookPitch = 0, yawRate = 0, tailYaw = 0, tailVel = 0, lastYaw = nil,
		happyWait = 3 + (r * 3.7) % 4, happyT = nil, pop = nil, popKind = nil,
		animName = nil, animT = 0, fromK = 1, fromV = {}, V = {}, L = {}, SV = {}, shot = nil, shotT = 0,
	}
end

-- Pops: "hatch" (crouch, hop, squash), "celebrate" (two hops with a spin), "spin" (one hop with a turn), "hop" (a
-- small hop; never cuts another pop short).
function PetPose.pop(s: State, kind: string)
	if kind == "hop" and s.pop then
		return
	end
	s.pop = 0
	s.popKind = kind
	s.shot = nil
end

-- One-shot clip (attack / hit / win) over whatever the pet is doing. Returns false for an unknown clip.
function PetPose.play(s: State, name: string): boolean
	if not PetClips[name] then
		return false
	end
	s.shot = name
	s.shotT = 0
	s.pop = nil
	return true
end

-- Advances the state by dt and returns the channel table (reused between calls; copy it to keep it).
function PetPose.step(s: State, i: Input, dt: number): { [string]: number }
	dt = math.clamp(dt, 0, 1 / 15)
	s.t += dt
	local t = s.t
	local g: Gait = PetPose.GAITS[i.gait] or PetPose.GAITS.quad
	local h = math.max(i.height, 0.3)
	local hs = h / PetPose.CLIP_HEIGHT -- root moves in clips and hops scale with the pet

	local target = if i.moving then 1 else 0
	s.walk += (target - s.walk) * math.min(1, dt * 6)
	local w = s.walk
	local idle = 1 - w
	-- the step clock keeps turning (slowly) into idle instead of freezing mid-stride
	local rate = PetPose.stepRate(g, i.speed, h, i.walkRate)
	s.ph += dt * (4 * idle + rate * w)
	local ph = s.ph

	-- sit after standing still a while; any move or hop stands it straight back up
	if not i.moving and not s.pop and not s.shot then
		s.still += dt
	else
		s.still = 0
	end
	local sitTarget = if s.still >= PetPose.SIT_AFTER and i.anim == nil then 1 else 0
	s.sit += (sitTarget - s.sit) * math.min(1, dt * (if sitTarget > s.sit then 3 else 10))
	local sit = s.sit

	-- happy idle: every 5-9 s of standing (not sitting), a 1.2 s burst of fast tail wag and quick wing beats
	s.happyWait -= dt * idle * (1 - sit)
	if s.happyWait <= 0 and not s.pop then
		s.happyT = 0
		s.happyWait = 5 + ((t * 13.7) % 4)
	end
	local happyFx = 0
	if s.happyT then
		s.happyT += dt
		if s.happyT >= 1.2 or w > 0.3 then
			s.happyT = nil
		else
			happyFx = math.sin(math.pi * s.happyT / 1.2) * idle
		end
	end

	-- turning: the tail swings out the other way on a spring, then settles (follow-through)
	if s.lastYaw then
		local d = (i.yaw - s.lastYaw + math.pi) % (2 * math.pi) - math.pi
		s.yawRate += (d / math.max(dt, 1e-3) - s.yawRate) * math.min(1, dt * 10)
	end
	s.lastYaw = i.yaw
	local tailTarget = math.clamp(-s.yawRate * 0.12, -0.5, 0.5)
	s.tailVel += ((tailTarget - s.tailYaw) * 60 - s.tailVel * 9) * dt
	s.tailYaw += s.tailVel * dt

	-- hatch / celebrate / spin / hop
	local hopY, squash, hopPitch, spin = 0, 0, 0, 0
	if s.pop then
		s.pop += dt
		local p = s.pop
		local dur = if s.popKind == "celebrate" then PetPose.HOP_TIME * 2 else PetPose.HOP_TIME
		if p >= dur then
			s.pop = nil
		else
			local q = p % PetPose.HOP_TIME
			hopY, squash, hopPitch = PetPose.hopCurve(q)
			if s.popKind == "hop" then
				hopY *= 0.6
				squash *= 0.6
				hopPitch *= 0.6
			end
			if (s.popKind == "celebrate" or s.popKind == "spin") and q > 0.18 and q < 0.62 then
				spin = smooth01((q - 0.18) / 0.44) * math.pi * 2
			end
		end
	end
	local air = if s.pop and hopY > 0 then math.min(1, hopY / 0.5) else 0

	-- sleepy (owner idle a long while): the head droops and the breathing slows
	s.sleep += ((if i.sleepy then 1 else 0) - s.sleep) * math.min(1, dt * 2)
	local sleep = s.sleep

	-- look at a point (the owner, a passer-by): small angles, eased in and out
	local aimYaw = if sleep < 0.5 then i.aimYaw else nil
	local k = math.min(1, dt * 4)
	s.lookW += ((if aimYaw then 1 else 0) - s.lookW) * k
	if aimYaw then
		s.lookYaw += (math.clamp(aimYaw, -0.6, 0.6) - s.lookYaw) * k
		s.lookPitch += (math.clamp(i.aimPitch or 0, -0.3, 0.2) - s.lookPitch) * k
	end
	local lw = s.lookW

	local L = s.L
	local sn = math.sin(ph)
	-- legs and body by gait
	local tuck = -0.35 * air + 0.25 * squash - 0.3 * sit
	local stepLift = 0 -- extra height from gait hops (studs)
	local stepPitch = 0
	if g.hop then
		-- hoppers: the cycle is one hop. Ground half (sin < 0): crouch, push; air half: legs tucked, nose up then down.
		local up = math.max(0, sn)
		local crouch = math.max(0, -sn)
		stepLift = up * (g.hopHeight or 0.12) * h * w
		stepPitch = (-0.12 * math.cos(ph) * up) * w
		L.legFL = (-0.3 * up + 0.2 * crouch) * w + tuck
		L.legFR = L.legFL
		L.legBL = (0.35 * crouch - 0.25 * up) * w + tuck - 0.25 * sit
		L.legBR = L.legBL
	else
		local swing = sn * g.swing * w
		L.legFL = -swing + tuck
		L.legFR = swing + tuck
		L.legBL = swing + tuck - 0.25 * sit
		L.legBR = -swing + tuck - 0.25 * sit
	end
	for _, leg in { "legFL", "legFR", "legBL", "legBR" } do
		L[leg] = math.clamp(L[leg], -PetPose.LEG_MAX, PetPose.LEG_MAX)
	end

	-- bob is lowest when the feet are spread, highest as they pass under; sway over the planted foot
	local bob = (1 - math.abs(sn)) * g.bob * h * w
	local breathe = math.sin(t * (2.4 - 1.2 * sleep)) * (0.015 + 0.01 * sleep) * hs * idle
	local roll = sn * g.roll * w
	local twist = sn * g.twist * w
	local lean = g.lean * w + hopPitch + stepPitch - 0.1 * sit

	-- tail: drags behind the body sway (phase-lagged), droops on landing, lifts in the air, wags when happy
	L.tailY = math.sin(ph - 1.1) * 0.22 * w + math.sin(t * 1.3) * 0.16 * idle + s.tailYaw - twist
		+ math.sin(t * 14) * 0.38 * happyFx
	L.tailP = math.sin(t * 0.9) * 0.04 * idle + math.sin(ph * 2 - 1.2) * 0.05 * w
		- 0.18 * squash + 0.15 * air - lean * 0.6 - 0.12 * sit

	-- little arms: bounce a beat after each step, flail up in the air
	L.arms = math.sin(t * 2.2) * 0.07 * idle + math.sin(ph * 2 - 0.9) * 0.14 * w - 0.5 * air + 0.2 * squash
	-- wings: slow breathing lift when idle, folded down while walking, about one slow full beat per second in the
	-- air and in the happy burst (fast beats looked like a buzz and sheared the wing skin; owner 2026-10-15)
	L.wing = math.sin(t * 1.8) * 0.22 * idle * (1 - sleep) - 0.18 * w + sn * 0.03 * w
		+ (0.35 + math.sin(t * 6) * 0.35) * air + (0.22 + math.sin(t * 6) * 0.3) * happyFx

	-- head: stays level while the body bobs (counter-rotates), pumps with the step, looks around when idle
	local glance = (math.sin(t * 0.55) + 0.5 * math.sin(t * 1.37)) * 0.3 * idle * (1 - sleep) * (1 - lw)
		+ s.lookYaw * lw
	L.headY = glance - twist * 0.8
	L.headR = math.sin(t * 1.1) * 0.07 * idle * (1 - lw) + 0.12 * sleep
	L.headP = math.sin(t * 1.7) * 0.04 * idle * (1 - sleep) + math.sin(ph * 2 - 0.5) * g.headPump * w - lean * 0.7
		+ 0.35 * sleep + math.sin(t * 1.2) * 0.04 * sleep + s.lookPitch * lw

	local bobAmt = if i.rigged then 0 else 0.05 * h
	L.rootY = math.sin(t * 2) * bobAmt * idle + bob + breathe + hopY * hs + stepLift
		- sit * math.min(h * 0.1, PetPose.SIT_DROP_MAX)
	L.rootZ, L.rootP, L.rootYaw, L.rootR = 0, lean, spin + twist, roll

	-- clips: a looping Anim (cross-faded in, out and between clips), then a one-shot on top
	local clip = if i.anim then PetClips[i.anim] else nil
	if i.anim ~= s.animName then
		-- snapshot what is showing now so the switch fades instead of popping
		for _, ch in CH do
			s.fromV[ch] = s.V[ch] or L[ch] or 0
		end
		s.fromK, s.animName, s.animT = 0, i.anim, 0
	end
	-- walk / run clips play faster or slower with the real speed, like the procedural steps
	local clipRate = 1
	if clip and (i.anim == "walk" or i.anim == "run") and i.speed > 0.5 then
		local natural = 2 * math.pi / clip.dur -- rad/s the clip was made at
		clipRate = math.clamp(PetPose.stepRate(g, i.speed, h, nil) / natural, 0.7, 1.8)
	end
	s.animT += dt * clipRate
	s.fromK = math.min(1, s.fromK + dt / PetPose.FADE)
	local V = s.V
	if clip then
		PetPose.sampleClip(clip, s.animT, V)
		V.rootY *= hs
		V.rootZ *= hs
		V.arms = L.arms -- clips have no arm channel: keep the procedural bounce
	else
		for _, ch in CH do
			V[ch] = L[ch] or 0
		end
	end
	if s.fromK < 1 then
		local kk = smooth01(s.fromK)
		for _, ch in CH do
			V[ch] = s.fromV[ch] + (V[ch] - s.fromV[ch]) * kk
		end
	end
	if s.shot then
		local c = PetClips[s.shot]
		s.shotT += dt
		if not c or s.shotT >= c.dur then
			s.shot = nil
		else
			local SV = s.SV
			PetPose.sampleClip(c, s.shotT, SV)
			SV.rootY *= hs
			SV.rootZ *= hs
			local kk = smooth01(s.shotT / 0.08) -- quick ease in; every one-shot ends on the rest pose
			for _, ch in CH do
				if ch ~= "arms" then
					V[ch] = V[ch] + (SV[ch] - V[ch]) * kk
				end
			end
			if s.shot == "win" then
				V.rootYaw = SV.rootYaw -- full spin: never blend the angle
			end
		end
	end
	for _, leg in { "legFL", "legFR", "legBL", "legBR" } do
		V[leg] = math.clamp(V[leg], -PetPose.LEG_MAX, PetPose.LEG_MAX)
	end
	-- wings follow on a soft spring with a speed cap, so clip snaps and beats ease in and out instead of jerking
	local wt = math.clamp(V.wing, PetPose.WING_MIN, PetPose.WING_MAX)
	local wv = s.wingV or wt
	wv += math.clamp((wt - wv) * math.min(1, dt * 12), -PetPose.WING_SPEED * dt, PetPose.WING_SPEED * dt)
	s.wingV = wv
	V.wing = wv
	return V
end

return PetPose
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="170">
        <Properties>
          <string name="Name">PetRules</string>
          <string name="Source"><![CDATA[--!strict
-- Pure pet rules shared by the server and the client (tested offline in tests/test_pet_rules.luau):
--   capacity     how many pets the Pet Book holds (Config.Inventory.Max plus extra slots a future game pass may add)
--   cleanName    the shape check of a pet nickname before the server runs Roblox text filtering on it
--   label        the name players see for a pet (its nickname, else its species name)
--   friendLuck   the friend bonus: extra Luck per Roblox friend in the same server, capped
--   kindOf       a pet's boost kind (Coins / Speed / Luck), which picks its glow colour and icon
--   level / sort / best   Pet Book sorting (rarity, level, type) and Equip Best
--   autoFollow   whether a newly gained pet joins the team (empty slot, or stronger than the weakest member)

local Config = require(script.Parent.Config)
local GeodeGen = require(script.Parent.GeodeGen)
local PetStats = require(script.Parent.PetStats)

local PetRules = {}

-- Pet Book size: the base storage plus `extra` slots (Profiles.petCapacity reads the save's ExtraPetSlots; anything
-- that is not a whole non-negative number counts as 0).
function PetRules.capacity(base: number, extra: any): number
	local n = if type(extra) == "number" and extra == extra and extra > 0 then math.floor(extra) else 0
	return base + math.min(n, 100000)
end

-- Trims and tidies a requested nickname. Returns (name, nil) when it may go to the text filter, ("", nil) to clear the
-- nickname, or (nil, reason) when it is refused before filtering. Letters, digits, spaces and a few marks only
-- (no line breaks, rich text or invisible characters), at most `max` characters.
function PetRules.cleanName(raw: any, max: number): (string?, string?)
	if type(raw) ~= "string" then
		return nil, "That name can't be used."
	end
	if #raw > max * 4 + 16 then
		return nil, "Names can be up to " .. max .. " letters."
	end
	if utf8.len(raw) == nil then
		return nil, "That name can't be used."
	end
	local s = string.gsub(raw, "%s+", " ")
	s = string.match(s, "^%s*(.-)%s*$") or ""
	if s == "" then
		return "", nil
	end
	if string.find(s, "[^%w %-_%.!%?']") then
		return nil, "Use letters, numbers and spaces only."
	end
	if #s > max then
		return nil, "Names can be up to " .. max .. " letters."
	end
	return s, nil
end

-- The filtered text must come back exactly as asked; anything the filter changed (hashed out) is refused rather than
-- saved with hash marks.
function PetRules.filterAccepted(asked: string, filtered: any): boolean
	return type(filtered) == "string" and filtered == asked and not string.find(filtered, "#", 1, true)
end

function PetRules.label(g: { [string]: any }, short: boolean?): string
	local nick = g.Nickname
	if type(nick) == "string" and nick ~= "" then
		return nick
	end
	return GeodeGen.displayName(g :: any, short)
end

-- Friend bonus: `per` extra Luck for each friend, counting at most `maxFriends` of them.
function PetRules.friendLuck(friends: number, per: number, maxFriends: number): number
	local n = math.clamp(math.floor(friends), 0, maxFriends)
	return math.floor(n * per * 1000 + 0.5) / 1000
end

function PetRules.kindOf(g: { [string]: any }): string
	local sp: any = (Config.Minerals :: any)[g.Mineral]
	local kind = sp and sp.BoostKind
	return if type(kind) == "string" and (Config.Pets.KindColors :: any)[kind] then kind else "Coins"
end

function PetRules.kindColor(kind: string): Color3
	local colors: any = Config.Pets.KindColors
	return colors[kind] or colors.Coins
end

-- The boost a pet shows in the Pet Book (species Boost + rarity bonus, before KindScale and caps).
function PetRules.boost(g: { [string]: any }): number
	local sp: any = (Config.Minerals :: any)[g.Mineral]
	return ((Config.Pets.RarityBoost :: any)[g.Rarity] or 0) + ((sp and sp.Boost) or 0)
end

-- A pet's level: from its TowerXP (the pet tower's curve, PetStats.level; Profiles copies it into the public view), else 1.
function PetRules.level(g: { [string]: any }): number
	local xp = g.TowerXP
	if type(xp) ~= "number" or xp ~= xp or xp <= 0 then
		return 1
	end
	return (PetStats.level(xp, PetStats.cap(g :: any))) -- the same level the pet tower shows (capped by rarity)
end

local RANK = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5 }
local KIND_ORDER = { Coins = 1, Speed = 2, Luck = 3 }

-- Pet Book sort: "Rarity" (rarest first), "Level" (highest first), "Type" (Coins, Speed, Luck; strongest first) or
-- anything else = newest first. Ties: newest, then id, so the order never jumps.
function PetRules.sort(list: { any }, by: string)
	table.sort(list, function(a, b)
		if by == "Rarity" then
			local ra, rb = RANK[a.Rarity] or 0, RANK[b.Rarity] or 0
			if ra ~= rb then
				return ra > rb
			end
		elseif by == "Level" then
			local la, lb = PetRules.level(a), PetRules.level(b)
			if la ~= lb then
				return la > lb
			end
			local ra, rb = RANK[a.Rarity] or 0, RANK[b.Rarity] or 0
			if ra ~= rb then
				return ra > rb
			end
		elseif by == "Type" then
			local ka, kb = KIND_ORDER[PetRules.kindOf(a)] or 9, KIND_ORDER[PetRules.kindOf(b)] or 9
			if ka ~= kb then
				return ka < kb
			end
			local ba, bb = PetRules.boost(a), PetRules.boost(b)
			if ba ~= bb then
				return ba > bb
			end
		end
		local fa, fb = tonumber(a.Found) or 0, tonumber(b.Found) or 0
		if fa ~= fb then
			return fa > fb
		end
		return tostring(a.Id) < tostring(b.Id)
	end)
end

-- Equip Best: the ids of the `slots` owned pets with the highest POWER (PetStats.powerOfPet; `xpBook` = the save's
-- TowerXP by pet id, for server rows that do not carry it). Ties: higher boost, level, value, then id.
function PetRules.best(pets: { any }, slots: number, xpBook: { [string]: number }?): { string }
	local list = {}
	local power: { [any]: number } = {}
	for _, g in pets do
		if type(g) == "table" and type(g.Id) == "string" then
			table.insert(list, g)
			local xp = if xpBook then xpBook[g.Id] else nil
			power[g] = PetStats.powerOfPet(g, if type(xp) == "number" then xp else nil)
		end
	end
	table.sort(list, function(a, b)
		-- carter's pick (2026-10-14): the biggest POWER wins (bigger = better); the hunt bonus breaks ties
		if power[a] ~= power[b] then
			return power[a] > power[b]
		end
		local ba, bb = PetRules.boost(a), PetRules.boost(b)
		if ba ~= bb then
			return ba > bb
		end
		local la, lb = PetRules.level(a), PetRules.level(b)
		if la ~= lb then
			return la > lb
		end
		local va, vb = tonumber(a.Value) or 0, tonumber(b.Value) or 0
		if va ~= vb then
			return va > vb
		end
		return a.Id < b.Id
	end)
	local out = {}
	for i = 1, math.min(slots, #list) do
		out[i] = list[i].Id
	end
	return out
end

-- The team slot a full team swaps when a new pet joins: the slot the player picked (1..size), else nil (no silent
-- replace: the server refuses and MY PETS asks which slot).
function PetRules.swapSlot(pick: any, size: number): number?
	if type(pick) ~= "number" or pick ~= pick or pick % 1 ~= 0 or pick < 1 or pick > size then
		return nil
	end
	return pick
end

-- A newly hatched / found pet joins the team when a slot is empty, or, on a full team, when `powerOf` (POWER by pet id)
-- says it is stronger than the weakest team member, which it replaces. A fresh Common never pushes out a stronger pet,
-- and a stronger new pet is never left off (bug: 193 off the team, 156 on). Edits `equipped` in place; true = joined.
function PetRules.autoFollow(equipped: { string }, id: string, slots: number, powerOf: ((string) -> number)?): boolean
	if table.find(equipped, id) then
		return false
	end
	if #equipped < slots then
		table.insert(equipped, id)
		return true
	end
	if not powerOf or slots <= 0 then
		return false
	end
	local weakest, weakPower = nil, math.huge
	for i = 1, math.min(#equipped, slots) do
		local p = powerOf(equipped[i])
		if p < weakPower then
			weakest, weakPower = i, p
		end
	end
	if weakest and powerOf(id) > weakPower then
		equipped[weakest] = id
		return true
	end
	return false
end

-- MAX level is not a dead end (evolve is off, carter 2026-10-16): XP a team pet can no longer use (it is at its rarity
-- cap) goes to the other team pets that still have room, split evenly, so hunting and fighting with a maxed pet still
-- trains the rest of the team. `room(id)` = XP the pet can still take before its cap (0 = maxed). Pets off the team keep
-- the old rule (only `target` grows). Returns { [id] = gain }; XP no team pet can use is dropped.
function PetRules.spillXp(target: string, amount: number, team: { string }, room: (string) -> number): { [string]: number }
	local out: { [string]: number } = {}
	amount = math.max(math.floor(tonumber(amount) or 0), 0)
	if amount <= 0 then
		return out
	end
	if not table.find(team, target) then
		out[target] = amount
		return out
	end
	local left: { [string]: number } = {}
	local first = math.min(amount, math.max(room(target), 0))
	if first > 0 then
		out[target] = first
	end
	local over = amount - first
	local open: { string } = {}
	for _, id in team do
		if id ~= target and not left[id] then
			local r = math.max(math.floor(room(id)), 0)
			if r > 0 then
				left[id] = r
				table.insert(open, id)
			end
		end
	end
	while over > 0 and #open > 0 do
		local share, extra = over // #open, over % #open
		local still: { string } = {}
		for i, id in open do
			local give = math.min(share + (if i <= extra then 1 else 0), left[id])
			if give > 0 then
				out[id] = (out[id] or 0) + give
				left[id] -= give
				over -= give
			end
			if left[id] > 0 then
				table.insert(still, id)
			end
		end
		open = still -- every pass hands out at least 1 XP, so this ends
	end
	return out
end

-- After a team pet is sold, the empty team slots fill with the strongest owned pets not on the team (PetRules.best
-- order), so the team never sits at 2 while a strong pet waits in the Pet Book. Edits `equipped`; returns how many joined.
function PetRules.fillTeam(equipped: { string }, pets: { any }, slots: number, xpBook: { [string]: number }?): number
	local added = 0
	for _, id in PetRules.best(pets, #pets, xpBook) do
		if #equipped >= slots then
			break
		end
		if not table.find(equipped, id) then
			table.insert(equipped, id)
			added += 1
		end
	end
	return added
end

return PetRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="171">
