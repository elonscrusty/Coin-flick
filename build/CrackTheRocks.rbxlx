	-- Space pets added 2026-10-11 (Kind = a stand-in body until the owner's mesh exists; REPLACE: Pet_<id> under PetModels).
	Cometpup = { Name = "Cometpup", Kind = "wolf", Crystal = Color3.fromRGB(60, 70, 140), Rim = Color3.fromRGB(170, 230, 255), BoostKind = "Speed", Boost = 0.08 },
	Moonhoot = { Name = "Moon Owl", Kind = "griffin", Crystal = Color3.fromRGB(200, 200, 230), Rim = Color3.fromRGB(140, 120, 255), BoostKind = "Luck", Boost = 0.08 },
	Nebuclaw = { Name = "Nebuclaw", Kind = "raptor", Crystal = Color3.fromRGB(130, 60, 180), Rim = Color3.fromRGB(255, 150, 230), BoostKind = "Speed", Boost = 0.08 },
	LunarTusk = { Name = "Lunar Tusk", Kind = "mammoth", Crystal = Color3.fromRGB(180, 185, 200), Rim = Color3.fromRGB(120, 200, 255), BoostKind = "Coins", Boost = 0.08 },
	GalaxyStrut = { Name = "Galaxy Strut", Kind = "ostrich", Crystal = Color3.fromRGB(40, 30, 90), Rim = Color3.fromRGB(255, 120, 220), BoostKind = "Coins", Boost = 0.08 },
	Zapstar = { Name = "Zapstar", Kind = "pterodactyl", Crystal = Color3.fromRGB(250, 230, 80), Rim = Color3.fromRGB(120, 140, 255), BoostKind = "Speed", Boost = 0.08, Weekly = true },
	QuasarRex = { Name = "Quasar Rex", Kind = "trex", Crystal = Color3.fromRGB(30, 30, 60), Rim = Color3.fromRGB(120, 255, 240), BoostKind = "Coins", Boost = 0.08, Weekly = true },
	-- Tower-only pets (owner pick 2026-10-11): won in the pet tower, never in a hunt pile (no zone lists them).
	-- Kind reuses a hunt body as a stand-in until real meshes exist (REPLACE: Pet_<id> under PetModels).
	Thornback = { Name = "Thornback", Kind = "trex", Crystal = Color3.fromRGB(70, 150, 60), Rim = Color3.fromRGB(200, 240, 120), BoostKind = "Coins", Boost = 0.03, TowerOnly = true, Element = "Nature" },
	Frostbyte = { Name = "Frostbyte", Kind = "wolf", Crystal = Color3.fromRGB(150, 220, 255), Rim = Color3.fromRGB(240, 250, 255), BoostKind = "Speed", Boost = 0.04, TowerOnly = true, Element = "Ice" },
	Voltwing = { Name = "Storm Eagle", Kind = "griffin", Crystal = Color3.fromRGB(250, 220, 60), Rim = Color3.fromRGB(120, 200, 255), BoostKind = "Speed", Boost = 0.05, TowerOnly = true, Element = "Storm" },
	Embergeist = { Name = "Embergeist", Kind = "phoenix", Crystal = Color3.fromRGB(255, 120, 40), Rim = Color3.fromRGB(255, 230, 120), BoostKind = "Coins", Boost = 0.06, TowerOnly = true, Element = "Fire" },
	AstralKitsune = { Name = "Astral Kitsune", Kind = "wolf", Crystal = Color3.fromRGB(150, 90, 230), Rim = Color3.fromRGB(255, 220, 255), BoostKind = "Luck", Boost = 0.1, TowerOnly = true, Element = "Cosmic" },
	-- owner's new low-poly pets with no older species to take over (2026-10-13)
	Bunny = { Name = "Bunny", Kind = "wolf", Crystal = Color3.fromRGB(245, 240, 235), Rim = Color3.fromRGB(255, 190, 210), BoostKind = "Speed", Boost = 0.01 },
	Frog = { Name = "Frog", Kind = "raptor", Crystal = Color3.fromRGB(110, 190, 70), Rim = Color3.fromRGB(230, 250, 140), BoostKind = "Coins", Boost = 0.01 },
	Panda = { Name = "Panda", Kind = "mammoth", Crystal = Color3.fromRGB(245, 245, 245), Rim = Color3.fromRGB(60, 60, 70), BoostKind = "Luck", Boost = 0.02 },
	Turtle = { Name = "Turtle", Kind = "mammoth", Crystal = Color3.fromRGB(110, 140, 70), Rim = Color3.fromRGB(205, 190, 140), BoostKind = "Luck", Boost = 0.01 }, -- owner 2026-10-15: "bring the turtle back" (Pet_Turtle mesh)
	Shark = { Name = "Ice Shark", Kind = "raptor", Crystal = Color3.fromRGB(90, 140, 190), Rim = Color3.fromRGB(220, 240, 255), BoostKind = "Speed", Boost = 0.04 },
}
-- Chase pets (Chase = true): a zone's one Legendary-only species. A Legendary hatch in that zone is always its chase
-- pet and the chase pet is never anything but Legendary, so each one is exactly the 1 in 1000 roll (Void Dragon in
-- Space, owner pick). Every other species of the zone shares the remaining odds equally (SpeciesPool).
-- New pet every week (owner pick): species marked Weekly = true unlock one per week in the Order below, the first at
-- Start (UTC unix seconds), the next 7 days later, and so on. Start = 0 keeps every weekly pet hidden (not in piles,
-- odds, Pet Book or badges) until the owner sets the launch date (docs/OWNER_STEPS.md "Weekly pets").
Config.WeeklyPets = {
	Start = 0,
	Days = 7,
	Order = { "Clovercrest", "Hollowfang", "Waddlefrost", "Flarestrut", "Zapstar", "Bramblebat", "Mossback", "Hailwing", "Ashwing", "QuasarRex" },
}

-- Old geode saves name minerals; Profiles moves each to a pet of the same zone (docs/PET_MIGRATION in Profiles).
Config.MineralMigration = {
	Quartz = "Raptor", Amethyst = "Ostrich", Citrine = "Ostrich", RoseQuartz = "Raptor", Calcite = "Raptor",
	Fluorite = "Griffin", Celestite = "FrostWyvern", EmberQuartz = "Phoenix", Starstone = "Cometpup", VoidCrystal = "CosmicDragon",
}

-- Pets you own and show off. Slots = the ONE team: pets that follow you and fight (carter 2026-10-15: one team of 3). Pets are only found in hunts, never
-- sold for Robux, so their boosts are earned (never pay-to-win). Boost = (species Boost + RarityBoost[rarity]) *
-- KindScale[kind], summed over followers, capped at KindCap[kind]. Speed is kept small so new players can still win.
-- Lobby-only walk speed (MatchService; Roblox default is 16). Hunts use Config.Pets.BaseWalkSpeed.
Config.Lobby = { WalkSpeed = 18 }

-- The sleepy pet "Zzz" bubble (client/PetMoodFx). 2026-10-14 runner rounds: it pulled the eye, so it is half the old
-- 52 x 30 size and never fully opaque (Faint = the lowest text transparency).
Config.PetZzz = { Width = 26, Height = 16, TextSize = 12, Faint = 0.45 }

Config.Pets = {
	Slots = 3,
	RarityBoost = { Common = 0.03, Uncommon = 0.06, Rare = 0.1, Epic = 0.15, Legendary = 0.25 },
	KindScale = { Coins = 1, Speed = 0.4, Luck = 1 },
	KindCap = { Coins = 0.5, Speed = 0.15, Luck = 0.5 },
	AnnounceRarities = { Rare = true, Epic = true, Legendary = true }, -- whole-server message after the hatch
	BaseWalkSpeed = 18, -- hunt walk speed before the Speed boost (MatchService)
	Starter = "Raptor", -- every new player gets one Common Raptor so a pet follows them from minute one
	-- Free renaming (Pet Book detail): at most NameMax characters, filtered by Roblox (PetService), one rename per
	-- RenameCooldown seconds per player.
	NameMax = 20,
	RenameCooldown = 5,
	-- Pet type colours: the glow and icon on Pet Book cards and follower tags (BoostKind of the species).
	KindColors = {
		Coins = Color3.fromRGB(255, 196, 40),
		Speed = Color3.fromRGB(80, 200, 255),
		Luck = Color3.fromRGB(96, 220, 110),
	},
	-- Rarer pets are drawn a little bigger (PetModel multiplies its size by this; looks only, no gameplay effect).
	RarityScale = { Common = 1, Uncommon = 1.05, Rare = 1.12, Epic = 1.2, Legendary = 1.3 },
	-- Rarer pets sparkle (PetModel adds a Sparkles tagged "PetSparkle"; PetSparkle on the client turns them off
	-- with Settings.LowEffects). TimeScale < 1 = slower, calmer sparkles.
	Sparkle = {
		Rare = { Color = Color3.fromRGB(90, 170, 255), TimeScale = 0.6 },
		Epic = { Color = Color3.fromRGB(200, 110, 255), TimeScale = 0.8 },
		Legendary = { Color = Color3.fromRGB(255, 205, 60), TimeScale = 1 },
	},
}

-- Hatch reveal timing by rarity (owner pick: commons about 2 s, Rare and better about 6 s in slow motion with a
-- rarity glow, under a choir build-up; SoundConfig HatchChoir; pets never roar). RevealView plays
-- its animation in three parts: the egg drops in (Pre), wobbles, cracks and the pet pops (Slow), then rays and name
-- settle (Post); each value is real seconds. The server's Reveal phase lasts the total plus Hold (PetFlair).
Config.Hatch = {
	Normal = { Pre = 0.4, Slow = 0.9, Post = 0.7, Glow = false },
	Slow = { Pre = 0.6, Slow = 4.0, Post = 1.4, Glow = true },
	SlowRarities = { Rare = true, Epic = true, Legendary = true },
	Hold = 0.2,
}

-- Pet index rewards (PetIndex): coins the first time a species is hatched (once per species, paid inside the same
-- profile write that records the discovery, so it can never pay twice), and a title once every species is found.
-- FirstFindCoins is an in-game coin amount (never Robux), sized like the daily gift.
Config.PetIndex = { FirstFindCoins = 50, MasterTitle = "Pet Master" }

-- Rare hatch announcements (RareHatch). Same server: fireworks and a gold banner for everyone. Every other server:
-- the same banner (no fireworks) through MessagingService topic `Topic`. Payload = display name + pet name + rarity.
-- PublishGap: seconds between two publishes from this server; PlayerGap: per player. ReceiveGap: at most one
-- banner from other servers per this many seconds (extra ones are dropped). EchoSeconds: our own message coming
-- back from MessagingService within this time is ignored (the local banner already played).
Config.RareHatch = {
	Topic = "RareHatch",
	PublishGap = 6,
	PlayerGap = 30,
	ReceiveGap = 4,
	EchoSeconds = 30,
	NameMax = 32,
	PetMax = 48,
	BannerSeconds = 4.5,
	QueueMax = 3,
}

-- Material Discoveries (docs/m6/DISCOVERIES.md). Presentation only: which kind of ordinary stone a
-- player's own finished crush turns out to be. NO value, capacity, speed or currency changes: every ordinary
-- result is the same rubble unit as before. The category of a rock is fixed on the server per round + rock
-- (Materials.pick) and is only told to the player who completed that rock. Weights are relative.
-- Quartz chips are solid pieces (never a hollow geode); metallic specks are inclusions (never a gold nugget).
-- Thumbnails are drawn from Color / Accent / Look by ui/MaterialThumb (no asset ids).
Config.MaterialOrder = { "CommonStone", "QuartzFragment", "MetallicSpecks" }
Config.Materials = {
	CommonStone = {
		Id = "CommonStone", Name = "Plain Candy", Weight = 80, Look = "stone",
		Desc = "Sweet candy. Every egg you hatch leaves some.",
		Color = Color3.fromRGB(150, 148, 142), Accent = Color3.fromRGB(190, 188, 180),
	},
	QuartzFragment = {
		Id = "QuartzFragment", Name = "Sprinkle Candy", Weight = 15, Look = "chip",
		Desc = "Candy with sprinkles from a lucky egg.",
		Color = Color3.fromRGB(226, 214, 204), Accent = Color3.fromRGB(255, 250, 240),
	},
	MetallicSpecks = {
		Id = "MetallicSpecks", Name = "Golden Candy", Weight = 5, Look = "specks",
		Desc = "Shiny candy with golden flecks.",
		Color = Color3.fromRGB(128, 126, 122), Accent = Color3.fromRGB(226, 178, 84),
	},
}
-- Discovery notices from fast machines are merged into one card per this many seconds on the client.
Config.MaterialNoticeSeconds = 2.2

-- Specimens worth less than this fraction of their value cannot be "sold" twice etc. Sell price = value.
Config.Sell = { SpecimenFraction = 1 }

-- Match flow.
Config.Match = {
	CountdownSeconds = 3,
	WaitForMembersSeconds = 30,
	ManualRange = 14, -- client reach cue only; the server checks Config.Carry / Config.Station ranges
	RewardSaveTimeout = 15,
	RevealSeconds = 2.8, -- default reveal length; the hunt's Reveal phase uses PetFlair.revealSeconds(rarity) (Config.Hatch)
	ResultsReturnSeconds = 120, -- results screen; players may leave or rematch at any time
	MaxArenas = 6, -- single-place mode: concurrent private arenas in one server
	-- Phone speed: StreamingEnabled is off, so every built hunt arena (~1,600 parts) sits in every player's world. Arena
	-- slots above ArenaKeepWarm are torn down once they have stood empty for ArenaIdleSeconds (rebuilt on the next busy
	-- spell); the first ArenaKeepWarm slots stay built so a hunt starts without a build hitch. (tests/server/budget.luau)
	ArenaKeepWarm = 1,
	ArenaIdleSeconds = 90,
	CadenceTolerance = 0.3, -- network slack on strike cadence; eligible times still keep the true rate
	SettleSeconds = 0.4, -- client: rocks above a removed one settle over this long
	EggGravity = 90, -- client: studs/s^2 eggs fall with on the pile (shared/EggFall; real Roblox is 196, this is cartoon)
}

Config.Party = { MaxSize = 4, InviteSeconds = 60 }

-- First-time solo practice: a small pile on purpose (24 eggs; was 12, which read as a thin scatter on the meadow
-- mound, bug 245); the pet is still one of eggs 2-6 cracked, so the round stays short and the player always
-- cracks at least one ordinary egg (and sees shells) first.
Config.Tutorial = { Rocks = 24, TargetFrom = 2, TargetWithin = 6, Tier = "Gravel" }

-- Place topology. "SinglePlace" runs lobby and private arenas in one server (Phase 1, works in
-- Studio and live). "Teleport" (Phase 2) sends parties to a reserved Match place.
Config.Places = {
	Mode = "SinglePlace",
	LobbyPlaceId = 0,
	MatchPlaceId = 0,
	LobbyMaxPlayers = 12, -- owner: 12 per server (also set Max Players in Studio Game Settings)
	MatchMaxPlayers = 4,
}

-- Teleport mode only (Config.Places.Mode = "Teleport"). Seconds unless noted.
Config.Teleport = {
	ArriveSeconds = 180, -- first arrivals must reach the Match place within this of the ticket being made
	TicketSeconds = 3600, -- the whole ticket (reconnects included) dies after this
	MaxReconnects = 3, -- re-entries per member once they left a live Match server
	MaxRetries = 1, -- manual RETRY presses after a failed or partial teleport
	ReleaseAttempts = 4, -- save-and-release tries per profile before a teleport
	SentWatchdog = 25, -- a member still in the lobby this long after TeleportAsync counts as not sent
	AwayHoldSeconds = 900, -- lobby keeps a teleported party member's seat this long
	ReturnWatchdog = 25,
	LoadAttempts = 10, -- profile load tries on the Match server (lock waits after a teleport)
}

Config.Save = {
	StoreName = "CTR_Profiles_v1",
	LedgerName = "CTR_Ledger_v1",
	PendingName = "CTR_Pending_v1",
	AutosaveSeconds = 90,
	LockSeconds = 300, -- a lock older than this is treated as abandoned
	LoadAttempts = 7, -- profile load tries (lock held elsewhere / DataStore errors)
	SchemaVersion = 1,
	RecentAwardsKept = 50,
}

-- Cosmetic Robux products (launch rule: cosmetics only: no tool power, Cash, luck, hints or
-- speed). Every ProductId is 0 until the owner creates the Developer Product; with 0 the item
-- is hidden, and the whole Store tab is hidden when every id is 0. Prices are NOT set here:
-- once an id is real the client shows the price Roblox reports for the product, and until then
-- PriceText says "set by owner". Kinds: ToolSkin (recolours the held hammer / jackhammer) and
-- GalleryTheme (recolours the owner's own lobby alcove). See src/shared/Cosmetics.luau.
Config.CosmeticOrder = { "SkinCopper", "SkinNightSteel", "ThemeAmber", "ThemeGlacier" }
Config.Products = {
	SkinCopper = {
		Id = "SkinCopper", Kind = "ToolSkin", Name = "Copper Shine", ProductId = 0, PriceText = "set by owner",
		Desc = "Warm copper shine for your gear. Looks only: same power.",
		Head = Color3.fromRGB(184, 115, 51), Accent = Color3.fromRGB(232, 168, 110),
	},
	SkinNightSteel = {
		Id = "SkinNightSteel", Kind = "ToolSkin", Name = "Night Shine", ProductId = 0, PriceText = "set by owner",
		Desc = "Dark blue shine with bright edges. Looks only: same power.",
		Head = Color3.fromRGB(40, 48, 78), Accent = Color3.fromRGB(120, 160, 255),
	},
	ThemeAmber = {
		Id = "ThemeAmber", Kind = "GalleryTheme", Name = "Amber Glow", ProductId = 0, PriceText = "set by owner",
		Desc = "Warm amber frame and shelf lights for your gallery alcove.",
		Accent = Color3.fromRGB(255, 176, 64), Light = Color3.fromRGB(255, 196, 110),
	},
	ThemeGlacier = {
		Id = "ThemeGlacier", Kind = "GalleryTheme", Name = "Glacier Trim", ProductId = 0, PriceText = "set by owner",
		Desc = "Cool ice-blue frame and shelf lights for your gallery alcove.",
		Accent = Color3.fromRGB(96, 190, 230), Light = Color3.fromRGB(170, 230, 255),
	},
}
Config.CosmeticKinds = { ToolSkin = "Gear skin", GalleryTheme = "Gallery theme" }

-- Lobby leaderboards (OrderedDataStores; Studio adds "_Studio" to every store name). Writes
-- are throttled per board and only run while the request budget leaves MinBudget spare; a
-- stored value is never lowered or deleted. Rankings are never reset.
Config.Leaderboards = {
	StorePrefix = "CTR_LB_",
	Top = 10,
	RefreshSeconds = 60, -- how often the top lists are re-read
	WriteMinSeconds = 60, -- at most one write per player per board in this time
	FlushSeconds = 15,
	MinBudget = 8,
	NameFailRetrySeconds = 120,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="128">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[--!strict
-- Cosmetic catalogue rules (brief section 15: cosmetics only). Pure helpers over Config.Products
-- and the profile's Cosmetics table; nothing here can change power, Cash, luck or speed.
-- A cosmetic is visible (and buyable) only when its ProductId is a real id (> 0); with every id
-- at 0 the Store tab is hidden and the game works exactly as before.

local Config = require(script.Parent.Config)

local Cosmetics = {}

export type Entry = {
	Id: string,
	Kind: string,
	Name: string,
	Desc: string,
	ProductId: number,
	PriceText: string,
	Head: Color3?,
	Accent: Color3?,
	Light: Color3?,
}

function Cosmetics.get(id: any): Entry?
	if type(id) ~= "string" then
		return nil
	end
	return (Config.Products :: any)[id]
end

function Cosmetics.visible(entry: Entry?): boolean
	return entry ~= nil and type(entry.ProductId) == "number" and entry.ProductId > 0
end

-- Visible catalogue in display order, optionally one kind.
function Cosmetics.list(kind: string?): { Entry }
	local out = {}
	for _, id in Config.CosmeticOrder do
		local e = Cosmetics.get(id)
		if e and Cosmetics.visible(e) and (kind == nil or e.Kind == kind) then
			table.insert(out, e)
		end
	end
	return out
end

function Cosmetics.anyVisible(): boolean
	return #Cosmetics.list() > 0
end

function Cosmetics.byProductId(productId: number): Entry?
	for _, id in Config.CosmeticOrder do
		local e = Cosmetics.get(id)
		if e and Cosmetics.visible(e) and e.ProductId == productId then
			return e
		end
	end
	return nil
end

function Cosmetics.empty(): { Owned: { [string]: boolean }, Equipped: { [string]: string }, Receipts: { [string]: boolean }, ReceiptOrder: { string } }
	return { Owned = {}, Equipped = {}, Receipts = {}, ReceiptOrder = {} }
end

function Cosmetics.owned(state: any, id: string): boolean
	return type(state) == "table" and type(state.Owned) == "table" and state.Owned[id] == true
end

-- The equipped cosmetic of a kind, only if it still exists, is owned and is visible.
function Cosmetics.equipped(state: any, kind: string): Entry?
	if type(state) ~= "table" or type(state.Equipped) ~= "table" then
		return nil
	end
	local id = state.Equipped[kind]
	local e = Cosmetics.get(id)
	if e and e.Kind == kind and Cosmetics.visible(e) and Cosmetics.owned(state, e.Id) then
		return e
	end
	return nil
end

-- Remembers a receipt id (idempotency key) and trims the oldest beyond `keep`.
function Cosmetics.rememberReceipt(state: any, key: string, keep: number)
	if state.Receipts[key] then
		return
	end
	state.Receipts[key] = true
	table.insert(state.ReceiptOrder, key)
	while #state.ReceiptOrder > keep do
		local old = table.remove(state.ReceiptOrder, 1)
		if old then
			state.Receipts[old] = nil
		end
	end
end

-- Recolours a held tool model. Hammers: Head + faces; Jackhammer: Body + shaft. Only colour.
function Cosmetics.applyToolSkin(tool: Instance, skin: Entry?)
	if not skin or skin.Kind ~= "ToolSkin" then
		return
	end
	local head, accent = skin.Head, skin.Accent
	for _, d in tool:GetDescendants() do
		if d:IsA("BasePart") then
			-- Part tools: Head / Body, FaceL / FaceR / Shaft / Collar. Kit tools: the steel head or
			-- amber body is the head colour, the bright steel faces and the bit are the accent.
			local n = d.Name
			if (n == "Head" or n == "Body" or n == "Steel" or n == "Amber_SmoothPlastic") and head then
				d.Color = head
			elseif (n == "FaceL" or n == "FaceR" or n == "Shaft" or n == "Collar" or n == "SteelLight" or n == "Bit") and accent then
				d.Color = accent
			end
		end
	end
end

local DEFAULT_SIDE = Color3.fromRGB(168, 117, 72) -- V4 wood
local DEFAULT_LIGHT = Color3.fromRGB(255, 220, 150)

-- Recolours one lobby alcove (frame sides + shelf lights). theme = nil restores the default.
function Cosmetics.applyAlcoveTheme(alcove: Instance, theme: Entry?)
	local side = DEFAULT_SIDE
	local light = DEFAULT_LIGHT
	if theme and theme.Kind == "GalleryTheme" then
		side = theme.Accent or side
		light = theme.Light or light
	end
	for _, d in alcove:GetChildren() do
		if d:IsA("BasePart") then
			if d.Name == "SideL" or d.Name == "SideR" then
				d.Color = side
			elseif d.Name == "ShelfLight" then
				d.Color = light
			end
		end
	end
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="129">
        <Properties>
          <string name="Name">EggConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Tuning for the egg events (src/server/EggEvents.luau, src/client/EggFx.luau): the wobble hint and the
-- speed boots power-up. Kept out of Config.luau so it can change on its own.

local PetSoundIds = require(script.Parent.PetSoundIds)

local EggConfig = {}

EggConfig.Wobble = {
	Enabled = true,
	-- Seconds between two wobble picks in one match (a random gap in this range, decided on the server).
	MinGap = 3,
	MaxGap = 5,
	-- Chance that a pick is the pet egg (only while it is still in the pile). Otherwise a uniformly random
	-- other pile egg wobbles. Small on purpose: one wobble says almost nothing about the pet egg.
	TargetChance = 0.25,
	-- Slow tiers wobble at the slower Meadow gap below with a slightly higher pet egg chance (the first zone is the
	-- easiest), but decoy wobbles are mixed in everywhere: pet-only wobbles would let a few patches intersect on
	-- the pet egg. Wobbles also go on after the pet egg left the pile. Code tier ids: Gravel = Meadow.
	SlowTiers = { Gravel = true } :: { [string]: boolean },
	MeadowTargetChance = 0.35,
	MeadowMinGap = 8,
	MeadowMaxGap = 12,
	-- Patch hint (owner pick 2026-10-11): a wobble never names one egg. The server takes the pick above as an
	-- anchor, moves PatchJitterMin..PatchJitterMax studs from it in a random flat direction, and every pile egg
	-- within PatchRadius of that point wobbles together (at most PatchMax, listed by id). The jitter range goes
	-- past the radius, so the anchor is OUTSIDE its own patch most of the time (here 5 times in 8) and
	-- intersecting patches does not single it out.
	PatchRadius = 3.5,
	PatchJitterMin = 2,
	PatchJitterMax = 6,
	PatchMax = 8,
	-- Client animation.
	Seconds = 0.7,
	Degrees = 13,
	Shakes = 3,
}

-- Overtime (owner pick 2026-10-11): when a round has been Searching for RoundSeconds, the pet egg glows gold for
-- everyone so the race finishes and there is always a winner. Only then is the pet egg's id sent, and only while it
-- is in the pile: if it is carried or on a nest at that moment, the glow waits until it is back in the pile (the
-- wobbles keep going meanwhile). Never in the practice round.
EggConfig.Overtime = {
	Enabled = true,
	RoundSeconds = 180,
	GlowColor = Color3.fromRGB(255, 205, 60),
}

EggConfig.Chirp = {
	Enabled = true,
	-- Every MinGap..MaxGap seconds (random, server) each player near the pile may hear ONE chirp (Chance) from an
	-- egg still in the pile within Radius studs of them. The chirping egg is the pet egg with TargetChance when it
	-- is that close, otherwise a random nearby decoy egg, so hearing a chirp does not mean the pet egg is near, and
	-- many chirps do not average out on it. Never in the practice round.
	Radius = 8,
	MinGap = 3,
	MaxGap = 6,
	Chance = 0.6,
	TargetChance = 0.3,
	-- The sound plays at a point Jitter studs (random direction, flat) away from the chirping egg (more than half
	-- the Radius), so it points at an area of the pile, not at one egg. No egg id is ever sent.
	JitterMin = 3,
	JitterMax = 6,
	-- PetSoundIds.EggChirp (uploaded by tools/upload_audio.py). 0 = no sound (only the note sparkle shows).
	SoundId = PetSoundIds.EggChirp,
	Volume = 0.6,
	RollOff = 24, -- studs: the 3D sound fades out past this
}

EggConfig.Boots = {
	Enabled = true,
	-- Chance per ordinary egg a player finishes cracking (rolled on the server).
	Chance = 0.04,
	Seconds = 8,
	Bonus = 0.5, -- +50% walk speed while boosted (owner pick 2026-10-11)
	-- Unused by the boost now: the boots multiply the hunter's current walk speed (pet bonus included) and restore it.
	BaseWalkSpeed = 18,
}

return EggConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="130">
        <Properties>
          <string name="Name">EggFall</string>
          <string name="Source"><![CDATA[--!strict
-- Egg gravity for the hunt pile (carter 2026-10-16: "the eggs during the hunt should have gravity"). Pure maths, tested
-- in tests/test_egg_fall.luau; the client (PileView) samples it, the server never moves eggs.
--
-- An egg that moves on the pile (it settles when the egg under it is taken, a returned egg drops back on, the gold
-- overtime egg hops to the edge) flies a real gravity path: it speeds up as it falls (never eases in to land softly,
-- which read as floating), lands, then makes one small bounce. A move that goes up or sideways first hops over the
-- mound in a parabola. No physics engine: the pile stays deterministic and costs nothing per frame when still.

local EggFall = {}

export type Plan = {
	From: Vector3,
	To: Vector3,
	G: number, -- gravity, studs/s^2
	Vy0: number, -- launch speed up (0 for a plain drop)
	Flight: number, -- seconds from start to first touch-down
	Hop: number, -- bounce speed up at touch-down
	Dur: number, -- whole motion incl. the bounce
}

EggFall.Restitution = 0.3 -- bounce speed / landing speed
EggFall.MinFlight = 0.05

-- `maxHop`: highest bounce in studs. A move that rises, or slides sideways more than `sideways` studs, gets an arc
-- whose top clears the higher end by a third of the sideways distance (at most `maxLift`).
function EggFall.plan(from: Vector3, to: Vector3, g: number, maxHop: number, sideways: number?, maxLift: number?): Plan
	g = math.max(g, 1)
	local horiz = Vector3.new(to.X - from.X, 0, to.Z - from.Z).Magnitude
	local apex = math.max(from.Y, to.Y)
	if to.Y > from.Y - 0.01 or horiz > (sideways or math.huge) then
		apex += math.max(0.3, math.min(horiz / 3, maxLift or 4))
	end
	local up = math.max(0, apex - from.Y)
	local down = math.max(0, apex - to.Y)
	local tUp = math.sqrt(2 * up / g)
	local tDown = math.sqrt(2 * down / g)
	local flight = math.max(EggFall.MinFlight, tUp + tDown)
	local landSpeed = g * tDown
	local hopHeight = math.min(maxHop, (landSpeed * EggFall.Restitution) ^ 2 / (2 * g))
	local hop = math.sqrt(2 * g * math.max(0, hopHeight))
	return {
		From = from,
		To = to,
		G = g,
		Vy0 = g * tUp,
		Flight = flight,
		Hop = hop,
		Dur = flight + 2 * hop / g,
	}
end

-- Position at `t` seconds (clamped to the plan). Height follows gravity; across the ground it moves evenly during the
-- flight and stays put during the bounce.
function EggFall.at(p: Plan, t: number): Vector3
	t = math.clamp(t, 0, p.Dur)
	if t >= p.Flight then
		local s = t - p.Flight
		local y = math.max(0, p.Hop * s - 0.5 * p.G * s * s)
		return p.To + Vector3.new(0, y, 0)
	end
	local k = t / p.Flight
	local flat = p.From:Lerp(p.To, k)
	local y = p.From.Y + p.Vy0 * t - 0.5 * p.G * t * t
	-- tUp + tDown was rounded up to MinFlight for tiny moves: blend to the goal height so it always touches down exactly
	local yLine = p.From.Y + (p.To.Y - p.From.Y) * k
	if p.Flight <= EggFall.MinFlight + 1e-6 then
		y = yLine
	end
	return Vector3.new(flat.X, math.max(y, math.min(p.To.Y, yLine)), flat.Z)
end

-- Share of the flight done at `t` (0..1), for turning the egg from its old facing to its new one.
function EggFall.turn(p: Plan, t: number): number
	return math.clamp(t / p.Flight, 0, 1)
end

return EggFall
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="131">
        <Properties>
          <string name="Name">EggHints</string>
          <string name="Source"><![CDATA[--!strict
-- Pure rule for the egg wobble and chirp hints (no Roblox services; tests/test_egg_hints.luau drives it).
-- Every few seconds the server picks ONE anchor egg that is still in the pile and wobbles a small patch of eggs
-- near a jittered point around it (EggHints.patch); the anchor's id is never sent on its own and the anchor is
-- usually outside its own patch. With a small chance the pick is the pet egg (when it is still in the pile),
-- otherwise a uniformly random other pile egg. Every zone mixes in decoys; the Meadow (EggConfig.Wobble.SlowTiers)
-- only wobbles less often, with a slightly higher pet egg chance.

local EggConfig = require(script.Parent.EggConfig)

local EggHints = {}

-- Ids of the eggs still in the pile (state InPile), sorted so the pick depends on the rng only.
-- `rocks` is RoundRocks' Core.Rocks: { [id]: { State: string } }.
function EggHints.pileIds(rocks: { [number]: any }): { number }
	local out = {}
	for id, r in rocks do
		if r.State == "InPile" then
			table.insert(out, id)
		end
	end
	table.sort(out)
	return out
end

-- One pick. `pile` lists the candidate ids, `target` is the pet egg id (nil when unknown, e.g. the
-- practice pile), `chance` the probability of picking the pet egg while it is among the candidates.
-- Returns nil only when the pile is empty. Never returns an id that is not in `pile`.
function EggHints.pick(rng: Random, pile: { number }, target: number?, chance: number): number?
	local n = #pile
	if n == 0 then
		return nil
	end
	local targetIn = target ~= nil and table.find(pile, target) ~= nil
	local others = if targetIn then n - 1 else n
	if targetIn and (others == 0 or rng:NextNumber() < chance) then
		return target
	end
	-- uniform among the non-target pile eggs
	local k = rng:NextInteger(1, others)
	for _, id in pile do
		if not targetIn or id ~= target then
			k -= 1
			if k == 0 then
				return id
			end
		end
	end
	return nil
end

-- True when `tier` (code tier id, e.g. "Gravel" = Meadow) wobbles at the slower Meadow pace.
function EggHints.slowTier(tier: string?): boolean
	return tier ~= nil and EggConfig.Wobble.SlowTiers[tier] == true
end

-- Gap range (seconds) between two wobble picks in `tier`.
function EggHints.gapRange(tier: string?): (number, number)
	local w = EggConfig.Wobble
	if EggHints.slowTier(tier) then
		return w.MeadowMinGap, w.MeadowMaxGap
	end
	return w.MinGap, w.MaxGap
end

-- Chance that a wobble pick in `tier` is the pet egg (while it is in the pile).
function EggHints.targetChance(tier: string?): number
	local w = EggConfig.Wobble
	return if EggHints.slowTier(tier) then w.MeadowTargetChance else w.TargetChance
end

-- The wobble pick for a tier: EggHints.pick with the tier's target chance. Every tier mixes in decoys, and a
-- pile without the pet egg (taken, or the practice pile) still wobbles decoys, so wobbles never stop early.
function EggHints.pickForTier(rng: Random, pile: { number }, target: number?, tier: string?): number?
	return EggHints.pick(rng, pile, target, EggHints.targetChance(tier))
end

-- Patch hint: the eggs that wobble together for one pick. `anchor` = the picked egg's position, `eggs` = the
-- pile eggs as { Id, Pos } (any order). Returns the ids within `radius` of a point `jMin..jMax` studs from the
-- anchor (random flat direction), sorted by id and capped at `max` (the closest to the point are kept). The
-- anchor is not special: it is listed only if it happens to lie in the patch. Empty when nothing is near.
function EggHints.patch(rng: Random, anchor: Vector3, eggs: { { Id: number, Pos: Vector3 } }, radius: number, jMin: number, jMax: number, max: number): { number }
	local a = rng:NextNumber(0, math.pi * 2)
	local d = rng:NextNumber(jMin, jMax)
	local center = anchor + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
	local near = {}
	for _, e in eggs do
		local flat = Vector3.new(e.Pos.X - center.X, 0, e.Pos.Z - center.Z).Magnitude
		if flat <= radius then
			table.insert(near, { Id = e.Id, D = flat })
		end
	end
	table.sort(near, function(x, y)
		return x.D < y.D
	end)
	local out = {}
	for i = 1, math.min(#near, max) do
		table.insert(out, near[i].Id)
	end
	table.sort(out)
	return out
end

-- Chirp source for one listener: among the pile eggs within `radius` (flat) of `playerPos` (`eggs` as { Id, Pos }),
-- the pet egg with `chance` when it is one of them, else a uniformly random other nearby egg. Returns the chosen
-- egg's position, or nil when no pile egg is that close. The caller decides whether a chirp happens at all.
function EggHints.chirpSource(rng: Random, eggs: { { Id: number, Pos: Vector3 } }, playerPos: Vector3, radius: number, target: number?, chance: number): Vector3?
	local ids: { number } = {}
	local posOf: { [number]: Vector3 } = {}
	for _, e in eggs do
		if Vector3.new(e.Pos.X - playerPos.X, 0, e.Pos.Z - playerPos.Z).Magnitude <= radius then
			table.insert(ids, e.Id)
			posOf[e.Id] = e.Pos
		end
	end
	table.sort(ids)
	local id = EggHints.pick(rng, ids, target, chance)
	return if id then posOf[id] else nil
end

-- Chirp point: `eggPos` = the chirping egg's world position (nil when there is none), `playerPos` = the
-- listener's root position. Returns the point to play the chirp at, or nil when the player is farther than
-- `radius`. The point is `jMin..jMax` studs from the egg in a random flat direction (never the egg).
function EggHints.chirpPoint(rng: Random, eggPos: Vector3?, playerPos: Vector3, radius: number, jMin: number, jMax: number): Vector3?
	if eggPos == nil or (playerPos - eggPos).Magnitude > radius then
		return nil
	end
	local a = rng:NextNumber(0, math.pi * 2)
	local d = rng:NextNumber(jMin, jMax)
	return eggPos + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
end

return EggHints
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="132">
        <Properties>
          <string name="Name">EggKit</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED by lobby_blender/egg_kit.py (Blender). ModuleScript: ReplicatedStorage.Shared.EggKit
-- Smooth egg, hatch-shell, shard and nest meshes for GeodeModel and StationModels (client and server).
-- Needs the imported roblox/EggKit.fbx model in ReplicatedStorage named "EggKitMeshes". Without it, has() is false
-- and the old Part eggs / nests build as before.
-- Per mesh: natural bounding-box centre c and size s (Roblox axes, Blender units, see egg_kit.py).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

type MeshDef = { c: { number }, s: { number }, tris: number }

local MESHES: { [string]: MeshDef } = {
	Egg_Body = { c = {-0,0,-0}, s = {0.7682,1,0.78}, tris = 396 },
	Egg_Pat1 = { c = {0.0381,0.1926,-0.0258}, s = {0.6541,0.643,0.7617}, tris = 150 },
	Egg_Pat2 = { c = {0,0.0004,-0}, s = {0.8007,0.1514,0.8007}, tris = 96 },
	Egg_Pat3 = { c = {0,0.0104,-0}, s = {0.7724,0.4543,0.7681}, tris = 240 },
	Egg_Pat4 = { c = {0.0014,-0.0126,-0.0271}, s = {0.7395,0.6704,0.7647}, tris = 216 },
	Nest_Ring = { c = {-0.1088,0.2792,0.0446}, s = {3.647,0.6807,3.8128}, tris = 1758 },
	Pedestal = { c = {0,0.16,-0}, s = {1.9742,0.32,1.9742}, tris = 444 },
	Shard = { c = {0.7761,0.1415,-0.3997}, s = {0.4484,0.772,0.6928}, tris = 116 },
	Shell_In = { c = {-0.539,0,-0}, s = {1.239,2.9164,2.317}, tris = 360 },
	Shell_Out = { c = {-0.5807,0,-0}, s = {1.3386,3.1,2.5}, tris = 784 },
	Shell_Spots = { c = {-0.6978,-0.5831,0.5797}, s = {1.1662,1.6542,1.2393}, tris = 150 },
}

local EggKit = {}

local cache: { [string]: MeshPart }? = nil
local function sources(): { [string]: MeshPart }
	if cache then
		return cache
	end
	local found: { [string]: MeshPart } = {}
	local root = ReplicatedStorage:FindFirstChild("EggKitMeshes")
	if root then
		for _, d in root:GetDescendants() do
			if d:IsA("MeshPart") then
				local base = string.gsub(d.Name, "%.%d+$", "")
				found[base] = found[base] or d
			end
		end
		-- only cache a complete set (the client may see the folder before every mesh replicated)
		for name in MESHES do
			if not found[name] then
				return found
			end
		end
	end
	cache = found
	return found
end

function EggKit.has(name: string): boolean
	local src: Instance? = sources()[name]
	return MESHES[name] ~= nil and src ~= nil
end

-- Natural size of a mesh (Blender units).
function EggKit.size(name: string): Vector3
	local s = MESHES[name].s
	return Vector3.new(s[1], s[2], s[3])
end

-- Clone mesh `name` into `parent` as a visual-only MeshPart. `frame` = the kit frame (the Blender origin of that
-- mesh family: egg centre, shell egg centre, nest floor centre), `k` = per-axis scale from Blender units to studs.
function EggKit.place(parent: Instance, name: string, partName: string, frame: CFrame, k: Vector3, color: Color3,
	material: Enum.Material?): MeshPart?
	local src = sources()[name]
	local def = MESHES[name]
	if not (src and def) then
		return nil
	end
	local p = src:Clone()
	p.Name = partName
	p.TextureID = ""
	p.Size = Vector3.new(def.s[1] * k.X, def.s[2] * k.Y, def.s[3] * k.Z)
	p.CFrame = frame * CFrame.new(def.c[1] * k.X, def.c[2] * k.Y, def.c[3] * k.Z)
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	-- solid whatever the imported template was set to (a see-through template made pile eggs look washed out)
	p.Transparency = 0
	p.Reflectance = 0
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

return EggKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="133">
        <Properties>
          <string name="Name">EggPerks</string>
          <string name="Source"><![CDATA[--!strict
-- Reasons to want eggs (owner ask 2026-10-15: "we need a reason for players to want to buy and earn eggs").
-- Pure rules, tested in tests/test_egg_perks.luau; saved per player in profile EggPerks (Profiles reconciles it).
--
--   Lucky Meter  every shop egg (Robux, coins or free) fills the meter: Basic 1, Rare 3, Mythic 8 points. Full (Need)
--                = the next egg is EPIC or better. Any Epic+ hatch empties it. The pity egg keeps the egg's own
--                Legendary chance, so the 1 in 1000 Void Dragon stays exactly as rare as the odds card says; only
--                Common / Uncommon / Rare turn into Epic. Shown on the egg card (disclosed with the odds).
--   Pet Book pages  one page per zone: every normal pet of that zone (not the chase pet, not weekly pets, so a page
--                can never be lost again). A full page = +10% coins from shells and +10% pet training XP, forever.
--   Free eggs    earned, never bought: every 3rd Pet Battle win = a free Basic Egg; claiming all of today's quests =
--                a free Rare Egg. Banked eggs hatch on their own (same hatch show) as soon as the Pet Book has room.
-- Nothing here changes which hunt egg hides the pet or who finds it.

local Config = require(script.Parent.Config)
local RobuxConfig = require(script.Parent.RobuxConfig)

local EggPerks = {}

EggPerks.Meter = {
	Need = 30,
	Points = { BasicEgg = 1, RareEgg = 3, MythicEgg = 8 } :: { [string]: number }, -- Basic every 30, Rare 10, Mythic 4
	ResetRarity = "Epic", -- a hatch of this rarity or better empties the meter
}
EggPerks.Pages = { CoinsPerPage = 0.1, XpPerPage = 0.1 }
EggPerks.Free = {
	FightWinsPerEgg = 3,
	FightEgg = "BasicEgg",
	QuestEgg = "RareEgg",
	BankMax = 20, -- banked eggs beyond this are not added (a full Pet Book for weeks)
	Order = { "MythicEgg", "RareEgg", "BasicEgg" }, -- best banked egg opens first
}

export type State = { Meter: number, Bank: { [string]: number }, FightWins: number, QuestDay: number, HuntEggs: number? }

function EggPerks.empty(): State
	return { Meter = 0, Bank = {}, FightWins = 0, QuestDay = 0 }
end

local function whole(v: any, lo: number, hi: number): number
	local n = tonumber(v)
	if not n or n ~= n then
		return lo
	end
	return math.clamp(math.floor(n), lo, hi)
end

-- Repairs a saved state IN PLACE (missing or wrong-typed fields) and returns it, so every holder of the table keeps
-- seeing the live state; a non-table becomes a fresh state. Keeps every banked egg of a known kind.
function EggPerks.sanitize(s: any): State
	if type(s) ~= "table" then
		return EggPerks.empty()
	end
	local bank = {}
	if type(s.Bank) == "table" then
		for _, id in EggPerks.Free.Order do
			local n = whole(s.Bank[id], 0, EggPerks.Free.BankMax)
			if n > 0 then
				bank[id] = n
			end
		end
	end
	s.Meter = whole(s.Meter, 0, EggPerks.Meter.Need)
	s.Bank = bank
	s.FightWins = whole(s.FightWins, 0, 1e9)
	s.QuestDay = whole(s.QuestDay, 0, 1e9)
	s.HuntEggs = whole(s.HuntEggs, 0, 1e9) -- hunt eggs toward the next Lucky Meter point (shared/HuntFun)
	return s :: State
end

-- Lucky Meter -------------------------------------------------------------------------------------------------------

local function rank(rarity: any): number
	return table.find(Config.Rarities, rarity) or 0
end

function EggPerks.full(meter: number): boolean
	return meter >= EggPerks.Meter.Need
end

-- The rarity table of a pity egg: Legendary keeps its share of `base` (nil = the race egg odds), everything below
-- Epic becomes Epic. Sums to 100.
function EggPerks.pityWeights(base: { [string]: number }?): { [string]: number }
	local w: any = base or Config.RarityWeights
	local sum = 0
	for _, r in Config.Rarities do
		sum += tonumber(w[r]) or 0
	end
	local legend = if sum > 0 then 100 * (tonumber(w.Legendary) or 0) / sum else 0
	local out: { [string]: number } = {}
	for _, r in Config.Rarities do
		out[r] = 0
	end
	out.Legendary = legend
	out.Epic = 100 - legend
	return out
end

-- The meter after hatching a pet of `rarity` from egg `eggId`.
function EggPerks.meterAfter(meter: number, eggId: string, rarity: string): number
	if rank(rarity) >= rank(EggPerks.Meter.ResetRarity) then
		return 0
	end
	return math.min(meter + (EggPerks.Meter.Points[eggId] or 1), EggPerks.Meter.Need)
end

-- Pet Book pages ----------------------------------------------------------------------------------------------------

-- The pets a zone's page needs: its normal species (not chase, weekly or tower-only), in the zone's order.
function EggPerks.pageSpecies(tierId: string): { string }
	local tier = (Config.Tiers :: any)[tierId]
	local out = {}
	if not tier then
		return out
	end
	for _, id in tier.Minerals do
		local sp: any = (Config.Minerals :: any)[id]
		if sp and not sp.Chase and not sp.Weekly and not sp.TowerOnly then
			table.insert(out, id)
		end
	end
	return out
end

export type Page = { Tier: string, Name: string, Found: number, Need: number, Done: boolean }

function EggPerks.pages(index: any): { Page }
	local out = {}
	for _, tierId in Config.TierOrder do
		local need = EggPerks.pageSpecies(tierId)
		local found = 0
		for _, id in need do
			local v = if type(index) == "table" then index[id] else nil
			if type(v) == "number" and v > 0 then
				found += 1
			end
		end
		table.insert(out, { Tier = tierId, Name = (Config.Tiers :: any)[tierId].Name, Found = found, Need = #need, Done = #need > 0 and found >= #need })
	end
	return out
end

function EggPerks.pagesDone(index: any): number
	local n = 0
	for _, p in EggPerks.pages(index) do
		if p.Done then
			n += 1
		end
	end
	return n
end

function EggPerks.coinMult(index: any): number
	return 1 + EggPerks.Pages.CoinsPerPage * EggPerks.pagesDone(index)
end

function EggPerks.xpMult(index: any): number
	return 1 + EggPerks.Pages.XpPerPage * EggPerks.pagesDone(index)
end

-- The page that `species` just completed (read AFTER its first hatch was counted), or nil.
function EggPerks.pageJustDone(index: any, species: string): Page?
	if type(index) ~= "table" or index[species] ~= 1 then
		return nil
	end
	for _, p in EggPerks.pages(index) do
		if p.Done and table.find(EggPerks.pageSpecies(p.Tier), species) then
			return p
		end
	end
	return nil
end

function EggPerks.eggName(id: string): string
	local e = RobuxConfig.egg(id)
	return if e then e.Name else "Egg"
end

-- Free eggs -----------------------------------------------------------------------------------------------------------

function EggPerks.bankCount(s: State): number
	local n = 0
	for _, v in s.Bank do
		n += v
	end
	return n
end

-- Banks one free egg; false when the bank is full.
function EggPerks.bankAdd(s: State, eggId: string): boolean
	if not table.find(EggPerks.Free.Order, eggId) or EggPerks.bankCount(s) >= EggPerks.Free.BankMax then
		return false
	end
	s.Bank[eggId] = (s.Bank[eggId] or 0) + 1
	return true
end

-- Takes the best banked egg (nil = none).
function EggPerks.bankTake(s: State): string?
	for _, id in EggPerks.Free.Order do
		local n = s.Bank[id]
		if n and n > 0 then
			local bank: { [string]: number? } = s.Bank
			bank[id] = if n > 1 then n - 1 else nil
			return id
		end
	end
	return nil
end

-- A Pet Battle win: the free egg it earns (banked), or nil.
function EggPerks.fightWin(s: State): string?
	s.FightWins += 1
	if s.FightWins % EggPerks.Free.FightWinsPerEgg == 0 then
		if EggPerks.bankAdd(s, EggPerks.Free.FightEgg) then
			return EggPerks.Free.FightEgg
		end
		s.FightWins -= 1 -- bank full: this win doesn't count yet, so the next win earns the egg instead of losing it
	end
	return nil
end

-- Wins still needed for the next fight egg (1..FightWinsPerEgg).
function EggPerks.winsToEgg(s: State): number
	local n = EggPerks.Free.FightWinsPerEgg
	return n - s.FightWins % n
end

-- Every quest of `day` claimed: the free egg it earns (once per day, banked), or nil.
function EggPerks.questsDone(s: State, day: number): string?
	if s.QuestDay == day then
		return nil
	end
	if not EggPerks.bankAdd(s, EggPerks.Free.QuestEgg) then
		return nil -- bank full: today's egg stays unclaimed, so a later call can still pay it
	end
	s.QuestDay = day
	return EggPerks.Free.QuestEgg
end

-- What the client shows (egg cards, Pet Book, battle card).
function EggPerks.view(s: State, index: any): { [string]: any }
	return {
		Meter = s.Meter,
		MeterNeed = EggPerks.Meter.Need,
		MeterPoints = EggPerks.Meter.Points,
		Bank = EggPerks.bankCount(s),
		WinsToEgg = EggPerks.winsToEgg(s),
		QuestEggToday = s.QuestDay,
		Pages = EggPerks.pages(index),
		CoinMult = EggPerks.coinMult(index),
		XpMult = EggPerks.xpMult(index),
	}
end

return EggPerks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="134">
        <Properties>
          <string name="Name">FightCamRules</string>
          <string name="Source"><![CDATA[--!strict
-- Shot maths for the Pet Battle camera director (client FightCam). Pure (Vector3 / CFrame only), tested in
-- tests/test_fight_cam.luau. A Stage is the fight seen from the local player's side: the middle of the fight, the
-- direction back towards the player's own team, and how far / high the base camera sits for that arena layout.

local FightCamRules = {}

export type Stage = {
	Centre: Vector3, -- the middle between the two pet lines, a little above the floor
	Back: Vector3, -- flat unit vector from the centre towards the player's own pets
	Right: Vector3, -- flat unit vector, right of Back
	R: number, -- base camera distance from the centre
	H: number, -- base camera height above the centre (at R)
	Aim: number?, -- how high over the floor the base view looks (about half the pets' height; default 1)
	Fit: { number }?, -- the fitted base distance at FIT_SAMPLES angles across the orbit (FightCamRules.radiusAt)
}

FightCamRules.FIGHT_FOV = 45 -- the lens for the whole fight (FightCam gives the player's own back at the end)
FightCamRules.CUT_GAP = 6 -- s between two crit close-ups: the wide view (both teams) is the fight's main shot

local UP = Vector3.yAxis

local function flat(v: Vector3, fallback: Vector3): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	return if f.Magnitude > 1e-3 then f.Unit else fallback
end

local function turn(v: Vector3, a: number): Vector3
	return CFrame.Angles(0, a, 0):VectorToWorldSpace(v)
end

local function ease(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

-- The part of the screen the fight HUD leaves clear, in screen units (-1..1, y up): under the top banner, inside the
-- JUMP / SPECIAL buttons on the right and LEAVE on the left, above the bottom buttons.
FightCamRules.SAFE = { X0 = -0.72, X1 = 0.72, Y0 = -0.55, Y1 = 0.45 }

-- What the client knows about the fight it frames: the screen's width / height, how tall the drawn pets are, and how
-- many stand in each line. Unknown fields fall back to a 16:9 screen, 5-stud pets, three a side.
export type View = { Aspect: number?, Height: number?, Pets: number?, Foes: number? }

-- Where the pets of one line stand (TowerView.floor draws them the same way).
local function line(origin: CFrame, z: number, gap: number, n: number): { Vector3 }
	local out = {}
	for i = 1, n do
		table.insert(out, (origin * CFrame.new((i - (n + 1) / 2) * gap, 0, z)).Position)
	end
	return out
end

-- Screen position (-1..1) of `pt` seen from `pos` looking at `aim` through a lens FIGHT_FOV tall; nil = behind or
-- too close to the camera.
function FightCamRules.project(pos: Vector3, aim: Vector3, pt: Vector3, aspect: number): (number?, number?)
	local fwd = (aim - pos).Unit
	local right = fwd:Cross(UP).Unit
	local up = right:Cross(fwd)
	local d = pt - pos
	local depth = d:Dot(fwd)
	if depth < 3 then
		return nil, nil
	end
	local tanV = math.tan(math.rad(FightCamRules.FIGHT_FOV) / 2)
	return d:Dot(right) / depth / (tanV * aspect), d:Dot(up) / depth / tanV
end

-- Every pet's feet and head stay inside SAFE seen from `pos` looking at `aim`.
local function framed(pos: Vector3, aim: Vector3, pets: { Vector3 }, height: number, aspect: number): boolean
	local safe = FightCamRules.SAFE
	for _, foot in pets do
		for _, lift in { 0, height } do
			local x, y = FightCamRules.project(pos, aim, foot + UP * lift, aspect)
			if not x or not y or x < safe.X0 or x > safe.X1 or y < safe.Y0 or y > safe.Y1 then
				return false
			end
		end
	end
	return true
end

-- The orbit point at angle `a` (radians off Back towards Right), distance `r` (height follows: low and side-on).
local function orbitAt(s: Stage, a: number, r: number): Vector3
	return s.Centre + turn(s.Back, a) * r + UP * r * FightCamRules.LOW
end
FightCamRules.LOW = 0.2 -- base camera height over distance
FightCamRules.FIT_SAMPLES = 13 -- angles across the orbit fitted one by one

-- `origin`: the player's view origin (TowerView draws the player's pets at origin * (x, 0, PetZ), the rival's at
-- FoeZ); `layout`: a PvpConfig.Layouts entry; `view`: the screen and pets being framed. The base camera sits low and
-- side-on through the narrow FIGHT_FOV lens. For each angle of its orbit it comes as close as it can while every pet
-- stays inside SAFE on this screen (Studio 2026-10-15: one distance for the whole orbit left the pets in the middle
-- third of the screen at most angles).
function FightCamRules.stage(origin: CFrame, layout: { PetZ: number, FoeZ: number, PetGap: number?, FoeGap: number? }, view: View?): Stage
	local v: View = view or {}
	local mineMid = (origin * CFrame.new(0, 0, layout.PetZ)).Position
	local foeMid = (origin * CFrame.new(0, 0, layout.FoeZ)).Position
	local back = flat(mineMid - foeMid, flat(-origin.LookVector, Vector3.zAxis))
	local aspect = math.clamp(v.Aspect or 16 / 9, 1, 3)
	local height = math.clamp(v.Height or 5, 2, 12)
	local pets = line(origin, layout.PetZ, layout.PetGap or 6, math.clamp(v.Pets or 3, 1, 6))
	for _, p in line(origin, layout.FoeZ, layout.FoeGap or 6, math.clamp(v.Foes or 3, 1, 6)) do
		table.insert(pets, p)
	end
	local s: Stage = { Centre = (mineMid + foeMid) / 2 + UP * 1.5, Back = back, Right = back:Cross(UP).Unit, R = 12, H = 2.4, Fit = {}, Aim = height * 0.42 }
	local focus = FightCamRules.focus(s)
	local lo, hi = FightCamRules.BASE_ANGLE - FightCamRules.BASE_SWING, FightCamRules.BASE_ANGLE + FightCamRules.BASE_SWING
	local far = 0
	for i = 1, FightCamRules.FIT_SAMPLES do
		local a = lo + (hi - lo) * (i - 1) / (FightCamRules.FIT_SAMPLES - 1)
		local r = 10
		while r < FightCamRules.MAX_R and not framed(orbitAt(s, a, r), focus, pets, height, aspect) do
			r += 0.5
		end
		r *= 1.03 -- a little room between the fitted angles
		table.insert(s.Fit :: { number }, r)
		far = math.max(far, r)
	end
	s.R, s.H = far, far * FightCamRules.LOW
	return s
end

-- The fitted base distance at orbit angle `a`.
function FightCamRules.radiusAt(s: Stage, a: number): number
	local fit = s.Fit
	if not fit or #fit < 2 then
		return s.R
	end
	local lo, hi = FightCamRules.BASE_ANGLE - FightCamRules.BASE_SWING, FightCamRules.BASE_ANGLE + FightCamRules.BASE_SWING
	local u = math.clamp((a - lo) / (hi - lo), 0, 1) * (#fit - 1) + 1
	local i = math.min(math.floor(u), #fit - 1)
	return fit[i] + (fit[i + 1] - fit[i]) * (u - i)
end
FightCamRules.MAX_R = 80

-- The base view at fight time t: a three-quarter side view (the player's team on one side of the screen, the rival's
-- on the other, like a fighting game) that orbits slowly round the fight (between about 43 and 83 degrees off the
-- player's back, a sweep every ~14 s) and dollies in and out, so the shot is always moving. Never behind the player's
-- avatar (Studio test 2026-10-14: a tiny pan low behind the avatar read as a still camera).
FightCamRules.BASE_ANGLE = 1.1 -- radians off Back towards Right (mostly side-on: both teams across the frame)
FightCamRules.BASE_SWING = 0.35 -- +- radians of orbit

-- What the base view looks at: the middle of the fight at about half the pets' height (so tall pets are centred
-- too), a little towards the player's own team (it is nearer the camera, so this centres the two teams on screen).
function FightCamRules.focus(s: Stage): Vector3
	return s.Centre + UP * ((s.Aim or 1) - 1.5) + s.Back * 2
end

function FightCamRules.baseAngle(t: number): number
	return FightCamRules.BASE_ANGLE + math.sin(t * 0.45) * FightCamRules.BASE_SWING
end

-- The dolly: breathes out from the fitted distance and back (never closer, so no pet leaves the frame).
local function dolly(t: number): number
	return 1 + 0.08 * (0.5 + 0.5 * math.sin(t * 0.6 + 1))
end

function FightCamRules.basePos(s: Stage, t: number): Vector3
	local a = FightCamRules.baseAngle(t)
	return orbitAt(s, a, FightCamRules.radiusAt(s, a) * dolly(t))
end

function FightCamRules.base(s: Stage, t: number): CFrame
	return CFrame.lookAt(FightCamRules.basePos(s, t), FightCamRules.focus(s))
end

-- Reduce Motion: one still view (the middle of the orbit).
function FightCamRules.still(s: Stage): CFrame
	local a = FightCamRules.BASE_ANGLE
	return CFrame.lookAt(orbitAt(s, a, FightCamRules.radiusAt(s, a)), FightCamRules.focus(s))
end

FightCamRules.NUDGE_AIM, FightCamRules.NUDGE_MOVE = 0.2, 0.07

-- A hit lands on a pet at `at`: the base view leans towards it and pushes in a little (k = 0..1 strength).
function FightCamRules.nudge(base: CFrame, s: Stage, at: Vector3, k: number): CFrame
	k = math.clamp(k, 0, 1)
	local aim = FightCamRules.focus(s):Lerp(at, FightCamRules.NUDGE_AIM * k)
	local pos = base.Position:Lerp(at, FightCamRules.NUDGE_MOVE * k)
	return CFrame.lookAt(pos, aim)
end

-- The opening sweep, u = 0..1: starts wide and high over the rival's side of the arena and swings round and in to
-- the base view (u = 1 lands exactly on base(0)).
function FightCamRules.introAt(s: Stage, u: number): CFrame
	local e = ease(u)
	local a0 = FightCamRules.baseAngle(0)
	local r0 = FightCamRules.radiusAt(s, a0) * dolly(0) -- base(0)'s distance
	return CFrame.lookAt(orbitAt(s, a0 + (1 - e) * 2.4, r0 * (1.7 - 0.7 * e)), FightCamRules.focus(s))
end

function FightCamRules.intro(s: Stage, u: number, _base: CFrame?): CFrame
	return FightCamRules.introAt(s, u)
end

-- Side-on close-up of a pet that was hit (`from` = the attacker, when known), easing in a little over the shot.
-- The camera stays on the player's side of the fight.
function FightCamRules.closeUp(s: Stage, at: Vector3, from: Vector3?, size: number, t: number): CFrame
	local axis = if from then flat(at - from, s.Back) else s.Back
	local side = axis:Cross(UP)
	side = if side.Magnitude > 1e-3 then side.Unit else s.Right
	if side:Dot(s.Back) < 0 then
		side = -side
	end
	local dist = (size * 1.4 + 5) * (1 - 0.1 * math.clamp(t, 0, 1))
	local pos = at + (side * 0.85 + s.Back * 0.35).Unit * dist + UP * (size * 0.35 + 1.6)
	return CFrame.lookAt(pos, at)
end

-- Over the shoulder of the player's SPECIAL caster, looking at the rival team.
function FightCamRules.shoulder(s: Stage, caster: Vector3, _from: Vector3?): CFrame
	local pos = caster + s.Back * 5.5 + s.Right * 2.2 + UP * 3
	return CFrame.lookAt(pos, caster - s.Back * 14)
end

-- K.O. orbit round the pet that fainted (about 65 degrees a second).
function FightCamRules.orbit(s: Stage, at: Vector3, size: number, t: number): CFrame
	local dist = size * 1.2 + 6
	local pos = at + turn(s.Back, 0.6 + t * 1.15) * dist + UP * (2.5 + size * 0.3)
	return CFrame.lookAt(pos, at)
end

-- Three-quarter hero shot looking down on the pet (about 28 degrees) so it stands out against the floor, pushing in
-- over 2.5 s and holding. FightCam narrows the lens to HERO_FOV for it, so even a small pet fills the middle.
FightCamRules.HERO_FOV = 42
function FightCamRules.hero(s: Stage, at: Vector3, size: number, t: number): CFrame
	local dist = (size * 0.8 + 4) * (1.15 - 0.15 * math.clamp(t / 2.5, 0, 1))
	local pos = at + turn(s.Back, 0.55) * dist + UP * (dist * 0.53)
	return CFrame.lookAt(pos, at + UP * size * 0.4) -- a little above the pet: its power card stays in frame
end

-- Frame-rate independent easing factor towards the target camera.
function FightCamRules.alpha(k: number, dt: number): number
	return 1 - math.exp(-k * math.max(dt, 0))
end

return FightCamRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="135">
        <Properties>
          <string name="Name">FightFxRules</string>
          <string name="Source"><![CDATA[--!strict
-- Fight effect rules, pure: no Roblox services, unit-tested in tests/test_fight_fx.luau. Client FightFx plays what
-- these say (the big fight moments, built from the techniques of the egg hatch show, client HatchShow).
--   * moment(kind, lowEffects, reducedMotion): how big each moment is. Kinds climb hit < advantage (type advantage)
--     < crit < levelup < special < ko. Reduce Motion drops the camera kick, shake and slow motion and softens the
--     flash; Low Effects halves the debris, stars and rings.
--   * screen gate: camera / flash / colour effects never stack faster than SCREEN_GAP, unless the new moment ranks
--     higher than the one still showing (a KO always gets through).
--   * chunkStep: one step of the hand-animated debris (gravity, ground bounce, settle), so slow motion slows it too.

local FightFxRules = {}

export type Moment = {
	Kind: string,
	Rank: number,
	Fov: number, -- degrees added to the view for a moment (the "slam")
	Shake: number, -- camera shake strength 0..1
	Flash: number, -- screen flash opacity 0..1
	Bloom: number, -- bloom spike intensity
	Tint: number, -- colour correction pop 0..1 (towards the moment's colour)
	Slow: number, -- time scale during the slow motion (1 = none)
	SlowTime: number, -- seconds of real time the slow motion lasts
	Rings: number, -- ground shockwave rings
	Chunks: number, -- debris chunks
	Stars: number, -- star burst particles
	Beam: boolean, -- a light beam (special: attacker to target; levelup / ko winner: up into the sky)
	Banner: string?, -- big screen word
	Pop: string?, -- small floating word over the target
}

local BASE: { [string]: Moment } = {
	hit = { Kind = "hit", Rank = 1, Fov = 0, Shake = 0.12, Flash = 0, Bloom = 0, Tint = 0, Slow = 1, SlowTime = 0, Rings = 0, Chunks = 0, Stars = 0, Beam = false },
	advantage = { Kind = "advantage", Rank = 2, Fov = 4, Shake = 0.35, Flash = 0.25, Bloom = 0.4, Tint = 0.35, Slow = 1, SlowTime = 0, Rings = 1, Chunks = 6, Stars = 14, Beam = false, Pop = "SUPER!" },
	crit = { Kind = "crit", Rank = 3, Fov = 7, Shake = 0.6, Flash = 0.45, Bloom = 0.8, Tint = 0.45, Slow = 1, SlowTime = 0, Rings = 2, Chunks = 10, Stars = 24, Beam = false },
	levelup = { Kind = "levelup", Rank = 4, Fov = 5, Shake = 0.3, Flash = 0.35, Bloom = 0.9, Tint = 0.4, Slow = 1, SlowTime = 0, Rings = 2, Chunks = 0, Stars = 40, Beam = true, Banner = "LEVEL UP!" },
	special = { Kind = "special", Rank = 5, Fov = 12, Shake = 0.9, Flash = 0.55, Bloom = 1.2, Tint = 0.6, Slow = 0.35, SlowTime = 0.3, Rings = 3, Chunks = 16, Stars = 50, Beam = true, Banner = "SPECIAL!" },
	ko = { Kind = "ko", Rank = 6, Fov = 16, Shake = 1, Flash = 0.65, Bloom = 1.4, Tint = 0.7, Slow = 0.22, SlowTime = 0.9, Rings = 4, Chunks = 22, Stars = 70, Beam = true, Banner = "K.O.!" },
}
-- Caps on the screen pop (Studio fight test 2026-10-14: the K.O. flash washed the scene near white).
FightFxRules.MAX_FLASH = 0.32
FightFxRules.MAX_BLOOM = 0.8

FightFxRules.KINDS = { "hit", "advantage", "crit", "levelup", "special", "ko" }
FightFxRules.MAX_CHUNKS = 24 -- pooled debris parts (whole client)

function FightFxRules.moment(kind: string, lowEffects: boolean?, reducedMotion: boolean?): Moment
	local m = table.clone(BASE[kind] or BASE.hit)
	if reducedMotion then
		m.Fov, m.Shake, m.Slow, m.SlowTime = 0, 0, 1, 0
		m.Flash *= 0.5
	end
	if lowEffects then
		m.Chunks = m.Chunks // 2
		m.Stars = m.Stars // 2
		m.Rings = if m.Rings > 0 then math.max(1, m.Rings // 2) else 0
		m.Bloom *= 0.5
	end
	m.Chunks = math.min(m.Chunks, FightFxRules.MAX_CHUNKS)
	return m
end

-- Screen effects gate. State is per client.
export type Gate = { Until: number, Rank: number }
FightFxRules.SCREEN_GAP = 0.18 -- s between two screen effects of the same or lower rank

function FightFxRules.newGate(): Gate
	return { Until = 0, Rank = 0 }
end

-- May a moment of `rank` use the screen at `now`? If yes the gate is taken for `hold` seconds.
function FightFxRules.takeScreen(g: Gate, rank: number, now: number, hold: number?): boolean
	if now < g.Until and rank <= g.Rank then
		return false
	end
	g.Until = now + math.max(hold or 0, FightFxRules.SCREEN_GAP)
	g.Rank = rank
	return true
end

-- Debris: gravity, a bounce that loses most of its speed, then rest on the ground. Returns the new position,
-- velocity and whether it has settled.
FightFxRules.GRAVITY = 62
function FightFxRules.chunkStep(pos: Vector3, vel: Vector3, dt: number, groundY: number): (Vector3, Vector3, boolean)
	local v = vel + Vector3.new(0, -FightFxRules.GRAVITY * dt, 0)
	local p = pos + v * dt
	if p.Y < groundY then
		p = Vector3.new(p.X, groundY, p.Z)
		if v.Y < 0 then
			v = Vector3.new(v.X * 0.55, -v.Y * 0.38, v.Z * 0.55)
		end
		if math.abs(v.Y) < 2 then
			return p, Vector3.zero, true
		end
	end
	return p, v, false
end

-- The decaying shake curve of a slam (frame i of n): hard at once, gone at the end.
function FightFxRules.shakeAt(strength: number, k: number): number
	if k <= 0 then
		return strength
	elseif k >= 1 then
		return 0
	end
	return strength * math.exp(-k * 5) * (1 - k)
end

-- Floating fight pops (damage, "Strong!", "Weak", SPECIAL!) in one server batch used to land on the same frame and
-- stack into one blob. popSlot staggers them: pops on the same pet wait POP_GAP after each other and take the next
-- slot (0, 1, 2: the caller stacks each slot one label height higher on screen), and any two pops wait POP_SPREAD.
-- A pet's slots start over only once its last pop has gone (POP_LIFE), so two live pops never share a slot.
-- Never more than POP_MAX_WAIT.
FightFxRules.POP_GAP = 0.3
FightFxRules.POP_SPREAD = 0.1
FightFxRules.POP_MAX_WAIT = 1.2
FightFxRules.POP_LIFE = 0.9 -- TowerView's pop lifetime
FightFxRules.POP_SLOTS = 3

function FightFxRules.popSlot(state: { [string]: number }, key: string, now: number): (number, number)
	local at = math.max(state[key] or now, state["*"] or now, now)
	local wait = math.min(at - now, FightFxRules.POP_MAX_WAIT)
	local landed = state[key .. "@"]
	if landed == nil or now + wait > landed + FightFxRules.POP_LIFE then
		state[key .. "#"] = 0 -- this pet's last pop has gone: back to the first slot
	end
	local n = state[key .. "#"] or 0
	state[key .. "#"] = n + 1
	state[key .. "@"] = now + wait
	state[key] = now + wait + FightFxRules.POP_GAP
	state["*"] = now + wait + FightFxRules.POP_SPREAD
	return wait, n % FightFxRules.POP_SLOTS
end

return FightFxRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="136">
        <Properties>
          <string name="Name">GearKit</string>
          <string name="Source"><![CDATA[--!strict
-- Pure decisions for the owner's pet gear models (ReplicatedStorage.Assets.Kit.Gear_<Id>).
-- Pet gear is passive: nothing is ever held in the hand, so `heldToolName` is always nil.
local GearKit = {}

GearKit.Ids = { "Hammer", "SteelHammer", "Jackhammer", "AutoCracker", "HydraulicPress", "IndustrialCrusher" }

local LEGACY: { [string]: { string } } = {
	Hammer = { "Tool_Hammer", "Hammer" },
	SteelHammer = { "Tool_SteelHammer", "SteelHammer" },
	Jackhammer = { "Tool_Jackhammer", "Jackhammer" },
	AutoCracker = { "Machine_AutoCracker", "AutoCracker" },
	HydraulicPress = { "Machine_HydraulicPress", "HydraulicPress" },
	IndustrialCrusher = { "Machine_IndustrialCrusher", "IndustrialCrusher" },
}

-- Kit lookup order for a gear id: the new Gear_<Id> model first, the older names as fallbacks.
function GearKit.kitNames(id: string): { string }
	local out = { "Gear_" .. id }
	local legacy: { string } = LEGACY[id] or { id }
	for _, n in legacy do
		table.insert(out, n)
	end
	return out
end

-- Which build a machine uses: "Gear" when the Gear_<Id> model exists and is Ready, else the "Parts" build.
function GearKit.source(exists: boolean, ready: boolean): string
	if exists and ready then
		return "Gear"
	end
	return "Parts"
end

-- Which parts of the Parts build hide once the Gear_<Id> model stands over it: every body part, including the
-- StateLight bulb and the Beacon (they floated as grey dots beside the mesh); only the Base keeps its look.
function GearKit.hideUnderGear(name: string, _role: any): boolean
	return name ~= "Base"
end

-- Scale factor for the hip accessory: its longest side about 1.8 studs on a normal (~5 stud) avatar, in proportion on
-- bigger or smaller ones (0.7 studs was too small to see on R15).
GearKit.AccessoryLongest = 1.8
function GearKit.accessoryScale(longest: number, avatarHeight: number): number
	local want = GearKit.AccessoryLongest * math.clamp(avatarHeight / 5, 1, 2)
	return math.clamp(want / math.max(longest, 0.05), 0.05, 40)
end

-- Uniform scale that fits a model of size `gear` inside the footprint `box` (width/depth, and height when box.Y > 0).
function GearKit.fitScale(gear: Vector3, box: Vector3): number
	local s = math.min(box.X / math.max(gear.X, 1e-3), box.Z / math.max(gear.Z, 1e-3))
	if box.Y > 0 then
		s = math.min(s, box.Y / math.max(gear.Y, 1e-3))
	end
	return s
end

-- The held Tool name for a gear id: none (passive gear never sits in the hand).
function GearKit.heldToolName(_id: string): string?
	return nil
end

-- The kit model that may show as a small hip accessory (hand-tier gear only), else nil.
function GearKit.accessoryModel(id: string): string?
	if id == "Hammer" or id == "SteelHammer" or id == "Jackhammer" then
		return "Gear_" .. id
	end
	return nil
end

return GearKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="137">
        <Properties>
          <string name="Name">GeodeGen</string>
          <string name="Source"><![CDATA[--!strict
-- Pure specimen generation. The server rolls once per won match and stores the result;
-- nothing here is re-rolled on reveal, rejoin, inspect or sell.

local Config = require(script.Parent.Config)
local SpeciesPool = require(script.Parent.SpeciesPool)
local RobuxConfig = require(script.Parent.RobuxConfig)
local LaunchPerks = require(script.Parent.LaunchPerks)

local GeodeGen = {}

export type Specimen = {
	Id: string,
	MatchKey: string,
	Tier: string,
	Mineral: string,
	Rarity: string,
	Formation: string,
	Modifier: string,
	Mass: number,
	Seed: number,
	Value: number,
	ConfigVersion: number,
	Found: number,
	Favorite: boolean,
	Solo: boolean,
	Nickname: string?, -- the owner's filtered pet name (PetService rename), nil = the species name
	Evolve: number?, -- evolve stage (PvpService evolve; nil = never evolved)
	Shiny: boolean?, -- 1 in 100 shiny pet (LaunchPerks.Shiny): sparkle shimmer, "Shiny" name, 2x value; nil = not shiny
}

local function pickWeighted(rng: Random, order: { string }, weights: { [string]: number }): string
	local total = 0
	for _, k in order do
		total += weights[k]
	end
	local roll = rng:NextNumber() * total
	for _, k in order do
		roll -= weights[k]
		if roll < 0 then
			return k
		end
	end
	return order[#order]
end
GeodeGen.pickWeighted = pickWeighted

function GeodeGen.rollMass(rng: Random): number
	local roll = rng:NextNumber() * 100
	local band = Config.MassBands[#Config.MassBands]
	for _, b in Config.MassBands do
		roll -= b.Weight
		if roll < 0 then
			band = b
			break
		end
	end
	local raw = band.Min + rng:NextNumber() * (band.Max - band.Min)
	return math.clamp(math.floor(raw * 100 + 0.5) / 100, band.Min, band.Max)
end

function GeodeGen.value(tierId: string, rarity: string, modifier: string, mass: number, shiny: boolean?): number
	local tier = Config.Tiers[tierId]
	local v = tier.GeodeBase * Config.RarityMult[rarity] * Config.ModifierMult[modifier] * (0.75 + 0.25 * mass) * LaunchPerks.shinyMult(shiny)
	return math.floor(v)
end

-- Visual scale from mass: cube root, clamped so big specimens still fit a large stand.
function GeodeGen.visualScale(mass: number): number
	return math.clamp((mass / 2) ^ (1 / 3), 0.7, 2.2)
end

-- Rarity weights for a finder with Luck (every source added up, LuckEvents.total): Rare and better weigh (1 + luck)
-- times more; luck is clamped to [0, RobuxConfig.MaxLuck]. Luck only changes the pet the finder hatches, never which
-- egg hides it or who finds it.
-- baseWeights: another rarity table (a Robux shop Rare / Mythic egg, RobuxConfig.Eggs); nil = the race egg odds.
function GeodeGen.rarityWeights(luck: number?, baseWeights: { [string]: number }?): { [string]: number }
	local l = math.clamp(if luck == luck then luck or 0 else 0, 0, RobuxConfig.MaxLuck)
	local w: { [string]: number } = {}
	local base: { [string]: number } = baseWeights or Config.RarityWeights
	for _, k in Config.Rarities do
		local v = base[k] or 0
		w[k] = if k == "Common" or k == "Uncommon" then v else v * (1 + l)
	end
	return w
end

-- shinyOneIn: this egg's shiny chance (1 in N); nil = LaunchPerks.Shiny.OneIn. Shiny comes from the Seed (one more
-- draw at the very end), so every other roll is exactly what it was before shiny pets existed.
function GeodeGen.roll(rng: Random, tierId: string, id: string, matchKey: string, now: number, solo: boolean, luck: number?, baseWeights: { [string]: number }?, shinyOneIn: number?): Specimen
	local tier = Config.Tiers[tierId]
	assert(tier, "unknown tier " .. tostring(tierId))
	local rarity = pickWeighted(rng, Config.Rarities, GeodeGen.rarityWeights(luck, baseWeights))
	local mineral = SpeciesPool.pick(rng, tierId, rarity, now) -- weekly pets hidden until out; chase pet = Legendary
	local formation = pickWeighted(rng, Config.Formations, Config.FormationWeights)
	local modifier = pickWeighted(rng, Config.Modifiers, Config.ModifierWeights)
	local mass = GeodeGen.rollMass(rng)
	local seed = rng:NextInteger(1, 2 ^ 30)
	local shiny = LaunchPerks.shinyFromSeed(seed, shinyOneIn)
	return {
		Id = id,
		MatchKey = matchKey,
		Tier = tierId,
		Mineral = mineral,
		Rarity = rarity,
		Formation = formation,
		Modifier = modifier,
		Mass = mass,
		Seed = seed,
		Value = GeodeGen.value(tierId, rarity, modifier, mass, shiny),
		ConfigVersion = Config.Version,
		Found = math.floor(now),
		Favorite = false,
		Solo = solo,
		Shiny = if shiny then true else nil,
	}
end

-- Sanitised view for clients / gallery labels: no match internals.
function GeodeGen.public(s: Specimen): { [string]: any }
	return {
		Id = s.Id,
		Tier = s.Tier,
		Mineral = s.Mineral,
		Rarity = s.Rarity,
		Formation = s.Formation,
		Modifier = s.Modifier,
		Mass = s.Mass,
		Seed = s.Seed,
		Value = s.Value,
		Found = s.Found,
		Favorite = s.Favorite,
		Solo = s.Solo,
		Nickname = s.Nickname,
		Evolve = s.Evolve,
		Shiny = s.Shiny,
		TowerXP = (s :: any).TowerXP, -- pet tower experience when present (PetRules.level)
	}
end

-- short = true: a card-sized name (species may set Short, e.g. a long name cut for cards).
function GeodeGen.displayName(s: { Mineral: string, Modifier: string }, short: boolean?): string
	local m: any = (Config.Minerals :: any)[s.Mineral]
	local name = if m then (if short and m.Short then m.Short else m.Name) else s.Mineral
	if s.Modifier ~= "Natural" then
		name = (Config.ModifierNames[s.Modifier] or s.Modifier) .. " " .. name
	end
	if (s :: any).Shiny == true then
		name = "Shiny " .. name
	end
	return name
end

return GeodeGen
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="138">
        <Properties>
          <string name="Name">GeodeModel</string>
          <string name="Source"><![CDATA[--!strict
-- Procedural egg and pet presentation (Find The Pet). The module keeps its old name and public API
-- (build, example, onStand, frontHalves, shellFit, rockLook, rockShell, rubble, grit, gritPatch, RockVariants)
-- so every caller still compiles; what players SEE is now:
--   rockShell   a spotted pastel EGG (pile, basket, tray, plate). Look comes only from the opaque egg id and the
--               round seed (rockLook), never from target info, so the pet egg looks like every other egg.
--   rubble      a little heap of cracked eggshell pieces.
--   grit        a tiny shell crumb (hit bursts, pickup dust); gritPatch is off.
--   build       the pet itself (PetModel); example = a decorative pet; onStand = a pet on a little nest.
--   frontHalves two cracked eggshell halves around the pet that open in the hatch (RevealView, StationView).
-- All procedural Parts. REPLACE: real egg / shell / nest meshes when the owner uploads them.

local Config = require(script.Parent.Config)
local GeodeGen = require(script.Parent.GeodeGen)
local PetModel = require(script.Parent.PetModel)
-- smooth Blender egg / shell / nest meshes (Shared.EggKit + ReplicatedStorage.EggKitMeshes); falls back to Parts
local EggKit: any = nil
do
	local mod = script.Parent:FindFirstChild("EggKit")
	if mod and mod:IsA("ModuleScript") then
		local ok, m = pcall(require, mod)
		if ok then
			EggKit = m
		end
	end
end
-- the owner's textured low-poly pile eggs (Shared.WorldKit + ReplicatedStorage.WorldKit_LowPoly); nil = EggKit / Parts
local WorldKit: any = nil
do
	local mod = script.Parent:FindFirstChild("WorldKit")
	if mod and mod:IsA("ModuleScript") then
		local ok, m = pcall(require, mod)
		if ok then
			WorldKit = m
		end
	end
end
local function eggKit(...: string): boolean
	if EggKit == nil then
		return false
	end
	for _, n in { ... } do
		if not EggKit.has(n) then
			return false
		end
	end
	return true
end

local GeodeModel = {}

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material, shape: string?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat
	if shape == "ball" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Pastel egg shells and their spot colours. Every egg in a round draws from the same lists. A shade deeper than the
-- first pastels: those read as washed-out white in bright sun on a phone (owner video).
local EGG_TINTS = {
	Color3.fromRGB(255, 214, 176), Color3.fromRGB(182, 222, 255), Color3.fromRGB(255, 196, 218), Color3.fromRGB(198, 236, 184),
	Color3.fromRGB(222, 200, 255), Color3.fromRGB(255, 234, 158), Color3.fromRGB(176, 236, 220), Color3.fromRGB(255, 206, 178),
}
local SPOT_TINTS = {
	Color3.fromRGB(255, 160, 186), Color3.fromRGB(130, 196, 255), Color3.fromRGB(150, 220, 140), Color3.fromRGB(200, 160, 255),
	Color3.fromRGB(255, 196, 110), Color3.fromRGB(110, 214, 200),
}
local SHELL_INSIDE = Color3.fromRGB(255, 252, 244)

-- EGG_TINTS index -> WorldKit egg mesh (two tints each, by hue: peach/yellow, blue/lilac, pink/rose, green/mint)
local WORLD_EGG = { "HuntEgg_Yellow", "HuntEgg_Blue", "HuntEgg_Pink", "HuntEgg_Green", "HuntEgg_Blue", "HuntEgg_Yellow", "HuntEgg_Green", "HuntEgg_Pink" }

local PATTERNS = 12 -- 4 pattern kinds (spots, band, stripes, dots) x 3 spot colour offsets
GeodeModel.RockVariants = PATTERNS

local function eggTint(i: number): Color3
	return EGG_TINTS[((i - 1) % #EGG_TINTS) + 1]
end

local function spotTint(i: number): Color3
	return SPOT_TINTS[((i - 1) % #SPOT_TINTS) + 1]
end

-- Point and outward normal on an egg ellipsoid (half width a, half height b) at polar angle th from the top, azimuth ph.
local function eggPoint(a: number, b: number, th: number, ph: number): (Vector3, Vector3)
	local d = Vector3.new(math.sin(th) * math.cos(ph), math.cos(th), math.sin(th) * math.sin(ph))
	local p = Vector3.new(d.X * a, d.Y * b, d.Z * a)
	local nrm = Vector3.new(d.X / a, d.Y / b, d.Z / a).Unit
	return p, nrm
end

local function tangentCF(p: Vector3, nrm: Vector3): CFrame
	local up = if math.abs(nrm.Y) > 0.98 then Vector3.zAxis else Vector3.yAxis
	return CFrame.lookAt(p, p + nrm, up)
end

-- Pet presentation -------------------------------------------------------------------------------

export type BuildOpts = {
	Scale: number?, -- overrides the mass scale
	Lod: boolean?, -- fewer pieces (gallery shelves)
	Tiny: boolean?, -- fewest pieces (implies Lod)
	NoLight: boolean?, -- no light (many pets in one view)
	Tilt: number?, -- ignored for pets (kept for callers)
}

-- The pet for a specimen (spec: Mineral, Formation, Modifier, Rarity, Mass, Seed). Pivot = feet on the ground, faces -Z.
function GeodeModel.build(spec: { [string]: any }, opts: BuildOpts?): Model
	local o: BuildOpts = opts or {}
	local m = PetModel.build(spec, { Scale = o.Scale, Lod = o.Lod, Tiny = o.Tiny, NoLight = o.NoLight })
	m.Name = "CT_Rocks_Specimen"
	return m
end

-- A public DECORATIVE example pet (lobby signs, pedestals): a made-up specimen with no Id, tagged "Decorative".
function GeodeModel.example(mineral: string, seed: number, opts: BuildOpts?): Model
	local o: BuildOpts = table.clone(opts or {})
	if o.Lod == nil then
		o.Lod = true
	end
	local forms = { "Cluster", "Spire", "TwinCore", "HollowBloom" }
	local model = GeodeModel.build({ Mineral = mineral, Formation = forms[seed % #forms + 1], Modifier = "Natural", Rarity = "Common", Mass = 1.2, Seed = seed }, o)
	model.Name = "CT_Rocks_DecorGeode"
	model:SetAttribute("Decorative", true)
	return model
end

-- A pet sitting in a little straw nest on a short pastel pedestal (gallery, Collection corner). Pivot = floor centre.
-- REPLACE: real nest mesh.
function GeodeModel.onStand(spec: { [string]: any }, opts: BuildOpts?): Model
	local o: BuildOpts = table.clone(opts or {})
	local s = o.Scale or GeodeGen.visualScale(spec.Mass or 1)
	o.Scale = s
	local pet = GeodeModel.build(spec, o)
	local out = Instance.new("Model")
	out.Name = "CT_Rocks_SpecimenStand"
	local W = 2.3 * s
	local H = 0.32 * s
	local straw = Color3.fromRGB(214, 172, 108)
	if eggKit("Pedestal", "Nest_Ring") then
		-- soft rounded pedestal + woven straw ring
		local pn: Vector3 = EggKit.size("Pedestal")
		EggKit.place(out, "Pedestal", "StandBase", CFrame.new(), Vector3.new(W / pn.X, H / pn.Y, W / pn.Z), Color3.fromRGB(255, 226, 236))
		part(out, "Nest", Vector3.new(0.12 * s, W * 0.8, W * 0.8), CFrame.new(0, H + 0.05 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), straw:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.Fabric, "cyl")
		local nn: Vector3 = EggKit.size("Nest_Ring")
		local k = W * 0.92 / nn.X
		EggKit.place(out, "Nest_Ring", "Nest", CFrame.new(0, H - 0.04 * s, 0), Vector3.new(k, k * 0.8, k), straw, Enum.Material.Fabric)
	else
		part(out, "StandBase", Vector3.new(H, W, W), CFrame.new(0, H / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 226, 236), Enum.Material.SmoothPlastic, "cyl")
		part(out, "Nest", Vector3.new(0.18 * s, W * 0.82, W * 0.82), CFrame.new(0, H + 0.06 * s, 0) * CFrame.Angles(0, 0, math.rad(90)), straw:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.Fabric, "cyl")
		local ring = if o.Tiny then 5 elseif o.Lod then 6 else 8
		for i = 1, ring do
			local a = i / ring * math.pi * 2
			local r = W * 0.38
			part(out, "Nest", Vector3.new(0.7, 0.34, 0.5) * s, CFrame.new(math.cos(a) * r, H + 0.16 * s, math.sin(a) * r) * CFrame.Angles(0, -a, 0.15), straw, Enum.Material.Fabric, "ball")
		end
	end
	local rest = H + 0.1 * s
	for _, d in pet:GetChildren() do
		if d:IsA("BasePart") then
			d.CFrame = CFrame.new(0, rest, 0) * d.CFrame
			d.Parent = out
		end
	end
	local centreY = pet:GetAttribute("CentreY")
	out:SetAttribute("CentreY", rest + (if type(centreY) == "number" then centreY else 1.1 * s))
	out:SetAttribute("Radius", pet:GetAttribute("Radius"))
	out:SetAttribute("OnStand", true)
	pet:Destroy()
	out.WorldPivot = CFrame.new()
	return out
end

-- Eggshell halves around a pet (hatch) ---------------------------------------------------------------

-- Egg around a pet at scale s: half width A, half height B, centre height Y (pivot = ground under the egg).
local function eggDims(s: number): (number, number, number)
	local A = 1.25 * s
	local B = 1.55 * s
	return A, B, B + 0.02 * s
end

function GeodeModel.shellFit(spec: { [string]: any }, scale: number?): { Width: number, Height: number, CentreY: number }?
	local s = scale or GeodeGen.visualScale(spec.Mass or 1)
	local A, B, Y = eggDims(s)
	return { Width = 2 * A, Height = 2 * B, CentreY = Y }
end

-- Two cracked eggshell halves (left x < 0, right x > 0) that together close a whole egg around the pet. Each half's
-- pivot is its outer hinge (x = -A or +A at the egg centre height). Neon "Crack" zigzags along the seam start
-- invisible (Transparency 1). Colour comes from spec.Seed only (the reveal never needs the pile egg's look).
-- Returns { left, right }.
function GeodeModel.frontHalves(spec: { [string]: any }, scale: number?): { Model }
	local s = scale or GeodeGen.visualScale(spec.Mass or 1)
	local A, B, Y = eggDims(s)
	local seed = spec.Seed or 1
	local shell = eggTint(seed % #EGG_TINTS + 1)
	local spot = spotTint(seed % #SPOT_TINTS + 1)
	local rng = Random.new(seed + 7)
	local thick = 0.09 * s
	local centre = Vector3.new(0, Y, 0)
	local out = {}
	local meshShell = eggKit("Shell_Out", "Shell_In", "Shell_Spots")
	for side = -1, 1, 2 do
		local m = Instance.new("Model")
		m.Name = if side < 0 then "ShellLeft" else "ShellRight"
		m:SetAttribute("Side", side)
		if meshShell then
			-- smooth jagged half-shell meshes (built as the LEFT half; the right half is it turned half a turn)
			local k = Vector3.new(A / 1.25, B / 1.55, A / 1.25) -- meshes are the s = 1 egg (A 1.25, B 1.55)
			local frame = CFrame.new(centre) * (if side < 0 then CFrame.new() else CFrame.Angles(0, math.pi, 0))
			EggKit.place(m, "Shell_Out", "Shell", frame, k, shell)
			EggKit.place(m, "Shell_Spots", "Shell", frame, k, spot)
			EggKit.place(m, "Shell_In", "Inside", frame, k, SHELL_INSIDE)
		end
		-- rings of tangent slabs from the top pole to the bottom pole over this half's azimuths
		local rings: { { number } } = if meshShell then {} else { { 14, 1 }, { 38, 2 }, { 64, 3 }, { 90, 3 }, { 116, 3 }, { 142, 2 }, { 166, 1 } }
		for _, ring in rings do
			local th = math.rad(ring[1])
			local cnt = ring[2]
			for i = 1, cnt do
				local u = (i - 0.5) / cnt
				local ph = if side < 0 then math.pi / 2 + u * math.pi else -math.pi / 2 + u * math.pi
				local p, nrm = eggPoint(A, B, th, ph)
				local w = math.max(math.pi * A * math.sin(th) / cnt * 1.3, A * 0.42)
				local h = B * math.rad(26) * 1.45
				local col = shell
				if rng:NextNumber() < 0.3 then
					col = spot
				end
				part(m, "Shell", Vector3.new(w, h, thick), CFrame.new(centre) * tangentCF(p, nrm) * CFrame.new(0, 0, -thick / 2), col, Enum.Material.SmoothPlastic)
			end
		end
		-- pale inside lining so an opened half reads as a shell
		if not meshShell then
			part(m, "Inside", Vector3.new(0.05 * s, B * 1.5, A * 1.5), CFrame.new(centre + Vector3.new(side * 0.12 * s, 0, 0)), SHELL_INSIDE, Enum.Material.SmoothPlastic, "ball")
		end
		-- zigzag crack along the seam (x = 0 plane), shared by both halves
		local seamRng = Random.new(seed + 19)
		local prev: Vector3? = nil
		for t = -70, 250, 20 do
			local tr = math.rad(t)
			local zig = (if (t // 20) % 2 == 0 then 0.07 else -0.07) * s + seamRng:NextNumber(-0.02, 0.02) * s
			local pnt = Vector3.new(zig, math.sin(tr) * B * 1.03, -math.cos(tr) * A * 1.03)
			if prev then
				local mid = (prev + pnt) / 2
				local len = (pnt - prev).Magnitude
				local c = part(m, "Crack", Vector3.new(0.06 * s, 0.05 * s, len + 0.04 * s), CFrame.new(centre) * CFrame.lookAt(mid, pnt), Color3.fromRGB(255, 248, 210), Enum.Material.Neon)
				c.Transparency = 1
			end
			prev = pnt
		end
		m.WorldPivot = CFrame.new(centre + Vector3.new(side * A * 0.97, 0, 0))
		table.insert(out, m)
	end
	return out
end

-- Pile eggs ---------------------------------------------------------------------------------------

-- Pattern, tint index and yaw for an opaque egg id in a round (stable on every client; nothing about the target).
function GeodeModel.rockLook(id: number, seed: number): (number, number, number)
	local r = Random.new((seed % 100000) * 7919 + id * 104729)
	return r:NextInteger(1, PATTERNS), r:NextInteger(1, #EGG_TINTS), r:NextNumber(0, 360)
end

export type RockOpts = {
	Tint: number?, -- EGG_TINTS index
	Low: boolean?, -- body only (eggs buried inside the mound)
	Mini: boolean?, -- miniature for the basket, tray and plate (no shadows)
	Interactive: boolean?, -- Bounds part can be hit by tap rays (pile eggs)
	Cracks: boolean?, -- unused for eggs (HitFx draws the crack lines)
	Color: Color3?, -- body colour instead of the tint (shop eggs); needs NoTexture to show on the owner's textured eggs
	NoTexture: boolean?, -- never the owner's textured pile eggs (the smooth kit egg or Parts, which take a colour)
}

local function bounds(m: Model, size: Vector3, interactive: boolean): BasePart
	local b = Instance.new("Part")
	b.Name = "Bounds"
	b.Anchored = true
	b.CanCollide = false
	b.CanTouch = false
	b.CanQuery = interactive
	b.CastShadow = false
	b.Transparency = 1
	b.Size = size
	b.Parent = m
	return b
end

-- One egg Model. `variant` 1..RockVariants = pattern, `size` = egg height in studs, `name` = the egg id. PrimaryPart
-- is "Bounds" (invisible interaction box, 1.25 x the egg height so callers resting at 0.4 x Bounds height sit it on
-- the surface). Visible pieces are named "Rock" (the plate's crack drift moves them). Pivot = egg centre.
-- REPLACE: real egg mesh.
function GeodeModel.rockShell(variant: number, size: number, name: string, opts: RockOpts?): Model
	local o: RockOpts = opts or {}
	local v = ((variant - 1) % PATTERNS) + 1
	local D = size
	local A, B = 0.39 * D, 0.5 * D
	local tint = o.Color or eggTint(o.Tint or 1)
	local spot = spotTint((o.Tint or 1) + (v - 1) // 4)
	local mini = o.Mini == true
	local m = Instance.new("Model")
	m.Name = name
	bounds(m, Vector3.new(2 * A * 1.1, 2 * B * 1.25, 2 * A * 1.1), o.Interactive == true)
	-- the owner's textured egg meshes, picked by the tint only (rockLook: egg id + round seed, never the target), so
	-- the pet egg looks like every other egg of its colour. All four must be there, else no egg uses them.
	local worldEgg = WORLD_EGG[((o.Tint or 1) - 1) % #WORLD_EGG + 1]
	local wsize: Vector3? = if WorldKit and not o.NoTexture and WorldKit.has(table.unpack(WorldKit.Eggs)) then WorldKit.size(worldEgg) else nil
	if wsize then
		local body: BasePart? = WorldKit.clone(worldEgg, "Rock")
		if body then
			-- one mesh, uniform scale to fit inside the old egg body (2A x 2B x 2A), bottom on the old egg's bottom
			local k = math.min(2 * A / wsize.X, 2 * B / wsize.Y, 2 * A / wsize.Z)
			body.Size = wsize * k
			body.CFrame = CFrame.new(0, -B + body.Size.Y / 2, 0) * CFrame.Angles(0, (v * 1.7) % (math.pi * 2), 0)
			body.CastShadow = not mini
			body.Parent = m
			m.PrimaryPart = m:FindFirstChild("Bounds") :: BasePart
			m:PivotTo(CFrame.new())
			return m
		end
	end
	local pat = "Egg_Pat" .. ((v - 1) % 4 + 1)
	if eggKit("Egg_Body", pat) then
		-- one smooth egg mesh + one pattern mesh (2 parts instead of up to 7)
		local nat: Vector3 = EggKit.size("Egg_Body")
		local k = Vector3.new(2 * A / nat.X, 2 * B / nat.Y, 2 * A / nat.Z)
		local yaw = CFrame.Angles(0, (v * 1.7) % (math.pi * 2), 0)
		local body = EggKit.place(m, "Egg_Body", "Rock", yaw, k, tint)
		if body then
			body.CastShadow = not mini
		end
		if not o.Low then
			local rngC = Random.new(v * 131 + (o.Tint or 1))
			local col = if (v - 1) % 4 == 3 then spot:Lerp(Color3.new(1, 1, 1), 0.15) else spot
			EggKit.place(m, pat, "Rock", yaw * CFrame.Angles(0, rngC:NextNumber(0, math.pi * 2), 0), k, col)
		end
		m.PrimaryPart = m:FindFirstChild("Bounds") :: BasePart
		m:PivotTo(CFrame.new())
		return m
	end
	local body = part(m, "Rock", Vector3.new(2 * A, 2 * B, 2 * A), CFrame.new(), tint, Enum.Material.SmoothPlastic, "ball")
	body.CastShadow = not mini
	if not o.Low then
		local kindIdx = (v - 1) % 4
		local rng = Random.new(v * 131 + (o.Tint or 1))
		local function decal(th: number, ph: number, w: number, h: number, col: Color3)
			local p, nrm = eggPoint(A, B, th, ph)
			part(m, "Rock", Vector3.new(w, h, 0.05 * D), tangentCF(p, nrm) * CFrame.new(0, 0, -0.012 * D), col, Enum.Material.SmoothPlastic, "ball")
		end
		if kindIdx == 0 then -- big spots
			for i = 1, 4 do
				local s = rng:NextNumber(0.2, 0.3) * D
				decal(rng:NextNumber(0.5, 2.3), i * 1.57 + rng:NextNumber(-0.4, 0.4), s, s, spot)
			end
		elseif kindIdx == 1 then -- zigzag band round the middle
			for i = 1, 6 do
				local ph = i / 6 * math.pi * 2
				local p, nrm = eggPoint(A, B, math.pi / 2, ph)
				part(m, "Rock", Vector3.new(0.4 * D, 0.1 * D, 0.04 * D), tangentCF(p, nrm) * CFrame.Angles(0, 0, if i % 2 == 0 then 0.5 else -0.5), spot, Enum.Material.SmoothPlastic)
			end
		elseif kindIdx == 2 then -- two stripes (rings of flat ovals)
			for _, th in { 1.15, 2.0 } do
				for i = 1, 3 do
					decal(th, i / 3 * math.pi * 2 + th, 0.42 * D, 0.1 * D, spot)
				end
			end
		else -- many small dots
			for i = 1, 6 do
				local s = rng:NextNumber(0.1, 0.14) * D
				decal(rng:NextNumber(0.4, 2.5), i * 1.05 + rng:NextNumber(-0.3, 0.3), s, s, spot:Lerp(Color3.new(1, 1, 1), 0.15))
			end
		end
	end
	m.PrimaryPart = m:FindFirstChild("Bounds") :: BasePart
	m:PivotTo(CFrame.new())
	return m
end

-- A small heap of cracked eggshell pieces about `size` studs across. Pivot = heap centre. Never nil now.
function GeodeModel.rubble(size: number, tint: number, name: string): Model?
	local rng = Random.new(#name * 97 + tint * 13)
	local col = eggTint(tint)
	local m = Instance.new("Model")
	m.Name = name
	bounds(m, Vector3.new(size * 0.8, size * 0.5, size * 0.8), false)
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2 + rng:NextNumber(-0.4, 0.4)
		local r = size * 0.22
		local sz = size * rng:NextNumber(0.42, 0.58)
		local cf = CFrame.new(math.cos(a) * r, -size * 0.12 + i * 0.02 * size, math.sin(a) * r) * CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, 6.28), rng:NextNumber(-0.6, 0.6))
		if eggKit("Shard") then
			-- curved jagged bit of shell, about the old flat oval's footprint
			local nat: Vector3 = EggKit.size("Shard")
			local k = sz / math.max(nat.Y, nat.Z)
			local frame = cf * CFrame.Angles(math.rad(90), 0, 0)
			local sh = EggKit.place(m, "Shard", "Rock", CFrame.new(), Vector3.one * k, if i == 2 then SHELL_INSIDE else col)
			if sh then
				sh.CFrame = frame -- centred on the piece's spot (the mesh offset is irrelevant here)
			end
		else
			part(m, "Rock", Vector3.new(sz, sz * 0.22, sz * 0.8), cf, if i == 2 then SHELL_INSIDE else col, Enum.Material.SmoothPlastic, "ball")
		end
	end
	m.PrimaryPart = m:FindFirstChild("Bounds") :: BasePart
	m:PivotTo(CFrame.new())
	return m
end

-- Flat decorative patches are off (they read as pickable objects).
function GeodeModel.gritPatch(_width: number, _rng: Random): BasePart?
	return nil
end

-- Decorative bit (no id, never queryable): a tiny eggshell crumb for hit bursts and pickup dust. The grass clumps
-- this once also made for the pile base read as dark green discs and are gone.
function GeodeModel.grit(rng: Random, maxSize: number): BasePart
	local p = Instance.new("Part")
	p.Name = "Grit"
	local s = maxSize * rng:NextNumber(0.5, 1)
	p.Size = Vector3.new(s, s * 0.25, s * rng:NextNumber(0.6, 1))
	p.Color = if rng:NextNumber() < 0.5 then SHELL_INSIDE else EGG_TINTS[rng:NextInteger(1, #EGG_TINTS)]
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

local _ = Config -- (palette lives in Config; kept required for callers that rely on load order)

return GeodeModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="139">
        <Properties>
          <string name="Name">Hangout</string>
          <string name="Source"><![CDATA[--!strict
-- Lobby hangout (owner picks 2026-10-14: ideas 1, 2, 4, 6, 7, 8, 9, 10; no trading, no pet tricks). All tuning and the
-- pure rules, tested offline (tests/test_hangout.luau). The server owns every outcome (server/LobbyHangout,
-- server/LobbyGames, server/LobbyEvents); clients only draw (client/HangoutView).
--
--   1 show-off plots   likes are saved per UTC day; the plot with the most likes TODAY wears the crown and a glow
--   2 rare-hatch alert a sky beam over the egg shrine when an Epic or Legendary hatches in this server
--   4 mini-games       whack-a-rock stump (the pet race and egg toss were removed 2026-10-14); small coin prizes, one daily cap
--   6 big boards       MOST COINS joins RAREST PET and HIGHEST FLOOR (shared/Boards)
--   7 hourly events    coin rain, golden rock (everyone cracks it together), mystery egg drop
--   8 sit spots        Seats (benches, swing, dock, campfire logs) get a Sit prompt; emote button (Roblox's own emotes)
--   9 secret spots     hidden eggs (coins once each) and the lookout chest up the mountain (coins once a day)
--  10 group bonus      Roblox group members get a free pet once and a little hunt luck (needs the group id)
--
-- Profile state lives in data.Hangout (Hangout.empty), added without a schema bump.

local Retention = require(script.Parent.Retention)

local Hangout = {}

local DAY = 86400

function Hangout.day(now: number): number
	return math.floor(now / DAY)
end

-- Profile state ----------------------------------------------------------------------------------------------------

export type State = {
	Day: number, -- UTC day the daily fields below belong to
	LikesToday: number, -- likes this player's plot got today
	Liked: { string }, -- owner UserIds (strings) this player liked today
	GameCoins: number, -- mini-game coins paid today (Games.DailyCoinCap)
	LookoutDay: number, -- last UTC day the lookout chest was opened
	Secrets: { [string]: boolean }, -- hidden egg names found (once ever)
	GroupGift: boolean, -- free group pet already given
}

function Hangout.empty(): State
	return { Day = 0, LikesToday = 0, Liked = {}, GameCoins = 0, LookoutDay = 0, Secrets = {}, GroupGift = false }
end

local function num(v: any): number
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else 0
end

-- Fills or repairs a saved state in place (an old or hand-edited save) and returns it.
function Hangout.sanitize(s: any): State
	if type(s) ~= "table" then
		return Hangout.empty()
	end
	s.Day = math.floor(num(s.Day))
	s.LikesToday = math.max(0, math.floor(num(s.LikesToday)))
	s.GameCoins = math.max(0, math.floor(num(s.GameCoins)))
	s.LookoutDay = math.floor(num(s.LookoutDay))
	if type(s.Liked) ~= "table" then
		s.Liked = {}
	end
	if type(s.Secrets) ~= "table" then
		s.Secrets = {}
	end
	s.GroupGift = s.GroupGift == true
	return s :: State
end

-- Starts a new day: today's likes, liked list and game coins go back to zero.
function Hangout.roll(s: State, day: number)
	if s.Day ~= day then
		s.Day = day
		s.LikesToday = 0
		s.Liked = {}
		s.GameCoins = 0
	end
end

-- 1 Show-off plots --------------------------------------------------------------------------------------------------

Hangout.Likes = {
	LikedMax = 200, -- owners one player can like per day (keeps the save small)
	Glow = Color3.fromRGB(255, 214, 92),
}

-- A like from `visitor` (state, UserId) for `owner` (state, UserId). Returns (ok, reason "own" | "again" | "max").
function Hangout.like(visitor: State, visitorId: number, owner: State, ownerId: number, day: number): (boolean, string?)
	if visitorId == ownerId then
		return false, "own"
	end
	Hangout.roll(visitor, day)
	Hangout.roll(owner, day)
	local key = tostring(ownerId)
	if table.find(visitor.Liked, key) then
		return false, "again"
	end
	if #visitor.Liked >= Hangout.Likes.LikedMax then
		return false, "max"
	end
	table.insert(visitor.Liked, key)
	owner.LikesToday += 1
	return true, nil
end

function Hangout.likesToday(s: State, day: number): number
	return if s.Day == day then s.LikesToday else 0
end

-- 2 Rare-hatch alert -----------------------------------------------------------------------------------------------

Hangout.Beam = {
	Rarities = { Epic = true, Legendary = true },
	Seconds = 8,
	Height = 400,
	Width = { Epic = 5, Legendary = 8 },
	Color = { Epic = Color3.fromRGB(196, 110, 255), Legendary = Color3.fromRGB(255, 206, 64) },
}

function Hangout.beamFor(rarity: any): boolean
	return type(rarity) == "string" and Hangout.Beam.Rarities[rarity] == true
end

-- 4 Mini-games ----------------------------------------------------------------------------------------------------

Hangout.Games = {
	DailyCoinCap = 600, -- all mini-game prizes together, per player per UTC day
	Range = 16, -- studs from a game's prompt part
	Whack = { Seconds = 20, PopSeconds = 0.9, Gap = 0.15, CoinsPerHit = 2, MaxCoins = 40, Cooldown = 5, HoleRadius = 2.6, Holes = 5, LeaveDistance = 30 },
}

-- Coins a mini-game may still pay `want` today (the daily cap), and books them.
function Hangout.payGame(s: State, day: number, want: number): number
	Hangout.roll(s, day)
	local room = math.max(0, Hangout.Games.DailyCoinCap - s.GameCoins)
	local pay = math.clamp(math.floor(num(want)), 0, room)
	s.GameCoins += pay
	return pay
end

function Hangout.whackPrize(hits: number): number
	local w = Hangout.Games.Whack
	return math.clamp(math.floor(num(hits)) * w.CoinsPerHit, 0, w.MaxCoins)
end

-- 7 Hourly events -------------------------------------------------------------------------------------------------

Hangout.Events = {
	Interval = 3600, -- one event at the start of every UTC hour (every server at once)
	WarnSeconds = 60, -- "starts in 1 minute" toast
	Order = { "CoinRain", "GoldenRock", "MysteryEgg" },
	CoinRain = { Seconds = 30, Coins = 80, CoinValue = 5, PlayerCap = 75, Radius = 36, DropHeight = 40, Life = 25 },
	GoldenRock = { Seconds = 120, HitsPerPlayer = 15, MinHits = 25, HitGap = 0.25, Prize = 60, Range = 14 },
	MysteryEgg = { Seconds = 90, Egg = "BasicEgg", FallbackCoins = 120, Range = 12 },
	Names = { CoinRain = "COIN RAIN", GoldenRock = "GOLDEN EGG", MysteryEgg = "MYSTERY EGG" },
}

-- The event that starts at the hour slot holding `now`, and when the next one starts.
function Hangout.eventAt(now: number): string
	local e = Hangout.Events
	local slot = math.floor(now / e.Interval)
	return e.Order[slot % #e.Order + 1]
end

function Hangout.nextEventTime(now: number): number
	local e = Hangout.Events
	return (math.floor(now / e.Interval) + 1) * e.Interval
end

-- Hits the golden rock needs with `players` in the lobby.
function Hangout.rockHits(players: number): number
	local g = Hangout.Events.GoldenRock
	return math.max(g.MinHits, math.floor(num(players)) * g.HitsPerPlayer)
end

-- Coin-rain coins one player may still collect this event.
function Hangout.rainRoom(collected: number): number
	local c = Hangout.Events.CoinRain
	return math.max(0, c.PlayerCap - math.floor(num(collected)))
end

-- 8 Sit spots + emotes --------------------------------------------------------------------------------------------

Hangout.Sit = {
	Names = { "SitSpot", "Bench", "Swing", "DockSeat", "CampfireLog" }, -- a part whose name starts with one of these
	Campfire = "Campfire", -- gets a warm light (static: no flames moving, owner rule)
}

-- Roblox's default emotes, read from the avatar's own Animate script at run time (no asset ids here).
Hangout.Emotes = {
	{ Key = "wave", Name = "Wave" },
	{ Key = "cheer", Name = "Cheer" },
	{ Key = "dance", Name = "Dance" },
	{ Key = "dance2", Name = "Dance 2" },
	{ Key = "laugh", Name = "Laugh" },
	{ Key = "point", Name = "Point" },
}

function Hangout.isSitName(name: string): boolean
	for _, n in Hangout.Sit.Names do
		if string.sub(name, 1, #n) == n then
			return true
		end
	end
	return false
end

-- 9 Secret spots --------------------------------------------------------------------------------------------------

Hangout.Secrets = {
	Prefix = "HiddenEgg", -- HiddenEgg1, HiddenEgg2, ... anywhere in the lobby
	Coins = 75, -- once per hidden egg, ever
	Lookout = "LookoutChest", -- the chest at the mountain lookout
	LookoutCoins = 150, -- once per UTC day
	Range = 12,
}

-- A hidden egg's name -> its number, or nil when the name is not a hidden egg.
function Hangout.secretIndex(name: string): number?
	local n = string.match(name, "^" .. Hangout.Secrets.Prefix .. "(%d+)$")
	return if n then tonumber(n) else nil
end

function Hangout.claimSecret(s: State, name: string): boolean
	if not Hangout.secretIndex(name) or s.Secrets[name] then
		return false
	end
	s.Secrets[name] = true
	return true
end

function Hangout.secretsFound(s: State): number
	local n = 0
	for k, v in s.Secrets do
		if v == true and Hangout.secretIndex(k) then
			n += 1
		end
	end
	return n
end

-- The found hidden eggs as one short player attribute ("HiddenEgg1,HiddenEgg3", sorted): the client hides those
-- eggs and their Take prompts for this player only (audit F25: a taken egg stayed visible and tappable).
Hangout.Secrets.FoundAttr = "HiddenEggsFound"
function Hangout.foundList(s: State): string
	local names = {}
	for k, v in s.Secrets do
		if v == true and Hangout.secretIndex(k) then
			table.insert(names, k)
		end
	end
	table.sort(names, function(a, b)
		return (Hangout.secretIndex(a) or 0) < (Hangout.secretIndex(b) or 0)
	end)
	return table.concat(names, ",")
end

-- The attribute back to a set of hidden egg names (junk and unknown names are dropped).
function Hangout.parseFound(text: any): { [string]: boolean }
	local out = {}
	if type(text) == "string" then
		for name in string.gmatch(text, "[^,]+") do
			if Hangout.secretIndex(name) then
				out[name] = true
			end
		end
	end
	return out
end

function Hangout.claimLookout(s: State, day: number): boolean
	if s.LookoutDay == day then
		return false
	end
	s.LookoutDay = day
	return true
end

-- Animation (owner ask 2026-10-14: "animate what you can on all of them, glowing aura etc"; this lifts the old
-- static-props rule for the hangout pieces). Drawn by client/HangoutAnim, only within Near studs of the camera.
Hangout.Anim = {
	Near = 140, -- studs: farther pieces stop moving and their sparkles switch off
	CullEvery = 0.5, -- seconds between distance checks
	-- part name (exact, or a pattern) -> look
	Kinds = {
		{ Match = "^GoldenRock$", Kind = "GoldenRock" },
		{ Match = "^MysteryEgg$", Kind = "MysteryEgg" },
		{ Match = "^WhackRock$", Kind = "WhackRock" },
		{ Match = "^RainCoin$", Kind = "RainCoin" },
		{ Match = "^HiddenEgg%d+$", Kind = "HiddenEgg" },
		{ Match = "^LookoutChest$", Kind = "Lookout" },
		{ Match = "^CampfireLight$", Kind = "Campfire" },
		{ Match = "^CT_TopPlotGlow$", Kind = "TopPlot" },
		{ Match = "^CT_Park_PlotCrown$", Kind = "Crown" },
		{ Match = "^SkyBeam$", Kind = "Beam" },
		{ Match = "^WhackStump$", Kind = "Stump" },
	},
}

function Hangout.animKind(name: string): string?
	for _, k in Hangout.Anim.Kinds do
		if string.match(name, k.Match) then
			return k.Kind
		end
	end
	return nil
end

-- A smooth 0..1 pulse at `speed` cycles per second (phase-shifted by `seed`).
function Hangout.pulse(t: number, speed: number, seed: number?): number
	return 0.5 + 0.5 * math.sin((t * speed + (seed or 0)) * math.pi * 2)
end

-- Is a piece at distance `d` from the camera animated?
function Hangout.animNear(d: number, lowEffects: boolean): boolean
	return d <= (if lowEffects then Hangout.Anim.Near / 2 else Hangout.Anim.Near)
end

-- 10 Group bonus --------------------------------------------------------------------------------------------------

-- The group id is Retention.Group.Id (one place for it; the daily group coin gift uses it too).
Hangout.Group = {
	Luck = 0.05, -- extra hunt luck for group members
	GiftEgg = "BasicEgg", -- the free pet is hatched from this egg (race egg odds)
	GiftPrompt = "GroupGift", -- optional part in the lobby: "Claim" re-checks after joining the group
}

function Hangout.groupId(): number
	return Retention.Group.Id
end

function Hangout.groupOn(): boolean
	local id = Hangout.groupId()
	return type(id) == "number" and id > 0 and id == math.floor(id)
end

function Hangout.groupLuck(member: boolean): number
	return if member and Hangout.groupOn() then Hangout.Group.Luck else 0
end

-- GroupService:GetGroupsAsync rows -> member of the configured group?
function Hangout.inGroup(rows: any): boolean
	if not Hangout.groupOn() or type(rows) ~= "table" then
		return false
	end
	for _, r in rows do
		if type(r) == "table" and r.Id == Hangout.groupId() then
			return true
		end
	end
	return false
end

return Hangout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="140">
        <Properties>
          <string name="Name">HintRules</string>
          <string name="Source"><![CDATA[--!strict
-- HINT RULES: the one rule for tutorial / tip hints (pure; tests/test_hint_rules.luau).
--   * Each hint has an id. A hint hides for good once its step is done (done is remembered: it never comes back,
--     even if the caller asks again), and it hides after its timeout (seconds really on screen; time with a menu
--     over it does not count). A timed-out hint stays hidden for the rest of the session.
--   * Hint text is device aware: a key name only for a player who really uses a keyboard / mouse or a gamepad. Touch
--     players are never told to press a key (bug #221).
--   * The hunt's first hint says the goal and the action together: find the pet egg; grab eggs, bring them to your
--     nest, hatch them (walkthrough 2026-10-14 #9).

local HintRules = {}

export type Input = "Touch" | "Keyboard" | "Gamepad"

-- Seconds on screen before a hint retires for the session (nil = no timeout: the hint follows the action).
HintRules.Timeout = {
	Lobby = 10, -- every lobby tutorial hint (Pet Book, sell candy, goal): the marker and menus keep pointing the way
	Pickup = 15, -- the hunt's first hint (goal + controls)
	FreePet = 30, -- the world "FREE PET!" tag over the starter egg (the egg keeps glowing and sparkling)
}

-- Which input the wording should use. `last` is the name of UserInputService:GetLastInputType(); a phone whose last
-- input reads as something else (Focus, None, a stray mouse event) gets touch wording, never a key.
function HintRules.inputKind(last: string, touchEnabled: boolean, keyboardEnabled: boolean): Input
	if string.sub(last, 1, 7) == "Gamepad" then
		return "Gamepad"
	end
	local keys = last == "Keyboard" or string.sub(last, 1, 5) == "Mouse"
	if last == "Touch" or not keys or (touchEnabled and not keyboardEnabled) then
		return "Touch"
	end
	return "Keyboard"
end

-- The control that grabs an egg, named for the input (touch: the on-screen PICK UP button).
local GRAB = { Keyboard = "hold E", Gamepad = "hold RT", Touch = "hold PICK UP" }

-- The hunt's first hint: goal and action in one line.
function HintRules.pickupTip(input: Input): string
	return "Find the pet egg! Grab eggs (" .. GRAB[input] .. "), hatch them at your nest!"
end

-- After the first plain egg: keyboard players learn the cursor key, everyone else hears the goal again.
function HintRules.candyTip(input: Input): string
	if input == "Keyboard" then
		return "Just candy! Hold ALT to click buttons!"
	end
	return "Just candy! One egg hides the pet!"
end

-- Lifetime ----------------------------------------------------------------------------------------

export type State = { Shown: { [string]: number }, Retired: { [string]: boolean }, Done: { [string]: boolean } }

function HintRules.new(): State
	return { Shown = {}, Retired = {}, Done = {} }
end

-- Marks a hint done: it never shows again.
function HintRules.done(s: State, id: string)
	s.Done[id] = true
end

-- True when hint `id` may show now. `dt` = seconds since the last call, counted only when `onScreen` (the hint really
-- had the screen: no menu over it). `timeout` = seconds before it retires (nil = never times out).
function HintRules.visible(s: State, id: string, timeout: number?, onScreen: boolean, dt: number): boolean
	if s.Done[id] or s.Retired[id] then
		return false
	end
	if timeout then
		if onScreen then
			local t = (s.Shown[id] or 0) + math.clamp(dt, 0, 0.5)
			s.Shown[id] = t
			if t >= timeout then
				s.Retired[id] = true
				return false
			end
		end
	end
	return true
end

HintRules.PickupKey = "Find the pet egg!" -- the id of the hunt's first hint (any input)

-- One id per hint text, so a hint whose wording carries a live number ("Nice! You have 120 coins") keeps one clock.
function HintRules.key(text: string): string
	return string.match(text, "^(Nice! You have )") or string.match(text, "^(Find the pet egg!)") or text
end

return HintRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="141">
        <Properties>
          <string name="Name">HuntFun</string>
          <string name="Source"><![CDATA[--!strict
-- Hunt fun (owner picks 2026-10-15, "do 1 2 and 6"): pure rules, tested in tests/test_hunt_fun.luau.
--   1. Surprise eggs: every ordinary egg a player finishes pops a small server-rolled prize on top of its shells:
--      coins, pet XP or (rarely) a coin jackpot, and every 10th egg adds a Lucky Meter point. Never a pet.
--   2. Pet helper: the strongest equipped pet the player found (never one from a Robux egg, so Robux never changes who
--      finds the pet) joins the hunt and helps: faster cracking and extra basket room, bigger with more POWER.
--   6. Prizes for everyone: the racers who did not find the pet get a medal by eggs finished (2nd, 3rd, 4th), coins
--      and pet XP. A racer who finished no egg gets nothing (no reward for standing still or for the leftover pile).
-- Applied by src/server/RockService.luau (1, 2) and src/server/MatchService.luau (6); shown by the client
-- (Main "Surprise" event, PetFollow helper, ResultsPanel prize line).

local Config = require(script.Parent.Config)
local PetStats = require(script.Parent.PetStats)

local HuntFun = {}

HuntFun.Surprise = {
	Enabled = true,
	-- what an ordinary egg pops (relative weights; every egg pops one)
	Weights = { Coins = 58, Xp = 41, Jackpot = 1 } :: { [string]: number },
	Order = { "Coins", "Xp", "Jackpot" }, -- fixed roll order (weights tables have no order)
	-- Lucky Meter: every EggsPerMeter-th ordinary egg adds one point, for sure (a 5% random tick left the meter at 0
	-- for a whole Studio hunt, 2026-10-15). A shop Basic egg is 1 point too; 30 points fill the meter.
	EggsPerMeter = 10,
	CoinsMin = 1, -- coins = CoinsMin..CoinsMax x the zone's CashPerRubble
	CoinsMax = 2,
	Jackpot = 40, -- jackpot coins = Jackpot x the zone's CashPerRubble
	Xp = 3, -- pet XP for each following pet (the Pet Book page bonus applies on top)
}

HuntFun.Helper = {
	Enabled = true,
	-- POWER steps (PetStats.power): Rate = crack speed bonus (share), Carry = extra basket slots. A fresh Common is
	-- about 110 POWER, a maxed Common about 230, a maxed Legendary about 1600.
	Steps = {
		{ Power = 0, Rate = 0.05, Carry = 1 },
		{ Power = 250, Rate = 0.10, Carry = 1 },
		{ Power = 500, Rate = 0.15, Carry = 2 },
		{ Power = 900, Rate = 0.20, Carry = 2 },
		{ Power = 1400, Rate = 0.25, Carry = 3 },
	},
}

HuntFun.Prizes = {
	Enabled = true,
	Medals = { "Gold", "Silver", "Bronze", "Star" }, -- by place; the finder is always Gold
	Coins = { 0, 15, 10, 6 }, -- base coins by place (x the zone's CashPerRubble / 2); the finder gets the pet instead
	CoinsPerEgg = 1, -- + this per egg finished (same zone factor)
	MaxEggs = 60, -- eggs counted for the per-egg part
	Xp = { 0, 20, 14, 10 }, -- pet XP by place, for each following pet
	MinEggs = 1, -- at least this many eggs finished to get a prize
}

local function zoneFactor(tierId: string): number
	local tier = Config.Tiers[tierId]
	return if tier then math.max(tier.CashPerRubble, 1) else 1
end

export type Surprise = { Kind: string, Amount: number }

-- One ordinary egg's surprise, rolled by the server.
function HuntFun.surprise(rng: Random, tierId: string): Surprise
	local cfg = HuntFun.Surprise
	local total = 0
	for _, k in cfg.Order do
		total += cfg.Weights[k] or 0
	end
	local r = rng:NextNumber() * total
	local kind = cfg.Order[1]
	for _, k in cfg.Order do
		local w = cfg.Weights[k] or 0
		if r < w then
			kind = k
			break
		end
		r -= w
	end
	local f = zoneFactor(tierId)
	if kind == "Coins" then
		return { Kind = kind, Amount = rng:NextInteger(cfg.CoinsMin, cfg.CoinsMax) * f }
	elseif kind == "Jackpot" then
		return { Kind = kind, Amount = cfg.Jackpot * f }
	elseif kind == "Xp" then
		return { Kind = kind, Amount = cfg.Xp }
	end
	return { Kind = "Xp", Amount = cfg.Xp }
end

-- Counts one more ordinary hunt egg toward the Lucky Meter: the new count and whether this egg adds a point.
function HuntFun.meterTick(count: any): (number, boolean)
	local n = (if type(count) == "number" and count == count then math.max(math.floor(count), 0) else 0) + 1
	local per = math.max(HuntFun.Surprise.EggsPerMeter, 1)
	if n >= per then
		return 0, true
	end
	return n, false
end

export type HelperStep = { Power: number, Rate: number, Carry: number }

-- The helper step for a pet POWER (nil power = no helper).
function HuntFun.helperStep(power: number?): HelperStep?
	if not HuntFun.Helper.Enabled or type(power) ~= "number" or power ~= power then
		return nil
	end
	local best: HelperStep? = nil
	for _, s in HuntFun.Helper.Steps do
		if power >= s.Power then
			best = s
		end
	end
	return best
end

export type Candidate = { Pet: { [string]: any }, Xp: number?, Bought: boolean }

-- The helper among the equipped pets: the highest POWER pet that did not come from a Robux egg (ties: list order).
-- Returns the pet and its POWER, or nil when every equipped pet was bought (or none is equipped).
function HuntFun.pickHelper(list: { Candidate }): ({ [string]: any }?, number)
	local best, bestPower = nil, -1
	for _, c in list do
		if not c.Bought and type(c.Pet) == "table" then
			local p = PetStats.powerOfPet(c.Pet, c.Xp or 0)
			if p > bestPower then
				best, bestPower = c.Pet, p
			end
		end
	end
	return best, math.max(bestPower, 0)
end

export type Racer = { UserId: number, Eggs: number }
export type Prize = { Place: number, Medal: string, Coins: number, Xp: number }

-- Places for one finished round: the finder is 1st; the others by eggs finished (most first), equal counts share a
-- place. Racers below MinEggs get no row. `winner` may be nil (a round that ended without a finder gives no prizes).
function HuntFun.prizes(racers: { Racer }, winner: number?, tierId: string): { [number]: Prize }
	local cfg = HuntFun.Prizes
	local out: { [number]: Prize } = {}
	if not cfg.Enabled or winner == nil then
		return out
	end
	out[winner] = { Place = 1, Medal = cfg.Medals[1], Coins = 0, Xp = 0 }
	local rest: { Racer } = {}
	for _, r in racers do
		if r.UserId ~= winner and (tonumber(r.Eggs) or 0) >= cfg.MinEggs then
			table.insert(rest, r)
		end
	end
	table.sort(rest, function(a, b)
		if a.Eggs ~= b.Eggs then
			return a.Eggs > b.Eggs
		end
		return a.UserId < b.UserId
	end)
	local f = zoneFactor(tierId) / 2
	local place = 1
	for i, r in rest do
		if i == 1 or r.Eggs ~= rest[i - 1].Eggs then
			place = i + 1
		end
		local at = math.min(place, #cfg.Medals)
		local eggs = math.min(math.floor(r.Eggs), cfg.MaxEggs)
		out[r.UserId] = {
			Place = place,
			Medal = cfg.Medals[at],
			Coins = math.max(1, math.floor((cfg.Coins[at] + cfg.CoinsPerEgg * eggs) * f + 0.5)),
			Xp = cfg.Xp[at],
		}
	end
	return out
end

-- Surprise pop placement (client SurprisePop), in screen shares (0..1). Studio 2026-10-15: pops over the nest were
-- behind the first-person camera, and pops in front of the camera in the world drifted over the top-left clock card.
-- They are screen pops now, right of centre, clear of the clock card (top left), the action button (bottom right) and
-- the crosshair; up to three in the air at once, in different rows.
HuntFun.PopSpots = { Vector2.new(0.68, 0.42), Vector2.new(0.68, 0.32), Vector2.new(0.68, 0.64) }

function HuntFun.popScreen(n: number): Vector2
	local spots = HuntFun.PopSpots
	return spots[(math.max(math.floor(n), 0) % #spots) + 1]
end

export type TargetCand = { Id: number, Pos: Vector3 }

-- Which pickable egg in reach the action takes (client PileView auto target, third person): the nearest, the one the
-- avatar and camera face preferred. `priority` = the gold overtime egg: when it is in reach it always wins (Studio
-- 2026-10-15: the glowing egg lay alone at the pile edge 3 studs away, but eggs the player faced won every time, so
-- the round sat at 0:00). The glow is public by then (EggConfig.Overtime), so this gives nothing away.
function HuntFun.pickTarget(cands: { TargetCand }, rp: Vector3, look: Vector3, camLook: Vector3, limit: number, priority: number?): number?
	local best, bestScore = nil, math.huge
	for _, c in cands do
		local pos = c.Pos
		local dx, dz = pos.X - rp.X, pos.Z - rp.Z
		local d = math.sqrt(dx * dx + dz * dz)
		if d <= limit then
			if c.Id == priority then
				return c.Id
			end
			local facing = if d > 0.01 then (look.X * dx + look.Z * dz) / d else 1
			local aim = if d > 0.01 then (camLook.X * dx + camLook.Z * dz) / d else 1
			local score = d - facing * 3 - aim * 1.5 + pos.Y * -0.05
			if score < bestScore then
				best, bestScore = c.Id, score
			end
		end
	end
	return best
end

return HuntFun
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="142">
        <Properties>
          <string name="Name">HuntLedger</string>
          <string name="Source"><![CDATA[--!strict
-- Per-hunt rubble accounting (pure, tested in tests/test_hunt_ledger.luau).
--
-- The profile owns the persistent rubble bag and the cash. This ledger only COUNTS what happened during
-- one hunt so the results screen can label each figure honestly:
--   Processed     rocks the player finished crushing (the geode rock counts)
--   RubbleEarned  ordinary rubble granted to the bag by those rocks
--   RubbleSold    rubble sold at the hopper while the hunt was running (may include carried-over material)
--   SoldCash      cash those sales paid
-- Bag count, capacity and bag value come from the profile at snapshot time. Nothing here ever grants
-- rubble or cash: it is read-only bookkeeping, so building a results screen cannot change any balance.

export type Row = { Processed: number, RubbleEarned: number, RubbleSold: number, SoldCash: number }
export type Ledger = { Rows: { [number]: Row }, Closed: boolean }
export type Snapshot = {
	Processed: number,
	RubbleEarned: number,
	RubbleSold: number,
	SoldCash: number,
	BagCount: number,
	BagCapacity: number,
	BagValue: number,
	SpecimenValue: number?,
}

local HuntLedger = {}

function HuntLedger.new(): Ledger
	return { Rows = {}, Closed = false }
end

local function row(l: Ledger, uid: number): Row
	local r = l.Rows[uid]
	if not r then
		r = { Processed = 0, RubbleEarned = 0, RubbleSold = 0, SoldCash = 0 }
		l.Rows[uid] = r
	end
	return r
end

local function whole(n: any): number
	if type(n) ~= "number" or n ~= n or n < 0 or n == math.huge then
		return 0
	end
	return math.floor(n)
end

-- A rock finished. `ordinary` = it paid one rubble into the bag (false for the geode rock).
function HuntLedger.crushed(l: Ledger, uid: number, ordinary: boolean)
	if l.Closed then
		return
	end
	local r = row(l, uid)
	r.Processed += 1
	if ordinary then
		r.RubbleEarned += 1
	end
end

-- A hopper sale the server already applied (count and cash are what it really removed and paid).
function HuntLedger.sold(l: Ledger, uid: number, count: number, cash: number)
	if l.Closed then
		return
	end
	local c = whole(count)
	if c == 0 then
		return
	end
	local r = row(l, uid)
	r.RubbleSold += c
	r.SoldCash += whole(cash)
end

-- Freeze the hunt counters (results are being built). Later sales no longer change them.
function HuntLedger.close(l: Ledger)
	l.Closed = true
end

-- One member's figures. `bag` comes from the profile right now (count, capacity, value of the bag).
function HuntLedger.snapshot(l: Ledger, uid: number, bag: { Count: number, Capacity: number, Value: number }, specimenValue: number?): Snapshot
	local r = row(l, uid)
	return {
		Processed = r.Processed,
		RubbleEarned = r.RubbleEarned,
		RubbleSold = r.RubbleSold,
		SoldCash = r.SoldCash,
		BagCount = whole(bag.Count),
		BagCapacity = whole(bag.Capacity),
		BagValue = whole(bag.Value),
		SpecimenValue = specimenValue,
	}
end

return HuntLedger
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="143">
        <Properties>
          <string name="Name">HuntPlacement</string>
          <string name="Source"><![CDATA[--!strict
-- Where the hunt arena's scenery props stand (pure, so tests/test_hunt_placement.luau can check it offline).
-- Arena-local studs, origin = pile centre. The fence is a SQUARE (Hunt_Fence, about 85 x 85, lines at +-42.5; the east
-- side is fenced too). A prop whose footprint comes within Clear studs of a fence line steps perpendicular to that
-- line to exactly Clear studs off it (inward if it stood inside, outward if outside); cliffs are the backdrop and stay.
local ZoneThemes = require(script.Parent.ZoneThemes)

local HuntPlacement = {}

HuntPlacement.FenceHalf = 42.5 -- half-extent of the fence square when the mesh is not there to measure
HuntPlacement.Clear = 3 -- studs between a prop's footprint and the fence line
HuntPlacement.TrunkRadius = 1.5 -- trees count by their trunk, not their crown

-- { prop, x, y, z, yaw, scale }
local SCENERY: { { any } } = {
	{ "CliffTall", 67.616, 0.0, 41.425, 4.1816, 0.642 },
	{ "CliffTall", 52.681, 0.0, 57.505, 4.0485, 0.557 },
	{ "CliffTall", 29.861, 0.0, 76.477, 3.4168, 0.636 },
	{ "CliffTall", 5.934, 0.0, 78.078, 3.3459, 0.562 },
	{ "CliffTall", -14.326, 0.0, 78.357, 2.7969, 0.601 },
	{ "CliffTall", -34.069, 0.0, 68.933, 2.6795, 0.585 },
	{ "CliffTall", -52.911, 0.0, 58.875, 2.2681, 0.624 },
	{ "CliffTall", -65.229, 0.0, 41.808, 2.2521, 0.633 },
	{ "CliffTall", -80.121, 0.0, 21.575, 1.7861, 0.565 },
	{ "CliffTall", -77.098, 0.0, 3.619, 1.7711, 0.58 },
	{ "CliffTall", -79.648, 0.0, -19.571, 1.314, 0.577 },
	{ "CliffTall", -65.991, 0.0, -41.265, 0.873, 0.605 },
	{ "CliffTall", -51.622, 0.0, -53.94, 0.6715, 0.687 },
	{ "CliffTall", -30.618, 0.0, -71.14, 0.5143, 0.651 },
	{ "CliffTall", 33.607, 0.0, -74.545, -0.587, 0.606 },
	{ "CliffTall", 49.203, 0.0, -57.541, -0.7365, 0.551 },
	{ "CliffStep", 62.164, 0.0, -44.256, -1.0659, 0.551 },
	{ "Kit_Pine_A", -5.144, 0.0, 50.206, 3.3109, 0.82 },
	{ "CliffPine", 49.881, 0.0, -37.992, 4.2978, 0.79 },
	{ "PineTree", 36.478, 0.0, -40.949, 2.8062, 0.837 },
	{ "Kit_Tree_B", 56.639, 0.0, -26.694, 0.1932, 0.959 },
	{ "RoundTree", 41.749, 0.0, -48.079, 4.7352, 0.722 },
	{ "PineTree", -53.797, 0.0, 12.117, 6.2194, 0.858 },
	{ "RoundTree", -30.329, 0.0, -47.22, 1.191, 0.96 },
	{ "RoundTree", -24.622, 0.0, 45.204, 3.0948, 0.92 },
	{ "Kit_Tree_A", 21.387, 0.0, -49.586, 5.4642, 0.823 },
	{ "Kit_Tree_A", 32.808, 0.0, -41.802, 3.9873, 0.982 },
	{ "Kit_Pine_A", -61.748, 0.0, 15.341, 5.9758, 0.811 },
	{ "PineTree", -47.424, 0.0, 44.227, 4.7525, 0.71 },
	{ "Kit_Pine_A", -36.805, 0.0, 53.56, 1.7471, 0.895 },
	{ "RoundTree", 19.196, 0.0, 57.23, 1.4915, 0.89 },
	{ "RoundTree", -24.397, 0.0, 45.572, 3.0274, 0.84 },
	{ "Kit_Tree_A", 13.589, 0.0, -53.884, 3.0988, 0.995 },
	{ "PineTree", -25.192, 0.0, -54.752, 1.5908, 0.782 },
	{ "RoundTree", 15.081, 0.0, -61.62, 2.4897, 0.716 },
	{ "Kit_Pine_A", -0.812, 0.0, 55.501, 3.0357, 0.761 },
	{ "PineTree", 13.397, 0.0, -61.824, 4.2775, 0.7 },
	{ "Kit_Tree_A", -5.624, 0.0, 54.1, 5.5016, 0.926 },
	{ "CliffPine", -1.808, 0.0, 50.947, 6.1544, 0.809 },
	{ "Kit_Pine_A", -55.62, 0.0, 7.161, 2.8174, 0.814 },
	{ "Kit_Tree_A", -49.91, 0.0, 21.475, 4.1401, 0.803 },
	{ "CliffPine", 37.201, 0.0, 44.392, 6.1269, 0.725 },
	{ "CliffPine", -45.542, 0.0, 28.369, 3.3812, 0.723 },
	{ "RoundTree", -54.12, 0.0, -14.122, 3.066, 0.905 },
	{ "CliffPine", 52.002, 0.0, -28.557, 1.9568, 0.739 },
	{ "Kit_Tree_B", -49.387, 0.0, -22.821, 2.665, 0.921 },
	{ "Kit_Pine_A", 39.752, 0.0, 49.376, 1.974, 0.963 },
	{ "Kit_Pine_A", -10.416, 0.0, 60.151, 5.0496, 0.717 },
	{ "Kit_Tree_A", -27.22, 0.0, -60.348, 3.4476, 0.849 },
	{ "Kit_Pine_A", -57.015, 0.0, -3.112, 3.8196, 0.741 },
	{ "Kit_Tree_A", -52.499, 0.0, -14.933, 3.2344, 0.765 },
	{ "Kit_Tree_A", -61.49, 0.0, -14.88, 3.672, 0.959 },
	{ "Kit_Rock_A", -33.535, 0.0, 23.756, 0.7092, 0.749 },
	{ "Rock", -38.489, 0.0, -1.237, 1.9243, 0.809 },
	{ "FlowerBush", -35.222, 0.0, 21.91, 5.2293, 0.933 },
	{ "FlowerBush", 22.23, 0.0, -33.679, 3.6611, 0.875 },
	{ "Rock", 39.107, 0.0, 4.107, 5.4643, 0.937 },
	{ "Rock", -31.045, 0.0, 25.866, 2.4612, 0.807 },
	{ "FlowerBush", -37.809, 0.0, 18.816, 5.9884, 1.056 },
	{ "Rock", -23.668, 0.0, 31.572, 5.3884, 0.931 },
	{ "Mushroom", -3.647, 0.0, 40.519, 4.278, 0.4 },
	{ "Rock", 39.743, 0.0, 13.513, 3.5652, 0.819 },
	{ "Kit_Rock_A", -17.127, 0.0, 39.111, 2.2687, 0.811 },
	{ "Mushroom", 35.596, 0.0, 22.16, 0.4996, 0.5 },
	{ "FlowerBush", 32.588, 0.0, 23.071, 0.2088, 0.996 },
	{ "Kit_Bush_A", -38.21, 0.0, 0.753, 1.7276, 0.992 },
	{ "Kit_Rock_A", -38.999, 0.0, -18.536, 5.6423, 0.792 },
	{ "Kit_Rock_A", 39.889, 0.0, 7.147, 3.1435, 1.006 },
	{ "FlowerBush", -39.09, 0.0, -14.002, 4.9649, 0.829 },
	{ "Rock", -19.586, 0.0, 37.264, 0.885, 0.741 },
	{ "Kit_Rock_A", 26.398, 0.0, -31.221, 2.1845, 0.827 },
	{ "Kit_Rock_A", 33.552, 0.0, 21.827, 1.1857, 0.845 },
	{ "Kit_Rock_A", -31.314, 0.0, -23.107, 5.5503, 0.97 },
	{ "Kit_Rock_A", -39.027, 0.0, -2.037, 4.0626, 0.996 },
	{ "FlowerBush", -22.56, 0.0, 32.766, 3.7554, 1.058 },
	{ "Kit_Rock_A", 34.612, 0.0, -21.682, 4.8429, 0.978 },
	{ "FlowerBush", 95.913, -9.0, 5.444, 5.9052, 0.876 },
	{ "RoundTree", 89.763, -9.0, 44.946, 1.3087, 0.985 },
	{ "RoundTree", 81.237, -9.0, 7.728, 4.4717, 0.749 },
	{ "RoundTree", 64.155, -9.0, 28.314, 0.7706, 0.749 },
	{ "FlowerBush", 84.831, -9.0, 10.778, 0.0005, 0.769 },
	{ "Kit_Tree_A", 57.638, -9.0, -42.423, 4.2826, 0.715 },
	{ "FlowerBush", 91.139, -9.0, 37.517, 5.5358, 0.856 },
	{ "FlowerBush", 72.577, -9.0, 33.57, 3.6784, 0.823 },
	{ "Kit_Tree_A", 59.197, -9.0, 9.879, 3.1087, 0.869 },
	{ "RoundTree", 77.877, -9.0, 36.712, 3.507, 0.808 },
	-- beside the two SHELL SELL stands (apron 10 x 8 at z +-30), about 2 studs clear of it
	{ "Barrel", 9.8, 0.0, 31.76, 4.4297, 1.0 },
	{ "Crate", -9.8, 0.0, 31.32, 2.7063, 1.0 },
	{ "HayBale", 14.0, 0.0, 36.0, 5.2468, 1.0 },
	{ "Barrel", -9.8, 0.0, -31.76, 2.2708, 1.0 },
	{ "Crate", 9.8, 0.0, -31.32, 0.8822, 1.0 },
	{ "HayBale", -14.0, 0.0, -36.0, 5.2575, 1.0 },
}

local TREES: { [string]: boolean } = { PineTree = true, Kit_Pine_A = true, RoundTree = true, Kit_Tree_A = true, Kit_Tree_B = true }

-- Forest: one extra, taller tree beside every edge tree of the set, a little further out, so the edges read as a
-- dense wood. Same prop meshes; skips the open east drop and the north road.
function HuntPlacement.forestExtras(): { { any } }
	local out = {}
	local roadHalf = ZoneThemes.Layout.RoadHalfWidth
	for i, s in SCENERY do
		local x, z = s[2], s[4]
		local r = math.sqrt(x * x + z * z)
		if TREES[s[1]] and s[3] == 0 and r > 45 then
			for k, step in { { 1.12, 0.09, 1.3 }, { 0.97, -0.1, 1.15 } } do
				local a = math.atan2(z, x) + step[2]
				local nx, nz = math.cos(a) * r * step[1], math.sin(a) * r * step[1]
				local deg = math.deg(math.atan2(nz, nx))
				local onRoad = nz < 0 and math.abs(nx) < roadHalf + 5
				if math.abs(deg) > 30 and not onRoad then
					local pick = if (i + k) % 2 == 0 then "PineTree" else s[1]
					table.insert(out, { pick, nx, 0.0, nz, s[5] + 1.3 * k, s[6] * step[3] })
				end
			end
		end
	end
	return out
end

HuntPlacement.SCENERY = SCENERY
HuntPlacement.TREES = TREES

local function axis(c: number, other: number, half: number, clear: number): number
	-- the fence line on this axis only reaches as far as the square's side (plus the clearance round its end)
	if math.abs(other) > half + clear then
		return c
	end
	local a = math.abs(c)
	if math.abs(a - half) >= clear then
		return c
	end
	local want = if a < half then half - clear else half + clear
	return if c < 0 then -want else want
end

-- (x, z) stepped off the square fence of half-extent `half` until it is `clear` studs from the line (clear includes the
-- prop radius); unchanged when it already is.
function HuntPlacement.squareOff(x: number, z: number, half: number, clear: number): (number, number)
	return axis(x, z, half, clear), axis(z, x, half, clear)
end

-- Distance from (x, z) to the fence outline (inside or outside).
function HuntPlacement.fenceDistance(x: number, z: number, half: number): number
	local qx, qz = math.abs(x) - half, math.abs(z) - half
	local ox, oz = math.max(qx, 0), math.max(qz, 0)
	local outside = math.sqrt(ox * ox + oz * oz)
	if outside > 0 then
		return outside
	end
	return -math.max(qx, qz)
end

-- (x, z) pushed out past the square until it is `clear` studs outside the line (Space crystal clusters).
function HuntPlacement.pushOut(x: number, z: number, half: number, clear: number): (number, number)
	local want = half + clear
	if math.max(math.abs(x), math.abs(z)) >= want then
		return x, z
	end
	if math.abs(x) >= math.abs(z) then
		return (if x < 0 then -want else want), z
	end
	return x, (if z < 0 then -want else want)
end

-- Where a scenery row of prop `name` and footprint radius `radius` stands.
function HuntPlacement.spot(name: string, x: number, z: number, radius: number, half: number): (number, number)
	if string.sub(name, 1, 5) == "Cliff" and name ~= "CliffPine" then
		return x, z
	end
	local r = if TREES[name] or name == "CliffPine" then HuntPlacement.TrunkRadius else radius
	return HuntPlacement.squareOff(x, z, half, HuntPlacement.Clear + r)
end

-- True when a prop of `radius` at (x, z) would touch a SHELL SELL stand (apron 10 x 8 centred at z = +-30) or come
-- within 2 studs of it.
function HuntPlacement.nearHopper(x: number, z: number, radius: number): boolean
	return math.abs(x) < 5 + 2 + radius and math.abs(math.abs(z) - 30) < 4 + 2 + radius
end

-- A hunt spawn turned to face the egg pile (same spot, level gaze): every racer starts the round looking at the
-- action, whatever way a zone kit's spawn pad points (walkthrough 10-14: the hunt opened on an empty lawn).
function HuntPlacement.faceCentre(cf: CFrame, centre: Vector3): CFrame
	local pos = cf.Position
	local flat = Vector3.new(centre.X - pos.X, 0, centre.Z - pos.Z)
	if flat.Magnitude < 0.1 then
		return cf
	end
	local look = flat.Unit
	return CFrame.fromMatrix(pos, look:Cross(Vector3.yAxis), Vector3.yAxis) -- level gaze (same as CFrame.lookAt)
end

return HuntPlacement
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="144">
        <Properties>
          <string name="Name">HuntQueue</string>
          <string name="Source"><![CDATA[--!strict
-- Public hunt queue rules (pure: no Roblox services; tested in tests/test_hunt_queue.luau).
-- A lobby has a list of queues. Each queue holds groups (a party, or one player) up to Size players. The first
-- group to enter a queue starts its timer; the queue is due Seconds later (or at once when full and StartWhenFull).
-- A group always joins the earliest queue it fits in; a group that fits nowhere opens a new queue. A group never
-- splits across queues, so a party always hunts together.
-- A player who leaves a counting queue and comes back before it would have started keeps that start time (Held):
-- leaving and rejoining never restarts "HUNT IN 20S" from the top.

local HuntQueue = {}

export type Group = { Key: string, Members: { number } }
export type Queue = { Id: number, Groups: { Group }, StartsAt: number }
export type State = {
	Size: number,
	Seconds: number,
	StartWhenFull: boolean,
	Queues: { Queue },
	NextId: number,
	Held: { [number]: number }, -- userId -> StartsAt of the queue they last left (kept for a rejoin)
}

-- A rejoin into a fresh queue never starts sooner than this (the HUNT IN number must still be readable).
HuntQueue.RejoinMinSeconds = 3

function HuntQueue.new(opts: { Size: number, Seconds: number, StartWhenFull: boolean? }): State
	return {
		Size = opts.Size,
		Seconds = opts.Seconds,
		StartWhenFull = opts.StartWhenFull ~= false,
		Queues = {},
		NextId = 1,
		Held = {},
	}
end

function HuntQueue.count(queue: Queue): number
	local n = 0
	for _, g in queue.Groups do
		n += #g.Members
	end
	return n
end

function HuntQueue.members(queue: Queue): { number }
	local out = {}
	for _, g in queue.Groups do
		for _, uid in g.Members do
			table.insert(out, uid)
		end
	end
	return out
end

-- The queue and group a player is in, if any.
function HuntQueue.find(s: State, uid: number): (Queue?, Group?)
	for _, q in s.Queues do
		for _, g in q.Groups do
			if table.find(g.Members, uid) then
				return q, g
			end
		end
	end
	return nil, nil
end

function HuntQueue.findGroup(s: State, key: string): (Queue?, Group?)
	for _, q in s.Queues do
		for _, g in q.Groups do
			if g.Key == key then
				return q, g
			end
		end
	end
	return nil, nil
end

-- Adds a group. Returns the queue it joined, or nil and a reason:
--   "Empty" no members, "TooBig" more than Size, "AlreadyQueued" a member or the key is queued already.
function HuntQueue.join(s: State, key: string, members: { number }, now: number): (Queue?, string?)
	if #members == 0 then
		return nil, "Empty"
	end
	if #members > s.Size then
		return nil, "TooBig"
	end
	if (HuntQueue.findGroup(s, key)) then
		return nil, "AlreadyQueued"
	end
	for _, uid in members do
		if (HuntQueue.find(s, uid)) then
			return nil, "AlreadyQueued"
		end
	end
	local group: Group = { Key = key, Members = table.clone(members) }
	for _, q in s.Queues do
		if HuntQueue.count(q) + #members <= s.Size then
			for _, uid in members do
				s.Held[uid] = nil
			end
			table.insert(q.Groups, group)
			return q, nil
		end
	end
	-- a new queue: a member who left a still-counting queue keeps that queue's start time
	local startsAt = now + s.Seconds
	for _, uid in members do
		local held = s.Held[uid]
		if held and held > now then
			startsAt = math.min(startsAt, math.max(held, now + HuntQueue.RejoinMinSeconds))
		end
	end
	for _, uid in members do
		s.Held[uid] = nil
	end
	local q: Queue = { Id = s.NextId, Groups = { group }, StartsAt = startsAt }
	s.NextId += 1
	table.insert(s.Queues, q)
	return q, nil
end

local function prune(s: State)
	for i = #s.Queues, 1, -1 do
		local q = s.Queues[i]
		for j = #q.Groups, 1, -1 do
			if #q.Groups[j].Members == 0 then
				table.remove(q.Groups, j)
			end
		end
		if #q.Groups == 0 then
			table.remove(s.Queues, i)
		end
	end
end

-- One player leaves (their group stays queued without them). Returns the queue they left.
-- A queue left empty is dropped: its timer is gone, the next joiner starts a fresh one.
function HuntQueue.leave(s: State, uid: number): Queue?
	local q, g = HuntQueue.find(s, uid)
	if not q or not g then
		return nil
	end
	local i = table.find(g.Members, uid)
	if i then
		table.remove(g.Members, i)
	end
	s.Held[uid] = q.StartsAt
	prune(s)
	return q
end

-- A whole group leaves (the party leader cancelled, the party changed). Returns the members that were queued.
function HuntQueue.leaveGroup(s: State, key: string): { number }
	local q, g = HuntQueue.findGroup(s, key)
	if not q or not g then
		return {}
	end
	local out = table.clone(g.Members)
	for _, uid in out do
		s.Held[uid] = q.StartsAt
	end
	table.clear(g.Members)
	prune(s)
	return out
end

-- Drops a player's kept start time (they left the server, or their hunt started).
function HuntQueue.forget(s: State, uid: number)
	s.Held[uid] = nil
end

function HuntQueue.isDue(s: State, q: Queue, now: number): boolean
	return now >= q.StartsAt or (s.StartWhenFull and HuntQueue.count(q) >= s.Size)
end

-- Removes and returns every queue whose hunt should start now (oldest first).
function HuntQueue.popDue(s: State, now: number): { Queue }
	local out = {}
	for i = 1, #s.Queues do
		local q = s.Queues[i]
		if HuntQueue.isDue(s, q, now) then
			table.insert(out, q)
		end
	end
	for _, q in out do
		local i = table.find(s.Queues, q)
		if i then
			table.remove(s.Queues, i)
		end
	end
	-- a queue that started frees every kept start time that pointed at it or earlier (they have all run out)
	for uid, at in s.Held do
		if at <= now then
			s.Held[uid] = nil
		end
	end
	return out
end

-- Puts a queue whose start failed back at the front, due again at `startsAt`. Members who joined another queue in
-- the meantime are not duplicated.
function HuntQueue.restore(s: State, q: Queue, startsAt: number)
	for _, g in q.Groups do
		for i = #g.Members, 1, -1 do
			if (HuntQueue.find(s, g.Members[i])) then
				table.remove(g.Members, i)
			end
		end
	end
	q.StartsAt = startsAt
	table.insert(s.Queues, 1, q)
	prune(s)
end

-- What a player sees: their queue's count and start time, or the next open queue's (to show "2/4 waiting").
function HuntQueue.view(s: State, q: Queue?, now: number): { Count: number, Max: number, StartsAt: number, Remaining: number }?
	if not q then
		return nil
	end
	return {
		Count = HuntQueue.count(q),
		Max = s.Size,
		StartsAt = q.StartsAt,
		Remaining = math.max(0, math.ceil(q.StartsAt - now)),
	}
end

-- The queue a new single joiner would land in (nil when every queue is full or there is none).
function HuntQueue.openQueue(s: State): Queue?
	for _, q in s.Queues do
		if HuntQueue.count(q) < s.Size then
			return q
		end
	end
	return nil
end

-- The highest zone every member has unlocked (order: lowest first). Falls back to the first zone.
function HuntQueue.commonTier(order: { string }, unlocked: { { [string]: boolean } }): string
	local best = order[1]
	for _, tier in order do
		local all = true
		for _, set in unlocked do
			if not set[tier] then
				all = false
				break
			end
		end
		if all then
			best = tier
		end
	end
	return best
end

-- Whether a non-finder may roll for a bonus common pet.
function HuntQueue.bonusEligible(cracked: number, isFinder: boolean, practice: boolean, minCracked: number): boolean
	return not isFinder and not practice and cracked >= minCracked
end

return HuntQueue
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="145">
        <Properties>
          <string name="Name">HuntZoneKit</string>
          <string name="Source"><![CDATA[--!strict
-- Per-zone hunt piece sets ("5 worlds, not 5 paint jobs", /mnt/project-files/hunt_zones_v1.md). Pure, so
-- tests/test_hunt_zone_kit.luau checks it offline; server/HuntLowPoly does the cloning.
--
-- Contract for the Studio import: one folder per zone, ServerStorage.HuntZoneKit_<Zone> (Meadow, Forest, Snow,
-- Volcano, Space). Each piece is a MeshPart or a Model, named by its role, optionally with the zone and a Blender
-- number after it ("Hero", "Hero_Volcano", "Hero_Volcano.001" all count as Hero):
--   Ground                 220 x 220 ground tile under the whole arena (replaces the tinted Hunt_Ground; walkable)
--   PathEdge               trim along ONE side of the north road (about 70 long on Z); used on both sides
--   Skyline_A/_B/_C        big skyline silhouettes (about 120 wide), six spots around the arena
--   SkylineFill_1/_2/_3    edge fillers between the skyline spots (five spots), so the gap scan stays at 0
--   Hero                   the zone's hero landmark (30-40 tall) at the end of the north road
--   PetStatue              the zone's best pet as a 12-tall statue beside the hero
--   ZoneGate               the arch over the north gate
--   Scatter_<anything>     up to 6 scatter props; they stand in for the meadow trees, bushes, boulders, mushrooms
--                          (2.5x bigger outside the fence) and form a cluster behind every nest
--   LaneMarker             optional rocket / crystal / torch lining the north path (a glowing pillar without it)
-- Every piece is optional: a missing role keeps the tinted meadow piece it would replace, and a zone with no
-- folder (or an empty one) builds exactly as before. Kit pieces are visual only (no collision) except Ground.
-- Optional attributes on a piece, for tuning in Studio without code changes:
--   Offset (Vector3, studs, in the spot's own frame), Yaw (number, degrees added), Scale (number, size factor;
--   ignored on Scatter pieces, which are fitted to the footprint of the meadow prop they replace).
-- A piece's front (-Z, Roblox LookVector) faces the arena centre; if it imports facing away, set Yaw = 180.
local ZoneThemes = require(script.Parent.ZoneThemes)

local HuntZoneKit = {}

HuntZoneKit.FolderPrefix = "HuntZoneKit_"
HuntZoneKit.Zones = { "Meadow", "Forest", "Snow", "Volcano", "Space" }
-- zone of each hunt tier (Config.TierOrder ids)
HuntZoneKit.ZoneOfTier = { Gravel = "Meadow", Quarry = "Forest", Cavern = "Snow", Volcanic = "Volcano", Meteor = "Space" } :: { [string]: string }

HuntZoneKit.SkylineR = 140 -- skyline ring radius (plan: 60-160)
HuntZoneKit.FillR = 100
HuntZoneKit.HeroZ = -132 -- past the end of the north road (the road strip runs z -45..-115)
HuntZoneKit.StatueAt = Vector2.new(24, -118)
HuntZoneKit.MaxR = 160
HuntZoneKit.SkylineWidth = 120 -- assumed skyline / filler widths when a piece cannot be measured
HuntZoneKit.FillWidth = 60
HuntZoneKit.Overlap = 0.25 -- neighbouring skyline pieces overlap by this share of their width (closes the gap scan)
HuntZoneKit.FillSkipDeg = 18 -- no filler within this bearing of north: the road and the hero stay in view
HuntZoneKit.BigScatter = 2.5 -- scatter outside the fence is this much bigger than the prop it replaces
HuntZoneKit.FenceClear = 3 -- studs between any decoration footprint and the fence line (HuntPlacement.Clear)
HuntZoneKit.ClusterSize = 7 -- footprint (studs) of a nest-cluster prop before BigScatter
HuntZoneKit.LaneHalf = 5 -- the clear central path: half width, from the north gate to the mound
HuntZoneKit.MoundR = 14
HuntZoneKit.RoadEndZ = -115

-- Per-zone accents for the procedural extras (path, lane markers, focal pads and beacons, the backstop hills).
export type Style = { Path: Color3, Accent: Color3, Pad: Color3, Hill: { Color3 } }
HuntZoneKit.Style = {
	Meadow = { Path = Color3.fromRGB(214, 178, 120), Accent = Color3.fromRGB(255, 214, 64), Pad = Color3.fromRGB(255, 240, 200), Hill = { Color3.fromRGB(112, 172, 88), Color3.fromRGB(96, 154, 76) } },
	Forest = { Path = Color3.fromRGB(150, 108, 72), Accent = Color3.fromRGB(255, 226, 110), Pad = Color3.fromRGB(236, 214, 160), Hill = { Color3.fromRGB(52, 108, 50), Color3.fromRGB(70, 128, 58) } },
	Snow = { Path = Color3.fromRGB(150, 200, 236), Accent = Color3.fromRGB(110, 220, 255), Pad = Color3.fromRGB(60, 120, 200), Hill = { Color3.fromRGB(236, 242, 250), Color3.fromRGB(206, 222, 242) } },
	Volcano = { Path = Color3.fromRGB(46, 36, 36), Accent = Color3.fromRGB(255, 110, 30), Pad = Color3.fromRGB(255, 170, 60), Hill = { Color3.fromRGB(70, 54, 52), Color3.fromRGB(96, 72, 64) } },
	Space = { Path = Color3.fromRGB(80, 60, 140), Accent = Color3.fromRGB(90, 255, 230), Pad = Color3.fromRGB(255, 120, 230), Hill = { Color3.fromRGB(150, 124, 204), Color3.fromRGB(120, 96, 180) } },
} :: { [string]: Style }

export type Slot = { X: number, Z: number, Yaw: number, Variant: string? }
export type Plan = { [string]: { string } } -- role -> canonical keys present ("Skyline" -> { "Skyline_A", ... })

function HuntZoneKit.folderName(zone: string): string
	return HuntZoneKit.FolderPrefix .. zone
end

-- Canonical role and key of an instance name in zone `zone`'s kit, or nil when it is not a kit piece.
function HuntZoneKit.roleOf(name: string, zone: string): (string?, string?)
	local n = string.gsub(name, "%.%d+$", "")
	local suffix = "_" .. zone
	if #n > #suffix and string.sub(n, -#suffix) == suffix then
		n = string.sub(n, 1, #n - #suffix)
	end
	if n == "Ground" or n == "PathEdge" or n == "Hero" or n == "PetStatue" or n == "ZoneGate" or n == "LaneMarker" then
		return n, n
	end
	if string.match(n, "^Skyline_[ABC]$") then
		return "Skyline", n
	end
	if string.match(n, "^SkylineFill_[123]$") then
		return "SkylineFill", n
	end
	if string.match(n, "^Scatter_[%w_]+$") then
		return "Scatter", n
	end
	return nil, nil
end

-- Which roles a folder holding `names` provides (keys sorted, first copy of a key wins).
function HuntZoneKit.plan(names: { string }, zone: string): Plan
	local out: Plan = {}
	local seen: { [string]: boolean } = {}
	for _, name in names do
		local role, key = HuntZoneKit.roleOf(name, zone)
		if role and key and not seen[key] then
			seen[key] = true
			out[role] = out[role] or {}
			table.insert(out[role], key)
		end
	end
	for _, keys in out do
		table.sort(keys)
	end
	return out
end

-- yaw (radians) that turns a piece's front (-Z) toward the arena centre from (x, z)
local function facing(x: number, z: number): number
	return math.atan2(x, z)
end

local function ring(r: number, degs: { number }): { Slot }
	local out: { Slot } = {}
	for _, d in degs do
		-- bearing from north (-Z), clockwise toward east (+X)
		local a = math.rad(d)
		local x, z = math.sin(a) * r, -math.cos(a) * r
		table.insert(out, { X = x, Z = z, Yaw = facing(x, z) })
	end
	return out
end

-- Degrees of bearing a piece `width` wide covers seen from the centre at radius r.
function HuntZoneKit.spanDeg(width: number, r: number): number
	return math.deg(2 * math.atan((width / 2) / r))
end

-- Evenly spaced bearings that cover the whole circle (minus a window of `skip` degrees either side of north) with
-- pieces `width` wide at radius r, neighbours overlapping by Overlap: the gap scan closes by construction for any
-- piece width, instead of relying on six hand-picked spots.
function HuntZoneKit.coverRing(r: number, width: number, skip: number?): { number }
	local span = HuntZoneKit.spanDeg(math.max(width, 1), r) * (1 - HuntZoneKit.Overlap)
	local lo = skip or 0
	local arc = 360 - 2 * lo
	local n = math.clamp(math.ceil(arc / span), 3, 48)
	local out = {}
	if lo == 0 then
		for k = 0, n - 1 do
			table.insert(out, k * 360 / n)
		end
	else
		-- the first and last piece sit half a span inside the window's edges, so the arc between is covered
		local half = math.min(span / 2, arc / 2)
		local from, to = lo + half, 360 - lo - half
		local step = if n > 1 then (to - from) / (n - 1) else 0
		for k = 0, n - 1 do
			table.insert(out, from + k * step)
		end
	end
	return out
end

-- Arena-local spots (origin = pile centre on the floor, -Z north) for every copy of role `role`.
-- `variants` (sorted keys present, e.g. Skyline_A, Skyline_C) are dealt round the spots in turn; `width` is the
-- narrowest measured piece of a ring role (Skyline, SkylineFill), so the ring has no gaps.
function HuntZoneKit.slots(role: string, fenceHalf: number, variants: { string }?, width: number?): { Slot }
	local out: { Slot }
	if role == "Ground" then
		out = { { X = 0, Z = 0, Yaw = 0 } }
	elseif role == "ZoneGate" then
		out = { { X = 0, Z = -(fenceHalf + 1.5), Yaw = 0 } }
	elseif role == "PathEdge" then
		-- along the road strip's two sides, beyond the road's keep-clear half width; the east copy turned round
		local x = ZoneThemes.Layout.RoadHalfWidth + 1
		out = { { X = -x, Z = -80, Yaw = 0 }, { X = x, Z = -80, Yaw = math.pi } }
	elseif role == "Hero" then
		out = { { X = 0, Z = HuntZoneKit.HeroZ, Yaw = 0 } }
	elseif role == "PetStatue" then
		local p = HuntZoneKit.StatueAt
		out = { { X = p.X, Z = p.Y, Yaw = facing(p.X, p.Y) } }
	elseif role == "Skyline" then
		out = ring(HuntZoneKit.SkylineR, HuntZoneKit.coverRing(HuntZoneKit.SkylineR, width or HuntZoneKit.SkylineWidth))
	elseif role == "SkylineFill" then
		-- not near north: the road and the hero stay in view
		out = ring(HuntZoneKit.FillR, HuntZoneKit.coverRing(HuntZoneKit.FillR, width or HuntZoneKit.FillWidth, HuntZoneKit.FillSkipDeg))
	elseif role == "LaneMarker" then
		out = HuntZoneKit.laneMarkers(fenceHalf)
	else
		out = {}
	end
	if variants and #variants > 0 then
		for i, s in out do
			s.Variant = variants[(i - 1) % #variants + 1]
		end
	end
	return out
end

-- Lane markers: pairs along the north road from just past the gate to the road's end, plus one pair either side
-- of the gate, all facing the road.
function HuntZoneKit.laneMarkers(fenceHalf: number): { Slot }
	local out: { Slot } = {}
	local x = ZoneThemes.Layout.RoadHalfWidth + 4 -- outside the road and its PathEdge trim
	local z = -(fenceHalf + 6)
	while z >= HuntZoneKit.RoadEndZ do
		table.insert(out, { X = -x, Z = z, Yaw = -math.pi / 2 })
		table.insert(out, { X = x, Z = z, Yaw = math.pi / 2 })
		z -= 12
	end
	return out
end

-- The clear central path (arena-local box): from the hero's pad down the road, through the north gate, to the
-- mound's edge. Nothing decorative stands in it.
function HuntZoneKit.lane(fenceHalf: number): (number, number, number)
	return HuntZoneKit.LaneHalf, HuntZoneKit.HeroZ + 14, -HuntZoneKit.MoundR
end

-- True when a footprint of radius r at (x, z) reaches into the clear central path.
function HuntZoneKit.inLane(x: number, z: number, r: number, fenceHalf: number): boolean
	local half, zFar, zNear = HuntZoneKit.lane(fenceHalf)
	return math.abs(x) < half + r and z < zNear + r and z > zFar - r
end

-- Scatter clusters behind every nest: a fan of props just outside the fence on the nest's bearing (`angles` are
-- the nests' math angles, x = cos, z = sin), so each nest is framed by the zone. Skips the road and the east drop.
export type ClusterSpot = { X: number, Z: number, Yaw: number, Size: number }
function HuntZoneKit.clusterSpots(fenceHalf: number, angles: { number }): { ClusterSpot }
	local out: { ClusterSpot } = {}
	-- { bearing offset (rad), extra studs out, size factor }
	local fan = { { 0, 2, 1.3 }, { -0.16, 0, 1.0 }, { 0.16, 0, 1.0 }, { -0.3, 6, 0.9 }, { 0.3, 6, 0.9 }, { -0.08, 13, 1.15 }, { 0.08, 13, 1.15 } }
	for i, a in angles do
		-- nests on the east side swing their fan toward the north / south fence, away from the open east drop
		local swing = if math.sin(a) >= 0 then 1 else -1
		for k, f in fan do
			local size = HuntZoneKit.ClusterSize * f[3]
			local R = size * HuntZoneKit.BigScatter / 2
			for shift = 0, 8 do
				local b = a + f[1] + swing * shift * 0.1
				local dx, dz = math.cos(b), math.sin(b)
				-- far enough out on that bearing that the whole footprint clears the fence square by FenceClear
				local r = (fenceHalf + HuntZoneKit.FenceClear + R + f[2]) / math.max(math.abs(dx), math.abs(dz))
				local x, z = dx * r, dz * r
				local onRoad = z - R < -fenceHalf and math.abs(x) < ZoneThemes.Layout.RoadHalfWidth + 4 + R
				if x + R <= ZoneThemes.Layout.DropX and math.sqrt(x * x + z * z) + R < HuntZoneKit.SkylineR - 20 then
					if not onRoad then
						table.insert(out, { X = x, Z = z, Yaw = (i * 7 + k * 3) % 13 * 0.48, Size = size })
					end
					break
				end
			end
		end
	end
	return out
end

-- True when (x, z) is past the fence square (scatter there may grow BigScatter times).
function HuntZoneKit.outside(x: number, z: number, r: number, fenceHalf: number): boolean
	return math.max(math.abs(x), math.abs(z)) - r > fenceHalf
end

-- Meadow scenery props the Scatter pieces stand in for (trees, bushes, boulders, mushrooms; the barrels, crates
-- and hay bales by the sell stands and the cliffs stay as they are).
HuntZoneKit.Scatterable = {
	PineTree = true, Kit_Pine_A = true, RoundTree = true, Kit_Tree_A = true, Kit_Tree_B = true, CliffPine = true,
	FlowerBush = true, Kit_Bush_A = true, Rock = true, Kit_Rock_A = true, Mushroom = true,
} :: { [string]: boolean }

-- Which scatter key stands in for scenery row `index` (prop `prop`): deterministic, mixes the props per spot.
function HuntZoneKit.scatterFor(prop: string, index: number, keys: { string }): string?
	if not HuntZoneKit.Scatterable[prop] or #keys == 0 then
		return nil
	end
	return keys[(index - 1) % #keys + 1]
end

-- Uniform factor that fits a scatter piece of footprint `have` (max X/Z, studs) into the footprint `want` of the
-- meadow prop it replaces, so the placement checks (fence clearance, keep-outs, sell stands) still hold.
function HuntZoneKit.fitScale(have: number, want: number): number
	if have <= 0 or want <= 0 then
		return 1
	end
	return want / have
end

return HuntZoneKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="146">
        <Properties>
          <string name="Name">IntroRules</string>
          <string name="Source"><![CDATA[--!strict
-- Countdown number rules for client/RoundIntro (pure, tested in tests/test_hunt_fun.luau).
-- Studio 2026-10-15: a big "1" stayed on screen for a whole hunt. Round numbers restart at 1 in every new match, so
-- "GO already shown for round 1" from the last hunt blocked this hunt's GO. Rounds are keyed by match key + round.

local IntroRules = {}

-- One id per round of one match (the match key alone repeats nothing, the round alone repeats every match).
function IntroRules.roundKey(matchKey: any, round: any): string
	return tostring(matchKey) .. ":" .. tostring(round)
end

local DIGITS = { ["1"] = true, ["2"] = true, ["3"] = true }

-- What the centre number becomes once the hunt is Searching: "GO!" the first time this round, "" for any countdown
-- digit still showing after that, nil = leave it as it is.
function IntroRules.onSearching(shown: string, goKey: string?, key: string): string?
	if not DIGITS[shown] then
		return nil
	end
	return if goKey ~= key then "GO!" else ""
end

return IntroRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="147">
        <Properties>
          <string name="Name">IslandRules</string>
          <string name="Source"><![CDATA[--!strict
-- Where Pet Battle islands float and how a fight sits on one (pure; tested in tests/test_island.luau).
-- server/SkyIsland places a copy of the island per fight at spot(slot) and reads its fight floor (the part marked
-- ArenaCenter) through origin().

local PvpConfig = require(script.Parent.PvpConfig)

local IslandRules = {}

-- The island for fight slot `slot` (1, 2, ...): a row far from everything else, Spacing studs apart.
function IslandRules.spot(slot: number): Vector3
	local c = PvpConfig.Island
	return c.Base + Vector3.new(0, 0, (math.max(slot, 1) - 1) * c.Spacing)
end

-- The fight origin on a floor part (its CFrame and Size) and the layout that fits a floor of `radius` studs. The two
-- teams face each other along the part's X axis; TowerView draws side 1's pets along the origin's -Z.
function IslandRules.origin(floor: CFrame, size: Vector3, radius: number?): (CFrame, string)
	local pos = floor.Position + Vector3.new(0, size.Y / 2, 0)
	local look = floor.RightVector
	look = Vector3.new(look.X, 0, look.Z)
	look = if look.Magnitude > 0.1 then look.Unit else Vector3.xAxis
	local r = radius or math.min(size.X, size.Z) / 2
	local layout = if r >= PvpConfig.BigArena then "LiveBig" else "Live"
	return CFrame.lookAt(pos, pos - look), layout
end

-- True when a point is still on the island (for the fall catcher): within the floor radius plus a margin, and not
-- far below the floor.
function IslandRules.onIsland(origin: CFrame, radius: number, at: Vector3): boolean
	local d = at - origin.Position
	return Vector3.new(d.X, 0, d.Z).Magnitude <= radius + 8 and d.Y > -25
end

return IslandRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="148">
        <Properties>
          <string name="Name">KitModels</string>
          <string name="Source"><![CDATA[--!strict
-- Access to the Blender kit models that the server MeshService builds into
-- ReplicatedStorage.Assets.Kit.<Name> (docs/MODELING.md). Every caller keeps its Part stand-in as the
-- fallback: when a template is missing (not uploaded, not loaded yet, Studio without asset access, the
-- offline preview without FBX files) `template` and `clone` return nil and the stand-in is built.
--
-- A template is a Model with an invisible anchored `Root` part at the origin (PrimaryPart, floor centre
-- unless the catalog says otherwise), Attachments on Root for the named points, and one coloured MeshPart
-- per piece, all laid out around the origin. Clones are in "model space" (the origin at CFrame.new()):
-- parent them after PivotTo, or use `place`.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KitModels = {}

-- The ready template Model for a kit name, or nil.
function KitModels.template(name: string): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local kit = assets and assets:FindFirstChild("Kit")
	local m = kit and kit:FindFirstChild(name)
	if m and m:IsA("Model") and m:GetAttribute("Ready") then
		return m
	end
	return nil
end

-- A scaled clone in model space (nil when the template is absent). Sizes, offsets and attachment
-- points are multiplied by `scale`; rotations are kept. Parts stay anchored and non-colliding.
function KitModels.clone(name: string, scale: number?): Model?
	local t = KitModels.template(name)
	if not t then
		return nil
	end
	local m = t:Clone()
	local s = scale or 1
	if math.abs(s - 1) > 1e-4 then
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d.Size = d.Size * s
				d.CFrame = CFrame.new(d.Position * s) * d.CFrame.Rotation
			elseif d:IsA("Attachment") then
				d.Position = d.Position * s
			end
		end
	end
	return m
end

-- Position of a named attachment (on Root, model space) in a clone, or nil.
function KitModels.attach(m: Model, point: string): Vector3?
	local root = m:FindFirstChild("Root")
	local a = root and root:FindFirstChild(point)
	if a and a:IsA("Attachment") then
		return a.Position
	end
	return nil
end

-- Min / max corners of every visible piece of a model (model space), ignoring `Root`.
function KitModels.extents(m: Instance): (Vector3, Vector3)
	local lo = Vector3.new(math.huge, math.huge, math.huge)
	local hi = Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" then
			local h = d.Size / 2
			local c = d.Position
			lo = Vector3.new(math.min(lo.X, c.X - h.X), math.min(lo.Y, c.Y - h.Y), math.min(lo.Z, c.Z - h.Z))
			hi = Vector3.new(math.max(hi.X, c.X + h.X), math.max(hi.Y, c.Y + h.Y), math.max(hi.Z, c.Z + h.Z))
		end
	end
	return lo, hi
end

-- Moves the parts of a model-space clone to `cf` (a floor-centre frame) without needing a PrimaryPart.
function KitModels.place(m: Model, cf: CFrame)
	m:PivotTo(cf)
end

-- Stable small number from a string (seeded tint / scale per rock name).
function KitModels.hash(s: string): number
	local h = 17
	for i = 1, #s do
		h = (h * 31 + string.byte(s, i)) % 1000003
	end
	return h
end

return KitModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="149">
        <Properties>
          <string name="Name">LaunchPerks</string>
          <string name="Source"><![CDATA[--!strict
-- Launch picks (owner list 2026-10-15: ideas 2, 3, 9, 41-46), pure rules: no Roblox services, tested in
-- tests/test_launch_perks.luau. The server (RetentionService, QuestService, RobuxService) owns the state and pays every
-- reward; clients only see LaunchPerks.view and send intents.
--
--   Day 7 egg     the daily login gift's 7th streak day also banks a free Rare Egg (EggPerks bank, hatched for free).
--   Spin wheel    one free spin every 4 hours: coins (sized to the player's best zone), free luck potion minutes or a
--                 free egg. Free only; Robux never buys a spin.
--   Shiny         1 in 100 pets hatch SHINY (any egg, race or shop): a sparkle shimmer, "Shiny" in the name and 2x sell
--                 value. Decided from the pet's own Seed, so it never changes any other roll.
--   Lucky hour    2x luck for everyone at fixed UTC hours every day (RobuxConfig.Events.LuckyHours).
-- Nothing here changes which hunt egg hides the pet or who finds it.

local RobuxConfig = require(script.Parent.RobuxConfig)

local LaunchPerks = {}

LaunchPerks.StreakEgg = { Day = 7, Egg = "RareEgg" }

LaunchPerks.Shiny = {
	OneIn = 100,
	ValueMult = 2,
	Salt = 7919, -- mixes the pet's Seed so shiny is independent of its look rolls
}

-- Spin wheel slices (the wheel draws them in this order). Coins = Rounds x an average solo round in the player's best
-- zone (RobuxConfig.roundCoins), so a spin stays worth it from Meadow to Space. Weights sum to 100.
export type Slice = { Id: string, Kind: string, Weight: number, Rounds: number?, Minutes: number?, Egg: string? }
LaunchPerks.Spin = {
	Cooldown = 4 * 3600,
	Slices = {
		{ Id = "CoinsS", Kind = "Coins", Rounds = 0.25, Weight = 30 },
		{ Id = "Potion5", Kind = "Potion", Minutes = 5, Weight = 16 },
		{ Id = "CoinsM", Kind = "Coins", Rounds = 0.5, Weight = 20 },
		{ Id = "Basic", Kind = "Egg", Egg = "BasicEgg", Weight = 14 },
		{ Id = "CoinsL", Kind = "Coins", Rounds = 1, Weight = 10 },
		{ Id = "Potion15", Kind = "Potion", Minutes = 15, Weight = 6 },
		{ Id = "Rare", Kind = "Egg", Egg = "RareEgg", Weight = 3.5 },
		{ Id = "Mythic", Kind = "Egg", Egg = "MythicEgg", Weight = 0.5 },
	} :: { Slice },
}

export type State = { SpinAt: number, Spins: number, AutoEgg: string? }

function LaunchPerks.empty(): State
	return { SpinAt = 0, Spins = 0 }
end

local function whole(v: any, lo: number): number
	local n = tonumber(v)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return lo
	end
	return math.max(lo, math.floor(n))
end

function LaunchPerks.sanitize(s: any): State
	if type(s) ~= "table" then
		return LaunchPerks.empty()
	end
	s.SpinAt = whole(s.SpinAt, 0)
	s.Spins = whole(s.Spins, 0)
	if s.AutoEgg ~= nil and type(s.AutoEgg) ~= "string" then
		s.AutoEgg = nil
	end
	return s :: State
end

-- Day 7 egg ------------------------------------------------------------------------------------------------------------

-- The free egg a daily gift on streak day `streakDay` (1..7) banks, or nil.
function LaunchPerks.streakEgg(streakDay: number): string?
	return if streakDay == LaunchPerks.StreakEgg.Day then LaunchPerks.StreakEgg.Egg else nil
end

-- Shiny ----------------------------------------------------------------------------------------------------------------

-- Shiny from a pet's Seed (1 in oneIn; default Shiny.OneIn). Same seed, same answer, on every server.
function LaunchPerks.shinyFromSeed(seed: any, oneIn: number?): boolean
	local n = math.max(1, math.floor(oneIn or LaunchPerks.Shiny.OneIn))
	local s = tonumber(seed)
	if not s or s ~= s then
		return false
	end
	-- one Park-Miller step (exact in doubles: seed < 2^31) so neighbouring seeds don't line up
	local h = ((math.floor(math.abs(s)) % 2147483647) * 48271 + LaunchPerks.Shiny.Salt) % 2147483647
	return h % n == 0
end

function LaunchPerks.shinyMult(shiny: any): number
	return if shiny == true then LaunchPerks.Shiny.ValueMult else 1
end

-- Spin wheel -----------------------------------------------------------------------------------------------------------

-- The prize line once the wheel lands ("YOU WON +500 COINS!"), or nil when there is no prize to show yet: the panel
-- hides the prize pill then (Studio 2026-10-15: an empty green bar sat there before the first spin).
function LaunchPerks.spinWon(text: string?): string?
	if type(text) ~= "string" or string.match(text, "%S") == nil then
		return nil
	end
	return "YOU WON " .. string.upper(text) .. "!"
end

function LaunchPerks.spinLeft(s: State, now: number): number
	return math.max(0, s.SpinAt + LaunchPerks.Spin.Cooldown - now)
end

function LaunchPerks.slice(id: any): Slice?
	for _, sl in LaunchPerks.Spin.Slices do
		if sl.Id == id then
			return sl
		end
	end
	return nil
end

-- x rounded to two significant digits.
local function nice(x: number): number
	if x <= 0 then
		return 0
	end
	local step = 10 ^ math.max(0, math.floor(math.log10(x)) - 1)
	return math.floor(x / step + 0.5) * step
end

function LaunchPerks.sliceCoins(sl: Slice, tierId: string): number
	if sl.Kind ~= "Coins" then
		return 0
	end
	return math.max(10, nice((sl.Rounds or 0) * RobuxConfig.roundCoins(tierId)))
end

-- Short text for a slice ("+500 coins", "5 min 2x luck", "Rare Egg").
function LaunchPerks.sliceText(sl: Slice, tierId: string): string
	if sl.Kind == "Coins" then
		return "+" .. LaunchPerks.sliceCoins(sl, tierId) .. " coins"
	elseif sl.Kind == "Potion" then
		return (sl.Minutes or 0) .. " min 2x luck"
	end
	local e = RobuxConfig.egg(sl.Egg)
	return if e then e.Name else "Egg"
end

-- Spins the wheel if the cooldown is over: (slice, nil) and the clock restarts, or (nil, "NotYet").
-- `r` is a number in [0, 1) from the server's random (the client never picks).
function LaunchPerks.spin(s: State, now: number, r: number): (Slice?, string?)
	if LaunchPerks.spinLeft(s, now) > 0 then
		return nil, "NotYet"
	end
	local total = 0
	for _, sl in LaunchPerks.Spin.Slices do
		total += sl.Weight
	end
	local roll = math.clamp(r, 0, 0.999999) * total
	local pick = LaunchPerks.Spin.Slices[#LaunchPerks.Spin.Slices]
	for _, sl in LaunchPerks.Spin.Slices do
		roll -= sl.Weight
		if roll < 0 then
			pick = sl
			break
		end
	end
	s.SpinAt = now
	s.Spins += 1
	return pick, nil
end

-- Lucky hour -----------------------------------------------------------------------------------------------------------

-- Unix time the lucky hour running at `now` ends, or 0 when none is on.
function LaunchPerks.luckyHourUntil(now: number): number
	local ev = RobuxConfig.Events
	local dayStart = now - now % 86400
	for _, h in ev.LuckyHours do
		local from = dayStart + h * 3600
		local to = from + ev.LuckyHourMinutes * 60
		if now >= from and now < to then
			return to
		end
	end
	return 0
end

-- Seconds until the next lucky hour starts (0 = one is on now).
function LaunchPerks.nextLuckyHour(now: number): number
	if LaunchPerks.luckyHourUntil(now) > 0 then
		return 0
	end
	local dayStart = now - now % 86400
	local best = math.huge
	for _, h in RobuxConfig.Events.LuckyHours do
		for d = 0, 1 do
			local from = dayStart + d * 86400 + h * 3600
			if from > now then
				best = math.min(best, from - now)
			end
		end
	end
	return if best == math.huge then 0 else best
end

-- Limited eggs ---------------------------------------------------------------------------------------------------------

-- The limited egg on sale at `now` (the first one), with its seconds left; nil when none is on sale.
function LaunchPerks.limitedEgg(now: number): (RobuxConfig.Egg?, number)
	for _, e in RobuxConfig.LimitedEggs do
		if RobuxConfig.eggOnSale(e, now) then
			return e, (e.EndsAt :: number) - now
		end
	end
	return nil, 0
end

-- Client view ----------------------------------------------------------------------------------------------------------

function LaunchPerks.view(s: State, robux: any, now: number): { [string]: any }
	local egg, left = LaunchPerks.limitedEgg(now)
	return {
		SpinIn = LaunchPerks.spinLeft(s, now),
		Spins = s.Spins,
		AutoEgg = s.AutoEgg,
		StarterPack = type(robux) == "table" and robux.StarterPack == true,
		Limited = if egg then { Id = egg.Id, Name = egg.Name, EndsIn = left, ShinyOneIn = egg.ShinyOneIn } else nil,
		LuckyHourIn = LaunchPerks.nextLuckyHour(now),
	}
end

return LaunchPerks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="150">
        <Properties>
          <string name="Name">LobbyHudArt</string>
          <string name="Source"><![CDATA[--!strict
-- carter's illustrated lobby buttons (ChatGPT, 2026-10-15). The PNGs are in art/ui/lobby_v2/ (cropped to the
-- button, max 1024 px). Each has its label, icon, rim and shadow painted in, so the client shows the picture whole
-- (no live text on top) and moves the whole button. Uploaded by the Studio helper 2026-10-15 (art/artmap.json maps
-- the same ids for the offline preview); id 0 = the drawn stand-in button (client/ui/LobbyHudV2).
-- Aspect = picture width / height (the layout fits each button to its picture).
-- LowPoly: carter's low-poly set (2026-10-15, art/ui/lobby_v2_lowpoly/, cropped to the visible button). A button
-- switches to it as soon as its Id is set (uploaded); until then it keeps the first set. Preview scene lobbyhud2
-- --set lowpoly=1 shows them early with preview-only ids (art/artmap.json 1015000001..8, never used in the game).

local LobbyHudArt = {}

export type Art = { Id: number, File: string, Aspect: number }

LobbyHudArt.Buttons = {
	Play = { Id = 96942072120823, File = "play.png", Aspect = 1024 / 375 },
	Train = { Id = 87524953826160, File = "train.png", Aspect = 1024 / 556 },
	Fight = { Id = 124576908457553, File = "fight.png", Aspect = 1024 / 506 },
	MyPets = { Id = 102245046728736, File = "my-pets.png", Aspect = 950 / 952 },
	PetBook = { Id = 109596211807745, File = "pet-book.png", Aspect = 1024 / 969 },
	Daily = { Id = 128022063635544, File = "daily.png", Aspect = 1024 / 992 },
	Spin = { Id = 84426205531752, File = "spin.png", Aspect = 975 / 989 },
	Shop = { Id = 95443335354858, File = "shop.png", Aspect = 1006 / 1024 },
} :: { [string]: Art }

LobbyHudArt.LowPoly = {
	Play = { Id = 114838950909512, File = "play.png", Aspect = 1024 / 342 },
	Train = { Id = 137572183122331, File = "train.png", Aspect = 1024 / 520 },
	Fight = { Id = 89518801391920, File = "fight.png", Aspect = 1024 / 534 },
	MyPets = { Id = 76720327418104, File = "my-pets.png", Aspect = 1024 / 963 },
	PetBook = { Id = 76401971573055, File = "pet-book.png", Aspect = 1003 / 924 },
	Daily = { Id = 71271807509237, File = "daily.png", Aspect = 1024 / 949 },
	Spin = { Id = 99517740835124, File = "spin.png", Aspect = 1012 / 980 },
	Shop = { Id = 114606500480158, File = "shop.png", Aspect = 1024 / 950 },
} :: { [string]: Art }

-- the picture a button shows now: the low-poly one once uploaded, else the first set
function LobbyHudArt.get(name: string): Art?
	local lp = LobbyHudArt.LowPoly[name]
	if lp and lp.Id > 0 then
		return lp
	end
	return LobbyHudArt.Buttons[name]
end

function LobbyHudArt.image(name: string): string?
	local a = LobbyHudArt.get(name)
	if a and a.Id > 0 then
		return "rbxassetid://" .. a.Id
	end
	return nil
end

return LobbyHudArt
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="151">
        <Properties>
          <string name="Name">LobbyHudIdle</string>
          <string name="Source"><![CDATA[--!strict
-- Lobby HUD v2 idle personality (carter 2026-10-15): now and then ONE button does its own short move, then the HUD
-- rests for a few quiet seconds. Pure numbers and picks; client/ui/LobbyHudV2 plays them.
--   * Moves[name]: the button's steps. Each step tweens the whole painted button (one piece) to a pose:
--     x / y = offset as a share of the button's own size, sx / sy = size share, rot = degrees. Every move ends at rest.
--   * Moves[name].Fx: the separate light decoration that goes with it (Stars, Burst, Glow, Flash); Low Effects drops it.
--   * pick(now, lastAt, last, claimable, r): which button goes next (nil = nobody is ready). DAILY only goes while a
--     reward is claimable; never the same button twice in a row; each button rests between its own turns.

local LobbyHudIdle = {}

export type Step = { d: number, x: number?, y: number?, sx: number?, sy: number?, rot: number?, style: string?, dir: string? }
export type Move = { Steps: { Step }, Fx: string?, FxAt: number?, Stretch: boolean? }

LobbyHudIdle.Gap = { Min = 3.5, Max = 5.5 } -- quiet seconds after a move ends, before the next one starts
LobbyHudIdle.FirstWait = 2.5 -- after arriving in the lobby (the entrance pop plays first)
LobbyHudIdle.Rest = { Play = 8, Default = 14, Daily = 9 } -- a button's own rest between its turns
LobbyHudIdle.Weight = { Play = 3, Daily = 2, Default = 1 } -- PLAY is the liveliest
LobbyHudIdle.Limit = { Move = 0.12, Size = 0.1, Rot = 9, Time = 1.6 } -- keep every pose close to rest (tested)

LobbyHudIdle.Order = { "Play", "MyPets", "PetBook", "Daily", "Spin", "Train", "Fight", "Shop" }

LobbyHudIdle.Moves = {
	-- squash, spring up, settle with a little bounce; three tiny stars pop round the edges on the spring
	Play = {
		Steps = {
			{ d = 0.12, y = 0.03, sx = 1.05, sy = 0.92, style = "Quad" },
			{ d = 0.16, y = -0.08, sx = 0.97, sy = 1.05, style = "Quad" },
			{ d = 0.4, style = "Back" },
		},
		Fx = "Stars",
		FxAt = 0.12,
		Stretch = true,
	},
	-- an excited hop with a gentle tilt, then settle
	MyPets = {
		Steps = {
			{ d = 0.14, y = -0.09, rot = -5, style = "Quad" },
			{ d = 0.14, y = 0.01, rot = 3, style = "Quad", dir = "In" },
			{ d = 0.3, style = "Back" },
		},
	},
	-- a quick side-to-side wiggle, like a book asking to be opened
	PetBook = {
		Steps = {
			{ d = 0.09, x = 0.015, rot = 4, style = "Sine" },
			{ d = 0.12, x = -0.015, rot = -4, style = "Sine" },
			{ d = 0.11, x = 0.01, rot = 3, style = "Sine" },
			{ d = 0.1, x = -0.005, rot = -2, style = "Sine" },
			{ d = 0.15, style = "Sine" },
		},
	},
	-- the gift shakes with a small sparkle burst (only while a reward is claimable)
	Daily = {
		Steps = {
			{ d = 0.07, rot = -7, sx = 1.04, sy = 1.04, style = "Quad" },
			{ d = 0.09, rot = 7, sx = 1.04, sy = 1.04, style = "Quad" },
			{ d = 0.09, rot = -5, sx = 1.02, sy = 1.02, style = "Quad" },
			{ d = 0.08, rot = 4, style = "Quad" },
			{ d = 0.2, style = "Back" },
		},
		Fx = "Burst",
		FxAt = 0.05,
	},
	-- a playful rock of the whole button (the wheel is part of the picture, so the picture rocks, never spins)
	Spin = {
		Steps = {
			{ d = 0.25, rot = 6, style = "Sine" },
			{ d = 0.4, rot = -6, style = "Sine" },
			{ d = 0.3, rot = 3, style = "Sine" },
			{ d = 0.3, style = "Sine" },
		},
	},
	-- a small hop up with a soft glow underneath
	Train = {
		Steps = {
			{ d = 0.16, y = -0.08, style = "Quad" },
			{ d = 0.14, y = 0.01, style = "Quad", dir = "In" },
			{ d = 0.2, style = "Back" },
		},
		Fx = "Glow",
		FxAt = 0,
	},
	-- a short punchy tilt and a quick flash round the edge
	Fight = {
		Steps = {
			{ d = 0.07, rot = -8, sx = 1.05, sy = 1.05, style = "Quad" },
			{ d = 0.1, rot = 3, sx = 1.01, sy = 1.01, style = "Quad" },
			{ d = 0.22, style = "Back" },
		},
		Fx = "Flash",
		FxAt = 0.03,
	},
	-- a gentle sway, like a bag hanging from a hand
	Shop = {
		Steps = {
			{ d = 0.3, x = 0.01, rot = 4, style = "Sine" },
			{ d = 0.45, x = -0.01, rot = -4, style = "Sine" },
			{ d = 0.35, x = 0.005, rot = 2, style = "Sine" },
			{ d = 0.3, style = "Sine" },
		},
	},
} :: { [string]: Move }

-- where the separate sparkles sit, as shares of the button's box (round the edges, never over the words)
LobbyHudIdle.StarSpots = {
	Play = { { x = 0.03, y = 0.12 }, { x = 0.97, y = 0.18 }, { x = 0.9, y = 0.92 } },
	Daily = { { x = 0.08, y = 0.08 }, { x = 0.92, y = 0.1 }, { x = 0.04, y = 0.6 }, { x = 0.96, y = 0.55 } },
}

function LobbyHudIdle.duration(name: string): number
	local m = LobbyHudIdle.Moves[name]
	local t = 0
	if m then
		for _, s in m.Steps do
			t += s.d
		end
	end
	return t
end

local function rest(name: string): number
	return (LobbyHudIdle.Rest :: any)[name] or LobbyHudIdle.Rest.Default
end

local function weight(name: string): number
	return (LobbyHudIdle.Weight :: any)[name] or LobbyHudIdle.Weight.Default
end

-- quiet seconds before the next move (r in 0..1)
function LobbyHudIdle.gap(r: number): number
	local g = LobbyHudIdle.Gap
	return g.Min + (g.Max - g.Min) * math.clamp(r, 0, 1)
end

-- the next button to move, or nil when none is ready. `lastAt[name]` = when it last moved (nil = never).
-- `skip[name]` = true for a button that is busy (held down or hovered) and must not move now.
function LobbyHudIdle.pick(now: number, lastAt: { [string]: number }, last: string?, claimable: boolean, r: number, skip: { [string]: boolean? }?): string?
	local ready: { string } = {}
	local total = 0
	for _, name in LobbyHudIdle.Order do
		local at = lastAt[name]
		local ok = name ~= last and (at == nil or now - at >= rest(name)) and not (skip and skip[name])
		if name == "Daily" and not claimable then
			ok = false
		end
		if ok then
			table.insert(ready, name)
			total += weight(name)
		end
	end
	if total <= 0 then
		return nil
	end
	local roll = math.clamp(r, 0, 0.999999) * total
	for _, name in ready do
		roll -= weight(name)
		if roll < 0 then
			return name
		end
	end
	return ready[#ready]
end

return LobbyHudIdle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="152">
        <Properties>
          <string name="Name">LobbyHudLayout</string>
          <string name="Source"><![CDATA[--!strict
-- Lobby HUD v2 layout (carter's ChatGPT lobby prototype, 2026-10-15): where each piece sits, in LOGICAL px of the
-- HUD layer (origin top left, after UIScale). Pure, so every screen size is tested offline (tests/test_lobby_hud.luau).
--   coin pill top left, FIND THE PET title top centre, MY PETS / PET BOOK stacked on the left, DAILY / SPIN / SHOP
--   stacked on the right, TRAIN / big PLAY / FIGHT in one row at the bottom centre.
-- Keep-outs: Roblox's jump button (SafeZones.jumpZone) on touch screens; nothing overlaps anything else.

local SafeZones = require(script.Parent.SafeZones)
local LobbyHudArt = require(script.Parent.LobbyHudArt)

-- picture width / height of a button (carter's art), so each button box matches its picture
local function aspect(name: string): number
	local a = LobbyHudArt.get(name)
	return if a then a.Aspect else 1
end

local LobbyHudLayout = {}

export type Rect = SafeZones.Rect
export type Layout = { [string]: Rect }

LobbyHudLayout.EDGE = 8
LobbyHudLayout.GAP = 8
LobbyHudLayout.LEFT = { "MyPets", "PetBook" }
LobbyHudLayout.RIGHT = { "Daily", "Spin", "Shop" }
LobbyHudLayout.ROW = { "Train", "Play", "Fight" }
-- the queue line over PLAY ("HUNT IN 12s · 1/4 players")
LobbyHudLayout.STATUS_H = 26

local function status(out: { [string]: Rect }, w: number, aboveY: number?)
	local p = out.Play
	local sw = math.min(w - 2 * LobbyHudLayout.EDGE, math.max(p.w * 1.5, 300))
	out.Status = { x = math.clamp(p.x + p.w / 2 - sw / 2, LobbyHudLayout.EDGE, w - LobbyHudLayout.EDGE - sw), y = (aboveY or p.y) - LobbyHudLayout.STATUS_H - 4, w = sw, h = LobbyHudLayout.STATUS_H }
end

local function rect(x: number, y: number, w: number, h: number): Rect
	return { x = x, y = y, w = w, h = h }
end

-- `w`, `h`: logical screen; `scale`: real px per logical px; `touch`: keep the jump corner clear.
function LobbyHudLayout.layout(w: number, h: number, scale: number?, touch: boolean?): Layout
	local E, G = LobbyHudLayout.EDGE, LobbyHudLayout.GAP
	local out: Layout = {}
	local jump = if touch == false then rect(w, h, 0, 0) else SafeZones.jumpZone(w, h, scale)
	if h > w then
		return LobbyHudLayout.portrait(w, h, jump)
	end

	-- top: coin pill and title
	local coinW, coinH = math.clamp(w * 0.21, 150, 220), math.clamp(h * 0.12, 40, 54)
	out.Coins = rect(E, E - 2, coinW, coinH)
	local titleW = math.clamp(w * 0.24, 170, 260)
	local titleH = titleW * 0.34
	out.Title = rect((w - titleW) / 2, 0, titleW, titleH)

	-- bottom row: PLAY widest, TRAIN / FIGHT a bit over half its width; heights follow the pictures
	local playW = math.clamp(w * 0.29, 200, 320)
	playW = math.min(playW, h * 0.27 * aspect("Play")) -- never taller than about a quarter of a short screen
	local playH = playW / aspect("Play")
	local sideW = math.floor(playW * 0.58)
	local trainH, fightH = sideW / aspect("Train"), sideW / aspect("Fight")
	local rowH = math.max(trainH, fightH)
	local total = playW + 2 * sideW + 2 * G
	local x0 = (w - total) / 2
	local bottom = h - E
	-- slide left of the jump corner when the centred row would touch it
	local maxRight = jump.x - G
	if x0 + total > maxRight and jump.w > 0 then
		x0 = math.max(E + 70, maxRight - total)
	end
	out.Train = rect(x0, bottom - trainH, sideW, trainH)
	out.Play = rect(x0 + sideW + G, bottom - playH, playW, playH)
	out.Fight = rect(x0 + sideW + G + playW + G, bottom - fightH, sideW, fightH)
	local rowTop = bottom - math.max(playH, rowH)

	-- side stacks: square buttons, sized to fit between the top pieces and the row / jump corner
	local s = math.clamp(h * 0.2, 56, 90)
	local rightTop = E
	local rightBottom = math.min(jump.y, h) - G
	local leftTop = out.Coins.y + coinH + G
	local leftBottom = rowTop - G
	-- the row only blocks a stack when it reaches under it
	if out.Train.x > E + s + G then
		leftBottom = h - E
	end
	if out.Fight.x + out.Fight.w < w - E - s - G then
		rightBottom = math.min(rightBottom, h - E)
	else
		rightBottom = math.min(rightBottom, rowTop - G)
	end
	s = math.min(s, (rightBottom - rightTop - 2 * G) / 3, (leftBottom - leftTop - G) / 2)
	local function stack(names: { string }, x: number, top: number, bot: number, centre: number)
		local n = #names
		local height = n * s + (n - 1) * G
		local y = math.clamp(centre - height / 2, top, math.max(top, bot - height))
		for i, name in names do
			out[name] = rect(x, y + (i - 1) * (s + G), s, s)
		end
	end
	stack(LobbyHudLayout.LEFT, E, leftTop, leftBottom, h * 0.47)
	stack(LobbyHudLayout.RIGHT, w - E - s, rightTop, rightBottom, h * 0.42)
	status(out, w)
	return out
end

-- Upright phone: coins and title share the top, the stacks sit at mid height on each side, PLAY spans the bottom
-- left of the jump button with TRAIN and FIGHT side by side above it.
function LobbyHudLayout.portrait(w: number, h: number, jump: Rect): Layout
	local E, G = LobbyHudLayout.EDGE, LobbyHudLayout.GAP
	local out: Layout = {}
	local coinW = math.min(w * 0.46, 200)
	out.Coins = rect(E, E - 2, coinW, 44)
	local titleW = math.min(w - coinW - 3 * E, 220)
	out.Title = rect(w - E - titleW, 0, titleW, math.min(titleW * 0.34, 70))
	local right = (if jump.w > 0 then jump.x else w) - G
	local playW = right - E
	local playH = playW / aspect("Play")
	out.Play = rect(E, h - E - playH, playW, playH)
	local sideW = (playW - G) / 2
	local trainH, fightH = sideW / aspect("Train"), sideW / aspect("Fight")
	local rowH = math.max(trainH, fightH)
	local rowY = out.Play.y - G - rowH
	out.Train = rect(E, rowY + rowH - trainH, sideW, trainH)
	out.Fight = rect(E + sideW + G, rowY + rowH - fightH, sideW, fightH)
	local s = math.clamp(w * 0.19, 56, 84)
	local top = out.Coins.y + out.Coins.h + G + 70
	for i, name in LobbyHudLayout.LEFT do
		out[name] = rect(E, top + (i - 1) * (s + G), s, s)
	end
	for i, name in LobbyHudLayout.RIGHT do
		out[name] = rect(w - E - s, top + (i - 1) * (s + G), s, s)
	end
	status(out, w, rowY)
	return out
end

-- Every piece's name (for tests and the client).
function LobbyHudLayout.names(): { string }
	local list = { "Coins", "Title", "Status" }
	for _, group in { LobbyHudLayout.LEFT, LobbyHudLayout.RIGHT, LobbyHudLayout.ROW } do
		for _, n in group do
			table.insert(list, n)
		end
	end
	return list
end

return LobbyHudLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="153">
        <Properties>
          <string name="Name">LuckEvents</string>
          <string name="Source"><![CDATA[--!strict
-- Luck events and luck stacking (pure; tested in tests/test_robux.luau). The server (RobuxService) runs the storm
-- clock and publishes the live state as ReplicatedStorage attributes; the hunt reward (MatchService) and paid eggs
-- (RobuxService) add the sources up with LuckEvents.total, and the shop / HUD show the same numbers.
--
-- "Luck" is the GeodeGen number: Rare and better pets weigh (1 + luck) times more. Luck never changes which egg hides
-- the pet or who finds it.
--
-- ReplicatedStorage attributes (set by the server only):
--   LuckStormUntil  number  os.time() when the current luck storm ends (0 / past = no storm)
--   LuckWeekend     boolean the UTC weekend 2x luck is on

local Config = require(script.Parent.Config)
local RobuxConfig = require(script.Parent.RobuxConfig)
local GeodeGen = require(script.Parent.GeodeGen)
local SpeciesPool = require(script.Parent.SpeciesPool)
local LaunchPerks = require(script.Parent.LaunchPerks)

local LuckEvents = {}

-- Saturday or Sunday in UTC (os.date "!*t": wday 1 = Sunday, 7 = Saturday).
function LuckEvents.isWeekend(t: number): boolean
	local d = os.date("!*t", math.floor(t)) :: any
	return d.wday == 1 or d.wday == 7
end

export type Sources = {
	Pet: number?, -- equipped pets' Luck boost (already capped by Config.Pets.KindCap.Luck)
	Friends: number?, -- friends / party luck (already capped by QueueConfig.FriendLuck.Max)
	Potion: number?,
	Weekend: number?,
	Storm: number?,
	Hour: number?, -- lucky hour (LaunchPerks.luckyHourUntil)
	Vip: number?, -- VIP pass (RobuxConfig.vipLuck)
}

-- The timed sources active at `now` for a player whose potion runs until `potionUntil`, on a server whose storm runs
-- until `stormUntil`.
function LuckEvents.timed(now: number, potionUntil: number?, stormUntil: number?): { Potion: number, Weekend: number, Storm: number, Hour: number }
	local ev = RobuxConfig.Events
	return {
		Potion = if (potionUntil or 0) > now then RobuxConfig.Potion.Luck else 0,
		Weekend = if LuckEvents.isWeekend(now) then ev.WeekendLuck else 0,
		Storm = if (stormUntil or 0) > now then ev.StormLuck else 0,
		Hour = if LaunchPerks.luckyHourUntil(now) > 0 then ev.LuckyHourLuck else 0,
	}
end

-- Sum of every source, clamped to [0, RobuxConfig.MaxLuck]. Bad numbers (nil, NaN, negative) count as 0.
function LuckEvents.total(s: Sources): number
	local sum = 0
	for _, v in { s.Pet, s.Friends, s.Potion, s.Weekend, s.Storm, s.Hour, s.Vip } do
		if type(v) == "number" and v == v and v > 0 then
			sum += v
		end
	end
	return math.clamp(sum, 0, RobuxConfig.MaxLuck)
end

-- "x2" style multiplier the UI shows for a luck total (Rare and better odds factor).
function LuckEvents.factor(luck: number): number
	return 1 + math.clamp(luck, 0, RobuxConfig.MaxLuck)
end

-- Seconds until the next storm (random within the configured gap). first = a fresh server.
function LuckEvents.nextGap(rng: Random, first: boolean?): number
	local ev = RobuxConfig.Events
	if first then
		return ev.FirstStormMin + rng:NextNumber() * (ev.StormGapMax - ev.StormGapMin) * 0.5
	end
	return ev.StormGapMin + rng:NextNumber() * (ev.StormGapMax - ev.StormGapMin)
end

-- "12:05" / "1:02:03" for a countdown in seconds.
function LuckEvents.clock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	local h, m = math.floor(s / 3600), math.floor(s % 3600 / 60)
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s % 60)
	end
	return string.format("%d:%02d", m, s % 60)
end

export type Odds = {
	Rarity: { { Name: string, P: number } },
	Variant: { { Name: string, P: number } },
	Species: { string },
	SpeciesP: { { Id: string, Name: string, P: number, Chase: boolean } }, -- per species chance (chase = Legendary only)
}

-- The exact odds GeodeGen.roll uses for a pet of this zone with this luck (the paid egg card prints these).
-- Rarity and variant are independent; the species follows SpeciesPool (chase pet = the Legendary roll).
function LuckEvents.eggOdds(tierId: string, luck: number?, baseWeights: { [string]: number }?): Odds
	local w = GeodeGen.rarityWeights(luck, baseWeights)
	local total = 0
	for _, r in Config.Rarities do
		total += w[r] or 0
	end
	local out: Odds = { Rarity = {}, Variant = {}, Species = {}, SpeciesP = {} }
	for _, r in Config.Rarities do
		table.insert(out.Rarity, { Name = r, P = if total > 0 then (w[r] or 0) / total else 0 })
	end
	local vt = 0
	for _, m in Config.Modifiers do
		vt += (Config.ModifierWeights :: any)[m] or 0
	end
	for _, m in Config.Modifiers do
		local name = (Config.ModifierNames :: any)[m]
		table.insert(out.Variant, { Name = if name == nil or name == "" then "Normal" else name, P = if vt > 0 then ((Config.ModifierWeights :: any)[m] or 0) / vt else 0 })
	end
	local rp = {}
	for _, r in out.Rarity do
		rp[r.Name] = r.P
	end
	local now = os.time()
	for _, id in SpeciesPool.list(tierId, now) do
		local m: any = (Config.Minerals :: any)[id]
		table.insert(out.Species, if m then m.Name else id)
		table.insert(out.SpeciesP, { Id = id, Name = if m then m.Name else id, P = SpeciesPool.chance(tierId, id, now, rp), Chase = m ~= nil and m.Chase == true })
	end
	return out
end

-- "60%", "3.9%", "0.1% (1 in 1000)": a chance a young player can read.
function LuckEvents.chanceText(p: number): string
	local pct = p * 100
	local s
	if pct >= 10 or math.abs(pct - math.floor(pct + 0.5)) < 0.05 then
		s = tostring(math.floor(pct + 0.5)) .. "%"
	elseif pct >= 0.0995 then
		s = string.format("%.1f%%", pct)
	else
		s = string.format("%.2f%%", pct)
	end
	if p > 0 and p < 0.01 then
		s ..= " (1 in " .. math.floor(1 / p + 0.5) .. ")"
	end
	return s
end

-- The hatch reveal's odds line: the "1 in N" for one pet, or nil when no line should show. N is always a whole
-- number ("1 in 1.5?" read as a typo, bug #226) and common results show no line at all: a Common pet, or anything
-- better than 1 in OddsLineMin. `p` = the chance of this exact pet (rarity chance times species share).
LuckEvents.OddsLineMin = 10
function LuckEvents.oneIn(p: number, rarity: string?): number?
	if type(p) ~= "number" or p ~= p or p <= 0 or rarity == "Common" then
		return nil
	end
	local n = math.floor(1 / p + 0.5)
	if n < LuckEvents.OddsLineMin then
		return nil
	end
	return n
end

return LuckEvents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="154">
        <Properties>
          <string name="Name">MapNames</string>
          <string name="Source"><![CDATA[--!strict
-- Names the game code looks for in the lobby map. The owner builds the lobby by hand in Studio (Workspace.FTP_Lobby);
-- the code finds its hooks by these names (and attributes), so a name can change here, in one place. Where a hook
-- has a list, the first name is the owner's real map and the others are accepted too. Full list of what each piece
-- needs (attributes, attachments, prompts): docs/MAP_HOOKS.md.
--
-- If Workspace holds a Model (or Folder) named one of MapNames.Roots, that is the hand-built map: the code does not build the
-- procedural park (ParkBuilder) or the old lodge and only adopts the hooks it finds inside it. Without one, the
-- procedural park is built as a simple fallback, using the same names.

local MapNames = {}

MapNames.Roots = { "FTP_Lobby", "Lobby", "PetPark" } -- a hand-built map: a Model or Folder directly under Workspace

-- Hunt queue: QueuePads/QueuePad1..4 (a Model whose touch part is "Pad", or a single Part) and their "Countdown"
-- signs (SurfaceGuis with a TextLabel "Text"); the queue text also goes to an optional single QueueBoard/QueueText.
MapNames.QueuePad = "QueuePad"
MapNames.QueuePadCount = 4
MapNames.QueuePadTouch = "Pad"
MapNames.QueueCountdown = "Countdown"
MapNames.CountdownText = "Text"
MapNames.QueueBoard = "QueueBoard" -- PartyService writes the queue text into QueueBoard/QueueText
MapNames.QueueText = "QueueText"

-- Plots: Plots/Plot1..N (a Model; PrimaryPart "Floor"; the plot faces its PlotSign, i.e. the street)
MapNames.Plot = "Plot"
MapNames.PlotCount = 6 -- plots expected in the hand-built lobby (owner may add more: Plot7.. are found automatically)
MapNames.PlotFloor = "Floor"
MapNames.DomeCount = 3 -- display slots shown on stands (the rest stand in the yard)
-- Display slot k -> the part the pet stands on (accepted names, preferred first): slot 1 under the big glass Dome1
-- on Dome1Base, slots 2 and 3 on Stand1 / Stand2.
MapNames.SlotParts = {
	{ "Dome1Base", "DomeSlot1" },
	{ "Stand1", "Dome2Base", "DomeSlot2" },
	{ "Stand2", "Dome3Base", "DomeSlot3" },
}
MapNames.PlotSign = { "PlotSign", "Nameplate" } -- owner's name sign (TextLabel "Text" or "OwnerText" inside)
MapNames.SignText = { "Text", "OwnerText" }
MapNames.OwnerText = "OwnerText" -- the TextLabel the code makes when a sign has none
MapNames.LikePost = "LikePost" -- optional LIKE part; without it the LIKE prompt goes on the plot sign (or the floor)
MapNames.LikeText = "LikeText" -- optional TextLabel for the like count

-- Buildings (anywhere in the map; FTP_Lobby keeps them in Buildings/)
MapNames.EggShop = "EggShop" -- RobuxService opens the shop through the first ProximityPrompt in it
MapNames.ShopCounter = "Counter"
MapNames.BuildingSign = "Sign"
MapNames.HatchStand = "HatchStand"
MapNames.HatchPoint = "HatchPoint" -- Attachment on the stand's top part
MapNames.TowerEntrance = "TowerEntrance"
MapNames.TowerPortal = "TowerPortal" -- the doorway touch part (attribute TowerPortal = true)
MapNames.TowerExit = "TowerExit" -- optional Part where players come back out of the tower (front = the way they face)
MapNames.SecretEgg = "SecretEgg"
MapNames.SecretEggPrompt = "Take"
MapNames.WhatsNewBoard = "WhatsNewBoard"
MapNames.Spawn = "LobbySpawn" -- a SpawnLocation; any SpawnLocation in the map also works
-- First five minutes (optional Parts; without them the code places these near the lobby spawn):
MapNames.VoidStatueSpot = "VoidStatueSpot" -- old Void Dragon podium spot (removed 2026-10-14: the dragon perches on the leaderboard tree's DragonPerch)
MapNames.StarterEggSpot = "StarterEggSpot" -- a new player's free starter egg sits here

-- Leaderboards (FTP_Lobby: Leaderboards/RarestPetBoard and Leaderboards/TowerFloorBoard, each with a "Board" part
-- holding a SurfaceGui and a TextLabel "Text": the rows are written there as text). A plain Part gets drawn rows.
MapNames.Boards = {
	{ Parts = { "RarestPetBoard", "RarestBoard" }, Id = "Biggest" },
	{ Parts = { "TowerFloorBoard", "TowerBoard" }, Id = "Tower" },
	{ Parts = { "CoinsBoard", "MostCoinsBoard" }, Id = "Coins" },
}
MapNames.BoardFace = "Board"
MapNames.BoardText = "Text"

-- Optional spots where the code builds its existing stalls (a Part; the stall's front faces the Part's LookVector).
MapNames.StallSpots = { Upgrades = "UpgradesSpot", PetBook = "PetBookSpot", Seller = "SellerSpot" }

function MapNames.plot(i: number): string
	return MapNames.Plot .. tostring(i)
end

function MapNames.queuePad(n: number): string
	return MapNames.QueuePad .. tostring(n)
end

-- Accepted names for display slot k's stand part, preferred first.
function MapNames.slotParts(k: number): { string }
	return MapNames.SlotParts[k] or {}
end

-- The hand-built map root among `children` (Workspace:GetChildren()), or nil; earlier Roots win. Pure: tests pass
-- plain tables.
function MapNames.findRoot(children: { any }): any?
	for _, name in MapNames.Roots do
		for _, c in children do
			if c.Name == name and (type(c) == "table" or c:IsA("Model") or c:IsA("Folder")) then
				return c
			end
		end
	end
	return nil
end

return MapNames
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="155">
        <Properties>
          <string name="Name">MatchTicket</string>
          <string name="Source"><![CDATA[--!strict
-- Pure match-ticket rules. The lobby server creates a ticket (stored by the reserved server's
-- PrivateServerId, never trusted from teleport data); the Match server validates every arrival
-- against it. No Roblox services in here, so tests drive it directly.
--
-- Ticket (immutable once stored, plain data): who may enter, which tier, who leads, when the
-- first arrival must happen and when the whole ticket dies. Consumed = the match is over.
-- State (Match server memory only): who is present, how often each user came back.

local MatchTicket = {}

export type Ticket = {
	Id: string, -- ticket id (equals the reserved server's PrivateServerId)
	Leader: number,
	Members: { number }, -- UserIds, party order
	Names: { string }, -- display names parallel to Members (shown while waiting)
	Tier: string,
	Created: number, -- os.time()
	ArriveBy: number, -- first arrivals must happen before this
	Expires: number, -- reconnects must happen before this
	Consumed: boolean,
	LobbyJobId: string, -- lobby server to return to ("" = any)
}

export type State = {
	Present: { [number]: boolean },
	Arrivals: { [number]: number }, -- times each user has entered (1 = first arrival)
	Closed: boolean,
}

export type Verdict = { Ok: boolean, Reason: string?, Reconnect: boolean }

function MatchTicket.create(opts: {
	Id: string,
	Leader: number,
	Members: { number },
	Names: { string }?,
	Tier: string,
	Now: number,
	ArriveSeconds: number,
	LifetimeSeconds: number,
	MaxMembers: number,
	LobbyJobId: string?,
}): (Ticket?, string?)
	if opts.Id == "" then
		return nil, "NoId"
	end
	local n = #opts.Members
	if n < 1 or n > opts.MaxMembers then
		return nil, "BadSize"
	end
	local seen: { [number]: boolean } = {}
	for _, uid in opts.Members do
		if type(uid) ~= "number" or uid ~= uid or seen[uid] then
			return nil, "BadMember"
		end
		seen[uid] = true
	end
	if not seen[opts.Leader] then
		return nil, "LeaderNotMember"
	end
	local ticket: Ticket = {
		Id = opts.Id,
		Leader = opts.Leader,
		Members = table.clone(opts.Members),
		Names = table.clone(opts.Names or {}),
		Tier = opts.Tier,
		Created = opts.Now,
		ArriveBy = opts.Now + opts.ArriveSeconds,
		Expires = opts.Now + opts.LifetimeSeconds,
		Consumed = false,
		LobbyJobId = opts.LobbyJobId or "",
	}
	return ticket, nil
end

function MatchTicket.newState(): State
	return { Present = {}, Arrivals = {}, Closed = false }
end

function MatchTicket.isMember(ticket: Ticket, userId: number): boolean
	return table.find(ticket.Members, userId) ~= nil
end

-- Decides whether userId may enter now. Does not change anything (call recordArrive after).
-- Reasons: NoTicket, Unknown, NotMember, Consumed, Duplicate, Expired, ReconnectLimit.
function MatchTicket.validate(ticket: Ticket?, state: State, userId: any, now: number, maxReconnects: number): Verdict
	local function no(reason: string): Verdict
		return { Ok = false, Reason = reason, Reconnect = false }
	end
	if ticket == nil then
		return no("NoTicket")
	end
	local t = ticket :: Ticket
	if type(userId) ~= "number" then
		return no("Unknown")
	end
	if t.Consumed or state.Closed then
		return no("Consumed")
	end
	if not MatchTicket.isMember(t, userId) then
		return no("NotMember")
	end
	if state.Present[userId] then
		return no("Duplicate")
	end
	if now > t.Expires then
		return no("Expired")
	end
	local before = state.Arrivals[userId] or 0
	if before == 0 then
		if now > t.ArriveBy then
			return no("Expired")
		end
		return { Ok = true, Reason = nil, Reconnect = false }
	end
	if before - 1 >= maxReconnects then
		return no("ReconnectLimit")
	end
	return { Ok = true, Reason = nil, Reconnect = true }
end

function MatchTicket.recordArrive(state: State, userId: number)
	state.Present[userId] = true
	state.Arrivals[userId] = (state.Arrivals[userId] or 0) + 1
end

function MatchTicket.recordLeave(state: State, userId: number)
	state.Present[userId] = nil
end

-- Marks the whole ticket used up (match over or abandoned): nobody may enter again.
function MatchTicket.close(ticket: Ticket?, state: State)
	state.Closed = true
	if ticket then
		(ticket :: Ticket).Consumed = true
	end
end

return MatchTicket
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="156">
        <Properties>
          <string name="Name">Materials</string>
          <string name="Source"><![CDATA[--!strict
-- Material Discoveries, pure rules (docs/m6/DISCOVERIES.md). No Roblox services: unit-tested in tests/.
--
--   pick(salt, roundId, rockId)   the category of one rock in one round. A pure function of a server-only
--                                 salt, so retries / tool changes / who cracks it cannot reroll it, and it does
--                                 not depend on which rock is the geode target. Weights: Config.Materials.
--   record(store, id)             a finished ordinary crush for the owner: counts it and says whether the
--                                 category is new. Unknown ids (a future build wrote them) are ignored.
--   normalize(store)              safe defaults for old or damaged profile data; keeps unknown future ids.
--   progress(store)               numerator / denominator for the Collection line, configured categories only.

local Config = require(script.Parent.Config)

local Materials = {}

export type Store = { Found: { [string]: boolean }, Counts: { [string]: number } }

-- Exact 32-bit multiply (a double cannot hold a 64-bit product, so split into 16-bit halves).
local function mul32(a: number, b: number): number
	local hi = bit32.band(bit32.rshift(a, 16) * b, 0xFFFF)
	return bit32.band(hi * 65536 + bit32.band(a, 0xFFFF) * b, 0xFFFFFFFF)
end

-- 32-bit integer mix (xorshift-multiply), all values stay in uint32 range.
local function mix(h: number): number
	h = bit32.band(h, 0xFFFFFFFF)
	h = mul32(bit32.bxor(h, bit32.rshift(h, 16)), 0x45D9F3B)
	h = mul32(bit32.bxor(h, bit32.rshift(h, 16)), 0x45D9F3B)
	return bit32.bxor(h, bit32.rshift(h, 16))
end

function Materials.order(): { string }
	return Config.MaterialOrder
end

function Materials.get(id: any): any?
	if type(id) ~= "string" then
		return nil
	end
	return Config.Materials[id]
end

function Materials.totalWeight(): number
	local total = 0
	for _, id in Config.MaterialOrder do
		total += Config.Materials[id].Weight
	end
	return total
end

-- The unit-interval draw for one rock: deterministic in (salt, roundId, rockId).
function Materials.roll(salt: number, roundId: number, rockId: number): number
	local h = mix(bit32.band(salt, 0xFFFFFFFF) + 0x9E3779B1)
	h = mix(bit32.bxor(h, mul32(bit32.band(roundId, 0xFFFFFFFF), 0x85EBCA6B)))
	h = mix(bit32.bxor(h, mul32(bit32.band(rockId, 0xFFFFFFFF), 0xC2B2AE35)))
	return h / 4294967296
end

function Materials.pick(salt: number, roundId: number, rockId: number): string
	local x = Materials.roll(salt, roundId, rockId) * Materials.totalWeight()
	local acc = 0
	for _, id in Config.MaterialOrder do
		acc += Config.Materials[id].Weight
		if x < acc then
			return id
		end
	end
	return Config.MaterialOrder[1]
end

function Materials.empty(): Store
	return { Found = {}, Counts = {} }
end

-- Repairs a profile's Materials table in place (never removes ids it does not know: a newer build may have them).
function Materials.normalize(store: any): Store
	if type(store) ~= "table" then
		return Materials.empty()
	end
	if type(store.Found) ~= "table" then
		store.Found = {}
	end
	if type(store.Counts) ~= "table" then
		store.Counts = {}
	end
	for k, v in store.Counts do
		if type(k) ~= "string" or type(v) ~= "number" or v ~= v or v < 0 or v == math.huge then
			store.Counts[k] = nil
		else
			store.Counts[k] = math.floor(v)
		end
	end
	for k, v in store.Found do
		if type(k) ~= "string" or v ~= true then
			store.Found[k] = nil
		end
	end
	-- a counted category was necessarily discovered
	for k, v in store.Counts do
		if v > 0 then
			store.Found[k] = true
		end
	end
	return store
end

-- Returns (counted, isNew). Only configured categories count.
function Materials.record(store: Store, id: any): (boolean, boolean)
	if type(id) ~= "string" or not Config.Materials[id] then
		return false, false
	end
	local isNew = store.Found[id] ~= true
	store.Found[id] = true
	store.Counts[id] = (store.Counts[id] or 0) + 1
	return true, isNew
end

function Materials.progress(store: any): (number, number)
	local n = 0
	local found = if type(store) == "table" and type(store.Found) == "table" then store.Found else {}
	for _, id in Config.MaterialOrder do
		if found[id] == true then
			n += 1
		end
	end
	return n, #Config.MaterialOrder
end

-- The compact copy sent to the owning client (configured ids only).
function Materials.publicView(store: Store): Store
	local out = Materials.empty()
	for _, id in Config.MaterialOrder do
		if store.Found[id] then
			out.Found[id] = true
			out.Counts[id] = store.Counts[id] or 0
		end
	end
	return out
end

return Materials
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="157">
        <Properties>
          <string name="Name">MeshCatalog</string>
          <string name="Source"><![CDATA[--!strict
