      <Item class="ModuleScript" referent="195">
        <Properties>
          <string name="Name">SpeciesPool</string>
          <string name="Source"><![CDATA[--!strict
-- Which pet species a zone can hatch, and with what chance (pure; tests/test_species_pool.luau).
--   * Weekly pets (Config.WeeklyPets) are hidden until their week starts.
--   * Chase pets (species Chase = true) are Legendary only: a Legendary hatch in a zone with a released chase pet is
--     always that pet. Every other released species of the zone shares the other rarities equally.
-- GeodeGen.roll picks with SpeciesPool.pick; the shop odds (LuckEvents.eggOdds) and the Pet Book use SpeciesPool.chance,
-- so the printed odds are exactly the rolled ones.

local Config = require(script.Parent.Config)

local SpeciesPool = {}

-- Unix time a weekly species unlocks, nil when it is not weekly. math.huge while Start is unset (hidden).
function SpeciesPool.releaseTime(id: string): number?
	local sp: any = (Config.Minerals :: any)[id]
	if not sp or not sp.Weekly then
		return nil
	end
	local w = Config.WeeklyPets
	local idx = table.find(w.Order, id)
	if not idx or (tonumber(w.Start) or 0) <= 0 then
		return math.huge
	end
	return w.Start + (idx - 1) * w.Days * 86400
end

function SpeciesPool.released(id: string, now: number): boolean
	local t = SpeciesPool.releaseTime(id)
	return t == nil or now >= t
end

-- Released species of a zone, in the zone's list order: (normal ids, chase id or nil).
function SpeciesPool.available(tierId: string, now: number): ({ string }, string?)
	local tier = (Config.Tiers :: any)[tierId]
	local normal, chase = {}, nil
	if not tier then
		return normal, nil
	end
	for _, id in tier.Minerals do
		local sp: any = (Config.Minerals :: any)[id]
		if sp and not sp.TowerOnly and SpeciesPool.released(id, now) then
			if sp.Chase then
				chase = chase or id
			else
				table.insert(normal, id)
			end
		end
	end
	return normal, chase
end

-- Every released species of a zone (normal first, then the chase pet).
function SpeciesPool.list(tierId: string, now: number): { string }
	local normal, chase = SpeciesPool.available(tierId, now)
	local out = table.clone(normal)
	if chase then
		table.insert(out, chase)
	end
	return out
end

-- The species for a pet of `rarity` in this zone.
function SpeciesPool.pick(rng: Random, tierId: string, rarity: string, now: number): string
	local normal, chase = SpeciesPool.available(tierId, now)
	if chase and (rarity == "Legendary" or #normal == 0) then
		return chase
	end
	if #normal == 0 then
		-- nothing released here (bad config): any released pile species, in zone order, never a tower-only one
		for _, tid in Config.TierOrder do
			local other = SpeciesPool.available(tid, now)
			if #other > 0 then
				return other[1]
			end
		end
		local tier = (Config.Tiers :: any)[tierId]
		return tier.Minerals[1]
	end
	return normal[rng:NextInteger(1, #normal)]
end

-- Chance that a pet of this zone is species `id`, given the rarity chances `rarityP` ({ [rarity] = 0..1 }).
function SpeciesPool.chance(tierId: string, id: string, now: number, rarityP: { [string]: number }): number
	local normal, chase = SpeciesPool.available(tierId, now)
	local legendary = rarityP.Legendary or 0
	if chase and id == chase then
		return if #normal == 0 then 1 else legendary
	end
	if not table.find(normal, id) then
		return 0
	end
	local rest = if chase then 1 - legendary else 1
	return rest / #normal
end

-- True when this species can only hatch at this rarity (the chase pet: Legendary).
function SpeciesPool.rarityAllowed(id: string, rarity: string): boolean
	local sp: any = (Config.Minerals :: any)[id]
	return not (sp and sp.Chase) or rarity == "Legendary"
end

return SpeciesPool
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="196">
        <Properties>
          <string name="Name">StandRules</string>
          <string name="Source"><![CDATA[--!strict
-- Standing a model upright on top of a part (lobby top-player statues, audit 2 #41: the #1 avatar lay tipped across
-- the yellow podium). The old code copied the pedestal's whole rotation, so a cylinder pedestal (Roblox cylinders
-- lie along X and are turned 90 degrees to stand) tipped the avatar over with it, and used Size.Y as the height.
-- Here only the pedestal's facing (yaw) is kept, the model's feet sit on the pedestal's real highest point, and the
-- model's own pivot offset is respected.

local StandRules = {}

-- World Y of the highest point of a box part (any rotation).
function StandRules.topY(cf: CFrame, size: Vector3): number
	local h = size / 2
	return cf.Position.Y + math.abs(cf.RightVector.Y) * h.X + math.abs(cf.UpVector.Y) * h.Y + math.abs(cf.LookVector.Y) * h.Z
end

-- A flat facing direction from the pedestal: its look vector without tilt (or its up vector for a part turned on
-- its side), default -Z.
function StandRules.facing(cf: CFrame): Vector3
	for _, v in { cf.LookVector, cf.UpVector, cf.RightVector } do
		local flat = Vector3.new(v.X, 0, v.Z)
		if flat.Magnitude > 0.1 then
			return flat.Unit
		end
	end
	return Vector3.new(0, 0, -1)
end

-- The pivot CFrame for a model standing upright on the pedestal (`padCF`, `padSize`). `pivot` is the model's current
-- pivot and `boxCF`, `boxSize` its bounding box (Model:GetBoundingBox), measured while the model stands upright.
function StandRules.onTop(padCF: CFrame, padSize: Vector3, pivot: CFrame, boxCF: CFrame, boxSize: Vector3): CFrame
	local feet = boxCF.Position.Y - boxSize.Y / 2 -- the model's lowest point
	local lift = pivot.Position.Y - feet -- pivot height above the feet
	local at = Vector3.new(padCF.Position.X, StandRules.topY(padCF, padSize) + lift, padCF.Position.Z)
	return CFrame.lookAt(at, at + StandRules.facing(padCF))
end

return StandRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="197">
        <Properties>
          <string name="Name">TeleportBook</string>
          <string name="Source"><![CDATA[--!strict
-- Pure bookkeeping of the teleport flow (server/LobbyLaunch, server/MatchPlace), kept apart so it is tested offline
-- (tests/test_teleport_book.luau): which launch entries a dissolved launch clears, who is still here after a save
-- yielded, and which players a Return request takes (one already on its way back is skipped).
local TeleportBook = {}

-- Removes every `launchOf` entry (uid -> party id) that points at `partyId`, whoever is on the roster now. Returns how
-- many were removed.
function TeleportBook.dissolve(launchOf: { [number]: string }, partyId: string): number
	local n = 0
	for uid, pid in table.clone(launchOf) do
		if pid == partyId then
			launchOf[uid] = nil
			n += 1
		end
	end
	return n
end

-- True when every uid is still in the party and on the server; otherwise false and the refusal text.
function TeleportBook.stillHere(members: { number }, uids: { number }, onServer: (number) -> boolean): (boolean, string?)
	for _, uid in uids do
		if not onServer(uid) or not table.find(members, uid) then
			return false, "A party member left."
		end
	end
	return true, nil
end

-- A Return request: the uids that start a return now. A uid already returning is skipped unless this is a retry
-- (`retry` true: the caller's own earlier attempt failed). Each taken uid is stamped with `token`.
function TeleportBook.takeReturns(returning: { [number]: number }, uids: { number }, token: number, retry: boolean): { number }
	local taken = {}
	for _, uid in uids do
		if retry or returning[uid] == nil then
			table.insert(taken, uid)
			returning[uid] = token
		end
	end
	return taken
end

-- True when the watchdog of return `token` still owns `uid` (a newer return replaced it, or it cleared on arrival: no).
function TeleportBook.stillOwns(returning: { [number]: number }, uid: number, token: number): boolean
	return returning[uid] == token
end

return TeleportBook
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="198">
        <Properties>
          <string name="Name">ThemeWords</string>
          <string name="Source"><![CDATA[--!strict
-- THEME WORDS: the one list of words that must never appear in text a player reads. FIND THE PET! is a pet game
-- (find, train, fight): rock and mining wording is banned in names, descriptions, toasts, prompts, quests, news.
-- Code identifiers, attribute names and save keys keep their old names on purpose (CLAUDE.md), so this list is
-- only checked against player-visible strings (tests/test_theme_words.luau). Whole words, case-insensitive.

local ThemeWords = {}

ThemeWords.Banned = {
	"rock", "rocks", "rocky", "boulder", "boulders",
	"crack", "cracks", "cracked", "cracking", "cracker",
	"mallet", "mallets", "hammer", "hammers", "jackhammer", "tapper",
	"mine", "mines", "mining", "miner", "miners",
	"geode", "geodes", "rubble", "quarry", "ore", "ores", "pickaxe", "pickaxes",
	"crush", "crushes", "crushed", "crushing", "crusher", "crushers",
	"shell", "shells",
} :: { string }

local set: { [string]: boolean } = {}
for _, w in ThemeWords.Banned do
	set[w] = true
end

-- The first banned whole word inside `text`, or nil.
function ThemeWords.find(text: any): string?
	if type(text) ~= "string" then
		return nil
	end
	for word in string.gmatch(string.lower(text), "%a+") do
		if set[word] then
			return word
		end
	end
	return nil
end

return ThemeWords
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="199">
        <Properties>
          <string name="Name">TouchLayout</string>
          <string name="Source"><![CDATA[--!strict
-- Where Roblox's own touch controls sit, and where the game's primary action button may go.
--
-- All numbers are SCREEN pixels measured from the bottom-right corner (what Roblox calls
-- AbsoluteSize / Position of the PlayerGui, not our UIScale'd logical pixels).
--
-- Roblox's native jump button (PlayerModule/ControlModule/TouchJump) is, from memory, a circle of
-- 70 px (shorter screen side <= 500) or 120 px, whose left edge is 1.5 * size - 10 from the right edge
-- and whose top edge is size + 20 (small) or 1.75 * size (large) above the bottom edge. The owner's
-- recording shows the previous placement (which already used this model with a 14 px gap) overlapping
-- the real button, so this module does not trust the model alone: it reserves the model's area GROWN by
-- INFLATE towards the screen centre and puts the action outside it, with a visible gap. The real
-- rectangle must still be measured in Studio (docs/m4/INTERACTION.md).
local TouchLayout = {}

export type Rect = { Right: number, Left: number, Bottom: number, Top: number } -- distances from the right / bottom edge

local INFLATE = 1.1 -- allowance for a bigger real button (touch-control scaling, other control schemes) ...
local PAD = 14 -- ... plus a fixed margin in screen px
local GAP = 16 -- clear space between the reserved jump area and the action

-- The native jump button's rectangle by the model (edges as distances from the right/bottom edge).
function TouchLayout.jumpRect(w: number, h: number): Rect
	local small = math.min(w, h) <= 500
	local size = if small then 70 else 120
	local left = size * 1.5 - 10 -- left edge, from the right
	local top = if small then size + 20 else size * 1.75 -- top edge, from the bottom
	return { Right = left - size, Left = left, Bottom = top - size, Top = top }
end

-- The area kept free for the jump button: the model rectangle stretched out to the corner and grown
-- by INFLATE on its inner sides (so it also covers a button placed lower, further right or larger).
function TouchLayout.reserved(w: number, h: number): Rect
	local j = TouchLayout.jumpRect(w, h)
	return { Right = 0, Left = j.Left * INFLATE + PAD, Bottom = 0, Top = j.Top * INFLATE + PAD }
end

-- Position for an action of height `actH` (screen px). Returns the distance of its RIGHT edge from the
-- right edge, of its BOTTOM edge from the bottom edge, and the mode. `topLimit` = the highest its top
-- edge may reach (distance from the bottom edge). Preferred: directly above the reserved jump area; if
-- that is too tall for the screen, left of it on the bottom row. `touch` false (keyboard and mouse):
-- bottom right corner, there is no jump button to avoid.
function TouchLayout.place(w: number, h: number, actH: number, topLimit: number, touch: boolean): (number, number, string)
	if not touch then
		return 20, 90, "corner"
	end
	local r = TouchLayout.reserved(w, h)
	local bottom = r.Top + GAP
	if bottom + actH <= topLimit then
		return 24, bottom, "above"
	end
	return r.Left + GAP, 24, "left"
end

-- True when the action rectangle (right/bottom distances, size actW x actH) overlaps the reserved area.
function TouchLayout.overlapsJump(w: number, h: number, right: number, bottom: number, actW: number, actH: number): boolean
	local r = TouchLayout.reserved(w, h)
	local aLeft, aTop = right + actW, bottom + actH
	return not (right >= r.Left or aLeft <= r.Right or bottom >= r.Top or aTop <= r.Bottom)
end

return TouchLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="200">
        <Properties>
          <string name="Name">TowerConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Pet Tower tuning (design: project file plans/pet-tower.md). Pure data, no Roblox services.
-- Stats only matter inside the tower; the egg race never reads this file.

local TowerConfig = {}

export type Base = { Element: string, Power: number, Health: number, Speed: number, Basic: string }
export type Special = {
	Id: string,
	Name: string,
	Kind: string, -- "Burn" | "Slow" | "Chain" | "Heal" | "Shield" | "Stomp" | "Dash" | "Crit"
	Value: number, -- meaning depends on Kind (damage multiplier, heal fraction, seconds...)
	MinRarity: number, -- index into Rarities; rarer pets can roll stronger specials
	Element: string?, -- only pets of this type roll it; nil = any type
}
export type Mob = { Id: string, Element: string, Name: string, Pet: string?, Health: number, Power: number, Speed: number, Boss: boolean }

-- Species base stats, keyed by the pet species id (Specimen.Mineral). Speed 100 = one attack per second.
TowerConfig.Species = {
	Raptor = { Element = "Nature", Power = 12, Health = 90, Speed = 115, Basic = "Claw Rush" },
	Ostrich = { Element = "Nature", Power = 10, Health = 110, Speed = 105, Basic = "Peck" },
	DireWolf = { Element = "Storm", Power = 14, Health = 105, Speed = 110, Basic = "Bite" },
	Griffin = { Element = "Storm", Power = 15, Health = 100, Speed = 105, Basic = "Talon Dive" },
	FrostWyvern = { Element = "Ice", Power = 16, Health = 115, Speed = 100, Basic = "Frost Nip" },
	Mammoth = { Element = "Earth", Power = 14, Health = 150, Speed = 85, Basic = "Tusk Bump" },
	LavaTRex = { Element = "Fire", Power = 19, Health = 130, Speed = 90, Basic = "Lava Chomp" },
	Phoenix = { Element = "Fire", Power = 17, Health = 110, Speed = 115, Basic = "Flame Wing" },
	CosmicDragon = { Element = "Cosmic", Power = 20, Health = 140, Speed = 100, Basic = "Star Bite" },
	StarPterodactyl = { Element = "Cosmic", Power = 18, Health = 115, Speed = 120, Basic = "Comet Dive" },
	-- tower-only
	-- Pets added 2026-10-11 (all five zones).
	Puffquill = { Element = "Nature", Power = 10, Health = 105, Speed = 105, Basic = "Fluff Peck" },
	Pebblehorn = { Element = "Earth", Power = 11, Health = 130, Speed = 85, Basic = "Pebble Charge" },
	Mosswhip = { Element = "Nature", Power = 12, Health = 90, Speed = 115, Basic = "Vine Whip" },
	Honeyhoof = { Element = "Earth", Power = 10, Health = 120, Speed = 90, Basic = "Honey Stomp" },
	Bramblebat = { Element = "Nature", Power = 12, Health = 85, Speed = 120, Basic = "Thorn Swoop" },
	Clovercrest = { Element = "Nature", Power = 11, Health = 100, Speed = 110, Basic = "Lucky Talon" },
	SunpetalDrake = { Element = "Nature", Power = 17, Health = 130, Speed = 105, Basic = "Petal Storm" },
	Duskwing = { Element = "Storm", Power = 14, Health = 100, Speed = 115, Basic = "Night Dive" },
	Oakmaw = { Element = "Earth", Power = 15, Health = 150, Speed = 85, Basic = "Log Slam" },
	Thornhoof = { Element = "Nature", Power = 13, Health = 105, Speed = 115, Basic = "Thorn Kick" },
	Vinetail = { Element = "Nature", Power = 14, Health = 100, Speed = 120, Basic = "Vine Lash" },
	Mossback = { Element = "Earth", Power = 15, Health = 140, Speed = 90, Basic = "Moss Crunch" },
	Hollowfang = { Element = "Storm", Power = 15, Health = 100, Speed = 115, Basic = "Hollow Howl" },
	Elderhorn = { Element = "Nature", Power = 19, Health = 150, Speed = 100, Basic = "Spirit Bloom" },
	Frostpaw = { Element = "Ice", Power = 16, Health = 110, Speed = 115, Basic = "Frost Pounce" },
	Yetiboo = { Element = "Ice", Power = 15, Health = 155, Speed = 85, Basic = "Snowball Smash" },
	Shiverclaw = { Element = "Ice", Power = 17, Health = 100, Speed = 120, Basic = "Ice Slash" },
	AuroraHoot = { Element = "Ice", Power = 15, Health = 105, Speed = 110, Basic = "Aurora Beam" },
	Waddlefrost = { Element = "Ice", Power = 14, Health = 125, Speed = 95, Basic = "Belly Slide" },
	Hailwing = { Element = "Storm", Power = 17, Health = 100, Speed = 125, Basic = "Hail Dive" },
	FrostcrownDragon = { Element = "Ice", Power = 20, Health = 140, Speed = 100, Basic = "Crown Blizzard" },
	Cinderpup = { Element = "Fire", Power = 18, Health = 110, Speed = 115, Basic = "Cinder Bite" },
	Magmaw = { Element = "Fire", Power = 19, Health = 135, Speed = 90, Basic = "Magma Chomp" },
	Obsidihorn = { Element = "Earth", Power = 17, Health = 160, Speed = 85, Basic = "Obsidian Ram" },
	Emberclaw = { Element = "Fire", Power = 19, Health = 105, Speed = 120, Basic = "Ember Slash" },
	Ashwing = { Element = "Fire", Power = 18, Health = 105, Speed = 125, Basic = "Ash Cloud" },
	Flarestrut = { Element = "Fire", Power = 17, Health = 115, Speed = 115, Basic = "Flare Kick" },
	InfernalHydra = { Element = "Fire", Power = 22, Health = 150, Speed = 100, Basic = "Triple Blaze" },
	Cometpup = { Element = "Cosmic", Power = 19, Health = 115, Speed = 120, Basic = "Comet Tackle" },
	Moonhoot = { Element = "Cosmic", Power = 18, Health = 110, Speed = 115, Basic = "Moon Beam" },
	Nebuclaw = { Element = "Cosmic", Power = 20, Health = 105, Speed = 125, Basic = "Nebula Slash" },
	LunarTusk = { Element = "Cosmic", Power = 18, Health = 165, Speed = 85, Basic = "Crater Stomp" },
	GalaxyStrut = { Element = "Cosmic", Power = 17, Health = 120, Speed = 115, Basic = "Starlight Kick" },
	Zapstar = { Element = "Storm", Power = 20, Health = 105, Speed = 130, Basic = "Zap Dive" },
	QuasarRex = { Element = "Cosmic", Power = 21, Health = 145, Speed = 90, Basic = "Quasar Chomp" },
	Thornback = { Element = "Nature", Power = 15, Health = 150, Speed = 90, Basic = "Spike Roll" },
	Frostbyte = { Element = "Ice", Power = 17, Health = 120, Speed = 110, Basic = "Snow Pounce" },
	Voltwing = { Element = "Storm", Power = 19, Health = 105, Speed = 125, Basic = "Volt Swoop" },
	Embergeist = { Element = "Fire", Power = 21, Health = 115, Speed = 115, Basic = "Ghost Flame" },
	AstralKitsune = { Element = "Cosmic", Power = 23, Health = 135, Speed = 120, Basic = "Nine-Tail Flash" },
} :: { [string]: Base }
-- Tower-only pets (carter): never in eggs, only dropped by tower bosses. A species drops only from floor
-- `From` up. They join the normal collection once the core game lists them in Config.Minerals (until then
-- no drop is granted). REPLACE: Cube 3D models made on carter's PC.
TowerConfig.TowerPets = {
	{ Id = "Thornback", From = 5, Weight = 40 },
	{ Id = "Frostbyte", From = 10, Weight = 30 },
	{ Id = "Voltwing", From = 15, Weight = 20 },
	{ Id = "Embergeist", From = 20, Weight = 9 },
	{ Id = "AstralKitsune", From = 30, Weight = 1 },
}
TowerConfig.Drop = {
	Chance = 0.08, -- per boss floor clear, plus PerFloor x floor, capped at Max
	PerFloor = 0.002,
	Max = 0.25,
	RarityWeights = { Common = 50, Uncommon = 30, Rare = 14, Epic = 5, Legendary = 1 },
}
-- Pity (audit fix): a boss floor is cleared only once per climb (the run restarts after the last boss), so one plain
-- roll per boss left most tower pets out of reach. Each boss clear without a drop adds PerMiss to the next boss's
-- chance (saved as profile TowerPity), and after GuaranteeAfter misses in a row the next boss always drops. A drop
-- picks a tower pet the player has never had (allowed on that floor) when one is left, each with at least
-- MinNewWeight, so the rare ones are not starved. Aim: a steady climber owns all 5 by about floor 60-80
-- (tests/test_pet_tower.luau simulates it).
TowerConfig.Pity = {
	PerMiss = 0.15,
	GuaranteeAfter = 3,
	MinNewWeight = 10,
}

-- Display names (carter, 2026-10-11).
TowerConfig.PetNames = {
	Puffquill = "Puffquill",
	Pebblehorn = "Pebblehorn",
	Mosswhip = "Mosswhip",
	Honeyhoof = "Honeyhoof",
	Bramblebat = "Bramblebat",
	Clovercrest = "Clovercrest",
	SunpetalDrake = "Sunpetal Drake",
	Duskwing = "Duskwing",
	Oakmaw = "Oakmaw",
	Thornhoof = "Thornhoof",
	Vinetail = "Vinetail",
	Mossback = "Mossback",
	Hollowfang = "Hollowfang",
	Elderhorn = "Elderhorn",
	Frostpaw = "Frostpaw",
	Yetiboo = "Yetiboo",
	Shiverclaw = "Shiverclaw",
	AuroraHoot = "Aurora Hoot",
	Waddlefrost = "Waddlefrost",
	Hailwing = "Hailwing",
	FrostcrownDragon = "Frostcrown Dragon",
	Cinderpup = "Cinderpup",
	Magmaw = "Magmaw",
	Obsidihorn = "Obsidihorn",
	Emberclaw = "Emberclaw",
	Ashwing = "Ashwing",
	Flarestrut = "Flarestrut",
	InfernalHydra = "Infernal Hydra",
	Cometpup = "Cometpup",
	Moonhoot = "Moonhoot",
	Nebuclaw = "Nebuclaw",
	LunarTusk = "Lunar Tusk",
	GalaxyStrut = "Galaxy Strut",
	Zapstar = "Zapstar",
	QuasarRex = "Quasar Rex",
	Raptor = "Razorclaw",
	Ostrich = "Thunderstrut",
	DireWolf = "Shadowfang",
	Griffin = "Stormtalon",
	FrostWyvern = "Glacier Wyrm",
	Mammoth = "Titan Tusk",
	LavaTRex = "Inferno Rex",
	Phoenix = "Solar Phoenix",
	CosmicDragon = "Void Dragon",
	StarPterodactyl = "Nova Ptera",
	Thornback = "Thornback",
	Frostbyte = "Frostbyte",
	Voltwing = "Voltwing",
	Embergeist = "Embergeist",
	AstralKitsune = "Astral Kitsune",
} :: { [string]: string }

-- Any species not listed (old saves, new pets added later) fights with these.
TowerConfig.DefaultSpecies = { Element = "Earth", Power = 12, Health = 100, Speed = 100, Basic = "Bonk" } :: Base

-- Pokemon-style types. Each beats the next one in the circle (x1.5) and is weak to the one before it (x0.75).
-- Cosmic sits outside the circle: x1.25 against every other type, x1 against Cosmic.
TowerConfig.TypeCircle = { "Fire", "Nature", "Earth", "Storm", "Ice" }
TowerConfig.Strong, TowerConfig.Weak, TowerConfig.CosmicBonus = 1.5, 0.75, 1.25
-- Second attack: every pet rolls one move of its own type on hatch. Mult x Power per hit; Slow = longer wait after it.
TowerConfig.TypeMoves = {
	Fire = { { Name = "Ember", Mult = 1.4, Slow = 1.3 }, { Name = "Flame Burst", Mult = 1.6, Slow = 1.5 }, { Name = "Heat Wave", Mult = 1.8, Slow = 1.7 } },
	Nature = { { Name = "Vine Whip", Mult = 1.4, Slow = 1.3 }, { Name = "Leaf Blade", Mult = 1.6, Slow = 1.5 }, { Name = "Thorn Storm", Mult = 1.8, Slow = 1.7 } },
	Earth = { { Name = "Mud Toss", Mult = 1.4, Slow = 1.3 }, { Name = "Quake", Mult = 1.6, Slow = 1.5 }, { Name = "Mega Stomp", Mult = 1.8, Slow = 1.7 } },
	Storm = { { Name = "Spark", Mult = 1.4, Slow = 1.3 }, { Name = "Gust", Mult = 1.6, Slow = 1.5 }, { Name = "Thunder", Mult = 1.8, Slow = 1.7 } },
	Ice = { { Name = "Ice Shard", Mult = 1.4, Slow = 1.3 }, { Name = "Frost Fang", Mult = 1.6, Slow = 1.5 }, { Name = "Blizzard", Mult = 1.8, Slow = 1.7 } },
	Cosmic = { { Name = "Star Spark", Mult = 1.4, Slow = 1.3 }, { Name = "Moon Beam", Mult = 1.6, Slow = 1.5 }, { Name = "Meteor", Mult = 1.8, Slow = 1.7 } },
} :: { [string]: { { Name: string, Mult: number, Slow: number } } }

TowerConfig.Rarities = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }
TowerConfig.RarityStat = { Common = 1, Uncommon = 1.2, Rare = 1.45, Epic = 1.75, Legendary = 2.2 } :: { [string]: number }
-- carter: Golden 1.5x, Rainbow 2x. Skeleton and Silver Cosmic are rarer, so they sit just above their neighbours.
TowerConfig.VariantStat = { Natural = 1, Golden = 1.5, Skeleton = 1.75, Rainbow = 2, SilverCosmic = 2.5 } :: { [string]: number }
TowerConfig.RollMin = 0.8
TowerConfig.RollMax = 1.2
-- Grade from the average of the three rolls, mapped to 0..1. Below B is C.
TowerConfig.Grades = { { Grade = "S", Min = 0.85 }, { Grade = "A", Min = 0.6 }, { Grade = "B", Min = 0.3 } }

-- Specials match the pet's type (Fire Puff only on Fire pets, and so on); ones with no Element suit any type.
-- Every circle type has a MinRarity 1 special; a Common Cosmic pet gets the lowest any-type one (PetStats.roll).
TowerConfig.Specials = {
	{ Id = "FirePuff", Name = "Fire Puff", Kind = "Burn", Value = 0.6, MinRarity = 1, Element = "Fire" }, -- burn: Value x Power per second, 4 s
	{ Id = "IceBreath", Name = "Ice Breath", Kind = "Slow", Value = 4, MinRarity = 1, Element = "Ice" }, -- all mobs attack at half speed for Value s
	{ Id = "Zap", Name = "Zap", Kind = "Chain", Value = 2, MinRarity = 1, Element = "Storm" }, -- Value x Power to up to 3 mobs
	{ Id = "HealSong", Name = "Heal Song", Kind = "Heal", Value = 0.35, MinRarity = 1, Element = "Nature" }, -- heals every team pet by Value x max health
	{ Id = "Shield", Name = "Bubble Shield", Kind = "Shield", Value = 0.4, MinRarity = 2 }, -- each pet gets Value x max health shield
	{ Id = "BigStomp", Name = "Big Stomp", Kind = "Stomp", Value = 2.5, MinRarity = 1, Element = "Earth" }, -- Value x Power to every mob
	{ Id = "DashStrike", Name = "Dash Strike", Kind = "Dash", Value = 6, MinRarity = 3 }, -- Value x Power to the front mob
	{ Id = "LuckyHit", Name = "Lucky Hit", Kind = "Crit", Value = 8, MinRarity = 4 }, -- Value x Power, one mob, at random
} :: { Special }

TowerConfig.Mobs = {
	Slime = { Id = "Slime", Element = "Nature", Name = "Slime", Health = 45, Power = 4, Speed = 80, Boss = false },
	Beetle = { Id = "Beetle", Element = "Earth", Name = "Grumpy Beetle", Health = 60, Power = 5, Speed = 90, Boss = false },
	Mushroom = { Id = "Mushroom", Element = "Nature", Name = "Mushroom Hopper", Health = 50, Power = 6, Speed = 100, Boss = false },
	Snail = { Id = "Snail", Element = "Earth", Name = "Thorn Snail", Health = 90, Power = 5, Speed = 60, Boss = false },
	Crab = { Id = "Crab", Element = "Ice", Name = "Snappy Crab", Health = 80, Power = 7, Speed = 85, Boss = false },
	Ghost = { Id = "Ghost", Element = "Storm", Name = "Ghost Puff", Health = 55, Power = 8, Speed = 110, Boss = false },
	-- Bosses (carter): giant, angry versions of the pets. Pet = species model to scale up, tint red, glowing eyes.
	BossRaptor = { Id = "BossRaptor", Element = "Nature", Name = "Angry Razorclaw", Pet = "Raptor", Health = 380, Power = 9, Speed = 80, Boss = true },
	BossDireWolf = { Id = "BossDireWolf", Element = "Storm", Name = "Angry Shadowfang", Pet = "DireWolf", Health = 420, Power = 10, Speed = 80, Boss = true },
	BossMammoth = { Id = "BossMammoth", Element = "Earth", Name = "Angry Titan Tusk", Pet = "Mammoth", Health = 520, Power = 10, Speed = 60, Boss = true },
	BossGriffin = { Id = "BossGriffin", Element = "Storm", Name = "Angry Stormtalon", Pet = "Griffin", Health = 400, Power = 12, Speed = 95, Boss = true },
	BossFrostWyvern = { Id = "BossFrostWyvern", Element = "Ice", Name = "Angry Glacier Wyrm", Pet = "FrostWyvern", Health = 450, Power = 13, Speed = 90, Boss = true },
	BossLavaTRex = { Id = "BossLavaTRex", Element = "Fire", Name = "Angry Inferno Rex", Pet = "LavaTRex", Health = 600, Power = 14, Speed = 85, Boss = true },
} :: { [string]: Mob }
-- Which normal mobs appear on floors 1-5, 6-10, ... and the boss at the end of each band.
TowerConfig.Bands = {
	{ Mobs = { "Slime", "Beetle" }, Boss = "BossRaptor" },
	{ Mobs = { "Beetle", "Mushroom", "Snail" }, Boss = "BossDireWolf" },
	{ Mobs = { "Snail", "Crab", "Mushroom" }, Boss = "BossMammoth" },
	{ Mobs = { "Crab", "Ghost", "Mushroom" }, Boss = "BossGriffin" },
	{ Mobs = { "Ghost", "Crab", "Snail" }, Boss = "BossFrostWyvern" },
	{ Mobs = { "Ghost", "Crab", "Beetle" }, Boss = "BossLavaTRex" },
}

-- Endless (carter): floors never run out, mobs keep getting tougher; the board ranks the highest floor.
-- Bands repeat after the last one, stats keep growing.
-- Floor look (carter): changes every ThemeEvery floors, jungle -> lava -> ice -> space, then loops.
TowerConfig.ThemeEvery = 10
-- The first wave of a new theme (floors 1, 11, 21, ...) waits this long before the pets fight, so the theme title pill
-- ("JUNGLE · FLOORS 1-10", TowerFx.titleCard: 1.6 s + fade) is gone before the first hit (Studio 2026-10-14: it sat
-- over the pets while they fought). The client also takes it down at the first hit.
TowerConfig.TitleHold = 2.2
TowerConfig.Themes = {
	{ Id = "Jungle", Name = "Jungle", Floor = Color3.fromRGB(120, 180, 90), Ring = Color3.fromRGB(150, 110, 70), Pillar = Color3.fromRGB(176, 170, 150), Cap = Color3.fromRGB(96, 172, 84), Glow = Color3.fromRGB(170, 240, 120) },
	{ Id = "Lava", Name = "Lava", Floor = Color3.fromRGB(140, 94, 70), Ring = Color3.fromRGB(255, 110, 40), Pillar = Color3.fromRGB(150, 70, 44), Cap = Color3.fromRGB(255, 140, 50), Glow = Color3.fromRGB(255, 90, 30) },
	{ Id = "Ice", Name = "Ice", Floor = Color3.fromRGB(215, 240, 255), Ring = Color3.fromRGB(140, 200, 255), Pillar = Color3.fromRGB(170, 215, 245), Cap = Color3.fromRGB(240, 250, 255), Glow = Color3.fromRGB(150, 230, 255) },
	{ Id = "Space", Name = "Space", Floor = Color3.fromRGB(58, 48, 110), Ring = Color3.fromRGB(190, 120, 255), Pillar = Color3.fromRGB(84, 66, 150), Cap = Color3.fromRGB(255, 230, 120), Glow = Color3.fromRGB(200, 160, 255) },
}
TowerConfig.BossEvery = 5 -- floors 5, 10, ... are boss floors; they are also checkpoints
TowerConfig.FloorGrowth = 0.16 -- mob health and power grow by this much per floor
TowerConfig.PartyHealthPerPlayer = 0.6 -- extra mob health per extra player (rules support parties; tower is solo)
TowerConfig.TeamSize = 3 -- pets per player
TowerConfig.MaxPlayers = 1 -- solo (carter)

-- Pet levels from tower XP (carter). Level L -> L+1 costs XpBase + XpStep * (L - 1). Each level adds LevelStat
-- to Power and Health (Speed a quarter of that). XP is saved per pet; leaving keeps what was earned.
-- LevelStat 0.14 (carter 2026-10-14): a maxed Common (Lv 10, x2.26) slightly beats a fresh Legendary (x2.2); a maxed
-- Legendary (Lv 50) still wins by far.
TowerConfig.Levels = { XpBase = 40, XpStep = 25, Max = 100, LevelStat = 0.14 }
-- Rarity sets how high a pet can grow (carter 2026-10-14): training stops at the cap. Species in CapSpecies override
-- (Void Dragon, the 1/1000 pet, can reach 100). Uncommon sits between Common and Rare.
TowerConfig.LevelCaps = { Common = 10, Uncommon = 15, Rare = 20, Epic = 30, Legendary = 50 } :: { [string]: number }
TowerConfig.CapSpecies = { CosmicDragon = 100 } :: { [string]: number }
-- Only pets of this rarity or rarer (index into Rarities) bring a SPECIAL to a Pet Battle (carter 2026-10-14).
TowerConfig.SpecialMinRarity = 4 -- Epic
-- EVOLVE (carter 2026-10-14): a pet at its level cap merges with Copies - 1 other copies of the same species and rarity
-- (at the same stage) into its next stage, up to MaxStage. Each stage raises the cap by CapBonus levels, multiplies
-- every stat by (1 + StatBonus * stage) and draws the pet Scale bigger per stage with a glow (PetModel).
-- Enabled: carter 2026-10-16 "remove evolution 4 now": EVOLVE is off (no button, server refuses). Pets that already
-- evolved keep their stars and bonuses.
TowerConfig.Evolve = { Enabled = false, MaxStage = 2, Copies = 3, CapBonus = 10, StatBonus = 0.2, Scale = 0.15 }
TowerConfig.Xp = { PerFloor = 20, FloorStep = 4, LossShare = 0.5 } -- floor f clear: PerFloor + FloorStep * f to each team pet

-- Revive after a loss (carter picked Robux revive, 2026-10-11): pets come back at Health of max, mobs keep theirs.
-- ProductId = the Developer Product carter made on the Creator Dashboard (0 would turn revive off).
-- At most MaxPaid revives per climb so the floor board can't be bought outright.
TowerConfig.Revive = { Health = 0.5, Free = 0, MaxPaid = 3, ProductId = 3717828140 } -- carter's "Tower Revive" product (2026-10-11)
TowerConfig.SpecialCharge = 100 -- damage a player's pets must deal to fill the SPECIAL button
TowerConfig.FloorTimeLimit = 90 -- seconds; running out ends the run (rewards so far are kept)
TowerConfig.Tick = 0.1 -- server fight step in seconds

TowerConfig.Rewards = {
	CoinsPerFloor = 15, -- x floor number
	BossCoins = 150, -- x boss band number, on top
}

return TowerConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="201">
        <Properties>
          <string name="Name">TowerPropSlots</string>
          <string name="Source"><![CDATA[--!strict
-- Where the tower rooms' theme props stand (pure, tested in tests/test_tower_prop_slots.luau): one prop in each wall span
-- between the side doors, on the east and west walls. Side doors sit at 0 and +-TILE along the wall and are about 6.2
-- studs half-wide, so a prop centred at +-TILE/2 may be at most (TILE/2 - DoorHalf) * 2 wide before it blocks a door.
local TowerPropSlots = {}

TowerPropSlots.Room = 48 -- half width of the kit room: 3 x 3 floor tiles
TowerPropSlots.Tile = 32
TowerPropSlots.DoorHalf = 6.2 -- half width of a side door opening
TowerPropSlots.MaxWidth = 7 -- studs: no theme prop wider than this (big pines clipped the walls)
TowerPropSlots.TreeWidth = 14 -- trees keep their height (a squashed pine reads as a blob); 14 still clears both doors
TowerPropSlots.Alongs = { -0.5, 0.5 } -- slot centres along each wall, in tiles
TowerPropSlots.DoorAlongs = { -1, 0, 1 } -- door centres along each wall, in tiles

-- Uniform scale for a mesh of `size` that should be `height` tall, capped so its wider side stays within the width cap.
function TowerPropSlots.scale(sizeX: number, sizeY: number, sizeZ: number, height: number, tree: boolean): number
	local cap = if tree then TowerPropSlots.TreeWidth else TowerPropSlots.MaxWidth
	return math.min(height / sizeY, cap / math.max(sizeX, sizeZ))
end

-- Half the footprint of a scaled prop (its wider side), as the builder insets it.
function TowerPropSlots.half(sizeX: number, sizeZ: number): number
	return 0.5 * math.max(sizeX, sizeZ)
end

-- Local (x, z) of slot `along` (-0.5 / 0.5) on wall side `sx` (-1 west, 1 east) for a prop of half-footprint `half`.
function TowerPropSlots.position(sx: number, along: number, half: number): (number, number)
	return sx * (TowerPropSlots.Room - 2 - half), along * TowerPropSlots.Tile
end

-- Gap between the prop's footprint edge along the wall and the nearest door opening.
function TowerPropSlots.doorGap(along: number, half: number): number
	local best = math.huge
	for _, d in TowerPropSlots.DoorAlongs do
		best = math.min(best, math.abs(along - d) * TowerPropSlots.Tile - half - TowerPropSlots.DoorHalf)
	end
	return best
end

return TowerPropSlots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="202">
        <Properties>
          <string name="Name">TowerRules</string>
          <string name="Source"><![CDATA[--!strict
-- Pet Tower fight rules (pure, deterministic, tested in tests/test_pet_tower.luau).
-- The server steps this; clients only see the events it returns. Pets attack on their own; each player can fire
-- their team's SPECIAL when their meter is full. A fainted pet stays fainted for the rest of the run.

local TowerConfig = require(script.Parent.TowerConfig)
local PetStats = require(script.Parent.PetStats)

local TowerRules = {}

export type Unit = {
	Id: string,
	Owner: number, -- player UserId for pets, 0 for mobs
	Kind: string, -- species id or mob id
	Name: string,
	Max: number,
	Hp: number,
	Power: number,
	Speed: number,
	Cd: number, -- seconds until the next attack
	Shield: number,
	BurnDps: number,
	BurnLeft: number,
	Special: string?,
	Boss: boolean,
	Element: string,
	MoveMult: number, -- second attack (1 for mobs = no second attack)
	MoveSlow: number,
	Swing: number, -- attack counter; pets alternate basic attack and type move
}
export type Event = { Kind: string, From: string?, To: string?, Amount: number?, Owner: number?, Id: string? }
export type Run = {
	Floor: number,
	Wave: number,
	Waves: { { string } },
	Players: number,
	Pets: { Unit },
	Mobs: { Unit },
	Meters: { [number]: number },
	SlowLeft: number,
	FloorTime: number,
	State: string, -- "Fighting" | "Cleared" | "Lost"
	MobSerial: number,
}
export type TeamPet = { Owner: number, Id: string, Name: string?, Xp: number?, Pet: { Mineral: string, Rarity: string, Modifier: string?, Seed: number } }

function TowerRules.isBoss(floor: number): boolean
	return floor % TowerConfig.BossEvery == 0
end

-- Theme of a floor: jungle 1-10, lava 11-20, ice 21-30, space 31-40, then loops.
function TowerRules.theme(floor: number)
	local n = math.max(math.ceil(floor / TowerConfig.ThemeEvery), 1)
	return TowerConfig.Themes[(n - 1) % #TowerConfig.Themes + 1]
end

-- Seconds the fight waits before it starts on this floor and wave: only the first wave of a new theme (its title
-- pill shows first, then the pets fight); every other wave starts at once.
function TowerRules.introHold(floor: number, wave: number): number
	if wave == 1 and (floor - 1) % TowerConfig.ThemeEvery == 0 then
		return TowerConfig.TitleHold
	end
	return 0
end

-- Bands repeat (endless tower); the returned index keeps counting so boss rewards keep growing.
function TowerRules.band(floor: number)
	local n = math.max(math.ceil(floor / TowerConfig.BossEvery), 1)
	return TowerConfig.Bands[(n - 1) % #TowerConfig.Bands + 1], n
end

-- The checkpoint a player restarts from after reaching `best` (floor 1, 6, 11, ...).
function TowerRules.checkpoint(best: number): number
	local cleared = math.max(math.floor(best), 0)
	return math.floor(cleared / TowerConfig.BossEvery) * TowerConfig.BossEvery + 1
end

-- Mob ids per wave. Deterministic by floor so every run of a floor is the same puzzle.
function TowerRules.waves(floor: number): { { string } }
	local band = TowerRules.band(floor)
	local within = (floor - 1) % TowerConfig.BossEvery + 1 -- 1..5
	local out = {}
	if TowerRules.isBoss(floor) then
		table.insert(out, { band.Mobs[1], band.Mobs[2] })
		table.insert(out, { band.Boss })
		return out
	end
	local waveCount = if within <= 2 then 1 elseif within <= 3 then 2 else 3
	for w = 1, waveCount do
		local wave = {}
		local size = math.min(1 + math.floor((within + w) / 2), 4)
		for m = 1, size do
			table.insert(wave, band.Mobs[(floor + w + m) % #band.Mobs + 1])
		end
		table.insert(out, wave)
	end
	return out
end

function TowerRules.mobStats(mobId: string, floor: number, players: number): (number, number, number)
	local mob = TowerConfig.Mobs[mobId]
	assert(mob, "unknown mob " .. mobId)
	local grow = 1 + TowerConfig.FloorGrowth * (floor - 1)
	local party = 1 + TowerConfig.PartyHealthPerPlayer * (math.clamp(players, 1, TowerConfig.MaxPlayers) - 1)
	return math.floor(mob.Health * grow * party + 0.5), math.floor(mob.Power * grow * 10 + 0.5) / 10, mob.Speed
end

function TowerRules.reward(floor: number): number
	local coins = TowerConfig.Rewards.CoinsPerFloor * floor
	if TowerRules.isBoss(floor) then
		local _, bandIndex = TowerRules.band(floor)
		coins += TowerConfig.Rewards.BossCoins * bandIndex
	end
	return coins
end

-- XP each team pet earns for clearing `floor` (a loss earns LossShare of it).
function TowerRules.xp(floor: number, cleared: boolean): number
	local x = TowerConfig.Xp.PerFloor + TowerConfig.Xp.FloorStep * floor
	return if cleared then x else math.floor(x * TowerConfig.Xp.LossShare)
end

-- Boss drop chance on a boss floor clear (0 elsewhere) and which tower-only pet a 0..1 pick lands on.
-- `misses` = boss clears in a row without a drop (profile TowerPity): each adds Pity.PerMiss, and after
-- Pity.GuaranteeAfter misses the drop is certain.
function TowerRules.dropChance(floor: number, misses: number?): number
	if not TowerRules.isBoss(floor) then
		return 0
	end
	local d = TowerConfig.Drop
	local base = math.min(d.Chance + d.PerFloor * floor, d.Max)
	local m = math.max(math.floor(tonumber(misses) or 0), 0)
	if m >= TowerConfig.Pity.GuaranteeAfter then
		return 1
	end
	return math.min(base + TowerConfig.Pity.PerMiss * m, 1)
end

-- The pity counter after a boss clear: back to 0 on a drop, +1 on a miss.
function TowerRules.pityAfter(misses: number?, dropped: boolean): number
	if dropped then
		return 0
	end
	return math.max(math.floor(tonumber(misses) or 0), 0) + 1
end

-- `owned` (species -> truthy, e.g. the discovery index) favours tower pets the player never had: when any pet
-- allowed on this floor is new, only new ones can drop (each weighs at least Pity.MinNewWeight).
function TowerRules.dropSpecies(floor: number, pick: number, owned: { [string]: any }?): string?
	local function isNew(id: string): boolean
		local v = owned and owned[id]
		return not (v == true or (type(v) == "number" and v > 0))
	end
	local onlyNew = false
	if owned then
		for _, tp in TowerConfig.TowerPets do
			if floor >= tp.From and isNew(tp.Id) then
				onlyNew = true
				break
			end
		end
	end
	local function weight(tp): number
		if floor < tp.From then
			return 0
		end
		if onlyNew then
			return if isNew(tp.Id) then math.max(tp.Weight, TowerConfig.Pity.MinNewWeight) else 0
		end
		return tp.Weight
	end
	local total = 0
	for _, tp in TowerConfig.TowerPets do
		total += weight(tp)
	end
	if total <= 0 then
		return nil
	end
	local roll = math.clamp(pick, 0, 0.999999) * total
	for _, tp in TowerConfig.TowerPets do
		local w = weight(tp)
		if w > 0 then
			roll -= w
			if roll < 0 then
				return tp.Id
			end
		end
	end
	return nil
end

-- The zone a tower drop is priced in: the player's best unlocked zone (`order` = zone ids from first to last,
-- `unlocked` = zone id -> true), so a drop is never worth more than a hunt pet the player can already find.
function TowerRules.dropTier(order: { string }, unlocked: { [string]: any }?): string
	local tier = order[1]
	if type(unlocked) == "table" then
		for _, id in order do
			if unlocked[id] then
				tier = id
			end
		end
	end
	return tier
end

-- Brings a lost floor back: every team pet returns at Revive.Health of max, the timer restarts, mobs keep theirs.
function TowerRules.revive(run: Run): boolean
	if run.State ~= "Lost" or #run.Pets == 0 or #run.Mobs == 0 then
		return false
	end
	for _, p in run.Pets do
		p.Hp = math.max(p.Hp, math.floor(p.Max * TowerConfig.Revive.Health + 0.5))
		p.Shield = 0
	end
	run.FloorTime = 0
	run.State = "Fighting"
	return true
end

local function spawnWave(run: Run)
	run.Mobs = {}
	for _, mobId in run.Waves[run.Wave] do
		local hp, power, speed = TowerRules.mobStats(mobId, run.Floor, run.Players)
		run.MobSerial += 1
		table.insert(run.Mobs, {
			Id = "m" .. run.MobSerial,
			Owner = 0,
			Kind = mobId,
			Name = TowerConfig.Mobs[mobId].Name,
			Max = hp,
			Hp = hp,
			Power = power,
			Speed = speed,
			Cd = 0.6 + 0.15 * #run.Mobs, -- stagger the first hits
			Shield = 0,
			BurnDps = 0,
			BurnLeft = 0,
			Special = nil,
			Boss = TowerConfig.Mobs[mobId].Boss,
			Element = TowerConfig.Mobs[mobId].Element,
			MoveMult = 1,
			MoveSlow = 1,
			Swing = 0,
		})
	end
end

-- Builds a run from the players' chosen pets (at most TeamSize per player, MaxPlayers players).
function TowerRules.newRun(team: { TeamPet }, floor: number): Run
	local pets: { Unit } = {}
	local perOwner: { [number]: number } = {}
	local owners = 0
	for _, tp in team do
		local n = perOwner[tp.Owner]
		if n == nil then
			if owners >= TowerConfig.MaxPlayers then
				continue
			end
			owners += 1
			n = 0
		end
		if n >= TowerConfig.TeamSize then
			continue
		end
		perOwner[tp.Owner] = n + 1
		local s = PetStats.roll(tp.Pet, tp.Xp)
		table.insert(pets, {
			Id = tp.Id,
			Owner = tp.Owner,
			Kind = tp.Pet.Mineral,
			Name = tp.Name or tp.Pet.Mineral,
			Max = s.Health,
			Hp = s.Health,
			Power = s.Power,
			Speed = s.Speed,
			Cd = 0.3 + 0.1 * #pets,
			Shield = 0,
			BurnDps = 0,
			BurnLeft = 0,
			Special = s.Special,
			Boss = false,
			Element = s.Element,
			MoveMult = s.MoveMult,
			MoveSlow = s.MoveSlow,
			Swing = 0,
		})
	end
	local meters = {}
	for owner in perOwner do
		meters[owner] = 0
	end
	local run: Run = {
		Floor = 0,
		Wave = 0,
		Waves = {},
		Players = math.max(owners, 1),
		Pets = pets,
		Mobs = {},
		Meters = meters,
		SlowLeft = 0,
		FloorTime = 0,
		State = "Lost",
		MobSerial = 0,
	}
	if #pets > 0 then
		TowerRules.startFloor(run, floor)
	end
	return run
end

-- Next floor of the same run: fainted pets stay fainted, the rest keep their health.
function TowerRules.startFloor(run: Run, floor: number)
	run.Floor = math.max(math.floor(floor), 1)
	run.Waves = TowerRules.waves(run.Floor)
	run.Wave = 1
	run.FloorTime = 0
	run.SlowLeft = 0
	run.State = "Fighting"
	spawnWave(run)
end

local function alive(list: { Unit }): { Unit }
	local out = {}
	for _, u in list do
		if u.Hp > 0 then
			table.insert(out, u)
		end
	end
	return out
end

local function hurt(target: Unit, amount: number, from: string, events: { Event }, element: string?): number
	local eff = if element then PetStats.effect(element, target.Element) else 1
	local dmg = math.max(math.floor(amount * eff + 0.5), 1)
	local absorbed = math.min(target.Shield, dmg)
	target.Shield -= absorbed
	local real = math.min(dmg - absorbed, target.Hp)
	target.Hp -= real
	-- Id carries the type result so clients can pop "Super hit!" / "Weak..." like Pokemon.
	local note = if eff > 1 then "Strong" elseif eff < 1 then "Weak" else nil
	table.insert(events, { Kind = "Hit", From = from, To = target.Id, Amount = dmg, Id = note })
	if target.Hp <= 0 then
		table.insert(events, { Kind = "Faint", To = target.Id })
	end
	return real
end

local function charge(run: Run, owner: number, dealt: number)
	if run.Meters[owner] ~= nil then
		run.Meters[owner] = math.min(run.Meters[owner] + dealt, TowerConfig.SpecialCharge)
	end
end

local function settle(run: Run, events: { Event })
	if #alive(run.Pets) == 0 then
		run.State = "Lost"
		table.insert(events, { Kind = "Lost" })
	elseif #alive(run.Mobs) == 0 then
		if run.Wave < #run.Waves then
			run.Wave += 1
			spawnWave(run)
			table.insert(events, { Kind = "Wave", Amount = run.Wave })
		else
			run.State = "Cleared"
			table.insert(events, { Kind = "Cleared", Amount = run.Floor })
		end
	end
end

function TowerRules.step(run: Run, dt: number): { Event }
	local events: { Event } = {}
	if run.State ~= "Fighting" then
		return events
	end
	run.FloorTime += dt
	if run.FloorTime >= TowerConfig.FloorTimeLimit then
		run.State = "Lost"
		table.insert(events, { Kind = "Lost", Id = "Time" })
		return events
	end
	run.SlowLeft = math.max(run.SlowLeft - dt, 0)

	for _, m in alive(run.Mobs) do
		if m.BurnLeft > 0 then
			local tick = math.min(dt, m.BurnLeft)
			m.BurnLeft -= tick
			m.Hp = math.max(m.Hp - m.BurnDps * tick, 0)
			if m.Hp <= 0 then
				table.insert(events, { Kind = "Faint", To = m.Id })
			end
		end
	end

	for _, p in alive(run.Pets) do
		p.Cd -= dt
		if p.Cd <= 0 then
			local target = alive(run.Mobs)[1]
			if target == nil then
				break
			end
			p.Swing += 1
			local useMove = p.Swing % 2 == 0
			p.Cd += 100 / p.Speed * (if useMove then p.MoveSlow else 1)
			local amount = p.Power * (if useMove then p.MoveMult else 1)
			charge(run, p.Owner, hurt(target, amount, p.Id, events, p.Element))
		end
	end

	local mobRate = if run.SlowLeft > 0 then 0.5 else 1
	for i, m in alive(run.Mobs) do
		m.Cd -= dt * mobRate
		if m.Cd <= 0 then
			local pets = alive(run.Pets)
			if #pets == 0 then
				break
			end
			m.Cd += 100 / m.Speed
			-- Bosses go for the strongest pet; normal mobs spread out across the team.
			local target = pets[(i - 1) % #pets + 1]
			if m.Boss then
				for _, p in pets do
					if p.Hp > target.Hp then
						target = p
					end
				end
			end
			hurt(target, m.Power, m.Id, events, m.Element)
		end
	end

	settle(run, events)
	return events
end

function TowerRules.meterFull(run: Run, owner: number): boolean
	return (run.Meters[owner] or 0) >= TowerConfig.SpecialCharge
end

-- Fires the owner's SPECIAL with their strongest living pet's special. `pick` (0..1) only matters for Lucky Hit.
function TowerRules.useSpecial(run: Run, owner: number, pick: number?): (boolean, { Event })
	local events: { Event } = {}
	if run.State ~= "Fighting" or not TowerRules.meterFull(run, owner) then
		return false, events
	end
	local caster: Unit? = nil
	for _, p in alive(run.Pets) do
		if p.Owner == owner and (caster == nil or p.Power > caster.Power) then
			caster = p
		end
	end
	if caster == nil or caster.Special == nil then
		return false, events
	end
	local sp = PetStats.special(caster.Special)
	if sp == nil then
		return false, events
	end
	run.Meters[owner] = 0
	table.insert(events, { Kind = "Special", Owner = owner, From = caster.Id, Id = sp.Id })
	local mobs = alive(run.Mobs)
	local power = caster.Power
	if sp.Kind == "Burn" then
		for _, m in mobs do
			m.BurnDps, m.BurnLeft = sp.Value * power, 4
		end
	elseif sp.Kind == "Slow" then
		run.SlowLeft = sp.Value
	elseif sp.Kind == "Chain" then
		for i = 1, math.min(3, #mobs) do
			hurt(mobs[i], sp.Value * power, caster.Id, events, caster.Element)
		end
	elseif sp.Kind == "Heal" then
		for _, p in alive(run.Pets) do
			p.Hp = math.min(p.Max, p.Hp + math.floor(p.Max * sp.Value + 0.5))
		end
	elseif sp.Kind == "Shield" then
		for _, p in alive(run.Pets) do
			p.Shield = math.max(p.Shield, math.floor(p.Max * sp.Value + 0.5))
		end
	elseif sp.Kind == "Stomp" then
		for _, m in mobs do
			hurt(m, sp.Value * power, caster.Id, events, caster.Element)
		end
	elseif sp.Kind == "Dash" then
		if mobs[1] then
			hurt(mobs[1], sp.Value * power, caster.Id, events, caster.Element)
		end
	elseif sp.Kind == "Crit" then
		if #mobs > 0 then
			local i = math.clamp(math.floor((pick or 0) * #mobs) + 1, 1, #mobs)
			hurt(mobs[i], sp.Value * power, caster.Id, events, caster.Element)
		end
	end
	settle(run, events)
	return true, events
end

-- Plays a floor to the end with specials fired as soon as they are ready (tests and balance checks).
function TowerRules.simulate(run: Run, maxSeconds: number?): string
	local t = 0
	local limit = maxSeconds or TowerConfig.FloorTimeLimit + 1
	while run.State == "Fighting" and t < limit do
		TowerRules.step(run, TowerConfig.Tick)
		for owner in run.Meters do
			TowerRules.useSpecial(run, owner, 0.5)
		end
		t += TowerConfig.Tick
	end
	return run.State
end

return TowerRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="203">
        <Properties>
          <string name="Name">TreeBoard</string>
          <string name="Source"><![CDATA[--!strict
-- Leaderboard tree (owner pick 2026-10-14): a giant tree in the lobby centre; the top players by best pet POWER
-- (Boards "Power", the Pet Book's POWER, PetStats.powerOfPet) show that pet as a live model on a branch with a glowing
-- name / power sign. Pure rules here (tested, tests/test_tree_board.luau); the server part is server/TreeBoardService.
--
-- The best pet of each ranked player is saved as a small "card" (public look only) in a plain DataStore, keyed by
-- UserId, so every server can draw the pets of players who are offline. Cards from the store are re-checked here.

local Config = require(script.Parent.Config)
local PetStats = require(script.Parent.PetStats)

local TreeBoard = {}

TreeBoard.Config = {
	Enabled = false, -- carter 2026-10-15: the leaderboard tree is gone (shop square in the middle); top pets by POWER show on the RarestPetBoard
	Branches = 10, -- pets on the tree (rank 1 .. Branches); branch attachments Branch1..N, Branch1 = the top
	Store = "CTR_TreePets", -- DataStore of best-pet cards ("_Studio" suffix in Studio)
	CardWriteSeconds = 120, -- at most one card write per player in this time (and only when it changed)
	CardCacheSeconds = 180, -- cards of other servers' players are re-read after this
	RefreshSeconds = 120, -- the tree redraws at most this often (the board itself refreshes every minute)
	PetHeight = { First = 7, Top3 = 5.5, Rest = 4.2 }, -- studs
	SignColor = { First = Color3.fromRGB(255, 206, 64), Top3 = Color3.fromRGB(150, 220, 255), Rest = Color3.fromRGB(240, 240, 240) },
	Pad = "BattlePad", -- part in the tree model that becomes a BATTLE pad (PvpService: attribute PvpPad)
	Spot = "LeaderboardTreeSpot", -- where a tree from ServerStorage is placed when the map has none
	Model = "LeaderboardTree",
	NameMax = 20,
}

export type Card = {
	Mineral: string,
	Rarity: string,
	Modifier: string,
	Formation: string?,
	Seed: number,
	Mass: number,
	Power: number,
	Nickname: string?,
}

local function num(v: any): number?
	return if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then v else nil
end

-- The player's strongest pet and its POWER (tower XP from data.TowerXP), or nil when they have none.
function TreeBoard.bestPet(data: any): (any?, number)
	if type(data) ~= "table" or type(data.InventoryGeodes) ~= "table" then
		return nil, 0
	end
	local xpBook = if type(data.TowerXP) == "table" then data.TowerXP else {}
	local best, bestPower = nil, 0
	for _, g in data.InventoryGeodes do
		if type(g) == "table" then
			local xp = num(xpBook[g.Id])
			local p = PetStats.powerOfPet(g, xp or 0)
			if p > bestPower then
				best, bestPower = g, p
			end
		end
	end
	return best, bestPower
end

-- A card (look + power only) from a pet, or a stored card checked again. Nil when anything is off.
function TreeBoard.card(pet: any, power: any): Card?
	if type(pet) ~= "table" then
		return nil
	end
	local mineral, rarity = pet.Mineral, pet.Rarity
	local seed, p = num(pet.Seed), num(power)
	if type(mineral) ~= "string" or not (Config.Minerals :: any)[mineral] or type(rarity) ~= "string" or not table.find(Config.Rarities, rarity) then
		return nil
	end
	if not seed or not p or p <= 0 then
		return nil
	end
	local modifier = if type(pet.Modifier) == "string" and table.find(Config.Modifiers, pet.Modifier) then pet.Modifier else "Natural"
	local nick = if type(pet.Nickname) == "string" and #pet.Nickname > 0 then string.sub(pet.Nickname, 1, TreeBoard.Config.NameMax) else nil
	return {
		Mineral = mineral,
		Rarity = rarity,
		Modifier = modifier,
		Formation = if type(pet.Formation) == "string" then pet.Formation else nil,
		Seed = math.floor(seed),
		Mass = math.clamp(num(pet.Mass) or 1, 0.2, 5),
		Power = math.floor(p),
		Nickname = nick,
	}
end

-- A new card is worth saving when there was none, the pet looks different, or the power changed.
function TreeBoard.cardChanged(old: Card?, new: Card?): boolean
	if not new then
		return false
	end
	if not old then
		return true
	end
	return old.Mineral ~= new.Mineral or old.Rarity ~= new.Rarity or old.Modifier ~= new.Modifier or old.Seed ~= new.Seed or old.Power ~= new.Power or old.Nickname ~= new.Nickname
end

-- Rank -> size tier.
function TreeBoard.tier(rank: number): string
	return if rank == 1 then "First" elseif rank <= 3 then "Top3" else "Rest"
end

function TreeBoard.petHeight(rank: number): number
	return (TreeBoard.Config.PetHeight :: any)[TreeBoard.tier(rank)]
end

function TreeBoard.signColor(rank: number): Color3
	return (TreeBoard.Config.SignColor :: any)[TreeBoard.tier(rank)]
end

local function commas(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

-- "#1 Sam", "POWER 1,234"
function TreeBoard.signLines(rank: number, name: string, power: number): (string, string)
	local n = if #name > TreeBoard.Config.NameMax then string.sub(name, 1, TreeBoard.Config.NameMax - 1) .. "." else name
	return "#" .. rank .. " " .. n, "POWER " .. commas(power)
end

-- Ranked rows (Boards "Power": { Rank, UserId, Name, Value }) -> branch plan: up to Branches entries
-- { Branch = k, Rank, UserId, Name, Power }; rank k goes on branch k; rows without a positive value are skipped.
function TreeBoard.plan(rows: { any }, branches: number?): { any }
	local n = math.min(branches or TreeBoard.Config.Branches, TreeBoard.Config.Branches)
	local out = {}
	for _, r in rows do
		if #out >= n then
			break
		end
		if type(r) == "table" and num(r.UserId) and num(r.Value) and r.Value > 0 then
			table.insert(out, { Branch = #out + 1, Rank = #out + 1, UserId = r.UserId, Name = tostring(r.Name or ("Player " .. r.UserId)), Power = math.floor(r.Value) })
		end
	end
	return out
end

return TreeBoard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="204">
        <Properties>
          <string name="Name">UiKit</string>
          <string name="Source"><![CDATA[--!strict
-- "Polygon Adventure" UI kit (Blender-rendered PNGs, owner uploads 2026-10-14): one entry per picture,
-- name -> { Id, SliceCenter, Size }. The ids came from the owner's Studio uploads; an entry set back to
-- rbxassetid://0 makes that piece fall back to its drawn look. The shared UI helpers draw these as ImageLabels
-- (client/ui/UI.kitSkin, called from UI.button's paint, UI.modal, UI.tabs, UI.specimenCard, UI.catalogRow,
-- UI.cash, UI.bar, UI.closeButton, UI.newDot and UI.icon "cash"). Pure data and decisions, tested offline
-- (tests/test_ui_kit.luau).
--
-- The PNGs are 2x: Pixels is the uploaded picture's size, Size the 1x size (half). SliceCenter is in the picture's
-- own (2x) pixels from the kit's slices.json margins: Rect(L, T, W - R, H - B). SliceScale 0.5 draws the corners at 1x;
-- a piece smaller than its corners scales them down further (UiKit.sliceScale).

local UiKit = {}

-- Lip: extra bottom margin (2x px) a panel picture has under its rim (the 3D lip). Panels crop it off (ImageRect) so the
-- visible border is the same on all four sides (Studio check 2026-10-14: the Pet Book rim read thicker at the bottom).
-- MaxStretch: how far the element's aspect may stray from the picture's before the picture no longer fits (a portrait
-- card stretched into a wide bar drew a thick stretched stripe on the Upgrades rows); nil = any shape.
export type Entry = { Id: string, Pixels: Vector2, Size: Vector2, SliceCenter: Rect, Slice: boolean, Lip: number?, MaxStretch: number? }

-- A 9-slice piece: `w` x `h` (2x px), margins left / right / top / bottom in those pixels.
local function sliced(id: string, w: number, h: number, l: number, r: number, t: number, b: number): Entry
	return { Id = "rbxassetid://" .. id, Pixels = Vector2.new(w, h), Size = Vector2.new(w / 2, h / 2), SliceCenter = Rect.new(l, t, w - r, h - b), Slice = true }
end

-- A plain picture drawn whole (ScaleType Fit): icons, the badge dot, the close X.
local function plain(id: string, s: number): Entry
	return { Id = "rbxassetid://" .. id, Pixels = Vector2.new(s, s), Size = Vector2.new(s / 2, s / 2), SliceCenter = Rect.new(0, 0, s, s), Slice = false }
end

local function button(id: string): Entry
	return sliced(id, 271, 120, 47, 47, 35, 50)
end

local function rarity(id: string): Entry
	local e = sliced(id, 182, 188, 49, 49, 49, 56)
	e.MaxStretch = 3
	return e
end

-- A card picture (portrait): fits tiles, not wide bars.
local function card(id: string): Entry
	local e = sliced(id, 207, 266, 54, 54, 54, 61)
	e.MaxStretch = 3
	return e
end

-- A panel picture: its bottom lip is cropped so the rim is even (UiKit.crop).
local function panel(id: string, w: number, h: number): Entry
	local e = sliced(id, w, h, 84, 84, 84, 95)
	e.Lip = 95 - 84
	return e
end

local function icon(id: string): Entry
	return plain(id, 143)
end

UiKit.Entries = {
	button_blue = button("72697145353714"),
	button_blue_pressed = button("88459868316412"),
	button_coral = button("108639924673709"),
	button_coral_pressed = button("88633559143079"),
	button_green = button("85239779404293"),
	button_green_pressed = button("133919821267056"),
	button_yellow = button("131017167474107"),
	button_yellow_pressed = button("94666526187739"),
	panel_large = panel("123952033373409", 527, 410),
	panel_small = panel("76810626105109", 335, 256),
	card = card("123706165003345"),
	card_selected = card("98615042784008"),
	tab = sliced("75926104892358", 207, 99, 40, 40, 40, 14),
	tab_active = sliced("118884930792992", 207, 99, 40, 40, 40, 14),
	close_x = plain("102591340029020", 99),
	coin_pill = sliced("76218890033810", 246, 86, 84, 46, 36, 40),
	badge_dot = plain("135033080755062", 79),
	progress_bg = sliced("137735681037240", 399, 67, 36, 36, 33, 33),
	progress_fill = sliced("123400596244425", 399, 67, 36, 36, 33, 33),
	rarity_common = rarity("100541606021995"),
	rarity_uncommon = rarity("77702245224588"),
	rarity_rare = rarity("127616220113092"),
	rarity_epic = rarity("86734803035763"),
	rarity_legendary = rarity("136045809594401"),
	rarity_void = rarity("130434968960886"),
	icon_bolt = icon("123065655189615"),
	icon_coin = icon("78474630929064"),
	icon_egg = icon("138774715991522"),
	icon_gem = icon("140222387178177"),
	icon_heart = icon("79588751757651"),
	icon_paw = icon("108005474157839"),
	icon_star = icon("107664581924134"),
	icon_sword = icon("99463779099896"),
} :: { [string]: Entry }

-- UI.button styles -> kit button: gold (primary) yellow, green green, red (destructive) coral, blue (HUD tiles) blue.
-- gray (secondary: filters, sort, FAV, locked rewards) has no kit picture on purpose: it is drawn flat and
-- desaturated so it never reads like a primary button (Studio check 2026-10-14). A disabled button keeps its
-- picture, tinted grey (UI.kitSkin).
UiKit.ButtonFor = { gold = "button_yellow", green = "button_green", red = "button_coral", blue = "button_blue" } :: { [string]: string }

-- Pet rarity -> card frame (the rarest tiers share the void frame).
UiKit.RarityFor = {
	Common = "rarity_common", Uncommon = "rarity_uncommon", Rare = "rarity_rare", Epic = "rarity_epic",
	Legendary = "rarity_legendary", Mythic = "rarity_void", Secret = "rarity_void", Void = "rarity_void",
} :: { [string]: string }

-- True once the picture has a real (non-zero) asset id.
function UiKit.hasId(id: string?): boolean
	if type(id) ~= "string" or id == "" then
		return false
	end
	local n = string.match(id, "%d+")
	return n ~= nil and tonumber(n) ~= 0
end

export type Skin = { Image: string, SliceCenter: Rect, Pixels: Vector2, Size: Vector2, ScaleType: string, Pressed: string?, Lip: number?, MaxStretch: number? }

-- What `name` should draw: nil while its id is 0 (the caller keeps its drawn look), else the image, the slice
-- centre, the picture sizes, "Slice" (or "Fit" for plain pictures) and the pressed picture when that one has an id.
function UiKit.skinFor(name: string?, entries: { [string]: Entry }?): Skin?
	if type(name) ~= "string" then
		return nil
	end
	local t = entries or UiKit.Entries
	local e = t[name]
	if not e or not UiKit.hasId(e.Id) then
		return nil
	end
	local p = t[name .. "_pressed"]
	return {
		Image = e.Id,
		SliceCenter = e.SliceCenter,
		Pixels = e.Pixels,
		Size = e.Size,
		ScaleType = if e.Slice then "Slice" else "Fit",
		Pressed = if p and UiKit.hasId(p.Id) then p.Id else nil,
		Lip = e.Lip,
		MaxStretch = e.MaxStretch,
	}
end

-- The kit key for a UI.button style (nil: keep the drawn button).
function UiKit.buttonKey(style: string?): string?
	return UiKit.ButtonFor[style or ""]
end

-- The card key for a pet card: the selected frame wins, then the rarity frame, else the plain card.
function UiKit.cardKey(selected: boolean?, rarityName: string?): string
	if selected then
		return "card_selected"
	end
	return UiKit.RarityFor[rarityName or ""] or "card"
end

-- Corner margins (L, T, R, B) of a sliced picture, in its own pixels.
function UiKit.margins(skin: Skin): (number, number, number, number)
	local c = skin.SliceCenter
	return c.Min.X, c.Min.Y, skin.Pixels.X - c.Max.X, skin.Pixels.Y - c.Max.Y
end

-- SliceScale for a piece drawn `w` x `h` (logical px): 0.5 draws the 2x corners at 1x; a piece smaller than its
-- corners scales them down so opposite corners never overlap.
function UiKit.sliceScale(skin: Skin, w: number, h: number): number
	local l, t, r, b = UiKit.margins(skin)
	local s = 0.5
	if w > 0 and l + r > 0 then
		s = math.min(s, w / (l + r))
	end
	if h > 0 and t + b > 0 then
		s = math.min(s, h / (t + b))
	end
	return math.max(s, 0.01)
end

-- The part of a picture to draw (ImageRectSize) and its slice centre inside that part: a panel's bottom lip is cropped
-- off, so its four rim margins come out equal (L, T, R and B = T). Other pictures are drawn whole.
function UiKit.crop(skin: Skin): (Vector2, Rect)
	local lip = skin.Lip or 0
	if lip <= 0 or skin.ScaleType ~= "Slice" then
		return skin.Pixels, skin.SliceCenter
	end
	local l, t, r, _ = UiKit.margins(skin)
	local size = Vector2.new(skin.Pixels.X, skin.Pixels.Y - lip)
	return size, Rect.new(l, t, size.X - r, size.Y - t)
end

-- Rim margins (L, T, R, B) as drawn, after the crop.
function UiKit.drawnMargins(skin: Skin): (number, number, number, number)
	local size, c = UiKit.crop(skin)
	return c.Min.X, c.Min.Y, size.X - c.Max.X, size.Y - c.Max.Y
end

-- SliceScale for a piece drawn `w` x `h` (logical px, measured after layout), with the cropped margins:
-- min(cap, h / (T + B), w / (L + R)), so opposite corners never overlap and a corner is never stretched.
-- `cap` defaults to 0.5 (the 2x corners at 1x).
function UiKit.fitScale(skin: Skin, w: number, h: number, cap: number?): number
	local l, t, r, b = UiKit.drawnMargins(skin)
	local s = cap or 0.5
	if w > 0 and l + r > 0 then
		s = math.min(s, w / (l + r))
	end
	if h > 0 and t + b > 0 then
		s = math.min(s, h / (t + b))
	end
	return math.max(s, 0.01)
end

-- Whether a sliced picture suits an element `w` x `h`: a piece with MaxStretch only when the element's aspect is
-- within that factor of the picture's (a portrait card is not drawn as a wide bar); unknown sizes fit.
function UiKit.fits(skin: Skin, w: number, h: number): boolean
	local m = skin.MaxStretch
	if not m or w <= 0 or h <= 0 or skin.ScaleType ~= "Slice" then
		return true
	end
	local want = (w / h) / (skin.Pixels.X / skin.Pixels.Y)
	return want <= m and want >= 1 / m
end

-- Corner cap for a menu panel on a screen `logicalH` tall: 1x corners (0.5) from 450 logical px up, down to 0.35 at
-- 390 and below (landscape phones are 315-400 logical tall), so the rim does not eat the content.
function UiKit.panelCap(logicalH: number): number
	return math.clamp(0.35 + (logicalH - 390) / (450 - 390) * 0.15, 0.35, 0.5)
end

-- Share of a rim margin that is the visible frame; the rest is the soft inner edge the content may sit on.
UiKit.RIM_SHARE = 0.6

-- Inner content rect of a panel picture drawn at SliceScale `scale`: insets (L, T, R, B) in logical px. Header, tabs,
-- body and footer all sit inside it, so they line up with the picture and with each other.
-- Top offset (inside the KitPad padding) of a kit panel's solid fill: the content pad `padTop` and the rim's own
-- inset `rimTop` differ only when the header sits on the rim (padTop 0); the fill then still starts under the rim.
function UiKit.backingTop(padTop: number, rimTop: number): number
	return math.max(rimTop - padTop, 0)
end

function UiKit.contentInset(skin: Skin, scale: number): (number, number, number, number)
	local l, t, r, b = UiKit.drawnMargins(skin)
	local k = scale * UiKit.RIM_SHARE
	return math.floor(l * k), math.floor(t * k), math.floor(r * k), math.floor(b * k)
end

-- Text floor (Studio check 2026-10-14: small white words on pale kit buttons were unreadable). Every fitted label is
-- designed at MinText or more and never shrinks below it; light words over colour carry an outline of at least
-- LightOutline px.
UiKit.MinText = 14
UiKit.LightOutline = 2

-- The floor is also kept in REAL pixels: every layer has a UIScale, so a 14 logical px label is 8 real px at scale 0.6
-- (Studio check 1434 x 658). RealMinText is the smallest text, in screen px, that is allowed to show.
UiKit.RealMinText = 12
UiKit.MaxFloorText = 28 -- the real-pixel floor never asks for more than this many logical px (very small scales)

-- Smallest logical text size that draws at least RealMinText real px at UIScale `scale` (never below MinText).
function UiKit.floorFor(scale: number?): number
	local k = math.max(scale or 1, 0.1)
	return math.min(math.max(UiKit.MinText, math.ceil(UiKit.RealMinText / k - 1e-6)), UiKit.MaxFloorText)
end

-- (MaxTextSize, MinTextSize) for a label designed at `size` that may shrink to `minSize`, with the floor applied.
-- With `scale` (the current UIScale) the floor is the real-pixel one: the minimum is max(MinText, ceil(12 / scale)),
-- and the maximum is lifted to meet it so the label can always reach the floor.
function UiKit.textRange(size: number, minSize: number?, scale: number?): (number, number)
	local hi = math.max(math.floor(size), UiKit.MinText)
	local lo = math.clamp(math.floor(minSize or UiKit.MinText), UiKit.MinText, hi)
	if scale then
		lo = math.max(lo, UiKit.floorFor(scale))
		hi = math.max(hi, lo)
	end
	return hi, lo
end

-- True for light text (white, cream, pale yellow / green / blue): relative luminance above 0.5.
function UiKit.isLight(c: Color3): boolean
	return 0.2126 * c.R + 0.7152 * c.G + 0.0722 * c.B > 0.5
end

-- Outline thickness for a label in colour `c` designed with `thick` (nil or 0: none): light text gets at least
-- LightOutline px of dark outline; dark text keeps what it was designed with.
function UiKit.outlineFor(c: Color3, thick: number?): number
	local t = thick or 0
	if UiKit.isLight(c) then
		return math.max(t, UiKit.LightOutline)
	end
	return t
end

-- Top offset (logical px) that keeps a modal's header inside the safe area. `insetY` is GuiService:GetGuiInset().Y in
-- real px, counted only when the layer ignores the inset (else the layer already starts below the top bar);
-- `overhang` is how far the header (the title tab) sticks out above the panel's top edge; `margin` a clear gap.
UiKit.SafeTopMargin = 8 -- the clear gap modals pass as `margin` (was 2; Studio 1434 x 658 cleared the top bar only barely)

function UiKit.safeTop(insetY: number, ignoresInset: boolean, scale: number, overhang: number, margin: number): number
	local top = if ignoresInset then insetY / math.max(scale, 0.01) else 0
	return math.ceil(top + math.max(overhang, 0) + margin)
end

-- How much to shorten a scroll window `window` px tall so it ends on a whole row: `bottoms` are the rows' bottom
-- edges (px from the window's top at scroll 0, any order). Returns 0 when everything fits, when no row ends inside
-- the window, or when the cut would take more than `maxShare` (default 0.35) of the window.
-- `heights` (optional, same order as `bottoms`): a row that crosses the window edge with half or more of it in view
-- is kept, not cut away (a tall quest card cut to nothing left a void under the heading, Studio check 2026-10-15).
function UiKit.snapCut(bottoms: { number }, window: number, maxShare: number?, heights: { number }?): number
	local last, best = 0, -1
	for i, b in bottoms do
		last = math.max(last, b)
		if b <= window and b > best then
			best = b
		end
		if heights and b > window then
			local h = heights[i] or 0
			if h > 0 and (window - (b - h)) / h >= 0.5 then
				return 0
			end
		end
	end
	if last <= window or best <= 0 then
		return 0
	end
	local cut = window - best
	if cut > window * (maxShare or 0.35) then
		return 0
	end
	return math.floor(cut)
end

return UiKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="205">
        <Properties>
          <string name="Name">UiMotion</string>
          <string name="Source"><![CDATA[--!strict
-- Pure numbers behind the UI juice (client/ui/Juice, UI): count-up values, the coin-fly arc, tab slide direction,
-- reduced-motion gating, scroll canvas height and "new since last look" pet ids. No Instances, no services, so the
-- offline Lune tests can check every rule (tests/test_ui_motion.luau).

local UiMotion = {}

-- Reduce Motion: the game's own setting (UI.Reduced) or Roblox's system setting turns every effect off.
function UiMotion.animate(gameReduced: boolean?, systemReduced: boolean?): boolean
	return gameReduced ~= true and systemReduced ~= true
end

-- Ease out (cubic): fast first, slows into the final value.
function UiMotion.ease(a: number): number
	local x = math.clamp(a, 0, 1)
	return 1 - (1 - x) ^ 3
end

-- The whole number a counter shows `a` (0..1) of the way from `from` to `to` (counts down as well as up).
-- Ends exactly on `to`; never overshoots either end.
function UiMotion.countValue(from: number, to: number, a: number): number
	if a >= 1 then
		return to
	end
	local v = from + (to - from) * UiMotion.ease(a)
	local r = math.floor(v + 0.5)
	if to >= from then
		return math.clamp(r, from, to)
	end
	return math.clamp(r, to, from)
end

-- The values a counter steps through over `frames` frames (frame 1 .. frames), ending on `to`.
function UiMotion.countSteps(from: number, to: number, frames: number): { number }
	local n = math.max(1, math.floor(frames))
	local out = table.create(n)
	for i = 1, n do
		out[i] = UiMotion.countValue(from, to, i / n)
	end
	return out
end

-- Coin-fly arc: a quadratic curve from `p0` to `p1` that bows upward (screen y grows downward) by `lift` plus a
-- quarter of the horizontal distance, so a long flight arcs higher. t in 0..1.
function UiMotion.arcControl(p0: Vector2, p1: Vector2, lift: number): Vector2
	local mid = (p0 + p1) / 2
	return Vector2.new(mid.X, math.min(p0.Y, p1.Y) - lift - math.abs(p1.X - p0.X) * 0.25)
end

function UiMotion.arcPoint(p0: Vector2, p1: Vector2, lift: number, t: number): Vector2
	local u = math.clamp(t, 0, 1)
	local c = UiMotion.arcControl(p0, p1, lift)
	local a = 1 - u
	return p0 * (a * a) + c * (2 * a * u) + p1 * (u * u)
end

-- `n` + 1 points along the arc (t = 0, 1/n, .., 1).
function UiMotion.arcPath(p0: Vector2, p1: Vector2, lift: number, n: number): { Vector2 }
	local k = math.max(1, math.floor(n))
	local out = table.create(k + 1)
	for i = 0, k do
		out[i + 1] = UiMotion.arcPoint(p0, p1, lift, i / k)
	end
	return out
end

-- How many coins fly for a reward of `amount` coins: 3 for small rewards, up to 6 for big ones.
function UiMotion.coinCount(amount: number): number
	local a = math.max(amount, 1)
	return math.clamp(math.floor(math.log10(a)) + 2, 3, 6)
end

-- New tab content slides in from the side of the tab that was tapped: from the right (+dist) when the new tab is
-- right of the old one, from the left (-dist) when it is left of it, not at all for the same tab.
function UiMotion.slideFrom(oldIndex: number?, newIndex: number, dist: number): number
	if oldIndex == nil or oldIndex == newIndex then
		return 0
	end
	return if newIndex > oldIndex then dist else -dist
end

-- Scroll canvas height for a list: content + top and bottom padding + `extra` (one card gap under the last card),
-- never less than 0. Every card is then reachable by scrolling.
function UiMotion.canvasHeight(content: number, padTop: number, padBottom: number, extra: number?): number
	return math.max(0, math.ceil(content + padTop + padBottom + (extra or 0)))
end

-- Pets that arrived since the player last looked: `known` is the set of ids seen so far (nil before the first
-- look: everything is known then, nothing is fresh). Returns the updated known set and the new ids in list order.
function UiMotion.freshIds(known: { [string]: boolean }?, ids: { string }): ({ [string]: boolean }, { string })
	local out: { [string]: boolean } = {}
	local fresh: { string } = {}
	for _, id in ids do
		if known ~= nil and not known[id] then
			table.insert(fresh, id)
		end
		out[id] = true
	end
	return out, fresh
end

-- A GUI object is drawn only when every link from it up to its ScreenGui is on (Visible / Enabled flags, the object
-- first). An empty chain (not under any GUI) is not drawn. Used by Juice.onScreen.
function UiMotion.shownChain(chain: { boolean }): boolean
	if #chain == 0 then
		return false
	end
	for _, on in chain do
		if not on then
			return false
		end
	end
	return true
end

-- A Pet Book tile caption gets two lines when it is several words and too long for one line at the text floor
-- ("Golden Razorclaw", "Skeleton Thunderstrut" showed only their first word); short names stay on one line.
function UiMotion.twoLineName(text: string): boolean
	return string.find(text, " ", 1, true) ~= nil and utf8.len(text) ~= nil and (utf8.len(text) :: number) >= 12
end

-- True when something ending at x = `rightEdge` stays at least `gap` px left of a thing starting at `leftEdge`.
function UiMotion.clearOf(rightEdge: number, leftEdge: number, gap: number): boolean
	return rightEdge + gap <= leftEdge
end

return UiMotion
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="206">
        <Properties>
          <string name="Name">Vendor</string>
        </Properties>
        <Item class="ModuleScript" referent="207">
          <Properties>
            <string name="Name">spr</string>
            <string name="Source"><![CDATA[--!strict
--!native
---------------------------------------------------------------------
-- spr - Spring-driven motion library
--
-- Copyright (c) 2024 Fractality. All rights reserved.
-- Released under the MIT license.
--
-- Docs & license can be found at https://github.com/Fraktality/spr
--
-- API Summary:
--
-- spr.target(
--    Instance obj,
--    number dampingRatio,
--    number undampedFrequency,
--    dict<string, Variant> targetProperties)
--
--    Animates the given properties towardes the target values,
--    given damping ratio and undamped frequency.
--
--
-- spr.stop(
--    Instance obj[,
--    string property])
--
--    Stops the specified property on an Instance from animating.
--    If no property is specified, all properties of the Instance
--    will stop animating.
--
-- Visualizer: https://www.desmos.com/calculator/rzvw27ljh9
---------------------------------------------------------------------

local STRICT_RUNTIME_TYPES = true -- assert on parameter and property type mismatch
local SLEEP_OFFSET_SQ_LIMIT = (1/3840)^2 -- square of the offset sleep limit
local SLEEP_VELOCITY_SQ_LIMIT = 1e-2^2 -- square of the velocity sleep limit
local SLEEP_ROTATION_DIFF = math.rad(0.01) -- rad
local SLEEP_ROTATION_VELOCITY = math.rad(0.1) -- rad/s
local EPS = 1e-5 -- epsilon for stability checks around pathological frequency/damping values

local RunService: RunService = game:GetService("RunService")

local pi = math.pi
local exp = math.exp
local sin = math.sin
local cos = math.cos
local min = math.min
local max = math.max
local sqrt = math.sqrt
local atan2 = math.atan2
local round = math.round

local function magnitudeSq(vec: {number})
	local out = 0
	for _, v in vec do
		out += v^2
	end
	return out
end

local function distanceSq(vec0: {number}, vec1: {number})
	local out = 0
	for i0, v0 in vec0 do
		out += (vec1[i0] - v0)^2
	end
	return out
end

type TypeMetadata<T> = {
	springType: (dampingRatio: number, frequency: number, pos: number, typedat: TypeMetadata<T>, rawTarget: T) -> LinearSpring<T>,
	toIntermediate: (T) -> {number},
	fromIntermediate: ({number}) -> T,
}

-- Spring for an array of linear values
local LinearSpring = {}

type LinearSpring<T> = typeof(setmetatable({} :: {
	d: number,
	f: number,
	g: {number},
	p: {number},
	v: {number},
	typedat: TypeMetadata<T>,
	rawTarget: T,
}, LinearSpring))

do
	LinearSpring.__index = LinearSpring

	function LinearSpring.new<T>(dampingRatio: number, frequency: number, pos: T, rawGoal: T, typedat)
		local linearPos = typedat.toIntermediate(pos)
		return setmetatable(
			{
				d = dampingRatio,
				f = frequency,
				g = linearPos,
				p = linearPos,
				v = table.create(#linearPos, 0),
				typedat = typedat,
				rawGoal = rawGoal
			},
			LinearSpring
		)
	end

	function LinearSpring.setGoal<T>(self, goal: T)
		self.rawGoal = goal
		self.g = self.typedat.toIntermediate(goal)
	end

	function LinearSpring.setDampingRatio<T>(self: LinearSpring<T>, dampingRatio: number)
		self.d = dampingRatio
	end

	function LinearSpring.setFrequency<T>(self: LinearSpring<T>, frequency: number)
		self.f = frequency
	end

	function LinearSpring.canSleep<T>(self)
		if magnitudeSq(self.v) > SLEEP_VELOCITY_SQ_LIMIT then
			return false
		end

		if distanceSq(self.p, self.g) > SLEEP_OFFSET_SQ_LIMIT then
			return false
		end

		return true
	end

	function LinearSpring.step<T>(self: LinearSpring<T>, dt: number)
		-- Advance the spring simulation by dt seconds.
		-- Take the damped harmonic oscillator ODE:
		--    f^2*(X[t] - g) + 2*d*f*X'[t] + X''[t] = 0
		-- Where X[t] is position at time t, g is target position,
		-- f is undamped angular frequency, and d is damping ratio.
		-- Apply constant initial conditions:
		--    X[0] = p0
		--    X'[0] = v0
		-- Solve the IVP to get analytic expressions for X[t] and X'[t].
		-- The solution takes one of three forms for 0<=d<1, d=1, and d>1

		local d = self.d
		local f = self.f*(2*pi) -- Hz -> Rad/s
		local g = self.g
		local p = self.p
		local v = self.v

		if d == 1 then -- critically damped
			local q = exp(-f*dt)
			local w = dt*q

			local c0 = q + w*f
			local c2 = q - w*f
			local c3 = w*f*f

			for idx = 1, #p do
				local o = p[idx] - g[idx]
				p[idx] = o*c0 + v[idx]*w + g[idx]
				v[idx] = v[idx]*c2 - o*c3
			end

		elseif d < 1 then -- underdamped
			local q = exp(-d*f*dt)
			local c = sqrt(1 - d*d)

			local i = cos(dt*f*c)
			local j = sin(dt*f*c)

			-- Damping ratios approaching 1 can cause division by very small numbers.
			-- To mitigate that, group terms around z=j/c and find an approximation for z.
			-- Start with the definition of z:
			--    z = sin(dt*f*c)/c
			-- Substitute a=dt*f:
			--    z = sin(a*c)/c
			-- Take the Maclaurin expansion of z with respect to c:
			--    z = a - (a^3*c^2)/6 + (a^5*c^4)/120 + O(c^6)
			--    z ≈ a - (a^3*c^2)/6 + (a^5*c^4)/120
			-- Rewrite in Horner form:
			--    z ≈ a + ((a*a)*(c*c)*(c*c)/20 - c*c)*(a*a*a)/6

			local z
			if c > EPS then
				z = j/c
			else
				local a = dt*f
				z = a + ((a*a)*(c*c)*(c*c)/20 - c*c)*(a*a*a)/6
			end

			-- Frequencies approaching 0 present a similar problem.
			-- We want an approximation for y as f approaches 0, where:
			--    y = sin(dt*f*c)/(f*c)
			-- Substitute b=dt*c:
			--    y = sin(b*c)/b
			-- Now reapply the process from z.

			local y
			if f*c > EPS then
				y = j/(f*c)
			else
				local b = f*c
				y = dt + ((dt*dt)*(b*b)*(b*b)/20 - b*b)*(dt*dt*dt)/6
			end

			for idx = 1, #p do
				local o = p[idx] - g[idx]
				p[idx] = (o*(i + z*d) + v[idx]*y)*q + g[idx]
				v[idx] = (v[idx]*(i - z*d) - o*(z*f))*q
			end

		else -- overdamped
			local c = sqrt(d*d - 1)

			local r1 = -f*(d + c)
			local r2 = -f*(d - c)

			local ec1 = exp(r1*dt)
			local ec2 = exp(r2*dt)

			for idx = 1, #p do
				local o = p[idx] - g[idx]
				local co2 = (v[idx] - o*r1)/(2*f*c)
				local co1 = ec1*(o - co2)

				p[idx] = co1 + co2*ec2 + g[idx]
				v[idx] = co1*r1 + co2*ec2*r2
			end
		end

		return self.typedat.fromIntermediate(self.p)
	end
end

local RotationSpring = {} 

type RotationSpring = typeof(setmetatable({} :: {
	d: number,
	f: number,
	g: CFrame,
	p: CFrame,
	v: Vector3,
}, RotationSpring))

do
	RotationSpring.__index = RotationSpring

	function RotationSpring.new(d: number, f: number, p: CFrame, g: CFrame)
		return setmetatable(
			{
				d = d,
				f = f,
				g = g:Orthonormalize(),
				p = p:Orthonormalize(),
				v = Vector3.zero
			},
			RotationSpring
		)
	end

	function RotationSpring.setGoal(self: RotationSpring, value: CFrame)
		self.g = value:Orthonormalize()
	end

	function RotationSpring.setDampingRatio(self: RotationSpring, dampingRatio: number)
		self.d = dampingRatio
	end

	function RotationSpring.setFrequency(self: RotationSpring, frequency: number)
		self.f = frequency
	end

	-- evaluate dot products in high precision
	local function dot(v0: Vector3, v1: Vector3)
		return v0.X*v1.X + v0.Y*v1.Y + v0.Z*v1.Z
	end

	local function areRotationsClose(c0: CFrame, c1: CFrame)
		local rx = dot(c0.XVector, c1.XVector)
		local ry = dot(c0.YVector, c1.YVector)
		local rz = dot(c0.ZVector, c1.ZVector)
		local trace = rx + ry + rz
		return trace > 1 + 2*cos(SLEEP_ROTATION_DIFF)
	end
	
	local function angleDiff(c0: CFrame, c1: CFrame)
		local x = dot(c0.XVector, c1.XVector)
		local y = dot(c0.YVector, c1.YVector)
		local z = dot(c0.ZVector, c1.ZVector)
		local w = x + y + z - 1
		return atan2(sqrt(max(0, 1 - w*w*0.25)), w*0.5)
	end
	
	-- gives approx. 21% accuracy improvement over CFrame.fromAxisAngle near poles
	local function fromAxisAngle(axis: Vector3, angle: number)
		local c = cos(angle)
		local s = sin(angle)
		local x, y, z = axis.X, axis.Y, axis.Z

		local mxy = x*y*(1 - c)
		local myz = y*z*(1 - c)
		local mzx = z*x*(1 - c)

		local rx = Vector3.new(x*x*(1 - c) + c, mxy + z*s, mzx - y*s)
		local ry = Vector3.new(mxy - z*s, y*y*(1 - c) + c, myz + x*s)
		local rz = Vector3.new(mzx + y*s, myz - x*s, z*z*(1 - c) + c)

		return CFrame.fromMatrix(Vector3.zero, rx, ry, rz):Orthonormalize()
	end

	local function rotateAxis(r0: Vector3, c1: CFrame)
		local c0 = CFrame.identity
		local mag = r0.Magnitude
		if mag > 1e-6 then
			c0 = fromAxisAngle(r0.Unit, mag)
		end
		return c0 * c1
	end

	-- axis*angle difference between two cframes
	local function axisAngleDiff(c0: CFrame, c1: CFrame)
		-- use native axis (stable enough)
		local axis = (c0*c1:Inverse()):ToAxisAngle()
		
		-- use full-precision angle calculation to minimize truncation
		local angle = angleDiff(c0, c1)
		return axis.Unit*angle
	end

	function RotationSpring.canSleep(self: RotationSpring)
		local sleepP = areRotationsClose(self.p, self.g)
		local sleepV = self.v.Magnitude < SLEEP_ROTATION_VELOCITY
		return sleepP and sleepV
	end

	function RotationSpring.step(self: RotationSpring, dt: number): CFrame
		local d = self.d
		local f = self.f*(2*pi)
		local g = self.g
		local p0 = self.p
		local v0 = self.v

		local offset = axisAngleDiff(p0, g)
		local decay = exp(-d*f*dt)

		local pt: CFrame
		local vt: Vector3

		if d == 1 then -- critically damped
			pt = rotateAxis((offset*(1 + f*dt) + v0*dt)*decay, g)
			vt = (v0*(1 - dt*f) - offset*(dt*f*f))*decay

		elseif d < 1 then -- underdamped
			local c = sqrt(1 - d*d)

			local i = cos(dt*f*c)
			local j = sin(dt*f*c)

			local y = j/(f*c)
			local z = j/c

			pt = rotateAxis((offset*(i + z*d) + v0*y)*decay, g)
			vt = (v0*(i - z*d) - offset*(z*f))*decay

		else -- overdamped
			local c = sqrt(d*d - 1)

			local r1 = -f*(d + c)
			local r2 = -f*(d - c)

			local co2 = (v0 - offset*r1)/(2*f*c)
			local co1 = offset - co2

			local e1 = co1*exp(r1*dt)
			local e2 = co2*exp(r2*dt)

			pt = rotateAxis(e1 + e2, g)
			vt = e1*r1 + e2*r2
		end

		self.p = pt
		self.v = vt

		return pt
	end
end

-- Defined early to be used by CFrameSpring
local typeMetadata_Vector3 = {
	springType = LinearSpring.new,

	toIntermediate = function(value)
		return {value.X, value.Y, value.Z}
	end,

	fromIntermediate = function(value: {number})
		return Vector3.new(value[1], value[2], value[3])
	end,
}

-- Encapsulates a CFrame - Separates translation from rotation
local CFrameSpring = {}
do
	CFrameSpring.__index = CFrameSpring

	function CFrameSpring.new(
		dampingRatio: number,
		frequency: number,
		valueCurrent: CFrame,
		valueGoal: CFrame,
		_: any
	)
		return setmetatable(
			{
				rawGoal = valueGoal,
				_position = LinearSpring.new(dampingRatio, frequency, valueCurrent.Position, valueGoal.Position, typeMetadata_Vector3),
				_rotation = RotationSpring.new(dampingRatio, frequency, valueCurrent.Rotation, valueGoal.Rotation)
			},
			CFrameSpring
		)
	end

	function CFrameSpring:setGoal(value: CFrame)
		self.rawGoal = value
		self._position:setGoal(value.Position)
		self._rotation:setGoal(value.Rotation)
	end

	function CFrameSpring:setDampingRatio(value: number)
		self._position.d = value
		self._rotation.d = value
	end

	function CFrameSpring:setFrequency(value: number)
		self._position.f = value
		self._rotation.f = value
	end

	function CFrameSpring:canSleep()
		return self._position:canSleep() and self._rotation:canSleep()
	end

	function CFrameSpring:step(dt): CFrame
		local p: Vector3 = self._position:step(dt)
		local r: CFrame = self._rotation:step(dt)
		return r + p
	end
end

-- Color conversions
local rgbToLuv
local luvToRgb
do
	local function inverseGammaCorrectD65(c)
		return c < 0.0404482362771076 and c/12.92 or 0.87941546140213*(c + 0.055)^2.4
	end

	local function gammaCorrectD65(c)
		return c < 3.1306684425e-3 and 12.92*c or 1.055*c^(1/2.4) - 0.055
	end

	function rgbToLuv(value: Color3): {number}
		-- convert RGB to a variant of cieluv space
		local r, g, b = value.R, value.G, value.B

		-- D65 sRGB inverse gamma correction
		r = inverseGammaCorrectD65(r)
		g = inverseGammaCorrectD65(g)
		b = inverseGammaCorrectD65(b)

		-- sRGB -> xyz
		local x = 0.9257063972951867*r - 0.8333736323779866*g - 0.09209820666085898*b
		local y = 0.2125862307855956*r + 0.71517030370341085*g + 0.0722004986433362*b
		local z = 3.6590806972265883*r + 11.4426895800574232*g + 4.1149915024264843*b

		-- xyz -> scaled cieluv
		local l = y > 0.008856451679035631 and 116*y^(1/3) - 16 or 903.296296296296*y

		local u, v
		if z > 1e-14 then
			u = l*x/z
			v = l*(9*y/z - 0.46832)
		else
			u = -0.19783*l
			v = -0.46832*l
		end

		return {l, u, v}
	end

	function luvToRgb(value: {number}): Color3
		-- convert back from modified cieluv to rgb space
		local l = value[1]
		if l < 0.0197955 then
			return Color3.new(0, 0, 0)
		end
		local u = value[2]/l + 0.19783
		local v = value[3]/l + 0.46832

		-- cieluv -> xyz
		local y = (l + 16)/116
		y = y > 0.206896551724137931 and y*y*y or 0.12841854934601665*y - 0.01771290335807126
		local x = y*u/v
		local z = y*((3 - 0.75*u)/v - 5)

		-- xyz -> D65 sRGB
		local r =  7.2914074*x - 1.5372080*y - 0.4986286*z
		local g = -2.1800940*x + 1.8757561*y + 0.0415175*z
		local b =  0.1253477*x - 0.2040211*y + 1.0569959*z

		-- clamp minimum sRGB component
		if r < 0 and r < g and r < b then
			r, g, b = 0, g - r, b - r
		elseif g < 0 and g < b then
			r, g, b = r - g, 0, b - g
		elseif b < 0 then
			r, g, b = r - b, g - b, 0
		end

		-- gamma correction from D65
		-- clamp to avoid undesirable overflow wrapping behavior on certain properties (e.g. BasePart.Color)
		return Color3.new(
			min(gammaCorrectD65(r), 1),
			min(gammaCorrectD65(g), 1),
			min(gammaCorrectD65(b), 1)
		)
	end
end

-- Type definitions
-- Transforms Roblox types into intermediate types, converting
-- between spaces as necessary to preserve perceptual linearity
local typeMetadata = {
	boolean = {
		springType = LinearSpring.new,

		toIntermediate = function(value)
			return {value and 1 or 0}
		end,

		fromIntermediate = function(value)
			return value[1] >= 0.5
		end,
	},

	number = {
		springType = LinearSpring.new,

		toIntermediate = function(value)
			return {value}
		end,

		fromIntermediate = function(value)
			return value[1]
		end,
	},

	NumberRange = {
		springType = LinearSpring.new,

		toIntermediate = function(value)
			return {value.Min, value.Max}
		end,

		fromIntermediate = function(value)
			return NumberRange.new(value[1], value[2])
		end,
	},

	UDim = {
		springType = LinearSpring.new,

		toIntermediate = function(value)
			return {value.Scale, value.Offset}
		end,

		fromIntermediate = function(value: {number})
			return UDim.new(value[1], round(value[2]))
		end,
	},

	UDim2 = {
		springType = LinearSpring.new,

		toIntermediate = function(value)
			local x = value.X
			local y = value.Y
			return {x.Scale, x.Offset, y.Scale, y.Offset}
		end,

		fromIntermediate = function(value: {number})
			return UDim2.new(value[1], round(value[2]), value[3], round(value[4]))
		end,
	},

	Vector2 = {
		springType = LinearSpring.new,

		toIntermediate = function(value)
			return {value.X, value.Y}
		end,

		fromIntermediate = function(value: {number})
			return Vector2.new(value[1], value[2])
		end,
	},

	Vector3 = typeMetadata_Vector3,

	Color3 = {
		springType = LinearSpring.new,
		toIntermediate = rgbToLuv,
		fromIntermediate = luvToRgb,
	},

	-- Only interpolates start and end keypoints
	ColorSequence = {
		springType = LinearSpring.new,

		toIntermediate = function(value)
			local keypoints = value.Keypoints

			local luv0 = rgbToLuv(keypoints[1].Value)
			local luv1 = rgbToLuv(keypoints[#keypoints].Value)

			return {
				luv0[1], luv0[2], luv0[3],
				luv1[1], luv1[2], luv1[3],
			}
		end,

		fromIntermediate = function(value: {})
			return ColorSequence.new(
				luvToRgb{value[1], value[2], value[3]},
				luvToRgb{value[4], value[5], value[6]}
			)
		end,
	},

	CFrame = {
		springType = CFrameSpring.new,
		toIntermediate = error, -- custom (CFrameSpring)
		fromIntermediate = error, -- custom (CFrameSpring)
	}
}

type PropertyOverride = {
	[string]: {
		class: string,
		get: (any)->(),
		set: (any, any)->(),
	}
}

local PSEUDO_PROPERTIES: PropertyOverride = {
	Pivot = {
		class = "PVInstance",
		get = function(inst: PVInstance)
			return inst:GetPivot()
		end,
		set = function(inst: PVInstance, value: CFrame)
			inst:PivotTo(value)
		end
	},
	Scale = {
		class = "Model",
		get = function(inst: Model)
			return inst:GetScale()
		end,
		set = function(inst: Model, value: number)
			local FLOAT_MANTISSA_MIN = 1.402e-45
			local FLOAT_MANTISSA_MAX = 2^24
			value = math.clamp(value, FLOAT_MANTISSA_MIN, FLOAT_MANTISSA_MAX)
			inst:ScaleTo(value)
		end
	}
}

local function getProperty(instance: Instance, property: string): any
	local override = PSEUDO_PROPERTIES[property]
	if override and instance:IsA(override.class) then
		return override.get(instance)
	else
		return (instance :: any)[property]
	end
end

local function setProperty(instance: Instance, property: string, value: unknown)
	local override = PSEUDO_PROPERTIES[property]
	if override and instance:IsA(override.class) then
		override.set(instance, value)
	else
		(instance :: any)[property] = value
	end
end

-- Frame loop
local springStates_other: {[Instance]: {[string]: any}} = {} -- {[instance] = {[property] = spring}
local springStates_render: {[Instance]: {[string]: any}} = {} -- {[instance] = {[property] = spring}
local completedCallbacks: {[Instance]: {()->()}} = {}

local function processSprings(springStates: typeof(springStates_other), dt: number)
	for instance, state in springStates do
		for propName, spring in state do
			if spring:canSleep() then
				state[propName] = nil
				setProperty(instance, propName, spring.rawGoal)
			else
				setProperty(instance, propName, spring:step(dt))
			end
		end

		if not next(state) then
			springStates[instance] = nil

			-- trigger completed callbacks when all properties finish animating
			local callbackList = completedCallbacks[instance]
			if callbackList then
				-- flush callback list before we run any callbacks in case
				-- one of the callbacks recursively adds another callback
				completedCallbacks[instance] = nil

				for _, callback in callbackList do
					task.spawn(callback)
				end
			end
		end
	end
end

RunService.PreSimulation:Connect(function(dt)
	processSprings(springStates_other, dt)
end)

RunService.PostSimulation:Connect(function(dt)
	processSprings(springStates_render, dt)
end)

local function assertType(argNum: number, fnName: string, expectedType: string, value: unknown)
	if not expectedType:find(typeof(value)) then
		error(`bad argument #{argNum} to {fnName} ({expectedType} expected, got {typeof(value)})`, 3)
	end
end

-- API
local spr = {}

function spr.target(instance: Instance, dampingRatio: number, frequency: number, properties: {[string]: any})
	if STRICT_RUNTIME_TYPES then
		assertType(1, "spr.target", "Instance", instance)
		assertType(2, "spr.target", "number", dampingRatio)
		assertType(3, "spr.target", "number", frequency)
		assertType(4, "spr.target", "table", properties)
	end

	if dampingRatio ~= dampingRatio or dampingRatio < 0 then
		error(("expected damping ratio >= 0; got %.2f"):format(dampingRatio), 2)
	end

	if frequency ~= frequency or frequency < 0 then
		error(("expected undamped frequency >= 0; got %.2f"):format(frequency), 2)
	end

	local targetRecord = (if instance:IsA("Camera") then springStates_render else springStates_other) :: {[Instance]: {[string]: any}}

	local state = targetRecord[instance]
	if not state then
		state = {}
		targetRecord[instance] = state
	end

	for propName, propTarget in properties do
		local propValue = getProperty(instance, propName)

		if STRICT_RUNTIME_TYPES and typeof(propTarget) ~= typeof(propValue) then
			error(`bad property {propName} to spr.target ({typeof(propValue)} expected, got {typeof(propTarget)})`, 2)
		end

		-- Special case infinite frequency for an instantaneous change
		if frequency == math.huge then
			setProperty(instance, propName, propTarget)
			state[propName] = nil
			continue
		end

		local spring = state[propName]
		if not spring then
			local md = typeMetadata[typeof(propTarget)]
			if not md then
				error("unsupported type: " .. typeof(propTarget), 2)
			end

			spring = md.springType(dampingRatio, frequency, propValue, propTarget, md)
			state[propName] = spring
		end

		spring:setGoal(propTarget)
		spring:setDampingRatio(dampingRatio)
		spring:setFrequency(frequency)
	end

	if not next(state) then
		targetRecord[instance] = nil
	end
end

function spr.stop(instance: Instance, property: string?)
	if STRICT_RUNTIME_TYPES then
		assertType(1, "spr.stop", "Instance", instance)
		assertType(2, "spr.stop", "string|nil", property)
	end

	if property then
		local state = springStates_other[instance] or springStates_render[instance]
		if state then
			state[property] = nil
		end
	else
		springStates_other[instance] = nil
		springStates_render[instance] = nil
	end
end

function spr.completed(instance: Instance, callback: ()->())
	if STRICT_RUNTIME_TYPES then
		assertType(1, "spr.completed", "Instance", instance)
		assertType(2, "spr.completed", "function", callback)
	end

	local callbackList = completedCallbacks[instance]
	if callbackList then
		table.insert(callbackList, callback)
	else
		completedCallbacks[instance] = {callback}
	end
end

return table.freeze(spr)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="208">
        <Properties>
          <string name="Name">VibeGrade</string>
          <string name="Source"><![CDATA[--!strict
-- VIBE GRADE (carter 2026-10-15: "the map doesn't look vibrant enough to appeal to kids"). One pure colour lift for the
-- lobby dressing: coloured parts get more saturation (greens also lean a little toward a fresh yellow-green), greys,
-- whites and stone stay as they are, and nothing is pushed into a blown-out near-white (it read white on a phone).
-- Numbers only (r, g, b in 0..1), so tests/test_vibe_grade.luau runs it offline and the Studio lobby build
-- (tools/studio/lobby_redesign/gen_build.py inlines this file) applies the very same function.
-- Always lift from the part's ORIGINAL colour (the build keeps it in a VibeBase attribute), so a re-run never stacks.

local VibeGrade = {}

VibeGrade.NeutralSat = 0.17 -- below this a colour is grey / white / stone and is left alone
VibeGrade.GreenHue = { Lo = 0.17, Hi = 0.47, Target = 0.3, Pull = 0.6 } -- greens pull 60% to ONE lime-leaf green
-- (r29d runner: yellow-lime in front, teal-neon in places; one even lime grass reads cleaner)
-- (r29 runner: 0.29 / 0.72 read neon yellow-green in full sun)
VibeGrade.SatMul, VibeGrade.SatAdd, VibeGrade.SatMax = 1.3, 0.05, 0.9
VibeGrade.GreenSatMul, VibeGrade.GreenSatMax = 1.35, 0.62 -- grass stays natural, not neon
VibeGrade.ValMul, VibeGrade.ValMax = 1.06, 0.93
-- pale warm surfaces (sand paths, peach tiles) blew out in the 3.13 sun (r29 runner): no brighter than this
VibeGrade.PaleSat, VibeGrade.PaleValMax = 0.5, 0.78

-- Lighting: carter's favourite "old brightness" look (2026-10-15, screenshot of the pre-redesign lobby: deep blue sky,
-- crisp shadows, saturated grass, no grey haze). These are the exact Lighting values of that place (FindThePet_newest
-- .rbxlx, 2026-10-12 Studio save; default.project.json carries the same set). The build applies all of them and keeps
-- the round 26-28 values only as RedesignOld_* attributes. Two grades stack, as in the old place.
VibeGrade.Lighting = {
	Brightness = 3.13,
	ExposureCompensation = 0,
	ClockTime = 15.4, -- r29d runner: a lower sun for longer, clearer shadows (old 14.6)
	GeographicLatitude = 38,
	Ambient = { 0.4, 0.4, 0.42 },
	OutdoorAmbient = { 0.32, 0.34, 0.43 }, -- r29d runner: darker, cool shade so shadows read (old 0.46 grey)
	ColorShiftTop = { 1, 0.94, 0.84 },
	-- r29g: this Studio has no Technology property (carter could not find it); the newer Lighting Style "Realistic"
	-- gives crisp sun shadows ("Soft" is the blurry one). Scripts may not set it, then it is set by hand.
	LightingStyle = "Realistic",
	ShadowSoftness = 0, -- r29g: fully crisp edges (0.15 still read soft) -- r29 runner: crisp dark shadows like the old shot (was 0.55)
	EnvironmentDiffuseScale = 0.25, -- less sky fill in the shade (old 0.45)
	EnvironmentSpecularScale = 0.15,
	ColorCorrection = { Saturation = 0.14, Contrast = 0.04, Brightness = 0, Tint = { 1, 1, 1 } },
	Grade = { Saturation = 0.06, Contrast = 0.08, Brightness = 0.01, Tint = { 1, 0.985, 0.955 } },
	-- r29 runner: the warm haze washed the far yards and mountains and paled the sky at the horizon; a thin clear-blue
	-- air keeps the depth, no haze
	-- r29e runner: "slight horizon brightening": a deeper blue air so the horizon stays sky blue
	Atmosphere = { Density = 0.12, Offset = 0.3, Color = { 0.62, 0.78, 0.98 }, Decay = { 0.45, 0.62, 0.9 }, Glare = 0, Haze = 0 },
	Bloom = { Intensity = 0.06, Size = 12, Threshold = 2.4 },
	TerrainClouds = false, -- the old sky had only the blocky low-poly clouds (the build adds them), no soft Terrain layer
}

local function toHsv(r: number, g: number, b: number): (number, number, number)
	local mx, mn = math.max(r, g, b), math.min(r, g, b)
	local d = mx - mn
	local h = 0
	if d > 0 then
		if mx == r then
			h = ((g - b) / d) % 6
		elseif mx == g then
			h = (b - r) / d + 2
		else
			h = (r - g) / d + 4
		end
		h /= 6
	end
	local s = if mx > 0 then d / mx else 0
	return h, s, mx
end

local function fromHsv(h: number, s: number, v: number): (number, number, number)
	local i = math.floor(h * 6) % 6
	local f = h * 6 - math.floor(h * 6)
	local p, q, t = v * (1 - s), v * (1 - f * s), v * (1 - (1 - f) * s)
	if i == 0 then
		return v, t, p
	elseif i == 1 then
		return q, v, p
	elseif i == 2 then
		return p, v, t
	elseif i == 3 then
		return p, q, v
	elseif i == 4 then
		return t, p, v
	end
	return v, p, q
end
VibeGrade.toHsv, VibeGrade.fromHsv = toHsv, fromHsv

function VibeGrade.isGreen(h: number): boolean
	return h >= VibeGrade.GreenHue.Lo and h <= VibeGrade.GreenHue.Hi
end

-- The lifted colour of (r, g, b).
function VibeGrade.lift(r: number, g: number, b: number): (number, number, number)
	local h, s, v = toHsv(r, g, b)
	if s < VibeGrade.NeutralSat then
		return r, g, b
	end
	local s2, v2
	if VibeGrade.isGreen(h) then
		local gh = VibeGrade.GreenHue
		h += (gh.Target - h) * gh.Pull
		s2 = math.min(VibeGrade.GreenSatMax, math.max(s, s * VibeGrade.GreenSatMul + VibeGrade.SatAdd))
	else
		s2 = math.min(VibeGrade.SatMax, math.max(s, s * VibeGrade.SatMul + VibeGrade.SatAdd))
	end
	-- light, pale colours (paving, sand) get colour, not more light: they already read near white on a phone
	v2 = if v >= VibeGrade.ValMax then v else math.min(VibeGrade.ValMax, v * VibeGrade.ValMul)
	if not VibeGrade.isGreen(h) and s < VibeGrade.PaleSat and v2 > VibeGrade.PaleValMax then
		v2 = math.max(VibeGrade.PaleValMax, math.min(v2, v) - 0.04) -- pale paving: colour up, light a touch down
	end
	return fromHsv(h, s2, v2)
end

-- Hex in, hex out (lowercase, no #), for the build script and the tests.
function VibeGrade.liftHex(hex: string): string
	local r = tonumber(string.sub(hex, 1, 2), 16) or 0
	local g = tonumber(string.sub(hex, 3, 4), 16) or 0
	local b = tonumber(string.sub(hex, 5, 6), 16) or 0
	local r2, g2, b2 = VibeGrade.lift(r / 255, g / 255, b / 255)
	local function byte(x: number): number
		return math.clamp(math.floor(x * 255 + 0.5), 0, 255)
	end
	return string.format("%02x%02x%02x", byte(r2), byte(g2), byte(b2))
end

-- Textured part materials that flatten colour; the flat-shaded low-poly look wants a clean surface. Big grass and soil
-- tops become SmoothPlastic so the green reads as green on a phone. Other materials stay.
VibeGrade.FlatMaterials = { Grass = true, Ground = true }

return VibeGrade
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="209">
        <Properties>
          <string name="Name">WhatsNew</string>
          <string name="Source"><![CDATA[--!strict
-- WHAT'S NEW: the short update notes shown on the park's WHAT'S NEW board and once per version in a pop-up.
-- To announce an update: change Version (any new string) and the 3-5 Lines. Every player then sees the pop-up once;
-- the server stores the last version a player saw in the profile field LastSeenNews (SettingsAction).

local WhatsNew = {}

WhatsNew.Version = "2026.10.11"
WhatsNew.Title = "WHAT'S NEW"
WhatsNew.Lines = {
	"New jungle Pet Park lobby!",
	"Your own plot shows off your pets",
	"Visit other plots and tap LIKE",
	"Most liked plot wears the crown",
	"Boards: Rarest Pet and Highest Floor",
}

-- Pop-up rule: show when this version was not seen yet. Brand-new players finish the tutorial first.
function WhatsNew.shouldShow(lastSeen: any, onboardDone: boolean): boolean
	return onboardDone and lastSeen ~= WhatsNew.Version
end

-- Server rule for the intent: only the current version can be stored (nothing else is accepted).
function WhatsNew.accept(value: any): string?
	if type(value) == "string" and value == WhatsNew.Version then
		return value
	end
	return nil
end

return WhatsNew
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="210">
        <Properties>
          <string name="Name">WorldKit</string>
          <string name="Source"><![CDATA[--!strict
-- The owner's hand-made low-poly world meshes, imported in Studio into ReplicatedStorage.WorldKit_LowPoly
-- (docs/OWNER_STEPS.md "Low-poly world kit"). Shared: the client (pile eggs) and the server (nest tables, hunt pads,
-- LAST WINNERS board) both read it. Without the folder, or without a piece, has() is false and every caller builds
-- its old look (the place file in the repo has none of these, so the fallback is what tests and the preview run).
--
-- Expected pieces (each one MeshPart, or a Model holding one; "Name.001" counts as Name):
--   HuntEgg_Pink, HuntEgg_Blue, HuntEgg_Green, HuntEgg_Yellow   pile eggs (GeodeModel.rockShell)
--   NestTable                                                     the hatch nest table body (StationModels)
--   StonePad                                                      one hunt pad under each nest table (HuntLowPoly)
--   NoticeBoard                                                   the lobby LAST WINNERS board (WinnerBoard)
-- Assumed import (confirmed by Studio): sized in studs, textured (the TextureID is kept), front faces -Z. The pivot
-- may be at the base; this module never relies on it: a MeshPart's CFrame is its bounding-box centre, so callers
-- place pieces with fitBox / onFloor (bottom of the box on the floor).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldKit = {}

WorldKit.Folder = "WorldKit_LowPoly"
WorldKit.Eggs = { "HuntEgg_Pink", "HuntEgg_Blue", "HuntEgg_Green", "HuntEgg_Yellow" }
WorldKit.Names = { "HuntEgg_Pink", "HuntEgg_Blue", "HuntEgg_Green", "HuntEgg_Yellow", "NestTable", "StonePad", "NoticeBoard" }

local cache: { [string]: MeshPart }? = nil
-- an incomplete set is rescanned at most every RESCAN seconds (a pile builds hundreds of eggs in one go)
local RESCAN = 2
local partial: { [string]: MeshPart }? = nil
local partialAt = -math.huge
local function sources(): { [string]: MeshPart }
	if cache then
		return cache
	end
	if partial and os.clock() - partialAt < RESCAN then
		return partial
	end
	local found: { [string]: MeshPart } = {}
	local root = ReplicatedStorage:FindFirstChild(WorldKit.Folder)
	if not root then
		partial, partialAt = found, os.clock()
		return found
	end
	for _, d in root:GetDescendants() do
		if d:IsA("MeshPart") then
			local base = string.gsub(d.Name, "%.%d+$", "")
			-- a piece imported as a Model: the Model carries the name, its MeshPart may not
			local parent = d.Parent
			if not table.find(WorldKit.Names, base) and parent and parent:IsA("Model") then
				base = string.gsub(parent.Name, "%.%d+$", "")
			end
			found[base] = found[base] or d
		end
	end
	-- only cache a complete set (the client may see the folder before every mesh replicated)
	for _, name in WorldKit.Names do
		if not found[name] then
			partial, partialAt = found, os.clock()
			return found
		end
	end
	cache = found
	return found
end

-- True when every named piece is present.
function WorldKit.has(...: string): boolean
	local s = sources()
	for _, n in { ... } do
		if not s[n] then
			return false
		end
	end
	return true
end

-- The piece's natural size in studs (nil when missing).
function WorldKit.size(name: string): Vector3?
	local src = sources()[name]
	return if src then src.Size else nil
end

-- A visual-only copy of `name` (anchored, no collision, no queries, no touch, texture kept), unparented and unplaced.
function WorldKit.clone(name: string, partName: string?): MeshPart?
	local src = sources()[name]
	if not src then
		return nil
	end
	local p = src:Clone()
	for _, ch in p:GetChildren() do
		if not ch:IsA("SurfaceAppearance") then
			ch:Destroy()
		end
	end
	p.Name = partName or name
	p.Transparency = 0
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.PivotOffset = CFrame.identity
	return p
end

-- Stretches `p` per axis to `size` and centres it on `centre` (a box CFrame: the old part's CFrame and Size).
function WorldKit.fitBox(p: BasePart, centre: CFrame, size: Vector3)
	p.Size = size
	p.CFrame = centre
end

-- Stands `p` on `floor` (a floor-level frame): the bottom of its box on the floor, centred in X and Z.
function WorldKit.onFloor(p: BasePart, floor: CFrame)
	p.CFrame = floor * CFrame.new(0, p.Size.Y / 2, 0)
end

return WorldKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="211">
        <Properties>
          <string name="Name">ZoneThemes</string>
          <string name="Source"><![CDATA[--!strict
-- Per-zone arena look (audit: every zone used the one Meadow arena). The arena is built once per slot as the meadow
-- (ArenaBuilder) and re-skinned per round for the hunt's tier (ArenaBuilder.applyZone, called by MatchService
-- when a round starts): ground colours and materials, a tint on the boundary hills and trees, and one procedural
-- landmark set per zone (no asset ids). Pure data plus the placement spots, so tests/test_zone_themes.luau can check it.
--
-- Keys are tier ids (Config.TierOrder, code names): Gravel = Meadow, Quarry = Forest, Cavern = Snow,
-- Volcanic = Volcano, Meteor = Space. Material values are Enum.Material item names (strings, so this module loads
-- outside Roblox); ArenaBuilder turns them into Enum.Material.

local ZoneThemes = {}

-- Arena layout facts the scenery must respect (ArenaBuilder reads these, so there is one source of truth).
-- Arena-local studs, mound centre is the origin, -Z is north.
ZoneThemes.Layout = {
	Apothem = 43, -- inner face of the invisible containment octagon (play area ~86 studs across)
	BenchY = -9, -- top of the lower bench beyond the east drop
	DropX = 44, -- the main floor ends here (east); beyond it the ground is the bench
	RingOut = 7, -- landmark ring: this many studs outside the octagon side (behind the fence and the bounds wall)
	-- the north road beyond the gate: nothing may stand in it
	RoadHalfWidth = 9,
}

-- Directions (deg; x = cos, z = sin) of the landmark ring spots. They avoid the open east drop (|deg| < 25),
-- the north gate and road (255..285) and the kit trees/bushes ArenaBuilder already places outside the fence.
ZoneThemes.RingAngles = { 45, 82, 107, 145, 182, 205, 228, 296, 320 }

-- The hero landmark stands on the lower bench, seen across the east drop from every table (bearing about -17 deg,
-- inside the open east side), clear of the bench hay bales, bushes and trees.
ZoneThemes.HeroSpot = Vector3.new(92, -9, -28)
-- Space only: the planet and its moon hang in the sky east of the arena (well inside the 260-stud slot spacing).
ZoneThemes.PlanetSpot = Vector3.new(140, 62, -40)
ZoneThemes.MoonSpot = Vector3.new(108, 78, 26)

export type Theme = {
	Id: string, -- tier id
	Zone: string, -- player-facing zone name
	Floor: Color3, -- main play floor
	FloorMaterial: string,
	Bench: Color3, -- lower ground beyond the east drop
	BenchMaterial: string,
	Band: Color3, -- perimeter band tone (mixed half and half with Floor)
	BandMaterial: string,
	Path: Color3, -- worn routes and the north road
	PathMaterial: string,
	Hill: Color3, -- boundary hill domes are tinted toward this ...
	HillMix: number, -- ... by this much (0 = the meadow greens)
	HillMaterial: string,
	Leaf: Color3, -- tree crowns, bushes and hedges
	LeafMix: number,
	LeafMaterial: string,
	Trunk: Color3,
	TrunkMix: number,
	Rock: Color3, -- landmark rocks / crystals / trunk of the hero
	RockMaterial: string,
	Accent: Color3, -- landmark accent (flower hearts, leaves, ice glints, lava, crystal glow)
	Light: Color3?, -- arena-local PointLight colour on the hero landmark (nil: none)
	Landmark: string, -- "Flowers" | "BigTree" | "IceRocks" | "LavaRocks" | "Crystals"
	KeepMeadowFlowers: boolean, -- keep the flower beds just inside the fence
	-- Low-poly set (HuntLowPoly): Color tints on the owner's meshes, so the shared Meadow pieces read as this zone.
	Stone: Color3, -- hex stepping stones (Hunt_Pads) and the StonePad under each nest
	Wood: Color3, -- wood deck, stalls and fence (Hunt_Ledge, Hunt_Stalls, Hunt_Fence); white = mesh as built
	Boulder: Color3?, -- grey boulders and flat stone slabs (Rock, Kit_Rock_A); nil = the Meadow tints
	GroundTint: Color3?, -- tint on the low-poly ground mesh (nil = as built)
	LeafTint: Color3?, -- tint on the tree and bush props (nil = as built)
	ExtraTrees: boolean, -- Forest: extra, taller trees in clusters at the edges
	HideWater: boolean, -- Space: no sea (Hunt_Water) behind the arena
	Craters: boolean, -- Space: craters and crystal clusters on the ground outside the play area
}

-- Every material name a theme may use (all real Enum.Material items; the test checks themes stay inside this list).
ZoneThemes.Materials = {
	Grass = true, LeafyGrass = true, Ground = true, Sand = true, Snow = true, Glacier = true, Ice = true,
	Basalt = true, CrackedLava = true, Rock = true, Slate = true, Pebble = true, Neon = true, Glass = true,
	SmoothPlastic = true, Wood = true, Mud = true, Asphalt = true,
}

local rgb = Color3.fromRGB

ZoneThemes.Themes = {
	-- Meadow: exactly the colours the arena is built with (ArenaKit C.Floor / C.Bench / C.FloorDark, hill greens).
	Gravel = {
		Id = "Gravel", Zone = "Meadow",
		Floor = rgb(112, 190, 84), FloorMaterial = "Grass",
		Bench = rgb(128, 200, 96), BenchMaterial = "Grass",
		Band = rgb(150, 214, 104), BandMaterial = "Grass",
		Path = rgb(214, 180, 118), PathMaterial = "SmoothPlastic",
		Hill = rgb(104, 180, 84), HillMix = 0, HillMaterial = "Grass",
		Leaf = rgb(74, 170, 78), LeafMix = 0, LeafMaterial = "Grass",
		Trunk = rgb(150, 96, 64), TrunkMix = 0,
		Rock = rgb(70, 150, 70), RockMaterial = "Grass",
		Accent = rgb(255, 204, 70),
		Light = nil,
		Landmark = "Flowers",
		KeepMeadowFlowers = true,
		Stone = rgb(255, 205, 140), Wood = rgb(255, 255, 255), Boulder = nil,
		GroundTint = nil, LeafTint = nil,
		ExtraTrees = false, HideWater = false, Craters = false,
	},
	Quarry = {
		Id = "Quarry", Zone = "Forest",
		Floor = rgb(62, 124, 56), FloorMaterial = "LeafyGrass",
		Bench = rgb(56, 114, 52), BenchMaterial = "LeafyGrass",
		Band = rgb(120, 98, 70), BandMaterial = "Ground",
		Path = rgb(150, 112, 78), PathMaterial = "SmoothPlastic",
		Hill = rgb(36, 96, 48), HillMix = 0.75, HillMaterial = "LeafyGrass",
		Leaf = rgb(26, 86, 40), LeafMix = 0.75, LeafMaterial = "Grass",
		Trunk = rgb(104, 70, 48), TrunkMix = 0.5,
		Rock = rgb(112, 76, 52), RockMaterial = "Wood",
		Accent = rgb(40, 104, 50),
		Light = nil,
		Landmark = "BigTree",
		KeepMeadowFlowers = false,
		Stone = rgb(98, 120, 86), Wood = rgb(150, 112, 86), Boulder = rgb(86, 108, 76),
		GroundTint = nil, LeafTint = rgb(140, 180, 130),
		ExtraTrees = true, HideWater = false, Craters = false,
	},
	Cavern = {
		Id = "Cavern", Zone = "Snow",
		Floor = rgb(236, 244, 252), FloorMaterial = "Snow",
		Bench = rgb(226, 238, 250), BenchMaterial = "Snow",
		Band = rgb(196, 220, 240), BandMaterial = "Snow",
		Path = rgb(198, 210, 226), PathMaterial = "SmoothPlastic",
		Hill = rgb(244, 250, 255), HillMix = 0.85, HillMaterial = "Snow",
		Leaf = rgb(232, 244, 250), LeafMix = 0.6, LeafMaterial = "Snow",
		Trunk = rgb(110, 92, 84), TrunkMix = 0.4,
		Rock = rgb(150, 210, 240), RockMaterial = "Glacier",
		Accent = rgb(214, 244, 255),
		Light = rgb(170, 220, 255),
		Landmark = "IceRocks",
		KeepMeadowFlowers = false,
		Stone = rgb(150, 182, 214), Wood = rgb(222, 236, 255), Boulder = rgb(160, 188, 216),
		GroundTint = nil, LeafTint = nil,
		ExtraTrees = false, HideWater = false, Craters = false,
	},
	Volcanic = {
		Id = "Volcanic", Zone = "Volcano",
		Floor = rgb(92, 76, 72), FloorMaterial = "Basalt",
		Bench = rgb(70, 58, 56), BenchMaterial = "CrackedLava",
		Band = rgb(60, 50, 50), BandMaterial = "Basalt",
		Path = rgb(126, 96, 80), PathMaterial = "SmoothPlastic",
		Hill = rgb(66, 54, 54), HillMix = 0.85, HillMaterial = "Basalt",
		Leaf = rgb(84, 64, 56), LeafMix = 0.75, LeafMaterial = "Ground",
		Trunk = rgb(48, 38, 36), TrunkMix = 0.7,
		Rock = rgb(52, 44, 44), RockMaterial = "Basalt",
		Accent = rgb(255, 110, 30),
		Light = rgb(255, 120, 50),
		Landmark = "LavaRocks",
		KeepMeadowFlowers = false,
		Stone = rgb(92, 78, 78), Wood = rgb(226, 158, 108), Boulder = rgb(76, 64, 64),
		GroundTint = nil, LeafTint = nil,
		ExtraTrees = false, HideWater = true, Craters = false,
	},
	Meteor = {
		Id = "Meteor", Zone = "Space",
		Floor = rgb(150, 142, 172), FloorMaterial = "Slate",
		Bench = rgb(122, 114, 150), BenchMaterial = "Slate",
		Band = rgb(104, 96, 136), BandMaterial = "Pebble",
		Path = rgb(182, 176, 200), PathMaterial = "SmoothPlastic",
		Hill = rgb(112, 102, 150), HillMix = 0.8, HillMaterial = "Rock",
		Leaf = rgb(160, 110, 230), LeafMix = 0.7, LeafMaterial = "SmoothPlastic",
		Trunk = rgb(90, 80, 120), TrunkMix = 0.6,
		Rock = rgb(150, 120, 255), RockMaterial = "Glass",
		Accent = rgb(110, 230, 255),
		Light = rgb(170, 140, 255),
		Landmark = "Crystals",
		KeepMeadowFlowers = false,
		Stone = rgb(96, 78, 150), Wood = rgb(200, 178, 240), Boulder = rgb(110, 86, 170),
		GroundTint = rgb(214, 190, 255), LeafTint = nil,
		ExtraTrees = false, HideWater = true, Craters = true,
	},
} :: { [string]: Theme }

ZoneThemes.Default = "Gravel"

-- The theme for a tier id; an unknown or missing id falls back to the Meadow look (never errors mid-round).
function ZoneThemes.get(tierId: string?): Theme
	local t = if tierId then ZoneThemes.Themes[tierId] else nil
	return t or ZoneThemes.Themes[ZoneThemes.Default]
end

-- Distance from the centre to the octagon side along `deg` (sides are normal to 0, 45, 90 ... deg).
function ZoneThemes.octRadius(deg: number, apothem: number): number
	local d = ((deg % 45) + 45) % 45
	local off = math.min(d, 45 - d)
	return apothem / math.cos(math.rad(off))
end

-- Arena-local ground points of the landmark ring (y = floor height there: main floor 0, bench beyond the drop).
function ZoneThemes.ringSpots(): { Vector3 }
	local L = ZoneThemes.Layout
	local out = {}
	for _, deg in ZoneThemes.RingAngles do
		local r = ZoneThemes.octRadius(deg, L.Apothem) + L.RingOut
		local a = math.rad(deg)
		local x, z = math.cos(a) * r, math.sin(a) * r
		table.insert(out, Vector3.new(x, if x > L.DropX then L.BenchY else 0, z))
	end
	return out
end

return ZoneThemes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="212">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="213">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="214">
        <Properties>
          <string name="Name">ArenaBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Private hunt arena: a sunny grassy MEADOW around one shared egg pile (was the quarry worksite; the layout notes
-- below keep the old names: cliffs are now hills and hedges, the hoppers are SHELL SELL stands, the crane is gone).
-- Original notes: a functional worksite around one shared
-- mound. Built from the reusable pieces in ArenaKit; WorldBuilder.buildArena delegates here.
--
-- Layout (arena-local, the mound centre is the origin, -Z is north, angles use x = cos, z = sin):
--   mound pad        irregular dirt/stone patch ~18-21 studs across at the centre
--   tables 1-4       StationModels on the Config.Station.Radius circle at 45/135/225/315 deg,
--                    each on a plain concrete pad (table + the stance in front of it)
--   machine bays 1-4 directly behind each table, on the same line (radius 32.75), so table and machine
--                    read as one station; pad top y = 0.3, MachineModels builds on it. Nothing stands
--                    between the pile and a table (the lanes are bare floor).
--   sell hoppers     two identical ones, south (90 deg) serving tables 1 and 2 and north (270 deg) serving
--                    tables 3 and 4 at radius 30: every table is the same walk (about 21 studs) from one
--                    hopper, and nothing but floor lies on that route (V6 Master 4 section 18).
--   entrance gate    north (270 deg), closed, road beyond between cliff shoulders
--   tool shelter     north edge west of the gate (lean-to, tool wall, workbench)
--   cart bay         south edge east of the hopper: track, buffer stop, ore cart, wheel marks to the hopper
--   equipment nook   west (180 deg): shelter with compressor, generator, tool rack, crates
--   drop + railing   east (0 deg): retaining wall down to a lower bench with crane and conveyor
--   containment      invisible octagon (apothem 43, playable ~86 studs across) and a lid
-- Everything outside the octagon is scenery: terraced strata cliffs (Strata_* meshes, Part stepped cliffs as the
-- fallback) in a lower front row and a taller back row, rubble skirts at their feet. Floor: warm hard-packed
-- ground, a soft dust halo round the mound patch, a perimeter gravel band, compacted routes pile -> table and
-- table -> hopper (flat, no collision, CameraIgnore). The centre stays bare.

local Workspace = game:GetService("Workspace")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local RoundRocks = require(Shared.RoundRocks)
local StationModels = require(script.Parent.StationModels)
local ZoneThemes = require(Shared.ZoneThemes)
local Kit = require(script.Parent.ArenaKit)
local ZoneScenery = require(script.Parent.ZoneScenery)
local HuntLowPoly = require(script.Parent.HuntLowPoly)

local C = Kit.C
local P = Config.Palette
local part, deco = Kit.part, Kit.deco

local ArenaBuilder = {}

local APOTHEM = ZoneThemes.Layout.Apothem -- inner face of the containment octagon (43; zone landmarks stand outside it)
local BAY_RADIUS = 32.75 -- machine bay centre: right behind the table pad (table at Config.Station.Radius)
local HOPPER_RADIUS = 30
local BENCH_Y = ZoneThemes.Layout.BenchY -- lower bench beyond the east drop (-9)
local PAD_TOP = 0.3 -- station and bay pad top (the table kit and MachineModels assume it)
-- Restrained owner accents (same order as StationModels.ACCENTS): small inset and nameplate only.
local OWNER_COLORS = StationModels.Accents

local function dirAt(deg: number): Vector3
	local a = math.rad(deg)
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

-- Distance from the centre to the octagon side along `deg` (sides are normal to 0, 45, 90 ... deg).
local function octRadius(deg: number, apothem: number): number
	local d = ((deg % 45) + 45) % 45
	local off = math.min(d, 45 - d)
	return apothem / math.cos(math.rad(off))
end

-- Normal of the octagon side that `deg` falls on.
local function sideNormal(deg: number): Vector3
	return dirAt(math.floor((deg + 22.5) / 45) * 45)
end

-- Ground --------------------------------------------------------------------------------------

local function buildGround(root: Instance, c: Vector3, rng: Random)
	local g = Kit.folder(root, "CT_Rocks_Ground")
	-- main level (top y = 0) ends at the east drop (x = 44); lower bench beyond it
	part(g, "CT_Rocks_Floor", Vector3.new(124, 2, 210), CFrame.new(c + Vector3.new(-18, -1, -25)), C.Floor, Enum.Material.Grass)
	part(g, "CT_Rocks_Bench", Vector3.new(120, 2, 240), CFrame.new(c + Vector3.new(104, BENCH_Y - 1, -20)), C.Bench, Enum.Material.Grass)

	-- No mound pad under the egg pile any more: its overlapping flat sand discs (and their lobes, re-tinted grey in the
	-- colder zones) read as gold and grey plates lying under the eggs (owner video). The pile sits on the grass.

	-- perimeter gravel band along the foot of the boundary (every octagon side), a soft inner edge
	local gravel = C.Floor:Lerp(Color3.fromRGB(150, 214, 104), 0.5)
	local sideLen = 2 * APOTHEM * math.tan(math.rad(22.5))
	for k = 0, 7 do
		local n = dirAt(k * 45)
		local mid = c + n * (APOTHEM - 2.0)
		local cf = CFrame.lookAt(mid, mid + n)
		Kit.floorPatch(g, "CT_Rocks_GravelBand", cf * CFrame.new(0, 0.03, 0), Vector3.new(sideLen + 1.5, 0.06, 4.6), gravel, Enum.Material.Grass)
		for e = -1, 1 do
			local w = sideLen * rng:NextNumber(0.18, 0.28)
			Kit.floorPatch(g, "CT_Rocks_GravelEdge", cf * CFrame.new(e * sideLen * 0.3 + rng:NextNumber(-2, 2), 0.02, -2.6) * CFrame.Angles(0, rng:NextNumber(-0.06, 0.06), 0), Vector3.new(w, 0.04, 2.2), gravel:Lerp(C.Floor, 0.5), Enum.Material.Grass)
		end
	end

	-- compacted routes: mound edge -> each table's stance, and each table -> its sell hopper (south for the
	-- two tables with z > 0, north for the others). Flat, a shade darker than the floor, no collision.
	local worn = C.Floor:Lerp(C.FloorDark, 0.55)
	local function route(a: Vector3, b: Vector3, width: number)
		local mid = (a + b) / 2
		local len = (b - a).Magnitude
		local cf = CFrame.lookAt(mid, b)
		Kit.floorPatch(g, "CT_Rocks_Route", cf * CFrame.new(0, 0.018, 0), Vector3.new(width, 0.03, len), worn, Enum.Material.Ground)
		Kit.floorPatch(g, "CT_Rocks_RouteEdge", cf * CFrame.new(rng:NextNumber(-0.4, 0.4), 0.014, 0) * CFrame.Angles(0, rng:NextNumber(-0.05, 0.05), 0), Vector3.new(width * 1.45, 0.025, len * 0.9), C.Floor:Lerp(worn, 0.45), Enum.Material.Ground)
	end
	for i = 1, Config.Station.Count do
		local dir = RoundRocks.stationPosition(i).Unit
		route(c + dir * 9.5, c + dir * (Config.Station.Radius - 6.5), 3.4)
		local hopper = c + dirAt(if dir.Z > 0 then 90 else 270) * (HOPPER_RADIUS - 4)
		-- from the stance in front of the table (clear of the table body) to the hopper
		route(c + dir * (Config.Station.Radius - 5.5), hopper, 2.4)
	end
	-- the road outside the gate
	part(g, "CT_Rocks_Road", Vector3.new(14, 0.1, 70), CFrame.new(c + Vector3.new(0, 0.05, -80)), C.FloorDark, Enum.Material.SmoothPlastic)
end

-- Stations and bays --------------------------------------------------------------------------

local function buildStations(root: Instance, c: Vector3): ({ Model }, { CFrame })
	local stations = Kit.folder(root, "CT_Rocks_StationPads")
	for i = 1, Config.Station.Count do
		local rel = RoundRocks.stationPosition(i)
		local cf = CFrame.lookAt(c + rel, c)
		local pad = Kit.model(stations, "CT_Rocks_StationPad_" .. i)
		-- One plain concrete slab under the table and the stance in front of it (table frame: -Z toward
		-- the pile, the player stands at z -5): a low outer apron plus the slab, no paint, no glow.
		deco(part(pad, "Apron", Vector3.new(12.2, 0.14, 9.4), cf * CFrame.new(0, 0.07, -1.6), C.PadConcrete:Lerp(C.Dust, 0.3), Enum.Material.WoodPlanks))
		part(pad, "Pad", Vector3.new(11.6, PAD_TOP, 8.8), cf * CFrame.new(0, PAD_TOP / 2, -1.6), C.PadConcrete, Enum.Material.WoodPlanks)
		-- owner mark: one small muted inset with the table number at the front corner of the slab
		local tint = OWNER_COLORS[i] or P.Orange
		-- (no digit on it any more: a single figure on a 1.5 stud disc could only fill a third of it and the table number
		-- is now on the table's own timber sign; the disc stays as the owner's colour mark)
		deco(part(pad, "Number", Vector3.new(0.06, 1.5, 1.5), cf * CFrame.new(-4.6, PAD_TOP + 0.03, -5.0) * CFrame.Angles(0, 0, math.rad(90)), tint, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder))
		-- one work light on the back corner of the slab (beside the machine bay, never in front of the table)
		local light = Kit.kitProp(pad, "Prop_WorkLight", cf * CFrame.new(-5.6, PAD_TOP, 2.3) * CFrame.Angles(0, math.rad(25), 0), 0.8)
		if light and light.PrimaryPart then
			local l = Instance.new("PointLight")
			l.Range = 14
			l.Brightness = 0.5
			l.Color = Color3.fromRGB(255, 226, 170)
			l.Parent = light.PrimaryPart
		end
	end
	local tables = StationModels.buildAll(c, root, PAD_TOP) -- the tables stand ON their pads

	local bays = {}
	for i = 1, Config.Station.Count do
		local dir = RoundRocks.stationPosition(i).Unit
		local pos = c + dir * BAY_RADIUS
		local cf = CFrame.lookAt(pos, Vector3.new(c.X, c.Y, c.Z))
		local bay = Kit.model(root, "CT_Rocks_MachineBay_" .. i)
		-- the machine slot continues the table slab straight back (same concrete, same width class)
		-- snug: just wider than the machine, joined to the table slab at its back edge (the old slab was 11.4 x 10)
		part(bay, "Pad", Vector3.new(9.6, PAD_TOP, 8.9), cf * CFrame.new(0, PAD_TOP / 2, -0.65), C.PadConcrete, Enum.Material.WoodPlanks)
		-- machine clearance: four amber corner brackets, nothing else
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				local corner = cf * CFrame.new(sx * 4.3, PAD_TOP + 0.01, sz * 3.5)
				deco(part(bay, "Clearance", Vector3.new(1.4, 0.03, 0.22), corner * CFrame.new(-sx * 0.6, 0, 0), C.Amber, Enum.Material.SmoothPlastic))
				deco(part(bay, "Clearance", Vector3.new(0.22, 0.03, 1.4), corner * CFrame.new(0, 0, -sz * 0.6), C.Amber, Enum.Material.SmoothPlastic))
			end
		end
		table.insert(bays, cf)
	end
	return tables, bays
end

-- Boundary ------------------------------------------------------------------------------------

-- True where the boundary is open (east drop) or used by a feature (north gate).
local function isOpening(deg: number): boolean
	local d = deg % 360
	return d < 21 or d > 339 or math.abs(d - 270) < 13
end

local function buildBoundary(root: Instance, c: Vector3, rng: Random)
	local edge = Kit.folder(root, "CT_Rocks_Boundary")
	-- front row: low rolling green hills on the octagon sides (the sky stays in view), hedges in front of them
	local deg = 21
	while deg < 339 do
		local w = rng:NextNumber(20, 26)
		local r = octRadius(deg, APOTHEM + 2.5)
		local step = math.deg(w * 0.95 / r)
		local mid = deg + step / 2
		if not isOpening(mid) then
			local n = sideNormal(mid)
			local pos = c + dirAt(mid) * octRadius(mid, APOTHEM + 2.5)
			Kit.hill(edge, CFrame.lookAt(pos, pos - n), w, rng:NextNumber(7, 10), rng)
		end
		deg += step
	end
	-- back row: taller hills behind, offset so gaps never line up
	deg = 30
	while deg < 330 do
		local w = rng:NextNumber(28, 34)
		local r = octRadius(deg, APOTHEM + 16)
		local step = math.deg(w * 0.95 / r)
		local mid = deg + step / 2
		if math.abs(mid - 270) > 9 then
			local n = sideNormal(mid)
			local pos = c + dirAt(mid) * octRadius(mid, APOTHEM + 16)
			Kit.hill(edge, CFrame.lookAt(pos, pos - n), w, rng:NextNumber(13, 19), rng)
		end
		deg += step
	end
	-- north road: hills either side of the path beyond the gate
	for _, s in { -1, 1 } do
		for k = 0, 1 do
			local pos = c + Vector3.new(s * 11, 0, -52 - k * 22)
			Kit.hill(edge, CFrame.lookAt(pos, pos + Vector3.new(-s, 0, 0)), 21, 9 + k * 3, rng)
		end
	end
	-- distant low hills past the lower meadow (east)
	for k = -2, 2 do
		local pos = c + Vector3.new(118 + rng:NextNumber(-4, 4), BENCH_Y, k * 34)
		Kit.hill(edge, CFrame.lookAt(pos, pos + Vector3.new(-1, 0, 0)), 34, 14, rng)
	end

	-- hedges, bushes and round trees between the fence and the hills, at free spots only (not behind the stands,
	-- the nook, the gate, the tool shelter or the lamp post)
	for _, a in { 28, 52, 112, 128, 150, 212, 236, 250, 302, 326 } do
		local pos = c + dirAt(a) * (octRadius(a, APOTHEM) + 1.8)
		Kit.bushCluster(edge, pos, rng:NextNumber(1.0, 1.4), rng)
		local tpos = c + dirAt(a + 7) * (octRadius(a + 7, APOTHEM) + 6)
		Kit.tree(edge, tpos, rng:NextNumber(1.0, 1.5), rng)
	end
	for _, a in { 70, 95, 170, 195, 345 } do
		Kit.tree(edge, c + dirAt(a) * (octRadius(a, APOTHEM) + 9), rng:NextNumber(1.2, 1.7), rng)
	end
	-- flower patches inside the fence line and out on the lower meadow
	local flowers = Kit.folder(edge, "Flowers")
	for _ = 1, 90 do
		local a = rng:NextNumber(0, 360)
		local rr = octRadius(a, APOTHEM) - rng:NextNumber(2.2, 6)
		local fp = c + dirAt(a) * rr
		if not isOpening(a) and (fp - c).Magnitude > 20 then
			Kit.flower(flowers, Vector3.new(fp.X, 0, fp.Z), rng)
		end
	end
	for _ = 1, 24 do
		Kit.flower(flowers, c + Vector3.new(rng:NextNumber(52, 90), BENCH_Y, rng:NextNumber(-40, 40)), rng)
	end

	-- east drop: retaining wall down to the bench, railing along the edge. (No "STEP DOWN / MIND THE EDGE" placard any
	-- more: on a phone it was tiny unreadable text beside the HUD, and the railing plus the invisible boundary already
	-- keep everyone on the meadow.)
	Kit.retainingWall(edge, CFrame.lookAt(c + Vector3.new(44.6, 0, 0), c + Vector3.new(100, 0, 0)), 64, -BENCH_Y, BENCH_Y)
	Kit.railing(edge, c + Vector3.new(42.4, 0, -18), c + Vector3.new(42.4, 0, 18))
	-- (no traffic cones at the rail ends: they touched the rim rails and were clutter, Master 8 section 5)
	-- south: short retaining wall where the cut face sits behind the hopper
	Kit.retainingWall(edge, CFrame.lookAt(c + Vector3.new(0, 0, 44.4), c), 22, 6, 0)

	-- north: entrance gate (closed)
	Kit.gate(edge, CFrame.lookAt(c + Vector3.new(0, 0, -44.5), c), 12)

	-- timber fence rim along the foot of the cliffs (not at the east drop, which has its own railing, and
	-- with a gap at the north gate)
	for k = 1, 7 do
		local side = k * 45
		local a = c + dirAt(side - 22.5) * octRadius(side - 22.5, APOTHEM - 0.9)
		local b = c + dirAt(side + 22.5) * octRadius(side + 22.5, APOTHEM - 0.9)
		if side == 180 then
			-- the equipment nook stands against the west boundary: the rail stops either side of it
			Kit.railing(edge, a:Lerp(b, 0.03), a:Lerp(b, 0.2))
			Kit.railing(edge, a:Lerp(b, 0.8), b:Lerp(a, 0.03))
		elseif side ~= 270 then
			Kit.railing(edge, a:Lerp(b, 0.03), b:Lerp(a, 0.03))
		else
			Kit.railing(edge, a:Lerp(b, 0.03), a:Lerp(b, 0.30))
			Kit.railing(edge, a:Lerp(b, 0.70), b:Lerp(a, 0.03))
		end
	end

	-- background: a few hay bales on the lower meadow
	Kit.hayBale(edge, CFrame.new(c + Vector3.new(68, BENCH_Y, -15)) * CFrame.Angles(0, 0.4, 0))
	Kit.hayBale(edge, CFrame.new(c + Vector3.new(71, BENCH_Y, -12)) * CFrame.Angles(0, -0.2, 0))
	Kit.bushCluster(edge, c + Vector3.new(66, BENCH_Y, 12), 1.4, rng)
	Kit.bushCluster(edge, c + Vector3.new(100, BENCH_Y, 6), 1.6, rng)
	Kit.tree(edge, c + Vector3.new(84, BENCH_Y, -6), 1.6, rng)
	Kit.tree(edge, c + Vector3.new(90, BENCH_Y, 22), 1.4, rng)
end

-- Equipment nook, lamps, utility props --------------------------------------------------------

local function buildWorksite(root: Instance, c: Vector3, rng: Random)
	local site = Kit.folder(root, "CT_Rocks_Worksite")
	-- west equipment nook
	local front = c + Vector3.new(-34.5, 0, 0)
	local ncf = CFrame.lookAt(front, c) -- -Z faces the arena, +Z goes back toward the wall
	Kit.shelter(site, ncf, 15, 8)
	-- picnic corner: hay bales and crates under the shelter (the old generator / compressor / tool rack are gone)
	Kit.hayBale(site, ncf * CFrame.new(-4.5, 0.3, 4.6) * CFrame.Angles(0, 0.2, 0))
	Kit.hayBale(site, ncf * CFrame.new(-1.4, 0.3, 5.0) * CFrame.Angles(0, -0.15, 0))
	Kit.hayBale(site, ncf * CFrame.new(-3.0, 2.5, 4.8) * CFrame.Angles(0, 0.4, 0))
	Kit.pallet(site, ncf * CFrame.new(5.2, 0.3, 1.8))
	Kit.crate(site, ncf * CFrame.new(5.0, 0.82, 1.6), 2)
	Kit.crate(site, ncf * CFrame.new(9.2, 0, -0.5) * CFrame.Angles(0, 0.4, 0), 1)
	Kit.crate(site, ncf * CFrame.new(4.0, 0.3, 5.4) * CFrame.Angles(0, 0.3, 0), 3)

	-- One lamp mast on the east edge, 9.4 studs tall. The old four masts stood 22 degrees off the table axes and
	-- crossed the first-person table view; this one is 70 degrees off every table's line of sight (the nook has
	-- its own lanterns and work light, the cut face wall lamps, the gate its own light).
	do
		local pos = c + Vector3.new(40.6, 0, 0)
		Kit.lampMast(site, CFrame.lookAt(pos, Vector3.new(c.X, pos.Y, c.Z)), true)
	end

	-- Two identical SHELL SELL stands on the free edges: south (tables 1 and 2) and north (tables 3 and 4), so
	-- the sale walk is the same short route for every table (about 21 studs) and no table sits behind
	-- the crane, a cliff or the pile. Each stands on a small concrete apron with one sign and one barrow.
	for _, deg in { 90, 270 } do
		local hpos = c + dirAt(deg) * HOPPER_RADIUS
		local hcf = CFrame.lookAt(hpos, c) -- -Z faces the pile (the side players walk up to)
		deco(part(site, "HopperApron", Vector3.new(10, 0.14, 8), hcf * CFrame.new(0, 0.07, 0), C.PadConcrete:Lerp(C.Dust, 0.2), Enum.Material.WoodPlanks))
		Kit.hopper(site, hcf, rng)
	end
	-- south cut face: kit wall lamps over the retaining wall either side of the south hopper
	for _, sx in { -9, 9 } do
		-- back plate flush on the wall's front face (the kit wall segments stand 0.45 behind the wall line at 44.4)
		local lamp = Kit.kitProp(site, "Wall_Lamp", CFrame.lookAt(c + Vector3.new(sx, 4.6, 44.85), c + Vector3.new(sx, 4.6, 0)), 1.4)
		if lamp and lamp.PrimaryPart then
			local l = Instance.new("PointLight")
			l.Range = 16
			l.Brightness = 0.7
			l.Color = Color3.fromRGB(255, 214, 150)
			l.Parent = lamp.PrimaryPart
		end
	end

	-- utility groups on the free edges (pass four): a lean-to tool shelter west of the gate (open side to the
	-- arena) and a cart bay east of the south hopper (track along the boundary, buffer stop, parked ore cart;
	-- wheel marks lead to the hopper). Both stand outside the pile/table/hopper routes.
	local shelterAt = c + Vector3.new(-12.5, 0, -38.6)
	Kit.toolShelter(site, CFrame.lookAt(shelterAt, shelterAt + Vector3.new(0, 0, 1)))
	Kit.hayBale(site, CFrame.new(c + Vector3.new(10, 0, 40)) * CFrame.Angles(0, 0.3, 0))
	Kit.hayBale(site, CFrame.new(c + Vector3.new(13, 0, 40.5)) * CFrame.Angles(0, -0.2, 0))
	Kit.hayBale(site, CFrame.new(c + Vector3.new(16, 0, -39)) * CFrame.Angles(0, 0.2, 0))
end

-- Containment ---------------------------------------------------------------------------------

local function buildBounds(root: Instance, c: Vector3)
	local b = Kit.folder(root, "CT_Rocks_Bounds")
	local side = 2 * APOTHEM * math.tan(math.rad(22.5)) + 4 -- overlap the corners
	for k = 0, 7 do
		local n = dirAt(k * 45)
		local w = part(b, "CT_Rocks_Bounds", Vector3.new(side, 90, 2), CFrame.lookAt(c + n * (APOTHEM + 1) + Vector3.new(0, 40, 0), c + Vector3.new(0, 40, 0)), Color3.new(), Enum.Material.SmoothPlastic)
		w.Transparency = 1
		w.CanQuery = false
		w.CanTouch = false
	end
	local lid = part(b, "CT_Rocks_BoundsTop", Vector3.new(2 * APOTHEM + 4, 2, 2 * APOTHEM + 4), CFrame.new(c + Vector3.new(0, 85, 0)), Color3.new())
	lid.Transparency = 1
	lid.CanQuery = false
	lid.CanTouch = false
end

-- Master Prompt 7 palette (section 3): warm wood, slate stone, charcoal metal, subdued green and ONE amber
-- accent; fewer bright lamps and yellow strips. One pass over the built arena (tables keep their own state
-- light, machines are built later by MachineModels): scenery neon lamp faces become warm matte glass, scenery
-- amber trims are muted, the bay clearance strips go charcoal, and the lights are fewer and softer.
local WARM_GLASS = Color3.fromRGB(255, 226, 150)
local MUTED_AMBER = Color3.fromRGB(246, 200, 96)
local KEEP_NEON = { Light = true, StateLight = true, Beacon = true, PanelOn = true, PanelOff = true, ReceiptLight = true }
local AMBER_NAMES = { Amber = true, Amber_Metal = true, Accent = true, Accent_Metal = true, Hazard = true, Stripe = true }
local function calmPalette(root: Instance)
	for _, d in root:GetDescendants() do
		local inStation = d:FindFirstAncestorWhichIsA("Model")
		while inStation and inStation:GetAttribute("StationIndex") == nil do
			inStation = inStation.Parent and inStation.Parent:FindFirstAncestorWhichIsA("Model") or nil
		end
		if inStation then
			continue -- the tables have their own restrained accents and the state light
		end
		if d:IsA("BasePart") then
			if d.Material == Enum.Material.Neon and not KEEP_NEON[d.Name] then
				d.Material = Enum.Material.SmoothPlastic
				d.Color = WARM_GLASS
			elseif d.Name == "Clearance" then
				d.Color = C.Slate:Lerp(C.PadConcrete, 0.3)
			elseif AMBER_NAMES[d.Name] then
				d.Color = MUTED_AMBER
			end
		elseif d:IsA("PointLight") or d:IsA("SpotLight") then
			local light = d :: PointLight -- SpotLight shares Enabled / Brightness / Range / Shadows
			local pad = d:FindFirstAncestor("CT_Rocks_StationPads")
			if pad then
				light.Enabled = false -- the pad work lights stay as unlit fixtures: one lit lamp per corner is enough
			else
				light.Brightness *= 0.6
				light.Range = math.min(light.Range, 14)
				light.Shadows = false
			end
		end
	end
end

-- Decorative pieces the camera must not be pushed in by (cliffs, lamps, props, fences, crane, signs,
-- shield glass, machine hoods): the client camera honours the attribute CameraIgnore. Floors, pads and
-- the boundary invisible walls are left out.
-- (the station pads folder is tagged too: only its walkable Pad / Apron slabs are left out, by name)
local CAMERA_SKIP = { CT_Rocks_Ground = true, CT_Rocks_Bounds = true, Pile = true }
local function tagCameraIgnore(root: Instance)
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") and (d.Name ~= "Pad" and d.Name ~= "Apron" and d.Name ~= "Surface") then
			local top = d
			local skip = false
			while top.Parent and top.Parent ~= root do
				top = top.Parent :: any
			end
			skip = CAMERA_SKIP[top.Name] == true
			if not skip then
				d:SetAttribute("CameraIgnore", true)
			end
		end
	end
end

-- Entry point ---------------------------------------------------------------------------------

-- Builds the arena at centre `c` under Workspace.CT_Rocks_Arena_<slot>. Returns the same fields
-- WorldBuilder.buildArena always returned: Root, Center, Spawns, Bays, Tables, PileFolder,
-- MachineFolder (plus Hopper).
function ArenaBuilder.build(slot: number, c: Vector3): { [string]: any }
	local rng = Random.new(500 + slot)
	local root = Kit.folder(Workspace, "CT_Rocks_Arena_" .. slot)
	buildGround(root, c, rng)
	local tables, bays = buildStations(root, c)
	buildBoundary(root, c, rng)
	buildWorksite(root, c, rng)
	buildBounds(root, c)
	calmPalette(root)
	tagCameraIgnore(root)

	-- Spawn spots: in front of each crushing table, equal distance from the pile and the table,
	-- facing the pile. Which member gets which one rotates between rounds (MatchService).
	local spawns = {}
	for i = 1, Config.Station.Count do
		local dir = RoundRocks.stationPosition(i).Unit
		local pos = c + dir * (Config.Station.Radius - 4.5) + Vector3.new(0, 3, 0)
		table.insert(spawns, CFrame.lookAt(pos, Vector3.new(c.X, 3, c.Z)))
	end

	local hopper = root:FindFirstChild("CT_Rocks_SellHopper", true)
	local pileFolder = Kit.folder(root, "Pile")
	local machineFolder = Kit.folder(root, "CT_Rocks_Machines")
	local arena = { Root = root, Center = c, Spawns = spawns, Bays = bays, Tables = tables, PileFolder = pileFolder, MachineFolder = machineFolder, Hopper = hopper }
	-- built as the meadow; the round start re-skins it for the hunted zone (MatchService -> applyZone)
	ArenaBuilder.applyZone(arena, ZoneThemes.Default)
	return arena
end

-- Shows zone `tierId` (Config.TierOrder id; unknown ids fall back to the Meadow) on a built arena: ground colours,
-- boundary tint and the zone's landmark set (ZoneScenery, theme data in shared/ZoneThemes). The previous zone's
-- landmarks are destroyed first; a no-op when that zone is already shown, so reused arenas swap cleanly per round.
function ArenaBuilder.applyZone(arena: { [string]: any }, tierId: string?)
	local root = arena.Root
	local c = arena.Center
	if typeof(root) ~= "Instance" or typeof(c) ~= "Vector3" then
		return
	end
	ZoneScenery.apply(root, c, ZoneThemes.get(tierId))
	-- the owner's low-poly set for the zone (when its meshes are in the place) covers the procedural one
	HuntLowPoly.apply(root, c, tierId)
end

return ArenaBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="215">
        <Properties>
          <string name="Name">ArenaKit</string>
          <string name="Source"><![CDATA[--!strict
-- Reusable arena kit (V4 arena, docs/ASSET_MANIFEST.md "Arena kit"): quarry cliff forms, base
-- ledges and boulders, retaining walls, railings, lamps, gate, shelter, utility props, the shared
-- sell hopper and the background crane/conveyor. Everything is built from anchored Parts in the
-- chunky low-poly quarry style; each builder is a REPLACE point for an uploaded mesh of the same
-- name (CT_Rocks_<Name>). Local frames: -Z faces the arena (front), +Y is up, origin on the floor.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local KitPlace = require(script.Parent.KitPlace)
-- soft Blender meadow props (trees, bushes, hills, hedges, flowers); nil-safe: falls back to the ball props
local MeadowKit: any = nil
do
	local mod = script.Parent:FindFirstChild("MeadowKit")
	if mod and mod:IsA("ModuleScript") then
		local ok, m = pcall(require, mod)
		if ok then
			MeadowKit = m
		end
	end
end
local function meadow(name: string): boolean
	return MeadowKit ~= nil and MeadowKit.has(name)
end

local Kit = {}

-- The meadow never uses the quarry meshes: they count as absent here so the procedural meadow props build.
local function noKit(...: string): boolean
	return false
end
local function noPlace(...: any): any
	return nil
end

-- Palette (owner brief V4 section C) plus a few stone and ground tones derived from it.
local C = {
	Charcoal = Color3.fromRGB(104, 78, 98), -- plum brown
	Slate = Color3.fromRGB(150, 138, 186), -- pastel lavender
	Concrete = Color3.fromRGB(244, 228, 198), -- cream
	Wood = Color3.fromRGB(214, 156, 98), -- honey wood
	Amber = Color3.fromRGB(255, 212, 92), -- sunny yellow
	OffWhite = Color3.fromRGB(244, 239, 229), -- #F4EFE5
	Mint = Color3.fromRGB(114, 204, 160), -- #72CCA0
	Floor = Color3.fromRGB(112, 190, 84), -- meadow grass
	FloorDark = Color3.fromRGB(214, 180, 118), -- dirt paths
	Bench = Color3.fromRGB(128, 200, 96), -- lower meadow outside the drop
	Dirt = Color3.fromRGB(232, 200, 128), -- straw patch
	PadConcrete = Color3.fromRGB(236, 206, 156), -- station / bay pads (pale planks)
	Stone = { Color3.fromRGB(104, 180, 84), Color3.fromRGB(92, 168, 80), Color3.fromRGB(122, 194, 92) }, -- hill greens
	Strata = Color3.fromRGB(240, 222, 170),
	Dust = Color3.fromRGB(236, 206, 140),
	Steel = Color3.fromRGB(176, 206, 214),
	Rubber = Color3.fromRGB(86, 70, 74),
}
Kit.C = C

-- Prospector Lodge kit language (blender/models/lodge_building.py and _lodgeparts.py, docs/lodge): warm timber,
-- dark iron fittings, slate-brown roofing, warm stone, plaster, sign wood with cream letters and a muted gold
-- trim. The quarry structures (tables, sell bins, shelters, crane) use the same colours so the hunt reads as
-- the same world as the lobby.
local L = {
	Timber = Color3.fromRGB(206, 138, 84), -- #A9693F WoodMain: posts, beams, bin bodies
	TimberLight = Color3.fromRGB(234, 172, 112), -- #BC7E4E countertops, plank faces
	TimberDark = Color3.fromRGB(150, 96, 64), -- #70452D frames, battens, skids
	SignWood = Color3.fromRGB(172, 112, 72), -- #8A5532 sign faces (cream letters)
	Iron = Color3.fromRGB(124, 98, 90), -- warm brown fittings straps, hinges, bolts, lantern frames
	Stone = Color3.fromRGB(218, 200, 172), -- #A79F90 footings, foundation blocks
	StoneDark = Color3.fromRGB(180, 164, 140), -- #827B71
	Roof = Color3.fromRGB(226, 122, 120), -- coral roof slate-brown roof
	Plaster = Color3.fromRGB(252, 238, 212), -- #E7D6B8
	Gold = Color3.fromRGB(250, 204, 84), -- #C9A042 muted trim (not emissive)
	Cream = Color3.fromRGB(246, 238, 220), -- sign letters
	Charcoal = Color3.fromRGB(110, 82, 104), -- #282B30 board faces
}
Kit.L = L

-- Recolours a placed kit model (MeshParts named after their colour slot) into the lodge language. Slots it does not
-- know (Lamp, Glass, Rubber, Rock, Amber accents on purpose) are left as they are.
local LODGE_SLOT = {
	Wood = L.TimberLight,
	Timber = L.Timber,
	WoodDark = L.TimberDark,
	Frame = L.Iron,
	FrameDark = Color3.fromRGB(42, 44, 47),
	Slate = L.Roof,
	Concrete = L.Stone,
	Steel = Color3.fromRGB(128, 132, 136),
	SteelLight = Color3.fromRGB(150, 148, 142),
	Amber = L.Gold,
}
function Kit.lodgeSkin(m: Instance?)
	if not m then
		return
	end
	for _, d in m:GetDescendants() do
		if d:IsA("MeshPart") then
			local slot = string.match(d.Name, "^([%a]+)") or d.Name
			local col = LODGE_SLOT[slot]
			if col then
				d.Color = col
				if slot == "Wood" or slot == "Timber" or slot == "WoodDark" then
					d.Material = Enum.Material.Wood
				end
			end
		end
	end
end
-- warm charcoal for straps, rims and mast metal (the palette Charcoal reads black in the work view)
local HOP_METAL = Color3.fromRGB(170, 120, 82)

-- Primitives ------------------------------------------------------------------------------

function Kit.part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Shape = shape or Enum.PartType.Block
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Default WedgePart: the slope faces front (-Z) and up, full height at the back (+Z).
function Kit.wedge(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?): WedgePart
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.Slate
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Visual only: no collision, queries or touch.
function Kit.deco<T>(p: T): T
	local b = (p :: any) :: BasePart
	b.CanCollide = false
	b.CanQuery = false
	b.CanTouch = false
	return p
end

function Kit.model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Kit.folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- A square bar from world point a to world point b.
function Kit.bar(parent: Instance, name: string, a: Vector3, b: Vector3, thick: number, color: Color3, mat: Enum.Material?): Part
	local len = (b - a).Magnitude
	local up = if math.abs((b - a).Unit.Y) > 0.99 then Vector3.new(1, 0, 0) else Vector3.yAxis
	return Kit.part(parent, name, Vector3.new(thick, thick, len), CFrame.lookAt((a + b) / 2, b, up), color, mat or Enum.Material.Metal)
end

-- A cylinder from world point a to world point b (cables, pipes, tanks).
function Kit.pipe(parent: Instance, name: string, a: Vector3, b: Vector3, dia: number, color: Color3, mat: Enum.Material?): Part
	local len = (b - a).Magnitude
	local up = if math.abs((b - a).Unit.Y) > 0.99 then Vector3.new(1, 0, 0) else Vector3.yAxis
	local cf = CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.rad(90), 0)
	return Kit.part(parent, name, Vector3.new(len, dia, dia), cf, color, mat or Enum.Material.Metal, Enum.PartType.Cylinder)
end

-- Fitted text on one face of a part (SignLayout via KitPlace.applyFit: explicit TextSize, never TextScaled), with the
-- sign attributes (SignText / SignPreset / SignW / SignH) the numeric sign audit reads. The face size comes from the
-- part: Front/Back use X x Y, Left/Right Z x Y, Top/Bottom X x Z.
function Kit.label(p: BasePart, face: Enum.NormalId, text: string, color: Color3?, bg: Color3?, preset: string?): TextLabel
	local s = p.Size
	local w, h
	if face == Enum.NormalId.Front or face == Enum.NormalId.Back then
		w, h = s.X, s.Y
	elseif face == Enum.NormalId.Left or face == Enum.NormalId.Right then
		w, h = s.Z, s.Y
	else
		w, h = s.X, s.Z
	end
	local g = Instance.new("SurfaceGui")
	g.Name = "Label"
	g.Face = face
	g.LightInfluence = 0
	g.Parent = p
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.BackgroundColor3 = bg or C.Charcoal
	t.BackgroundTransparency = if bg then 0 else 1
	t.TextColor3 = color or C.Amber
	t.Font = Enum.Font.FredokaOne
	t.Parent = g
	local f = KitPlace.applyFit(g, t, text, w, h, preset or "Plaque")
	p:SetAttribute("SignText", f.Text)
	p:SetAttribute("SignPreset", preset or "Plaque")
	p:SetAttribute("SignW", w)
	p:SetAttribute("SignH", h)
	return t
end

local function stone(rng: Random): Color3
	return C.Stone[rng:NextInteger(1, #C.Stone)]
end

-- Cliffs -----------------------------------------------------------------------------------

-- One rock mass: a block with a sloped (wedge) cap toward the arena, a dust top, and an optional
-- lighter strata band on the front face. `cf` is the mass's base-front-centre, -Z out.
local function mass(m: Model, cf0: CFrame, w: number, h: number, d: number, rng: Random, strata: boolean?)
	local col = stone(rng)
	-- a little yaw and back-lean per mass so neighbouring faces never line up like bricks
	local cf = cf0 * CFrame.Angles(math.rad(rng:NextNumber(-7, 0)), math.rad(rng:NextNumber(-8, 8)), math.rad(rng:NextNumber(-3, 3)))
	local capH = math.min(h * 0.3, 7) * rng:NextNumber(0.6, 1)
	local bodyH = h - capH
	local base = -12 -- masses reach below the lower bench so no gap shows from any side
	Kit.part(m, "Mass", Vector3.new(w, bodyH - base, d), cf * CFrame.new(0, (bodyH + base) / 2, d / 2), col, Enum.Material.Slate)
	-- sloped cap: low edge at the front, flat block behind it, same stone colour (one silhouette)
	local capD = d * rng:NextNumber(0.45, 0.7)
	Kit.wedge(m, "Cap", Vector3.new(w, capH, capD), cf * CFrame.new(0, bodyH + capH / 2, capD / 2), col)
	Kit.part(m, "Top", Vector3.new(w, capH, d - capD), cf * CFrame.new(0, bodyH + capH / 2, capD + (d - capD) / 2), col, Enum.Material.Slate)
	Kit.deco(Kit.part(m, "Dust", Vector3.new(w * rng:NextNumber(0.4, 0.7), 0.3, (d - capD) * 0.6), cf * CFrame.new(w * rng:NextNumber(-0.15, 0.15), h + 0.1, capD + (d - capD) * 0.6), C.Dust, Enum.Material.Ground))
	if strata then
		local y = bodyH * rng:NextNumber(0.35, 0.7)
		Kit.deco(Kit.part(m, "Strata", Vector3.new(w + 0.2, rng:NextNumber(0.9, 1.6), 0.5), cf * CFrame.new(0, y, 0.1), C.Strata, Enum.Material.Sandstone))
	end
end

-- Eight broad cliff silhouettes. `cf` is the base-front-centre of the form (-Z faces the arena),
-- w its width, h its nominal height. Each variant is a different arrangement of 2-4 masses.
local CLIFF_VARIANTS: { (m: Model, cf: CFrame, w: number, h: number, rng: Random) -> () } = {
	-- 1 stepped mesa: low front bench, tall block set back
	function(m, cf, w, h, rng)
		mass(m, cf, w, h * 0.45, 8, rng, true)
		mass(m, cf * CFrame.new(w * 0.08, 0, 6), w * 0.75, h, 12, rng, true)
	end,
	-- 2 leaning slab: one broad mass tilted back, low talus wedge in front
	function(m, cf, w, h, rng)
		mass(m, cf * CFrame.new(0, 0, 2) * CFrame.Angles(math.rad(-6), 0, 0), w, h, 13, rng, true)
		Kit.wedge(m, "Talus", Vector3.new(w * 0.7, h * 0.18, 4), cf * CFrame.new(-w * 0.1, h * 0.09, 0.2), stone(rng))
	end,
	-- 3 twin buttress with a notch between
	function(m, cf, w, h, rng)
		mass(m, cf * CFrame.new(-w * 0.27, 0, 0), w * 0.46, h, 12, rng, true)
		mass(m, cf * CFrame.new(w * 0.27, 0, 1), w * 0.46, h * 0.82, 12, rng, true)
		mass(m, cf * CFrame.new(0, 0, 5), w * 0.3, h * 0.6, 8, rng)
	end,
	-- 4 shoulder: tall on one end, falling away to the other
	function(m, cf, w, h, rng)
		mass(m, cf * CFrame.new(-w * 0.22, 0, 0), w * 0.56, h, 13, rng, true)
		mass(m, cf * CFrame.new(w * 0.26, 0, 1), w * 0.5, h * 0.6, 12, rng, true)
		local s = Kit.wedge(m, "Shoulder", Vector3.new(12, h * 0.35, w * 0.3), cf * CFrame.new(w * 0.12, h * 0.6 + h * 0.175, 7) * CFrame.Angles(0, math.rad(-90), 0), stone(rng))
		s.CanCollide = false
	end,
	-- 5 terraced: three benches climbing back
	function(m, cf, w, h, rng)
		mass(m, cf, w, h * 0.32, 6, rng)
		mass(m, cf * CFrame.new(0, 0, 4.5), w * 0.92, h * 0.64, 7, rng, true)
		mass(m, cf * CFrame.new(-w * 0.05, 0, 9), w * 0.8, h, 8, rng)
	end,
	-- 6 broken tooth: tall narrow block beside a squat broad one
	function(m, cf, w, h, rng)
		mass(m, cf * CFrame.new(-w * 0.3, 0, 1), w * 0.36, h * 1.12, 11, rng, true)
		mass(m, cf * CFrame.new(w * 0.18, 0, 0), w * 0.66, h * 0.55, 12, rng, true)
	end,
	-- 7 rounded hump: three overlapping masses, highest in the middle
	function(m, cf, w, h, rng)
		mass(m, cf * CFrame.new(-w * 0.3, 0, 1) * CFrame.Angles(0, math.rad(8), 0), w * 0.42, h * 0.7, 11, rng)
		mass(m, cf * CFrame.new(0, 0, 0), w * 0.42, h, 12, rng, true)
		mass(m, cf * CFrame.new(w * 0.3, 0, 1) * CFrame.Angles(0, math.rad(-8), 0), w * 0.42, h * 0.74, 11, rng)
	end,
	-- 8 overhang ledge: body with a jutting upper shelf
	function(m, cf, w, h, rng)
		mass(m, cf * CFrame.new(0, 0, 2), w, h * 0.78, 12, rng, true)
		local shelf = Kit.part(m, "Shelf", Vector3.new(w * 0.6, 2.2, 6), cf * CFrame.new(w * 0.12, h * 0.78 - 1.1, 1.2), stone(rng), Enum.Material.Slate)
		shelf.CanCollide = false
		mass(m, cf * CFrame.new(w * 0.15, 0, 7), w * 0.55, h, 9, rng)
	end,
}
Kit.CliffVariants = #CLIFF_VARIANTS

function Kit.cliffParts(parent: Instance, cf: CFrame, variant: number, w: number, h: number, rng: Random): Model
	local m = Kit.model(parent, "CT_Rocks_Cliff_" .. variant)
	CLIFF_VARIANTS[((variant - 1) % #CLIFF_VARIANTS) + 1](m, cf, w, h, rng)
	return m
end

-- A low ledge step at a cliff base (walkable top, keeps players off the cliff face visually).
function Kit.ledgeParts(parent: Instance, cf: CFrame, w: number, h: number, d: number, rng: Random): Model
	local m = Kit.model(parent, "CT_Rocks_Ledge")
	local col = stone(rng)
	Kit.part(m, "Step", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, d / 2), col, Enum.Material.Slate)
	Kit.wedge(m, "Bevel", Vector3.new(w, h * 0.5, 1.4), cf * CFrame.new(0, h * 0.25, -0.7), col:Lerp(C.Dust, 0.2))
	return m
end

-- Boulder cluster: 2-4 faceted chunks with a contact skirt (grounded, no floating cubes).
function Kit.boulders(parent: Instance, cf: CFrame, size: number, rng: Random, count: number?): Model
	local m = Kit.model(parent, "CT_Rocks_Boulders")
	local n = count or rng:NextInteger(2, 4)
	for i = 1, n do
		local s = size * (if i == 1 then 1 else rng:NextNumber(0.4, 0.7))
		local off = if i == 1 then Vector3.zero else Vector3.new(rng:NextNumber(-0.9, 0.9) * size, 0, rng:NextNumber(-0.7, 0.7) * size)
		local col = stone(rng):Lerp(C.Dust, rng:NextNumber(0, 0.2))
		local yaw = rng:NextNumber(0, math.pi * 2)
		local body = Kit.part(m, "Chunk", Vector3.new(s, s * 0.62, s * 0.86), cf * CFrame.new(off + Vector3.new(0, s * 0.26, 0)) * CFrame.Angles(rng:NextNumber(-0.18, 0.18), yaw, rng:NextNumber(-0.18, 0.18)), col, Enum.Material.Slate)
		body.CanCollide = i == 1
		-- faceted shoulder on top
		Kit.deco(Kit.wedge(m, "Facet", Vector3.new(s * 0.8, s * 0.32, s * 0.6), cf * CFrame.new(off + Vector3.new(0, s * 0.72, 0)) * CFrame.Angles(0, yaw + rng:NextNumber(-0.5, 0.5), 0), col:Lerp(C.Dust, 0.15)))
	end
	return m
end

-- Sparse grit at a boundary: a few small dull stones, never near the pile, never collidable.
function Kit.grit(parent: Instance, center: Vector3, spread: number, rng: Random, count: number)
	for _ = 1, count do
		local s = rng:NextNumber(0.4, 1.0)
		local pos = center + Vector3.new(rng:NextNumber(-spread, spread), s * 0.2, rng:NextNumber(-spread * 0.5, spread * 0.5))
		Kit.deco(Kit.part(parent, "CT_Rocks_Grit", Vector3.new(s, s * 0.5, s * 0.8), CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)), C.Dust:Lerp(C.Stone[2], rng:NextNumber(0.2, 0.7)), Enum.Material.Slate))
	end
end

-- Structures ---------------------------------------------------------------------------------

-- Retaining wall: concrete panels between steel H-posts with a cap beam. `cf` is the base-centre
-- of the face; the wall stands from y = bottom to y = 0 (it holds the level behind it, +Z).
function Kit.retainingWallParts(parent: Instance, cf: CFrame, length: number, height: number, bottom: number?): Model
	local m = Kit.model(parent, "CT_Rocks_RetainingWall")
	local b = bottom or 0
	local top = b + height
	Kit.part(m, "Panels", Vector3.new(length, height - 0.04, 1.2), cf * CFrame.new(0, b + (height - 0.04) / 2, 0.6), C.Concrete, Enum.Material.WoodPlanks)
	local n = math.max(2, math.floor(length / 8) + 1)
	for i = 0, n - 1 do
		local x = -length / 2 + i * length / (n - 1)
		Kit.part(m, "Post", Vector3.new(0.9, height + 0.4, 0.7), cf * CFrame.new(x, b + height / 2 + 0.2, -0.3), C.Slate, Enum.Material.Wood)
		Kit.deco(Kit.part(m, "Flange", Vector3.new(1.4, height + 0.4, 0.2), cf * CFrame.new(x, b + height / 2 + 0.2, -0.65), C.Slate, Enum.Material.Wood))
	end
	Kit.part(m, "Cap", Vector3.new(length + 0.4, 0.8, 1.8), cf * CFrame.new(0, top + 0.3, 0.4), C.PadConcrete, Enum.Material.WoodPlanks)
	return m
end

-- Railing at a drop: slate posts, amber top rail, mid rail, toe board.
function Kit.railingParts(parent: Instance, a: Vector3, b: Vector3): Model
	local m = Kit.model(parent, "CT_Rocks_Railing")
	local len = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b)
	local rail = L.TimberLight
	Kit.part(m, "TopRail", Vector3.new(0.3, 0.3, len), cf * CFrame.new(0, 3.0, 0), rail, Enum.Material.Wood)
	Kit.part(m, "MidRail", Vector3.new(0.26, 0.26, len), cf * CFrame.new(0, 1.7, 0), rail, Enum.Material.Wood)
	local n = math.max(2, math.floor(len / 5) + 1)
	for i = 0, n - 1 do
		local p = a:Lerp(b, i / (n - 1))
		Kit.part(m, "Post", Vector3.new(0.5, 3.4, 0.5), CFrame.new(p + Vector3.new(0, 1.7, 0)), L.Timber, Enum.Material.Wood)
		Kit.deco(Kit.part(m, "PostCap", Vector3.new(0.7, 0.25, 0.7), CFrame.new(p + Vector3.new(0, 3.45, 0)), L.Cream, Enum.Material.Wood))
	end
	return m
end

-- Lamp mast with a visible base, brace, arm and housing. `cf` faces the lit area (-Z).
function Kit.lampMast(parent: Instance, cf: CFrame, lit: boolean): Model
	local m = Kit.model(parent, "CT_Rocks_LampMast")
	Kit.part(m, "Footing", Vector3.new(1.8, 0.8, 1.8), cf * CFrame.new(0, 0.4, 0), C.PadConcrete, Enum.Material.Concrete)
	Kit.part(m, "Pole", Vector3.new(0.7, 9.4, 0.7), cf * CFrame.new(0, 5.1, 0), HOP_METAL, Enum.Material.SmoothPlastic)
	Kit.deco(Kit.bar(m, "Brace", cf:PointToWorldSpace(Vector3.new(0, 8.0, 0)), cf:PointToWorldSpace(Vector3.new(0, 9.8, -2.4)), 0.3, HOP_METAL))
	Kit.deco(Kit.part(m, "Arm", Vector3.new(0.4, 0.4, 3.2), cf * CFrame.new(0, 9.8, -1.4), HOP_METAL, Enum.Material.SmoothPlastic))
	local head = Kit.deco(Kit.part(m, "Housing", Vector3.new(1.8, 0.6, 1.2), cf * CFrame.new(0, 9.6, -3) * CFrame.Angles(math.rad(-15), 0, 0), HOP_METAL, Enum.Material.SmoothPlastic))
	local lens = Kit.deco(Kit.part(m, "Lens", Vector3.new(1.5, 0.12, 0.9), head.CFrame * CFrame.new(0, -0.32, 0), Color3.fromRGB(255, 236, 196), Enum.Material.Neon))
	Kit.deco(Kit.part(m, "Junction", Vector3.new(0.8, 1.0, 0.5), cf * CFrame.new(0, 2.2, 0.5), C.Amber, Enum.Material.Metal))
	if lit then
		local l = Instance.new("SpotLight")
		l.Face = Enum.NormalId.Bottom
		l.Range = 30
		l.Angle = 80
		l.Brightness = 1.4
		l.Color = Color3.fromRGB(255, 226, 180)
		l.Parent = lens
	end
	return m
end

-- Entrance gate: concrete pillars, steel header with a sign, closed mesh panels. `cf` is the
-- centre of the gateway on the floor, -Z faces the arena.
function Kit.gateParts(parent: Instance, cf: CFrame, width: number): Model
	local m = Kit.model(parent, "CT_Rocks_EntranceGate")
	for _, s in { -1, 1 } do
		local x = s * (width / 2 + 1.2)
		Kit.part(m, "Pillar", Vector3.new(2.4, 11, 2.4), cf * CFrame.new(x, 5.5, 0), C.Concrete, Enum.Material.Wood)
		Kit.deco(Kit.part(m, "PillarCap", Vector3.new(2.8, 0.6, 2.8), cf * CFrame.new(x, 11.3, 0), C.Slate, Enum.Material.Wood))
		for k = 0, 2 do
			Kit.deco(Kit.part(m, "Hazard", Vector3.new(2.45, 0.5, 2.45), cf * CFrame.new(x, 1 + k * 1.0, 0), if k % 2 == 0 then C.Amber else C.Charcoal, Enum.Material.SmoothPlastic))
		end
	end
	Kit.part(m, "Header", Vector3.new(width + 5, 1.2, 1.2), cf * CFrame.new(0, 12.2, 0), C.Slate, Enum.Material.Wood)
	local sign = Kit.deco(Kit.part(m, "Sign", Vector3.new(width * 0.7, 2.2, 0.3), cf * CFrame.new(0, 13.9, -0.2), C.Charcoal, Enum.Material.SmoothPlastic))
	Kit.label(sign, Enum.NormalId.Front, "PET MEADOW", C.Amber, nil, "Landmark")
	Kit.deco(Kit.part(m, "SignTrim", Vector3.new(width * 0.7 + 0.4, 0.25, 0.4), cf * CFrame.new(0, 15.05, -0.2), C.Amber, Enum.Material.Wood))
	-- two closed sliding panels: frame + vertical bars
	for _, s in { -1, 1 } do
		local pw = width / 2
		local px = s * pw / 2
		local frame = cf * CFrame.new(px, 0, 0.6)
		Kit.part(m, "PanelTop", Vector3.new(pw, 0.35, 0.35), frame * CFrame.new(0, 6.5, 0), C.Slate, Enum.Material.Wood)
		Kit.part(m, "PanelBottom", Vector3.new(pw, 0.35, 0.35), frame * CFrame.new(0, 0.6, 0), C.Slate, Enum.Material.Wood)
		Kit.part(m, "PanelMid", Vector3.new(pw, 0.25, 0.3), frame * CFrame.new(0, 3.6, 0), C.Amber, Enum.Material.Wood)
		local bars = math.floor(pw / 1.1)
		for i = 0, bars do
			Kit.deco(Kit.part(m, "Bar", Vector3.new(0.16, 5.9, 0.16), frame * CFrame.new(-pw / 2 + i * pw / bars, 3.55, 0), C.Slate, Enum.Material.Wood))
		end
		Kit.deco(Kit.part(m, "Wheel", Vector3.new(0.3, 0.6, 0.6), frame * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, 0), C.Charcoal, Enum.Material.Wood, Enum.PartType.Cylinder))
	end
	Kit.deco(Kit.part(m, "Track", Vector3.new(width + 3, 0.1, 0.5), cf * CFrame.new(0, 0.07, 0.6), C.Slate, Enum.Material.Wood))
	return m
end

-- Workshop shelter / equipment nook: slate frame, wood roof, light back wall, amber fascia.
-- `cf` is the front-centre on the floor, -Z faces the arena.
function Kit.shelterParts(parent: Instance, cf: CFrame, w: number, d: number): Model
	local m = Kit.model(parent, "CT_Rocks_EquipmentShelter")
	local h = 8.5
	-- lodge language: stone slab, timber posts and beam, plaster walls, slate-brown roof, dark timber fascia
	Kit.part(m, "Slab", Vector3.new(w + 1, 0.3, d + 1), cf * CFrame.new(0, 0.15, d / 2), L.Stone, Enum.Material.Slate)
	for _, sx in { -1, 1 } do
		for _, sz in { 0.4, d - 0.4 } do
			Kit.part(m, "Post", Vector3.new(0.6, h + (sz / d) * 1.5, 0.6), cf * CFrame.new(sx * (w / 2 - 0.4), (h + (sz / d) * 1.5) / 2, sz), L.Timber, Enum.Material.Wood)
		end
	end
	Kit.part(m, "BackWall", Vector3.new(w, h, 0.5), cf * CFrame.new(0, h / 2 + 0.3, d - 0.3), L.Plaster, Enum.Material.SmoothPlastic)
	Kit.part(m, "SideWall", Vector3.new(0.5, h * 0.6, d - 1), cf * CFrame.new(-w / 2 + 0.4, h * 0.3 + 0.3, d / 2), L.Plaster, Enum.Material.SmoothPlastic)
	-- roof slopes down toward the arena
	Kit.part(m, "Roof", Vector3.new(w + 1.6, 0.45, d + 2), cf * CFrame.new(0, h + 0.75, d / 2 - 0.4) * CFrame.Angles(math.rad(-8), 0, 0), L.Roof, Enum.Material.Slate)
	Kit.deco(Kit.part(m, "Fascia", Vector3.new(w + 1.7, 0.7, 0.25), cf * CFrame.new(0, h + 0.15, -1.3) * CFrame.Angles(math.rad(-8), 0, 0), L.TimberDark, Enum.Material.Wood))
	Kit.deco(Kit.part(m, "Beam", Vector3.new(w, 0.5, 0.5), cf * CFrame.new(0, h - 0.1, 0.4), L.Timber, Enum.Material.Wood))
	local lightBar = Kit.deco(Kit.part(m, "LightBar", Vector3.new(w * 0.5, 0.15, 0.4), cf * CFrame.new(0, h - 0.45, d / 2), Color3.fromRGB(255, 232, 190), Enum.Material.Neon))
	local l = Instance.new("PointLight")
	l.Range = 12
	l.Brightness = 0.8
	l.Color = Color3.fromRGB(255, 220, 170)
	l.Parent = lightBar
	return m
end

-- Utility props ------------------------------------------------------------------------------

-- Air compressor on skids: horizontal tank, motor box, pressure gauge, hose reel.
function Kit.compressorParts(parent: Instance, cf: CFrame): Model
	local m = Kit.model(parent, "CT_Rocks_Compressor")
	Kit.part(m, "Skid", Vector3.new(4.8, 0.4, 2.4), cf * CFrame.new(0, 0.2, 0), C.Charcoal, Enum.Material.Metal)
	Kit.part(m, "Tank", Vector3.new(4.4, 1.9, 1.9), cf * CFrame.new(0, 1.4, 0), C.Amber, Enum.Material.Metal, Enum.PartType.Cylinder)
	Kit.part(m, "Motor", Vector3.new(1.8, 1.3, 1.5), cf * CFrame.new(-0.8, 3.0, 0), C.Slate, Enum.Material.Metal)
	Kit.deco(Kit.part(m, "Pulley", Vector3.new(0.3, 1.0, 1.0), cf * CFrame.new(0.4, 3.0, 0) * CFrame.Angles(0, 0, 0), C.Charcoal, Enum.Material.Metal, Enum.PartType.Cylinder))
	Kit.deco(Kit.part(m, "Gauge", Vector3.new(0.15, 0.6, 0.6), cf * CFrame.new(1.4, 2.6, -0.5) * CFrame.Angles(0, math.rad(90), 0), C.OffWhite, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder))
	Kit.deco(Kit.part(m, "HoseReel", Vector3.new(0.6, 1.3, 1.3), cf * CFrame.new(2.6, 0.9, 0), C.Charcoal, Enum.Material.Rubber, Enum.PartType.Cylinder))
	return m
end

-- Generator housing: louvred box, amber stripe, exhaust stack, control panel.
function Kit.generatorParts(parent: Instance, cf: CFrame): Model
	local m = Kit.model(parent, "CT_Rocks_Generator")
	Kit.part(m, "Skid", Vector3.new(5.6, 0.4, 3), cf * CFrame.new(0, 0.2, 0), C.Charcoal, Enum.Material.Metal)
	Kit.part(m, "Housing", Vector3.new(5.2, 3.2, 2.7), cf * CFrame.new(0, 2.0, 0), C.Slate, Enum.Material.Metal)
	Kit.deco(Kit.part(m, "Stripe", Vector3.new(5.25, 0.35, 2.75), cf * CFrame.new(0, 3.2, 0), C.Amber, Enum.Material.Metal))
	for i = 0, 4 do
		Kit.deco(Kit.part(m, "Louvre", Vector3.new(0.12, 1.4, 0.15), cf * CFrame.new(0.6 + i * 0.35, 1.9, -1.38), C.Charcoal, Enum.Material.Metal))
	end
	Kit.deco(Kit.part(m, "Panel", Vector3.new(1.2, 1.0, 0.12), cf * CFrame.new(-1.4, 2.2, -1.38), C.Charcoal, Enum.Material.SmoothPlastic))
	Kit.deco(Kit.part(m, "Ready", Vector3.new(0.25, 0.25, 0.1), cf * CFrame.new(-1.1, 2.4, -1.45), C.Mint, Enum.Material.Neon))
	Kit.part(m, "Exhaust", Vector3.new(1.6, 0.45, 0.45), cf * CFrame.new(1.8, 4.3, 0.6) * CFrame.Angles(0, 0, math.rad(90)), C.Charcoal, Enum.Material.Metal, Enum.PartType.Cylinder)
	return m
end

-- Cable run along the floor through world points (low, never collidable).
function Kit.cable(parent: Instance, points: { Vector3 }, color: Color3?)
	local m = Kit.model(parent, "CT_Rocks_Cable")
	for i = 1, #points - 1 do
		Kit.deco(Kit.pipe(m, "Cable", points[i] + Vector3.new(0, 0.12, 0), points[i + 1] + Vector3.new(0, 0.12, 0), 0.24, color or C.Charcoal, Enum.Material.Rubber))
	end
	return m
end

-- Crates in three sizes (1 small, 2 medium, 3 large).
local CRATE = { 1.8, 2.6, 3.6 }
function Kit.crateParts(parent: Instance, cf: CFrame, size: number): Model
	local s = CRATE[math.clamp(size, 1, 3)]
	local m = Kit.model(parent, "CT_Rocks_Crate" .. size)
	Kit.part(m, "Box", Vector3.new(s, s * 0.8, s), cf * CFrame.new(0, s * 0.4, 0), C.Wood, Enum.Material.WoodPlanks)
	for _, y in { 0.12, s * 0.68 } do
		Kit.deco(Kit.part(m, "Rim", Vector3.new(s + 0.08, 0.18, s + 0.08), cf * CFrame.new(0, y, 0), C.Wood:Lerp(C.Charcoal, 0.35), Enum.Material.Wood))
	end
	Kit.deco(Kit.part(m, "Strap", Vector3.new(0.2, s * 0.82, s + 0.1), cf * CFrame.new(0, s * 0.4, 0), C.Slate, Enum.Material.Metal))
	return m
end

function Kit.palletParts(parent: Instance, cf: CFrame): Model
	local m = Kit.model(parent, "CT_Rocks_Pallet")
	for _, x in { -1.6, 0, 1.6 } do
		Kit.part(m, "Runner", Vector3.new(0.5, 0.45, 3.8), cf * CFrame.new(x, 0.225, 0), C.Wood:Lerp(C.Charcoal, 0.2), Enum.Material.Wood)
	end
	for i = 0, 4 do
		Kit.part(m, "Slat", Vector3.new(3.8, 0.15, 0.6), cf * CFrame.new(0, 0.52, -1.6 + i * 0.8), C.Wood, Enum.Material.WoodPlanks)
	end
	return m
end

-- Rock bin: open steel skip with fork pockets, holding a few dull spill stones (decor only).
function Kit.rockBinParts(parent: Instance, cf: CFrame, rng: Random): Model
	local m = Kit.model(parent, "CT_Rocks_RockBin")
	Kit.part(m, "Floor", Vector3.new(4.4, 0.3, 3.4), cf * CFrame.new(0, 0.55, 0), C.Slate, Enum.Material.Metal)
	for _, s in { -1, 1 } do
		Kit.part(m, "SideX", Vector3.new(0.3, 2.4, 3.4), cf * CFrame.new(s * 2.2, 1.6, 0) * CFrame.Angles(0, 0, math.rad(8 * s)), C.Slate, Enum.Material.Metal)
		Kit.part(m, "SideZ", Vector3.new(4.6, 2.4, 0.3), cf * CFrame.new(0, 1.6, s * 1.7) * CFrame.Angles(math.rad(-8 * s), 0, 0), C.Slate, Enum.Material.Metal)
		Kit.deco(Kit.part(m, "Pocket", Vector3.new(0.9, 0.4, 3.6), cf * CFrame.new(s * 1.2, 0.2, 0), C.Charcoal, Enum.Material.Metal))
	end
	Kit.deco(Kit.part(m, "Rim", Vector3.new(4.9, 0.2, 0.35), cf * CFrame.new(0, 2.85, -1.85), C.Amber, Enum.Material.Metal))
	for _ = 1, 5 do
		local s = rng:NextNumber(0.7, 1.2)
		Kit.deco(Kit.part(m, "Spill", Vector3.new(s, s * 0.7, s * 0.8), cf * CFrame.new(rng:NextNumber(-1.4, 1.4), 1.6 + rng:NextNumber(0, 0.5), rng:NextNumber(-0.9, 0.9)) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6), 0), C.Stone[2]:Lerp(C.Dust, 0.3), Enum.Material.Slate))
	end
	return m
end

-- Hand cart: tray, two wheels, push handle.
function Kit.cartParts(parent: Instance, cf: CFrame): Model
	local m = Kit.model(parent, "CT_Rocks_Cart")
	Kit.part(m, "Tray", Vector3.new(2.6, 0.9, 3.6), cf * CFrame.new(0, 1.5, 0), C.Amber, Enum.Material.Metal)
	Kit.deco(Kit.part(m, "Inner", Vector3.new(2.2, 0.1, 3.2), cf * CFrame.new(0, 1.96, 0), C.Charcoal, Enum.Material.Metal))
	for _, s in { -1, 1 } do
		Kit.part(m, "Wheel", Vector3.new(0.35, 1.3, 1.3), cf * CFrame.new(s * 1.5, 0.65, -0.6), C.Rubber, Enum.Material.Rubber, Enum.PartType.Cylinder)
		Kit.deco(Kit.part(m, "Handle", Vector3.new(0.2, 0.2, 2.2), cf * CFrame.new(s * 1.1, 2.1, 2.6) * CFrame.Angles(math.rad(20), 0, 0), C.Slate, Enum.Material.Metal))
		Kit.deco(Kit.part(m, "Leg", Vector3.new(0.2, 1.1, 0.2), cf * CFrame.new(s * 1.0, 0.55, 1.4), C.Slate, Enum.Material.Metal))
	end
	Kit.deco(Kit.part(m, "Grip", Vector3.new(2.4, 0.25, 0.25), cf * CFrame.new(0, 2.5, 3.6), C.Rubber, Enum.Material.Rubber))
	return m
end

-- Spare tool rack against a wall: frame, pegboard, hanging hammers and pry bars.
function Kit.toolRack(parent: Instance, cf: CFrame): Model
	local m = Kit.model(parent, "CT_Rocks_ToolRack")
	Kit.part(m, "Board", Vector3.new(5, 3.6, 0.25), cf * CFrame.new(0, 3.4, 0), C.Wood, Enum.Material.WoodPlanks)
	for _, s in { -1, 1 } do
		Kit.part(m, "Leg", Vector3.new(0.3, 5.4, 0.3), cf * CFrame.new(s * 2.4, 2.7, 0.1), C.Slate, Enum.Material.Metal)
	end
	for i = 0, 3 do
		local x = -1.8 + i * 1.2
		Kit.deco(Kit.part(m, "Handle", Vector3.new(0.22, 2.4, 0.22), cf * CFrame.new(x, 3.0, -0.3), if i % 2 == 0 then C.Amber else C.Wood, Enum.Material.SmoothPlastic))
		if i % 2 == 0 then
			Kit.deco(Kit.part(m, "Head", Vector3.new(1.0, 0.5, 0.5), cf * CFrame.new(x, 4.3, -0.3), C.Steel, Enum.Material.Metal))
		end
	end
	return m
end

-- Warning placard on a short post (sparingly: one at the drop, one at the hopper).
function Kit.placard(parent: Instance, cf: CFrame, text: string): Model
	local m = Kit.model(parent, "CT_Rocks_Placard")
	Kit.part(m, "Post", Vector3.new(0.25, 3.2, 0.25), cf * CFrame.new(0, 1.6, 0.05), C.Slate, Enum.Material.Metal)
	local board = Kit.deco(Kit.part(m, "Board", Vector3.new(2.4, 1.6, 0.12), cf * CFrame.new(0, 3.0, 0), C.Amber, Enum.Material.SmoothPlastic))
	Kit.deco(Kit.part(m, "Border", Vector3.new(2.6, 1.8, 0.08), cf * CFrame.new(0, 3.0, 0.08), C.Charcoal, Enum.Material.SmoothPlastic))
	Kit.label(board, Enum.NormalId.Front, text, C.Charcoal, nil, "Placard")
	return m
end

function Kit.cone(parent: Instance, pos: Vector3): Model
	local m = Kit.model(parent, "CT_Rocks_Cone")
	Kit.deco(Kit.part(m, "Base", Vector3.new(1.1, 0.15, 1.1), CFrame.new(pos + Vector3.new(0, 0.075, 0)), C.Charcoal, Enum.Material.Rubber))
	Kit.deco(Kit.part(m, "Body", Vector3.new(1.2, 0.7, 0.7), CFrame.new(pos + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0, math.rad(90)), C.Amber, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder))
	Kit.deco(Kit.part(m, "Band", Vector3.new(0.25, 0.72, 0.72), CFrame.new(pos + Vector3.new(0, 0.85, 0)) * CFrame.Angles(0, 0, math.rad(90)), C.OffWhite, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder))
	return m
end

-- Shared sell hopper: support frame, funnel lip, chute into a rock bin, receipt light, yellow
-- edge paint on the floor. Keeps the contract the client and EconomyService use: Model attribute
-- Hopper, a "Body" part carrying the ProximityPrompt "SellPrompt" with attribute Sell.
-- `cf` is the floor centre, -Z faces the arena (the side players walk up to).
function Kit.hopperParts(parent: Instance, cf: CFrame, rng: Random): Model
	local m = Kit.model(parent, "CT_Rocks_SellHopper")
	local body = Kit.part(m, "Body", Vector3.new(6, 2.6, 4.6), cf * CFrame.new(0, 3.1, 0.6), C.Slate, Enum.Material.Metal)
	-- legs and braces
	for _, sx in { -2.7, 2.7 } do
		for _, sz in { -1.4, 2.6 } do
			Kit.part(m, "Leg", Vector3.new(0.5, 1.8, 0.5), cf * CFrame.new(sx, 0.9, sz), C.Charcoal, Enum.Material.Metal)
		end
		Kit.deco(Kit.bar(m, "Brace", cf:PointToWorldSpace(Vector3.new(sx, 0.3, -1.4)), cf:PointToWorldSpace(Vector3.new(sx, 1.8, 2.6)), 0.22, C.Charcoal))
	end
	-- funnel lip: four plates flaring outward above the body
	local lipY = 5.0
	for _, s in { -1, 1 } do
		Kit.part(m, "LipX", Vector3.new(0.35, 1.8, 5.4), cf * CFrame.new(s * 3.3, lipY, 0.6) * CFrame.Angles(0, 0, math.rad(-22 * s)), C.Amber, Enum.Material.Metal)
		Kit.part(m, "LipZ", Vector3.new(6.8, 1.8, 0.35), cf * CFrame.new(0, lipY, 0.6 + s * 2.65) * CFrame.Angles(math.rad(22 * s), 0, 0), C.Amber, Enum.Material.Metal)
	end
	Kit.deco(Kit.part(m, "Mouth", Vector3.new(5.6, 0.2, 4.2), cf * CFrame.new(0, 4.45, 0.6), C.Charcoal, Enum.Material.Metal))
	for i = -2, 2 do
		Kit.deco(Kit.part(m, "Grate", Vector3.new(0.16, 0.16, 4.2), cf * CFrame.new(i * 1.1, 4.6, 0.6), C.Steel, Enum.Material.Metal))
	end
	-- chute out the back into a bin
	Kit.deco(Kit.part(m, "Chute", Vector3.new(2.4, 0.3, 4), cf * CFrame.new(0, 2.0, 4.4) * CFrame.Angles(math.rad(28), 0, 0), C.Slate, Enum.Material.Metal))
	for _, s in { -1, 1 } do
		Kit.deco(Kit.part(m, "ChuteSide", Vector3.new(0.2, 0.8, 4), cf * CFrame.new(s * 1.2, 2.3, 4.4) * CFrame.Angles(math.rad(28), 0, 0), C.Slate, Enum.Material.Metal))
	end
	Kit.rockBin(m, cf * CFrame.new(0, 0, 7.6), rng)
	-- receipt light on a post at the front corner (mint = sale accepted)
	Kit.part(m, "LightPost", Vector3.new(0.3, 5.4, 0.3), cf * CFrame.new(3.6, 2.7, -1.6), C.Slate, Enum.Material.Metal)
	local lamp = Kit.deco(Kit.part(m, "ReceiptLight", Vector3.new(0.7, 0.7, 0.7), cf * CFrame.new(3.6, 5.7, -1.6), C.Mint, Enum.Material.Neon, Enum.PartType.Ball))
	lamp.Name = "ReceiptLight"
	-- sign on the front of the body
	local sign = Kit.deco(Kit.part(m, "Sign", Vector3.new(4.4, 1.3, 0.15), cf * CFrame.new(0, 3.1, -1.75), C.Charcoal, Enum.Material.SmoothPlastic))
	Kit.label(sign, Enum.NormalId.Front, "SELL CANDY", C.Amber, nil, "Landmark")
	-- yellow edge paint: a U around the approach side only
	Kit.deco(Kit.part(m, "EdgePaint", Vector3.new(8.4, 0.06, 0.35), cf * CFrame.new(0, 0.03, -2.6), C.Amber, Enum.Material.SmoothPlastic))
	for _, s in { -1, 1 } do
		Kit.deco(Kit.part(m, "EdgePaint", Vector3.new(0.35, 0.06, 5.6), cf * CFrame.new(s * 4.2, 0.03, 0.1), C.Amber, Enum.Material.SmoothPlastic))
	end
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "SellPrompt"
	pp.ActionText = "Sell Candy"
	pp.ObjectText = "Hopper"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R -- E is the crack key on keyboards
	pp.UIOffset = Vector2.new(0, 30)
	pp:SetAttribute("Panel", "")
	pp:SetAttribute("Sell", true)
	pp.Parent = body
	m:SetAttribute("Hopper", true)
	m.PrimaryPart = body
	return m
end

-- Background ----------------------------------------------------------------------------------

-- Tower crane silhouette on a concrete footing: braced mast, cab, jib, counter-jib with weight,
-- trolley and hook. `cf` is the footing centre; the jib points along -X.
function Kit.craneParts(parent: Instance, cf: CFrame, height: number): Model
	local m = Kit.model(parent, "CT_Rocks_Crane")
	local orange = Config.Palette.Orange
	Kit.part(m, "Footing", Vector3.new(7, 1.5, 7), cf * CFrame.new(0, 0.75, 0), C.PadConcrete, Enum.Material.Concrete)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.deco(Kit.part(m, "Chord", Vector3.new(0.5, height, 0.5), cf * CFrame.new(sx * 1.4, height / 2 + 1.5, sz * 1.4), orange, Enum.Material.Metal))
		end
	end
	local seg = 5
	for i = 0, math.floor(height / seg) - 1 do
		local y0, y1 = 1.5 + i * seg, 1.5 + (i + 1) * seg
		local s = if i % 2 == 0 then 1 else -1
		for _, side in { -1.4, 1.4 } do
			Kit.deco(Kit.bar(m, "Lace", cf:PointToWorldSpace(Vector3.new(-1.4 * s, y0, side)), cf:PointToWorldSpace(Vector3.new(1.4 * s, y1, side)), 0.22, orange))
			Kit.deco(Kit.bar(m, "Lace", cf:PointToWorldSpace(Vector3.new(side, y0, -1.4 * s)), cf:PointToWorldSpace(Vector3.new(side, y1, 1.4 * s)), 0.22, orange))
		end
	end
	local top = height + 1.5
	Kit.deco(Kit.part(m, "Slew", Vector3.new(3.6, 1.0, 3.6), cf * CFrame.new(0, top + 0.5, 0), C.Slate, Enum.Material.Metal))
	Kit.deco(Kit.part(m, "Cab", Vector3.new(2.4, 2.2, 2.4), cf * CFrame.new(-1.6, top + 2, -2.2), C.OffWhite, Enum.Material.Metal))
	Kit.deco(Kit.part(m, "Jib", Vector3.new(34, 1.2, 1.4), cf * CFrame.new(-17, top + 2.2, 0), orange, Enum.Material.Metal))
	Kit.deco(Kit.part(m, "JibTop", Vector3.new(30, 0.4, 0.4), cf * CFrame.new(-15, top + 4.2, 0), orange, Enum.Material.Metal))
	Kit.deco(Kit.part(m, "CounterJib", Vector3.new(12, 1.0, 1.4), cf * CFrame.new(6, top + 2.2, 0), orange, Enum.Material.Metal))
	Kit.deco(Kit.part(m, "Counterweight", Vector3.new(3, 3, 2.2), cf * CFrame.new(10.5, top + 0.8, 0), C.PadConcrete, Enum.Material.Concrete))
	Kit.deco(Kit.part(m, "Apex", Vector3.new(1, 6, 1), cf * CFrame.new(0, top + 4, 0), orange, Enum.Material.Metal))
	Kit.deco(Kit.bar(m, "Tie", cf:PointToWorldSpace(Vector3.new(0, top + 7, 0)), cf:PointToWorldSpace(Vector3.new(-26, top + 2.8, 0)), 0.18, C.Charcoal))
	Kit.deco(Kit.bar(m, "Tie", cf:PointToWorldSpace(Vector3.new(0, top + 7, 0)), cf:PointToWorldSpace(Vector3.new(11, top + 2.8, 0)), 0.18, C.Charcoal))
	Kit.deco(Kit.part(m, "Trolley", Vector3.new(1.6, 0.8, 1.8), cf * CFrame.new(-22, top + 1.2, 0), C.Slate, Enum.Material.Metal))
	Kit.deco(Kit.part(m, "Rope", Vector3.new(0.12, 14, 0.12), cf * CFrame.new(-22, top - 6, 0), C.Charcoal, Enum.Material.Metal))
	Kit.deco(Kit.part(m, "Hook", Vector3.new(1.0, 1.2, 0.6), cf * CFrame.new(-22, top - 13.4, 0), C.Amber, Enum.Material.Metal))
	return m
end

-- Inclined conveyor on A-frame trestles, discharging onto a stockpile cone. `a` is the low
-- (feed) end and `b` the high (discharge) end, both world points on the belt line.
function Kit.conveyor(parent: Instance, a: Vector3, b: Vector3, groundY: number, rng: Random): Model
	local m = Kit.model(parent, "CT_Rocks_Conveyor")
	local len = (b - a).Magnitude
	local cf = CFrame.lookAt((a + b) / 2, b)
	Kit.deco(Kit.part(m, "Belt", Vector3.new(2.4, 0.3, len), cf, C.Charcoal, Enum.Material.Rubber))
	for _, s in { -1, 1 } do
		Kit.deco(Kit.part(m, "Stringer", Vector3.new(0.3, 0.8, len), cf * CFrame.new(s * 1.35, -0.2, 0), C.Slate, Enum.Material.Metal))
	end
	Kit.deco(Kit.part(m, "Head", Vector3.new(3.2, 1.6, 1.6), CFrame.new(b) * (cf - cf.Position), C.Amber, Enum.Material.Metal))
	local n = math.max(2, math.floor(len / 10))
	for i = 1, n do
		local p = a:Lerp(b, i / (n + 0.4))
		local right = cf.RightVector
		for _, s in { -1, 1 } do
			Kit.deco(Kit.bar(m, "Trestle", p + right * s * 1.3, Vector3.new(p.X, groundY, p.Z) + right * s * 2.6, 0.35, C.Slate))
		end
		Kit.deco(Kit.bar(m, "Cross", p + right * -1.6 + Vector3.new(0, -(p.Y - groundY) * 0.5, 0), p + right * 1.6 + Vector3.new(0, -(p.Y - groundY) * 0.5, 0), 0.25, C.Slate))
	end
	-- stockpile under the discharge end
	local pile = Vector3.new(b.X, groundY, b.Z) + cf.LookVector * 3
	for i = 1, 4 do
		local s = 9 - i * 1.6
		Kit.deco(Kit.part(m, "Stockpile", Vector3.new(s * 1.2, s * 0.5, s), CFrame.new(pile + Vector3.new(0, s * 0.25 + (i - 1) * 0.9, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), C.Stone[3]:Lerp(C.Dust, 0.3), Enum.Material.Slate))
	end
	return m
end

-- Blender kit versions (docs/MODELING.md) -------------------------------------------------------
-- Same signatures and frames as the Part builders above (-Z faces the arena, floor-centre origin);
-- each uses the uploaded kit model when it is loaded and the Part builder otherwise. Kit meshes do not
-- collide, so structures the players could touch get invisible blockers.

-- Pass 2 (docs/m4/QUARRY.md): fewer, chunkier stepped cliff blocks in neutral grey, like the owner's quarry
-- placement target. One cliff = three terraced tiers climbing away from the arena (each a broad block with a
-- lighter cap slab and a lower shoulder block in front). `cf` = base-front-centre, -Z out, w width, h height.
function Kit.cliff(parent: Instance, cf: CFrame, variant: number, w: number, h: number, rng: Random): Model
	local m = Kit.model(parent, "CT_Rocks_Cliff_" .. (((variant - 1) % 8) + 1))
	local base = -12 -- below the lower bench so no gap shows from any side
	local depth = 6.5
	for tier = 0, 2 do
		local tw = w * rng:NextNumber(0.82, 1.0) * (1 - 0.07 * tier)
		local th = h * (0.38 + 0.31 * tier) * rng:NextNumber(0.92, 1.08)
		local z = tier * 6.0
		local x = rng:NextNumber(-0.08, 0.08) * w
		local col = stone(rng)
		local tcf = cf * CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(rng:NextNumber(-4, 4)), 0)
		Kit.part(m, "Mass", Vector3.new(tw, th - base, depth), tcf * CFrame.new(0, (th + base) / 2, depth / 2), col, Enum.Material.Slate)
		Kit.deco(Kit.part(m, "Cap", Vector3.new(tw * 0.97, 0.6, depth * 0.96), tcf * CFrame.new(0, th + 0.3, depth / 2), col:Lerp(C.Dust, 0.22), Enum.Material.Slate))
		-- a lower shoulder block in front of the tier (the step), narrower and offset to one side
		local sw = tw * rng:NextNumber(0.34, 0.5)
		local sh = th * rng:NextNumber(0.5, 0.72)
		local sx = (if rng:NextNumber() < 0.5 then -1 else 1) * (tw / 2 - sw / 2 - rng:NextNumber(0, tw * 0.2))
		local scol = stone(rng)
		Kit.part(m, "Step", Vector3.new(sw, sh - base, 4.2), tcf * CFrame.new(sx, (sh + base) / 2, -2.1), scol, Enum.Material.Slate)
		Kit.deco(Kit.part(m, "StepCap", Vector3.new(sw * 0.97, 0.5, 4.0), tcf * CFrame.new(sx, sh + 0.25, -2.1), scol:Lerp(C.Dust, 0.22), Enum.Material.Slate))
	end
	return m
end

function Kit.ledge(parent: Instance, cf: CFrame, w: number, h: number, d: number, rng: Random): Model
	if noKit("Cliff_E") then
		local m = noPlace(parent, "Cliff_E", cf * CFrame.new(0, -0.2, d * 0.5), math.clamp(w / 24.5 * 1.4, 0.3, 0.9), "CT_Rocks_Ledge")
		if m then
			return m
		end
	end
	return Kit.ledgeParts(parent, cf, w, h, d, rng)
end

function Kit.retainingWall(parent: Instance, cf: CFrame, length: number, height: number, bottom: number?): Model
	if noKit("RetainingWall_Low") then
		local b = bottom or 0
		local s = math.max(1, height / 3.26)
		local pitch = 8.0 * s
		local n = math.max(1, math.ceil(length / pitch))
		local m = Kit.model(parent, "CT_Rocks_RetainingWall")
		for i = 0, n - 1 do
			local x = -length / 2 + (i + 0.5) * length / n
			noPlace(m, "RetainingWall_Low", cf * CFrame.new(x, b, 0.85 * s), s * (length / n / pitch) * 1.02, "Segment")
		end
		-- solid face so the level behind it holds
		KitPlace.blocker(m, cf * CFrame.new(0, b + height / 2, 0.8), Vector3.new(length, height, 1.6), "Face")
		return m
	end
	return Kit.retainingWallParts(parent, cf, length, height, bottom)
end

function Kit.railing(parent: Instance, a: Vector3, b: Vector3): Model
	if noKit("Fence_Section") then
		local m = Kit.model(parent, "CT_Rocks_Railing")
		local len = (b - a).Magnitude
		local dir = (b - a).Unit
		local out = Vector3.new(-dir.Z, 0, dir.X) -- the fence front faces sideways to the run
		local n = math.max(1, math.ceil(len / 6.4))
		for i = 0, n - 1 do
			local p = a + dir * ((i + 0.5) * len / n)
			noPlace(m, "Fence_Section", CFrame.lookAt(p, p + out), len / n / 6.4 * 1.02, "Section")
		end
		KitPlace.blocker(m, CFrame.lookAt((a + b) / 2 + Vector3.new(0, 1.7, 0), (a + b) / 2 + Vector3.new(0, 1.7, 0) + out), Vector3.new(len, 3.4, 0.8), "Rail")
		return m
	end
	return Kit.railingParts(parent, a, b)
end

function Kit.gate(parent: Instance, cf: CFrame, width: number): Model
	if noKit("Quarry_Gate") then
		local m = Kit.model(parent, "CT_Rocks_EntranceGate")
		noPlace(m, "Quarry_Gate", cf, width * 1.25 / 17.2, "Gate")
		return m
	end
	return Kit.gateParts(parent, cf, width)
end

function Kit.shelter(parent: Instance, cf: CFrame, w: number, d: number): Model
	if noKit("Storage_Nook") then
		local s = w / 13.5 * 1.1
		local m = noPlace(parent, "Storage_Nook", cf * CFrame.new(0, 0, 4.2 * s), s, "CT_Rocks_EquipmentShelter")
		Kit.lodgeSkin(m)
		if m then
			KitPlace.blocker(m, cf * CFrame.new(0, 3, 8.2 * s), Vector3.new(13.4 * s, 6, 0.8), "BackWall")
			local lamp = m.PrimaryPart
			if lamp then
				local l = Instance.new("PointLight")
				l.Range = 16
				l.Brightness = 0.9
				l.Color = Color3.fromRGB(255, 214, 160)
				l.Parent = lamp
			end
			return m
		end
	end
	return Kit.shelterParts(parent, cf, w, d)
end

function Kit.compressor(parent: Instance, cf: CFrame): Model
	local m = noPlace(parent, "Prop_Compressor", cf, 1.4, "CT_Rocks_Compressor")
	KitPlace.solidify(m)
	return m or Kit.compressorParts(parent, cf)
end

function Kit.generator(parent: Instance, cf: CFrame): Model
	local m = noPlace(parent, "Prop_Generator", cf, 1.4, "CT_Rocks_Generator")
	KitPlace.solidify(m)
	return m or Kit.generatorParts(parent, cf)
end

local CRATE_KIT = { "Prop_CrateSmall", "Prop_CrateMedium", "Prop_CrateLarge" }
local CRATE_SCALE = { 1.05, 1.1, 1.15 }
function Kit.crate(parent: Instance, cf: CFrame, size: number): Model
	local i = math.clamp(size, 1, 3)
	local m = noPlace(parent, CRATE_KIT[i], cf, CRATE_SCALE[i], "CT_Rocks_Crate" .. size)
	KitPlace.solidify(m)
	return m or Kit.crateParts(parent, cf, size)
end

function Kit.pallet(parent: Instance, cf: CFrame): Model
	return noPlace(parent, "Prop_Pallet", cf, 1.0, "CT_Rocks_Pallet") or Kit.palletParts(parent, cf)
end

function Kit.rockBin(parent: Instance, cf: CFrame, rng: Random): Model
	local m = noPlace(parent, "Prop_StoneBin", cf, 1.35, "CT_Rocks_RockBin")
	KitPlace.solidify(m)
	return m or Kit.rockBinParts(parent, cf, rng)
end

function Kit.cart(parent: Instance, cf: CFrame): Model
	local m = noPlace(parent, "Prop_Handcart", cf, 1.2, "CT_Rocks_Cart")
	KitPlace.solidify(m)
	return m or Kit.cartParts(parent, cf)
end

-- Sell hopper (pass 2): a wooden bin on a timber skid with steel straps, a heap of rubble on top, wooden steps
-- and a SELL RUBBLE board on two posts (owner's quarry target). Contract kept: Model "CT_Rocks_SellHopper"
-- with attribute Hopper, a solid "Body" part carrying the ProximityPrompt "SellPrompt" (attribute Sell) and a
-- "ReceiptLight" lamp. `cf` = floor centre, -Z faces the pile (the side players walk up to).
local SHELL_TINTS = { Color3.fromRGB(255, 240, 220), Color3.fromRGB(255, 214, 224), Color3.fromRGB(206, 232, 255), Color3.fromRGB(220, 246, 214), Color3.fromRGB(255, 244, 178) }
local function shellTint(rng: Random): Color3
	return SHELL_TINTS[rng:NextInteger(1, #SHELL_TINTS)]
end

local function woodHopperParts(parent: Instance, cf: CFrame, rng: Random): Model
	-- lodge kit language: timber bin, dark timber skid and seams, iron straps and rim, a framed sign-wood board
	local m = Kit.model(parent, "CT_Rocks_SellHopper")
	Kit.deco(Kit.part(m, "Skid", Vector3.new(7.4, 0.5, 5.6), cf * CFrame.new(0, 0.25, 0.2), L.TimberDark, Enum.Material.WoodPlanks))
	local body = Kit.part(m, "Body", Vector3.new(6.2, 2.9, 4.4), cf * CFrame.new(0, 1.95, 0.2), L.Timber, Enum.Material.WoodPlanks)
	-- plank seams and iron straps on the three visible faces
	for i = -2, 2 do
		Kit.deco(Kit.part(m, "Seam", Vector3.new(0.06, 2.6, 0.06), cf * CFrame.new(i * 1.2, 1.95, -2.02), L.TimberDark, Enum.Material.Wood))
	end
	for _, x in { -2.9, 0, 2.9 } do
		Kit.deco(Kit.part(m, "Strap", Vector3.new(0.3, 3.0, 0.12), cf * CFrame.new(x, 1.95, -2.04), L.Iron, Enum.Material.Wood))
	end
	for _, sx in { -1, 1 } do
		Kit.deco(Kit.part(m, "Strap", Vector3.new(0.12, 3.0, 0.3), cf * CFrame.new(sx * 3.14, 1.95, 0.2), L.Iron, Enum.Material.Wood))
	end
	-- top rim (iron) and the rubble heap showing above it
	Kit.deco(Kit.part(m, "RimF", Vector3.new(6.4, 0.2, 0.3), cf * CFrame.new(0, 3.5, -1.95), L.Iron, Enum.Material.Wood))
	Kit.deco(Kit.part(m, "RimB", Vector3.new(6.4, 0.2, 0.3), cf * CFrame.new(0, 3.5, 2.35), L.Iron, Enum.Material.Wood))
	for _, sx in { -1, 1 } do
		Kit.deco(Kit.part(m, "RimS", Vector3.new(0.3, 0.2, 4.4), cf * CFrame.new(sx * 3.05, 3.5, 0.2), L.Iron, Enum.Material.Wood))
	end
	Kit.deco(Kit.part(m, "Fill", Vector3.new(5.7, 0.3, 3.9), cf * CFrame.new(0, 3.45, 0.2), Color3.fromRGB(255, 244, 214), Enum.Material.Fabric))
	for i = 1, 11 do
		local sz = rng:NextNumber(0.7, 1.3)
		local x, z = rng:NextNumber(-2.3, 2.3), rng:NextNumber(-1.4, 1.8)
		local lift = (1 - (math.abs(x) / 2.8 + math.abs(z - 0.2) / 2.2) * 0.45) * 0.55
		Kit.deco(Kit.part(m, "Shell", Vector3.new(sz, sz * 0.7, sz * 0.9), cf * CFrame.new(x, 3.6 + math.max(lift, 0.1), 0.2 + z) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6.28), rng:NextNumber(-0.5, 0.5)), shellTint(rng), Enum.Material.SmoothPlastic))
	end
	-- timber steps up the left side
	for k = 1, 3 do
		Kit.part(m, "Step", Vector3.new(1.6, 0.55 * k, 1.2), cf * CFrame.new(-4.6, 0.275 * k, 0.2 + (k - 2) * 1.0), L.TimberDark:Lerp(L.Timber, 0.4), Enum.Material.WoodPlanks)
	end
	-- framed SELL RUBBLE board on two timber posts above the front edge. The board's face is 0.6 in front of the
	-- posts, the posts stop below its top rail and nothing else stands in front of it (text never covered).
	for _, sx in { -2.75, 2.75 } do
		Kit.part(m, "SignPost", Vector3.new(0.45, 5.6, 0.45), cf * CFrame.new(sx, 2.8, -2.25), L.Timber, Enum.Material.Wood)
	end
	KitPlace.signBoard(m, "Sign", cf * CFrame.new(0, 5.25, -2.6) * CFrame.Angles(0, math.pi, 0), 4.8, 1.4, "SELL CANDY", "Landmark", {
		Face = L.SignWood,
		Frame = L.TimberDark,
		Ink = L.Cream,
		Trim = L.Gold,
		Depth = 0.35,
	})
	local lamp = Kit.deco(Kit.part(m, "ReceiptLight", Vector3.new(0.6, 0.6, 0.6), cf * CFrame.new(3.25, 5.0, -2.25), C.Mint, Enum.Material.Neon, Enum.PartType.Ball))
	lamp.Name = "ReceiptLight"
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "SellPrompt"
	pp.ActionText = "Sell Candy"
	pp.ObjectText = "Candy Stand"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R -- E is the crack key on keyboards
	pp.UIOffset = Vector2.new(0, 30)
	pp:SetAttribute("Panel", "")
	pp:SetAttribute("Sell", true)
	pp.Parent = body
	-- the owner's Meshy stand (ServerStorage.MeshyAssets.MeshySellStand) replaces the timber bin look; Body stays as the
	-- invisible collider that carries the prompt, and the sign and receipt light stay
	local stand = KitPlace.meshy("MeshySellStand", cf * CFrame.new(0, 2.6, 0.4) * CFrame.Angles(0, math.pi, 0), Vector3.new(8, 5.2, 6))
	if stand then
		for _, d in m:GetChildren() do
			if d:IsA("BasePart") and (d.Name == "Skid" or d.Name == "Seam" or d.Name == "Strap" or d.Name:sub(1, 3) == "Rim" or d.Name == "Fill" or d.Name == "Shell" or d.Name == "Step") then
				d:Destroy()
			end
		end
		body.Transparency = 1
		stand.Name = "StandMesh"
		stand.Parent = m
	end
	m:SetAttribute("Hopper", true) -- contract: EconomyService, PileView, Hud and Main.client look for "Hopper"
	m.PrimaryPart = body
	return m
end

function Kit.hopper(parent: Instance, cf: CFrame, rng: Random): Model
	return woodHopperParts(parent, cf, rng)
end

-- Small wooden gantry crane (pass 2): two timber A-frames, a top beam, a small work platform with a rail and a
-- hanging grab. About 14 wide, 13 tall; `cf` = floor centre, the beam runs along X. Replaces the huge steel
-- tower crane. The grab is the Crane_Bucket kit mesh when loaded, else a few dark Parts.
function Kit.crane(parent: Instance, cf: CFrame, height: number): Model
	local m = Kit.model(parent, "CT_Rocks_Crane")
	local h = height
	local half = 6.2
	local timber = L.Timber
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.bar(m, "Leg", cf:PointToWorldSpace(Vector3.new(sx * (half + 1.2), 0, sz * 2.4)), cf:PointToWorldSpace(Vector3.new(sx * half, h, sz * 0.5)), 0.9, timber, Enum.Material.Wood)
		end
		Kit.deco(Kit.part(m, "Footing", Vector3.new(2.6, 0.5, 6.4), cf * CFrame.new(sx * (half + 1.2), 0.25, 0), L.Stone, Enum.Material.Slate))
		Kit.deco(Kit.bar(m, "Brace", cf:PointToWorldSpace(Vector3.new(sx * (half + 0.8), h * 0.25, 1.6)), cf:PointToWorldSpace(Vector3.new(sx * (half + 0.8), h * 0.25, -1.6)), 0.45, timber, Enum.Material.Wood))
		Kit.deco(Kit.part(m, "Plate", Vector3.new(1.4, 1.4, 0.3), cf * CFrame.new(sx * half, h - 0.6, -0.75), L.Iron, Enum.Material.Metal))
	end
	Kit.part(m, "Beam", Vector3.new(half * 2 + 3.4, 1.1, 1.3), cf * CFrame.new(0, h + 0.2, 0), timber, Enum.Material.Wood)
	Kit.deco(Kit.part(m, "BeamStrap", Vector3.new(0.35, 1.3, 1.5), cf * CFrame.new(-half, h + 0.2, 0), L.Iron, Enum.Material.Metal))
	Kit.deco(Kit.part(m, "BeamStrap", Vector3.new(0.35, 1.3, 1.5), cf * CFrame.new(half, h + 0.2, 0), L.Iron, Enum.Material.Metal))
	-- work platform on the left frame, railing toward the arena
	local deckY = h * 0.45
	Kit.part(m, "Deck", Vector3.new(4.2, 0.4, 5.4), cf * CFrame.new(-half - 0.2, deckY, 0), L.TimberLight, Enum.Material.WoodPlanks)
	for _, z in { -2.5, 2.5 } do
		Kit.deco(Kit.part(m, "RailPost", Vector3.new(0.3, 2.4, 0.3), cf * CFrame.new(-half - 0.2, deckY + 1.2, z), timber, Enum.Material.Wood))
	end
	Kit.deco(Kit.part(m, "Rail", Vector3.new(0.25, 0.25, 5.4), cf * CFrame.new(-half + 1.8, deckY + 2.2, 0), timber, Enum.Material.Wood))
	Kit.deco(Kit.part(m, "Rail", Vector3.new(4.2, 0.25, 0.25), cf * CFrame.new(-half - 0.2, deckY + 2.2, -2.6), timber, Enum.Material.Wood))
	-- hanging grab (cable, hook block, two claws) near the middle of the beam
	local hookX = 1.2
	local dropY = h * 0.52
	Kit.deco(Kit.part(m, "Cable", Vector3.new(0.14, h - dropY, 0.14), cf * CFrame.new(hookX, (h + dropY) / 2, 0), L.Iron, Enum.Material.Metal))
	local bucketAt = cf:PointToWorldSpace(Vector3.new(hookX, dropY, 0))
	local placed = false
	if noKit("Crane_Bucket") then
		local bucket = noPlace(m, "Crane_Bucket", CFrame.new(bucketAt) * (cf - cf.Position), 0.8, "Bucket")
		Kit.lodgeSkin(bucket)
		placed = bucket ~= nil
	end
	if not placed then
		Kit.deco(Kit.part(m, "Grab", Vector3.new(1.4, 0.8, 1.4), cf * CFrame.new(hookX, dropY, 0), C.Charcoal, Enum.Material.Metal))
		for _, sx in { -1, 1 } do
			Kit.deco(Kit.part(m, "Claw", Vector3.new(0.3, 2.0, 1.2), cf * CFrame.new(hookX + sx * 0.8, dropY - 1.2, 0) * CFrame.Angles(0, 0, math.rad(-sx * 18)), C.Slate, Enum.Material.Metal))
		end
	end
	return m
end

-- Quarry perimeter pass (Master Prompt 5 section 8) -----------------------------------------------

-- Flat floor treatment (gravel band, worn path, dust): visual only, no shadow, ignored by the camera.
function Kit.floorPatch(parent: Instance, name: string, cf: CFrame, size: Vector3, color: Color3, mat: Enum.Material?): Part
	local p = Kit.deco(Kit.part(parent, name, size, cf, color, mat or Enum.Material.Ground))
	p.CastShadow = false
	p:SetAttribute("CameraIgnore", true)
	return p
end

-- Terraced strata cliffs (blender/models/quarry_strata.py). Kit width and the depth of the front foot in
-- front of the model origin, per kind; the model is scaled to `w` and placed so its front foot lies on `cf`.
local STRATA = {
	Low = { w = 28, foot = 4.0, h = 9 },
	Mid = { w = 30, foot = 6.0, h = 14.5 },
	High = { w = 30, foot = 6.0, h = 19 },
	Shoulder = { w = 24, foot = 4.5, h = 12 },
	-- layered bedded walls (Cliff_Strata_A..C): origin on the front foot line
	LayerA = { w = 30, foot = 1.0, h = 14, mesh = "Cliff_Strata_A" },
	LayerB = { w = 28, foot = 1.0, h = 11, mesh = "Cliff_Strata_B" },
	LayerC = { w = 32, foot = 1.0, h = 15, mesh = "Cliff_Strata_C" },
}
Kit.StrataKinds = { "Low", "Mid", "Shoulder", "Mid", "High" }

-- `cf` = base-front-centre of the cliff (-Z faces the arena), `w` the width it should fill. Falls back to the
-- Part stepped cliff when the mesh is not loaded.
function Kit.strata(parent: Instance, cf: CFrame, kind: string, w: number, rng: Random): Model
	local spec = STRATA[kind] or STRATA.Mid
	if noKit(spec.mesh or "Strata_" .. kind) then
		local s = w / spec.w
		local m = noPlace(parent, spec.mesh or "Strata_" .. kind, cf * CFrame.new(0, 0, spec.foot * s), s, "CT_Rocks_Strata_" .. kind)
		if m then
			return m
		end
	end
	if spec.mesh and noKit("Strata_Mid") then
		return Kit.strata(parent, cf, "Mid", w, rng)
	end
	return Kit.cliff(parent, cf, rng:NextInteger(1, 8), w, spec.h * w / spec.w, rng)
end

-- Ground-to-cliff transition cluster (gravel mound + scenery stones). `cf` = floor centre, -Z to the arena.
function Kit.rubbleSkirt(parent: Instance, cf: CFrame, scale: number, rng: Random): Model
	local m = noPlace(parent, "Rubble_Skirt", cf, scale, "CT_Rocks_RubbleSkirt")
	if m then
		return m
	end
	local f = Kit.boulders(parent, cf, 1.6 * scale, rng, 3)
	Kit.grit(f, cf.Position, 3 * scale, rng, 4)
	return f
end

-- Narrow-gauge cart track from a to b on the floor: 8-stud segments, a buffer stop at b, an ore cart parked
-- on the first segment. Decorative and walk-over (no collision).
function Kit.cartTrack(parent: Instance, a: Vector3, b: Vector3): Model
	local m = Kit.model(parent, "CT_Rocks_CartTrack")
	local d = b - a
	local u = d.Unit
	local look = Vector3.new(-u.Z, 0, u.X) -- kit X runs along the track (kit -X = +u, the buffer end)
	local function at(dist: number): CFrame
		local p = a + u * dist
		return CFrame.lookAt(p, p + look)
	end
	local segs = math.max(1, math.floor((d.Magnitude - 3) / 8))
	local kit = noKit("Cart_Track", "Track_Buffer", "Mine_Cart")
	if kit then
		for i = 0, segs - 1 do
			noPlace(m, "Cart_Track", at(4 + i * 8), 1, "Track")
		end
		noPlace(m, "Track_Buffer", at(segs * 8 + 1.5), 1, "Buffer")
		noPlace(m, "Mine_Cart", at(4.2), 1, "Cart")
	else
		local len = segs * 8 + 3
		local mid = at(len / 2)
		Kit.deco(Kit.part(m, "Ballast", Vector3.new(len, 0.24, 3), mid * CFrame.new(0, 0.12, 0), C.Bench, Enum.Material.Pebble))
		for k = 0, math.floor(len / 0.95) - 1 do
			Kit.deco(Kit.part(m, "Sleeper", Vector3.new(0.5, 0.2, 2.4), at(0.5 + k * 0.95) * CFrame.new(0, 0.32, 0), Color3.fromRGB(122, 86, 52), Enum.Material.Wood))
		end
		for _, sz in { -0.75, 0.75 } do
			Kit.deco(Kit.part(m, "Rail", Vector3.new(len, 0.24, 0.16), mid * CFrame.new(0, 0.54, sz), C.Steel, Enum.Material.Metal))
		end
		Kit.deco(Kit.part(m, "Buffer", Vector3.new(0.9, 1.2, 2.6), at(len - 0.45) * CFrame.new(0, 0.84, 0), Color3.fromRGB(122, 86, 52), Enum.Material.Wood))
		Kit.cartParts(m, at(4.2))
	end
	return m
end

-- Lean-to tool shelter (tool wall, workbench, lantern). `cf` = floor centre, -Z = open front. The kit mesh
-- does not collide: an invisible blocker stands in for the back wall.
function Kit.toolShelter(parent: Instance, cf: CFrame): Model
	local m = noPlace(parent, "Quarry_ToolShelter", cf, 1, "CT_Rocks_ToolShelter")
	Kit.lodgeSkin(m)
	if m then
		KitPlace.blocker(m, cf * CFrame.new(0, 2.4, 2.2), Vector3.new(9, 4.8, 0.6), "BackWall")
		local root = m:FindFirstChild("Root")
		local a = root and root:FindFirstChild("Light")
		if a then
			local l = Instance.new("PointLight")
			l.Range = 12
			l.Brightness = 0.6
			l.Color = Color3.fromRGB(255, 214, 160)
			l.Parent = a
		end
		return m
	end
	return Kit.shelterParts(parent, cf * CFrame.new(0, 0, -2.5), 9, 5)
end

-- Small prop from the utility kit at `cf` (nil when absent); used by ArenaBuilder for placed set dressing.
-- Floor props get simple collision (kit meshes never collide); wall-mounted ones (Wall_Lamp) do not.
function Kit.kitProp(parent: Instance, name: string, cf: CFrame, scale: number?): Model?
	local m = KitPlace.place(parent, name, cf, scale or 1.0)
	if m and name ~= "Wall_Lamp" then
		KitPlace.solidify(m)
	end
	return m
end

-- Meadow scenery (replaces the quarry cliffs): soft green hills, hedges, round trees, bushes, flowers, hay bales.
-- All low-poly balls and blocks. REPLACE: real mesh (hill / tree / flower) when uploaded.
local FLOWER_COLORS = {
	Color3.fromRGB(255, 142, 170), Color3.fromRGB(255, 226, 96), Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(176, 150, 255), Color3.fromRGB(255, 170, 96), Color3.fromRGB(130, 200, 255),
}
local function ball(parent: Instance, name: string, pos: Vector3, dia: number, color: Color3, mat: Enum.Material?, squash: number?): Part
	return Kit.part(parent, name, Vector3.new(dia, dia * (squash or 1), dia), CFrame.new(pos), color, mat or Enum.Material.Grass, Enum.PartType.Ball)
end

-- `cf` = base-front-centre (-Z faces the arena), `w` the width, `h` roughly the height of the highest dome.
function Kit.hill(parent: Instance, cf: CFrame, w: number, h: number, rng: Random): Model
	local name = if rng:NextNumber() < 0.5 then "Hill_A" else "Hill_B"
	if meadow(name) then
		-- one soft rolling Blender hill stretched to w x h, a little deeper than wide is tall
		local nat: Vector3 = MeadowKit.size(name)
		local flip = if rng:NextNumber() < 0.5 then math.pi else 0
		local scale = Vector3.new(w * 1.05 / nat.X, h / nat.Y, w * 0.62 / nat.Z)
		return MeadowKit.place(parent, name, "CT_Rocks_Hill", cf * CFrame.new(0, 0, 4) * CFrame.Angles(0, flip, 0), scale)
	end
	local m = Kit.model(parent, "CT_Rocks_Hill")
	local n = 3
	for i = 1, n do
		local t = (i - 0.5) / n - 0.5
		local dia = w * rng:NextNumber(0.5, 0.7)
		local hh = h * rng:NextNumber(0.7, 1.0)
		local col = C.Stone[rng:NextInteger(1, 3)]
		-- dome: ball squashed to its height, centre sunk so only the top shows above the floor
		local pos = cf:PointToWorldSpace(Vector3.new(t * w * 0.9, hh * 0.35 - dia * 0.2, rng:NextNumber(2, 6)))
		local b = ball(m, "Dome", pos, dia, col, Enum.Material.Grass, hh / dia * 1.3)
		b.CanCollide = false
	end
	return m
end

function Kit.hedge(parent: Instance, a: Vector3, b: Vector3, height: number, rng: Random): Model
	local len = (b - a).Magnitude
	local n = math.max(1, math.floor(len / 3.2))
	if meadow("Hedge_A") and len > 0.1 then
		local m = Kit.model(parent, "CT_Rocks_Hedge")
		local nat: Vector3 = MeadowKit.size("Hedge_A")
		local dir = (b - a).Unit
		for i = 0, n - 1 do
			local p = a:Lerp(b, (i + 0.5) / n)
			local cf = CFrame.lookAt(p, p + Vector3.new(-dir.Z, 0, dir.X)) * CFrame.Angles(0, rng:NextNumber(-0.08, 0.08), 0)
			local s = rng:NextNumber(0.95, 1.15)
			local piece = MeadowKit.place(m, "Hedge_A", "Bush", cf,
				Vector3.new(len / n * 1.15 / nat.X, height * s / nat.Y, 3.0 * s / nat.Z))
			if piece then
				for _, d in piece:GetChildren() do
					d.Name = "Bush"
					d.Parent = m
				end
				piece:Destroy()
			end
		end
		return m
	end
	local m = Kit.model(parent, "CT_Rocks_Hedge")
	for i = 0, n - 1 do
		local p = a:Lerp(b, (i + 0.5) / n)
		local col = C.Stone[2]:Lerp(Color3.fromRGB(64, 150, 70), rng:NextNumber(0.2, 0.7))
		ball(m, "Bush", p + Vector3.new(0, height * 0.4, 0), 3.6 * rng:NextNumber(0.9, 1.15), col, Enum.Material.Grass, height / 3.2)
	end
	return m
end

function Kit.tree(parent: Instance, pos: Vector3, scale: number, rng: Random): Model
	local name = if rng:NextNumber() < 0.55 then "Tree_A" else "Tree_B"
	if meadow(name) then
		-- about as tall as the old ball tree (13 studs at scale 1); the trunk collides
		local nat: Vector3 = MeadowKit.size(name)
		local cf = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		return MeadowKit.place(parent, name, "CT_Rocks_Tree", cf, 13.5 * scale / nat.Y, { Trunk = true })
	end
	local m = Kit.model(parent, "CT_Rocks_Tree")
	local trunkH = 5 * scale
	Kit.part(m, "Trunk", Vector3.new(trunkH, 1.4 * scale, 1.4 * scale), CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), L.TimberDark:Lerp(L.Timber, 0.3), Enum.Material.Wood, Enum.PartType.Cylinder)
	local leaf = Color3.fromRGB(74, 170, 78):Lerp(Color3.fromRGB(120, 200, 80), rng:NextNumber(0, 0.6))
	ball(m, "Crown", pos + Vector3.new(0, trunkH + 3.2 * scale, 0), 8 * scale, leaf, Enum.Material.Grass)
	ball(m, "CrownTop", pos + Vector3.new(0.6 * scale, trunkH + 6.2 * scale, 0.4 * scale), 5 * scale, leaf:Lerp(Color3.new(1, 1, 1), 0.12), Enum.Material.Grass)
	return m
end

function Kit.bushCluster(parent: Instance, pos: Vector3, scale: number, rng: Random): Model
	local name = if rng:NextNumber() < 0.5 then "Bush_A" else "Bush_B"
	if meadow(name) then
		local nat: Vector3 = MeadowKit.size(name)
		local cf = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		local m = MeadowKit.place(parent, name, "CT_Rocks_Bushes", cf, 3.4 * scale / nat.Y)
		-- a fern or a boulder tucked in front now and then
		local extra = if rng:NextNumber() < 0.5 then "Fern_A" else "Boulder_A"
		if m and meadow(extra) and rng:NextNumber() < 0.6 then
			local o = cf * CFrame.new(rng:NextNumber(-1.5, 1.5) * scale, 0, -2.2 * scale)
			local piece = MeadowKit.place(m, extra, extra, o * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), scale * 0.7)
			if piece and extra == "Boulder_A" then
				for _, d in piece:GetDescendants() do
					if d:IsA("BasePart") then
						d.CanCollide = true
					end
				end
			end
		end
		return m
	end
	local m = Kit.model(parent, "CT_Rocks_Bushes")
	for i = 1, 3 do
		local o = Vector3.new(rng:NextNumber(-1.6, 1.6) * scale, 0, rng:NextNumber(-1.2, 1.2) * scale)
		local d = rng:NextNumber(2.4, 3.6) * scale
		ball(m, "Bush", pos + o + Vector3.new(0, d * 0.3, 0), d, C.Stone[rng:NextInteger(1, 3)]:Lerp(Color3.fromRGB(60, 150, 70), 0.3), Enum.Material.Grass, 0.8)
	end
	return m
end

function Kit.flower(parent: Instance, pos: Vector3, rng: Random)
	local name = "Flowers_" .. rng:NextInteger(0, 3)
	if meadow(name) then
		-- a little clump of daisies with leaves (visual only)
		local cf = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		MeadowKit.place(parent, name, "Flowers", cf, rng:NextNumber(0.75, 1.1))
		return
	end
	local col = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)]
	local s = rng:NextNumber(0.8, 1.3)
	Kit.deco(Kit.part(parent, "Stem", Vector3.new(0.9 * s, 0.14, 0.14), CFrame.new(pos + Vector3.new(0, 0.45 * s, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(70, 150, 70), Enum.Material.Grass, Enum.PartType.Cylinder)).CanCollide = false
	local head = ball(parent, "Bloom", pos + Vector3.new(0, 0.95 * s, 0), 0.55 * s, col, Enum.Material.SmoothPlastic)
	head.CanCollide = false
	Kit.deco(head)
	local mid = ball(parent, "Heart", pos + Vector3.new(0, 1.0 * s, 0), 0.25 * s, Color3.fromRGB(255, 204, 70), Enum.Material.SmoothPlastic)
	Kit.deco(mid)
	mid.CanCollide = false
end

function Kit.hayBale(parent: Instance, cf: CFrame): Model
	local m = Kit.model(parent, "CT_Rocks_HayBale")
	local mesh = KitPlace.meshy("MeshyHayBale", cf * CFrame.new(0, 1.2, 0), Vector3.new(2.8, 2.4, 2.8))
	if mesh then
		mesh.Name = "Bale"
		mesh.Parent = m
		return m
	end
	Kit.part(m, "Bale", Vector3.new(2.6, 2.2, 2.2), cf * CFrame.new(0, 1.1, 0), Color3.fromRGB(240, 208, 112), Enum.Material.Fabric, Enum.PartType.Cylinder)
	Kit.deco(Kit.part(m, "Band", Vector3.new(0.3, 2.3, 2.3), cf * CFrame.new(-0.6, 1.1, 0), Color3.fromRGB(190, 120, 90), Enum.Material.Fabric, Enum.PartType.Cylinder))
	Kit.deco(Kit.part(m, "Band", Vector3.new(0.3, 2.3, 2.3), cf * CFrame.new(0.6, 1.1, 0), Color3.fromRGB(190, 120, 90), Enum.Material.Fabric, Enum.PartType.Cylinder))
	return m
end

return Kit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="216">
        <Properties>
          <string name="Name">AwardLedger</string>
          <string name="Source"><![CDATA[--!strict
-- Durable record of match wins. One entry per award key (MatchKey:RoundId):
--   { Winner, Specimen, State = "pending" | "applied", Time }
-- The winner decision and specimen are written here before the reveal. The grant to the
-- winner's profile is a separate write (two stores cannot be updated atomically), so:
--   * the profile records the award key with the item (idempotent grant), and
--   * if the winner is not on this server any more, the key goes into their pending list and
--     is applied on their next load.
-- If the ledger cannot be reached (Studio without API access), the in-memory grant and the
-- normal profile save still happen; only the cross-session recovery is missing.

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Profiles = require(script.Parent.Profiles)

local Ledger = {}

-- A pending key whose ledger entry is still missing after this long is dropped (Ledger.record retries for 10 minutes).
local MISSING_EXPIRY_SECONDS = 3 * 24 * 3600

local SUFFIX = if RunService:IsStudio() then "_Studio" else ""
local ledger: DataStore? = nil
local pending: DataStore? = nil
pcall(function()
	ledger = DataStoreService:GetDataStore(Config.Save.LedgerName .. SUFFIX)
	pending = DataStoreService:GetDataStore(Config.Save.PendingName .. SUFFIX)
end)

local function retry(fn: () -> ()): boolean
	for attempt = 1, 4 do
		local ok: boolean, err: any = pcall(fn)
		if ok then
			return true
		end
		warn("[Ledger]", err)
		task.wait(2 ^ attempt * 0.5)
	end
	return false
end

-- Writes the decision if no entry exists yet. Returns the stored (canonical) entry.
function Ledger.record(awardKey: string, winner: number, specimen): any
	local stored = { Winner = winner, Specimen = specimen, State = "pending", Time = os.time() }
	if not ledger then
		return stored
	end
	local ds = ledger :: DataStore
	local result = stored
	local function write()
		ds:UpdateAsync(awardKey, function(old)
			if old then
				result = old
				return nil
			end
			result = stored
			return stored
		end)
	end
	if not retry(write) then
		-- outage: keep trying in the background (every 30 s for 10 minutes) so the decision still
		-- becomes durable and a pending key written later can find its entry
		task.spawn(function()
			for _ = 1, 20 do
				task.wait(30)
				if pcall(write) then
					return
				end
			end
			warn("[Ledger] could not store the decision for", awardKey)
		end)
	end
	return result
end

-- Grants applied in memory whose own save failed, per player, until a later committed save carries them.
local unsaved: { [Player]: { { Key: string, At: number } } } = {}

-- markApplied writes still running; BindToClose waits for them (Profiles.onShutdown).
local inFlight = 0

function Ledger.markApplied(awardKey: string)
	if not ledger then
		return
	end
	local ds = ledger :: DataStore
	inFlight += 1
	task.spawn(function()
		pcall(retry, function()
			ds:UpdateAsync(awardKey, function(old)
				if not old then
					return nil
				end
				old.State = "applied"
				return old
			end)
		end)
		inFlight -= 1
	end)
end

Profiles.onShutdown(function()
	while inFlight > 0 do
		task.wait(0.2) -- Profiles bounds the whole shutdown wait
	end
end)

function Ledger.addPending(userId: number, awardKey: string): boolean
	if not pending then
		return false
	end
	local ds = pending :: DataStore
	return retry(function()
		ds:UpdateAsync("p_" .. userId, function(old)
			old = old or {}
			if not table.find(old, awardKey) then
				table.insert(old, awardKey)
			end
			return old
		end)
	end)
end

-- addPending with a slow background retry (every 30 s for 10 minutes) so a DataStore outage
-- right after a winner leaves does not silently drop the prize.
function Ledger.ensurePending(userId: number, awardKey: string)
	if Ledger.addPending(userId, awardKey) then
		return
	end
	task.spawn(function()
		for _ = 1, 20 do
			task.wait(30)
			if Ledger.addPending(userId, awardKey) then
				return
			end
		end
		warn("[Ledger] could not record pending award", awardKey, "for", userId, "- the ledger entry stays pending")
	end)
end

-- Grants a decided award to a player who is on this server. Holds the profile open while
-- saving so a leaving winner still gets it.
-- Returns (granted or saved, saved): only a saved grant may leave the pending list.
function Ledger.apply(player: Player, awardKey: string, specimen, kind: string): (boolean, boolean)
	Profiles.hold(player)
	local granted = Profiles.grantSpecimen(player, awardKey, specimen, kind)
	local saved = Profiles.saveNow(player)
	Profiles.unhold(player)
	if kind == "Tutorial" then
		-- practice rounds write no ledger entry, so a pending key could never resolve; an unsaved practice pet
		-- stays in memory and goes out with the next autosave or the leave save
		return granted or saved, saved
	end
	if saved then
		Ledger.markApplied(awardKey)
	else
		-- the grant lives only in memory: make sure the next join can still find the award
		Ledger.ensurePending(player.UserId, awardKey)
		if granted then
			-- the next committed save (autosave or leave) carries it: mark the entry applied then (Profiles.onSaved)
			local list = unsaved[player] or {}
			unsaved[player] = list
			table.insert(list, { Key = awardKey, At = os.clock() })
		end
	end
	return granted or saved, saved
end

-- A later save that started after an unsaved grant committed it: the ledger entry is applied now, so a rejoin never
-- has to resolve it again (and a sold pet whose key left RecentAwardIds is never granted twice).
Profiles.onSaved(function(player: Player, startedAt: number)
	local list = unsaved[player]
	if not list then
		return
	end
	local keep = {}
	for _, u in list do
		if startedAt >= u.At then
			Ledger.markApplied(u.Key)
		else
			table.insert(keep, u)
		end
	end
	if #keep > 0 then
		unsaved[player] = keep
	else
		unsaved[player] = nil
	end
end)
game:GetService("Players").PlayerRemoving:Connect(function(player: Player)
	-- the leave save runs first (the profile stays loaded until it lands), so drop the list once it is gone
	task.spawn(function()
		local t0 = os.clock()
		while Profiles.isLoaded(player) and os.clock() - t0 < 300 do
			task.wait(1)
		end
		unsaved[player] = nil
	end)
end)

-- On profile load: apply any awards decided while the player was away.
function Ledger.reconcile(player: Player)
	if not pending or not ledger or Profiles.isOffline(player) then
		return
	end
	local pds, lds = pending :: DataStore, ledger :: DataStore
	local keys: { any } = {}
	local okRead = retry(function()
		keys = pds:GetAsync("p_" .. player.UserId) or {}
	end)
	if not okRead or #keys == 0 then
		return
	end
	local done = {}
	local missing: { string } = {}
	for _, awardKey in keys do
		local entry
		local readOk = type(awardKey) == "string" and retry(function()
			entry = lds:GetAsync(awardKey)
		end)
		if type(awardKey) ~= "string" then
			table.insert(done, awardKey) -- junk in the list can never resolve
		elseif not readOk then
			continue -- read failed: try again on the next join
		elseif entry == nil then
			table.insert(missing, awardKey) -- no decision stored (yet): expires below
		elseif type(entry) ~= "table" or entry.Winner ~= player.UserId or not entry.Specimen then
			table.insert(done, awardKey) -- not this player's prize: it can never be granted here
		else
			if not player.Parent then
				return
			end
			if entry.State == "applied" then
				table.insert(done, awardKey) -- already in a committed save: never grant it twice
			else
				local kind = if entry.Specimen.Solo then "Solo" else "Multiplayer"
				local _, saved = Ledger.apply(player, awardKey, entry.Specimen, kind)
				if saved then
					table.insert(done, awardKey) -- a failed save keeps the key pending for the next join
				end
			end
		end
	end
	-- A pending key whose ledger entry never appeared (the decision write failed for its whole 10 minute retry,
	-- or an old practice round) would stay forever. Remember when each was first seen missing; after
	-- MISSING_EXPIRY_SECONDS it is dropped. Keys that resolved are forgotten here too.
	local missKey = "m_" .. player.UserId
	local now = os.time()
	retry(function()
		pds:UpdateAsync(missKey, function(old)
			local seen = if type(old) == "table" then old else {}
			local out = {}
			for _, k in missing do
				local first = tonumber(seen[k]) or now
				out[k] = first
				if now - first >= MISSING_EXPIRY_SECONDS then
					table.insert(done, k)
					out[k] = nil
				end
			end
			if next(out) == nil and next(seen) == nil then
				return nil -- nothing to remember, nothing stored: no write
			end
			return out
		end)
	end)
	if #done > 0 then
		retry(function()
			pds:UpdateAsync("p_" .. player.UserId, function(old)
				old = old or {}
				local keep = {}
				for _, k in old do
					if not table.find(done, k) then
						table.insert(keep, k)
					end
				end
				return keep
			end)
		end)
	end
end

return Ledger
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="217">
        <Properties>
          <string name="Name">BadgeService</string>
          <string name="Source"><![CDATA[--!strict
-- Roblox badges for launch milestones (ids in shared/ProgressConfig.Badges; 0 = off until the owner creates the badge
-- and pastes its id there, see the REPLACE note). Awarded by the server from the saved profile only:
--   FirstHatch  - hatched your first pet (the free starter pet does not count)
--   FirstRare   - own (or once owned) a Rare, Epic or Legendary pet
--   AllHuntPets - found every released hunt pet species (35 at launch, 45 once the weekly pets are out; tower-only
--                 pets do not count)
--   Tower25     - reached floor 25 of the pet tower (profile TowerBest)
--   Forest      - unlocked the Forest zone
--   SecretEgg   - found the hidden egg in the lobby park: a part with attribute SecretEgg = true holding a
--                 ProximityPrompt (built by the park). Triggered marks SecretEggFound once, with a toast. If the
--                 part is missing nothing happens (the handler only reacts to prompts it finds on such a part).
-- A badge is remembered in the profile (`Badges`) once Roblox confirms it, so it is not asked for again. A badge
-- that is still off (id 0) is not remembered, so players who already qualify get it once the id is set.
-- Every Roblox call is wrapped in pcall; a failure is retried on a later profile change (at most once a minute per
-- badge and player).

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RobloxBadges = game:GetService("BadgeService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ProgressConfig = require(Shared.ProgressConfig)
local Profiles = require(script.Parent.Profiles)
local Net = require(Shared.Net)

local BadgeService = {}

local RETRY = 60
local busy: { [Player]: { [string]: boolean } } = {}
local lastTry: { [Player]: { [string]: number } } = {}

-- Which milestones this profile has reached (pure reads of the saved data, ProgressConfig.badgeProgress).
function BadgeService.earned(data): { [string]: boolean }
	local out = {}
	for key, p in ProgressConfig.badgeProgress(data) do
		out[key] = p.Done
	end
	return out
end

local function award(player: Player, key: string, id: number)
	local mine = busy[player]
	local tries = lastTry[player]
	if not mine or not tries or mine[key] or os.clock() - (tries[key] or -math.huge) < RETRY then
		return
	end
	mine[key] = true
	tries[key] = os.clock()
	task.spawn(function()
		local ok, res = pcall(function()
			return RobloxBadges:AwardBadge(player.UserId, id)
		end)
		local done = ok and res == true
		if not done then
			-- already owned (awarded before the profile remembered it) also counts as done
			local hasOk, has = pcall(function()
				return RobloxBadges:UserHasBadgeAsync(player.UserId, id)
			end)
			done = hasOk and has == true
			if not done then
				warn("[BadgeService] badge " .. key .. " not awarded yet:", res)
			end
		end
		if busy[player] then
			busy[player][key] = nil
		end
		local data = Profiles.get(player)
		if done and data and player.Parent and not Profiles.isReleased(player) then
			data.Badges[key] = true
			Profiles.changed(player, true)
		end
	end)
end

function BadgeService.check(player: Player)
	local data = Profiles.get(player)
	if not data or type(data.Badges) ~= "table" then
		return
	end
	local earned = BadgeService.earned(data)
	for _, key in ProgressConfig.BadgeOrder do
		local b = ProgressConfig.Badges[key]
		if earned[key] and not data.Badges[key] and b and type(b.Id) == "number" and b.Id > 0 then
			award(player, key, b.Id)
		end
	end
end

-- The prompt's part (or a model above it) carries SecretEgg = true. Triggered alone is not proof of range; start() re-checks the distance.
local function isSecretEgg(prompt: ProximityPrompt): boolean
	local node: Instance? = prompt.Parent
	for _ = 1, 3 do
		if not node then
			return false
		end
		if node:GetAttribute("SecretEgg") == true then
			return true
		end
		node = node.Parent
	end
	return false
end

function BadgeService.secretEgg(player: Player)
	local data = Profiles.get(player)
	if not data or Profiles.isReleased(player) then
		return
	end
	if data.SecretEggFound == true then
		Net.event("Toast"):FireClient(player, "You already found the secret egg!", "info")
		return
	end
	data.SecretEggFound = true
	Profiles.changed(player, true) -- onChanged runs check(): the badge is awarded once its id is set
	-- a big moment: the client shows it as a big banner with confetti (Main.client, Fx "SecretEgg"), not a small toast
	Net.event("Fx"):FireClient(player, "SecretEgg", {})
end

function BadgeService.start()
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		if prompt and isSecretEgg(prompt) then
			-- Triggered is not proof of range (an exploit client can fire it): re-check the avatar distance.
			local parent = prompt.Parent
			local at = if parent and parent:IsA("BasePart") then parent.Position else nil
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not at or not root or not root:IsA("BasePart") or (root.Position - at).Magnitude > prompt.MaxActivationDistance + 6 then
				return
			end
			BadgeService.secretEgg(player)
		end
	end)
	Profiles.onLoaded(function(player)
		busy[player] = {}
		lastTry[player] = {}
		BadgeService.check(player)
	end)
	Profiles.onChanged(BadgeService.check)
	Players.PlayerRemoving:Connect(function(p)
		busy[p] = nil
		lastTry[p] = nil
	end)
end

return BadgeService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="218">
        <Properties>
          <string name="Name">DevCommands</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Studio dev shortcuts for screenshots (owner tool). Nothing here runs in a live game: the script returns at once
-- unless RunService:IsStudio(), and the server functions it calls refuse outside Studio too.
-- Chat commands (or ReplicatedStorage.DevCommand:FireServer("<same text>")):
--   /endround   end your current hunt round as if you found the pet egg (goes to results)
--   /findpet    same as /endround, named for the hatch check: your camera glides to your nest, then the big
--               "You hatched ...!" card with confetti, then the results
--   /boss [N]   jump your tower run to boss floor N (rounded up to a boss floor; no N = next boss floor)
--   /zone NAME  show hunt zone NAME (meadow, forest, snow, volcano, space) on your hunt arena, or on a free arena you
--               are moved to when not in a hunt
--   /coins N    set your coins to N (0 - 10,000,000), e.g. to test the egg shrine buys
--   /event NAME start a lobby event now: rain (coin rain), rock (golden rock) or egg (mystery egg)
--   /xp N       give every pet following you N XP (tower XP book, same as training)
--   /maxpet     put every pet following you at its level cap (to test EVOLVE)
--   /spin       spin the free wheel now (ignores the 4-hour clock; same pay as a real spin)
-- Chat works through TextChatService commands (TextChatCommand per command, made below) and legacy Player.Chatted.
-- Without chat: ServerStorage.DevRun:Invoke(player, "/coins 5000") from the Studio command bar returns (ok, message).
-- See docs/OWNER_STEPS.md "Studio dev shortcuts".
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

if not RunService:IsStudio() then
	return
end

local MatchService = require(script.Parent.MatchService)
local TowerService = require(script.Parent.TowerService)
local PartyService = require(script.Parent.PartyService)
local Profiles = require(script.Parent.Profiles)

local last: { [Player]: number } = {}

local function run(player: Player, text: any): (boolean?, string?)
	if not RunService:IsStudio() or type(text) ~= "string" or #text > 40 then
		return
	end
	local cmd, arg = string.match(string.lower(text), "^%s*/(%a+)%s*(%w*)")
	if cmd == "findpet" then
		cmd = "endround"
	end
	if cmd ~= "endround" and cmd ~= "boss" and cmd ~= "zone" and cmd ~= "coins" and cmd ~= "event" and cmd ~= "xp" and cmd ~= "maxpet" and cmd ~= "spin" then
		return
	end
	local t = os.clock()
	if t - (last[player] or 0) < 0.5 then
		return
	end
	last[player] = t
	local ok, msg
	if cmd == "endround" then
		ok, msg = MatchService.devEndRound(player)
	elseif cmd == "coins" then
		local data = Profiles.get(player)
		local n = tonumber(arg)
		if not data then
			ok, msg = false, "Profile not loaded yet."
		elseif not n then
			ok, msg = false, "Use /coins N"
		else
			data.Cash = math.clamp(math.floor(n), 0, 10_000_000)
			Profiles.changed(player)
			ok, msg = true, "Coins set to " .. data.Cash .. "."
		end
	elseif cmd == "spin" then
		local data = Profiles.get(player)
		if not data then
			ok, msg = false, "Profile not loaded yet."
		else
			local id, what = require(script.Parent.RetentionService).spin(player, data, true)
			ok, msg = id ~= nil, if id then "Spin: " .. tostring(what) .. " (" .. id .. ")" else "Spin refused: " .. tostring(what)
		end
	elseif cmd == "xp" or cmd == "maxpet" then
		local data = Profiles.get(player)
		local n = tonumber(arg)
		if not data or type(data.EquippedPets) ~= "table" or #data.EquippedPets == 0 then
			ok, msg = false, "Equip (follow) a pet first."
		elseif cmd == "xp" and not n then
			ok, msg = false, "Use /xp N"
		else
			local PetStats = require(game:GetService("ReplicatedStorage").Shared.PetStats)
			for _, id in data.EquippedPets do
				local g = TowerService.petById(player, id)
				if g then
					local cur = TowerService.xpOf(player, id)
					local want = if cmd == "xp" then math.clamp(math.floor(n :: number), 0, 1_000_000) else math.max(PetStats.xpForLevel(PetStats.cap(g)) - cur, 0)
					TowerService.addXp(player, id, want, true)
				end
			end
			Profiles.changed(player)
			ok, msg = true, if cmd == "xp" then "Gave " .. tostring(n) .. " XP to your following pets." else "Following pets are at max level."
		end
	elseif cmd == "event" then
		local kind = ({ rain = "CoinRain", rock = "GoldenRock", egg = "MysteryEgg" } :: any)[arg or ""]
		if not kind then
			ok, msg = false, "Use /event rain, /event rock or /event egg"
		elseif require(script.Parent.LobbyEvents).run(kind) then
			ok, msg = true, "Started " .. kind .. "."
		else
			ok, msg = false, "An event is already running."
		end
	elseif cmd == "zone" then
		ok, msg = MatchService.devZone(player, arg or "")
	else
		ok, msg = TowerService.devJump(player, tonumber(arg))
	end
	PartyService.toast(player, "[DEV] " .. msg, if ok then "info" else "warn")
	return ok, msg
end

local remote = Instance.new("RemoteEvent")
remote.Name = "DevCommand"
remote.Parent = ReplicatedStorage
remote.OnServerEvent:Connect(run)

local function hook(player: Player)
	player.Chatted:Connect(function(text)
		run(player, text)
	end)
end
Players.PlayerAdded:Connect(hook)
for _, p in Players:GetPlayers() do
	hook(p)
end
Players.PlayerRemoving:Connect(function(p)
	last[p] = nil
end)

-- TextChatService chat: Player.Chatted does not fire for it, so every command gets a TextChatCommand whose Triggered
-- runs on the server (the text is checked by run() like any other).
local TextChatService = game:GetService("TextChatService")
local folder = Instance.new("Folder")
folder.Name = "DevCommands"
for _, name in { "endround", "findpet", "boss", "zone", "coins", "event", "xp", "maxpet", "spin" } do
	local c = Instance.new("TextChatCommand")
	c.Name = "Dev_" .. name
	c.PrimaryAlias = "/" .. name
	c.Triggered:Connect(function(source: TextSource, text: string)
		local player = Players:GetPlayerByUserId(source.UserId)
		if player then
			run(player, text) -- the same text may also arrive through Player.Chatted: run()'s 0.5 s guard drops the twin
		end
	end)
	c.Parent = folder
end
pcall(function()
	folder.Parent = TextChatService
end)

-- Command bar (no chat): ServerStorage.DevRun:Invoke(game.Players.<you>, "/spin") returns (ok, message).
local bind = Instance.new("BindableFunction")
bind.Name = "DevRun"
bind.OnInvoke = function(player: any, text: any)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return false, "Pass a Player"
	end
	last[player] = 0
	return run(player, text)
end
bind.Parent = game:GetService("ServerStorage")
]]></string>
        </Properties>
