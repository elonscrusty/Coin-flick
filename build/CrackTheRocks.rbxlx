      <Item class="Script" referent="219">
        <Properties>
          <string name="Name">DevPets</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Dev pet spawner (owner tool). Only works in Studio or for the place owner (game.CreatorId); everyone else is
-- refused on the server, and the client button (DevPetsClient) only shows when the server marks the player IsDev.
-- Request: DevSpawnPet:InvokeServer(speciesId, rarity) -> (ok, message). The pet is granted like a bought pet
-- (follows you, not counted as a hunt find or for the boards).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GeodeGen = require(Shared.GeodeGen)
local Retention = require(Shared.Retention)
local Profiles = require(script.Parent.Profiles)

local COOLDOWN = 0.3
local last: { [Player]: number } = {}

local function isDev(player: Player): boolean
	return RunService:IsStudio() or (game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId)
end

-- Pet minting is Studio-only; live servers never create the remote. IsDev (owner fly mode, DevFly) still works live.
local function canMint(player: Player): boolean
	return RunService:IsStudio() and isDev(player)
end

local function tierOf(id: string): string?
	for tierId, tier in Config.Tiers :: any do
		if table.find(tier.Minerals, id) then
			return tierId
		end
	end
	return nil
end

local remote = Instance.new("RemoteFunction")
remote.Name = "DevSpawnPet"
if RunService:IsStudio() then
	remote.Parent = ReplicatedStorage
end

remote.OnServerInvoke = function(player: Player, species: any, rarity: any): (boolean, string)
	if not canMint(player) then
		return false, "not allowed"
	end
	local now = os.clock()
	if now - (last[player] or 0) < COOLDOWN then
		return false, "slow down"
	end
	last[player] = now
	if type(species) ~= "string" or (Config.Minerals :: any)[species] == nil then
		return false, "unknown pet"
	end
	-- owner rule: only pets with a real (Meshy) model can be spawned from the DEV menu
	local folder = ReplicatedStorage:FindFirstChild("PetModels")
	local model = folder and folder:FindFirstChild("Pet_" .. species)
	if not (model and model:GetAttribute("Mesh") == true) then
		return false, "no model yet"
	end
	if type(rarity) ~= "string" or not table.find(Config.Rarities, rarity) then
		return false, "unknown rarity"
	end
	if not Profiles.isLoaded(player) then
		return false, "profile not loaded"
	end
	local tierId = tierOf(species) or next(Config.Tiers :: any)
	local id = HttpService:GenerateGUID(false)
	local pet = GeodeGen.roll(Random.new(), tierId, id, "dev:" .. id, os.time(), true)
	pet.Mineral = species
	pet.Rarity = rarity
	pet.Value = GeodeGen.value(tierId, rarity, pet.Modifier, pet.Mass)
	if not Profiles.grantSpecimen(player, "dev:" .. id, pet, "Bought") then
		return false, "grant failed (pet storage full?)"
	end
	return true, rarity .. " " .. GeodeGen.displayName(pet)
end

-- Studio playtests only: ReplicatedStorage attribute DevAutoPet = a species id (e.g. "Ostrich") gives that pet
-- (Legendary, following) once per test session, so a new model can be looked at without opening the menu.
local function autoPet(player: Player)
	local species = ReplicatedStorage:GetAttribute("DevAutoPet")
	if not RunService:IsStudio() or type(species) ~= "string" or (Config.Minerals :: any)[species] == nil then
		return
	end
	local t0 = os.clock()
	while player.Parent and not Profiles.isLoaded(player) and os.clock() - t0 < 30 do
		task.wait(0.5)
	end
	if not player.Parent or not Profiles.isLoaded(player) then
		return
	end
	-- a fresh save hatches its starter egg first: the dev pet never steals "YOUR FIRST PET!" (walkthrough 10-14)
	while player.Parent and not Retention.freePetReady(Profiles.get(player)) do
		task.wait(1)
	end
	if not player.Parent then
		return
	end
	local tierId = tierOf(species) or next(Config.Tiers :: any)
	local id = HttpService:GenerateGUID(false)
	local pet = GeodeGen.roll(Random.new(), tierId, id, "devauto:" .. id, os.time(), true)
	pet.Mineral = species
	pet.Rarity = "Legendary"
	pet.Value = GeodeGen.value(tierId, "Legendary", pet.Modifier, pet.Mass)
	Profiles.grantSpecimen(player, "devauto:" .. id, pet, "Bought")
end

local function mark(player: Player)
	if isDev(player) then
		player:SetAttribute("IsDev", true) -- fly mode (live too)
		if RunService:IsStudio() then
			player:SetAttribute("DevPets", true) -- shows the client DEV tile
		end
		task.spawn(autoPet, player)
	end
end
Players.PlayerAdded:Connect(mark)
for _, p in Players:GetPlayers() do
	mark(p)
end
Players.PlayerRemoving:Connect(function(p)
	last[p] = nil
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="220">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[--!strict
-- Cash, rubble sales, equipment, capacity, tier unlocks, collection actions and settings.
-- Every price is read from Config on the server; clients only name what they want.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local ProgressConfig = require(Shared.ProgressConfig)
local WhatsNew = require(Shared.WhatsNew)
local Profiles = require(script.Parent.Profiles)
local GearKit = require(Shared.GearKit)
local KitModels = require(Shared.KitModels)
local QuestService = require(script.Parent.QuestService)
local BadgeService = require(script.Parent.BadgeService)

local Economy = {}

local saleListener: ((Player, number, number) -> ())? = nil
function Economy.setSaleListener(fn: (Player, number, number) -> ())
	saleListener = fn
end

local toolChangedHandler: ((Player, string) -> ())? = nil
local displayChangedHandler: ((Player) -> ())? = nil
local machineHandler: ((Player, string, string?) -> ())? = nil -- (player, "Install" | "Toggle", machine id)
local skipHandler: ((Player) -> ())? = nil -- tutorial skipped (Main: PetService.ensureStarter)

function Economy.onTutorialSkipped(fn: (Player) -> ())
	skipHandler = fn
end

local function toast(player: Player, text: string, kind: string?)
	Net.event("Toast"):FireClient(player, text, kind or "info")
end

-- Upgrade levels the world reads from the player (StationModels.setOwner dresses a nest in its owner's nest
-- level). The round core reads the sizes from the profile itself (RockService.refreshSpace).
function Economy.syncLevels(player: Player)
	local data = Profiles.get(player)
	if data then
		player:SetAttribute("NestLevel", ProgressConfig.clampLevel(data.NestLevel, #ProgressConfig.Nests))
		player:SetAttribute("BasketLevel", ProgressConfig.clampLevel(data.BasketLevel, #ProgressConfig.Baskets))
	end
end

local function spend(player: Player, data, price: number): boolean
	if data.Cash < price then
		toast(player, "Not enough coins (need " .. price .. ").", "warn")
		return false
	end
	data.Cash -= price
	return true
end

-- Tool visual: the equipped handheld welded to the character's right hand.
-- Standing height of an avatar in studs (R15, R6 or a custom rig), for sizing held tools.
function Economy.avatarHeight(char: Model): number
	local head = char:FindFirstChild("Head")
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if head and head:IsA("BasePart") and root and root:IsA("BasePart") and hum then
		local legs = if hum.RigType == Enum.HumanoidRigType.R15 then hum.HipHeight else 2
		local h = head.Position.Y + head.Size.Y / 2 - (root.Position.Y - root.Size.Y / 2 - legs)
		if h > 2 and h < 30 then
			return h
		end
	end
	local ok, size = pcall(function()
		return char:GetExtentsSize()
	end)
	if ok and size.Y > 2 and size.Y < 30 then
		return size.Y
	end
	return 5.3
end

-- Rest (carry) rotation of the held tool in the hand's frame (hand hanging: -Y down, -Z forward).
function Economy.restGrip(toolId: string): CFrame
	if toolId == "Jackhammer" then
		return CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, math.rad(-62))
	end
	-- the head turned to run front-to-back (a quarter turn about the handle): sideways it reached into the hip and leg of
	-- the avatar (owner video: the pink head clipped the body)
	return CFrame.Angles(math.rad(-28), 0, 0) * CFrame.Angles(0, math.rad(90), 0)
end

-- The held tool is a hunt thing: it shows only while the player is in a hunt (MatchKey set by MatchService, also in the
-- Match place). In the lobby the hands are empty (owner video: the pink hammer showed in the lobby).
local toolWatch: { [Player]: RBXScriptConnection } = {}
local function inHunt(player: Player): boolean
	return player:GetAttribute("MatchKey") ~= nil
end

function Economy.attachTool(player: Player)
	local char = player.Character
	local data = Profiles.get(player)
	if not char or not data then
		return
	end
	local old = char:FindFirstChild("CT_Rocks_GearAccessory")
	if old then
		old:Destroy()
	end
	if not toolWatch[player] then
		toolWatch[player] = player:GetAttributeChangedSignal("MatchKey"):Connect(function()
			Economy.attachTool(player) -- entering a hunt attaches it, leaving takes it away
		end)
		player.AncestryChanged:Connect(function(_, parent)
			if parent == nil and toolWatch[player] then
				toolWatch[player]:Disconnect()
				toolWatch[player] = nil
			end
		end)
	end
	if not inHunt(player) then
		return
	end
	-- Pet gear is passive: nothing is held. The owned gear shows as a small hip accessory (kit model, welded,
	-- massless, non-colliding) when the owner's Gear_<Id> model exists; otherwise nothing at all.
	local toolId = data.EquippedHandheld
	local gearName = GearKit.accessoryModel(toolId)
	local template = if gearName then KitModels.template(gearName) else nil
	local root = char:FindFirstChild("HumanoidRootPart")
	if not template or not root or not root:IsA("BasePart") then
		return
	end
	local acc = template:Clone()
	acc.Name = "CT_Rocks_GearAccessory"
	acc:SetAttribute("ToolId", toolId)
	local height = Economy.avatarHeight(char)
	-- measure only what shows: hidden helper parts made the box bigger, so the visible gear came out small
	local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, d in acc:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 then
			for _, sx in { -0.5, 0.5 } do
				for _, sy in { -0.5, 0.5 } do
					for _, sz in { -0.5, 0.5 } do
						local p = d.CFrame:PointToWorldSpace(d.Size * Vector3.new(sx, sy, sz))
						lo, hi = lo:Min(p), hi:Max(p)
					end
				end
			end
		end
	end
	local size = if lo.X < math.huge then hi - lo else select(2, acc:GetBoundingBox())
	local longest = math.max(size.X, size.Y, size.Z, 0.1)
	acc:ScaleTo(GearKit.accessoryScale(longest, height) * acc:GetScale())
	for _, d in acc:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	local primary = acc.PrimaryPart or acc:FindFirstChildWhichIsA("BasePart")
	if not primary then
		acc:Destroy()
		return
	end
	acc.PrimaryPart = primary
	acc:PivotTo(root.CFrame * CFrame.new(1.1, -0.9, 0.35) * CFrame.Angles(0, 0, math.rad(25)))
	local weld = Instance.new("WeldConstraint")
	weld.Name = "GearWeld"
	weld.Part0 = root
	weld.Part1 = primary
	weld.Parent = primary
	acc.Parent = char
end

local lastSale: { [Player]: number } = {}
local SALE_GAP = 0.6 -- a second sell request this soon is a double tap, not a new sale

-- The one rubble sale (hopper prompt and the HUD button). The receipt the player sees is built from the
-- numbers returned here (count, total, new balance), never from what the client previewed.
local function sellRubble(player: Player, at: Vector3?)
	local data = Profiles.get(player)
	if not data then
		return
	end
	local t = os.clock()
	if t - (lastSale[player] or -math.huge) < SALE_GAP then
		return
	end
	-- Only rubble this build can price is sold; rubble of an unknown (newer) tier stays in the bag.
	local count, total = Profiles.sellableRubble(data)
	if count == 0 then
		toast(player, "Your candy bag is empty. Nothing to sell.", "info")
		return
	end
	lastSale[player] = t
	for tierId: string in table.clone(data.RubbleByTier) :: { [string]: number } do
		if Config.Tiers[tierId] then
			data.RubbleByTier[tierId] = nil
		end
	end
	data.Cash += total
	data.Stats.CashEarned += total
	Profiles.changed(player, true)
	Profiles.onboard(player, "Sold")
	Net.event("Toast"):FireClient(player, "Sold " .. count .. " candy for " .. total .. " coins", "cash")
	Net.event("Fx"):FireClient(player, "Sell", { Pos = at, Count = count, Total = total, Cash = data.Cash })
	if saleListener then
		saleListener(player, count, total) -- the hunt ledger (MatchService)
	end
	QuestService.note(player, "Sell", 1)
end
Economy.sellRubble = sellRubble

-- The HUD's SELL RUBBLE button (the same sale as the hopper prompt): only when the avatar is close
-- to a hopper, measured by the server from the character, never from anything the client sends.
-- Hoppers are found by one Workspace scan that is cached server-wide and redone at most once per
-- HOPPER_RESCAN seconds (a miss can trigger it), so spamming the button never walks the whole world.
local HOPPER_RESCAN = 2
local hopperBodies: { BasePart } = {}
local hopperScanAt = -math.huge
local function scanHoppers()
	hopperScanAt = os.clock()
	table.clear(hopperBodies)
	for _, d in game:GetService("Workspace"):GetDescendants() do
		if d:IsA("Model") and d:GetAttribute("Hopper") then
			local body = d:FindFirstChild("Body")
			if body and body:IsA("BasePart") then
				table.insert(hopperBodies, body)
			end
		end
	end
end

local function nearestHopperBody(player: Player, range: number): BasePart?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local function nearest(): BasePart?
		local best: BasePart? = nil
		local bestD = range
		for _, body in hopperBodies do
			if body.Parent and body:IsDescendantOf(game:GetService("Workspace")) then
				local dist = Vector3.new(body.Position.X - root.Position.X, 0, body.Position.Z - root.Position.Z).Magnitude
				if dist <= bestD then
					best, bestD = body, dist
				end
			end
		end
		return best
	end
	local best = nearest()
	if not best and os.clock() - hopperScanAt >= HOPPER_RESCAN then
		scanHoppers() -- a hopper built since the last scan (new arena) is picked up here
		best = nearest()
	end
	return best
end

-- Level purchases (storage, gallery slots) have no item id, so a double tap would buy two levels. A repeat
-- of the same kind this soon is dropped; a client may also send the level it expects to buy as `id`
-- (a number), and a request for any other level is refused (the shop showed stale data).
local LEVEL_GAP = 1.0
local lastLevelBuy: { [Player]: { [string]: number } } = {}
local displayQuestSeen: { [Player]: { Day: string, Ids: { [string]: boolean } } } = {} -- pets counted for today's Display quest
-- The daily Display quest counts different pets, so placing and removing one pet again (by any display action)
-- does not farm it.
local function noteDisplay(player: Player, id: string)
	local day = os.date("!%Y%m%d")
	local prev = displayQuestSeen[player]
	local ids: { [string]: boolean } = if prev and prev.Day == day then prev.Ids else {}
	displayQuestSeen[player] = { Day = day, Ids = ids }
	if not ids[id] then
		ids[id] = true
		QuestService.note(player, "Display")
	end
end
local function levelRequestOk(player: Player, kind: string, expected: any, nextLevel: number): boolean
	if type(expected) == "number" and expected ~= nextLevel then
		return false
	end
	local t = os.clock()
	local mine = lastLevelBuy[player]
	if not mine then
		mine = {}
		lastLevelBuy[player] = mine
	end
	if t - (mine[kind] or -math.huge) < LEVEL_GAP then
		return false
	end
	mine[kind] = t
	return true
end

local function handleShop(player: Player, action: any, id: any)
	local data = Profiles.get(player)
	if not data or type(action) ~= "string" then
		return
	end
	if action == "SellAtHopper" then
		local body = nearestHopperBody(player, 12)
		if body then
			sellRubble(player, body.Position)
		else
			toast(player, "Walk up to a SELL bin first.", "info")
		end
		return
	end
	if action == "BuyHandheld" then
		local h = if type(id) == "string" then Config.Handhelds[id] else nil
		if not h then
			return
		end
		if data.EquipmentOwned[h.Id] then
			toast(player, "You already own the " .. h.Name .. ".", "info")
			return
		end
		if spend(player, data, h.Price) then
			data.EquipmentOwned[h.Id] = true
			data.EquippedHandheld = h.Id
			toast(player, "Bought and equipped the " .. h.Name .. "!", "ok")
			Profiles.changed(player, true)
			Economy.attachTool(player)
			if toolChangedHandler then
				toolChangedHandler(player, h.Id)
			end
		end
	elseif action == "Equip" then
		local h = if type(id) == "string" then Config.Handhelds[id] else nil
		if h and data.EquipmentOwned[h.Id] and data.EquippedHandheld ~= h.Id then
			data.EquippedHandheld = h.Id
			Profiles.changed(player, true)
			Economy.attachTool(player)
			if toolChangedHandler then
				toolChangedHandler(player, h.Id)
			end
		end
	elseif action == "BuyMachine" then
		-- Price comes from Config on the server; one machine is installed at a time, owned ones do not stack.
		local mc = type(id) == "string" and Config.Machines[id]
		if not Config.MachinesEnabled or not mc then
			return
		end
		if data.EquipmentOwned[mc.Id] then
			toast(player, "You already own the " .. mc.Name .. ".", "info")
			return
		end
		if spend(player, data, mc.Price) then
			data.EquipmentOwned[mc.Id] = true
			data.InstalledMachine = mc.Id
			toast(player, "Bought and installed the " .. mc.Name .. "!", "ok")
			Profiles.changed(player, true)
			if machineHandler then
				machineHandler(player, "Install", mc.Id)
			end
		end
	elseif action == "InstallMachine" then
		local mc = type(id) == "string" and Config.Machines[id]
		if Config.MachinesEnabled and mc and data.EquipmentOwned[mc.Id] and data.InstalledMachine ~= mc.Id then
			data.InstalledMachine = mc.Id
			Profiles.changed(player, true)
			if machineHandler then
				machineHandler(player, "Install", mc.Id)
			end
		end
	elseif action == "ToggleMachine" then
		if Config.MachinesEnabled and data.InstalledMachine and machineHandler then
			machineHandler(player, "Toggle", nil)
		end
	elseif action == "BuyCapacity" then
		local nextLvl = Config.Capacity[data.CapacityTier + 1]
		if not nextLvl or not levelRequestOk(player, "Capacity", id, data.CapacityTier + 1) then
			return
		end
		if spend(player, data, nextLvl.Price) then
			data.CapacityTier += 1
			toast(player, "Candy bag now holds " .. nextLvl.Size .. ".", "ok")
			Profiles.changed(player, true)
		end
	elseif action == "BuyBasket" or action == "BuyNest" then
		-- Coins only (ProgressConfig prices). One level at a time; `id` is the level the shop showed.
		local isBasket = action == "BuyBasket"
		local list = if isBasket then ProgressConfig.Baskets else ProgressConfig.Nests
		local field = if isBasket then "BasketLevel" else "NestLevel"
		local cur = data[field]
		local nextLvl: any = list[cur + 1]
		if not nextLvl or cur < 1 or not levelRequestOk(player, field, id, cur + 1) then
			return
		end
		if spend(player, data, nextLvl.Price) then
			data[field] = cur + 1
			if isBasket then
				toast(player, nextLvl.Name .. ": carry " .. nextLvl.Carry .. " eggs per trip!", "ok")
			else
				toast(player, nextLvl.Name .. ": your nest holds " .. nextLvl.Queue .. " eggs!", "ok")
			end
			Profiles.changed(player, true)
			Economy.syncLevels(player)
		end
	elseif action == "ClaimGift" or action == "ClaimQuest" then
		QuestService.handle(player, action, id)
	elseif action == "BuyDisplay" then
		local nextLvl = Config.Display[data.DisplayCapacity + 1]
		if not nextLvl or not levelRequestOk(player, "Display", id, data.DisplayCapacity + 1) then
			return
		end
		if spend(player, data, nextLvl.Price) then
			data.DisplayCapacity += 1
			toast(player, "Pet Lodge now shows " .. nextLvl.Slots .. " pets.", "ok")
			Profiles.changed(player, true)
		end
	elseif action == "UnlockTier" then
		local tier = if type(id) == "string" then Config.Tiers[id] else nil
		if not tier or data.UnlockedTiers[tier.Id] then
			return
		end
		local finds = Profiles.finds(data)
		if finds < tier.UnlockFinds then
			toast(player, "Need " .. tier.UnlockFinds .. " pet finds (you have " .. finds .. ").", "warn")
			return
		end
		-- previous tier must be unlocked first
		local prev = Config.TierOrder[tier.Order - 1]
		if prev and not data.UnlockedTiers[prev] then
			toast(player, "Unlock " .. prev .. " first.", "warn")
			return
		end
		if spend(player, data, tier.UnlockCash) then
			data.UnlockedTiers[tier.Id] = true
			toast(player, tier.Name .. " zone unlocked!", "ok")
			Profiles.changed(player, true)
		end
	end
end

local function handleCollection(player: Player, action: any, a: any, b: any)
	local data = Profiles.get(player)
	if not data or type(action) ~= "string" then
		return
	end
	if action == "Favorite" then
		local _, g = Profiles.findGeode(data, if type(a) == "string" then a else "")
		if g then
			g.Favorite = b == true
			Profiles.changed(player)
		end
	elseif action == "Display" then
		local id = if type(a) == "string" then a else ""
		local _, g = Profiles.findGeode(data, id)
		if not g then
			return
		end
		local idx = table.find(data.DisplayAssignments, id)
		if b == true and not idx then
			if #data.DisplayAssignments >= Profiles.displaySlots(data) then
				toast(player, "Pet Lodge is full. Upgrade slots or remove one.", "warn")
				return
			end
			table.insert(data.DisplayAssignments, id)
			data.Onboard.Displayed = true
			noteDisplay(player, id)
		elseif b ~= true and idx then
			table.remove(data.DisplayAssignments, idx)
			data.RoamPets = Profiles.roamList(data) -- a pet off display stops roaming
		else
			return
		end
		Profiles.changed(player)
		if displayChangedHandler then
			displayChangedHandler(player)
		end
	elseif action == "DisplayAt" then
		-- Slot chooser: a = specimen id, b = slot number (1..slots). DisplayAssignments stays a dense list whose
		-- position is the alcove slot. Empty slot: place (or move to the end). Occupied slot: replace (the old
		-- specimen simply returns to the collection) or, for a specimen already on show, swap the two slots.
		local id = if type(a) == "string" then a else ""
		local slotNo = if type(b) == "number" and b == b and b >= 1 and b <= 64 then math.floor(b) else 0
		local _, g = Profiles.findGeode(data, id)
		if not g or slotNo == 0 or slotNo > Profiles.displaySlots(data) then
			return
		end
		local list = data.DisplayAssignments
		local from = table.find(list, id)
		if slotNo > #list then
			if from then
				table.remove(list, from)
				table.insert(list, id)
			else
				table.insert(list, id)
				data.Onboard.Displayed = true
				noteDisplay(player, id)
			end
		elseif from == slotNo then
			return
		elseif from then
			list[from], list[slotNo] = list[slotNo], list[from]
		else
			list[slotNo] = id
			data.RoamPets = Profiles.roamList(data) -- the replaced pet left the display, so it stops roaming
			data.Onboard.Displayed = true
			noteDisplay(player, id)
		end
		Profiles.changed(player)
		if displayChangedHandler then
			displayChangedHandler(player)
		end
	elseif action == "Sell" then
		-- a = list of specimen ids, b = expected total the client showed (must match exactly)
		if type(a) ~= "table" or #a == 0 or #a > #data.InventoryGeodes then
			return
		end
		local seen = {}
		local total = 0
		local idxs = {}
		for _, id in a do
			if type(id) ~= "string" or seen[id] then
				return
			end
			seen[id] = true
			local i, g = Profiles.findGeode(data, id)
			if not i then
				toast(player, "Some of those pets are gone. Refresh and try again.", "warn")
				return
			end
			if type(g.Value) ~= "number" or g.Value ~= g.Value or g.Value < 0 then
				toast(player, "One of those pets can't be sold right now.", "warn")
				return
			end
			if g.Favorite then
				toast(player, "Favourites can't be sold. Unfavourite first.", "warn")
				return
			end
			if table.find(data.DisplayAssignments, id) then
				toast(player, "Remove displayed pets from the Pet Lodge first.", "warn")
				return
			end
			-- Robux egg pets sell for a token share (Profiles.priceValue), so Robux never turns into coins
			total += math.floor(Profiles.priceValue(g) * Config.Sell.SpecimenFraction)
			table.insert(idxs, i)
		end
		if b ~= total then
			toast(player, "Sale value changed. Check and confirm again.", "warn")
			return
		end
		table.sort(idxs, function(x, y)
			return x > y
		end)
		for _, i in idxs do
			table.remove(data.InventoryGeodes, i)
		end
		data.Cash += total
		data.Stats.CashEarned += total
		Profiles.changed(player)
		toast(player, "Sold " .. #idxs .. " pet" .. (if #idxs == 1 then "" else "s") .. " for " .. total .. " coins", "cash")
	end
end

local function handleSettings(player: Player, s: any)
	local data = Profiles.get(player)
	if not data or type(s) ~= "table" then
		return
	end
	local out = data.Settings
	for _, k in { "Music", "Sfx", "CameraSensitivity" } do
		if type(s[k]) == "number" and s[k] == s[k] then
			out[k] = math.clamp(s[k], 0, 1)
		end
	end
	for _, k in { "ReducedMotion", "LowEffects", "Hints" } do
		if type(s[k]) == "boolean" then
			out[k] = s[k]
		end
	end
	local news = WhatsNew.accept(s.LastSeenNews) -- WHAT'S NEW pop-up seen (only the current version is stored)
	if news then
		data.LastSeenNews = news
	end
	Profiles.changed(player, true)
end

function Economy.onToolChanged(fn: (Player, string) -> ())
	toolChangedHandler = fn
end

function Economy.onMachine(fn: (Player, string, string?) -> ())
	machineHandler = fn
end

function Economy.onDisplayChanged(fn: (Player) -> ())
	displayChangedHandler = fn
end

function Economy.start()
	-- Daily gift / quests and badges ride on the profile and shop remotes, so they start with the economy.
	QuestService.start()
	BadgeService.start()
	Profiles.onLoaded(Economy.syncLevels)
	Players.PlayerRemoving:Connect(function(p)
		lastSale[p] = nil
		lastLevelBuy[p] = nil
		displayQuestSeen[p] = nil
	end)
	local function limited(fn)
		local last: { [Player]: { n: number, t: number } } = {}
		Players.PlayerRemoving:Connect(function(p)
			last[p] = nil
		end)
		return function(player: Player, ...)
			local t = os.clock()
			local l = last[player]
			if not l or t - l.t > 1 then
				local fresh = { n = 0, t = t }
				last[player] = fresh
				l = fresh
			end
			l.n += 1
			if l.n <= 6 then
				if Profiles.isReleased(player) then
					return -- profile handed over for a teleport: nothing may change here now
				end
				fn(player, ...)
			end
		end
	end
	Net.event("ShopAction").OnServerEvent:Connect(limited(handleShop))
	Net.event("CollectionAction").OnServerEvent:Connect(limited(handleCollection))
	Net.event("SettingsAction").OnServerEvent:Connect(limited(handleSettings))
	Net.event("TutorialAction").OnServerEvent:Connect(limited(function(player: Player, action: any)
		if action == "Skip" then
			Profiles.onboard(player, "Skipped")
			-- skipping also ends the practice requirement so the next solo hunt is a real one
			local data = Profiles.get(player)
			if data and data.TutorialStep == 0 then
				data.TutorialStep = 1
				Profiles.changed(player, true)
			end
			-- and never costs the free starter pet (granted once; a no-op when it was already given)
			if skipHandler then
				skipHandler(player)
			end
		elseif action == "Goal" then
			Profiles.onboard(player, "Goal")
		end
	end))
	-- Hopper prompts are server objects, but Triggered is not proof of range (an exploit client can fire it):
	-- the server re-checks the avatar's distance to the prompt like the HUD button path does.
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		if prompt:GetAttribute("Sell") and not Profiles.isReleased(player) then
			local parent = prompt.Parent
			local at = if parent and parent:IsA("BasePart") then parent.Position else nil
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not at or not root or not root:IsA("BasePart") or (root.Position - at).Magnitude > prompt.MaxActivationDistance + 6 then
				return
			end
			sellRubble(player, at)
		end
	end)
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="221">
        <Properties>
          <string name="Name">EggEvents</string>
          <string name="Source"><![CDATA[--!strict
-- Egg events (tuning in src/shared/EggConfig.luau):
--   * Wobble hint: every few seconds (server-decided gap) a small patch of eggs still in the pile wobbles for everyone in the
--     match. Each anchor is decided at fire time by EggHints.pickForTier (small chance of the pet egg while it is in
--     the pile, otherwise a uniformly random other pile egg); the pile eggs near a jittered point around it wobble
--     together (EggHints.patch), and the jitter usually leaves the anchor outside its own patch. Nothing is
--     precomputed or sent ahead; eggs in baskets, trays or on plates never wobble. The payload is a list of pile
--     ids, never the anchor alone. Every zone mixes in decoys; the Meadow (EggConfig.Wobble.SlowTiers) is slower.
--   * Speed boots: finishing an ordinary egg has a small server-rolled chance to give that player a short walk
--     speed boost. The server sets WalkSpeed and restores it afterwards (only if nothing else changed it).
--   * Overtime: after EggConfig.Overtime.RoundSeconds of searching the pet egg glows gold for the match, as soon as
--     it is in the pile (if it is carried or on a nest at that moment, the glow waits; wobbles keep going until the
--     glow is sent). Sync re-sends it (EggEvents.resend).
--   * Chirp: a pile egg near a player chirps for that player (EggConfig.Chirp) at a jittered point (no id); it is
--     the pet egg only with a small chance, otherwise a nearby decoy egg.
-- MatchService calls EggEvents.step(m, t) for every Searching match; RockService calls EggEvents.cracked(m, uid)
-- for every ordinary egg a player finishes.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local EggConfig = require(Shared.EggConfig)
local EggHints = require(Shared.EggHints)

local EggEvents = {}

type WobbleState = { Round: number, NextAt: number, Start: number, Overtime: boolean }

local rng = Random.new()
local wobble: { [any]: WobbleState } = setmetatable({}, { __mode = "k" }) :: any -- per match table, dies with it
-- Active boosts per user: the speed we set and when it ends (server clock).
local boosts: { [number]: { Speed: number, Base: number, Until: number, Token: number } } = {}
local token = 0

local function fireMatch(m: any, kind: string, payload: any)
	local ev = Net.event("EggEvent")
	for uid in m.Present do
		local p = Players:GetPlayerByUserId(uid)
		if p then
			ev:FireClient(p, kind, payload)
		end
	end
end

local function gap(tier: string?): number
	local lo, hi = EggHints.gapRange(tier)
	return rng:NextNumber(lo, hi)
end

-- The pile eggs of a match as { Id, Pos } in world space.
local function pileEggs(m: any, core: any): { { Id: number, Pos: Vector3 } }
	local eggs = {}
	local center = m.Arena and m.Arena.Center
	if not center then
		return eggs
	end
	for _, eid in EggHints.pileIds(core.Rocks) do
		local lp = core.Pile:localPosition(eid)
		if lp then
			table.insert(eggs, { Id = eid, Pos = center + lp })
		end
	end
	return eggs
end

local chirpStep: (any, any, number) -> () -- defined below

-- The pet egg's id while it is in the pile, else nil (the overtime glow can only show on a pile egg).
local function overtimeId(core: any): number?
	local rock = core.TargetId and core.Rocks[core.TargetId]
	return if rock and rock.State == "InPile" then core.TargetId else nil
end

-- One scheduler step for a Searching match (t = os.clock()).
function EggEvents.step(m: any, t: number)
	if m.Phase ~= "Searching" then
		return
	end
	local core = m.Core
	if not core or core.Phase ~= "Searching" then
		return
	end
	chirpStep(m, core, t)
	local st = wobble[m]
	if st == nil or st.Round ~= m.Round then
		-- first wobble one gap after Searching starts; the overtime clock starts here too
		wobble[m] = { Round = m.Round, NextAt = t + gap(core.Tier), Start = t, Overtime = false }
		return
	end
	local ot = EggConfig.Overtime
	if ot.Enabled and not st.Overtime and not m.Tutorial and t - st.Start >= ot.RoundSeconds then
		local id = overtimeId(core)
		if id then
			-- Only set once it is really sent: an egg carried or on a nest at 3:00 glows once it is back in the pile.
			st.Overtime = true
			-- a glowing egg buried in the mound could not be picked up (Studio 2026-10-15): lift it to a reachable
			-- spot first (RoundRocks.surface; the Move event goes out with the next rock flush)
			core:surface(id)
			fireMatch(m, "Overtime", { Round = m.Round, Id = id }) -- the one time the pet egg is named
		end
	end
	if not EggConfig.Wobble.Enabled or st.Overtime then
		return
	end
	if t < st.NextAt then
		return
	end
	st.NextAt = t + gap(core.Tier)
	-- Decided now, from the live pile: only eggs still in the pile can be picked; decoys in every zone.
	local id = EggHints.pickForTier(rng, EggHints.pileIds(core.Rocks), core.TargetId, core.Tier)
	local center = m.Arena and m.Arena.Center
	local anchorLocal = id and center and core.Pile:localPosition(id)
	if anchorLocal then
		-- Patch hint: never one id. Every pile egg near a jittered point around the anchor wobbles together.
		local w = EggConfig.Wobble
		local ids = EggHints.patch(rng, center + anchorLocal, pileEggs(m, core), w.PatchRadius, w.PatchJitterMin, w.PatchJitterMax, w.PatchMax)
		if #ids > 0 then
			fireMatch(m, "Wobble", { Round = m.Round, Ids = ids })
		end
	end
end

-- Sync / late join: the overtime glow is an event, so a client that rebuilt its pile gets it again.
function EggEvents.resend(m: any, player: Player)
	local st = wobble[m]
	local core = m.Core
	if not st or not core or st.Round ~= m.Round or not st.Overtime or m.Phase ~= "Searching" then
		return
	end
	local id = overtimeId(core)
	if id then
		Net.event("EggEvent"):FireClient(player, "Overtime", { Round = m.Round, Id = id })
	end
end

-- Chirps: per match, per player, the next check time. Only pile eggs chirp, only to a player close to them, never
-- in the practice round. The pet egg is only sometimes the source; the payload is a jittered point, not an id.
local chirpAt: { [any]: { Round: number, Next: { [number]: number } } } = setmetatable({}, { __mode = "k" }) :: any

function chirpStep(m: any, core: any, t: number)
	local cfg = EggConfig.Chirp
	if not cfg.Enabled or m.Tutorial or not m.Arena or not m.Arena.Center then
		return
	end
	local st = chirpAt[m]
	if st == nil or st.Round ~= m.Round then
		st = { Round = m.Round, Next = {} }
		chirpAt[m] = st
	end
	local ev = Net.event("EggEvent")
	local eggs: { { Id: number, Pos: Vector3 } }? = nil -- built once per step, only when someone is due
	for uid in m.Present do
		local due = st.Next[uid]
		if due == nil then
			st.Next[uid] = t + rng:NextNumber(cfg.MinGap, cfg.MaxGap)
		elseif t >= due then
			st.Next[uid] = t + rng:NextNumber(cfg.MinGap, cfg.MaxGap)
			local p = Players:GetPlayerByUserId(uid)
			local root = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if p and root and root:IsA("BasePart") and rng:NextNumber() < cfg.Chance then
				eggs = eggs or pileEggs(m, core)
				local src = EggHints.chirpSource(rng, eggs :: any, root.Position, cfg.Radius, core.TargetId, cfg.TargetChance)
				local at = EggHints.chirpPoint(rng, src, root.Position, math.huge, cfg.JitterMin, cfg.JitterMax)
				if at then
					ev:FireClient(p, "Chirp", { Round = m.Round, Pos = at })
				end
			end
		end
	end
end

-- Walk speed allowance multiplier for a movement check: >1 while the player wears speed boots.
function EggEvents.speedAllowance(uid: number): number
	local b = boosts[uid]
	if b and Workspace:GetServerTimeNow() < b.Until then
		return 1 + EggConfig.Boots.Bonus
	end
	return 1
end

local function endBoost(player: Player, my: number)
	local b = boosts[player.UserId]
	if not b or b.Token ~= my then
		return -- a newer boost took over
	end
	boosts[player.UserId] = nil
	player:SetAttribute("SpeedBoost", nil)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	-- Restore only our own speed: a freeze (countdown) or a respawn already set its own value.
	if hum and math.abs(hum.WalkSpeed - b.Speed) < 0.01 then
		hum.WalkSpeed = b.Base -- the speed before the boots (pet speed bonus included)
	end
end

-- An ordinary egg finished by `uid` in match `m`: maybe drop speed boots.
function EggEvents.cracked(m: any, uid: number)
	local cfg = EggConfig.Boots
	if not cfg.Enabled or m.Phase ~= "Searching" then
		return
	end
	local player = Players:GetPlayerByUserId(uid)
	if not player or boosts[uid] then
		return -- one pair at a time: no roll while boosted
	end
	if rng:NextNumber() >= cfg.Chance then
		return
	end
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or hum.WalkSpeed <= 0 then
		return
	end
	token += 1
	local my = token
	-- The boots multiply the hunter's current speed, so a speed pet's bonus (MatchService.setFrozen) is kept and
	-- comes back unchanged when they run out.
	local base = hum.WalkSpeed
	local speed = base * (1 + cfg.Bonus)
	local untilT = Workspace:GetServerTimeNow() + cfg.Seconds
	boosts[uid] = { Speed = speed, Base = base, Until = untilT, Token = my }
	-- Movement checks can read this to widen their allowance while boosted.
	player:SetAttribute("SpeedBoost", 1 + cfg.Bonus)
	hum.WalkSpeed = speed
	fireMatch(m, "Boots", { Round = m.Round, UserId = uid, Until = untilT, Seconds = cfg.Seconds })
	task.delay(cfg.Seconds, function()
		if player.Parent then
			endBoost(player, my)
		elseif boosts[uid] and boosts[uid].Token == my then
			boosts[uid] = nil -- only our own boost: a rejoined player's newer boost is keyed by the same UserId
		end
	end)
end

function EggEvents.start()
	Players.PlayerRemoving:Connect(function(p)
		boosts[p.UserId] = nil
	end)
end

return EggEvents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="222">
        <Properties>
          <string name="Name">FightBoard</string>
          <string name="Source"><![CDATA[--!strict
-- The lobby arena's fight board (carter 2026-10-14: fights in the middle, fun to watch, make players want stronger
-- pets): a big sign floating over the arena that everyone in the lobby reads, showing the LIVE fight (names and
-- team power, or how to join) and the day's BIGGEST WIN on this server (the biggest upset: PvpRules.biggerWin).
-- A two-faced sign 16 studs over the arena centre, or where a part with attribute FightBoard = true stands (Studio);
-- fitted sign text (KitPlace / SignLayout). PvpService feeds it (FightBoard.live / FightBoard.won).

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PvpRules = require(Shared.PvpRules)
local KitPlace = require(script.Parent.KitPlace)

local FightBoard = {}

local board: Model? = nil
type Row = { Labels: { TextLabel }, W: number, H: number, Preset: string }
local rows: { [string]: Row } = {}
local best: PvpRules.Win? = nil

local GOLD = Color3.fromRGB(255, 205, 70)
local WHITE = Color3.new(1, 1, 1)
local RED = Color3.fromRGB(255, 96, 86)
local FACE = Color3.fromRGB(34, 30, 52)
local W, H = 28, 11

local function setRow(name: string, text: string, color: Color3?)
	local r = rows[name]
	if not r then
		return
	end
	for _, l in r.Labels do
		local gui = l.Parent
		if gui and gui:IsA("SurfaceGui") then
			KitPlace.applyFit(gui, l, text, r.W, r.H, r.Preset)
		end
		if color then
			l.TextColor3 = color
		end
	end
end

-- Builds the board over the arena at `origin` (PvpService's arena origin) once. Returns it (tests).
function FightBoard.ensure(origin: CFrame?): Model?
	if board and board.Parent then
		return board
	end
	local at: CFrame? = nil
	for _, d in Workspace:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("FightBoard") == true then
			at = d.CFrame -- a spot the owner placed in Studio
			break
		end
	end
	if not at then
		if not origin then
			return nil
		end
		at = CFrame.new(origin.Position + Vector3.new(0, 16, 0)) * origin.Rotation
	end
	local cf = at :: CFrame
	local m = Instance.new("Model")
	m.Name = "FightBoard"
	local slab = Instance.new("Part")
	slab.Name = "Slab"
	slab.Size = Vector3.new(W, H, 0.8)
	slab.CFrame = cf
	slab.Color = FACE
	slab.Material = Enum.Material.SmoothPlastic
	slab.Anchored = true
	slab.CanCollide = false
	slab.CanQuery = false
	slab.CanTouch = false
	slab:SetAttribute("CameraIgnore", true)
	slab.Parent = m
	local trim = Instance.new("SelectionBox")
	trim.Name = "Trim"
	trim.Adornee = slab
	trim.Color3 = GOLD
	trim.LineThickness = 0.25
	trim.SurfaceTransparency = 1
	trim.Parent = slab
	-- the same three rows on both faces (spectators stand on every side of the arena)
	local spec: { { Name: string, Y: number, H: number, Preset: string, Color: Color3 } } = {
		{ Name = "Title", Y = 3.6, H = 2.6, Preset = "Heading", Color = GOLD },
		{ Name = "Live", Y = 0.1, H = 2.8, Preset = "Row", Color = WHITE },
		{ Name = "Biggest", Y = -3.4, H = 2.2, Preset = "Row", Color = GOLD },
	}
	for _, r in spec do
		local name, y, h, preset, color = r.Name, r.Y, r.H, r.Preset, r.Color
		local row: Row = { Labels = {}, W = W - 2, H = h, Preset = preset }
		for _, turn in { 0, math.pi } do
			local face = cf * CFrame.Angles(0, turn, 0) * CFrame.new(0, y, 0.45)
			local _, label = KitPlace.signText(m, name, face, W - 2, h, " ", preset, color, nil, true)
			table.insert(row.Labels, label)
		end
		rows[name] = row
	end
	m.Parent = Workspace
	board = m
	FightBoard.live(nil)
	FightBoard.refreshWin()
	return m
end

local function side(s: { Name: string, Bot: boolean, Power: number }): string
	return string.format("%s%s \u{26A1}%d", s.Name, if s.Bot then " BOT" else "", s.Power)
end

-- The fight in the arena now (two side cards from PvpService), or nil when it is empty.
function FightBoard.live(a: any?, b: any?)
	if a and b then
		setRow("Title", "\u{1F534} LIVE BATTLE!", RED)
		setRow("Live", side(a) .. "  vs  " .. side(b), WHITE)
	else
		setRow("Title", "\u{2694} PET BATTLE ARENA \u{2694}", GOLD)
		setRow("Live", "Tap BATTLE to fight on Sky Island!", Color3.fromRGB(200, 230, 255))
	end
	local slab = board and board:FindFirstChild("Slab")
	local trim = slab and slab:FindFirstChild("Trim") :: SelectionBox?
	if trim then
		trim.Color3 = if a then RED else GOLD
	end
end

function FightBoard.refreshWin()
	local today = math.floor(os.time() / 86400)
	local w = best
	if w and w.Day == today then
		setRow("Biggest", string.format("\u{1F3C6} BIGGEST WIN TODAY: %s \u{26A1}%d beat %s \u{26A1}%d", w.Winner, w.WinnerPower, w.Loser, w.LoserPower))
	else
		setRow("Biggest", "\u{1F3C6} Biggest win today: nobody yet. Be first!")
	end
end

-- A finished fight with a player winner: maybe the day's new biggest win. Returns true when it is.
function FightBoard.won(winner: string, loser: string, winnerPower: number, loserPower: number): boolean
	local cand: PvpRules.Win = { Winner = winner, Loser = loser, WinnerPower = winnerPower, LoserPower = loserPower, Day = math.floor(os.time() / 86400) }
	local nextBest = PvpRules.biggerWin(best, cand)
	local isNew = nextBest == cand
	best = nextBest
	FightBoard.refreshWin()
	return isNew
end

-- Whether a board stands in the world (no board means no "biggest win" notice).
function FightBoard.shown(): boolean
	return board ~= nil and board.Parent ~= nil
end

function FightBoard.best(): PvpRules.Win?
	return best
end

return FightBoard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="223">
        <Properties>
          <string name="Name">FriendBonus</string>
          <string name="Source"><![CDATA[--!strict
-- Friend bonus (QueueConfig.FriendLuck): a finder gets extra Luck for each Roblox friend of theirs in the same server,
-- up to MaxFriends. Player:IsFriendsWith yields and can fail, so answers are asked once per pair when a player joins
-- (in the background), cached for as long as both stay, and a failed call is simply not counted (and asked again
-- next time). The server sets the player attribute "FriendLuck" (fraction) so the client can show it; the client
-- never decides it.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local QueueConfig = require(Shared.QueueConfig)
local PetRules = require(Shared.PetRules)

local FriendBonus = {}

local cache: { [string]: boolean } = {}
local check = function(a: Player, b: Player): boolean
	return a:IsFriendsWith(b.UserId)
end

local function key(a: number, b: number): string
	return math.min(a, b) .. ":" .. math.max(a, b)
end

-- Tests only: replace the friendship check (and forget cached answers).
function FriendBonus.setCheck(fn: (Player, Player) -> boolean)
	check = fn
	table.clear(cache)
end

local function ask(a: Player, b: Player): boolean
	local k = key(a.UserId, b.UserId)
	local cached = cache[k]
	if cached ~= nil then
		return cached
	end
	local ok, res = pcall(check, a, b)
	if ok then
		cache[k] = res == true
		return res == true
	end
	return false
end

-- Friends of `player` in this server right now. With `cachedOnly` nothing yields (unknown pairs count as not friends).
function FriendBonus.count(player: Player, cachedOnly: boolean?): number
	local n = 0
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local yes = if cachedOnly then cache[key(player.UserId, other.UserId)] == true else ask(player, other)
			if yes then
				n += 1
			end
		end
	end
	return n
end

function FriendBonus.luck(player: Player, cachedOnly: boolean?): number
	local fc = QueueConfig.FriendLuck
	return PetRules.friendLuck(FriendBonus.count(player, cachedOnly), fc.PerFriend, fc.MaxFriends)
end

local function publish(player: Player)
	if player.Parent then
		local v = FriendBonus.luck(player, true)
		if player:GetAttribute("FriendLuck") ~= v then
			player:SetAttribute("FriendLuck", v)
		end
	end
end

local function onJoin(player: Player)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			ask(player, other)
			publish(other)
		end
	end
	publish(player)
end

function FriendBonus.start()
	Players.PlayerAdded:Connect(function(p)
		task.spawn(onJoin, p)
	end)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end
	Players.PlayerRemoving:Connect(function(leaver)
		local id = leaver.UserId
		for _, other in Players:GetPlayers() do
			if other ~= leaver then
				cache[key(id, other.UserId)] = nil
			end
		end
		task.defer(function()
			for _, other in Players:GetPlayers() do
				publish(other)
			end
		end)
	end)
end

return FriendBonus
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="224">
        <Properties>
          <string name="Name">GalleryService</string>
          <string name="Source"><![CDATA[--!strict
-- Park plots (dino-jungle pet park, owner picks 2026-10-10/11): each connected player gets one of the 12 fenced plots
-- (ParkConfig.Plot.Count = the lobby's population) for the session; it frees on leave. The owner's name goes on the
-- sign over the gate. The pets they chose to display (saved DisplayAssignments, in their order, up to their capacity
-- Profiles.displaySlots) are shown on the plot (ParkConfig.arrange):
--   * display slots 1-3 go in the plot's 3 glass domes (slot 1 = the big middle dome); the player picks them with
--     the display slot chooser (CollectionAction, Collection panel); an empty dome says "+ ADD PET" and its prompt
--     opens the Collection panel;
--   * pets placed beyond the 3 domes stand still in the yard on fixed spots (ParkConfig.yardSpots), playing their idle
--     on each client (PetDisplay). No pet walks around loose (owner, 2026-10-14); old saved RoamPets are ignored.
-- Every shown pet carries an "Inspect" prompt (attributes InspectOwner / InspectId) that opens the read-only
-- InspectPanel through the "Inspect" event. Visitors can look; nothing here lets anyone change another display.
-- LIKE: every plot has a LIKE post (prompt attribute LikePlot). One like per visitor per plot owner per UTC day,
-- saved in both profiles (shared/Hangout.like); the plot with the most likes TODAY wears a big floating crown and a
-- gold glow (owner pick 2026-10-14, lobby hangout idea 1).
-- Public API unchanged: Gallery.start(lobbyInfo) (lobbyInfo.Alcoves = the plots), Gallery.render(player); the player
-- attribute `Alcove` (and `Plot`) = the plot index.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local GeodeGen = require(Shared.GeodeGen)
local GeodeModel = require(Shared.GeodeModel)
local Net = require(Shared.Net)
local Cosmetics = require(Shared.Cosmetics)
local ParkConfig = require(Shared.ParkConfig)
local Hangout = require(Shared.Hangout)
local Profiles = require(script.Parent.Profiles)
local KitPlace = require(script.Parent.KitPlace)
local ParkBuilder = require(script.Parent.ParkBuilder)

local Gallery = {}


local plots: { any } = {}
local owner: { [number]: Player } = {} -- plot index -> player
local plotOf: { [Player]: number } = {}

local PLAQUE_BG = Color3.fromRGB(110, 74, 44) -- warm wood (the near-black plaque read as a black slab from the path)

-- Dome plaques are read from both sides of the dome: copy the text face onto the front too.
local function bothFaces(tag: BasePart)
	local g = tag:FindFirstChild("Label")
	if g and g:IsA("SurfaceGui") and not tag:FindFirstChild("LabelFront") then
		local c = g:Clone()
		c.Name = "LabelFront"
		c.Face = Enum.NormalId.Front
		c.Parent = tag
	end
end

local likes = ParkConfig.newLikes()
-- The crown's working table (ParkConfig.likeLeader): its counts are refreshed from today's saved likes on every
-- crown update; it is dropped once the server is empty, so it never grows for the whole life of a long server.
Players.PlayerRemoving:Connect(function(leaver)
	for _, p in Players:GetPlayers() do
		if p ~= leaver then
			return
		end
	end
	likes = ParkConfig.newLikes()
end)
local crownOwner: number? = nil -- UserId of the plot owner wearing the crown
local crown: Model? = nil
local glow: Highlight? = nil -- gold glow on the crowned plot

local function clear(idx: number)
	local a = plots[idx]
	local f = a.Root:FindFirstChild("Display")
	if f then
		f:Destroy()
	end
end

-- The plot's glow ring takes the owner's gallery theme light; with no theme it is the park teal.
local function applyTheme(root: Instance, data: any?)
	local theme = if data then Cosmetics.equipped(data.Cosmetics, "GalleryTheme") else nil
	if theme then
		Cosmetics.applyAlcoveTheme(root, theme)
	else
		for _, ring in root:GetChildren() do
			if ring.Name == "ShelfLight" and ring:IsA("BasePart") then
				ring.Color = ParkBuilder.Palette.Teal
			end
		end
	end
end

local function inspectPrompt(parent: Instance, player: Player, g: any, range: number)
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "InspectPrompt"
	pp.ActionText = "Inspect"
	pp.ObjectText = GeodeGen.displayName(g)
	pp.HoldDuration = 0
	pp.MaxActivationDistance = range
	pp.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R
	pp:SetAttribute("InspectOwner", player.UserId)
	pp:SetAttribute("InspectId", g.Id)
	pp.Parent = parent
end

local function placePrompt(parent: Instance)
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "PlacePrompt"
	pp.ActionText = "Place pet"
	pp.ObjectText = "Showcase"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 8
	pp.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R
	pp:SetAttribute("Panel", "Collection") -- opens the Collection panel locally
	pp.Parent = parent
end

local function speciesName(g: any): string
	-- the pet's nickname when its owner named it (filtered by PetService), else the species name
	if type(g.Nickname) == "string" and g.Nickname ~= "" then
		return g.Nickname
	end
	local mineral = Config.Minerals[g.Mineral]
	return if mineral then mineral.Name else tostring(g.Mineral)
end

local function petModel(g: any, scale: number, tiny: boolean): Model
	local m = GeodeModel.build(GeodeGen.public(g), { Scale = scale, Lod = true, Tiny = tiny, NoLight = true })
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	return m
end

-- The plot's LIKE prompt reads as one action: "Like / <Name>'s Park". Off on an empty plot; the owner never gets it
-- on their own plot (the client arbiter reads OwnerId; the server still refuses self-likes).
local function setLikePrompt(root: Instance, player: Player?)
	for _, d in root:GetDescendants() do
		if d:IsA("ProximityPrompt") and d:GetAttribute("LikePlot") ~= nil then
			d.ActionText = "Like"
			d.ObjectText = if player then player.DisplayName .. "'s Park" else ParkConfig.EmptyPlot
			d:SetAttribute("Off", player == nil)
			d:SetAttribute("OwnerId", if player then player.UserId else nil)
		end
	end
end

function Gallery.render(player: Player)
	local idx = plotOf[player]
	local data = Profiles.get(player)
	if not idx or not data then
		return
	end
	local a = plots[idx]
	clear(idx)
	a.SetLabel(player.DisplayName .. "'s Park") -- fitted Nameplate sign: shrinks, then truncates long names
	setLikePrompt(a.Root, player)
	applyTheme(a.Root, data)
	local f = Instance.new("Folder")
	f.Name = "Display"
	f.Parent = a.Root
	local slots = Profiles.displaySlots(data)
	local byId: { [string]: any } = {}
	local refs: { ParkConfig.PetRef } = {}
	for _, id in data.DisplayAssignments do
		if #refs >= slots then
			break
		end
		local _, g = Profiles.findGeode(data, id)
		if g and not byId[g.Id] then
			byId[g.Id] = g
			table.insert(refs, { Id = g.Id, Rarity = g.Rarity, Value = g.Value })
		end
	end
	local S = ParkConfig.Showcase
	local arr = ParkConfig.arrange(refs, ParkConfig.wanderCap(slots))
	local textCol = Config.RarityTextColors

	-- display slots 1-3: the glass domes (an empty dome invites the owner to place a pet)
	for k, dome in a.Domes do
		local ref = arr.Domes[k]
		local g = if ref then byId[ref.Id] else nil
		if g then
			local m = petModel(g, dome.Scale, false)
			m:PivotTo(dome.Slot)
			m.Parent = f
			CollectionService:AddTag(m, "PetSpin") -- clients turn dome pets slowly (PetDisplay; cosmetic)
			local tag = KitPlace.signText(f, "Label", dome.Label, 3.0, 0.6, speciesName(g), "Plaque", textCol[g.Rarity] or Color3.new(1, 1, 1), PLAQUE_BG)
			tag.CanQuery = true
			bothFaces(tag)
			inspectPrompt(tag, player, g, 9)
		else
			local tag = KitPlace.signText(f, "Label", dome.Label, 3.0, 0.6, "\u{1F43E} ADD PET", "Plaque", Color3.fromRGB(200, 190, 165), PLAQUE_BG)
			tag.CanQuery = true
			bothFaces(tag)
			placePrompt(tag)
		end
	end

	-- pets beyond the 3 domes stand still in the yard, each on its own spot, facing the gate (PetDisplay plays their
	-- idle and turns their heads to passers-by). Nothing roams (owner, 2026-10-14).
	local W = S.Wander
	local box = a.Wander
	local big = if a.Domes[1] then a.Frame:PointToObjectSpace(a.Domes[1].Slot.Position) else Vector3.new(S.Domes[1].X, 0, S.Domes[1].Z)
	local spots = ParkConfig.yardSpots(box, Vector2.new(big.X, big.Z), W.AvoidR, #arr.Yard)
	-- stand each pet on the ground players see at its spot (ParkConfig.yardLift): the plot frame sits on the plot's
	-- Floor, which a re-laid lawn can cover; players, the display itself and the plot's dome stands are not ground
	local ray = RaycastParams.new()
	ray.FilterType = Enum.RaycastFilterType.Exclude
	local skip: { Instance } = { f }
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(skip, pl.Character)
		end
	end
	ray.FilterDescendantsInstances = skip
	local function liftAt(local2: Vector2): number
		local top = a.Frame * CFrame.new(local2.X, ParkConfig.YardMaxLift + 1, local2.Y)
		local res = workspace:Raycast(top.Position, Vector3.new(0, -(ParkConfig.YardMaxLift + 3), 0), ray)
		return ParkConfig.yardLift(if res then res.Position.Y else nil, a.Frame.Position.Y)
	end
	for k, ref in arr.Yard do
		local g = byId[ref.Id]
		if g then
			local m = petModel(g, W.PetScale, true)
			local at = spots[k]
			m:PivotTo(a.Frame * CFrame.new(at.X, liftAt(at), at.Y))
			local cy = m:GetAttribute("CentreY")
			local hit = Instance.new("Part")
			hit.Name = "Stand"
			hit.Size = Vector3.new(1.4, 1.4, 1.4)
			hit.CFrame = m:GetPivot() * CFrame.new(0, if type(cy) == "number" then cy else 0.8, 0)
			hit.Transparency = 1
			hit.Anchored = true
			hit.CanCollide = false
			hit.CanTouch = false
			hit.CanQuery = true
			hit.CastShadow = false
			hit.Parent = m
			inspectPrompt(hit, player, g, 8)
			m.Parent = f
		end
	end
end

-- LIKE ---------------------------------------------------------------------------------------------------------

-- The saved hangout state of a player (repaired in place), or nil before their profile loads.
local function hangoutOf(player: Player): Hangout.State?
	local data = Profiles.get(player)
	if not data then
		return nil
	end
	data.Hangout = Hangout.sanitize(data.Hangout)
	return data.Hangout
end

local function likeCount(idx: number): number
	local p = owner[idx]
	local h = if p then hangoutOf(p) else nil
	return if h then Hangout.likesToday(h, Hangout.day(os.time())) else 0
end

-- Moves the floating crown over the most-liked plot (or hides it when nobody has a like).
local function updateCrown()
	local present: { number } = {}
	local plotByUser: { [number]: number } = {}
	for i = 1, #plots do
		local p = owner[i]
		if p then
			table.insert(present, p.UserId)
			plotByUser[p.UserId] = i
		end
	end
	-- today's saved likes are the counts the leader is picked from (a new UTC day starts everyone at zero)
	for uid, i in plotByUser do
		likes.Count[uid] = likeCount(i)
	end
	crownOwner = ParkConfig.likeLeader(likes, present, crownOwner)
	local idx = if crownOwner then plotByUser[crownOwner] else nil
	local g = glow
	if g then
		g.Adornee = if idx then plots[idx].Root else nil
		g.Parent = if idx then plots[idx].Root else nil
	end
	local c = crown
	if not c then
		return
	end
	if idx then
		c:PivotTo(plots[idx].CrownAt)
		c.Parent = plots[idx].Root
	else
		c.Parent = nil
	end
end

-- Test hook: the UserId wearing the crown (nil = nobody).
function Gallery.crownOwner(): number?
	return crownOwner
end

local lastLike: { [Player]: number } = {}

local function like(visitor: Player, prompt: ProximityPrompt)
	local want = prompt:GetAttribute("LikePlot") -- the plot number (MapNames Plot<n>), not the list position
	local idx: number? = nil
	for p, plot in plots do
		if plot.Index == want then
			idx = p
		end
	end
	if not idx then
		return
	end
	local t = os.clock()
	if lastLike[visitor] and t - lastLike[visitor] < 0.5 then
		return
	end
	lastLike[visitor] = t
	local plotOwner = owner[idx]
	if not plotOwner then
		Net.event("Toast"):FireClient(visitor, "Nobody lives here yet", "info")
		return
	end
	local vh, oh = hangoutOf(visitor), hangoutOf(plotOwner)
	if not vh or not oh then
		return
	end
	local ok, why = Hangout.like(vh, visitor.UserId, oh, plotOwner.UserId, Hangout.day(os.time()))
	if not ok then
		Net.event("Toast"):FireClient(visitor, if why == "own" then "That's your own park!" elseif why == "max" then "You liked lots of parks today!" else "You already liked this park today", "info")
		return
	end
	Profiles.changed(visitor, true)
	Profiles.changed(plotOwner, true)
	plots[idx].SetLikes(likeCount(idx))
	Net.event("Toast"):FireClient(visitor, "You liked " .. plotOwner.DisplayName .. "'s park!", "ok")
	if plotOwner.Parent then
		Net.event("Toast"):FireClient(plotOwner, visitor.DisplayName .. " liked your park!", "ok")
	end
	updateCrown()
end


local function assign(player: Player)
	if plotOf[player] then
		return
	end
	for i = 1, #plots do
		if not owner[i] then
			owner[i] = player
			plotOf[player] = i
			player:SetAttribute("Alcove", plots[i].Index or i) -- the plot number (MapNames Plot<n>): Main.client's marker
			player:SetAttribute("Plot", plots[i].Index or i)
			Gallery.render(player)
			plots[i].SetLikes(likeCount(i))
			updateCrown()
			return
		end
	end
end

local function release(player: Player)
	local idx = plotOf[player]
	if not idx then
		return
	end
	clear(idx)
	plots[idx].SetLabel(ParkConfig.EmptyPlot)
	setLikePrompt(plots[idx].Root, nil)
	applyTheme(plots[idx].Root, nil)
	owner[idx] = nil
	plotOf[player] = nil
	plots[idx].SetLikes(0)
	updateCrown()
end

-- A visitor pressed Inspect on a displayed pet: send them a read-only card. The server re-checks that the owner is
-- still here and the pet is still on display.
local lastInspect: { [Player]: number } = {}

local function inspect(visitor: Player, prompt: ProximityPrompt)
	local ownerId = prompt:GetAttribute("InspectOwner")
	local id = prompt:GetAttribute("InspectId")
	if type(ownerId) ~= "number" or type(id) ~= "string" then
		return
	end
	local t = os.clock()
	if lastInspect[visitor] and t - lastInspect[visitor] < 0.5 then
		return
	end
	lastInspect[visitor] = t
	local plotOwner = Players:GetPlayerByUserId(ownerId)
	local data = if plotOwner then Profiles.get(plotOwner) else nil
	if not plotOwner or not data or not table.find(data.DisplayAssignments, id) then
		return
	end
	local _, g = Profiles.findGeode(data, id)
	if not g then
		return
	end
	Net.event("Inspect"):FireClient(visitor, {
		Owner = plotOwner.DisplayName,
		IsYou = plotOwner == visitor,
		Specimen = GeodeGen.public(g),
	})
end

function Gallery.start(lobbyInfo)
	plots = lobbyInfo.Alcoves
	if plots[1] then
		local c = ParkBuilder.crown(plots[1].Root, "CT_Park_PlotCrown", plots[1].CrownAt, 2.4)
		c.Parent = nil -- shown over the most-liked plot only
		local top = c:FindFirstChildWhichIsA("BasePart", true)
		if top then
			local light = Instance.new("PointLight")
			light.Color = Hangout.Likes.Glow
			light.Brightness = 2
			light.Range = 18
			light.Parent = top
		end
		crown = c
	end
	local h = Instance.new("Highlight")
	h.Name = "CT_TopPlotGlow"
	h.FillColor = Hangout.Likes.Glow
	h.FillTransparency = 0.85
	h.OutlineColor = Hangout.Likes.Glow
	h.OutlineTransparency = 0.2
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	glow = h
	-- a new UTC day resets everyone's likes: re-read the counts once a minute
	task.spawn(function()
		while true do
			task.wait(60)
			for i = 1, #plots do
				if owner[i] then
					plots[i].SetLikes(likeCount(i))
				end
			end
			updateCrown()
		end
	end)
	-- Triggered is not proof of range (an exploit client can fire it): re-check the distance on the server.
	local function inRange(prompt: ProximityPrompt, player: Player): boolean
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local parent = prompt.Parent
		local at: Vector3? = if parent and parent:IsA("BasePart") then parent.Position
			elseif parent and parent:IsA("Attachment") then parent.WorldPosition
			elseif parent and parent:IsA("Model") then parent:GetPivot().Position
			else nil
		return root ~= nil and root:IsA("BasePart") and at ~= nil and (root.Position - at).Magnitude <= prompt.MaxActivationDistance + 6
	end
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if (prompt:GetAttribute("InspectId") or prompt:GetAttribute("LikePlot")) and not inRange(prompt, player) then
			return
		end
		if prompt:GetAttribute("InspectId") then
			inspect(player, prompt)
		elseif prompt:GetAttribute("LikePlot") then
			like(player, prompt)
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		lastInspect[p] = nil
		lastLike[p] = nil
	end)
	Profiles.onLoaded(function(player)
		assign(player)
	end)
	Players.PlayerRemoving:Connect(release)
end

-- Test / preview hook: the plot index a player holds.
function Gallery.plotOf(player: Player): number?
	return plotOf[player]
end

return Gallery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="225">
        <Properties>
          <string name="Name">HuntLowPoly</string>
          <string name="Source"><![CDATA[--!strict
-- Low-poly hunt arena (owner's Blender set, lobby_blender/roblox/hunt_lowpoly): when the meshes are in the place,
-- the Meadow hunt shows them instead of the procedural ground, hills, trees, fence and pads. Other zones keep the
-- procedural look (their re-skins tint those parts). Nothing that collides or that the round uses is removed: the
-- procedural parts it covers only turn invisible (their old Transparency is kept in the attribute LPHidden and put
-- back for other zones). Meshes: ServerStorage.HuntLowPoly (Hunt_Ground, Hunt_Nest, Hunt_Pads, Hunt_Stalls,
-- Hunt_Fence, Hunt_Ledge, Hunt_Water) and the shared props in ServerStorage.LowPolyLib (<Prop>_LowPoly models).
-- Placement data (arena-local studs, origin = pile centre on the floor) from hunt_placement.json.
local ServerStorage = game:GetService("ServerStorage")

local HuntLowPoly = {}

local FOLDER = "CT_Rocks_LowPoly"
local FLIP = CFrame.Angles(0, math.pi, 0)
-- procedural folders/models the low-poly set replaces (visual only; collision stays)
local COVERED = { "CT_Rocks_Boundary", "CT_Rocks_Ground", "CT_Rocks_StationPads", "CT_Rocks_ZoneScenery" }
local KEEP_VISIBLE = { CT_Rocks_Road = true }
-- hidden parts that keep their collision (walking surface, table pads, the east drop wall and rails)
local KEEP_SOLID = { CT_Rocks_Floor = true, CT_Rocks_Bench = true, Pad = true }
local KEEP_SOLID_IN = { CT_Rocks_Railing = true, CT_Rocks_RetainingWall = true }

local PIECES: { [string]: Vector3 } = {
	Hunt_Fence = Vector3.new(0.0, 4.785, -0.179),
	Hunt_Ground = Vector3.new(0.016, 2.437, -0.006),
	Hunt_Ledge = Vector3.new(65.088, -4.648, 0.016),
	Hunt_Nest = Vector3.new(-0.01, 0.541, -0.006),
	Hunt_Pads = Vector3.new(0.0, 0.154, 0.0),
	Hunt_Stalls = Vector3.new(0.0, 3.476, 0.0),
