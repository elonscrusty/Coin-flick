      <Item class="ModuleScript" referent="159">
        <Properties>
          <string name="Name">MyPetsArt</string>
          <string name="Source"><![CDATA[--!strict
-- MY PETS low-poly frame pictures (carter's art pack, 2026-10-16). Files: art/ui/my_pets_lowpoly/<File>.png, cropped to
-- their visible pixels (W x H = the uploaded size). Inset = the clear opening inside each frame as shares of the
-- picture (left, top, right, bottom), measured from the alpha along the middle lines. Id 0 = not uploaded yet: the
-- panel keeps its drawn low-poly look. Preview: --set art=1 uses preview-only ids 1016000001..15 (art/artmap.json).
-- Frames are drawn as nine-slice pictures cut at the measured opening (slice), scaled so the border keeps the source
-- proportions (scaleFor); buttons are cut a little inside their bevelled ends (Cap). Tested in tests/test_my_pets.luau.

local MyPetsArt = {}

export type Piece = { Id: number, File: string, W: number, H: number, Inset: { number }? }

MyPetsArt.Pieces = {
	Main = { Id = 102450592636035, File = "main-panel-frame", W = 1024, H = 534, Inset = { 0.0781, 0.1067, 0.0791, 0.1348 } },
	Detail = { Id = 90800160593928, File = "detail-panel-frame", W = 659, H = 1024, Inset = { 0.1381, 0.0918, 0.1411, 0.0986 } },
	CardCommon = { Id = 127375042254219, File = "card-common", W = 512, H = 498, Inset = { 0.1348, 0.1727, 0.1367, 0.1566 } },
	CardUncommon = { Id = 108087286214024, File = "card-uncommon", W = 512, H = 504, Inset = { 0.1445, 0.1409, 0.1465, 0.1587 } },
	CardRare = { Id = 139298743910020, File = "card-rare", W = 512, H = 505, Inset = { 0.1562, 0.1505, 0.1582, 0.1564 } },
	CardEpic = { Id = 129474966464429, File = "card-epic", W = 512, H = 489, Inset = { 0.1426, 0.1329, 0.1445, 0.1472 } },
	CardLegendary = { Id = 124773211826038, File = "card-legendary", W = 512, H = 508, Inset = { 0.1445, 0.1417, 0.1484, 0.1634 } },
	CardVoid = { Id = 109768012411313, File = "card-void", W = 507, H = 512, Inset = { 0.1321, 0.1699, 0.1361, 0.1523 } },
	Selected = { Id = 134979085238480, File = "selected-card-overlay", W = 512, H = 492, Inset = { 0.1289, 0.1199, 0.1309, 0.124 } },
	Slot = { Id = 115512055450279, File = "team-slot-frame", W = 512, H = 493, Inset = { 0.1367, 0.1359, 0.1387, 0.1643 } },
	Lime = { Id = 79103791647785, File = "action-lime", W = 1024, H = 317 },
	Orange = { Id = 111821095370774, File = "action-orange", W = 1024, H = 283 },
	Blue = { Id = 82932321259022, File = "action-blue", W = 1024, H = 293 },
	Close = { Id = 88518206824559, File = "close-red", W = 512, H = 492 },
	Fav = { Id = 71518618550192, File = "favorite-gold", W = 512, H = 481 },
} :: { [string]: Piece }

-- the order the preview ids follow (1016000000 + index)
MyPetsArt.Order = { "Main", "Detail", "CardCommon", "CardUncommon", "CardRare", "CardEpic", "CardLegendary", "CardVoid", "Selected", "Slot", "Lime", "Orange", "Blue", "Close", "Fav" }

-- a button's bevelled ends: kept whole (shares of the picture height)
MyPetsArt.Cap = { X = 0.45, Y = 0.34 }

local CARD = { Common = "CardCommon", Uncommon = "CardUncommon", Rare = "CardRare", Epic = "CardEpic", Legendary = "CardLegendary" }

-- the card frame for a rarity (VOID species use the void frame); unknown rarities fall back to Common
function MyPetsArt.cardKey(rarity: string?, void: boolean?): string
	if void then
		return "CardVoid"
	end
	return CARD[rarity or ""] or "CardCommon"
end

-- the piece when its picture is uploaded, else nil (draw the fallback)
function MyPetsArt.get(name: string): Piece?
	local p = MyPetsArt.Pieces[name]
	if p and p.Id > 0 then
		return p
	end
	return nil
end

function MyPetsArt.ready(): boolean
	for _, n in MyPetsArt.Order do
		if MyPetsArt.Pieces[n].Id <= 0 then
			return false
		end
	end
	return true
end

-- nine-slice centre (picture pixels): a frame is cut at its opening, a button just inside its bevelled ends
function MyPetsArt.slice(p: Piece): (number, number, number, number)
	local i = p.Inset
	if i then
		return math.floor(i[1] * p.W), math.floor(i[2] * p.H), math.ceil(p.W - i[3] * p.W), math.ceil(p.H - i[4] * p.H)
	end
	local cx, cy = math.floor(MyPetsArt.Cap.X * p.H), math.floor(MyPetsArt.Cap.Y * p.H)
	return cx, cy, p.W - cx, p.H - cy
end

-- SliceScale that draws the piece's left border `border` px wide (frames) or its whole height `border` px (buttons)
function MyPetsArt.scaleFor(p: Piece, border: number): number
	local i = p.Inset
	local src = if i then i[1] * p.W else p.H
	return border / math.max(src, 1)
end

-- the clear opening of a piece drawn in a w x h box with slice scale k: (left, top, right, bottom) in px
function MyPetsArt.opening(p: Piece, k: number): (number, number, number, number)
	local x0, y0, x1, y1 = MyPetsArt.slice(p)
	return x0 * k, y0 * k, (p.W - x1) * k, (p.H - y1) * k
end

return MyPetsArt
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="160">
        <Properties>
          <string name="Name">MyPetsLayout</string>
          <string name="Source"><![CDATA[--!strict
-- MY PETS screen layout (carter's low-poly reference, 2026-10-15): where each piece sits inside the menu panel, in
-- LOGICAL px of the panel (origin top left). Pure, so every screen size is tested offline (tests/test_my_pets.luau).
--   landscape: title + red X on top (short phones: YOUR TEAM on the title row, the title over the pet panel); YOUR TEAM (3 slots) over the toolbar (count, search, sort) and the scrolling
--   pet grid, EQUIP BEST under it; the selected pet's big panel on the right.
--   upright phone: the same pieces stacked; the selected pet's panel sits between the team and the grid (picture
--   left, numbers and buttons right).

local MyPetsLayout = {}

export type Rect = { x: number, y: number, w: number, h: number }
export type Layout = { [string]: Rect }

MyPetsLayout.Pad = 16 -- inside the main frame's border (MyPetsLayout.Border)
MyPetsLayout.Gap = 6
MyPetsLayout.CardAspect = 0.9 -- tallest card height / width (the art cards are near square)
MyPetsLayout.CardFlat = 0.6 -- flattest card height / width (the frames are nine-sliced, so they stay crisp)
MyPetsLayout.Compact = 430
MyPetsLayout.CornerClear = 0.14 -- share of the pet panel width the frame's slanted top-left corner covers
MyPetsLayout.ShortPortrait = 600 -- upright panels shorter than this put EQUIP BEST in the team strip -- landscape panels shorter than this put the team strip on the title row

-- the pieces the panel builds (the test checks them all)
MyPetsLayout.Top = { "Title", "Close", "Team", "Count", "Search", "Sort", "Grid", "EquipBest", "Detail" }
MyPetsLayout.Inner = { "Name", "Badge", "Preview", "PowerLabel", "Power", "Level", "Bar", "Action", "Display", "Fav" }

local function r(x: number, y: number, w: number, h: number): Rect
	return { x = x, y = y, w = math.max(w, 0), h = math.max(h, 0) }
end

local function clamp(v: number, lo: number, hi: number): number
	return math.max(lo, math.min(v, hi))
end

-- border widths (logical px) the frame pictures are drawn at: the main frame, the pet panel frame, a card frame
function MyPetsLayout.Border(w: number, h: number): number
	return clamp(math.min(w, h) * 0.03, 9, 14)
end

function MyPetsLayout.detailBorder(d: Rect): number
	return clamp(d.w * 0.04, 9, 15)
end

function MyPetsLayout.cardBorder(cw: number): number
	return clamp(cw * 0.075, 7, 14)
end

-- the selected pet's panel: name, rarity badge, big picture, POWER, level, XP bar, buttons. `wide` = picture on
-- the left, numbers on the right (upright phones, where the panel is short and wide). Everything sits inside the
-- frame's border, buttons a clear step up from its bottom edge.
local function detail(out: Layout, d: Rect, wide: boolean)
	local p, g = MyPetsLayout.detailBorder(d) + 5, MyPetsLayout.Gap
	local btnH = clamp(d.h * 0.12, 42, 52)
	if wide then
		-- buttons along the whole bottom; picture left, numbers right above them
		local by = d.y + d.h - p - btnH
		local bw = d.w - 2 * p
		out.Action = r(d.x + p, by, bw * 0.45 - g, btnH)
		out.Display = r(d.x + p + bw * 0.45, by, bw * 0.55 - btnH - g, btnH)
		out.Fav = r(d.x + d.w - p - btnH, by, btnH, btnH)
		local pw = math.floor(d.w * 0.42)
		out.Preview = r(d.x + p, d.y + p, pw - p, by - g - d.y - p)
		local x = d.x + pw + g
		local w = d.x + d.w - p - x
		if d.h < 200 then
			-- short upright panel: badge beside the name, POWER beside its number, the level beside the XP bar
			local nameH = 28
			local bwd = math.min(w * 0.44, 96)
			out.Name = r(x, d.y + p, w - bwd - 4, nameH)
			out.Badge = r(x + w - bwd, d.y + p + 4, bwd, 20)
			local lvY = by - 4 - 20
			out.Level = r(x, lvY, w * 0.5, 20)
			out.Bar = r(x + w * 0.5 + 4, lvY + 4, w * 0.5 - 4, 12)
			local py = d.y + p + nameH + 2
			local ph = math.min(lvY - 2 - py, 44)
			out.PowerLabel = r(x, py, w * 0.36, ph)
			out.Power = r(x + w * 0.36 + 2, py, w * 0.64 - 2, ph)
			return
		end
		local nameH = clamp(d.h * 0.13, 28, 38)
		out.Name = r(x, d.y + p, w, nameH)
		local y = d.y + p + nameH + 2
		out.Badge = r(x + w * 0.2, y, w * 0.6, 20)
		y += 20 + 2
		local barY = by - g - 12
		out.Bar = r(x + 4, barY, w - 8, 12)
		local lvY = barY - 2 - 20
		out.Level = r(x, lvY, w, 20)
		out.PowerLabel = r(x, y, w, 16)
		y += 16
		out.Power = r(x + w * 0.06, y, w * 0.88, math.min(lvY - 2 - y, 50))
		return
	end
	local x, w = d.x + p, d.w - 2 * p
	local by = d.y + d.h - p - btnH
	out.Action = r(x, by, w * 0.48 - g, btnH)
	out.Display = r(x + w * 0.48, by, w * 0.52 - btnH - g, btnH)
	out.Fav = r(x + w - btnH, by, btnH, btnH)
	if d.h < 380 then
		-- short panel: the full name on its own row (clear of the frame's corners), the ON TEAM / ON DISPLAY chips and
		-- the rarity badge on the row under it; POWER (label over the number) and the level over its XP bar share one
		-- row, so the picture keeps its room
		local nameH = clamp(d.h * 0.1, 26, 34)
		local nc = w * MyPetsLayout.CornerClear -- clear of the frame's slanted top-left corner, centred
		out.Name = r(x + nc, d.y + p, w - 2 * nc, nameH)
		local bw = math.min(w * 0.36, 110)
		local cy = d.y + p + nameH + 2
		out.Badge = r(x + w - bw, cy, bw, 22)
		-- the chips start a step in: the pet panel frame's slanted top-left corner reaches into its opening
		local cx = w * MyPetsLayout.CornerClear
		out.Roles = r(x + cx, cy, w - bw - g - cx, 22)
		local rowH = clamp(d.h * 0.15, 40, 54)
		local ry = by - g - rowH
		local pw = math.floor(w * 0.56)
		out.PowerLabel = r(x, ry, pw, 14)
		out.Power = r(x, ry + 14, pw, rowH - 14)
		out.Level = r(x + pw + g, ry + 2, w - pw - g, 20)
		out.Bar = r(x + pw + g, ry + rowH - 16, w - pw - g, 14)
		local y = cy + 22 + 2
		out.Preview = r(x, y, w, ry - 2 - y)
		return
	end
	local nameH = clamp(d.h * 0.1, 30, 44)
	local nc = w * MyPetsLayout.CornerClear
	out.Name = r(x + nc, d.y + p, w - 2 * nc, nameH)
	local y = d.y + p + nameH + 2
	out.Badge = r(x + w * 0.28, y, w * 0.44, 24)
	y += 24 + 4
	local barY = by - g - 12
	local lvY = barY - 3 - 20
	local powH = clamp(d.h * 0.11, 36, 52)
	local powY = lvY - 2 - powH
	local plY = powY - 18
	out.PowerLabel = r(x, plY, w, 18)
	out.Power = r(x + w * 0.1, powY, w * 0.8, powH)
	out.Level = r(x, lvY, w, 20)
	out.Bar = r(x + 6, barY, w - 12, 12)
	out.Preview = r(x, y, w, plY - 4 - y)
end

-- the team strip: the YOUR TEAM words on the left, three square slots on the right
local function team(out: Layout, t: Rect, minLabel: number)
	local g = MyPetsLayout.Gap
	local s = t.h - 8
	local slotsW = 3 * s + 2 * g
	local labelW = t.w - slotsW - 12
	if labelW < minLabel then -- narrow: smaller slots so the words keep room
		s = math.floor((t.w - 12 - minLabel - 2 * g) / 3)
		slotsW = 3 * s + 2 * g
		labelW = t.w - slotsW - 12
	end
	out.TeamLabel = r(t.x + 6, t.y + 4, labelW, t.h - 8)
	for i = 1, 3 do
		out["Slot" .. i] = r(t.x + t.w - 6 - slotsW + (i - 1) * (s + g), t.y + (t.h - s) / 2, s, s)
	end
end

-- count / search / sort in one row
local function toolbar(out: Layout, b: Rect)
	local g = MyPetsLayout.Gap
	local cw = math.max(b.w * 0.24, 92)
	local sw = math.max(b.w * 0.25, 96)
	out.Count = r(b.x, b.y, cw, b.h)
	out.Sort = r(b.x + b.w - sw, b.y, sw, b.h)
	out.Search = r(b.x + cw + g, b.y, b.w - cw - sw - 2 * g, b.h)
end

-- Grid columns and card size for a grid `w` x `h` (logical), leaving room for the scroll bar: three even columns
-- across the whole width (two on a very narrow grid); cards as tall as fits two full rows, never flatter than
-- CardFlat, and flatter still only when that is what it takes to show a row and a half (so the grid reads as a
-- scrolling list on short phones).
MyPetsLayout.GridPad = { Top = 6, Bottom = 10, Side = 4 }
function MyPetsLayout.cards(w: number, bar: number?, h: number?): (number, number, number)
	local g = MyPetsLayout.Gap
	local inner = w - (bar or 8) - 2 * MyPetsLayout.GridPad.Side
	local cols = if inner >= 330 then 3 else 2
	local cw = math.floor((inner - (cols - 1) * g) / cols)
	local tall = cw * MyPetsLayout.CardAspect
	if not h then
		return cols, cw, math.floor(tall)
	end
	local room = h - MyPetsLayout.GridPad.Top
	local two = room / 2 - g
	local ch = math.min(tall, math.max(two, cw * MyPetsLayout.CardFlat))
	if room / (ch + g) < 1.5 then
		ch = math.max(room / 1.5 - g, 72)
	end
	return cols, cw, math.floor(math.min(ch, tall))
end

function MyPetsLayout.layout(w: number, h: number): Layout
	local out: Layout = {}
	local p, g = MyPetsLayout.Pad, MyPetsLayout.Gap
	local portrait = h > w * 1.05
	local bottom = h - p
	if portrait then
		local headH = clamp(h * 0.08, 44, 60)
		out.Title = r(p, 4, math.min(w * 0.62, 320), headH - 4)
		local cs = math.max(headH - 6, 40)
		out.Close = r(w - p - cs, 4, cs, cs)
		local top = headH + 4
		local cw = w - 2 * p
		-- a short upright phone: EQUIP BEST moves into the team strip, under the YOUR TEAM words, and the pet panel
		-- tightens, so the grid keeps room for its cards
		local short = h < MyPetsLayout.ShortPortrait
		local teamH = if short then 84 else clamp(h * 0.11, 64, 92)
		out.Team = r(p, top, cw, teamH)
		local y = top + teamH + g
		local detH = if short then clamp(h * 0.33, 162, 220) else clamp(h * 0.34, 220, 270)
		out.Detail = r(p, y, cw, detH)
		y += detH + g
		local tbH = 40
		local tb = r(p, y, cw, tbH)
		if short then
			local t = out.Team
			local s = math.min(t.h - 8, math.floor((t.w - 12 - 130 - 2 * g) / 3))
			local slotsW = 3 * s + 2 * g
			local lw = t.w - slotsW - 12 - g
			out.TeamLabel = r(t.x + 6, t.y + 4, lw, 22)
			out.EquipBest = r(t.x + 6, t.y + 28, lw, t.h - 34)
			for i = 1, 3 do
				out["Slot" .. i] = r(t.x + t.w - 6 - slotsW + (i - 1) * (s + g), t.y + (t.h - s) / 2, s, s)
			end
			out.Grid = r(p, y + tbH + g, cw, bottom - (y + tbH + g))
		else
			local ebH = 48
			out.EquipBest = r(p, bottom - ebH, cw, ebH)
			out.Grid = r(p, y + tbH + g, cw, bottom - ebH - g - (y + tbH + g))
			team(out, out.Team, 120)
		end
		toolbar(out, tb)
		detail(out, out.Detail, true)
		return out
	end
	local lw = math.floor((w - 3 * p) * 0.6)
	local rx = p * 2 + lw
	local rw = w - rx - p
	local tbH = clamp(h * 0.09, 36, 42)
	local ebH = clamp(h * 0.1, 40, 56)
	local gy
	if h < MyPetsLayout.Compact then
		-- short phone: YOUR TEAM on the title row (left), the title and the X over the pet panel (right)
		local rowH = clamp(h * 0.17, 56, 72)
		local y0 = 8
		out.Team = r(p, y0, lw, rowH)
		local cs = clamp(rowH - 14, 38, 50)
		out.Close = r(w - p - cs, y0 + (rowH - cs) / 2, cs, cs)
		out.Title = r(rx, y0 + 2, rw - cs - g, rowH - 4)
		local top = y0 + rowH + g
		out.Detail = r(rx, top, rw, bottom - top)
		local tb = r(p, top, lw, tbH)
		toolbar(out, tb)
		gy = top + tbH + g
		team(out, out.Team, 96)
		-- EQUIP BEST joins the team row (between the words and the slots), so the grid runs to the bottom and two
		-- full rows of cards fit on a phone
		local tl = out.TeamLabel
		local lw2 = clamp(tl.w * 0.42, 100, 150)
		out.EquipBest = r(tl.x + lw2 + g, out.Team.y + 6, tl.w - lw2 - g, out.Team.h - 12)
		tl.w = lw2
		out.Grid = r(p, gy, lw, bottom - gy)
		detail(out, out.Detail, false)
		return out
	else
		local headH = clamp(h * 0.11, 46, 60)
		out.Title = r(p, 4, math.min(w * 0.5, 340), headH - 4)
		local cs = math.max(headH - 6, 40)
		out.Close = r(w - p - cs, 4, cs, cs)
		local top = headH + 4
		out.Detail = r(rx, top, rw, bottom - top)
		local teamH = clamp((bottom - top) * 0.21, 70, 108)
		out.Team = r(p, top, lw, teamH)
		local tb = r(p, top + teamH + g, lw, tbH)
		toolbar(out, tb)
		gy = tb.y + tbH + g
		team(out, out.Team, 120)
	end
	out.EquipBest = r(p, bottom - ebH, lw, ebH)
	out.Grid = r(p, gy, lw, bottom - ebH - g - gy)
	detail(out, out.Detail, false)
	return out
end

return MyPetsLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="161">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Remote registry. The server creates every remote at boot; clients wait for them.
-- Clients only ever send intents; every outcome is decided on the server.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

Net.Events = {
	-- client -> server
	"RockAction", -- (action, roundId, rockId?) action: Pickup | Deposit | Crush | ToggleMachine (V3 loop, docs/V3_LOOP.md)
	"PartyAction", -- (action, arg)
	"MatchAction", -- (action)
	"ShopAction", -- (action, id)
	"CollectionAction", -- (action, arg1, arg2)
	"SettingsAction", -- (settings table)
	"ClientReady", -- ()
	"TutorialAction", -- ("Skip" | "Goal")
	"LaunchAction", -- (action) Teleport mode: "Retry" | "Cancel" | "StartWithArrived" | "ReturnAll"
	"StoreAction", -- ("Buy" | "Equip" | "Unequip", cosmetic id or kind)
	"RobuxAction", -- ("Buy", egg id, count 1|3|10 | "LuckPotion" | pass key) Robux shop (RobuxService); the server prompts the purchase
	"RetentionAction", -- ("Ready" | "Starter" | "Gift") first five minutes + comeback hooks (RetentionService)
	-- server -> client
	"ProfileState", -- (public profile)
	"PartyState", -- (party view or nil, invites)
	"Inspect", -- (card) read-only view of a specimen on display in a lobby gallery
	"MatchEvent", -- (kind, payload)
	"Toast", -- (text, kind)
	"LaunchEvent", -- (kind, payload) Teleport mode: loading / waiting-for-party UI
	"Fx", -- (kind, data) cosmetic feedback, e.g. ("Sell", { Pos, Count, Total })
	"RareHatch", -- (kind "Local" | "Global", { Name, Pet, Rarity }) rare hatch banner (RareHatch); Local adds fireworks
	"EggEvent", -- (kind, payload) EggEvents: ("Wobble", { Round, Id }) | ("Boots", { Round, UserId, Until, Seconds })
	"Retention", -- (kind, payload) RetentionService: "Starter" | "Gift" | "GiftReady" | "Away" | "Friend" | "Group"
	"HangoutEvent", -- (kind, payload) lobby hangout (LobbyGames / LobbyEvents): Whack, WhackDone, Event
	"HatchShow", -- (show) a bought egg hatching at the public hatch stand: { Buyer, BuyerId, Egg, Count, Pet, Waiting } (RobuxService queue; Waiting = shows still queued)
}

local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder :: Folder
	end
	local found: Folder
	if RunService:IsServer() then
		local f = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
		if f then
			found = f
		else
			found = Instance.new("Folder")
			found.Name = "Remotes"
			found.Parent = ReplicatedStorage
		end
	else
		found = ReplicatedStorage:WaitForChild("Remotes") :: Folder
	end
	folder = found
	return found
end

function Net.init()
	local f = getFolder()
	if RunService:IsServer() then
		for _, name in Net.Events do
			if not f:FindFirstChild(name) then
				local e = Instance.new("RemoteEvent")
				e.Name = name
				e.Parent = f
			end
		end
	end
end

function Net.event(name: string): RemoteEvent
	local f = getFolder()
	if RunService:IsServer() then
		return f:FindFirstChild(name) :: RemoteEvent
	end
	return f:WaitForChild(name) :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="162">
        <Properties>
          <string name="Name">NoticeLayout</string>
          <string name="Source"><![CDATA[--!strict
-- Decisions of the notification column (client/ui/UI fitNotices / notify), pure so tests/test_notice_layout.luau can
-- check them: with a menu open the column shows at most ONE notice, and sits top-right under the menu header (or beside
-- the menu when there is room) rather than over the menu body.
local NoticeLayout = {}

NoticeLayout.SideMin = 230 -- logical width beside a menu that takes the notification column

-- How many cards may be on screen: one over an open menu, else `normal` (UI.MaxNotices).
function NoticeLayout.maxCards(menuOpen: boolean, normal: number): number
	return if menuOpen then 1 else normal
end

-- Where the column goes: "side" (beside the menu, no dialog), "corner" (top-right, under the menu header, no dialog
-- and no room beside it), or "hud" (no menu, or a dialog is open: the HUD spot, kept clear of the protected bands).
function NoticeLayout.mode(menuOpen: boolean, dialogOpen: boolean, sideGap: number): string
	if not menuOpen or dialogOpen then
		return "hud"
	end
	return if sideGap >= NoticeLayout.SideMin then "side" else "corner"
end

return NoticeLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="163">
        <Properties>
          <string name="Name">ParkConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Dino-jungle pet park (the public lobby, owner picks 2026-10-10, latest layout picture): layout numbers and the pure
-- rules around them. The park sits on normal ground in a jungle valley (ground top y = Config.Lodge.FloorY = 0).
-- World frame: a 4 x 4 grid of cells; the middle 2 x 2 is an open grass CLEARING with the four queue nests (2 x 2)
-- and the crowned leaderboard; the 12 outer cells are square fenced PLOTS, stone paths between them. The main stone
-- path runs north-south through the middle: the spawn plaza with the stalls at its south end (+Z), the EGG SHOP hut at
-- its north end (-Z). Used by ParkBuilder (geometry), LobbyBuilder (spawn, zones), GalleryService (who shows where)
-- and the yard spots. Tested offline in tests/test_park.luau.

local ParkConfig = {}

-- Nameplate text (and like-prompt object) on a plot nobody holds right now. Plots are given out on join, so this
-- must not read like something to claim; it says the real rule (audit 2 #3: "FREE PLOT" gave no next step).
ParkConfig.EmptyPlot = "OPEN PLOT\nthe next player to join gets it"
-- Title text a hand-built sign may carry for an empty plot (MapHooks finds and reuses that label).
ParkConfig.SignMatch = { "FREE PLOT", "OPEN PLOT" }
-- Over the local player's own plot, only on their screen (client/YourPlotTag).
ParkConfig.YourPlot = "YOUR PLOT"

-- Walkable park bounds (world studs): the invisible boundary and the lobby camera box (Config.Lodge mirrors these).
ParkConfig.Bounds = { MinX = -100, MaxX = 100, MinZ = -164, MaxZ = 160 } -- Pet Garden yard 200 x 320 (walls x +-91, z -160..142)

-- Grid: cell centres on both axes (studs); the four middle cells form the clearing.
ParkConfig.Grid = { Centres = { -66, -22, 22, 66 }, Pitch = 44 }
ParkConfig.Clearing = { Half = 38 } -- grass square -38..38 (the stone ring path runs around it at 39..49)
ParkConfig.Path = { Width = 10, Ring = 44 } -- ring path centre line |x| / |z| = 44; main path x = 0

-- Spawn plaza (south end of the main path): stalls and two boards around it, the spawn facing the clearing (-Z).
ParkConfig.Plaza = { MinX = -56, MaxX = 56, MinZ = 92, MaxZ = 132 }
ParkConfig.Spawn = { X = 0, Z = 108 }

-- EGG SHOP hut at the north end of the main path, facing the clearing (+Z).
ParkConfig.Shop = { X = 0, Z = -108 }

-- PET TOWER entrance (the tower thread hooks its TowerPortal part) at the west end of the cross path, facing the park.
ParkConfig.Tower = { X = -95, Z = 0 }

-- Plots: 12 squares of Size studs in the outer cells. Plot order = allocation order (south row first: nearest the
-- spawn). Each plot's gate faces the ring path toward the clearing.
ParkConfig.Plot = { Count = 12, Size = 32 }
local CELLS: { { number } } = {
	{ -22, 66 }, { 22, 66 }, { -66, 66 }, { 66, 66 }, -- south row (nearest the spawn)
	{ -66, 22 }, { 66, 22 }, { -66, -22 }, { 66, -22 }, -- west and east columns
	{ -22, -66 }, { 22, -66 }, { -66, -66 }, { 66, -66 }, -- north row
}

-- Showcase layout inside a plot (plot frame: origin = yard centre on the ground, -Z (LookVector) = toward the gate).
-- Owner pick: every plot has exactly 3 glass domes on stone stands at the back, and the player chooses which pets go
-- in them (the display slot chooser, CollectionAction; display slot k = dome k, slot 1 = the big middle dome).
-- Pets placed beyond the 3 domes (a larger display capacity) stand still in the yard between the gate and the domes
-- on fixed spots (yardSpots), kept AvoidR clear of the middle dome. (Speed is unused since roaming was removed.)
ParkConfig.Showcase = {
	Domes = {
		{ X = 0, Z = 8, Height = 1.6, Plinth = 8.4, Dome = 7.4, PetScale = 3.4 },
		{ X = -10, Z = 6, Height = 1.3, Plinth = 6.6, Dome = 5.8, PetScale = 2.7 },
		{ X = 10, Z = 6, Height = 1.3, Plinth = 6.6, Dome = 5.8, PetScale = 2.7 },
	},
	Wander = { MinX = -7.5, MaxX = 7.5, MinZ = -12.5, MaxZ = 1.0, AvoidR = 6, Speed = 2.2, PetScale = 2.2 },
	MaxWander = 17, -- 3 domes + 17 standing in the yard = 20, the largest bought display level (Config.Display); see wanderCap
	FloorMargin = 5, -- hand-built plots: yard pets keep this far inside the pen's Floor edge (fence, posts)
}

-- Queue nests (the hunt pads) in a 2 x 2 in the clearing; each glows its own colour and has a small sign.
ParkConfig.QueuePads = {
	Size = 8, -- glowing disc diameter (the woven rim sits around it)
	Spots = { { -11, -12 }, { 11, -12 }, { -11, 12 }, { 11, 12 } },
	Colours = { "Yellow", "Blue", "Pink", "Green" },
}
-- The two lobby boards (owner: only these two) stand side by side east of the nests, facing them (-X):
-- RAREST PET (crowned) and HIGHEST FLOOR. Players read them from the open grass between the nests and the boards.
ParkConfig.Leaderboard = { X = 30, Z = -8 } -- RAREST PET, the tall crowned board
ParkConfig.TowerBoard = { X = 30, Z = 8 } -- HIGHEST FLOOR
-- WHAT'S NEW board in the plaza (shared/WhatsNew), beside the park arch, facing the spawn (+Z).
ParkConfig.NewsBoard = { X = 22, Z = 97, W = 16, H = 7 }

-- Public HATCH STAND beside the EGG SHOP (hook only: part HatchStand, attribute HatchStand = true, attachment
-- HatchPoint on top; the hatch itself is played there by the shop side).
ParkConfig.HatchStand = { X = 21, Z = -97, D = 11 }

-- Secret egg (hook only: part SecretEgg, attribute SecretEgg, prompt "Take"): far north-east corner of the jungle
-- edge, inside the boundary, tucked behind bushes.
ParkConfig.SecretEgg = { X = 99, Z = -131 }

-- Plot LIKEs (server-checked; GalleryService): one like per visitor per plot owner per server session, never your
-- own plot. The plot with the most likes (at least one) wears the crown; on a tie the current crown stays.
ParkConfig.Likes = { CrownHeight = 20 }

export type LikeState = { Count: { [number]: number }, By: { [number]: { [number]: boolean } } }

function ParkConfig.newLikes(): LikeState
	return { Count = {}, By = {} }
end

-- Records a like from `visitor` for the plot of `owner`; returns (ok, reason).
function ParkConfig.like(s: LikeState, visitor: number, owner: number): (boolean, string)
	if visitor == owner then
		return false, "own"
	end
	local by = s.By[owner]
	if not by then
		by = {}
		s.By[owner] = by
	end
	if by[visitor] then
		return false, "already"
	end
	by[visitor] = true
	s.Count[owner] = (s.Count[owner] or 0) + 1
	return true, "ok"
end

-- The owner whose plot wears the crown among `present` owners (or nil); `current` keeps it on a tie.
function ParkConfig.likeLeader(s: LikeState, present: { number }, current: number?): number?
	local best, bestN = nil, 0
	for _, o in present do
		local n = s.Count[o] or 0
		if n > bestN or (n == bestN and n > 0 and o == current) then
			best, bestN = o, n
		end
	end
	if current and best ~= current and table.find(present, current) and (s.Count[current] or 0) == bestN then
		return current
	end
	return best
end

local RANK: { [string]: number } = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5 }
ParkConfig.Rank = RANK

-- Plot i: cell centre (x, z) and the unit direction (dx, dz) from the plot toward its gate (the ring path).
function ParkConfig.plotCentre(i: number): (number, number, number, number)
	local c = CELLS[i]
	local x, z = c[1], c[2]
	if math.abs(z) == 66 then
		return x, z, 0, -math.sign(z)
	end
	return x, z, -math.sign(x), 0
end

-- World frame of plot i on the ground (y = groundY): origin at the yard centre, LookVector toward the gate.
function ParkConfig.plotFrame(i: number, groundY: number?): CFrame
	local x, z, dx, dz = ParkConfig.plotCentre(i)
	local p = Vector3.new(x, groundY or 0, z)
	return CFrame.new(p) * CFrame.Angles(0, math.atan2(-dx, -dz), 0) -- look (-Z) toward the gate
end

-- Where the displayed pets go. `pets` = the displayed specimens in display order (each { Id, Rarity, Value }).
-- The first 3 go in the domes (slot k = dome k); the rest stand still in the yard (at most maxYard), each on its own
-- spot (yardSpots) doing its idle. Nothing walks around loose (owner, 2026-10-14: no roaming pets). Pure: no instances.
export type PetRef = { Id: string, Rarity: string, Value: number? }

function ParkConfig.arrange(pets: { PetRef }, maxYard: number?): { Domes: { PetRef }, Yard: { PetRef } }
	local nDomes = #ParkConfig.Showcase.Domes
	local nYard = maxYard or ParkConfig.Showcase.MaxWander
	local out = { Domes = {}, Yard = {} }
	for _, p in pets do
		if #out.Domes < nDomes then
			table.insert(out.Domes, p)
		elseif #out.Yard < nYard then
			table.insert(out.Yard, p)
		end
	end
	return out
end

-- Fixed standing spots (plot-local x, z) for `n` yard pets inside `box`, inset from the fence, clear of the big
-- dome (`avoid`, radius `avoidR`). The yard is cut into an even cols x rows table of cells over its WHOLE width and
-- depth (the cols x rows with the widest spacing) and each pet stands in a cell's middle: rows fill from the gate side (-Z, the front)
-- toward the domes, and a part-full last row is spread across the width. When cells would be closer than MIN_GAP
-- studs, a tight grid is reused in turn instead (huge displays on a small yard). Pure.
local MIN_GAP = 2.4
function ParkConfig.yardSpots(box: { MinX: number, MaxX: number, MinZ: number, MaxZ: number }, avoid: Vector2, avoidR: number, n: number): { Vector2 }
	local inset = 1.2
	local x0, x1 = box.MinX + inset, box.MaxX - inset
	local z0, z1 = box.MinZ + inset, box.MaxZ - inset
	if x0 > x1 then
		x0, x1 = (box.MinX + box.MaxX) / 2, (box.MinX + box.MaxX) / 2
	end
	if z0 > z1 then
		z0, z1 = (box.MinZ + box.MaxZ) / 2, (box.MinZ + box.MaxZ) / 2
	end
	local out: { Vector2 } = {}
	if n <= 0 then
		return out
	end
	local w, d = math.max(x1 - x0, 0.01), math.max(z1 - z0, 0.01)
	-- the table whose cells are farthest apart (ties: more columns, so the yard's width is used)
	local function cells(cols: number, rows: number): ({ { Vector2 } }, number)
		local byRow: { { Vector2 } } = {}
		local count = 0
		for r = 1, rows do
			local row = {}
			for c = 1, cols do
				local v = Vector2.new(x0 + (c - 0.5) * w / cols, z0 + (r - 0.5) * d / rows)
				if (v - avoid).Magnitude >= avoidR then
					table.insert(row, v)
				end
			end
			count += #row
			table.insert(byRow, row)
		end
		return byRow, count
	end
	local bestRows: { { Vector2 } }? = nil
	local bestGap = MIN_GAP - 1e-6
	for cols = n, 1, -1 do
		for rows = math.ceil(n / cols), math.ceil(n / cols) + 4 do
			local gap = math.min(w / cols, d / rows)
			if gap <= bestGap then
				break
			end
			local byRow, count = cells(cols, rows)
			if count >= n then
				bestRows, bestGap = byRow, gap
				break
			end
		end
	end
	if bestRows then
		for _, row in bestRows do
			local left = n - #out
			if left <= 0 then
				break
			end
			if left >= #row then
				for _, v in row do
					table.insert(out, v)
				end
			else
				for k = 1, left do
					table.insert(out, row[math.floor((k - 0.5) * #row / left) + 1])
				end
			end
		end
		return out
	end
	-- fallback: a MIN_GAP grid over the yard, reused in turn
	local spots: { Vector2 } = {}
	local nx, nz = math.floor(w / MIN_GAP) + 1, math.floor(d / MIN_GAP) + 1
	local sx, sz = if nx > 1 then w / (nx - 1) else 0, if nz > 1 then d / (nz - 1) else 0
	for r = 0, nz - 1 do
		for c = 0, nx - 1 do
			local v = Vector2.new(x0 + c * sx, z0 + r * sz)
			if (v - avoid).Magnitude >= avoidR then
				table.insert(spots, v)
			end
		end
	end
	for k = 1, n do
		out[k] = if #spots > 0 then spots[(k - 1) % #spots + 1] else Vector2.new((x0 + x1) / 2, (z0 + z1) / 2)
	end
	return out
end

-- The yard box (plot-local) yard pets stand in, from the pen's Floor half sizes seen from the plot frame (`hx` across,
-- `hz` gate to back) less `margin`, pulled in to the inner face of each outer fence run (`fences`: plot-local centre
-- X/Z and half extents TX/TZ of every part named "...Fence...", less `pad`). Only real outer runs count: long and thin
-- (along a side), standing in the outer band of that side (past 70% of the half size), and pulling the side in by at
-- most 40% of the half size. A "fence" inside the pen (a garden-bed fence, a rail by the domes) would otherwise shrink
-- the yard to a strip and line every pet up along one fence (owner report 2026-10-15). Smaller than `fallback` (the
-- code default box) on either axis -> `fallback`. Pure.
export type YardFence = { X: number, Z: number, TX: number, TZ: number }
function ParkConfig.yardBox(hx: number, hz: number, margin: number, fences: { YardFence }, pad: number, fallback: { MinX: number, MaxX: number, MinZ: number, MaxZ: number }): { MinX: number, MaxX: number, MinZ: number, MaxZ: number }
	local ax, az = hx - margin, hz - margin
	if not (ax > fallback.MaxX and az > fallback.MaxZ) then
		return { MinX = fallback.MinX, MaxX = fallback.MaxX, MinZ = fallback.MinZ, MaxZ = fallback.MaxZ }
	end
	local box = { MinX = -ax, MaxX = ax, MinZ = -az, MaxZ = az }
	local maxPullX, maxPullZ = hx * 0.4, hz * 0.4
	for _, f in fences do
		local ox, oz = math.abs(f.X) / math.max(hx, 1), math.abs(f.Z) / math.max(hz, 1)
		if ox >= oz then
			-- an X side: a run along z, thin across x, in the outer band
			if f.TX * 3 <= f.TZ and ox >= 0.7 then
				local inner = math.abs(f.X) - f.TX - pad
				if inner >= hx - maxPullX then
					if f.X > 0 then
						box.MaxX = math.min(box.MaxX, inner)
					else
						box.MinX = math.max(box.MinX, -inner)
					end
				end
			end
		elseif f.TZ * 3 <= f.TX and oz >= 0.7 then
			local inner = math.abs(f.Z) - f.TZ - pad
			if inner >= hz - maxPullZ then
				if f.Z > 0 then
					box.MaxZ = math.min(box.MaxZ, inner)
				else
					box.MinZ = math.max(box.MinZ, -inner)
				end
			end
		end
	end
	if box.MinX > box.MaxX then
		local c = (box.MinX + box.MaxX) / 2
		box.MinX, box.MaxX = c, c
	end
	if box.MinZ > box.MaxZ then
		local c = (box.MinZ + box.MaxZ) / 2
		box.MinZ, box.MaxZ = c, c
	end
	return box
end

-- How far above the plot floor a yard pet stands so it is on the ground players actually see (Studio 2026-10-15: a
-- moved hand-built plot kept its old Floor height while the new lawn there is higher, so pets placed on the Floor
-- were buried). `hitY` = the first surface a ray straight down at the spot meets (nil = none); surfaces below the
-- floor, or more than YardMaxLift above it (a roof, a tree, a sign), are ignored. Pure.
ParkConfig.YardMaxLift = 14
function ParkConfig.yardLift(hitY: number?, floorTop: number): number
	if hitY == nil or hitY ~= hitY then
		return 0
	end
	local lift = hitY - floorTop
	if lift <= 0 or lift > ParkConfig.YardMaxLift then
		return 0
	end
	return lift
end

-- How many pets may stand in the yard on a plot with `slots` display slots: at least Showcase.MaxWander, and enough for every
-- slot past the domes (the ExtraPlots pass adds RobuxConfig.ExtraDisplaySlots on top of the biggest bought level).
function ParkConfig.wanderCap(slots: number): number
	return math.max(ParkConfig.Showcase.MaxWander, slots - #ParkConfig.Showcase.Domes)
end

-- Inside the walkable park (world x / z)?
function ParkConfig.inside(x: number, z: number): boolean
	local B = ParkConfig.Bounds
	return x > B.MinX and x < B.MaxX and z > B.MinZ and z < B.MaxZ
end

return ParkConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="164">
        <Properties>
          <string name="Name">PathGrid</string>
          <string name="Source"><![CDATA[--!strict
-- Flat-box spatial grid (pure; tests/test_path_grid.luau). Lobby path parts have CanQuery = false (the lobby build turns
-- queries off for its 1500+ decor parts), so raycasts and overlap queries never see them. RainbowPath (is this player
-- standing on a path?) and LobbyBloom (does a flower spot touch a path or a prop?) ask this grid instead: it is filled
-- once from the parts' CFrames and sizes and answers with plain math.
--
-- A box is a part seen from above: centre, half sizes and its two flat axes (R and Z, both on the ground plane). The
-- part's most vertical axis is its height (a path joint disc is a Cylinder turned so its axis points up: its X is the
-- height). An upright cylinder or a ball is a round footprint (Round = radius).

local PathGrid = {}

export type Box = {
	X: number, Y: number, Z: number, -- centre
	HX: number, HY: number, HZ: number, -- half sizes
	RX: number, RZ: number, -- right axis (ground plane, unit)
	ZX: number, ZZ: number, -- back axis (ground plane, unit)
	MinX: number, MaxX: number, MinZ: number, MaxZ: number, -- flat bounds (from the axes)
	Round: number?, -- radius of a round footprint (upright cylinder, ball); nil = rectangle
}
export type Grid = { Cell: number, Cells: { [string]: { Box } }, Count: number }

function PathGrid.new(cell: number?): Grid
	return { Cell = cell or 16, Cells = {}, Count = 0 }
end

local function unit(x: number, z: number): (number, number)
	local m = math.sqrt(x * x + z * z)
	if m < 1e-6 then
		return 1, 0
	end
	return x / m, z / m
end

-- A box from a centre, a size and the part's RightVector / ZVector x and z parts.
function PathGrid.box(x: number, y: number, z: number, sx: number, sy: number, sz: number, rx: number, rz: number, zx: number, zz: number): Box
	local ux, uz = unit(rx, rz)
	local vx, vz = unit(zx, zz)
	local hx, hz = sx / 2, sz / 2
	local ex = math.abs(ux) * hx + math.abs(vx) * hz
	local ez = math.abs(uz) * hx + math.abs(vz) * hz
	return {
		X = x, Y = y, Z = z, HX = hx, HY = sy / 2, HZ = hz,
		RX = ux, RZ = uz, ZX = vx, ZZ = vz,
		MinX = x - ex, MaxX = x + ex, MinZ = z - ez, MaxZ = z + ez,
	}
end

-- A round footprint (upright cylinder disc, ball) of radius r.
function PathGrid.disc(x: number, y: number, z: number, r: number, sy: number): Box
	local b = PathGrid.box(x, y, z, r * 2, sy, r * 2, 1, 0, 0, 1)
	b.Round = r
	return b
end

-- A box from a part's position, size, rotation (the 9 matrix numbers of CFrame:GetComponents, row by row) and shape
-- ("Block", "Cylinder", "Ball"; anything else is a block). Pure, so tests can feed it dumped lobby geometry.
function PathGrid.fromComponents(px: number, py: number, pz: number, sx: number, sy: number, sz: number, m: { number }, shape: string?): Box
	-- columns of the matrix: the part's right (X), up (Y) and back (Z) axes in world space
	local axes = { { m[1], m[4], m[7] }, { m[2], m[5], m[8] }, { m[3], m[6], m[9] } }
	local sizes = { sx, sy, sz }
	local h = 2
	for i = 1, 3 do
		if math.abs(axes[i][2]) > math.abs(axes[h][2]) then
			h = i
		end
	end
	if shape == "Ball" then
		return PathGrid.disc(px, py, pz, sx / 2, sx)
	end
	if shape == "Cylinder" and h == 1 then
		return PathGrid.disc(px, py, pz, math.min(sy, sz) / 2, sx)
	end
	local a = if h == 1 then 2 else 1
	local b = if h == 3 then 2 else 3
	return PathGrid.box(px, py, pz, sizes[a], sizes[h], sizes[b], axes[a][1], axes[a][3], axes[b][1], axes[b][3])
end

-- A box from a Roblox part (its CFrame, Size and shape).
function PathGrid.fromPart(part: BasePart): Box
	local px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = part.CFrame:GetComponents()
	local sz = part.Size
	local shape = if part:IsA("Part") then part.Shape.Name else nil
	return PathGrid.fromComponents(px, py, pz, sz.X, sz.Y, sz.Z, { r00, r01, r02, r10, r11, r12, r20, r21, r22 }, shape)
end

-- Spots beside a walkway strip, for props that must stand on the grass next to it: for both flat axes, both sides,
-- every `spacing` studs along the other axis. Each spot is a list of tries (nearest first) at `clear` + each of
-- `steps` studs out from the strip's side, so a stone or a joining strip at the edge pushes the prop further out.
-- A strip's run direction is not assumed (the lobby's strips are short wide slabs: 26 wide, ~3 long), so both axes are
-- tried; tries that land on the path are rejected by the caller's overlap check. Round boxes give none.
function PathGrid.sideSpots(b: Box, clear: number, spacing: number, steps: { number }): { { { number } } }
	local out = {}
	if b.Round then
		return out
	end
	for _, ax in { { b.RX, b.RZ, b.HX, b.ZX, b.ZZ, b.HZ }, { b.ZX, b.ZZ, b.HZ, b.RX, b.RZ, b.HX } } do
		local ux, uz, uh, vx, vz, vh = ax[1], ax[2], ax[3], ax[4], ax[5], ax[6]
		local len = vh * 2
		local n = math.max(1, math.floor(len / spacing))
		for i = 0, n - 1 do
			local t = -vh + (i + 0.5) * len / n
			for _, side in { -1, 1 } do
				local tries = {}
				for _, extra in steps do
					local d = side * (uh + clear + extra)
					table.insert(tries, { b.X + ux * d + vx * t, b.Z + uz * d + vz * t })
				end
				table.insert(out, tries)
			end
		end
	end
	return out
end

-- Every BasePart inside a folder or model named "Paths" (the lobby build's path layer) or with attribute
-- RainbowPath = true, as a grid. Count = 0 when the map has none.
function PathGrid.lobbyPaths(root: Instance): Grid
	local g = PathGrid.new(16)
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") and (d:GetAttribute("RainbowPath") == true or d:FindFirstAncestor("Paths") ~= nil) then
			PathGrid.add(g, PathGrid.fromPart(d))
		end
	end
	return g
end

local function key(i: number, j: number): string
	return i .. ":" .. j
end

function PathGrid.add(g: Grid, b: Box)
	local c = g.Cell
	for i = math.floor(b.MinX / c), math.floor(b.MaxX / c) do
		for j = math.floor(b.MinZ / c), math.floor(b.MaxZ / c) do
			local k = key(i, j)
			local list = g.Cells[k]
			if not list then
				list = {}
				g.Cells[k] = list
			end
			table.insert(list, b)
		end
	end
	g.Count += 1
end

-- The box under the point (x, z) (within `margin` studs of its edge) whose top is highest between y - `depth` and
-- y + `above`, or nil. `above`: how far the top may be over the point; `depth`: how far below (default: any).
function PathGrid.under(g: Grid, x: number, y: number, z: number, margin: number?, above: number?, depth: number?): Box?
	local list = g.Cells[key(math.floor(x / g.Cell), math.floor(z / g.Cell))]
	if not list then
		return nil
	end
	local m = margin or 0
	local best: Box? = nil
	for _, b in list do
		local dx, dz = x - b.X, z - b.Z
		local lx = dx * b.RX + dz * b.RZ
		local lz = dx * b.ZX + dz * b.ZZ
		local top = b.Y + b.HY
		local r = b.Round
		local inside = if r then dx * dx + dz * dz <= (r + m) * (r + m) else math.abs(lx) <= b.HX + m and math.abs(lz) <= b.HZ + m
		if inside and top <= y + (above or 0) and top >= y - (depth or math.huge) then
			if not best or top > best.Y + best.HY then
				best = b
			end
		end
	end
	return best
end

-- True when the turned box b's footprint, grown by `margin`, overlaps the flat rectangle centred (cx, cz) with half
-- sizes (ax, az): an exact 2D separating-axis test (a turned strip's bounds cover far more grass than the strip).
function PathGrid.overlapsRect(b: Box, cx: number, cz: number, ax: number, az: number, margin: number?): boolean
	local m = margin or 0
	local dx, dz = b.X - cx, b.Z - cz
	local r = b.Round
	if r then
		-- circle against the rectangle: distance from the centre to the rectangle's nearest point
		local nx = math.max(math.abs(dx) - ax, 0)
		local nz = math.max(math.abs(dz) - az, 0)
		return nx * nx + nz * nz <= (r + m) * (r + m)
	end
	local hx, hz = b.HX + m, b.HZ + m
	for _, n in { { 1, 0 }, { 0, 1 }, { b.RX, b.RZ }, { b.ZX, b.ZZ } } do
		local nx, nz = n[1], n[2]
		local ra = ax * math.abs(nx) + az * math.abs(nz)
		local rb = hx * math.abs(b.RX * nx + b.RZ * nz) + hz * math.abs(b.ZX * nx + b.ZZ * nz)
		if math.abs(dx * nx + dz * nz) > ra + rb then
			return false
		end
	end
	return true
end

-- Exact version of touches: the rectangle centred (cx, cz), half sizes (ax, az), between heights minY and maxY,
-- against every box's turned footprint grown by `margin`.
function PathGrid.touchesExact(g: Grid, cx: number, cz: number, ax: number, az: number, minY: number, maxY: number, margin: number?): Box?
	local c = g.Cell
	local m = margin or 0
	for i = math.floor((cx - ax - m) / c), math.floor((cx + ax + m) / c) do
		for j = math.floor((cz - az - m) / c), math.floor((cz + az + m) / c) do
			local list = g.Cells[key(i, j)]
			if list then
				for _, b in list do
					if b.Y - b.HY <= maxY and b.Y + b.HY >= minY and PathGrid.overlapsRect(b, cx, cz, ax, az, m) then
						return b
					end
				end
			end
		end
	end
	return nil
end

-- True when the flat rectangle [minX, maxX] x [minZ, maxZ] between heights minY and maxY touches any box's flat
-- bounds and height range (conservative: a turned box counts by its bounds).
function PathGrid.touches(g: Grid, minX: number, minZ: number, maxX: number, maxZ: number, minY: number, maxY: number): boolean
	local c = g.Cell
	for i = math.floor(minX / c), math.floor(maxX / c) do
		for j = math.floor(minZ / c), math.floor(maxZ / c) do
			local list = g.Cells[key(i, j)]
			if list then
				for _, b in list do
					if b.MinX <= maxX and b.MaxX >= minX and b.MinZ <= maxZ and b.MaxZ >= minZ and b.Y - b.HY <= maxY and b.Y + b.HY >= minY then
						return true
					end
				end
			end
		end
	end
	return false
end

export type SpotOpts = {
	Half: number, -- half size of the prop's square footprint
	Height: number, -- prop height (trim above the ground within this blocks)
	Margin: number, -- clear studs round the prop (walkways)
	Clear: number?, -- first try's distance from a strip side to the prop's centre (default Half + Margin + 0.2)
	Spacing: number, -- studs between spots along a strip side
	Steps: { number }, -- tries out from the strip side, nearest first
	Cell: number, -- no two props in one Cell x Cell square
	Max: number,
	Ground: (x: number, z: number, y: number) -> number?, -- ground height under (x, z) when it is grass, else nil
	Extra: ((x: number, y: number, z: number) -> string?)?, -- any other reason the spot is blocked (props, queries)
}

-- Where props go beside the walkways (pure: the lobby flowers use it; tests run it on dumped lobby geometry). A try is
-- rejected when it is not grass, its footprint (+ Margin) overlaps a walkway (any height), it overlaps trim (edge
-- stones, curbs, tufts: no margin, from just below the ground to Height above), Extra blocks it, or a prop already
-- stands in its Cell square. Walkways are visited in a fixed shuffled order so the props spread over the whole lobby.
-- Returns the spots ({x, y, z}) and counts per reason (the last reason tried per spot).
function PathGrid.spots(walkways: { Box }, paths: Grid, trim: Grid, o: SpotOpts): ({ { number } }, { [string]: number })
	local stats: { [string]: number } = { samples = 0, tries = 0, notGrass = 0, path = 0, trim = 0, solid = 0, query = 0, spaced = 0, placed = 0 }
	local order = table.clone(walkways)
	local seed = 20261015
	for i = #order, 2, -1 do
		seed = (seed * 48271) % 2147483647
		local j = seed % i + 1
		order[i], order[j] = order[j], order[i]
	end
	local taken: { [string]: boolean } = {}
	local out: { { number } } = {}
	local clear = o.Clear or (o.Half + o.Margin + 0.2)
	local function cellKey(x: number, z: number): string
		return math.floor(x / o.Cell) .. ":" .. math.floor(z / o.Cell)
	end
	for _, w in order do
		if #out >= o.Max then
			break
		end
		for _, tries in PathGrid.sideSpots(w, clear, o.Spacing, o.Steps) do
			if #out >= o.Max then
				break
			end
			stats.samples += 1
			local why = "notGrass"
			local spot: { number }? = nil
			for _, at in tries do
				stats.tries += 1
				local x, z = at[1], at[2]
				local y = o.Ground(x, z, w.Y)
				if not y then
					why = "notGrass"
					continue
				end
				if taken[cellKey(x, z)] then
					why = "spaced"
					continue
				end
				if PathGrid.touchesExact(paths, x, z, o.Half, o.Half, -math.huge, math.huge, o.Margin) then
					why = "path"
					continue
				end
				if PathGrid.touchesExact(trim, x, z, o.Half, o.Half, y - 1, y + o.Height, 0) then
					why = "trim"
					continue
				end
				local extra = if o.Extra then o.Extra(x, y, z) else nil
				if extra then
					why = extra
					continue
				end
				spot = { x, y, z }
				break
			end
			if spot then
				taken[cellKey(spot[1], spot[3])] = true
				table.insert(out, spot)
				stats.placed += 1
			else
				stats[why] = (stats[why] or 0) + 1
			end
		end
	end
	return out, stats
end

return PathGrid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="165">
        <Properties>
          <string name="Name">PetClips</string>
          <string name="Source"><![CDATA[--!nonstrict
-- (nonstrict: a data table whose keys hold different channel sets)
-- Shared pet clips (one table for every rig: Body/Head/Tail/LegL/LegR/LegBL/LegBR/WingL/WingR/Arms; no Jaw, no mouth,
-- no roar). Played by PetMotion through PetPose. Root channels rootY/rootZ are studs for a 2.4-stud pet; PetPose scales
-- them by the pet's height. Started from carter's pets\pet_clips.py (Blender-checked previews); edit here now.
local Clips: { [string]: any } = {
	idle = { loop = true, dur = 2.4, keys = {
		{ t = 0.0, rootY = 0.0, rootP = 0.0, tailY = 0.3, tailP = 0.05, headY = 0.35, headP = 0.06, wing = 0.0 },
		{ t = 0.6, rootY = 0.06, rootP = -0.03, tailY = 0.05, tailP = -0.08, headY = 0.2, headP = -0.08, wing = 0.15 },
		{ t = 1.2, rootY = 0.0, rootP = 0.0, tailY = -0.3, tailP = 0.05, headY = -0.35, headP = 0.06, headR = 0.12, wing = 0.0 },
		{ t = 1.8, rootY = 0.06, rootP = -0.03, tailY = -0.05, tailP = -0.08, headY = -0.15, headP = -0.08, wing = 0.15 },
		{ t = 2.4, rootY = 0.0, rootP = 0.0, tailY = 0.3, tailP = 0.05, headY = 0.35, headP = 0.06, wing = 0.0 },
	} },
	walk = { loop = true, dur = 0.8, keys = {
		{ t = 0.0, legFL = -0.44, legBR = -0.44, legFR = 0.44, legBL = 0.44, rootY = 0.0, rootR = 0.16, rootP = 0.1, tailY = 0.6, headP = 0.14, wing = -0.18 },
		{ t = 0.2, rootY = 0.28, rootP = 0.0, tailY = 0.0, headP = -0.16, wing = -0.08 },
		{ t = 0.4, legFL = 0.44, legBR = 0.44, legFR = -0.44, legBL = -0.44, rootY = 0.0, rootR = -0.16, rootP = 0.1, tailY = -0.6, headP = 0.14, wing = -0.18 },
		{ t = 0.6, rootY = 0.28, rootP = 0.0, tailY = 0.0, headP = -0.16, wing = -0.08 },
		{ t = 0.8, legFL = -0.44, legBR = -0.44, legFR = 0.44, legBL = 0.44, rootY = 0.0, rootR = 0.16, rootP = 0.1, tailY = 0.6, headP = 0.14, wing = -0.18 },
	} },
	run = { loop = true, dur = 0.56, keys = {
		{ t = 0.0, legFL = 0.4, legFR = 0.4, legBL = -0.4, legBR = -0.4, rootY = 0.0, rootP = 0.14, tailP = -0.15, headP = -0.06, wing = -0.25 },
		{ t = 0.1, legFL = 0.1, legFR = 0.1, legBL = -0.1, legBR = -0.1, rootY = 0.3, rootP = 0.0, tailP = -0.3, wing = -0.2 },
		{ t = 0.2, legFL = -0.45, legFR = -0.45, legBL = 0.45, legBR = 0.45, rootY = 0.55, rootP = -0.18, tailP = -0.4, tailY = 0.1, headP = 0.1, wing = -0.3 },
		{ t = 0.32, legFL = -0.45, legFR = -0.45, legBL = 0.45, legBR = 0.45, rootY = 0.4, rootP = -0.08, tailP = -0.38, headP = 0.08, wing = -0.28 },
		{ t = 0.44, legFL = 0.2, legFR = 0.2, legBL = -0.2, legBR = -0.2, rootY = 0.08, rootP = 0.12, tailP = -0.22, tailY = -0.1, headP = -0.04, wing = -0.25 },
		{ t = 0.56, legFL = 0.4, legFR = 0.4, legBL = -0.4, legBR = -0.4, rootY = 0.0, rootP = 0.14, tailP = -0.15, headP = -0.06, wing = -0.25 },
	} },
	train = { loop = true, dur = 1.6, keys = {
		{ t = 0.0 },
		{ t = 0.22, rootY = -0.32, rootP = 0.32, legFL = -0.42, legFR = -0.42, headP = -0.25, wing = -0.25, tailP = -0.25 },
		{ t = 0.42, rootY = -0.34, rootP = 0.34, legFL = -0.44, legFR = -0.44, headP = -0.28, wing = -0.28, tailP = -0.28 },
		{ t = 0.62, rootY = 0.0, rootP = 0.0, wing = 0.1 },
		{ t = 0.78, rootY = -0.2, rootP = 0.06, legFL = 0.3, legFR = 0.3, legBL = 0.3, legBR = 0.3, wing = -0.15, tailP = 0.15 },
		{ t = 0.98, rootY = 0.75, rootP = -0.1, legFL = -0.35, legFR = -0.35, legBL = -0.35, legBR = -0.35, wing = 0.55, tailP = -0.35, headP = -0.18 },
		{ t = 1.14, rootY = 0.8, rootP = -0.06, legFL = -0.3, legFR = -0.3, legBL = -0.3, legBR = -0.3, wing = 0.2, tailP = -0.3, headP = -0.15 },
		{ t = 1.32, rootY = -0.12, rootP = 0.06, legFL = 0.25, legFR = 0.25, legBL = 0.25, legBR = 0.25, wing = 0.0, tailP = 0.15 },
		{ t = 1.6 },
	} },
	attack = { loop = false, dur = 0.85, keys = {
		{ t = 0.0 },
		{ t = 0.38, rootY = -0.16, rootZ = -0.7, rootP = -0.22, legFL = 0.3, legFR = 0.3, legBL = 0.3, legBR = 0.3, headP = -0.22, tailP = -0.3, wing = 0.4 },
		{ t = 0.48, rootY = 0.1, rootZ = 2.6, rootP = 0.1, legFL = -0.44, legFR = -0.44, legBL = 0.4, legBR = 0.4, headP = -0.12, tailP = -0.1, wing = 0.65 },
		{ t = 0.6, rootY = 0.04, rootZ = 2.4, rootP = 0.06, legFL = -0.35, legFR = -0.35, legBL = 0.3, legBR = 0.3, headP = -0.08, tailP = -0.08, wing = 0.4 },
		{ t = 0.85 },
	} },
	hit = { loop = false, dur = 0.55, keys = {
		{ t = 0.0 },
		{ t = 0.07, rootY = -0.3, rootZ = -2.2, rootP = -0.4, rootYaw = 0.2, rootR = 0.1, headP = -0.35, headY = -0.22, legFL = 0.3, legFR = 0.3, tailP = 0.25, wing = 0.45 },
		{ t = 0.22, rootY = -0.24, rootZ = -2.1, rootP = -0.36, rootYaw = -0.06, rootR = -0.05, headP = -0.12, headY = 0.1, tailP = 0.1, wing = 0.12 },
		{ t = 0.4, rootY = -0.08, rootZ = -0.9, rootP = -0.1, rootYaw = 0.02, headP = -0.03 },
