      <Item class="ModuleScript" referent="172">
        <Properties>
          <string name="Name">PetSoundIds</string>
          <string name="Source"><![CDATA[--!strict
-- Sound ids for Find The Pet (list and sources: /mnt/project-files/audio/sound-list.md).
-- 0 = not picked yet: the client Audio module skips a 0 id. Never put guessed ids here.
-- Sounds already uploaded (SoundIds, generated) are reused by reference; sounds made by
-- tools/synth_pet_sfx.py read their id from SoundIds once tools/upload_audio.py has uploaded them.
local SoundIds = require(script.Parent.SoundIds)

local PetSoundIds: { [string]: number } = {
	-- Music (REPLACE: Roblox licensed tracks from the Creator Store)
	LobbyMusic = 140660383888658, -- "Sun on the Porch" (APM, licensed); picked in Studio (sound-picks.md)
	RaceMusic = 1837560399, -- "High Energy" (APM, licensed); picked in Studio (sound-picks.md)

	-- Eggs
	EggTap = SoundIds.EggTap or 9113959071, -- "Crack Egg Crunchy 6" (Pro Sound Effects, licensed) until the synth tap is uploaded
	EggBreak = SoundIds.EggBreak or 9113959343, -- "Crack Egg Crunchy 11" (Pro Sound Effects, licensed) until the synth break is uploaded
	EggChirp = SoundIds.EggChirp or 9117236949, -- "Parakeet Chirps 7" (Pro Sound Effects, licensed) until the synth chirp is uploaded
	EggPickup = SoundIds.Pickup,

	-- Hatching
	HatchBuildUp = 87681931953984, -- "Vast Horizon - Sting" (APM, licensed); picked in Studio (sound-picks.md)
	HatchWin = SoundIds.MatchWin,
	RareSparkle = SoundIds.RarityAccent,

	-- Lobby, shop, HUD
	CoinPickup = SoundIds.CoinPickup or 1169806635, -- "Coin Collect 2 - SFX" (public, free to use) until the synth coin is uploaded
	SpeedBoots = SoundIds.SpeedBoots or 0, -- made by tools/synth_pet_sfx.py; 0 until uploaded
	UIClick = SoundIds.Button,
	Purchase = SoundIds.Purchase,
	Countdown = SoundIds.CountdownTick,

	-- Tower
	TowerHit = SoundIds.TowerHit or 0, -- made by tools/synth_pet_sfx.py; 0 until uploaded
	TowerSpecial = SoundIds.TowerSpecial or 0, -- made by tools/synth_pet_sfx.py; 0 until uploaded

	-- Find The Pet moments (Item 20): made by tools/synth_pet_sfx.py, 0 until tools/upload_audio.py uploads them.
	-- While a key is 0 the client plays its stand-in from shared/SoundCues.Fallback (or nothing). Moment map: SoundCues.
	-- Pets never roar (owner rule): big hatches use HatchSparkle (swell) and HatchDrum (drum hit).
	HatchSparkle = SoundIds.HatchSparkle or 0,
	HatchDrum = SoundIds.HatchDrum or 0,
	PetFound = SoundIds.PetFound or 0,
	EggGrab = SoundIds.EggGrab or 0,
	EggDrop = SoundIds.EggDrop or 0,
	BattleMatched = SoundIds.BattleMatched or 0,
	PetCrit = SoundIds.PetCrit or 0,
	PetKO = SoundIds.PetKO or 0,
	BattleWin = SoundIds.BattleWin or 0,
	BattleLose = SoundIds.BattleLose or 0,
	TrainTap = SoundIds.TrainTap or 0,
	LevelUp = SoundIds.LevelUp or 0,
	Evolve = SoundIds.Evolve or 0,
	FloorClear = SoundIds.FloorClear or 0,
	DailyClaim = SoundIds.DailyClaim or 0,
	GiftOpen = SoundIds.GiftOpen or 0,
	QuestDone = SoundIds.QuestDone or 0,
	LuckyMeter = SoundIds.LuckyMeter or 0,
	Denied = SoundIds.Denied or 0,
}

return PetSoundIds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="173">
        <Properties>
          <string name="Name">PetStatView</string>
          <string name="Source"><![CDATA[--!strict
-- What a pet's stats MEAN, in plain words for young players (pure, tested in tests/test_pet_stat_view.luau).
-- Display only: every number comes from the same rules the server uses (PetStats.roll for the Pet Tower stats,
-- PetRules.boost x Config.Pets.KindScale for the hunt bonus). Nothing here changes how a pet plays.
--
-- carter's pick (2026-10-14): ONE "bigger = better" POWER number per pet (PetStatView.power), on every pet card, the
-- Pet Book detail and the Pet Tower picker, with a green up / red down arrow against the pet that follows you.
-- POWER folds attack, health and attack speed (rarity, Golden / Rainbow and level all raise them) with the weights
-- PvP (PvpRules.petPower) and the tower team pick (TowerService.score) use. Everything else
-- (the hunt bonus, attack, health, speed, type, moves, level, grade, multipliers) is behind MORE (PetStatView.more).
-- New stats (a ride speed, for example) go in as one more `Line` in PetStatView.more.

local Config = require(script.Parent.Config)
local TowerConfig = require(script.Parent.TowerConfig)
local PetStats = require(script.Parent.PetStats)
local PetRules = require(script.Parent.PetRules)

local PetStatView = {}

export type Line = { Icon: string, Head: string, Text: string }

PetStatView.KindIcon = { Coins = "boostCoins", Speed = "boostSpeed", Luck = "boostLuck" } :: { [string]: string }
-- what the bonus does, in a few words (Config.Minerals BoostKind comment)
PetStatView.KindWord = { Coins = "coins", Speed = "run speed", Luck = "luck" } :: { [string]: string }
-- the bonus tile's one-word label
PetStatView.KindShort = { Coins = "coins", Speed = "speed", Luck = "luck" } :: { [string]: string }
PetStatView.KindDoes = {
	Coins = "you get more coins for candy",
	Speed = "you run faster in hunts",
	Luck = "you hatch rarer pets more often",
} :: { [string]: string }

-- The hunt bonus this pet really gives while it follows you: kind and fraction (after KindScale and the cap, the
-- same maths as Profiles.petBoosts for one pet). The old Pet Book line showed it before KindScale.
function PetStatView.bonus(g: { [string]: any }): (string, number)
	local kind = PetRules.kindOf(g)
	local scale = (Config.Pets.KindScale :: any)[kind] or 1
	local cap = (Config.Pets.KindCap :: any)[kind] or 1
	local amt = math.clamp(PetRules.boost(g) * scale, 0, cap)
	return kind, math.floor(amt * 1000 + 0.5) / 1000
end

local function pct(f: number): string
	local p = f * 100
	-- whole percents, except small Speed bonuses (+3.2%) that would all round to the same number
	if p < 10 and math.abs(p - math.floor(p + 0.5)) > 0.05 then
		return string.format("+%.1f%%", p)
	end
	return "+" .. math.floor(p + 0.5) .. "%"
end
PetStatView.pct = pct

-- A pet needs Seed for its tower stats (GeodeGen.public and the tower roster both carry it). Without one only the
-- bonus is known.
local function tower(g: { [string]: any }): PetStats.Stats?
	if type(g.Seed) ~= "number" or type(g.Mineral) ~= "string" or type(g.Rarity) ~= "string" then
		return nil
	end
	return PetStats.roll(g :: any, if type(g.TowerXP) == "number" then g.TowerXP else nil)
end
PetStatView.tower = tower

-- The POWER number from rolled tower stats (PetStats.power: one formula for the whole game).
function PetStatView.powerOf(s: { Power: number, Health: number, Speed: number }): number
	return PetStats.power(s)
end

-- A pet's POWER (nil without a Seed: very old or partial data).
function PetStatView.power(g: { [string]: any }): number?
	local s = tower(g)
	return if s then PetStatView.powerOf(s) else nil
end

-- +1 when `g` is stronger than `other` (the pet that follows you), -1 weaker, 0 same, the same pet, or unknown.
function PetStatView.compare(g: { [string]: any }, other: { [string]: any }?): number
	if other == nil or (other.Id ~= nil and other.Id == g.Id) then
		return 0
	end
	local a, b = PetStatView.power(g), PetStatView.power(other)
	if a == nil or b == nil or a == b then
		return 0
	end
	return if a > b then 1 else -1
end

-- "Lv 7/20": level and its rarity cap (PetStats.cap: Common 10 ... Legendary 50, Void Dragon 100).
-- At the cap it says MAX (Studio 2026-10-16: a maxed pet showed only "Lv 50/50", and with evolve off nothing else
-- told the player the pet was done training).
function PetStatView.levelText(level: number, cap: number): string
	-- "Lv 50 MAX", not "Lv 50/50 MAX": the same width as "Lv 50/50", so pills and rows sized for it still fit
	return if level >= cap then "Lv " .. level .. " MAX" else "Lv " .. level .. "/" .. cap
end

-- A pet's level and cap (level from TowerXP, as PetRules.level).
function PetStatView.levelOf(g: { [string]: any }): (number, number)
	return PetRules.level(g), PetStats.cap(g :: any)
end

-- Short hunt bonus text for the facts line ("+3.2% speed").
function PetStatView.bonusText(g: { [string]: any }): string
	local kind, amt = PetStatView.bonus(g)
	return pct(amt) .. " " .. (PetStatView.KindShort[kind] or "coins")
end

local function times(x: number): string
	if x == math.floor(x) then
		return "x" .. tostring(x)
	end
	local t = string.gsub(string.format("%.2f", x), "0$", "")
	return "x" .. t
end
PetStatView.times = times

local GRADE_WORD = { S = "super lucky", A = "great", B = "good", C = "okay" }

-- Every stat in one plain sentence each (the MORE page). Order: what it does for you first, battle stats next,
-- then where the numbers come from.
function PetStatView.more(g: { [string]: any }): { Line }
	local lines: { Line } = {}
	local kind, amt = PetStatView.bonus(g)
	local cap = (Config.Pets.KindCap :: any)[kind] or 1
	table.insert(lines, {
		Icon = PetStatView.KindIcon[kind] or "boostCoins",
		Head = pct(amt) .. " " .. (PetStatView.KindWord[kind] or "coins"),
		Text = "When it follows you, " .. (PetStatView.KindDoes[kind] or "") .. ". Max " .. pct(cap) .. " from all pets.",
	})
	local s = tower(g)
	if s then
		table.insert(lines, 1, { Icon = "statPower", Head = "POWER " .. PetStatView.powerOf(s), Text = "Bigger = better. Attack, health and speed together." })
		table.insert(lines, { Icon = "statAttack", Head = "Attack " .. s.Power, Text = "How hard it hits in the Pet Tower." })
		table.insert(lines, { Icon = "statHealth", Head = "Health " .. s.Health, Text = "How many hits it can take." })
		table.insert(lines, { Icon = "statSpeed", Head = "Attack speed " .. s.Speed, Text = "Higher attacks more often." })
		local circle = TowerConfig.TypeCircle
		local i = table.find(circle, s.Element)
		local typeText = if s.Element == "Cosmic"
			then "Strong against every other type."
			elseif i then "Strong vs " .. circle[i % #circle + 1] .. ", weak vs " .. circle[(i - 2) % #circle + 1] .. "."
			else ""
		table.insert(lines, { Icon = "sparkle", Head = s.Element .. " type", Text = typeText })
		local sp = PetStats.special(s.Special)
		table.insert(lines, { Icon = "hammer", Head = "Moves", Text = s.Basic .. ", " .. s.Move .. ", and special " .. (if sp then sp.Name else s.Special) .. "." })
		local top = PetStats.cap(g :: any)
		table.insert(lines, {
			Icon = "trophy",
			Head = "Level " .. s.Level .. " of " .. top .. (if s.Level >= top then " (MAX)" else ""),
			Text = "Fights level it up (+" .. math.floor(TowerConfig.Levels.LevelStat * 100 + 0.5) .. "% Attack and Health each). Rarer pets can grow higher.",
		})
		table.insert(lines, { Icon = "star", Head = "Grade " .. s.Grade, Text = "Its hatch roll was " .. (GRADE_WORD[s.Grade] or "okay") .. ". S is best, C is lowest." })
	end
	local rarityX = (TowerConfig.RarityStat :: any)[g.Rarity] or 1
	table.insert(lines, {
		Icon = "gem",
		Head = tostring(g.Rarity),
		Text = (if rarityX > 1 then times(rarityX) .. " Attack and Health, " else "") .. "rarer pets give a bigger bonus.",
	})
	local mod = g.Modifier
	if type(mod) == "string" and mod ~= "Natural" then
		local vx = (TowerConfig.VariantStat :: any)[mod] or 1
		table.insert(lines, {
			Icon = "sparkle",
			Head = (Config.ModifierNames :: any)[mod] or mod,
			Text = times(vx) .. " Attack and Health, sells for " .. times((Config.ModifierMult :: any)[mod] or 1) .. " coins.",
		})
	end
	return lines
end

-- Short variant tag for the header ("Golden x1.5"), nil for a plain pet.
function PetStatView.variantTag(g: { [string]: any }): string?
	local mod = g.Modifier
	if type(mod) ~= "string" or mod == "Natural" then
		return nil
	end
	return ((Config.ModifierNames :: any)[mod] or mod) .. " " .. times((TowerConfig.VariantStat :: any)[mod] or 1)
end

return PetStatView
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="174">
        <Properties>
          <string name="Name">PetStats</string>
          <string name="Source"><![CDATA[--!strict
-- Tower stats for one pet copy (pure, tested in tests/test_pet_tower.luau).
-- Stats come from the pet's secret server-rolled Seed, so every pet already has them and nothing new is saved.
-- Same pet in, same stats out, on every server.

local TowerConfig = require(script.Parent.TowerConfig)

local PetStats = {}

export type Stats = {
	Power: number,
	Health: number,
	Speed: number,
	Grade: string,
	Level: number,
	Quality: number, -- 0..1, how good the three rolls were
	Element: string, -- Pokemon-style type
	Basic: string,
	Move: string, -- second attack, of the pet's own type
	MoveMult: number,
	MoveSlow: number,
	Special: string, -- TowerConfig.Specials Id
}

-- Evolve stage of a pet copy (0 = never evolved), always a whole number in 0..TowerConfig.Evolve.MaxStage.
function PetStats.stage(pet: any): number
	local e = if type(pet) == "table" then tonumber(pet.Evolve) else nil
	if not e or e ~= e then
		return 0
	end
	return math.clamp(math.floor(e), 0, TowerConfig.Evolve.MaxStage)
end

-- Highest level a pet can train to: its rarity's cap (TowerConfig.LevelCaps), or its species' own (Void Dragon),
-- plus TowerConfig.Evolve.CapBonus per evolve stage.
function PetStats.cap(pet: { Mineral: string?, Rarity: string? }?): number
	local L = TowerConfig.Levels
	if pet == nil then
		return L.Max
	end
	local c = (pet.Mineral and TowerConfig.CapSpecies[pet.Mineral]) or (pet.Rarity and TowerConfig.LevelCaps[pet.Rarity]) or L.Max
	return math.clamp(c + PetStats.stage(pet) * TowerConfig.Evolve.CapBonus, 1, L.Max)
end

-- Level from saved tower XP: (level, xp into this level, xp needed for the next). `cap` (PetStats.cap) stops the
-- climb: at the cap the last two are 0 (XP past it is kept but does nothing).
function PetStats.level(xp: number?, cap: number?): (number, number, number)
	local L = TowerConfig.Levels
	local top = math.clamp(cap or L.Max, 1, L.Max)
	local left = math.max(math.floor(tonumber(xp) or 0), 0)
	local level = 1
	while level < top do
		local need = L.XpBase + L.XpStep * (level - 1)
		if left < need then
			return level, left, need
		end
		left -= need
		level += 1
	end
	return top, 0, 0
end

-- Total XP from level 1 to reach `level` (dev /maxpet, tests).
function PetStats.xpForLevel(level: number): number
	local L = TowerConfig.Levels
	local total = 0
	for l = 1, math.clamp(math.floor(level), 1, L.Max) - 1 do
		total += L.XpBase + L.XpStep * (l - 1)
	end
	return total
end

-- Damage multiplier for an attack of type `att` hitting type `def`.
function PetStats.effect(att: string, def: string): number
	if att == "Cosmic" then
		return if def == "Cosmic" then 1 else TowerConfig.CosmicBonus
	end
	local circle = TowerConfig.TypeCircle
	local n = #circle
	for i, e in circle do
		if e == att then
			if circle[i % n + 1] == def then
				return TowerConfig.Strong
			elseif circle[(i - 2) % n + 1] == def then
				return TowerConfig.Weak
			end
		end
	end
	return 1
end

-- Small integer hash stream (deterministic and identical everywhere, unlike Random across platforms).
local function stream(seed: number)
	local s = (math.floor(seed) % 2147483646) + 1
	return function(): number
		s = (s * 48271) % 2147483647
		return s / 2147483647
	end
end

local function rarityIndex(rarity: string): number
	for i, r in TowerConfig.Rarities do
		if r == rarity then
			return i
		end
	end
	return 1
end

function PetStats.grade(quality: number): string
	for _, g in TowerConfig.Grades do
		if quality >= g.Min then
			return g.Grade
		end
	end
	return "C"
end

-- `pet` needs Mineral (species), Rarity, Modifier (variant) and Seed, i.e. a GeodeGen Specimen.
function PetStats.roll(pet: { Mineral: string, Rarity: string, Modifier: string?, Seed: number }, xp: number?): Stats
	local base = TowerConfig.Species[pet.Mineral] or TowerConfig.DefaultSpecies
	local nextNum = stream(pet.Seed)
	for _ = 1, 4 do -- decorrelate nearby seeds
		nextNum()
	end
	local span = TowerConfig.RollMax - TowerConfig.RollMin
	local rolls = {}
	local sum = 0
	for i = 1, 3 do
		rolls[i] = TowerConfig.RollMin + nextNum() * span
		sum += rolls[i]
	end
	local quality = math.clamp((sum / 3 - TowerConfig.RollMin) / span, 0, 1)
	local level = PetStats.level(xp, PetStats.cap(pet))
	local grow = 1 + TowerConfig.Levels.LevelStat * (level - 1)
	local mult = (TowerConfig.RarityStat[pet.Rarity] or 1) * (TowerConfig.VariantStat[pet.Modifier or "Natural"] or 1)
		* (1 + TowerConfig.Evolve.StatBonus * PetStats.stage(pet))

	local tier = rarityIndex(pet.Rarity)
	local pool = {}
	-- Only specials of the pet's own type (or of no type). If none is open at this rarity (Common Cosmic), the
	-- lowest-rarity matching one is used.
	local fallback: TowerConfig.Special? = nil
	for _, sp in TowerConfig.Specials do
		if sp.Element == nil or sp.Element == base.Element then
			if sp.MinRarity <= tier then
				table.insert(pool, sp.Id)
			end
			if fallback == nil or sp.MinRarity < fallback.MinRarity then
				fallback = sp
			end
		end
	end
	if #pool == 0 then
		table.insert(pool, if fallback then fallback.Id else TowerConfig.Specials[1].Id)
	end
	local special = pool[math.clamp(math.floor(nextNum() * #pool) + 1, 1, #pool)]
	-- Rarer pets can roll stronger type moves: Common gets the first, Uncommon up to the second, Rare+ any.
	local moves = TowerConfig.TypeMoves[base.Element] or TowerConfig.TypeMoves.Earth
	local reach = math.min(#moves, tier)
	local move = moves[math.clamp(math.floor(nextNum() * reach) + 1, 1, reach)]

	return {
		Power = math.floor(base.Power * rolls[1] * mult * grow + 0.5),
		Health = math.floor(base.Health * rolls[2] * mult * grow + 0.5),
		-- speed grows gently so fights stay readable
		Speed = math.floor(base.Speed * rolls[3] * mult ^ 0.25 * (1 + (grow - 1) / 4) + 0.5),
		Grade = PetStats.grade(quality),
		Level = level,
		Quality = quality,
		Element = base.Element,
		Basic = base.Basic,
		Move = move.Name,
		MoveMult = move.Mult,
		MoveSlow = move.Slow,
		Special = special,
	}
end

-- THE one "bigger = better" POWER number players see (Pet Book, Pet Tower, hatch reveal, Equip Best; PvP should use it
-- too): attack counts most. Rarity, Golden / Rainbow and level are already inside the rolled stats.
function PetStats.power(s: { Power: number, Health: number, Speed: number }): number
	return math.floor(s.Power * 3 + s.Health * 0.5 + s.Speed * 0.2 + 0.5)
end

-- A pet's POWER (0 without a Seed). `xp` defaults to the pet's own TowerXP (the public view carries it).
function PetStats.powerOfPet(pet: { [string]: any }, xp: number?): number
	if type(pet.Seed) ~= "number" or type(pet.Mineral) ~= "string" or type(pet.Rarity) ~= "string" then
		return 0
	end
	local x = xp or (if type(pet.TowerXP) == "number" then pet.TowerXP else nil)
	return PetStats.power(PetStats.roll(pet :: any, x))
end

function PetStats.special(id: string): TowerConfig.Special?
	for _, sp in TowerConfig.Specials do
		if sp.Id == id then
			return sp
		end
	end
	return nil
end

return PetStats
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="175">
        <Properties>
          <string name="Name">Pile</string>
          <string name="Source"><![CDATA[--!strict
-- Deterministic rock pile. Server and clients build the same layout from (rock count, rock
-- size, radius, seed), then apply the same removals, so only rock ids travel over the network.
-- The server picks a fresh seed every round (MatchService), so the mound turns, its peak shifts and the
-- ids land in different slots each round; the seed is public, the target id never is.
--
-- The mound is a set of columns on a hex grid. Each column is a stack of rocks (bottom first).
-- A rock is exposed when it is the top of its column, or when a neighbouring column is lower
-- than it (its side is open). Removing a rock lets the rocks above it settle down one slot.
-- Edge columns are open on the outside, so every rock is eventually reachable; nothing sits
-- under the floor.

local Pile = {}
Pile.__index = Pile

export type Rock = {
	Id: number,
	Column: number,
	Jitter: Vector3, -- small xz offset
	Rot: Vector3, -- euler degrees for the shell
	Scale: number, -- 0.85..1.15
	Shape: number, -- 1..4 shell variant
}

export type Column = {
	Pos: Vector2, -- xz relative to pile centre
	Neighbors: { number },
	OpenEdge: boolean,
	Stack: { number }, -- remaining rock ids, bottom first
}

export type Pile = typeof(setmetatable(
	{} :: {
		RockSize: number,
		Layer: number,
		Rocks: { Rock },
		Columns: { Column },
		Removed: { [number]: boolean },
		Remaining: number,
		Total: number,
	},
	Pile
))

local SQRT3 = math.sqrt(3)

function Pile.new(count: number, rockSize: number, radius: number, seed: number): Pile
	local rng = Random.new(seed)
	local s = rockSize
	-- Per-round variety (all from `seed`, so server and clients agree): the whole grid turns by a random
	-- angle, the dome's peak sits off centre, and egg ids are dealt to slots in a shuffled order.
	local turn = rng:NextNumber(0, math.pi * 2)
	local cosT, sinT = math.cos(turn), math.sin(turn)
	-- Shrink the footprint for small piles so short columns stay together.
	local wanted = math.max(1, math.ceil(count / 2.2))
	local rEff = math.min(radius, s * math.sqrt(wanted / 3.4) + s * 0.5)

	-- Hex grid points inside the circle.
	local cols: { Column } = {}
	local index: { [string]: number } = {}
	local n = math.ceil(rEff / s) + 1
	for q = -n * 2, n * 2 do
		for r = -n * 2, n * 2 do
			local x = s * (q + r / 2)
			local z = s * (SQRT3 / 2) * r
			if x * x + z * z <= rEff * rEff then
				local pos = Vector2.new(x * cosT - z * sinT, x * sinT + z * cosT)
				table.insert(cols, { Pos = pos, Neighbors = {}, OpenEdge = false, Stack = {} })
				index[q .. ":" .. r] = #cols
			end
		end
	end
	if #cols == 0 then
		table.insert(cols, { Pos = Vector2.zero, Neighbors = {}, OpenEdge = true, Stack = {} })
		index["0:0"] = 1
	end
	-- Neighbours (6 hex directions); a missing neighbour means the side faces open ground.
	local dirs = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 }, { 1, -1 }, { -1, 1 } }
	for key, ci in index do
		local q, r = string.match(key, "^(-?%d+):(-?%d+)$")
		local qi, ri = tonumber(q) :: number, tonumber(r) :: number
		local col = cols[ci]
		for _, d in dirs do
			local nb = index[(qi + d[1]) .. ":" .. (ri + d[2])]
			if nb then
				table.insert(col.Neighbors, nb)
			else
				col.OpenEdge = true
			end
		end
		table.sort(col.Neighbors)
	end

	-- Dome heights: weight by distance from centre, then hand out exactly `count` rocks.
	local peakAngle = rng:NextNumber(0, math.pi * 2)
	local peakDist = rng:NextNumber(0, 0.25) * rEff
	local peak = Vector2.new(math.cos(peakAngle), math.sin(peakAngle)) * peakDist
	local weights = {}
	local sum = 0
	for i, c in cols do
		local d = (c.Pos - peak).Magnitude / math.max(rEff, 1)
		local w = 0.1 + math.max(0, 1 - d * d) ^ 1.4 -- wide base, tapered peak
		weights[i] = w
		sum += w
	end
	local heights = {}
	local given = 0
	for i in cols do
		heights[i] = math.floor(count * weights[i] / sum)
		given += heights[i]
	end
	-- Remainder to the most central columns, deterministic order.
	local order = {}
	for i in cols do
		order[i] = i
	end
	table.sort(order, function(a, b)
		if weights[a] ~= weights[b] then
			return weights[a] > weights[b]
		end
		return a < b
	end)
	local k = 1
	while given < count do
		local ci = order[((k - 1) % #order) + 1]
		heights[ci] += 1
		given += 1
		k += 1
	end

	-- Shuffled id deal (Fisher-Yates): slot j (column order, bottom to top) gets id perm[j].
	local perm = table.create(count)
	for i = 1, count do
		perm[i] = i
	end
	for i = count, 2, -1 do
		local j = rng:NextInteger(1, i)
		perm[i], perm[j] = perm[j], perm[i]
	end
	local rocks: { Rock } = table.create(count)
	local slot = 0
	for ci, c in cols do
		for _ = 1, heights[ci] do
			slot += 1
			local id = perm[slot]
			rocks[id] = {
				Id = id,
				Column = ci,
				Jitter = Vector3.new(rng:NextNumber(-0.12, 0.12) * s, 0, rng:NextNumber(-0.12, 0.12) * s),
				Rot = Vector3.new(rng:NextNumber(-25, 25), rng:NextNumber(0, 360), rng:NextNumber(-25, 25)),
				Scale = rng:NextNumber(0.85, 1.15),
				Shape = rng:NextInteger(1, 4),
			}
			table.insert(c.Stack, id)
		end
	end

	return setmetatable({
		RockSize = s,
		Layer = s * 0.62,
		Rocks = rocks,
		Columns = cols,
		Removed = {},
		Remaining = count,
		Total = count,
	}, Pile)
end

function Pile.levelOf(self: Pile, id: number): number?
	local rock = self.Rocks[id]
	if not rock or self.Removed[id] then
		return nil
	end
	local stack = self.Columns[rock.Column].Stack
	for i, rid in stack do
		if rid == id then
			return i
		end
	end
	return nil
end

function Pile.isExposed(self: Pile, id: number): boolean
	local level = self:levelOf(id)
	if not level then
		return false
	end
	local col = self.Columns[self.Rocks[id].Column]
	if level == #col.Stack or col.OpenEdge then
		return true
	end
	for _, nb in col.Neighbors do
		if #self.Columns[nb].Stack < level then
			return true
		end
	end
	return false
end

-- Local position of a rock's centre relative to the pile centre on the floor.
function Pile.localPosition(self: Pile, id: number): Vector3?
	local level = self:levelOf(id)
	if not level then
		return nil
	end
	local rock = self.Rocks[id]
	local col = self.Columns[rock.Column]
	return Vector3.new(col.Pos.X, (level - 0.5) * self.Layer, col.Pos.Y) + rock.Jitter
end

-- Removes a rock. Returns the column index so callers can refresh it and its neighbours.
function Pile.remove(self: Pile, id: number): number?
	local level = self:levelOf(id)
	if not level then
		return nil
	end
	local rock = self.Rocks[id]
	table.remove(self.Columns[rock.Column].Stack, level)
	self.Removed[id] = true
	self.Remaining -= 1
	return rock.Column
end

-- V3 loop: a rock can be picked up when it is exposed AND low enough to reach from the mound
-- perimeter without climbing (its layer is at most maxLevel). The bottom rock of any column that
-- touches empty ground is always exposed, so the pile can never get stuck.
function Pile.isPickable(self: Pile, id: number, maxLevel: number): boolean
	local level = self:levelOf(id)
	return level ~= nil and level <= maxLevel and self:isExposed(id)
end

function Pile.pickableIds(self: Pile, maxLevel: number): { number }
	local out = {}
	for _, col in self.Columns do
		for level, id in col.Stack do
			if level <= maxLevel and self:isExposed(id) then
				table.insert(out, id)
			end
		end
	end
	return out
end

-- Puts a removed rock back on the mound (a leaver's basket or queue). It goes on top of a
-- low column at the edge (fewer than maxLevel rocks, so it stays reachable), the one nearest
-- `near` (xz relative to the pile centre) when given. Deterministic; returns the column index.
function Pile.restore(self: Pile, id: number, near: Vector2?, maxLevel: number?): number?
	if not self.Removed[id] then
		return nil
	end
	local cap = maxLevel or 3
	local best, bestKey, bestIdx = nil, math.huge, math.huge
	for ci, col in self.Columns do
		local h = #col.Stack
		-- prefer edge columns that still have room, then the lowest column anywhere
		local key = h + (if col.OpenEdge and h < cap then 0 else 1000)
		if near then
			key += (col.Pos - near).Magnitude * 0.01
		end
		if key < bestKey or (key == bestKey and ci < bestIdx) then
			best, bestKey, bestIdx = ci, key, ci
		end
	end
	if not best then
		return nil
	end
	self.Removed[id] = nil
	table.insert(self.Columns[best].Stack, id)
	self.Rocks[id].Column = best
	self.Remaining += 1
	return best
end

-- Same as restore but into a column the server already chose (clients replay the server's choice).
function Pile.restoreTo(self: Pile, id: number, column: number): boolean
	if not self.Removed[id] or not self.Columns[column] then
		return false
	end
	self.Removed[id] = nil
	table.insert(self.Columns[column].Stack, id)
	self.Rocks[id].Column = column
	self.Remaining += 1
	return true
end

-- Full column contents (bottom first), for reconnects: clients replace their layout with this.
function Pile.stacks(self: Pile): { { number } }
	local out = {}
	for ci, col in self.Columns do
		out[ci] = table.clone(col.Stack)
	end
	return out
end

function Pile.setStacks(self: Pile, stacks: { { number } })
	local removed: { [number]: boolean } = {}
	for id in self.Rocks do
		removed[id] = true
	end
	local remaining = 0
	for ci, col in self.Columns do
		col.Stack = table.clone(stacks[ci] or {})
		for _, id in col.Stack do
			removed[id] = nil
			remaining += 1
			if self.Rocks[id] then
				self.Rocks[id].Column = ci
			end
		end
	end
	self.Removed = removed
	self.Remaining = remaining
end

function Pile.exposedIds(self: Pile): { number }
	local out = {}
	for _, col in self.Columns do
		for _, id in col.Stack do
			if self:isExposed(id) then
				table.insert(out, id)
			end
		end
	end
	return out
end

return Pile
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="176">
        <Properties>
          <string name="Name">PlaceRole</string>
          <string name="Source"><![CDATA[--!strict
-- Which job this server does. Pure so it can be tested offline.
--   "Single": lobby and private arenas in one server (default, Studio, unpublished places).
--   "Lobby" : public lobby that teleports parties to the Match place.
--   "Match" : private reserved server that runs one party's hunts.
-- Anything that is not clearly configured falls back to "Single" so Studio always works.

local PlaceRole = {}

function PlaceRole.resolve(mode: string, placeId: number, lobbyPlaceId: number, matchPlaceId: number): string
	if mode ~= "Teleport" then
		return "Single"
	end
	if lobbyPlaceId == 0 or matchPlaceId == 0 or lobbyPlaceId == matchPlaceId then
		return "Single" -- ids not pasted in yet (or both the same): do not half-enable teleports
	end
	if placeId == matchPlaceId then
		return "Match"
	elseif placeId == lobbyPlaceId then
		return "Lobby"
	end
	return "Single" -- Studio / a place that is neither of the two
end

return PlaceRole
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="177">
        <Properties>
          <string name="Name">PopupRules</string>
          <string name="Source"><![CDATA[--!strict
-- One rule for every popup that is not part of a fight (Studio 2026-10-14: the NEXT GOAL card and toasts popped over
-- a Pet Battle). Pure; the client wrapper is client/PopupGate (reads the player's attributes and the fight holds).
--   Toast  small notices: wait while a Pet Battle or a tower climb is on screen (a hunt keeps its toasts).
--   Card   big cards and dialogs (NEXT GOAL, away nest, welcome, level ups): also wait through a hunt round.
-- Popups that belong to the fight itself (the result card, "Floor N cleared!") are shown by the fight code directly
-- and never go through this gate.

local PopupRules = {}

export type Busy = {
	MatchKey: any?, -- player attribute: in a hunt (server)
	InTower: any?, -- player attribute: climbing the Training Tower
	InBattle: any?, -- player attribute: in a Pet Battle (set at the fight start, cleared after the result)
	Match: any?, -- client State.Match: a hunt round is open
	Held: boolean?, -- a client fight view holds popups (FightCam from the count-in to the hero shot's end)
	Shown: boolean?, -- a menu or another big card is already on screen (Studio 2026-10-15: NEXT GOAL over WHAT'S NEW)
}

PopupRules.Kinds = { Toast = true, Card = true }

-- Seconds a released popup waits after the fight view closes, so it never lands on the last frame of the fight.
PopupRules.Breath = 1.5

function PopupRules.fighting(s: Busy): boolean
	return s.Held == true or s.InBattle == true or s.InTower == true
end

-- Whether a popup of `kind` may show now.
function PopupRules.free(kind: string, s: Busy): boolean
	if PopupRules.fighting(s) then
		return false
	end
	if kind == "Card" then
		return s.MatchKey == nil and s.Match == nil and s.Shown ~= true -- big cards come one at a time
	end
	return true
end

-- Big cards that pop up on their own (UI.dialogLayer children); any of them on screen counts as Shown.
PopupRules.Cards = { "NextGoal", "AwayNest" }


-- A card that pops up on its own (NEXT GOAL, away nest) closes itself after CardLife seconds, and at once when its kind
-- stops being free (a hunt, tower climb or Pet Battle starts under it). Studio 2026-10-15: the NEXT GOAL card stayed
-- mid-screen into the hunt.
PopupRules.CardLife = 20
function PopupRules.cardStays(shownFor: number, s: Busy): boolean
	-- the card itself is on screen, so Shown never closes it; only a hunt / climb / battle or its age does
	return shownFor < PopupRules.CardLife and PopupRules.free("Card", { MatchKey = s.MatchKey, InTower = s.InTower, InBattle = s.InBattle, Match = s.Match, Held = s.Held })
end

-- The player's own avatar is hidden for the player (others still see it) for the whole of any fight view: a Pet Battle
-- or a tower climb, where it stands on its mark between the camera and the pets (Studio 2026-10-15: tower fight).
function PopupRules.hideSelf(inBattle: boolean, inTower: boolean): boolean
	return inBattle or inTower
end

return PopupRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="178">
        <Properties>
          <string name="Name">ProgressConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Progression tuning (Find The Pet part 2): basket and nest upgrades, the daily gift, daily quests and badges.
-- Kept apart from Config.luau so it can be tuned on its own. Every price here is in-game COINS (earned by
-- selling shells and pets), never Robux: upgrades are not sold for real money (never pay-to-win).

local Config = require(script.Parent.Config)
local SpeciesPool = require(script.Parent.SpeciesPool)

local ProgressConfig = {}

export type Basket = { Id: string, Name: string, Carry: number, Price: number }
export type Nest = { Id: string, Name: string, Queue: number, Price: number, Color: Color3, Dark: Color3, Material: string }

-- Baskets: eggs carried per trip, 3 up to 20. Level 1 is free (Config.Carry.Capacity, 3 eggs). The avatar's basket
-- model shows at most its own slot count (CarryView); the HUD shows the real count. Prices invented for the
-- in-game economy (a Meadow shell sells for 2 coins, a Forest shell for 5): the first upgrade is a few hunts away.
ProgressConfig.Baskets = {
	{ Id = "Starter", Name = "Starter Basket", Carry = Config.Carry.Capacity, Price = 0 },
	{ Id = "Picnic", Name = "Picnic Basket", Carry = 4, Price = 400 },
	{ Id = "Big", Name = "Big Basket", Carry = 5, Price = 1500 },
	{ Id = "Mega", Name = "Mega Basket", Carry = 6, Price = 7500 },
	{ Id = "Wagon", Name = "Egg Wagon", Carry = 8, Price = 40000 },
	{ Id = "Barrow", Name = "Wheelbarrow", Carry = 10, Price = 90000 },
	{ Id = "Cart", Name = "Egg Cart", Carry = 12, Price = 180000 },
	{ Id = "Crate", Name = "Giant Crate", Carry = 15, Price = 350000 },
	{ Id = "Golden", Name = "Golden Basket", Carry = 20, Price = 700000 }, -- owner: the biggest basket holds 20
} :: { Basket }

-- Nests: how many eggs wait in your nest tray (Config.Station.QueueCapacity is level 1) and how the nest looks.
-- Material is an Enum.Material name (this module stays free of Roblox enums so the offline tests can load it).
ProgressConfig.Nests = {
	{ Id = "Straw", Name = "Straw Nest", Queue = Config.Station.QueueCapacity, Price = 0, Color = Color3.fromRGB(246, 214, 128), Dark = Color3.fromRGB(214, 170, 90), Material = "SmoothPlastic" },
	{ Id = "Wood", Name = "Wood Nest", Queue = Config.Station.QueueCapacity + 2, Price = 800, Color = Color3.fromRGB(176, 118, 70), Dark = Color3.fromRGB(122, 80, 48), Material = "Wood" },
	{ Id = "Stone", Name = "Clay Nest", Queue = Config.Station.QueueCapacity + 4, Price = 2500, Color = Color3.fromRGB(168, 170, 176), Dark = Color3.fromRGB(110, 112, 120), Material = "Slate" },
	{ Id = "Gold", Name = "Gold Nest", Queue = Config.Station.QueueCapacity + 6, Price = 15000, Color = Color3.fromRGB(255, 204, 64), Dark = Color3.fromRGB(214, 150, 30), Material = "Foil" },
} :: { Nest }

-- The biggest tray any nest has (StationModels builds this many tray slots).
ProgressConfig.MaxQueue = Config.Station.QueueCapacity + 6

-- Level lookups clamp to the levels this build knows (a level from a newer build gets the biggest known one).
local function clampLevel(n: any, count: number): number
	if type(n) ~= "number" or n ~= n then
		return 1
	end
	return math.clamp(math.floor(n), 1, count)
end
ProgressConfig.clampLevel = clampLevel

function ProgressConfig.basket(level: any): Basket
	return ProgressConfig.Baskets[clampLevel(level, #ProgressConfig.Baskets)]
end

function ProgressConfig.nest(level: any): Nest
	return ProgressConfig.Nests[clampLevel(level, #ProgressConfig.Nests)]
end

function ProgressConfig.carry(level: any): number
	return ProgressConfig.basket(level).Carry
end

function ProgressConfig.queue(level: any): number
	return ProgressConfig.nest(level).Queue
end

-- Daily login gift: coins for day 1..7 of a streak (claim once per UTC day). Missing a day starts again at day 1;
-- after day 7 the streak goes round again at day 1.
ProgressConfig.DailyGift = { 25, 35, 45, 60, 75, 100, 300 }

-- Daily quests (owner pick 2026-10-11): every day has exactly one RACE quest (the egg hunt), one TOWER quest (the
-- pet tower) and one PET quest, in that order (Quests.forDay). Kind and goal are picked per player per UTC day.
-- Goals are picked from each list; Reward[i] pays for Goals[i]. Text uses %d for the goal; One is the text for 1.
-- Crack counts every egg opened in a hunt (most are empty); Hatch counts only hunt finds (the round's one pet), so
-- their words must differ (audit 2 #29: "Hatch 30 eggs 3/30" next to "Hatch any pet 0/1" read as a lost count).
export type QuestKind = { Kind: string, Group: string, Text: string, One: string?, Goals: { number }, Reward: { number } }
ProgressConfig.QuestGroups = { "Race", "Tower", "Pet" }
ProgressConfig.QuestsPerDay = #ProgressConfig.QuestGroups
ProgressConfig.QuestKinds = {
	{ Kind = "Crack", Group = "Race", Text = "Open %d eggs in hunts", Goals = { 10, 20, 30 }, Reward = { 40, 70, 100 } },
	{ Kind = "Sell", Group = "Race", Text = "Sell candy %d times", One = "Sell your candy once", Goals = { 1, 2 }, Reward = { 30, 60 } },
	{ Kind = "Hunt", Group = "Race", Text = "Play %d hunts", One = "Play a hunt", Goals = { 2, 3 }, Reward = { 50, 80 } },
	{ Kind = "Friend", Group = "Race", Text = "Play %d hunts with a friend", One = "Play a hunt with a friend", Goals = { 1 }, Reward = { 90 } },
	-- floors cleared today (QuestService.bump(player, "TowerFloors", n) from the tower, or the TowerFloorsToday field)
	{ Kind = "TowerFloors", Group = "Tower", Text = "Clear %d tower floors", One = "Clear a tower floor", Goals = { 3, 5, 8 }, Reward = { 50, 80, 120 } },
	{ Kind = "Hatch", Group = "Pet", Text = "Find the pet in %d hunts", One = "Find the pet in a hunt", Goals = { 1 }, Reward = { 80 } },
	{ Kind = "Display", Group = "Pet", Text = "Put %d pets on display", One = "Put a pet on display", Goals = { 1, 2 }, Reward = { 30, 50 } },
} :: { QuestKind }

-- Badges: REPLACE. The owner creates each badge on the Creator Dashboard (Experience > Associated items > Badges)
-- and pastes its id here. 0 = that badge is off (nothing is awarded, and it is awarded later once an id is set).
ProgressConfig.Badges = {
	FirstHatch = { Id = 0, Name = "First Hatch" }, -- hatch your first pet (the free starter pet does not count)
	FirstRare = { Id = 0, Name = "Rare Find" }, -- own a Rare, Epic or Legendary pet
	AllHuntPets = { Id = 0, Name = "Hunt Pet Master" }, -- find every hunt pet species (tower-only pets do not count)
	Tower25 = { Id = 0, Name = "Tower Floor 25" }, -- reach floor 25 of the pet tower (profile TowerBest)
	Forest = { Id = 0, Name = "Into the Forest" }, -- unlock the Forest zone
	SecretEgg = { Id = 0, Name = "Secret Egg" }, -- find the hidden egg in the lobby park (profile SecretEggFound)
}
ProgressConfig.BadgeOrder = { "FirstHatch", "FirstRare", "AllHuntPets", "Tower25", "Forest", "SecretEgg" }
ProgressConfig.RareRarities = { Rare = true, Epic = true, Legendary = true }
ProgressConfig.BadgeTowerFloor = 25
ProgressConfig.BadgeForestTier = "Quarry" -- the Forest zone's tier id (Config.Tiers.Quarry.Name = "Forest")

-- Hunt pet species: every species a hunt pile can hatch (listed by a zone), in zone order.
function ProgressConfig.huntSpecies(): { string }
	local out = {}
	for _, tid in Config.TierOrder do
		for _, id in SpeciesPool.list(tid, os.time()) do -- weekly pets count once they are out
			table.insert(out, id)
		end
	end
	return out
end

-- Pure milestone check used by the server badge service and the Stats tab: which badges this profile has reached.
-- `data` needs Stats, DiscoveryIndex, DiscoveryRarity, InventoryGeodes (or Inventory), TowerBest, UnlockedTiers and
-- SecretEggFound.
function ProgressConfig.badgeProgress(data: any): { [string]: { Done: boolean, Have: number, Need: number } }
	local stats = data.Stats or {}
	local finds = (tonumber(stats.SoloFinds) or 0) + (tonumber(stats.MultiplayerWins) or 0)
	local rare = false
	for _, list in { data.InventoryGeodes or {}, data.Inventory or {} } do
		for _, g in list do
			if type(g) == "table" and ProgressConfig.RareRarities[g.Rarity] then
				rare = true
			end
		end
	end
	for _, row in data.DiscoveryRarity or {} do
		if type(row) == "table" then
			for r, n in row do
				if ProgressConfig.RareRarities[r] and type(n) == "number" and n > 0 then
					rare = true
				end
			end
		end
	end
	local species = ProgressConfig.huntSpecies()
	local seen = 0
	for _, id in species do
		local idx = data.DiscoveryIndex and tonumber(data.DiscoveryIndex[id]) or 0
		local row = data.DiscoveryRarity and data.DiscoveryRarity[id]
		local any = idx > 0
		if not any and type(row) == "table" then
			for _, n in row do
				if type(n) == "number" and n > 0 then
					any = true
				end
			end
		end
		if any then
			seen += 1
		end
	end
	local tower = tonumber(data.TowerBest) or 0
	local forest = type(data.UnlockedTiers) == "table" and data.UnlockedTiers[ProgressConfig.BadgeForestTier] == true
	return {
		FirstHatch = { Done = finds >= 1, Have = math.min(finds, 1), Need = 1 },
		FirstRare = { Done = rare, Have = if rare then 1 else 0, Need = 1 },
		AllHuntPets = { Done = seen >= #species, Have = seen, Need = #species },
		Tower25 = { Done = tower >= ProgressConfig.BadgeTowerFloor, Have = math.min(tower, ProgressConfig.BadgeTowerFloor), Need = ProgressConfig.BadgeTowerFloor },
		Forest = { Done = forest, Have = if forest then 1 else 0, Need = 1 },
		SecretEgg = { Done = data.SecretEggFound == true, Have = if data.SecretEggFound == true then 1 else 0, Need = 1 },
	}
end

return ProgressConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="179">
        <Properties>
          <string name="Name">PromptPick</string>
          <string name="Source"><![CDATA[--!strict
-- Which ONE world prompt wins (Master Prompt 4, section 27). Pure: the client collects candidates
-- (distance to the prompt's anchor, how directly the camera faces it) and gets one winner back.
-- Nearest wins, a candidate the camera faces gets a bonus, and the current winner is kept until another
-- beats it by a margin (so the label never flickers between two benches or two pedestals).
local PromptPick = {}

export type Candidate = {
	Key: any, -- the prompt (or any stable key)
	Distance: number, -- studs from the avatar to the prompt's anchor
	Range: number, -- the prompt's MaxActivationDistance
	Facing: number, -- 0..1, how much the camera looks at it (1 = straight at it)
}

PromptPick.FacingBonus = 4 -- studs of advantage for a prompt dead ahead
PromptPick.Hysteresis = 2.5 -- studs the challenger must beat the current winner by

local function score(c: Candidate): number
	return c.Distance - PromptPick.FacingBonus * math.clamp(c.Facing, 0, 1)
end

-- Returns the winning key or nil. Candidates outside their own range are never chosen.
function PromptPick.pick(cands: { Candidate }, current: any?): any?
	local best: Candidate? = nil
	local cur: Candidate? = nil
	for _, c in cands do
		if c.Distance <= c.Range then
			if c.Key == current then
				cur = c
			end
			if not best or score(c) < score(best) or (score(c) == score(best) and tostring(c.Key) < tostring(best.Key)) then
				best = c
			end
		end
	end
	if not best then
		return nil
	end
	if cur and score(cur) <= score(best) + PromptPick.Hysteresis then
		return cur.Key
	end
	return best.Key
end

return PromptPick
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="180">
        <Properties>
          <string name="Name">PvpConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Pet Battle + Pet Training tuning (carter 2026-10-14: "find the pet - train the pet - fight other pets").
-- Pure data, no Roblox services. Fights reuse the tower's pet stats (PetStats) and type chart; rules in PvpRules.

local PvpConfig = {}

PvpConfig.TeamSize = 3 -- pets per side

-- Matchmaking: 1v1, matched by team power (PvpRules.teamPower). Two players match when their power differs by at
-- most Window.Start (share of the bigger one), widening by Window.PerSecond for every second waited. Nobody waits
-- longer than BotAfter seconds: then a bot team of about the same power steps in.
PvpConfig.Window = { Start = 0.15, PerSecond = 0.03 }
PvpConfig.BotAfter = 15
-- Bot team power aims at BotPower x the player's (a small edge for the player), picked from BotTries rolls.
PvpConfig.BotPower = 0.95
PvpConfig.BotTries = 8
PvpConfig.BotSpecialDelay = 1.5 -- seconds a bot waits after its SPECIAL fills
-- Shown with a BOT tag in the game, so nobody thinks a bot is a real player.
PvpConfig.BotNames = { "Pip", "Mo", "Zee", "Bo", "Kit", "Nova", "Sunny", "Tumble" }

-- Fight
PvpConfig.FightTime = 60 -- seconds; on time-out the side with more health left (share of max) wins
PvpConfig.ForfeitWinAfter = 8 -- seconds: a rival who leaves sooner gives the stayer a draw reward, not a win (anti win-feeding)
PvpConfig.CritChance = 0.1 -- basic and type-move hits
PvpConfig.CritMult = 1.6
PvpConfig.HealthMult = 4 -- pets have this much more health in battle than in the tower, so a fight lasts ~20-30 s
PvpConfig.SpecialCharge = 150 -- meter units when SPECIAL is full (clients get the meter as a 0..1 share of it)
-- SPECIAL fills after dealing this share of the other team's total max health, at every level and rarity (a flat
-- damage number filled at once for trained teams: their fights were all SPECIALs, 6 s long; balance sim).
PvpConfig.SpecialShare = 0.15
-- The rival's pets stand on this line (arena z; ours are at z -14), nearer than the tower's mob line (z 3) so both
-- teams read clearly from behind the player. PvpService mirrors side 2's view about the middle of the two lines.
PvpConfig.FoeZ = -4
-- Fight layouts (studs along the arena's look axis from the origin): our pet line, the rival's, where the players
-- stand, gaps between pets. Private = a TowerBuilder arena; Live = the open arena in the middle of the lobby (carter
-- 2026-10-14: everyone can watch). Its origin is the arena floor's centre, so the two pet lines sit either side of it.
PvpConfig.Layouts = {
	Private = { PetZ = -14, FoeZ = -4, StandZ = -22, PetGap = 8, FoeGap = 8 },
	Live = { PetZ = -4, FoeZ = 4, StandZ = -12, PetGap = 6, FoeGap = 6 },
	-- the lobby stadium (fight floor ~64 studs, ArenaCenter FightRadius 30): pet lines at +-10 facing each other across
	-- the middle, pets 9 apart in a line, players at +-21 behind their own team (Studio test 2026-10-14: at +-6 the
	-- two teams' real-size pets overlapped). StandX puts the player off to their left (the view's +X), away from the
	-- fight camera's orbit (it swings round their right side): their avatar never fills the foreground.
	LiveBig = { PetZ = -10, FoeZ = 10, StandZ = -21, StandX = 13, PetGap = 9, FoeGap = 9 },
}
-- An ArenaCenter with FightRadius (or a floor half-size) of at least BigArena studs uses Layouts.LiveBig.
PvpConfig.BigArena = 20
-- Fights happen on small floating islands (carter 2026-10-14: "make a floating island ... teleport to the small
-- island"), one copy per fight, nobody watches. The island is ServerStorage[Island.Model] (the owner's Blender model,
-- with a part marked ArenaCenter = true and FightRadius on its fight floor); without it a procedural stand-in is built.
-- Copies float at Base, Spacing studs apart, far from the lobby, hunts and the tower.
PvpConfig.Island = { Model = "ArenaIsland", Base = Vector3.new(-4000, 600, 0), Spacing = 400, Radius = 30 }
PvpConfig.CountIn = 3 -- seconds of "3, 2, 1, FIGHT!" before pets start
PvpConfig.ResultHold = 4 -- seconds the winners cheer before the result card

-- Rewards. Bots pay full coins and XP but fewer trophies, so the trophy count mostly means real wins.
PvpConfig.Rewards = {
	WinCoins = 75,
	LossCoins = 15,
	DrawCoins = 25,
	StreakCoins = 10, -- per win in the current streak after the first, up to StreakCap
	StreakCap = 5,
	WinXp = 60, -- to each of the side's pets (training XP, PetStats.level)
	LossXp = 25,
	WinTrophies = 20,
	LossTrophies = 10,
	BotWinTrophies = 8,
	BotLossTrophies = 4,
}

-- Trophy ranks, lowest first.
PvpConfig.Ranks = {
	{ Name = "Bronze", Min = 0, Color = Color3.fromRGB(205, 140, 90) },
	{ Name = "Silver", Min = 150, Color = Color3.fromRGB(200, 210, 225) },
	{ Name = "Gold", Min = 400, Color = Color3.fromRGB(255, 205, 70) },
	{ Name = "Diamond", Min = 800, Color = Color3.fromRGB(120, 220, 255) },
	{ Name = "Champion", Min = 1500, Color = Color3.fromRGB(255, 120, 200) },
}

-- Training (TRAIN): pets level up with the tower's XP book (profile TowerXP, PetStats.level, +4% power per level).
-- Tap TRAIN: each accepted tap gives TapXp to the picked pet; at most TapsPerSecond taps count (more are dropped).
-- Idle: every IdleEvery seconds online, each pet following the player gets IdleXp.
PvpConfig.Train = { TapXp = 2, TapsPerSecond = 5, IdleEvery = 60, IdleXp = 5 }
-- Hunt XP (carter 2026-10-14): every egg a player cracks in a hunt gives each pet following them CrackXp; the
-- egg with the pet inside gives FoundXp.
PvpConfig.Hunt = { CrackXp = 3, FoundXp = 25 }

-- Tap to fight (carter 2026-10-16: "Fight part is thin"). The player's hands count too:
-- TAP anywhere on the fight: a quick extra hit from the team (Share of the team's damage per second, so taps add
-- about Share x PerSecond on top: 6 taps a second ~ +18%). Taps within ComboGap seconds grow a combo; each combo step
-- adds ComboStep, up to ComboMax steps. The server counts at most PerSecond taps.
-- BLOCK: a rival pet about to use its big type move WarnTime seconds ahead raises a gold ring on our side; a BLOCK
-- before it lands is PERFECT (the move does Cut less damage and our SPECIAL meter gains PerfectCharge). A BLOCK with
-- no ring up misses and locks BLOCK for MissLock seconds, so spamming it does not work.
-- Bots tap BotTaps a second and block BotBlock of the rings, so a player who plays along has the edge (balance in
-- tests/test_pvp_tap.luau: vs bots a kid who taps and blocks wins ~87%, one who only watches ~36%).
PvpConfig.Tap = { Share = 0.03, PerSecond = 6, ComboGap = 0.7, ComboStep = 0.05, ComboMax = 10, BotTaps = 2 }
PvpConfig.Block = { WarnTime = 1.1, Cut = 0.5, PerfectCharge = 25, MissLock = 1.5, BotBlock = 0.35 }

-- Rate limits (server): one queue / leave intent per QueueGap, one SPECIAL per ActionGap.
PvpConfig.QueueGap = 1
PvpConfig.ActionGap = 0.15

return PvpConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="181">
        <Properties>
          <string name="Name">PvpRules</string>
          <string name="Source"><![CDATA[--!strict
-- Pet Battle rules (pure, deterministic given the `rand` function; tested in tests/test_pvp.luau).
-- Two sides of up to 3 pets fight in real time like the tower: every pet attacks on its own, alternating its basic
-- attack and its type move; each side fires SPECIAL when its meter is full. Types work as in the tower (PetStats.effect).
-- The server steps a fight and sends the events; clients only draw them.

local PvpConfig = require(script.Parent.PvpConfig)
local TowerConfig = require(script.Parent.TowerConfig)
local PetStats = require(script.Parent.PetStats)

local PvpRules = {}

export type Pet = { Mineral: string, Rarity: string, Modifier: string?, Seed: number }
export type TeamPet = { Id: string, Name: string?, Xp: number?, Pet: Pet }
export type Unit = {
	Id: string,
	Side: number, -- 1 or 2
	Kind: string, -- species id
	Rarity: string,
	Name: string,
	Max: number,
	Hp: number,
	Power: number,
	Speed: number,
	Cd: number,
	Shield: number,
	BurnDps: number,
	BurnLeft: number,
	Special: string?,
	Element: string,
	MoveMult: number,
	MoveSlow: number,
	Swing: number,
	Warned: boolean, -- a ring is up for this pet's next type move (Warn sent)
	Guarded: boolean, -- the other side blocked that move in time
}
export type Event = {
	Kind: string, From: string?, To: string?, Amount: number?, Side: number?, Id: string?, Crit: boolean?, Combo: number?,
}
export type Fight = {
	Units: { Unit },
	Meters: { number }, -- [side]
	Slow: { number }, -- [side] seconds that side still attacks at half speed
	Time: number,
	State: string, -- "Fighting" | "Done"
	Winner: number, -- 0 = draw (or not done), else the winning side
	Pool: { number }, -- [side] total max health of the OTHER side (the SPECIAL meter fills by share of it)
	Turn: number, -- steps so far: on a tie the side that strikes first alternates (no side edge)
	Combo: { number }, -- [side] tap combo (PvpConfig.Tap)
	LastTap: { number }, -- [side] fight time of the last tap
	BlockLock: { number }, -- [side] fight time until which BLOCK is locked after a miss
}

-- THE power number of one pet (matchmaking, team cards, training level-ups). One place to change it.
function PvpRules.petPower(s: { Power: number, Health: number, Speed: number }): number
	return PetStats.power(s) -- the Pet Book's POWER (PetStats.power): one formula for the whole game
end

function PvpRules.power(pet: Pet, xp: number?): number
	return PvpRules.petPower(PetStats.roll(pet, xp))
end

function PvpRules.teamPower(team: { TeamPet }): number
	local sum = 0
	for i, tp in team do
		if i > PvpConfig.TeamSize then
			break
		end
		sum += PvpRules.power(tp.Pet, tp.Xp)
	end
	return sum
end

-- How far apart (share of the bigger power) two teams may be after waiting `waited` seconds.
function PvpRules.window(waited: number): number
	return PvpConfig.Window.Start + PvpConfig.Window.PerSecond * math.max(waited, 0)
end

-- Two waiting players always beat a bot: once either has waited BotAfter seconds (when the bot would step in), any
-- power gap is fine (Studio 2026-10-14: two testers, one with a maxed team, both got bots seconds apart).
function PvpRules.canMatch(powerA: number, waitedA: number, powerB: number, waitedB: number): boolean
	if math.max(waitedA, waitedB) >= PvpConfig.BotAfter then
		return true
	end
	local big = math.max(powerA, powerB, 1)
	local gap = math.abs(powerA - powerB) / big
	return gap <= math.max(PvpRules.window(waitedA), PvpRules.window(waitedB))
end

-- Species a bot may field: every egg pet with stats (tower-only drops are left out).
local botSpecies: { string } = {}
do
	local towerOnly = {}
	for _, tp in TowerConfig.TowerPets do
		towerOnly[tp.Id] = true
	end
	for id in TowerConfig.Species do
		if not towerOnly[id] then
			table.insert(botSpecies, id)
		end
	end
	table.sort(botSpecies)
end

-- A bot team for `team`: same rarities, variants and levels, other species and seeds. Of BotTries rolls, the one
-- whose power is closest to BotPower x the player's is kept.
function PvpRules.botTeam(team: { TeamPet }, rand: () -> number): { TeamPet }
	local target = PvpRules.teamPower(team) * PvpConfig.BotPower
	local best: { TeamPet }? = nil
	local bestGap = math.huge
	for _ = 1, PvpConfig.BotTries do
		local out: { TeamPet } = {}
		for i, tp in team do
			if i > PvpConfig.TeamSize then
				break
			end
			local species = botSpecies[math.clamp(math.floor(rand() * #botSpecies) + 1, 1, #botSpecies)]
			table.insert(out, {
				Id = "bot" .. i,
				Name = TowerConfig.PetNames[species] or species,
				Xp = tp.Xp,
				Pet = { Mineral = species, Rarity = tp.Pet.Rarity, Modifier = tp.Pet.Modifier, Seed = math.floor(rand() * 2 ^ 30) + 1 },
			})
		end
		local gap = math.abs(PvpRules.teamPower(out) - target)
		if gap < bestGap then
			best, bestGap = out, gap
		end
	end
	return best or {}
end

-- How much faster than its plain level-1 self a pet attacks (level, rarity, variant and evolve all add speed). Battle
-- health grows by the same factor, so a trained rare team's fight lasts about as long as a fresh common one's
-- (balance sim: maxed legendary fights were over in 6 s); who is stronger is unchanged.
local function speedGrowth(pet: Pet, s: PetStats.Stats): number
	local plain = PetStats.roll({ Mineral = pet.Mineral, Rarity = "Common", Modifier = "Natural", Seed = pet.Seed }, 0)
	return math.max(s.Speed / math.max(plain.Speed, 1), 1)
end

local function unit(tp: TeamPet, side: number, slot: number): Unit
	local s = PetStats.roll(tp.Pet, tp.Xp)
	local hp = s.Health * PvpConfig.HealthMult * speedGrowth(tp.Pet, s)
	return {
		Id = tp.Id,
		Side = side,
		Kind = tp.Pet.Mineral,
		Rarity = tp.Pet.Rarity,
		Name = tp.Name or (TowerConfig.PetNames[tp.Pet.Mineral] or tp.Pet.Mineral),
		Max = hp,
		Hp = hp,
		Power = s.Power,
		Speed = s.Speed,
		Cd = 0.3 + 0.12 * slot, -- both sides alike: ties are broken fairly in step (Turn)
		Shield = 0,
		BurnDps = 0,
		BurnLeft = 0,
		Special = s.Special,
		Element = s.Element,
		MoveMult = s.MoveMult,
		MoveSlow = s.MoveSlow,
		Swing = 0,
		Warned = false,
		Guarded = false,
	}
end

function PvpRules.newFight(a: { TeamPet }, b: { TeamPet }): Fight
	local units: { Unit } = {}
	for side, team in { a, b } do
		for i, tp in team do
			if i > PvpConfig.TeamSize then
				break
			end
			table.insert(units, unit(tp, side, i))
		end
	end
	local max = { 0, 0 }
	for _, u in units do
		max[u.Side] += u.Max
	end
	return {
		Units = units, Meters = { 0, 0 }, Slow = { 0, 0 }, Time = 0, State = "Fighting", Winner = 0,
		Pool = { math.max(max[2], 1), math.max(max[1], 1) }, Turn = 0,
		Combo = { 0, 0 }, LastTap = { -math.huge, -math.huge }, BlockLock = { -math.huge, -math.huge },
	}
end

function PvpRules.alive(f: Fight, side: number): { Unit }
	local out = {}
	for _, u in f.Units do
		if u.Side == side and u.Hp > 0 then
			table.insert(out, u)
		end
	end
	return out
end

-- Share of max health a side has left (0..1).
function PvpRules.healthShare(f: Fight, side: number): number
	local hp, max = 0, 0
	for _, u in f.Units do
		if u.Side == side then
			hp += u.Hp
			max += u.Max
		end
	end
	return if max > 0 then hp / max else 0
end

local function hurt(target: Unit, amount: number, from: string, events: { Event }, element: string, crit: boolean?): number
	local eff = PetStats.effect(element, target.Element)
	local dmg = math.max(math.floor(amount * eff + 0.5), 1)
	local absorbed = math.min(target.Shield, dmg)
	target.Shield -= absorbed
	local real = math.min(dmg - absorbed, target.Hp)
	target.Hp -= real
	local note = if eff > 1 then "Strong" elseif eff < 1 then "Weak" else nil
	table.insert(events, { Kind = "Hit", From = from, To = target.Id, Amount = dmg, Id = note, Crit = if crit then true else nil })
	if target.Hp <= 0 then
		table.insert(events, { Kind = "Faint", To = target.Id })
	end
	return real
end

-- The meter fills after dealing PvpConfig.SpecialShare of the other team's total max health (meter units stay
-- 0..SpecialCharge). A flat damage number filled at once for trained, rare teams, so their fights were all SPECIALs
-- and over in seconds (balance sim, tests/test_pvp_balance.luau).
local function charge(f: Fight, side: number, dealt: number)
	local gain = dealt / f.Pool[side] / PvpConfig.SpecialShare * PvpConfig.SpecialCharge
	f.Meters[side] = math.min(f.Meters[side] + gain, PvpConfig.SpecialCharge)
end

-- A pet hits the first standing foe it is strong against, else the first standing foe.
local function pickTarget(foes: { Unit }, element: string): Unit?
	for _, u in foes do
		if PetStats.effect(element, u.Element) > 1 then
			return u
		end
	end
	return foes[1]
end

local function finish(f: Fight, winner: number, events: { Event })
	f.State = "Done"
	f.Winner = winner
	table.insert(events, { Kind = "KO", Side = winner })
end

local function settle(f: Fight, events: { Event })
	if f.State ~= "Fighting" then
		return
	end
	local a, b = #PvpRules.alive(f, 1), #PvpRules.alive(f, 2)
	if a == 0 and b == 0 then
		finish(f, 0, events)
	elseif a == 0 then
		finish(f, 2, events)
	elseif b == 0 then
		finish(f, 1, events)
	end
end

-- One fight step. `rand` returns 0..1 (crits); the server passes math.random, tests a seeded stream.
function PvpRules.step(f: Fight, dt: number, rand: () -> number): { Event }
	local events: { Event } = {}
	if f.State ~= "Fighting" then
		return events
	end
	f.Time += dt
	if f.Time >= PvpConfig.FightTime then
		local a, b = PvpRules.healthShare(f, 1), PvpRules.healthShare(f, 2)
		table.insert(events, { Kind = "TimeUp" })
		finish(f, if a > b then 1 elseif b > a then 2 else 0, events)
		return events
	end
	for side = 1, 2 do
		f.Slow[side] = math.max(f.Slow[side] - dt, 0)
	end
	for _, u in f.Units do
		if u.Hp > 0 and u.BurnLeft > 0 then
			local tick = math.min(dt, u.BurnLeft)
			u.BurnLeft -= tick
			u.Hp = math.max(u.Hp - u.BurnDps * tick, 0)
			if u.Hp <= 0 then
				table.insert(events, { Kind = "Faint", To = u.Id })
			end
		end
	end
	-- who is due this step strikes in the order they came due (most overdue first); on a tie the first side
	-- alternates step by step, so neither side always lands the first blow (mirror fights split evenly)
	f.Turn += 1
	local due: { Unit } = {}
	for _, u in f.Units do
		if u.Hp > 0 then
			u.Cd -= dt * (if f.Slow[u.Side] > 0 then 0.5 else 1)
			if u.Cd <= 0 then
				table.insert(due, u)
			elseif not u.Warned and (u.Swing + 1) % 2 == 0 and u.Cd <= PvpConfig.Block.WarnTime then
				-- the next swing is the big type move: ring up on the other side so its player can BLOCK it
				local target = pickTarget(PvpRules.alive(f, 3 - u.Side), u.Element)
				if target then
					u.Warned = true
					table.insert(events, { Kind = "Warn", From = u.Id, To = target.Id, Side = 3 - u.Side })
				end
			end
		end
	end
	local first = f.Turn % 2 + 1
	table.sort(due, function(x: Unit, y: Unit): boolean
		if math.abs(x.Cd - y.Cd) > 1e-6 then
			return x.Cd < y.Cd
		end
		if x.Side ~= y.Side then
			return x.Side == first
		end
		return x.Id < y.Id
	end)
	for _, u in due do
		if u.Hp > 0 then
			local foes = PvpRules.alive(f, 3 - u.Side)
			local target = pickTarget(foes, u.Element)
			if target == nil then
				break
			end
			u.Swing += 1
			local useMove = u.Swing % 2 == 0
			u.Cd += 100 / u.Speed * (if useMove then u.MoveSlow else 1)
			local crit = rand() < PvpConfig.CritChance
			local amount = u.Power * (if useMove then u.MoveMult else 1) * (if crit then PvpConfig.CritMult else 1)
			if useMove then
				if u.Guarded then
					amount *= 1 - PvpConfig.Block.Cut
					local side = 3 - u.Side
					f.Meters[side] = math.min(f.Meters[side] + PvpConfig.Block.PerfectCharge, PvpConfig.SpecialCharge)
					table.insert(events, { Kind = "Perfect", From = u.Id, To = target.Id, Side = side })
				end
				u.Warned, u.Guarded = false, false
			end
			charge(f, u.Side, hurt(target, amount, u.Id, events, u.Element, crit))
		end
	end
	settle(f, events)
	return events
end

function PvpRules.meterFull(f: Fight, side: number): boolean
	return (f.Meters[side] or 0) >= PvpConfig.SpecialCharge
end

local function rarityIndex(r: string): number
	return table.find(TowerConfig.Rarities, r) or 1
end

-- Only Epic+ pets bring a SPECIAL to a battle (TowerConfig.SpecialMinRarity). The caster is the strongest standing one.
local function caster(f: Fight, side: number): Unit?
	local best: Unit? = nil
	for _, u in PvpRules.alive(f, side) do
		if u.Special ~= nil and rarityIndex(u.Rarity) >= TowerConfig.SpecialMinRarity and (best == nil or u.Power > best.Power) then
			best = u
		end
	end
	return best
end

-- True while `side` has a standing pet that can fire SPECIAL.
function PvpRules.hasSpecial(f: Fight, side: number): boolean
	return caster(f, side) ~= nil
end

-- Fires `side`'s SPECIAL with its strongest standing Epic+ pet's special (TowerConfig.Specials, aimed at the other side).
function PvpRules.useSpecial(f: Fight, side: number, pick: number?): (boolean, { Event })
	local events: { Event } = {}
	if f.State ~= "Fighting" or (side ~= 1 and side ~= 2) or not PvpRules.meterFull(f, side) then
		return false, events
	end
	local c = caster(f, side)
	if c == nil or c.Special == nil then
		return false, events
	end
	local sp = PetStats.special(c.Special)
	if sp == nil then
		return false, events
	end
	f.Meters[side] = 0
	table.insert(events, { Kind = "Special", Side = side, From = c.Id, Id = sp.Id })
	local foes = PvpRules.alive(f, 3 - side)
	local power = c.Power
	if sp.Kind == "Burn" then
		for _, m in foes do
			m.BurnDps, m.BurnLeft = sp.Value * power, 4
		end
	elseif sp.Kind == "Slow" then
		f.Slow[3 - side] = sp.Value
	elseif sp.Kind == "Chain" then
		for i = 1, math.min(3, #foes) do
			hurt(foes[i], sp.Value * power, c.Id, events, c.Element)
		end
	elseif sp.Kind == "Heal" then
		for _, p in PvpRules.alive(f, side) do
			p.Hp = math.min(p.Max, p.Hp + math.floor(p.Max * sp.Value + 0.5))
		end
	elseif sp.Kind == "Shield" then
		for _, p in PvpRules.alive(f, side) do
			p.Shield = math.max(p.Shield, math.floor(p.Max * sp.Value + 0.5))
		end
	elseif sp.Kind == "Stomp" then
		for _, m in foes do
			hurt(m, sp.Value * power, c.Id, events, c.Element)
		end
	elseif sp.Kind == "Dash" then
		if foes[1] then
			hurt(foes[1], sp.Value * power, c.Id, events, c.Element)
		end
	elseif sp.Kind == "Crit" then
		if #foes > 0 then
			local i = math.clamp(math.floor((pick or 0) * #foes) + 1, 1, #foes)
			hurt(foes[i], sp.Value * power, c.Id, events, c.Element, true)
		end
	end
	settle(f, events)
	return true, events
end

-- Damage per second of a side's standing pets (basic and type move averaged; taps scale with it).
local function teamDps(f: Fight, side: number): number
	local dps = 0
	for _, u in PvpRules.alive(f, side) do
		dps += u.Power * (1 + u.MoveMult) / 2 * u.Speed / 100 / ((1 + u.MoveSlow) / 2)
	end
	return dps
end

-- One TAP from `side` (rate limited by the server): a quick hit on the foe its strongest standing pet aims at,
-- growing with the tap combo. Fills the SPECIAL meter like any hit. Returns false when the fight is not on.
function PvpRules.tap(f: Fight, side: number): (boolean, { Event })
	local events: { Event } = {}
	if f.State ~= "Fighting" or (side ~= 1 and side ~= 2) then
		return false, events
	end
	local lead: Unit? = nil
	for _, u in PvpRules.alive(f, side) do
		if lead == nil or u.Power > lead.Power then
			lead = u
		end
	end
	local target = lead and pickTarget(PvpRules.alive(f, 3 - side), lead.Element)
	if lead == nil or target == nil then
		return false, events
	end
	local cfg = PvpConfig.Tap
	f.Combo[side] = if f.Time - f.LastTap[side] <= cfg.ComboGap then f.Combo[side] + 1 else 1
	f.LastTap[side] = f.Time
	local combo = f.Combo[side]
	local amount = teamDps(f, side) * cfg.Share * (1 + cfg.ComboStep * math.min(combo - 1, cfg.ComboMax))
	local before = #events
	charge(f, side, hurt(target, amount, lead.Id, events, lead.Element))
	-- the hit goes out as a Tap (its own small pop on the client, not a pet lunge)
	local e = events[before + 1]
	e.Kind, e.Side, e.Combo = "Tap", side, combo
	settle(f, events)
	return true, events
end

-- BLOCK from `side`: guards against the soonest rival type move that has its ring up. With no ring up it misses and
-- BLOCK stays locked for PvpConfig.Block.MissLock seconds. Returns true on a guard ("Blocked"; the PERFECT lands with
-- the move), false on a miss or a locked BLOCK.
function PvpRules.block(f: Fight, side: number): (boolean, { Event })
	local events: { Event } = {}
	if f.State ~= "Fighting" or (side ~= 1 and side ~= 2) or f.Time < f.BlockLock[side] then
		return false, events
	end
	local soonest: Unit? = nil
	for _, u in PvpRules.alive(f, 3 - side) do
		if u.Warned and not u.Guarded and (soonest == nil or u.Cd < soonest.Cd) then
			soonest = u
		end
	end
	if soonest == nil then
		f.BlockLock[side] = f.Time + PvpConfig.Block.MissLock
		table.insert(events, { Kind = "BlockMiss", Side = side, Amount = PvpConfig.Block.MissLock })
		return false, events
	end
	soonest.Guarded = true
	table.insert(events, { Kind = "Blocked", From = soonest.Id, Side = side })
	return true, events
end

-- Plays a fight to the end, both sides firing SPECIAL as soon as it is ready (tests and balance checks).
function PvpRules.simulate(f: Fight, rand: () -> number): number
	local t = 0
	while f.State == "Fighting" and t < PvpConfig.FightTime + 1 do
		PvpRules.step(f, TowerConfig.Tick, rand)
		for side = 1, 2 do
			PvpRules.useSpecial(f, side, rand())
		end
		t += TowerConfig.Tick
	end
	return f.Winner
end

export type Outcome = { Coins: number, Trophies: number, Xp: number, Streak: number }

-- What one side gets: `result` = "Win" | "Loss" | "Draw"; `trophies` and `streak` are the player's before the fight.
-- Trophies never go below 0.
function PvpRules.outcome(result: string, trophies: number, streak: number, vsBot: boolean): Outcome
	local R = PvpConfig.Rewards
	trophies = math.max(math.floor(trophies), 0)
	streak = math.max(math.floor(streak), 0)
	if result == "Win" then
		local s = streak + 1
		return {
			Coins = R.WinCoins + R.StreakCoins * math.min(s - 1, R.StreakCap),
			Trophies = if vsBot then R.BotWinTrophies else R.WinTrophies,
			Xp = R.WinXp,
			Streak = s,
		}
	elseif result == "Loss" then
		local lose = if vsBot then R.BotLossTrophies else R.LossTrophies
		return { Coins = R.LossCoins, Trophies = -math.min(lose, trophies), Xp = R.LossXp, Streak = 0 }
	end
	return { Coins = R.DrawCoins, Trophies = 0, Xp = R.LossXp, Streak = streak }
end

-- What the side that stayed gets when the rival leaves mid-fight: a real "Win" only once the fight has run
-- PvpConfig.ForfeitWinAfter seconds; a quit in the count-in or the first seconds pays a "Draw" (no trophies, no streak,
-- no free-egg progress), so a second account cannot feed wins by leaving at once.
function PvpRules.forfeitResult(phase: string, fightTime: number): string
	if phase == "Fighting" and type(fightTime) == "number" and fightTime >= PvpConfig.ForfeitWinAfter then
		return "Win"
	end
	return "Draw"
end

-- Rank for a trophy count: (rank, next rank or nil).
function PvpRules.rank(trophies: number)
	local cur, nxt = PvpConfig.Ranks[1], nil
	for i, r in PvpConfig.Ranks do
		if trophies >= r.Min then
			cur = r
			nxt = PvpConfig.Ranks[i + 1]
		end
	end
	return cur, nxt
end

-- Training: (level before, level after, new xp) for adding `gain` XP to `xp`; `cap` = PetStats.cap(pet).
function PvpRules.train(xp: number, gain: number, cap: number?): (number, number, number)
	local before = PetStats.level(xp, cap)
	local now = math.max(xp, 0) + math.max(gain, 0)
	return before, (PetStats.level(now, cap)), now
end

-- True when the pet cannot train any higher (its rarity's level cap).
function PvpRules.maxed(pet: Pet, xp: number?): boolean
	return (PetStats.level(xp, PetStats.cap(pet))) >= PetStats.cap(pet)
end

-- ARENA BOARD --------------------------------------------------------------------------------------------------

export type Win = { Winner: string, Loser: string, WinnerPower: number, LoserPower: number, Day: number }

-- How big a win is: the loser's team power over the winner's (above 1 = an upset).
function PvpRules.winScore(w: Win): number
	return w.LoserPower / math.max(w.WinnerPower, 1)
end

-- The day's biggest win after `cand` (a new day starts over); ties keep the older one.
function PvpRules.biggerWin(best: Win?, cand: Win): Win
	if best == nil or best.Day ~= cand.Day or PvpRules.winScore(cand) > PvpRules.winScore(best) then
		return cand
	end
	return best
end

-- EVOLVE -------------------------------------------------------------------------------------------------------

export type EvolvePet = { Id: string, Mineral: string, Rarity: string, Evolve: number?, Favorite: boolean? }

-- Can `pet` evolve? It must sit at its level cap, below the last stage, and the player must own Copies - 1 other
-- copies of the same species and rarity at the same stage that are free to use up: not `locked` (following, on the
-- plot, in the battle team), not favourites. Returns (ok, reason, the copies to use: lowest XP first).
-- reason: "Stage" (fully evolved), "Level" (not at the cap yet), "Copies" (not enough free copies).
function PvpRules.evolveCheck(pet: EvolvePet, xpOf: (string) -> number, inventory: { EvolvePet }, locked: { [string]: boolean }): (boolean, string?, { string }, number)
	local stage = PetStats.stage(pet)
	local free: { EvolvePet } = {}
	for _, g in inventory do
		if g.Id ~= pet.Id and g.Mineral == pet.Mineral and g.Rarity == pet.Rarity and PetStats.stage(g) == stage
			and not locked[g.Id] and g.Favorite ~= true then
			table.insert(free, g)
		end
	end
	table.sort(free, function(a, b)
		local xa, xb = xpOf(a.Id), xpOf(b.Id)
		if xa ~= xb then
			return xa < xb
		end
		return a.Id < b.Id
	end)
	local need = TowerConfig.Evolve.Copies - 1
	local use = {}
	for i = 1, math.min(need, #free) do
		table.insert(use, free[i].Id)
	end
	if stage >= TowerConfig.Evolve.MaxStage then
		return false, "Stage", use, #free
	end
	if not PvpRules.maxed(pet :: any, xpOf(pet.Id)) then
		return false, "Level", use, #free
	end
	if #use < need then
		return false, "Copies", use, #free
	end
	return true, nil, use, #free
end

-- Why a battle search ended without a fight -> the one line the player sees (audit F24: every exit has one clear
-- reason). nil = say nothing (the player is gone, or a fight is starting).
local UNQUEUE_TEXT: { [string]: string } = {
	Cancel = "Battle search cancelled.",
	Hunt = "Battle search stopped: you joined a hunt.",
	Busy = "Battle search stopped: finish what you are doing first.",
	NoTeam = "Battle search stopped: hatch a pet first! Pets fight in battles.",
}
function PvpRules.unqueueText(why: string?): string?
	return if why then UNQUEUE_TEXT[why] else nil
end

return PvpRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="182">
        <Properties>
          <string name="Name">Quests</string>
          <string name="Source"><![CDATA[--!strict
-- Daily gift and daily quests as pure rules (no Roblox services; tests/test_progress.luau drives them).
-- The server (src/server/QuestService.luau) owns the state in the profile (`Daily`) and decides every reward;
-- clients only see Quests.view and send "claim" intents.
--
-- Days are whole UTC days since the Unix epoch (Quests.day(os.time())). Each player gets one race (egg hunt), one
-- tower and one pet quest per day, picked deterministically from (user id, day), so a rejoin or another server shows the same quests.
-- Progress resets when the day changes; nothing carries over.

local ProgressConfig = require(script.Parent.ProgressConfig)
local Retention = require(script.Parent.Retention)

local Quests = {}

export type Daily = {
	Day: number, -- the day Progress / Claimed belong to
	Progress: { number },
	Claimed: { boolean },
	GiftDay: number, -- last day the gift was claimed (0 = never)
	Streak: number, -- consecutive gift days up to GiftDay
	Shields: number, -- streak shields (Retention.Streak): each one saves the streak after one missed day
}

export type Quest = { Index: number, Kind: string, Group: string, Goal: number, Reward: number, Text: string }

function Quests.day(unixTime: number): number
	return math.floor(unixTime / 86400)
end

function Quests.empty(): Daily
	return { Day = 0, Progress = {}, Claimed = {}, GiftDay = 0, Streak = 0, Shields = 0 }
end

-- Small deterministic generator (Park-Miller), independent of Roblox's Random so the same quests come out everywhere.
local function rng(seed: number): () -> number
	local s = seed % 2147483647
	if s <= 0 then
		s += 2147483646
	end
	for _ = 1, 4 do
		s = (s * 48271) % 2147483647
	end
	return function(): number
		s = (s * 48271) % 2147483647
		return s / 2147483647
	end
end

-- Every possible day: one (kind, goal) option per quest group (ProgressConfig.QuestGroups: Race, Tower, Pet),
-- in group order. Built once.
type Option = { Kind: number, Goal: number }
local combos: { { Option } } = {}
do
	local perGroup: { { Option } } = {}
	for gi, group in ProgressConfig.QuestGroups do
		perGroup[gi] = {}
		for ki, k in ProgressConfig.QuestKinds do
			if k.Group == group then
				for g = 1, #k.Goals do
					table.insert(perGroup[gi], { Kind = ki, Goal = g })
				end
			end
		end
		assert(#perGroup[gi] > 0, "quest group without quests: " .. group)
	end
	local pick: { Option } = {}
	local function walk(gi: number)
		if gi > #perGroup then
			table.insert(combos, table.clone(pick))
			return
		end
		for _, o in perGroup[gi] do
			pick[gi] = o
			walk(gi + 1)
		end
		pick[gi] = nil
	end
	walk(1)
end

local function shift(userId: number, day: number): number
	local uid = math.abs(math.floor(userId)) % 2147483647
	return if rng((uid * 7919 + day * 104729 + 17) % 2147483647)() < 0.5 then 0 else 1
end

-- The quests of `userId` on `day`: one race, one tower and one pet quest, in that order. The day walks through every
-- combination: day d uses combination (base + 3d + s(d)) with s(d) in {0, 1}, so two days in a row are 2 to 4 steps
-- apart and never the same day (there are dozens of combinations).
function Quests.forDay(userId: number, day: number): { Quest }
	local uid = math.abs(math.floor(userId)) % 2147483647
	local count = #combos
	local base = uid % count
	local combo = combos[((base + 3 * day + shift(uid, day)) % count) + 1]
	local out: { Quest } = {}
	for i, o in combo do
		local k = ProgressConfig.QuestKinds[o.Kind]
		local goal = k.Goals[o.Goal]
		table.insert(out, {
			Index = i,
			Kind = k.Kind,
			Group = k.Group,
			Goal = goal,
			Reward = k.Reward[o.Goal],
			Text = if goal == 1 and k.One then k.One else string.format(k.Text, goal),
		})
	end
	return out
end

local function num(v: any, default: number): number
	return if type(v) == "number" and v == v and v > -math.huge and v < math.huge then v else default
end

-- Repairs a stored Daily (old save, hand edit) in place and returns it. Never invents progress.
function Quests.sanitize(d: any): Daily
	if type(d) ~= "table" then
		return Quests.empty()
	end
	d.Day = math.floor(num(d.Day, 0))
	d.GiftDay = math.floor(num(d.GiftDay, 0))
	d.Streak = math.max(0, math.floor(num(d.Streak, 0)))
	d.Shields = math.clamp(math.floor(num(d.Shields, 0)), 0, Retention.Streak.MaxShields)
	if type(d.Progress) ~= "table" then
		d.Progress = {}
	end
	if type(d.Claimed) ~= "table" then
		d.Claimed = {}
	end
	for i = 1, ProgressConfig.QuestsPerDay do
		d.Progress[i] = math.max(0, math.floor(num(d.Progress[i], 0)))
		d.Claimed[i] = d.Claimed[i] == true
	end
	return d :: Daily
end

-- Moves the quest state to `today` (fresh progress on a new day). Returns true when it changed.
function Quests.rollover(d: Daily, today: number): boolean
	if d.Day == today then
		return false
	end
	d.Day = today
	d.Progress = {}
	d.Claimed = {}
	for i = 1, ProgressConfig.QuestsPerDay do
		d.Progress[i] = 0
		d.Claimed[i] = false
	end
	return true
end

-- Counts `n` toward every unfinished quest of `kind` today. Returns true when any progress changed.
function Quests.bump(d: Daily, userId: number, today: number, kind: string, n: number?): boolean
	local add = math.floor(num(n, 1))
	if add <= 0 then
		return false
	end
	local changed = Quests.rollover(d, today)
	for i, q in Quests.forDay(userId, today) do
		if q.Kind == kind and not d.Claimed[i] and d.Progress[i] < q.Goal then
			d.Progress[i] = math.min(q.Goal, d.Progress[i] + add)
			changed = true
		end
	end
	return changed
end

-- Claims quest `index` for today. Returns (coins, nil) or (nil, reason). Each quest pays once.
function Quests.claim(d: Daily, userId: number, today: number, index: any): (number?, string?)
	Quests.rollover(d, today)
	if type(index) ~= "number" or index ~= index or index % 1 ~= 0 then
		return nil, "BadQuest"
	end
	local q = Quests.forDay(userId, today)[index]
	if not q then
		return nil, "BadQuest"
	end
	if d.Claimed[index] then
		return nil, "Claimed"
	end
	if d.Progress[index] < q.Goal then
		return nil, "NotDone"
	end
	d.Claimed[index] = true
	return q.Reward, nil
end

-- The streak the next gift claim would reach on `today`, and whether a streak shield would be used for it.
-- One missed day (last claim two days ago) keeps the streak when a shield is left (Retention.Streak).
local function nextStreak(d: Daily, today: number): (number, boolean)
	if d.GiftDay == today - 1 then
		return d.Streak + 1, false
	elseif d.GiftDay == today - 2 and d.Streak > 0 and (d.Shields or 0) > 0 then
		return d.Streak + 1, true
	end
	return 1, false
end
Quests.nextStreak = nextStreak

-- The streak day (1..7) the next gift claim would pay, as seen on `today`.
function Quests.giftStreakDay(d: Daily, today: number): number
	local cycle = #ProgressConfig.DailyGift
	if d.GiftDay == today then
		return ((math.max(d.Streak, 1) - 1) % cycle) + 1 -- already claimed: the day just paid
	end
	local streak = nextStreak(d, today)
	return ((streak - 1) % cycle) + 1
end

-- Coins the gift pays on streak day `streak` (the 7-day table times the growing streak multiplier).
function Quests.giftCoins(streak: number): number
	local cycle = #ProgressConfig.DailyGift
	local sd = ((math.max(streak, 1) - 1) % cycle) + 1
	return math.floor(ProgressConfig.DailyGift[sd] * Retention.streakMult(streak))
end

-- Claims today's gift. Returns (coins, streakDay, nil, shieldUsed) or (nil, nil, reason). Once per UTC day.
-- Every Retention.Streak.ShieldEvery streak days earn a shield (up to MaxShields).
function Quests.claimGift(d: Daily, today: number): (number?, number?, string?, boolean?)
	if d.GiftDay == today then
		return nil, nil, "Claimed"
	end
	if d.GiftDay > today then
		return nil, nil, "Clock" -- a save from a server whose clock ran ahead: wait for that day
	end
	local streak, shield = nextStreak(d, today)
	if shield then
		d.Shields -= 1
	end
	d.Streak = streak
	d.GiftDay = today
	local st = Retention.Streak
	if streak % st.ShieldEvery == 0 and (d.Shields or 0) < st.MaxShields then
		d.Shields = (d.Shields or 0) + 1
	end
	local sd = ((d.Streak - 1) % #ProgressConfig.DailyGift) + 1
	return Quests.giftCoins(streak), sd, nil, shield
end

export type View = {
	Day: number,
	NextReset: number, -- unix time the quests and gift turn over (UTC midnight)
	Quests: { { Text: string, Kind: string, Group: string, Goal: number, Progress: number, Reward: number, Claimed: boolean, Done: boolean } },
	-- Streak = the streak this claim reaches (or reached today), Shields = streak shields left, Mult = gift multiplier
	Gift: { Ready: boolean, StreakDay: number, Reward: number, Rewards: { number }, Streak: number, Shields: number, Mult: number },
	Claimable: number, -- quests done and unclaimed, plus 1 when the gift is ready (HUD dot)
}

-- What the client sees (no seeds, nothing it could use to cheat; it is all the player's own data anyway).
function Quests.view(d: Daily, userId: number, today: number): View
	local fresh = d.Day ~= today
	local list = {}
	local claimable = 0
	for i, q in Quests.forDay(userId, today) do
		local p = if fresh then 0 else math.min(q.Goal, d.Progress[i] or 0)
		local claimed = not fresh and d.Claimed[i] == true
		local done = p >= q.Goal
		if done and not claimed then
			claimable += 1
		end
		table.insert(list, { Text = q.Text, Kind = q.Kind, Group = q.Group, Goal = q.Goal, Progress = p, Reward = q.Reward, Claimed = claimed, Done = done })
	end
	local ready = d.GiftDay < today
	if ready then
		claimable += 1
	end
	local sd = Quests.giftStreakDay(d, today)
	local streak = if ready then (nextStreak(d, today)) else math.max(d.Streak, 1)
	return {
		Day = today,
		NextReset = (today + 1) * 86400,
		Quests = list,
		Gift = {
			Ready = ready,
			StreakDay = sd,
			Reward = Quests.giftCoins(streak),
			Rewards = table.clone(ProgressConfig.DailyGift),
			Streak = streak,
			Shields = d.Shields or 0,
			Mult = Retention.streakMult(streak),
		},
		Claimable = claimable,
	}
end

return Quests
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="183">
        <Properties>
          <string name="Name">QueueConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Tuning for the public hunt queue (lobby portal / PLAY button) and the round extras that come with it
-- (bonus common pets for helpers, friends luck). Kept apart from Config so the queue can be tuned alone.

local QueueConfig = {}

-- Public queue: up to Size players per hunt; the hunt starts Seconds after the first player joins with whoever
-- is there (1..Size). A full queue starts at once when StartWhenFull is on. A joiner who does not fit starts the
-- next queue. When a start fails (all quarries busy, someone still spawning) the queue waits RetrySeconds and tries
-- again.
QueueConfig.Size = 4
QueueConfig.Seconds = 20
QueueConfig.StartWhenFull = true
QueueConfig.RetrySeconds = 5
-- Touching a portal pad more often than this does nothing (one join per touch burst).
QueueConfig.TouchDebounce = 1.5
-- After LEAVE, a player standing on a portal pad is not queued again until they are this many studs off every pad.
QueueConfig.PadClear = 4

-- Lobby queue board and pads (built by the lobby builder; all optional).
QueueConfig.Board = {
	Idle = "STEP ON TO PLAY",
	Counting = "HUNT IN %ds  (%d/%d)", -- seconds left, queued, size
	PadLit = Color3.fromRGB(110, 230, 120),
}

-- Non-finders who cracked at least MinCracked eggs in a round get a Chance (0..1) of a Common pet of that zone.
-- Not a win, not a find; never auto-follows. Practice rounds never roll it.
QueueConfig.Bonus = {
	MinCracked = 5,
	Chance = 0.05,
}

-- Friend bonus (owner pick): the finder gets PerFriend extra Luck for every Roblox friend of theirs in the same server
-- (lobby or hunt), counting at most MaxFriends (so +30% at most). Luck only lifts the odds of a Rare or better pet
-- (GeodeGen); it never changes which egg hides the pet or who finds it. Practice rounds get none.
QueueConfig.FriendLuck = {
	PerFriend = 0.10,
	MaxFriends = 3,
}

return QueueConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="184">
        <Properties>
          <string name="Name">RaceRules</string>
          <string name="Source"><![CDATA[--!strict
-- Race bar standings (pure, tests/test_race.luau). Input: the station views the server sends with every pile
-- update ({ UserId, Index, Cracked }) and the member list ({ UserId, Name, Present }). Output: one row per
-- member, most eggs cracked first (ties keep station order), with a 0..1 bar share of the leader's count.
-- Uses only per-player crack counts: nothing here says which egg hides the pet.

local RaceRules = {}

export type Row = { UserId: number, Name: string, Cracked: number, Share: number, Present: boolean, Leader: boolean }

function RaceRules.standings(stations: { any }?, members: { any }?): { Row }
	local counts: { [number]: number } = {}
	local order: { [number]: number } = {}
	local stList: { any } = stations or {}
	for _, st in stList do
		if type(st) == "table" and type(st.UserId) == "number" then
			counts[st.UserId] = math.max(0, math.floor(tonumber(st.Cracked) or 0))
			order[st.UserId] = tonumber(st.Index) or 99
		end
	end
	local rows: { Row } = {}
	local memList: { any } = members or {}
	for i, mem in memList do
		local uid = mem.UserId
		if type(uid) == "number" then
			table.insert(rows, {
				UserId = uid,
				Name = tostring(mem.Name or "?"),
				Cracked = counts[uid] or math.max(0, math.floor(tonumber(mem.Cracked) or 0)),
				Share = 0,
				Present = mem.Present ~= false,
				Leader = false,
			})
			if order[uid] == nil then
				order[uid] = 100 + i
			end
		end
	end
	table.sort(rows, function(a, b)
		if a.Cracked ~= b.Cracked then
			return a.Cracked > b.Cracked
		end
		return order[a.UserId] < order[b.UserId]
	end)
	local top = if rows[1] then rows[1].Cracked else 0
	for i, r in rows do
		r.Share = if top > 0 then r.Cracked / top else 0
		r.Leader = i == 1 and top > 0 and (rows[2] == nil or rows[2].Cracked < top)
	end
	return rows
end

return RaceRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="185">
        <Properties>
          <string name="Name">ResultsRules</string>
          <string name="Source"><![CDATA[--!strict
-- RESULTS RULES: what the hunt results card leads with and which few lines it shows (pure; tests/test_results_rules.luau).
-- The card's job is "go again": the primary (gold) button is PLAY AGAIN (READY! once a party member tapped it), or
-- TRAIN PET while the tutorial runs (find -> train -> fight, owner pick 2026-10-14). Selling candy is never the
-- primary button and never a button on this card (walkthrough 2026-10-14 #12: "GO SELL SHELLS" led the card).
-- Details are capped at MaxLines short rows: the reward line first, then one stat row, then the party lines.

local ResultsRules = {}

export type Primary = "PlayAgain" | "Ready" | "TrainPet"
export type Ctx = {
	Tutorial: boolean, -- the tutorial is still running (profile.OnboardDone false)
	Leader: boolean, -- this player starts the rematch
	Ready: boolean, -- a member who already tapped PLAY AGAIN
	Racers: number, -- players in the results
}

ResultsRules.MaxLines = 3

ResultsRules.Label = {
	PlayAgain = "PLAY AGAIN",
	Ready = "READY!",
	TrainPet = "TRAIN PET",
} :: { [string]: string }

function ResultsRules.primary(c: Ctx): Primary
	if c.Tutorial then
		return "TrainPet"
	end
	if not c.Leader and c.Ready then
		return "Ready"
	end
	return "PlayAgain"
end

-- The detail rows, in order, at most MaxLines: "Reward" (pet added / who hatched it), "Stats" (eggs hatched + candy
-- in one row), "Racers" (party hunts only). The bag strip, the pile-left line and the tutorial stage chips' extra
-- captions are left out: they were the tiny lines (bug #227).
function ResultsRules.lines(c: Ctx): { string }
	local out = { "Reward", "Stats" }
	if c.Racers > 1 and not c.Tutorial then
		table.insert(out, "Racers")
	end
	while #out > ResultsRules.MaxLines do
		table.remove(out)
	end
	return out
end

return ResultsRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="186">
        <Properties>
          <string name="Name">Retention</string>
          <string name="Source"><![CDATA[--!strict
-- First five minutes and comeback hooks as pure rules (no Roblox services; tests/test_retention.luau drives them).
-- The server (src/server/RetentionService.luau) owns the state in the profile (`Retention`) and decides every reward;
-- clients only see Retention.view and send intents ("Starter", "Gift").
--
-- Every reward here is in-game COINS or a pet rolled by the server, never Robux, and nothing here changes which egg
-- hides the hunt pet or who finds it.
--
--   Starter egg   one free egg near the lobby spawn; its pet is always Rare or better (never the 1 in 1000 chase pet).
--   Play gifts    free gifts after 1, 3, 5 and 10 minutes of play each UTC day (a timer shows the next one).
--   Away nest     coming back after a while: eggs "hatched while you were away" pay coins (and a Common pet after a
--                 long break); a big welcome-back gift after several days away.
--   Friend gift   a Roblox friend in the same server: coins once per friend per day (a few friends a day).
--   Group gift    members of the owner's Roblox group get a daily coin gift (off until the owner sets GroupId).

local PopupRules = require(script.Parent.PopupRules)

local Retention = {}

Retention.Starter = {
	Tier = "Gravel", -- the first zone (Meadow)
	-- Rare or better, never Legendary (the zone's Legendary is its 1 in 1000 chase pet; it must stay the dream)
	Weights = { Rare = 85, Epic = 15 } :: { [string]: number },
}

Retention.PlayGifts = {
	Marks = { 60, 180, 300, 600 }, -- seconds played today
	Coins = { 50, 100, 150, 400 },
	TickMax = 15, -- a single play-time tick never adds more than this (a stalled server cannot jump the clock)
}

Retention.Away = {
	MinSeconds = 30 * 60, -- shorter breaks are not "away"
	HoursCap = 12, -- coins stop growing after this many hours
	EggEverySeconds = 4 * 3600, -- one nest egg hatches per 4 hours away (at least one once away counts)
	MaxEggs = 3,
	CoinsPerEgg = 60,
	PetAfterSeconds = 8 * 3600, -- a long break (8 h+) also hatches one Common pet
	WelcomeBackSeconds = 3 * 86400, -- 3 days or more away
	WelcomeBackCoins = 500,
}

Retention.Friend = { Coins = 50, MaxPerDay = 3 }

-- REPLACE: the owner's Roblox group id (Creator Dashboard / roblox.com/groups/<id>). 0 = the group gift is off.
Retention.Group = { Id = 0, Coins = 100 }

-- Daily streak extras on top of ProgressConfig.DailyGift (shared/Quests applies them):
--   every full week of streak adds WeekBonus to the gift multiplier (up to MaxMult), and every ShieldEvery streak
--   days earn one streak shield (up to MaxShields). A shield is used up to save the streak after one missed day.
Retention.Streak = { WeekBonus = 0.25, MaxMult = 2, ShieldEvery = 7, MaxShields = 1 }

export type PlayState = { Day: number, Seconds: number, Claimed: number }
export type FriendState = { Day: number, Ids: { number } }
export type State = {
	LastSeen: number, -- os.time the player was last seen in a server (saved with the profile)
	Play: PlayState,
	Friend: FriendState,
	GroupDay: number, -- last UTC day the group gift was paid
}

local function num(v: any, default: number): number
	local n = tonumber(v)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return default
	end
	return n
end

function Retention.day(unixTime: number): number
	return math.floor(unixTime / 86400)
end

function Retention.empty(): State
	return {
		LastSeen = 0,
		Play = { Day = 0, Seconds = 0, Claimed = 0 },
		Friend = { Day = 0, Ids = {} },
		GroupDay = 0,
	}
end

-- Repairs a stored State (old save, hand edit) in place and returns it. Never invents progress.
function Retention.sanitize(s: any): State
	if type(s) ~= "table" then
		return Retention.empty()
	end
	s.LastSeen = math.max(0, math.floor(num(s.LastSeen, 0)))
	if type(s.Play) ~= "table" then
		s.Play = { Day = 0, Seconds = 0, Claimed = 0 }
	end
	s.Play.Day = math.floor(num(s.Play.Day, 0))
	s.Play.Seconds = math.max(0, num(s.Play.Seconds, 0))
	s.Play.Claimed = math.clamp(math.floor(num(s.Play.Claimed, 0)), 0, #Retention.PlayGifts.Marks)
	if type(s.Friend) ~= "table" then
		s.Friend = { Day = 0, Ids = {} }
	end
	s.Friend.Day = math.floor(num(s.Friend.Day, 0))
	if type(s.Friend.Ids) ~= "table" then
		s.Friend.Ids = {}
	end
	local ids = {}
	for _, id in s.Friend.Ids do
		if type(id) == "number" and #ids < Retention.Friend.MaxPerDay then
			table.insert(ids, id)
		end
	end
	s.Friend.Ids = ids
	s.GroupDay = math.floor(num(s.GroupDay, 0))
	return s :: State
end

-- Play gifts ------------------------------------------------------------------------------------

local function rollPlay(p: PlayState, today: number)
	if p.Day ~= today then
		p.Day = today
		p.Seconds = 0
		p.Claimed = 0
	end
end

-- Adds `dt` seconds of play on `today` (clamped per tick). Returns true when a gift just became ready.
function Retention.tickPlay(s: State, today: number, dt: number): boolean
	local p = s.Play
	rollPlay(p, today)
	local before = Retention.readyGifts(s, today)
	p.Seconds += math.clamp(num(dt, 0), 0, Retention.PlayGifts.TickMax)
	return Retention.readyGifts(s, today) > before
end

-- How many play gifts are earned and not claimed yet.
function Retention.readyGifts(s: State, today: number): number
	local p = s.Play
	if p.Day ~= today then
		return 0
	end
	local earned = 0
	for _, mark in Retention.PlayGifts.Marks do
		if p.Seconds >= mark then
			earned += 1
		end
	end
	return math.max(0, earned - p.Claimed)
end

-- The next gift: (index, seconds until it is ready; 0 = ready now) or nil when every gift today is claimed.
function Retention.nextGift(s: State, today: number): (number?, number)
	local p = s.Play
	local claimed = if p.Day == today then p.Claimed else 0
	local secs = if p.Day == today then p.Seconds else 0
	local i = claimed + 1
	local mark = Retention.PlayGifts.Marks[i]
	if not mark then
		return nil, 0
	end
	return i, math.max(0, math.ceil(mark - secs))
end

-- Claims the oldest ready gift. Returns (coins, index, nil) or (nil, nil, reason).
function Retention.claimGift(s: State, today: number): (number?, number?, string?)
	rollPlay(s.Play, today)
	local i, left = Retention.nextGift(s, today)
	if not i then
		return nil, nil, "AllClaimed"
	end
	if left > 0 then
		return nil, nil, "NotYet"
	end
	s.Play.Claimed = i
	return Retention.PlayGifts.Coins[i], i, nil
end

-- Away nest -------------------------------------------------------------------------------------

export type AwayReward = { Seconds: number, Eggs: number, Coins: number, Pet: boolean, WelcomeBack: boolean }

-- What a player gets for coming back at `now` after last being seen at `lastSeen` (0 = brand new: nothing).
-- nil when the break is too short (or the clock went backwards).
function Retention.away(lastSeen: number, now: number): AwayReward?
	local a = Retention.Away
	if lastSeen <= 0 then
		return nil
	end
	local gone = now - lastSeen
	if gone < a.MinSeconds then
		return nil
	end
	local capped = math.min(gone, a.HoursCap * 3600)
	local eggs = math.clamp(math.floor(capped / a.EggEverySeconds), 1, a.MaxEggs)
	local welcome = gone >= a.WelcomeBackSeconds
	return {
		Seconds = gone,
		Eggs = eggs,
		Coins = eggs * a.CoinsPerEgg + (if welcome then a.WelcomeBackCoins else 0),
		Pet = gone >= a.PetAfterSeconds,
		WelcomeBack = welcome,
	}
end

-- Friend + group gifts --------------------------------------------------------------------------

-- Pays the friend gift for `friendId` on `today` if this friend was not paid today and the daily cap is not reached.
-- Returns the coins (0 = nothing).
function Retention.friendGift(s: State, today: number, friendId: number): number
	local f = s.Friend
	if f.Day ~= today then
		f.Day = today
		f.Ids = {}
	end
	if table.find(f.Ids, friendId) or #f.Ids >= Retention.Friend.MaxPerDay then
		return 0
	end
	table.insert(f.Ids, friendId)
	return Retention.Friend.Coins
end

-- Pays the group gift once per day when the group gift is on and the player is a member. Returns the coins.
function Retention.groupGift(s: State, today: number, member: boolean): number
	if Retention.Group.Id == 0 or not member or s.GroupDay >= today then
		return 0
	end
	s.GroupDay = today
	return Retention.Group.Coins
end

-- Streak extras (used by shared/Quests) ---------------------------------------------------------

-- Gift multiplier for a streak of `streak` days (week 1 = 1x, week 2 = 1.25x, ... up to MaxMult).
function Retention.streakMult(streak: number): number
	local st = Retention.Streak
	local weeks = math.max(0, math.floor((math.max(streak, 1) - 1) / 7))
	return math.min(st.MaxMult, 1 + weeks * st.WeekBonus)
end

-- Hunter level (a level-up pop for the first minutes; shown only, nothing is bought with it) -----------------
-- XP comes from what the player already did (profile Stats): eggs cracked, hunts played, pets found.
Retention.Level = { PerCrack = 1, PerHunt = 10, PerFind = 20, Step = 25 }

function Retention.xp(stats: any): number
	local l = Retention.Level
	if type(stats) ~= "table" then
		return 0
	end
	local finds = num(stats.SoloFinds, 0) + num(stats.MultiplayerWins, 0)
	return math.max(0, math.floor(num(stats.RocksCracked, 0) * l.PerCrack + num(stats.MatchesPlayed, 0) * l.PerHunt + finds * l.PerFind))
end

-- XP needed to reach `level` (level 1 = 0; each level asks Step more than the one before: 25, 75, 150, ...).
function Retention.levelXp(level: number): number
	local n = math.max(0, level - 1)
	return Retention.Level.Step * n * (n + 1) / 2
end

-- (level, xp into this level, xp this level needs) for `xp`.
function Retention.level(xp: number): (number, number, number)
	local lv = 1
	while Retention.levelXp(lv + 1) <= xp and lv < 999 do
		lv += 1
	end
	local from = Retention.levelXp(lv)
	return lv, xp - from, Retention.levelXp(lv + 1) - from
end

-- The dream (the "next goal" card after the first hatch) ------------------------------------------------------
-- The strongest a Void Dragon can get: Legendary, the best variant, the best roll, the top level (TowerConfig), so
-- the card's "Void Dragon: power N" is a real number from the same rules the tower fights with.
Retention.DreamSpecies = "CosmicDragon" -- "Void Dragon", the 1 in 1000 chase pet
-- Where the dream pet comes from, shown on the lobby statue (audit F22: the sign said "1 in 1000" but not where to
-- get it). The Space zone's Legendary hatch is always its chase pet; Legendary is 0.1% before luck boosts.
Retention.DreamZone = "Meteor" -- Config.Tiers id (shown as "Space")
Retention.DreamSource = "Hatch it from SPACE zone eggs!"
Retention.DreamHint = "The rarest pet. Base odds: 1 in 1000 Space zone eggs. Luck boosts raise it!"

function Retention.dreamPower(): number
	local TowerConfig = require(script.Parent.TowerConfig)
	local base = TowerConfig.Species[Retention.DreamSpecies] or TowerConfig.DefaultSpecies
	local bestVariant = 1
	for _, v in TowerConfig.VariantStat do
		bestVariant = math.max(bestVariant, v)
	end
	local grow = 1 + TowerConfig.Levels.LevelStat * (TowerConfig.Levels.Max - 1)
	return math.floor(base.Power * TowerConfig.RollMax * (TowerConfig.RarityStat.Legendary or 1) * bestVariant * grow + 0.5)
end

-- How far `power` is toward the dream, 0..1 (square root, so a first pet shows a sliver, not an empty bar).
function Retention.dreamProgress(power: number): number
	local dream = Retention.dreamPower()
	if dream <= 0 then
		return 1
	end
	return math.clamp(math.sqrt(math.max(0, power) / dream), 0, 1)
end

-- Client view -----------------------------------------------------------------------------------

export type View = { NextGift: number?, NextIn: number, Ready: number, GiftCoins: number?, Marks: { number }, Coins: { number } }

function Retention.view(s: State, today: number): View
	local i, left = Retention.nextGift(s, today)
	return {
		NextGift = i,
		NextIn = left,
		Ready = Retention.readyGifts(s, today),
		GiftCoins = if i then Retention.PlayGifts.Coins[i] else nil,
		Marks = table.clone(Retention.PlayGifts.Marks),
		Coins = table.clone(Retention.PlayGifts.Coins),
	}
end

-- Big welcome cards (NEXT GOAL, away nest) wait for a calm moment: never over a hunt, a tower climb or a Pet Battle
-- (Studio 2026-10-14: the NEXT GOAL card covered a fight). `busy` = the player's MatchKey / InTower / InBattle
-- attributes and whether a hunt round is open on the client.
-- One rule with every other popup: PopupRules (Card).
function Retention.calm(busy: { MatchKey: any?, InTower: any?, InBattle: any?, Match: any?, Held: boolean?, Shown: boolean? }): boolean
	return PopupRules.free("Card", busy)
end

-- FIRST PET RULE: a player's first pet only ever comes from their first hatch (the starter egg). Any pet that is given
-- for free (the away nest's Common pet, the Studio dev auto pet, DevPets.server attribute DevAutoPet) waits until
-- the save has hatched its starter egg, so a fresh save always sees "YOUR FIRST PET!" on its own hatch and never a
-- "New in your Pet Book" toast on join (walkthrough 2026-10-14 #1).
function Retention.freePetReady(data: any): boolean
	return type(data) == "table" and data.StarterPet == true
end

return Retention
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="187">
        <Properties>
          <string name="Name">RobuxConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Robux shop tuning (owner decision 2026-10-11): paid pet eggs, 15-minute luck potions and three game passes, plus
-- the free luck events (2x luck every UTC weekend, random server-wide "luck storms"). Everything the owner may want
-- to tune is in this file. The pure helpers below (receipt ledger, pass effects, product lookup) are shared by the
-- server (RobuxService, Profiles) and the shop panel, and are tested offline (tests/test_robux.luau).
--
-- IDS: every ProductId / PassId is 0 until the owner creates the product or pass on the Creator Hub and pastes its id
-- here (docs/OWNER_STEPS.md, "Robux shop"). An id of 0 is never prompted or granted; the shop shows "NOT FOR SALE
-- YET". Prices are never written here: the shop reads them from Roblox (MarketplaceService:GetProductInfo).

local Config = require(script.Parent.Config)

local RobuxConfig = {}

-- Paid eggs (owner, 2026-10-11): Basic, Rare and Mythic, each sold as 1x, 3x and 10x (a separate Developer Product per
-- count). Every egg hatches pets of the buyer's best unlocked zone (its species pool, equal chance) with their normal
-- boost, through GeodeGen.roll: same variant, pose and size odds as a race egg. Rarity: Basic uses the race egg odds
-- (Config.RarityWeights, Legendary 1 in 1000); Rare and Mythic use the better tables below (every rarity can still roll,
-- each table sums to 100). The shop prints the full odds on the egg card above the buy buttons.
-- A 3x / 10x buy is ONE receipt that grants 3 / 10 rolls; it is refused before the prompt if the Pet Book has no room.
-- Image: an owner picture of the egg for the shop (asset id; 0 / nil = the drawn 3D egg).
-- Limited eggs (owner pick 2026-10-15, idea 46): Limited = true, sold only while os.time() < EndsAt (0 = not on sale;
-- the shop hides it). ShinyOneIn: this egg's shiny chance (1 in N; nil = LaunchPerks.Shiny.OneIn).
export type Egg = {
	Id: string,
	Name: string,
	Rarity: { [string]: number }?,
	Products: { [number]: number },
	Image: number?,
	Limited: boolean?,
	EndsAt: number?,
	ShinyOneIn: number?,
}
RobuxConfig.EggCounts = { 1, 3, 10 }
RobuxConfig.Eggs = {
	-- Rarity = nil: the race egg odds (Config.RarityWeights)
	{ Id = "BasicEgg", Name = "Basic Egg", Rarity = nil, Products = { [1] = 0, [3] = 0, [10] = 0 } }, -- REPLACE the three Developer Product ids
	{
		Id = "RareEgg", Name = "Rare Egg",
		Rarity = { Common = 30, Uncommon = 35, Rare = 25, Epic = 9.5, Legendary = 0.5 },
		Products = { [1] = 0, [3] = 0, [10] = 0 }, -- REPLACE
	},
	{
		Id = "MythicEgg", Name = "Mythic Egg",
		Rarity = { Common = 11, Uncommon = 25, Rare = 40, Epic = 23, Legendary = 1 }, -- Legendary 1 in 100 (owner pick)
		Products = { [1] = 0, [3] = 0, [10] = 0 }, -- REPLACE
	},
} :: { Egg }

-- Limited-time eggs (idea 46), kept out of RobuxConfig.Eggs so the normal shop cards stay as they are; the shop shows
-- one as its own timed card (LaunchPerks.limitedView). RobuxConfig.egg / productKind find them too.
RobuxConfig.LimitedEggs = {
	-- Limited-time egg (idea 46): the Rare Egg's odds (never worse than race odds) plus a 1 in 10 shiny chance, sold
	-- only until EndsAt (unix seconds, UTC; 0 keeps it hidden). Product ids: carter's Creator Hub (2026-10-15).
	{
		Id = "SpookyEgg", Name = "Spooky Egg",
		Rarity = { Common = 30, Uncommon = 35, Rare = 25, Epic = 9.5, Legendary = 0.5 },
		Products = { [1] = 3718841224, [3] = 3718841562, [10] = 3718841645 },
		Limited = true,
		-- 1793577600 = 2026-11-02 00:00 UTC, the day after Halloween (default end, no date given by carter yet)
		EndsAt = 1793577600,
		ShinyOneIn = 10,
	},
} :: { Egg }

-- Is this egg sold right now? Every normal egg is; a limited egg only before its EndsAt.
function RobuxConfig.eggOnSale(egg: Egg, now: number): boolean
	if not egg.Limited then
		return true
	end
	return type(egg.EndsAt) == "number" and now < (egg.EndsAt :: number)
end

-- COIN eggs at the lobby EGG SHRINE (the hatch stand; owner choice 2026-10-14). The same three eggs (same odds, same
-- best-zone pets, same hatch show) for in-game coins. Robux never buys coins, so this never lets Robux buy pets
-- another way; the Robux eggs above stay as they are.
--
-- Price reasoning (Config.Tiers, Config.RarityWeights / RarityMult / ModifierMult / MassBands):
--   * A round's pay = the shells of the eggs you crack + the pet you find. The 150-egg pile hides the pet egg
--     anywhere, so on average it turns up about halfway: a solo hunter cracks about RoundEggs = 75 eggs, worth
--     75 x CashPerRubble coins (Meadow 150, Forest 375, Snow 900, Volcano 1875, Space 3750), and finds one race pet
--     worth on average GeodeBase x 1.55 (rarity) x 1.08 (variant) x 1.49 (size) = about 2.5 x GeodeBase if sold
--     (Meadow ~100, Space ~10000). So one round pays about: Meadow 250, Forest 750, Snow 2150, Volcano 5600,
--     Space 13700 coins (a party splits the shells, so party rounds pay less each).
--   * Upgrades for scale: Treat Bag 150, Forest unlock 500, Pet Whistle 1200, Snow unlock 3000, Auto Nest
--     6000, Volcano 25000, Space 100000, Mega Incubator 180000 (tests/test_grind_speed.luau paces them). A tower run to floor 10 pays about 15 x 55 = 825 + bosses.
--   * Basic egg = 1.5 rounds, Rare = 5x Basic, Mythic = 15x Basic (Rounds below), priced for the zone the egg hatches
--     from (the buyer's best zone, eggTier), rounded to two significant digits. Prices per egg:
--         zone     Basic   Rare     Mythic
--         Meadow     370    1,900    5,600
--         Forest   1,100    5,600   17,000
--         Snow     3,200   16,000   48,000
--         Volcano  8,400   42,000  130,000
--         Space   21,000  100,000  310,000
--     Every egg costs more than its pet sells for on average (the sell price is the pet's Value), so buying eggs to
--     sell the pets loses coins (checked in tests/test_coin_eggs.luau). 3x / 10x cost exactly 3 / 10 eggs (no bulk
--     discount, no surprises).
RobuxConfig.CoinEggs = {
	Panel = "EggShrine", -- client panel the shrine prompt opens (Main.client panels table)
	Counts = { 1, 3, 10 },
	RoundEggs = 75, -- eggs a solo hunter cracks in an average round (half the 150-egg pile)
	Rounds = { BasicEgg = 1.5, RareEgg = 7.5, MythicEgg = 22.5 }, -- rounds of coins per egg (Basic x1, x5, x15)
}

-- false: a bought egg uses the plain odds (exactly the odds printed on the card). true: the buyer's current luck
-- (pets, potion, weekend, storm; never friends luck) applies too, and the card shows the odds with that luck.
RobuxConfig.EggsUseLuck = false

-- Public hatch stand (owner pick): every bought egg is cracked at the stand by the shop (a part with attribute
-- HatchStand = true and an Attachment "HatchPoint") for everyone to watch, one show after another.
RobuxConfig.Show = {
	Seconds = 6, -- one show (egg wobble, crack, pet reveal) before the next one starts
	QueueMax = 25, -- shows waiting beyond this are skipped (the pets are granted anyway)
}

-- Luck potion: each one adds Seconds of potion time (stacking purchases extend the timer). The timer is server time
-- (os.time, UTC) saved in the profile, so it keeps running while the player is offline.
RobuxConfig.Potion = {
	Id = "LuckPotion",
	Name = "Luck Potion",
	ProductId = 0, -- REPLACE with the Developer Product id
	Seconds = 15 * 60,
	Luck = 1, -- +1 luck = Rare and better pets twice as likely (GeodeGen.rarityWeights)
	MaxStackSeconds = 6 * 60 * 60, -- no new potion can be bought while more than this is left
}

-- Game passes. Owned passes are remembered in the profile (Robux.Passes) and re-checked on join.
export type Pass = { Key: string, Name: string, PassId: number, Desc: string }
RobuxConfig.Passes = {
	DoubleCoins = { Key = "DoubleCoins", Name = "2x Coins", PassId = 0, Desc = "Candy sells for twice the coins." }, -- REPLACE
	ExtraPlots = { Key = "ExtraPlots", Name = "Extra Plots", PassId = 0, Desc = "10 more pet display spots on your plot." }, -- REPLACE
	PetStorage = { Key = "PetStorage", Name = "Pet Storage+", PassId = 0, Desc = "Keep more pets in your Pet Book." }, -- REPLACE
} :: { [string]: Pass }
RobuxConfig.Passes.VIP = { Key = "VIP", Name = "VIP", PassId = 2039996496, Desc = "Gold VIP name tag and +50% luck on every pet." }
RobuxConfig.Passes.AutoHatch = { Key = "AutoHatch", Name = "Auto Hatch", PassId = 2040326268, Desc = "The Egg Shrine keeps hatching your egg for you." }
RobuxConfig.Passes.TripleHatch = { Key = "TripleHatch", Name = "Open 3 Eggs", PassId = 2036792742, Desc = "Hatch 3 or 10 coin eggs at once." }
RobuxConfig.PassOrder = { "VIP", "DoubleCoins", "TripleHatch", "AutoHatch", "PetStorage", "ExtraPlots" }
RobuxConfig.VipLuck = 0.5 -- VIP: +0.5 luck (Rare and better pets 1.5x as likely), added like any other luck source

-- Coin egg counts that need a pass (idea 44). While that pass is still unsold (PassId 0) nobody is locked out.
RobuxConfig.CountPass = { [3] = "TripleHatch", [10] = "TripleHatch" } :: { [number]: string }

-- Auto hatch (idea 43): with the pass, the shrine re-buys the same coin egg every Show.Seconds while the player stays
-- near it, has the coins and Pet Book room. Stops after MaxHatches buys, on any refusal or when the player walks away.
RobuxConfig.Auto = { Every = 6, MaxHatches = 200 }

-- Starter pack (idea 41): one Developer Product, one buy per player (the shop hides it once bought; a receipt that
-- still arrives is granted anyway). 3 Rare Eggs (hatched like bought eggs) + 30 minutes of luck potion.
RobuxConfig.StarterPack = {
	Id = "StarterPack",
	Name = "Starter Pack",
	ProductId = 3718841132, -- carter's Creator Hub (2026-10-15)
	Eggs = { RareEgg = 3 } :: { [string]: number },
	PotionSeconds = 30 * 60,
}
RobuxConfig.CoinMult = 2 -- DoubleCoins: shell sell cash x2 (after the pet Coins boost)
RobuxConfig.ExtraPetSlots = 250 -- PetStorage: Pet Book holds Config.Inventory.Max + this
RobuxConfig.ExtraDisplaySlots = 10 -- ExtraPlots: display spots on the player's plot beyond the bought Config.Display level

-- Free luck events (LuckEvents). Luck is the GeodeGen "luck" number: +1 doubles the odds of Rare and better.
RobuxConfig.Events = {
	WeekendLuck = 1, -- every Saturday and Sunday (UTC): 2x luck for everyone
	StormLuck = 1, -- a luck storm: 2x luck for everyone on this server
	StormSeconds = 15 * 60,
	StormGapMin = 45 * 60, -- quiet time between storms (random in [min, max])
	StormGapMax = 120 * 60,
	FirstStormMin = 10 * 60, -- the first storm of a fresh server
	-- Lucky hour (idea 45): 2x luck for everyone, every day at these UTC hours (17 = 1 pm US East, 23 = 7 pm US East)
	LuckyHours = { 17, 23 },
	LuckyHourLuck = 1,
	LuckyHourMinutes = 60,
}

-- All luck sources add up (pets + friends + potion + weekend + storm) and the total is clamped here.
-- 4 = Rare and better weights at most 5x (owner pick: weekend + storm + potion = 3, so pet and friends luck still
-- count on top). Common/Uncommon weights don't scale, so Legendary at best is about 1 in 300, not 1 in 200.
RobuxConfig.MaxLuck = 4

RobuxConfig.ReceiptsKept = 300 -- newest PurchaseIds remembered per profile (Roblox retries recent receipts only)

-- Pure helpers -------------------------------------------------------------------------------------------------------

function RobuxConfig.emptyState(): { [string]: any }
	return { Receipts = {}, ReceiptOrder = {}, LuckUntil = 0, Passes = {}, EggsBought = 0, PotionsBought = 0, StarterPack = false }
end

-- Repairs a saved Robux table (missing or wrong-typed fields); never drops a receipt or an owned pass.
function RobuxConfig.sanitize(state: any): { [string]: any }
	local def = RobuxConfig.emptyState()
	if type(state) ~= "table" then
		return def
	end
	for k, v in def do
		if type(state[k]) ~= type(v) or (type(v) == "number" and state[k] ~= state[k]) then
			state[k] = v
		end
	end
	for k, v in state.Passes do
		if type(k) ~= "string" or v ~= true then
			state.Passes[k] = nil
		end
	end
	return state
end

function RobuxConfig.egg(id: any): Egg?
	for _, e in RobuxConfig.Eggs do
		if e.Id == id then
			return e
		end
	end
	for _, e in RobuxConfig.LimitedEggs do
		if e.Id == id then
			return e
		end
	end
	return nil
end

-- Base rarity weights of an egg (nil Rarity = the race egg odds).
function RobuxConfig.eggRarity(egg: Egg): { [string]: number }
	return egg.Rarity or (Config.RarityWeights :: any)
end

-- The zone a bought egg hatches from: the buyer's best unlocked zone (highest Order), Meadow when none.
function RobuxConfig.eggTier(unlocked: any): string
	local best, bestOrder = "Gravel", -math.huge
	for id, t in Config.Tiers :: any do
		if type(unlocked) == "table" and unlocked[id] and t.Order > bestOrder then
			best, bestOrder = id, t.Order
		end
	end
	return best
end

-- Coin eggs ------------------------------------------------------------------------------------------------------------

local function weightedMean(weights: { [string]: number }, mult: { [string]: number }): number
	local sum, total = 0, 0
	for k, w in weights do
		sum += w * (mult[k] or 1)
		total += w
	end
	return if total > 0 then sum / total else 1
end

-- Average sell value of a pet from an egg with these rarity weights in this zone (GeodeGen.value averaged over the
-- rarity, variant and size rolls).
function RobuxConfig.petMeanValue(tierId: string, rarity: { [string]: number }?): number
	local tier = (Config.Tiers :: any)[tierId]
	if not tier then
		return 0
	end
	local massW, mass = 0, 0
	for _, b in Config.MassBands do
		massW += b.Weight
		mass += b.Weight * (b.Min + b.Max) / 2
	end
	local meanMass = if massW > 0 then mass / massW else 1
	return tier.GeodeBase
		* weightedMean(rarity or (Config.RarityWeights :: any), Config.RarityMult :: any)
		* weightedMean(Config.ModifierWeights :: any, Config.ModifierMult :: any)
		* (0.75 + 0.25 * meanMass)
end

-- Coins an average solo round in this zone pays: the shells of RoundEggs eggs plus the race pet's average value.
function RobuxConfig.roundCoins(tierId: string): number
	local tier = (Config.Tiers :: any)[tierId]
	if not tier then
		return 0
	end
	return RobuxConfig.CoinEggs.RoundEggs * tier.CashPerRubble + RobuxConfig.petMeanValue(tierId, nil)
end

-- x rounded to two significant digits (374 -> 370, 20576 -> 21000).
local function nice(x: number): number
	if x <= 0 then
		return 0
	end
	local step = 10 ^ math.max(0, math.floor(math.log10(x)) - 1)
	return math.floor(x / step + 0.5) * step
end

-- Coin price of `count` eggs of this kind hatching from zone tierId; nil for an unknown egg / zone or a count the
-- shrine does not sell.
function RobuxConfig.eggCoinPrice(eggId: any, tierId: string, count: any): number?
	local rounds = RobuxConfig.CoinEggs.Rounds[eggId]
	if type(rounds) ~= "number" or not RobuxConfig.egg(eggId) or not (Config.Tiers :: any)[tierId] then
		return nil
	end
	if type(count) ~= "number" or not table.find(RobuxConfig.CoinEggs.Counts, count) then
		return nil
	end
	return count * nice(rounds * RobuxConfig.roundCoins(tierId))
end

-- The Pet Book refusal shared by both egg shops (nil = room for n more pets).
function RobuxConfig.roomRefusal(room: number, n: number): string?
	if room >= n then
		return nil
	end
	return if room <= 0 then "Your Pet Book is full." else "Your Pet Book only has room for " .. room .. " more pets."
end

-- Checks a coin egg buy (everything but the PolicyService gate, which the server checks first). Returns the price, or
-- nil and the refusal text (nil text = a malformed request, refused silently).
function RobuxConfig.coinEggCheck(eggId: any, count: any, tierId: string, cash: number, room: number): (number?, string?)
	local price = RobuxConfig.eggCoinPrice(eggId, tierId, count)
	if not price then
		return nil, nil
	end
	local full = RobuxConfig.roomRefusal(room, count)
	if full then
		return nil, full
	end
	if not (type(cash) == "number" and cash >= price) then
		return nil, "Need " .. (price - (if type(cash) == "number" then cash else 0)) .. " more coins."
	end
	return price, nil
end

-- The label, enabled flag and style of one coin buy button (client panel): "3x 1,500", a pending dots, "NO ROOM", or
-- "NEED N" (how many more coins) in gray. `fmt` formats numbers (UI.num).
function RobuxConfig.coinButton(count: number, price: number, cash: number, room: number, pending: boolean, fmt: (number) -> string): (string, boolean, string)
	if pending then
		return "\u{2026}", false, "gold"
	elseif room < count then
		return count .. "x  NO ROOM", false, "gold"
	elseif cash < price then
		return count .. "x  NEED " .. fmt(price - cash), true, "gray"
	end
	return count .. "x  " .. fmt(price), true, "gold"
end

-- What a Developer Product id buys: ("Egg", egg, count) | ("Potion", potion, 1) | nil. Id 0 (not created yet)
-- matches nothing.
-- Retired product ids whose late receipts must still grant: [oldId] = { Kind = "Egg", Egg = <egg id>, Count = n } or
-- { Kind = "Potion" }. Empty until an id is ever changed (only ever filled with ids the owner really used).
RobuxConfig.LegacyProducts = {} :: { [number]: { Kind: string, Egg: string?, Count: number? } }

function RobuxConfig.productKind(productId: any): (string?, any, number)
	if type(productId) ~= "number" or productId <= 0 then
		return nil, nil, 0
	end
	for _, list in { RobuxConfig.Eggs, RobuxConfig.LimitedEggs } do
		for _, e in list do
			for _, n in RobuxConfig.EggCounts do
				if e.Products[n] == productId then
					return "Egg", e, n
				end
			end
		end
	end
	if RobuxConfig.Potion.ProductId == productId then
		return "Potion", RobuxConfig.Potion, 1
	end
	if RobuxConfig.StarterPack.ProductId == productId then
		return "Pack", RobuxConfig.StarterPack, 1
	end
	local old = RobuxConfig.LegacyProducts[productId]
	if old then
		if old.Kind == "Potion" then
			return "Potion", RobuxConfig.Potion, 1
		end
		local egg = if old.Egg then RobuxConfig.egg(old.Egg) else nil
		if egg and old.Count and table.find(RobuxConfig.EggCounts, old.Count) then
			return "Egg", egg, old.Count
		end
	end
	return nil, nil, 0
end

function RobuxConfig.passKey(passId: any): string?
	if type(passId) ~= "number" or passId <= 0 then
		return nil
	end
	for key, p in RobuxConfig.Passes do
		if p.PassId == passId then
			return key
		end
	end
	return nil
end

-- Receipt ledger: true if this PurchaseId was already granted. remember() keeps the newest ReceiptsKept ids.
function RobuxConfig.granted(state: any, purchaseId: string): boolean
	return state.Receipts[purchaseId] == true
end

function RobuxConfig.remember(state: any, purchaseId: string)
	if state.Receipts[purchaseId] then
		return
	end
	state.Receipts[purchaseId] = true
	table.insert(state.ReceiptOrder, purchaseId)
	while #state.ReceiptOrder > RobuxConfig.ReceiptsKept do
		local old = table.remove(state.ReceiptOrder, 1)
		if old then
			state.Receipts[old] = nil
		end
	end
end

-- The pass a coin egg count needs, or nil (free for everyone, or that pass is not on sale yet).
function RobuxConfig.countPass(count: number): string?
	local key = RobuxConfig.CountPass[count]
	local pass = if key then RobuxConfig.Passes[key] else nil
	return if pass and pass.PassId > 0 then key else nil
end

function RobuxConfig.vipLuck(state: any): number
	return if RobuxConfig.hasPass(state, "VIP") then RobuxConfig.VipLuck else 0
end

-- One potion: the timer runs from now (or from the current end if one is still running).
function RobuxConfig.addPotion(state: any, now: number, seconds: number?)
	state.LuckUntil = math.max(state.LuckUntil or 0, now) + (seconds or RobuxConfig.Potion.Seconds)
	state.PotionsBought = (state.PotionsBought or 0) + 1
end

function RobuxConfig.potionLeft(state: any, now: number): number
	return math.max(0, (if type(state) == "table" then tonumber(state.LuckUntil) or 0 else 0) - now)
end

function RobuxConfig.hasPass(state: any, key: string): boolean
	return type(state) == "table" and type(state.Passes) == "table" and state.Passes[key] == true
end

function RobuxConfig.coinMult(state: any): number
	return if RobuxConfig.hasPass(state, "DoubleCoins") then RobuxConfig.CoinMult else 1
end

function RobuxConfig.inventoryMax(base: number, state: any): number
	return base + (if RobuxConfig.hasPass(state, "PetStorage") then RobuxConfig.ExtraPetSlots else 0)
end

-- Plot display spots: the bought display level plus the ExtraPlots pass (extra pets stand in the plot yard).
function RobuxConfig.displaySlots(base: number, state: any): number
	return base + (if RobuxConfig.hasPass(state, "ExtraPlots") then RobuxConfig.ExtraDisplaySlots else 0)
end

return RobuxConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="188">
        <Properties>
          <string name="Name">RoundRocks</string>
          <string name="Source"><![CDATA[--!strict
-- Pure rules of the V3 loop for ONE round (no Roblox services, so tests drive it directly):
--   shared pile -> pickup into a basket -> deposit at your own crushing table -> crush there.
-- The server owns one RoundRocks per round (src/server/RockService.luau). Clients never see
-- which rock is the target; they only get opaque rock ids, states, queues and counters.
--
-- Every rock has exactly one record and one state:
--   InPile -> Carried (basket) -> Queued (station tray) -> Processing (on the plate)
--          -> ResolvedOrdinary | ResolvedGeode
-- All transitions happen inside the validated operations below, so a rock can never exist in two
-- places, be claimed twice or be resolved twice. Times are `now` seconds on one monotonic clock
-- chosen by the caller (the server passes os.clock()). Positions are relative to the pile centre
-- and are read by the server, never sent by clients. docs/V3_LOOP.md has the full protocol.

local Config = require(script.Parent.Config)
local Pile = require(script.Parent.Pile)
local Materials = require(script.Parent.Materials)

local RoundRocks = {}
RoundRocks.__index = RoundRocks

export type Rock = {
	Id: number, -- opaque, round-scoped (the pile layout index; carries no information about the target)
	State: string, -- InPile | Carried | Queued | Processing | ResolvedOrdinary | ResolvedGeode
	Carrier: number?, -- user id while Carried
	Station: number?, -- owner user id while Queued / Processing
	Hp: number, -- hit points left (full whenever the rock is not being processed)
}

export type Member = {
	UserId: number,
	Index: number, -- station index 1..Config.Station.Count
	Tool: string,
	HelpRate: number, -- pet helper crack speed multiplier (1 = no helper; shared/HuntFun.Helper)
	Active: boolean,
	Basket: { number },
	Queue: { number },
	CarryCap: number, -- basket size for this member (basket upgrades; Config.Carry.Capacity to start)
	QueueCap: number, -- nest tray size for this member (nest upgrades; Config.Station.QueueCapacity to start)
	Current: number?, -- the rock on the plate
	Reserved: boolean, -- storage for one ordinary result is held for Current
	Machine: string?,
	Running: boolean,
	Complete: number?, -- machine: when Current finishes
	Remaining: number?, -- machine paused: seconds still needed
	ReadyAt: number, -- machine: when the previous rock finished (keeps the cadence exact)
	NextPick: number,
	NextDeposit: number,
	NextHit: number,
	Space: number, -- rubble storage left (the server refreshes it from the profile)
	Cracked: number,
	Rubble: number,
}

export type Event = {
	Kind: string, -- Pick | Return | Move | Deposit | Start | Hit | Done | Found
	UserId: number?,
	Id: number?,
	Ids: { number }?,
	Col: number?,
	From: number?, -- Move: the column the rock left
	Progress: number?,
	Duration: number?,
	Mat: string?, -- Done only: the material of the rock that just finished (told after completion, never before)
}

export type Result = {
	UserId: number,
	RockId: number,
	Kind: string, -- Hit | Cracked | Found
	Progress: number?,
	Material: string?, -- Cracked only: Materials.pick for this rock in this round
}

export type Core = typeof(setmetatable(
	{} :: {
		MatchKey: string,
		RoundId: number,
		Tier: string,
		Seed: number,
		Pile: Pile.Pile,
		Rocks: { Rock },
		Total: number,
		MaxHp: number,
		TargetId: number?, -- server-only, never rerolled
		MatSalt: number, -- server-only, fixes every rock's material for the round
		TutorialBreak: number?, -- practice only: the geode is the Nth rock crushed
		Practice: boolean,
		Broken: number, -- rocks resolved (crushed to completion)
		Phase: string,
		Winner: number?,
		Members: { [number]: Member },
		Order: { number }, -- user ids by station index
		Events: { Event },
	},
	RoundRocks
))

export type Options = {
	MatchKey: string,
	RoundId: number,
	Tier: string,
	Seed: number, -- public layout seed
	TargetRng: Random, -- server-only
	-- Carry / Queue: this member's basket and nest tray sizes (upgrades); omitted = the Config sizes.
	Members: { { UserId: number, Tool: string, Machine: string?, Station: number, Carry: number?, Queue: number? } },
	Tutorial: boolean?,
}

local STATE_IN_PILE, STATE_CARRIED, STATE_QUEUED, STATE_PROCESSING = "InPile", "Carried", "Queued", "Processing"
local STATE_ORDINARY, STATE_GEODE = "ResolvedOrdinary", "ResolvedGeode"
RoundRocks.States = { STATE_IN_PILE, STATE_CARRIED, STATE_QUEUED, STATE_PROCESSING, STATE_ORDINARY, STATE_GEODE }

-- Upgrade sizes are whole numbers in a sane range; anything else falls back to the base size.
local MAX_CAP = 64
local function capOf(v: any, default: number): number
	if type(v) ~= "number" or v ~= v or v < 1 then
		return default
	end
	return math.min(math.floor(v), MAX_CAP)
end

-- Station table centre relative to the pile centre: four evenly spaced on one circle, so every
-- table is the same distance from the pile and from its neighbours.
function RoundRocks.stationAngle(index: number): number
	return (index - 0.5) / Config.Station.Count * math.pi * 2
end

function RoundRocks.stationPosition(index: number): Vector3
	local a = RoundRocks.stationAngle(index)
	return Vector3.new(math.cos(a) * Config.Station.Radius, 0, math.sin(a) * Config.Station.Radius)
end

-- Seconds one rock takes in a machine.
function RoundRocks.machineSeconds(machineId: string): number
	local cfg = Config.Machines[machineId]
	return cfg.BatchSeconds / cfg.RocksPerBatch
end

function RoundRocks.new(opts: Options): Core
	local tier = Config.Tiers[opts.Tier]
	assert(tier, "unknown tier")
	local count = if opts.Tutorial then Config.Tutorial.Rocks else tier.Rocks
	local pile = Pile.new(count, tier.RockSize, tier.Radius, opts.Seed)
	local maxHp = if opts.Tutorial then 1 else tier.HP
	local rocks: { Rock } = {}
	for id = 1, count do
		rocks[id] = { Id = id, State = STATE_IN_PILE, Carrier = nil, Station = nil, Hp = maxHp }
	end
	local members: { [number]: Member } = {}
	local order: { number } = {}
	for _, m in opts.Members do
		-- Practice rounds never run machines (they would skip the lesson).
		local machine = if not opts.Tutorial and m.Machine and Config.Machines[m.Machine] then m.Machine else nil
		members[m.UserId] = {
			UserId = m.UserId,
			Index = m.Station,
			Tool = m.Tool,
			HelpRate = 1,
			Active = true,
			Basket = {},
			Queue = {},
			CarryCap = capOf(m.Carry, Config.Carry.Capacity),
			QueueCap = capOf(m.Queue, Config.Station.QueueCapacity),
			Current = nil,
			Reserved = false,
			Machine = machine,
			Running = true,
			Complete = nil,
			Remaining = nil,
			ReadyAt = -math.huge,
			NextPick = -math.huge,
			NextDeposit = -math.huge,
			NextHit = -math.huge,
			Space = math.huge,
			Cracked = 0,
			Rubble = 0,
		}
		table.insert(order, m.UserId)
	end
	table.sort(order, function(a, b)
		return members[a].Index < members[b].Index
	end)
	local self = setmetatable({
		MatchKey = opts.MatchKey,
		RoundId = opts.RoundId,
		Tier = opts.Tier,
		Seed = opts.Seed,
		Pile = pile,
		Rocks = rocks,
		Total = count,
		MaxHp = maxHp,
		TargetId = nil :: number?,
		MatSalt = 0,
		TutorialBreak = nil :: number?,
		Practice = opts.Tutorial == true,
		Broken = 0,
		Phase = "Waiting",
		Winner = nil :: number?,
		Members = members,
		Order = order,
		Events = {},
	}, RoundRocks)
	if opts.Tutorial then
		-- Practice only: the geode is one of the first few rocks CRUSHED (picking up does not count).
		self.TutorialBreak = opts.TargetRng:NextInteger(math.min(Config.Tutorial.TargetFrom, count), math.min(Config.Tutorial.TargetWithin, count))
	else
		-- Fixed for the whole round, chosen uniformly from every record. Never rerolled.
		self.TargetId = opts.TargetRng:NextInteger(1, count)
	end
	-- Server-only salt for Materials.pick, drawn after the target so the target sequence is unchanged.
	self.MatSalt = opts.TargetRng:NextInteger(1, 2 ^ 30)
	return self
end

-- Helpers ------------------------------------------------------------------------------------

local function emit(self: Core, ev: Event)
	table.insert(self.Events, ev)
end

local function validId(self: Core, id: any): boolean
	return type(id) == "number" and id == id and id % 1 == 0 and id >= 1 and id <= self.Total
end

local function flat(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

local function validPos(pos: any): boolean
	return typeof(pos) == "Vector3" and pos.X == pos.X and pos.Z == pos.Z and math.abs(pos.X) < 1e6 and math.abs(pos.Z) < 1e6
end

-- Round, phase and membership gate shared by every action.
local function gate(self: Core, uid: number, roundId: any): (Member?, string?)
	if roundId ~= self.RoundId then
		return nil, "StaleRound"
	end
	if self.Phase ~= "Searching" then
		return nil, "NotSearching"
	end
	local m = self.Members[uid]
	if not m or not m.Active then
		return nil, "NotMember"
	end
	return m, nil
end

local function available(m: Member): number
	return m.Space - (if m.Reserved then 1 else 0)
end

function RoundRocks.setPhase(self: Core, phase: string)
	self.Phase = phase
	if phase ~= "Searching" then
		-- Round over (found, ended): every pending machine job stops and pays nothing.
		for _, m in self.Members do
			m.Complete = nil
			m.Remaining = nil
		end
	end
end

function RoundRocks.setTool(self: Core, userId: number, tool: string)
	local m = self.Members[userId]
	if m and Config.Handhelds[tool] then
		m.Tool = tool
	end
end

-- The pet helper's crack speed bonus for a member (share, 0 = none; the server reads it from the helper pet).
function RoundRocks.setHelper(self: Core, userId: number, rateBonus: number)
	local m = self.Members[userId]
	if m and rateBonus == rateBonus then
		m.HelpRate = 1 + math.clamp(rateBonus, 0, 1)
	end
end

function RoundRocks.setSpace(self: Core, userId: number, space: number)
	local m = self.Members[userId]
	if m and space == space then
		m.Space = space
	end
end

-- A member's basket and nest tray sizes (the server reads them from the profile's upgrade levels). A smaller
-- size never takes rocks away: the basket and tray just accept no more until they are below it.
function RoundRocks.setCaps(self: Core, userId: number, carry: any, queue: any)
	local m = self.Members[userId]
	if m then
		m.CarryCap = capOf(carry, m.CarryCap)
		m.QueueCap = capOf(queue, m.QueueCap)
	end
end

function RoundRocks.activeCount(self: Core): number
	local n = 0
	for _, m in self.Members do
		if m.Active then
			n += 1
		end
	end
	return n
end

-- Counters. Unopened = every unresolved rock (pile, baskets, trays, plates); it only drops when a
-- rock is crushed to completion. Pile = rocks lying in the pile. Carrying = this member's basket.
-- Rubble (ordinary results in storage) is NOT here: it lives in the profile.
function RoundRocks.counters(self: Core, userId: number?): { [string]: number }
	local m = if userId then self.Members[userId] else nil
	return {
		Unopened = self.Total - self.Broken,
		Pile = self.Pile.Remaining,
		Carrying = if m then #m.Basket else 0,
		CarryCapacity = if m then m.CarryCap else Config.Carry.Capacity,
		Queue = if m then #m.Queue else 0, -- tray only; the plate is separate
		OnPlate = if m and m.Current then 1 else 0,
		QueueCapacity = if m then m.QueueCap else Config.Station.QueueCapacity,
	}
end

-- Pickup ---------------------------------------------------------------------------------------

-- Moves one rock from the pile into the member's basket. Returns nil on success or a reason.
function RoundRocks.pickup(self: Core, uid: number, roundId: any, rockId: any, pos: Vector3, now: number): string?
	local m, why = gate(self, uid, roundId)
	if not m then
		return why
	end
	if not validId(self, rockId) or not validPos(pos) then
		return "BadRock"
	end
	local cfg = Config.Carry
	if now < m.NextPick - cfg.PickupTolerance then
		return "TooFast"
	end
	local rock = self.Rocks[rockId :: number]
	if rock.State ~= STATE_IN_PILE then
		return "Gone" -- someone else has it (or it is resolved): never two owners
	end
	if #m.Basket >= m.CarryCap then
		return "BasketFull"
	end
	if not self.Pile:isPickable(rock.Id, cfg.ReachLevels) then
		return "Unreachable"
	end
	local rp = self.Pile:localPosition(rock.Id) :: Vector3
	if flat(rp, pos) > cfg.PickupRange + self.Pile.RockSize * 0.5 then
		return "TooFar"
	end
	if pos.Y ~= pos.Y or math.abs(rp.Y - pos.Y) > cfg.PickupHeight then
		return "TooFar" -- flying or perched far above (or below) the mound
	end
	m.NextPick = math.max(now, m.NextPick) + cfg.PickupInterval
	self.Pile:remove(rock.Id)
	rock.State = STATE_CARRIED
	rock.Carrier = uid
	rock.Station = nil
	table.insert(m.Basket, rock.Id)
	emit(self, { Kind = "Pick", UserId = uid, Id = rock.Id })
	return nil
end

-- Deposit -------------------------------------------------------------------------------------

export type DepositResult = { Moved: { number }, Left: number, Queue: number }

-- Moves the basket into the member's OWN station tray, in basket order, as many as fit. The rest
-- stays in the basket (Left). Returns (result, nil) or (nil, reason).
function RoundRocks.deposit(self: Core, uid: number, roundId: any, pos: Vector3, now: number): (DepositResult?, string?)
	local m, why = gate(self, uid, roundId)
	if not m then
		return nil, why
	end
	if not validPos(pos) then
		return nil, "BadPosition"
	end
	local cfg = Config.Station
	if flat(RoundRocks.stationPosition(m.Index), pos) > cfg.DepositRange then
		return nil, "TooFar"
	end
	if #m.Basket == 0 then
		return nil, "BasketEmpty"
	end
	if now < m.NextDeposit - cfg.DepositTolerance then
		return nil, "TooFast"
	end
	local free = m.QueueCap - #m.Queue
	if free <= 0 then
		return nil, "QueueFull"
	end
	m.NextDeposit = math.max(now, m.NextDeposit) + cfg.DepositInterval
	local moved: { number } = {}
	while #moved < free and #m.Basket > 0 do
		local id = table.remove(m.Basket, 1) :: number
		local rock = self.Rocks[id]
		rock.State = STATE_QUEUED
		rock.Carrier = nil
		rock.Station = uid
		table.insert(m.Queue, id)
		table.insert(moved, id)
	end
	emit(self, { Kind = "Deposit", UserId = uid, Ids = table.clone(moved) })
	return { Moved = moved, Left = #m.Basket, Queue = #m.Queue }, nil
end

-- Processing ----------------------------------------------------------------------------------

-- Moves the next queued rock onto the plate. Storage for one ordinary result is reserved FIRST,
-- for every rock alike (the geode included): with no room nothing starts, so a full bag can
-- never single out the target. Returns (true) or (false, reason).
local function tryStart(self: Core, m: Member, duration: number?): (boolean, string?)
	if m.Current then
		return true, nil
	end
	if #m.Queue == 0 then
		return false, "QueueEmpty"
	end
	if available(m) < 1 then
		return false, "StorageFull"
	end
	local id = table.remove(m.Queue, 1) :: number
	local rock = self.Rocks[id]
	rock.State = STATE_PROCESSING
	rock.Hp = self.MaxHp
	m.Current = id
	m.Reserved = true
	m.Complete = nil
	m.Remaining = nil
	emit(self, { Kind = "Start", UserId = m.UserId, Id = id, Duration = duration })
	return true, nil
end

-- The one place a rock is finished (hand hit or machine). Returns true when it was the target:
-- the round stops at once and that member wins.
local function finishRock(self: Core, m: Member, id: number, results: { Result }): boolean
	local rock = self.Rocks[id]
	rock.Hp = 0
	m.Current = nil
	m.Complete = nil
	m.Remaining = nil
	self.Broken += 1
	m.Cracked += 1
	local isTarget = id == self.TargetId or (self.TutorialBreak ~= nil and self.Broken == self.TutorialBreak)
	if isTarget then
		rock.State = STATE_GEODE
		self.TargetId = id
		self.Winner = m.UserId
		m.Reserved = false -- a geode releases the reservation and pays no rubble
		emit(self, { Kind = "Found", UserId = m.UserId, Id = id })
		table.insert(results, { UserId = m.UserId, RockId = id, Kind = "Found" })
		RoundRocks.setPhase(self, "RewardPending")
		return true
	end
	rock.State = STATE_ORDINARY
	m.Reserved = false -- consumed by the rubble below
	m.Rubble += 1
	m.Space -= 1
	local material = Materials.pick(self.MatSalt, self.RoundId, id)
	emit(self, { Kind = "Done", UserId = m.UserId, Id = id, Mat = material })
	table.insert(results, { UserId = m.UserId, RockId = id, Kind = "Cracked", Material = material })
	return false
end

local function isAutomatic(m: Member): boolean
	return m.Machine ~= nil and m.Running
end

local function progressOf(self: Core, m: Member, now: number?): number
	local id = m.Current
	if not id then
		return 0
	end
	if m.Complete and m.Machine and now then
		local dur = RoundRocks.machineSeconds(m.Machine)
		return math.clamp(1 - (m.Complete - now) / dur, 0, 1)
	end
	return math.clamp(1 - self.Rocks[id].Hp / self.MaxHp, 0, 1)
end

-- One hand-tool hit at the member's OWN station. A station with a running machine ignores hits.
-- The first hit puts the next queued rock on the plate. Returns (results, nil) or ({}, reason).
function RoundRocks.crush(self: Core, uid: number, roundId: any, pos: Vector3, now: number): ({ Result }, string?)
	local none: { Result } = {}
	local m, why = gate(self, uid, roundId)
	if not m then
		return none, why
	end
	if not validPos(pos) then
		return none, "BadPosition"
	end
	if isAutomatic(m) then
		return none, "Automatic"
	end
	if flat(RoundRocks.stationPosition(m.Index), pos) > Config.Station.CrushRange then
		return none, "TooFar"
	end
	local tool = Config.Handhelds[m.Tool] or Config.Handhelds.Hammer
	local step = 1 / (tool.Rate * m.HelpRate)
	if now < m.NextHit - Config.Match.CadenceTolerance then
		return none, "TooFast"
	end
	-- A valid hit first catches every machine up to `now`: a rock another station finished earlier is
	-- resolved (and paid) before this hit, and the hit never lands once a machine has found the geode.
	local results: { Result } = RoundRocks.tickMachines(self, now)
	if self.Phase ~= "Searching" then
		return results, nil
	end
	local ok, reason = tryStart(self, m)
	if not ok then
		return results, if #results == 0 then reason else nil
	end
	m.NextHit = math.max(now, m.NextHit) + step
	local id = m.Current :: number
	local rock = self.Rocks[id]
	rock.Hp -= tool.Damage
	if rock.Hp > 0 then
		local p = progressOf(self, m, nil)
		emit(self, { Kind = "Hit", UserId = uid, Id = id, Progress = p })
		table.insert(results, { UserId = uid, RockId = id, Kind = "Hit", Progress = p })
		return results, nil
	end
	finishRock(self, m, id, results)
	return results, nil
end

-- Machines ------------------------------------------------------------------------------------
-- One scheduler step (tickMachines) drives every machine in the round. A machine only ever
-- touches ITS station: it takes rocks from that station's queue, one at a time, and never reads
-- the pile or another station.

function RoundRocks.setMachine(self: Core, userId: number, machine: string?)
	local m = self.Members[userId]
	if not m or not m.Active or self.Practice then
		return
	end
	if machine ~= nil and not Config.Machines[machine] then
		return
	end
	m.Machine = machine
	m.Complete = nil -- a swap re-times the rock on the plate from scratch (no free progress)
	m.Remaining = nil
end

function RoundRocks.setMachineRunning(self: Core, userId: number, running: boolean, now: number)
	local m = self.Members[userId]
	if not m or not m.Machine or m.Running == running then
		return
	end
	if not running and m.Complete then
		m.Remaining = math.max(0, m.Complete - now)
		m.Complete = nil
	end
	m.Running = running
	m.ReadyAt = now -- no back-dated start after a pause
end

-- "None" | "Running" | "Paused" | "Full" (Full = no storage for another ordinary result).
function RoundRocks.machineState(self: Core, userId: number): string
	local m = self.Members[userId]
	if not m or not m.Machine then
		return "None"
	end
	if not m.Running then
		return "Paused"
	end
	if not m.Current and available(m) < 1 then
		return "Full"
	end
	return "Running"
end

-- Puts the next rock on a machine plate and times it. `from` = when the previous rock finished.
local function arm(self: Core, m: Member, now: number, from: number)
	if not m.Active or not m.Machine or not m.Running then
		return
	end
	local dur = RoundRocks.machineSeconds(m.Machine)
	if not m.Current then
		local ok = tryStart(self, m, dur)
		if not ok then
			return
		end
		local startAt = if now - from <= 0.1 then from else now
		m.Complete = startAt + dur
	elseif not m.Complete then
		-- a rock put on the plate by hand, or resumed after a pause
		m.Complete = now + (m.Remaining or dur)
		m.Remaining = nil
	end
end

-- Advances every machine to `now`. Rocks finish in completion order (ties by station index), so
-- two machines finishing together still give one winner. Returns Cracked / Found results.
function RoundRocks.tickMachines(self: Core, now: number): { Result }
	local results: { Result } = {}
	if self.Phase ~= "Searching" then
		return results
	end
	for _, uid in self.Order do
		local m = self.Members[uid]
		if m.Machine and m.Active and m.Running then
			arm(self, m, now, m.ReadyAt)
		end
	end
	local steps: { [number]: number } = {}
	while self.Phase == "Searching" do
		local pick: Member? = nil
		for _, uid in self.Order do
			local m = self.Members[uid]
			local c = m.Complete
			if c and c <= now and m.Active and m.Running and (steps[uid] or 0) < Config.Station.MaxMachineSteps then
				if not pick or c < (pick.Complete :: number) then
					pick = m
				end
			end
		end
		if not pick then
			break
		end
		local m = pick :: Member
		steps[m.UserId] = (steps[m.UserId] or 0) + 1
		local at = m.Complete :: number
		m.ReadyAt = at
		if finishRock(self, m, m.Current :: number, results) then
			break
		end
		arm(self, m, now, at)
	end
	return results
end

-- Leaving, reset, disconnect --------------------------------------------------------------------

-- Returns one rock to the pile near the station. Its damage is reset, so a returned rock is
-- indistinguishable from an untouched one.
local function returnRock(self: Core, id: number, near: Vector2, uid: number)
	local rock = self.Rocks[id]
	if rock.State == STATE_ORDINARY or rock.State == STATE_GEODE or rock.State == STATE_IN_PILE then
		return
	end
	rock.State = STATE_IN_PILE
	rock.Carrier = nil
	rock.Station = nil
	rock.Hp = self.MaxHp
	local col = self.Pile:restore(id, near, Config.Carry.ReachLevels)
	emit(self, { Kind = "Return", UserId = uid, Id = id, Col = col })
end

-- Overtime (EggConfig.Overtime, Studio 2026-10-15): the pet egg glows gold at 3:00 so the race can end, but a glowing
-- egg deep inside the mound could not be picked up, and the hunt ran on past 0:00. This lifts a pile rock that is not
-- pickable onto a reachable edge column (the same placement as a returned rock) and tells clients with a "Move"
-- event. Called only together with the glow, which names the egg anyway. Returns true when it moved.
function RoundRocks.surface(self: Core, id: number): boolean
	local rock = self.Rocks[id]
	if not rock or rock.State ~= STATE_IN_PILE or self.Pile:isPickable(id, Config.Carry.ReachLevels) then
		return false
	end
	local from = self.Pile:remove(id)
	local col = self.Pile:restore(id, nil, Config.Carry.ReachLevels)
	if not col then
		return false
	end
	emit(self, { Kind = "Move", Id = id, Col = col, From = from })
	return true
end

-- Gives back everything the member holds (plate, tray, basket) to reachable pile positions and
-- frees the reservation. Progress on the plate rock is discarded (it returns at full HP). Rubble
-- already resolved stays with the member. Returns how many rocks went back.
function RoundRocks.resetMember(self: Core, userId: number): number
	local m = self.Members[userId]
	if not m then
		return 0
	end
	local sp = RoundRocks.stationPosition(m.Index)
	local near = Vector2.new(sp.X, sp.Z)
	local n = 0
	if m.Current then
		returnRock(self, m.Current, near, userId)
		n += 1
	end
	for _, id in m.Queue do
		returnRock(self, id, near, userId)
		n += 1
	end
	for _, id in m.Basket do
		returnRock(self, id, near, userId)
		n += 1
	end
	m.Current, m.Reserved, m.Complete, m.Remaining = nil, false, nil, nil
	table.clear(m.Queue)
	table.clear(m.Basket)
	return n
end

-- A character reset drops only the basket (the tray is on the table, not on the avatar).
function RoundRocks.dropCarried(self: Core, userId: number): number
	local m = self.Members[userId]
	if not m or self.Phase ~= "Searching" then
		return 0
	end
	local sp = RoundRocks.stationPosition(m.Index)
	local near = Vector2.new(sp.X, sp.Z)
	local n = #m.Basket
	for _, id in m.Basket do
		returnRock(self, id, near, userId)
	end
	table.clear(m.Basket)
	return n
end

-- Rule: work already due at the moment of leaving counts (machines are caught up to `now` first, so a
-- finished rock or geode is paid to the leaver); anything not yet due goes back to the pile.
-- Returns the machine results from the catch-up (empty without `now`).
function RoundRocks.removeMember(self: Core, userId: number, now: number?): { Result }
	local results: { Result } = {}
	local m = self.Members[userId]
	if not m then
		return results
	end
	if now and self.Phase == "Searching" then
		results = RoundRocks.tickMachines(self, now)
	end
	if self.Phase == "Searching" or self.Phase == "Countdown" or self.Phase == "Waiting" then
		RoundRocks.resetMember(self, userId)
	end
	m.Active = false
	m.Machine = nil
	return results
end

-- Views for replication (ids only, never the target) -------------------------------------------

export type StationView = {
	UserId: number,
	Index: number,
	Basket: { number },
	Queue: { number },
	CarryCap: number, -- this member's basket size (the client's pickup / take hint)
	QueueCap: number, -- this member's nest tray size
	Current: number?,
	Progress: number,
	Machine: string?,
	Tool: string,
	Help: number,
	State: string,
	Cracked: number,
}

function RoundRocks.stationViews(self: Core, now: number?): { StationView }
	local out: { StationView } = {}
	for _, uid in self.Order do
		local m = self.Members[uid]
		if m.Active then
			table.insert(out, {
				UserId = uid,
				Index = m.Index,
				Basket = table.clone(m.Basket),
				Queue = table.clone(m.Queue),
				CarryCap = m.CarryCap,
				QueueCap = m.QueueCap,
				Current = m.Current,
				Progress = progressOf(self, m, now),
				Machine = m.Machine,
				Tool = m.Tool,
				Help = m.HelpRate, -- pet helper crack speed multiplier (the client paces held taps with it)
				State = RoundRocks.machineState(self, uid),
				Cracked = m.Cracked, -- eggs this member finished this round (race bar); says nothing about the pet egg
			})
		end
	end
	return out
end

-- Ids no longer in the pile (carried, queued, on a plate or resolved). Reconnects replay this.
function RoundRocks.removedIds(self: Core): { number }
	local out = {}
	for id, rock in self.Rocks do
		if rock.State ~= STATE_IN_PILE then
			table.insert(out, id)
		end
	end
	table.sort(out)
	return out
end

function RoundRocks.drainEvents(self: Core): { Event }
	local out = self.Events
	self.Events = {}
	return out
end

return RoundRocks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="189">
        <Properties>
          <string name="Name">SafeZones</string>
          <string name="Source"><![CDATA[--!strict
-- Pure screen geometry for touch HUD keep-out zones, in LOGICAL px (the HUD layer after UIScale), origin top left.
--   * jump zone: the bottom-right corner kept clear for Roblox's own jump button on touch devices, sized by Roblox's
--     default TouchGui rule (real px: min(W, H) <= 500 is a 70x70 button at (1,-95,1,-90), else 120x120 at
--     (1,-170,1,-210)) plus a small margin. `scale` = real px per logical px (UI.Scale); 1 when omitted.
--   * prompt band: the bottom-centre strip where a ProximityPrompt card (egg "E FREE PET / Hatch!") appears.
-- Everything that sits near the bottom edge (EMOTE, right column tiles) asks this module instead of using its own numbers.
local SafeZones = {}

export type Rect = { x: number, y: number, w: number, h: number }

SafeZones.JUMP_SMALL = { w = 95, h = 90 } -- real px from the bottom-right corner, small screens
SafeZones.JUMP_BIG = { w = 170, h = 210 } -- real px, tablets and big phones
SafeZones.JUMP_MARGIN = 10 -- real px around the button
SafeZones.SMALL_SCREEN = 500 -- Roblox: min(W, H) at or under this is a small screen
SafeZones.PROMPT_W = 230 -- widest prompt card (action + object line), centred
SafeZones.PROMPT_H = 74 -- from the bottom edge up, with its own margin
SafeZones.GAP = 8
SafeZones.STACK_H = 160 -- tutorial hint / notice cards stacked at the bottom of a narrow (portrait) screen

-- Logical size of the jump keep-out corner for a logical screen at `scale` real px per logical px.
function SafeZones.jumpSize(screenW: number, screenH: number, scale: number?): (number, number)
	local k = math.max(scale or 1, 0.05)
	local small = math.min(screenW, screenH) * k <= SafeZones.SMALL_SCREEN
	local j = if small then SafeZones.JUMP_SMALL else SafeZones.JUMP_BIG
	return (j.w + SafeZones.JUMP_MARGIN) / k, (j.h + SafeZones.JUMP_MARGIN) / k
end

function SafeZones.jumpZone(screenW: number, screenH: number, scale: number?): Rect
	local w, h = SafeZones.jumpSize(screenW, screenH, scale)
	return { x = screenW - w, y = screenH - h, w = w, h = h }
end

function SafeZones.promptBand(screenW: number, screenH: number): Rect
	return { x = (screenW - SafeZones.PROMPT_W) / 2, y = screenH - SafeZones.PROMPT_H, w = SafeZones.PROMPT_W, h = SafeZones.PROMPT_H }
end

function SafeZones.overlaps(a: Rect, b: Rect): boolean
	return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end

function SafeZones.inJumpZone(r: Rect, screenW: number, screenH: number, scale: number?): boolean
	return SafeZones.overlaps(r, SafeZones.jumpZone(screenW, screenH, scale))
end

-- Where a w x h bottom button (EMOTE) goes: on the bottom row just left of the jump zone, or, when that would touch the
-- prompt band (narrow screens), on the row above the bottom card stack (hint cards, prompt). Never inside the jump zone. `touch` false: the PC spot
-- (same offsets as before: right edge 184 from the right, 40 above the bottom).
function SafeZones.bottomButton(screenW: number, screenH: number, w: number, h: number, touch: boolean, scale: number?): Rect
	if not touch then
		return { x = screenW - 184 - w, y = screenH - 40 - h, w = w, h = h }
	end
	local band = SafeZones.promptBand(screenW, screenH)
	local jump = SafeZones.jumpZone(screenW, screenH, scale)
	local r: Rect = { x = jump.x - SafeZones.GAP - w, y = screenH - SafeZones.GAP - h, w = w, h = h }
	if SafeZones.overlaps(r, band) then
		r.y = screenH - SafeZones.STACK_H - SafeZones.GAP - h
	end
	return r
end

-- Roblox's dynamic thumbstick listens for touches that start anywhere in the lower left of a landscape screen
-- (the left 40 % of the width, the bottom 60 % of the height) or the bottom 40 % of an upright one. A button there
-- takes the touch first, so the player cannot start walking: no HUD button may sit in this zone on touch devices.
function SafeZones.thumbZone(screenW: number, screenH: number): Rect
	if screenH > screenW then
		return { x = 0, y = screenH * 0.6, w = screenW, h = screenH * 0.4 }
	end
	return { x = 0, y = screenH * 0.4, w = screenW * 0.4, h = screenH * 0.6 }
end

function SafeZones.inThumbZone(r: Rect, screenW: number, screenH: number): boolean
	return SafeZones.overlaps(r, SafeZones.thumbZone(screenW, screenH))
end

-- How the lobby buttons (PLAY, GIFT, TOWER, BATTLE, DAILY) are laid out. A computer keeps the column down the left.
-- Touch screens keep them out of the thumbstick zone: a landscape phone puts them in one short row along the top
-- (PLAY as a pill `PlayW` wide, the other four as `CellW` squares, so the row covers little of the view: owner's
-- phone shot 2026-10-15 "the ui is blocking my view"), an upright one in two columns. Sizes in logical px.
export type LobbyLayout = { Mode: string, Cols: number, CellW: number, CellH: number, PlayW: number? }
SafeZones.ROW_TILE = 60 -- square tiles of the landscape row (a thumb target: 44 px or more; 60 fits a 16 px word)
SafeZones.ROW_PLAY = 112 -- PLAY pill width in that row
function SafeZones.lobbyLayout(screenW: number, screenH: number, touch: boolean, columnW: number): LobbyLayout
	-- a short landscape window without touch (the Studio phone window, a small laptop) takes the row too: the
	-- column of five buttons filled 40% of a 390 px tall screen
	if not touch and not (screenW > screenH and screenH < 420) then
		return { Mode = "column", Cols = 1, CellW = columnW, CellH = 52 }
	end
	if screenH > screenW then
		-- two columns under the coins, as wide as two thirds of the screen allows (the right column keeps its side)
		local cell = math.clamp(math.floor((screenW * 0.66 - 6) / 2), math.floor((columnW - 6) / 2), 130)
		return { Mode = "grid", Cols = 2, CellW = cell, CellH = 52 }
	end
	-- the tiles shrink (never under 44) so the row stays inside the left half of a narrow phone
	local tile = math.clamp(math.floor((screenW * 0.48 - 14 - SafeZones.ROW_PLAY - 4 * 6) / 4), 44, SafeZones.ROW_TILE)
	return { Mode = "row", Cols = 5, CellW = tile, CellH = tile, PlayW = SafeZones.ROW_PLAY }
end

-- Width of the landscape row: PLAY, four tiles and the gaps between them.
-- true when the lobby buttons leave the column (a phone, or a short landscape window): the objective pill and
-- the rare-hatch banner follow the same verdict
function SafeZones.compactLobby(screenW: number, screenH: number, touch: boolean): boolean
	return SafeZones.lobbyLayout(screenW, screenH, touch, 172).Mode ~= "column"
end

function SafeZones.rowWidth(L: LobbyLayout, gap: number): number
	return (L.PlayW or L.CellW) + (L.Cols - 1) * L.CellW + (L.Cols - 1) * gap
end

-- Largest bottom (logical y) a right-column tile may reach on touch: just above the jump zone.
function SafeZones.columnLimit(screenW: number, screenH: number, scale: number?): number
	local _, h = SafeZones.jumpSize(screenW, screenH, scale)
	return screenH - h - SafeZones.GAP
end

return SafeZones
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="190">
        <Properties>
          <string name="Name">SightRules</string>
          <string name="Source"><![CDATA[--!strict
-- Line of sight for a pickup (Master Prompt 6 section 5): the SERVER checks that nothing solid stands between the
-- character's head and the rock. This module is the pure part (no raycast API), so Lune can test it; RockService
-- supplies the real `cast` function. Rocks themselves are not server instances (the pile is deterministic data), so
-- "the pile's other rocks" can never block here; characters, carried things and decor (CameraIgnore, non-collidable
-- or see-through parts) are skipped, so only solid world geometry such as a wall, a cliff face or the drop between
-- the two quarry levels can refuse a pickup.
local SightRules = {}

SightRules.EYE_LIFT = 1.5 -- studs above the root part when the Head cannot be found
SightRules.STOP_SHORT = 0.9 -- fraction of the rock radius the ray stops before the rock centre
SightRules.MAX_STEPS = 24 -- casts per check; more means a cluster of ignorable parts: the check fails closed
SightRules.EPSILON = 0.02

export type Part = {
	CanCollide: boolean,
	CameraIgnore: boolean,
	Character: boolean, -- part of any player's character (own, partner, or a held tool)
	Transparency: number,
}

export type Hit = { Distance: number, Part: Part }

-- Where the check starts: the head when there is one, otherwise a fixed lift above the root part.
function SightRules.eye(rootPos: Vector3, headPos: Vector3?): Vector3
	if headPos then
		return headPos
	end
	return rootPos + Vector3.new(0, SightRules.EYE_LIFT, 0)
end

-- The point the ray must reach: on the line eye -> rock centre, just before the rock's own shell.
function SightRules.target(eye: Vector3, rockCentre: Vector3, rockSize: number): Vector3
	local d = rockCentre - eye
	local len = d.Magnitude
	if len < 1e-4 then
		return rockCentre
	end
	local back = math.min(len, rockSize * 0.5 * SightRules.STOP_SHORT)
	return eye + d * ((len - back) / len)
end

-- Does this part count as a wall for pickups?
function SightRules.blocks(p: Part): boolean
	if p.Character or p.CameraIgnore or not p.CanCollide or p.Transparency >= 0.95 then
		return false
	end
	return true
end

-- cast(origin, direction) -> Hit? : the first part along the segment, whatever it is (RockService wraps Raycast).
-- Walks past ignorable parts. True when the segment reaches `target` unobstructed.
function SightRules.clear(eye: Vector3, target: Vector3, cast: (Vector3, Vector3) -> Hit?): boolean
	local origin = eye
	for _ = 1, SightRules.MAX_STEPS do
		local d = target - origin
		local len = d.Magnitude
		if len <= SightRules.EPSILON then
			return true
		end
		local hit = cast(origin, d)
		if not hit or hit.Distance >= len - SightRules.EPSILON then
			return true
		end
		if SightRules.blocks(hit.Part) then
			return false
		end
		origin = origin + d.Unit * (hit.Distance + SightRules.EPSILON)
	end
	return false -- ran out of casts before reaching the target: refuse (fails closed)
end

-- The full pickup check. A raycast that starts inside a part never reports that part, so a head pushed into a wall
-- would see straight through it. The segment root -> eye is checked first (the root sits inside the character's
-- collision box, never inside a wall), then eye -> target.
function SightRules.clearFrom(root: Vector3, eye: Vector3, target: Vector3, cast: (Vector3, Vector3) -> Hit?): boolean
	if not SightRules.clear(root, eye, cast) then
		return false
	end
	return SightRules.clear(eye, target, cast)
end

return SightRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="191">
        <Properties>
          <string name="Name">SignLayout</string>
          <string name="Source"><![CDATA[--!strict
-- World-sign typography (Master Prompt 5 section 3). Pure maths, no Instances, so tests and the preview
-- audit can run it.
--
-- Cause of the tiny-text signs: every sign factory used TextScaled inside a SurfaceGui with a fixed
-- PixelsPerStud and a text plate sized separately from the visible board. TextScaled never goes above
-- 100 px and the board and the text plate were never tied together, so a big board (or a plate smaller
-- than the black face it sat on) left small words in a sea of board. Here ONE call decides everything
-- from the board size in studs and the text: TextSize is explicit (<= 100), PixelsPerStud is derived from
-- it, and the resulting width fill is checked against the preset range.
--
-- Presets (fraction of the board width the line should fill):
--   Landmark  START HUNT / UPGRADES / COLLECTION / RECORDS: 60-88 percent, big cap height
--   Heading   board headings (SOLO FINDS / COMPETITIVE WINS): up to 94 percent of the board's top band
--   Plaque    small item and counter plaques: up to 88 percent
--   Nameplate owner names: fills to 78 percent, shrinks, then truncates with "..." (MaxChars)
--   Placard   short hints and warnings: up to 92 percent
--   Row       one line of a list board: up to 98 percent of its row box
-- The advance widths are the Fredoka One metrics the preview renderer measured (em units); the real
-- Roblox rendering can differ by a few percent, which the preset ranges leave room for.

local SignLayout = {}

local ADV: { [string]: number } = { [" "]=0.253, ["!"]=0.267, ["\""]=0.429, ["#"]=0.749, ["$"]=0.475, ["%"]=0.838, ["&"]=0.748, ["'"]=0.208, ["("]=0.384, [")"]=0.384, ["*"]=0.503, ["+"]=0.527, [","]=0.238, ["-"]=0.433, ["."]=0.237, ["/"]=0.526, ["0"]=0.608, ["1"]=0.407, ["2"]=0.609, ["3"]=0.608, ["4"]=0.592, ["5"]=0.53, ["6"]=0.56, ["7"]=0.561, ["8"]=0.582, ["9"]=0.56, [":"]=0.238, [";"]=0.237, ["<"]=0.627, ["="]=0.478, [">"]=0.627, ["?"]=0.512, ["@"]=0.908, ["A"]=0.765, ["B"]=0.646, ["C"]=0.679, ["D"]=0.704, ["E"]=0.638, ["F"]=0.637, ["G"]=0.714, ["H"]=0.699, ["I"]=0.257, ["J"]=0.549, ["K"]=0.639, ["L"]=0.587, ["M"]=0.87, ["N"]=0.72, ["O"]=0.775, ["P"]=0.632, ["Q"]=0.83, ["R"]=0.631, ["S"]=0.583, ["T"]=0.731, ["U"]=0.726, ["V"]=0.783, ["W"]=0.999, ["X"]=0.741, ["Y"]=0.686, ["Z"]=0.643, ["["]=0.348, ["\\"]=0.528, ["]"]=0.348, ["^"]=0.526, ["_"]=0.826, ["`"]=0.482, ["a"]=0.596, ["b"]=0.592, ["c"]=0.517, ["d"]=0.598, ["e"]=0.573, ["f"]=0.45, ["g"]=0.585, ["h"]=0.605, ["i"]=0.255, ["j"]=0.252, ["k"]=0.536, ["l"]=0.327, ["m"]=0.851, ["n"]=0.606, ["o"]=0.6, ["p"]=0.582, ["q"]=0.582, ["r"]=0.457, ["s"]=0.489, ["t"]=0.449, ["u"]=0.606, ["v"]=0.638, ["w"]=0.793, ["x"]=0.567, ["y"]=0.604, ["z"]=0.586, ["{"]=0.381, ["|"]=0.217, ["}"]=0.381, ["~"]=0.651 }
local FALLBACK = 0.606
local ASCENT, DESCENT = 0.974, 0.236

export type Preset = { Target: number, Min: number, Max: number, HeightFill: number, TextPx: number, MaxChars: number?, MinEm: number? }
export type Fit = {
	Text: string,
	Preset: string,
	Lines: number,
	Em: number, -- studs per em (font size in studs)
	TextSize: number, -- px, what the TextLabel uses
	PPS: number, -- PixelsPerStud for the SurfaceGui
	Fill: number, -- widest line / board width
	CapStuds: number, -- cap height in studs
	InRange: boolean,
}

SignLayout.Presets = {
	-- (visual pass 2026-10-10: the lodge landmarks fill more of their boards, like the approved painting; was 0.65 / 0.55-0.75 / 0.7)
	Landmark = { Target = 0.78, Min = 0.6, Max = 0.88, HeightFill = 0.78, TextPx = 80 },
	Plaque = { Target = 0.72, Min = 0.45, Max = 0.88, HeightFill = 0.7, TextPx = 60 },
	Nameplate = { Target = 0.78, Min = 0.4, Max = 0.92, HeightFill = 0.7, TextPx = 56, MaxChars = 22, MinEm = 0.36 },
	Placard = { Target = 0.8, Min = 0.4, Max = 0.92, HeightFill = 0.72, TextPx = 48 },
	-- board headings (SOLO FINDS / COMPETITIVE WINS on the lodge boards): fill the top band of the board face
	Heading = { Target = 0.9, Min = 0.55, Max = 0.94, HeightFill = 0.74, TextPx = 80 },
	-- one line of a list board (LAST WINNERS rows): fills its row box nearly edge to edge; long lines just get smaller
	Row = { Target = 0.96, Min = 0.2, Max = 0.98, HeightFill = 0.9, TextPx = 60 },
} :: { [string]: Preset }

-- Lodge landmark lettering (owner brief 2026-10-10, docs/lodge/VISUAL_PASS_BRIEF.md): bold white letters with a
-- controlled black outline, like the approved lobby painting. The outline is a UIStroke on the label (Contextual),
-- its thickness in canvas pixels scaled with the text size so every sign has the same proportion of outline.
SignLayout.Outline = {
	Ink = Color3.fromRGB(255, 255, 255),
	Stroke = Color3.fromRGB(16, 12, 10),
	Transparency = 0.05,
	Ratio = 0.075, -- outline thickness / TextSize
	MinPx = 2,
	MaxPx = 7,
}

-- Outline thickness (px) for a label of `textSize` px.
function SignLayout.outlinePx(textSize: number): number
	local o = SignLayout.Outline
	return math.clamp(math.floor(textSize * o.Ratio + 0.5), o.MinPx, o.MaxPx)
end

-- Width of one line in em.
function SignLayout.lineEm(line: string): number
	local w = 0
	for i = 1, #line do
		w += ADV[string.sub(line, i, i)] or FALLBACK
	end
	return w
end

local function lines(text: string): { string }
	local out = {}
	for l in string.gmatch(text .. "\n", "([^\n]*)\n") do
		table.insert(out, l)
	end
	return out
end

function SignLayout.widestEm(text: string): number
	local m = 0
	for _, l in lines(text) do
		m = math.max(m, SignLayout.lineEm(l))
	end
	return m
end

-- Layout for `text` on a board `boardW` x `boardH` studs.
function SignLayout.fit(text: string, boardW: number, boardH: number, presetName: string): Fit
	local p = SignLayout.Presets[presetName] or SignLayout.Presets.Plaque
	local t = text
	if p.MaxChars and #t > p.MaxChars then
		t = string.sub(t, 1, p.MaxChars - 3) .. "..."
	end
	local ls = lines(t)
	local ew = SignLayout.widestEm(t)
	if ew <= 0 then
		ew = 1
	end
	local function emFor(str: string): number
		local w = SignLayout.widestEm(str)
		local byW = p.Target * boardW / math.max(w, 0.01)
		local byH = p.HeightFill * boardH / ((ASCENT + DESCENT) * #lines(str))
		return math.min(byW, byH)
	end
	local em = emFor(t)
	-- too small to read: drop characters (names only) until it is readable
	if p.MinEm and #ls == 1 then
		while em < p.MinEm and #t > 4 do
			t = string.sub(t, 1, #t - 4) .. "..."
			em = emFor(t)
		end
		ls = lines(t)
		ew = SignLayout.widestEm(t)
	end
	local textSize = p.TextPx
	local pps = math.max(8, textSize / em)
	local fill = em * ew / boardW
	return {
		Text = t,
		Preset = presetName,
		Lines = #ls,
		Em = em,
		TextSize = textSize,
		PPS = pps,
		Fill = fill,
		CapStuds = em * 0.733,
		InRange = fill >= p.Min - 0.001 and fill <= p.Max + 0.001,
	}
end

return SignLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="192">
        <Properties>
          <string name="Name">SoundConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Hand-set sound ids for Find The Pet sounds that are not in the generated SoundIds table (that file is rewritten by
-- tools/upload_audio.py). The client Audio module looks here after SoundIds. 0 = no sound yet: nothing plays.
-- REPLACE: the owner uploads or picks each sound (Creator Dashboard > Audio, or the Toolbox) and pastes its numeric
-- id here. Never put a guessed id here.
--
-- Ids: plain sounds by name (Audio.play(name)).
-- Pets never roar (owner rule 2026-10-13): there is no per-species roar sound.

local PetSoundIds = require(script.Parent.PetSoundIds)

local SoundConfig = {
	Ids = {
		EggCrunch = PetSoundIds.EggTap, -- made sound (0 until uploaded)
		EggPop = PetSoundIds.EggBreak, -- made sound (0 until uploaded)
		HatchChoir = PetSoundIds.HatchBuildUp, -- build-up before a Rare+ pet pops
		-- the owner's uploads (IMPORT_SOUNDS, 2026-10-13)
		ButtonClickSoft = 101452752754957, -- UI button click
		UIWhooshSoft = 131957057864016, -- menu panel open / close
		ShopKaChing = 78809819500095, -- purchase
		ShellPop = 125084463938090, -- shells sold
		HuntWindBed = 130675273376991, -- hunt wind loop (Audio.setArea)
		PetFootstepPat = 77953031296703, -- very quiet pet footstep (not wired yet)
	} :: { [string]: number },
}

return SoundConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="193">
        <Properties>
          <string name="Name">SoundCues</string>
          <string name="Source"><![CDATA[--!strict
-- Which sound plays at which Find The Pet moment (pure rules; the client Audio module and SoundCueView play them).
-- Every key named here resolves through Audio's id lookup: SoundIds (uploaded), SoundConfig.Ids (hand-set),
-- PetSoundIds (Find The Pet). An id of 0 plays nothing; a key in Fallback plays its stand-in instead, so a moment that
-- already had a sound never goes quiet while its new made sound waits for upload.
-- Pets never roar (owner rule): no key here or in the id tables may be a roar.
-- Tests: tests/test_sound_cues.luau. Docs: docs/AUDIO.md "Find The Pet moments".

local SoundCues = {}

export type Cue = { Key: string, Delay: number, Pitch: number, Volume: number, Tag: string? }

-- new made sound -> the uploaded sound it replaces (played while the new one's id is still 0)
SoundCues.Fallback = {
	EggGrab = "Pickup",
	EggDrop = "Deposit",
	BattleWin = "MatchWin",
	LevelUp = "RarityAccent",
	Evolve = "RarityAccent",
} :: { [string]: string }

-- The audit list (Item 20): every key moment and the key it plays. Order = the owner's list.
SoundCues.Moments = {
	{ Moment = "Hatch reveal (every rarity)", Key = "GeodeReveal" },
	{ Moment = "Hatch reveal rarity sting (Uncommon+)", Key = "RarityAccent" },
	{ Moment = "Hatch reveal Epic+ sparkle swell", Key = "HatchSparkle" },
	{ Moment = "Hatch reveal Legendary / Void drum hit", Key = "HatchDrum" },
	{ Moment = "Hatch build-up (Rare+ slow motion)", Key = "HatchChoir" },
	{ Moment = "Pet found (everyone in the round)", Key = "PetFound" },
	{ Moment = "Pet found, you won (versus)", Key = "MatchWin" },
	{ Moment = "Egg grab from the pile", Key = "EggGrab" },
	{ Moment = "Egg drop at the nest", Key = "EggDrop" },
	{ Moment = "Egg tap", Key = "EggCrunch" },
	{ Moment = "Egg breaks (no pet)", Key = "EggPop" },
	{ Moment = "Pet egg hint chirp", Key = "EggChirp" },
	{ Moment = "Pet Battle queue matched", Key = "BattleMatched" },
	{ Moment = "Pet Battle hit", Key = "TowerHit" },
	{ Moment = "Pet Battle crit", Key = "PetCrit" },
	{ Moment = "Pet Battle SPECIAL", Key = "TowerSpecial" },
	{ Moment = "Pet Battle SPECIAL ready", Key = "RarityAccent" },
	{ Moment = "Pet Battle K.O. (a pet faints)", Key = "PetKO" },
	{ Moment = "Pet Battle win", Key = "BattleWin" },
	{ Moment = "Pet Battle lose", Key = "BattleLose" },
	{ Moment = "Training tap", Key = "TrainTap" },
	{ Moment = "Level up", Key = "LevelUp" },
	{ Moment = "Evolve", Key = "Evolve" },
	{ Moment = "Tower floor clear", Key = "FloorClear" },
	{ Moment = "Tower run lost", Key = "BattleLose" },
	{ Moment = "Daily claim", Key = "DailyClaim" },
	{ Moment = "Gift open", Key = "GiftOpen" },
	{ Moment = "Coin gain", Key = "CoinPickup" },
	{ Moment = "Buttons and tabs", Key = "ButtonClickSoft" },
	{ Moment = "Panel open / close", Key = "UIWhooshSoft" },
	{ Moment = "Purchase / unlock", Key = "ShopKaChing" },
	{ Moment = "Quest done", Key = "QuestDone" },
	{ Moment = "Lucky Meter full", Key = "LuckyMeter" },
	{ Moment = "Error / denied", Key = "Denied" },
	{ Moment = "Round countdown", Key = "CountdownTick" },
	{ Moment = "Speed boots", Key = "SpeedBoots" },
} :: { { Moment: string, Key: string } }

-- Hatch reveal: rarity sets the pitch and loudness of the sting; Epic and up add the sparkle swell, Legendary and
-- Void (the Void Dragon, or a Mythic / Secret / Void rarity) add the drum hit on top. No roars.
local STING: { [string]: { Pitch: number, Volume: number, Reveal: number, Echo: number?, Sparkle: boolean?, Drum: number? } } = {
	Common = { Pitch = 0.8, Volume = 0.55, Reveal = 0.95 },
	Uncommon = { Pitch = 0.9, Volume = 0.7, Reveal = 1.0 },
	Rare = { Pitch = 1.0, Volume = 0.85, Reveal = 1.0 },
	Epic = { Pitch = 1.12, Volume = 1.0, Reveal = 1.04, Echo = 1.5, Sparkle = true },
	Legendary = { Pitch = 1.25, Volume = 1.2, Reveal = 1.08, Echo = 2.0, Sparkle = true, Drum = 1.0 },
	Void = { Pitch = 1.1, Volume = 1.25, Reveal = 0.92, Echo = 2.0, Sparkle = true, Drum = 0.85 },
}
local VOID_RARITY = { Mythic = true, Secret = true, Void = true }

function SoundCues.reveal(rarity: string?, isVoid: boolean?): { Cue }
	local name = if isVoid or (rarity and VOID_RARITY[rarity]) then "Void" else rarity
	local st = name and STING[name]
	local out: { Cue } = { { Key = "GeodeReveal", Delay = 0, Pitch = if st then st.Reveal else 1, Volume = 1 } }
	if not st then
		return out
	end
	table.insert(out, { Key = "RarityAccent", Delay = 0.25, Pitch = st.Pitch, Volume = st.Volume })
	if st.Echo then
		table.insert(out, { Key = "RarityAccent", Delay = 0.6, Pitch = st.Pitch * st.Echo, Volume = st.Volume * 0.6, Tag = "RarityEcho" })
	end
	if st.Drum then
		table.insert(out, { Key = "HatchDrum", Delay = 0.05, Pitch = st.Drum, Volume = 1 })
	end
	if st.Sparkle then
		table.insert(out, { Key = "HatchSparkle", Delay = 0.15, Pitch = 1, Volume = if st.Drum then 1 else 0.85 })
	end
	return out
end

local function has(text: string, word: string): boolean
	return string.find(string.lower(text), word, 1, true) ~= nil
end

-- A server Toast (text, kind) -> the key to play, or nil. Kinds: ok (purchase / unlock), cash (daily gift, quest
-- reward), rare (Lucky Meter, free eggs, streak shield), warn (refused / not allowed), info (no sound).
function SoundCues.toast(text: string?, kind: string?): string?
	local t = if type(text) == "string" then text else ""
	if kind == "ok" then
		return "ShopKaChing"
	elseif kind == "warn" then
		return "Denied"
	elseif kind == "cash" then
		if has(t, "quest") then
			return "QuestDone"
		elseif has(t, "daily gift") or has(t, "streak") then
			return "DailyClaim"
		end
		return "CoinPickup"
	elseif kind == "rare" then
		if has(t, "lucky meter") then
			return "LuckyMeter"
		elseif has(t, "quest") then
			return "QuestDone"
		elseif has(t, "streak") then
			return "DailyClaim"
		end
		return "LuckyMeter"
	end
	return nil
end

-- A PvpNet.PvpEvent message -> the key to play here, or nil. The Pet Battle panel (ui/PvpPanel) plays the win,
-- level-up and evolve keys itself; TowerView plays hit, crit, SPECIAL and K.O. per fight event.
function SoundCues.pvp(msg: any): string?
	if type(msg) ~= "table" then
		return nil
	end
	if msg.Kind == "Start" then
		return "BattleMatched"
	elseif msg.Kind == "Result" and msg.Result == "Loss" then
		return "BattleLose"
	elseif msg.Kind == "Trained" and not msg.LevelUp and (tonumber(msg.Gain) or 0) > 0 then
		return "TrainTap"
	end
	return nil
end

-- A TowerNet.TowerEvent message -> key, or nil.
function SoundCues.tower(msg: any): string?
	if type(msg) ~= "table" then
		return nil
	end
	if msg.Kind == "FloorEnd" then
		return if msg.Result == "Cleared" then "FloorClear" elseif msg.Result == "Lost" then "BattleLose" else nil
	end
	return nil
end

-- A Retention remote kind -> key, or nil (gifts that pay coins open with the gift sound).
function SoundCues.retention(kind: string?): string?
	if kind == "Gift" or kind == "Friend" or kind == "Group" then
		return "GiftOpen"
	end
	return nil
end

return SoundCues
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="194">
        <Properties>
          <string name="Name">SoundIds</string>
          <string name="Source"><![CDATA[--!strict
