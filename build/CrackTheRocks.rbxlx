    <Item class="ModuleScript" referent="117">
      <Properties>
        <string name="Name">PetMotion</string>
        <string name="Source"><![CDATA[--!strict
-- Pet animation for the real skinned pet meshes (ReplicatedStorage.PetModels). Runs on the CLIENT: Bone /
-- Motor6D.Transform does not replicate. Lives at ReplicatedStorage.PetMotion; all the "how does it move" maths is in
-- ReplicatedStorage.Shared.PetPose (pure, tested) and the clips in Shared.PetClips. This file only finds the bones,
-- measures speed, aims the head and writes the pose.
--
-- API (used through client/PetMotionBridge, PetFollow, PetDisplay, RevealView, PvpPanel):
--   PetMotion.start(model)            animate it (idle / walk); safe to call twice
--   PetMotion.setBase(model, cf)      where the pet stands this frame (it is re-pivoted from here every frame)
--   PetMotion.hatch / celebrate / spin / hop(model)
--   PetMotion.play(model, "attack"|"hit"|"win") -> boolean   one-shot clip, then back to the loop
-- Model attributes read: Moving (bool), Anim ("idle"|"walk"|"run"|"train"|nil), WalkRate (number), Sleepy (bool),
-- LookAt (Vector3), Species (species id, set by PetModel), Gait ("quad"|"biped"|"heavy"|"hopper"|"waddle", optional override).
-- Rigs: Bones or Motor6Ds named Body, Head, Tail, LegL, LegR, LegBL, LegBR, WingL, WingR, Arms (optionally prefixed,
-- e.g. "Raptor_Head"). A rig without bones gets a gentle bob. Owner rules: no mouth opening (a Jaw bone is held
-- shut), no roar. Merged 2026-10-15 from the two copies that had split (clips + play / LookAt, Sleepy, spin, hop).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local PetPose = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PetPose")) :: any

local PetMotion = {}

type State = {
	pose: any, base: CFrame, gone: number, joints: { [string]: any }, fwd: number, height: number, scale: number,
	gait: string, rigged: boolean, speed: number, lastPos: Vector3?,
}
-- Strong on purpose: a weak Instance key can vanish while the pet still exists (Roblox may recycle the Lua wrapper).
-- Entries leave on Destroying, or after GONE seconds out of the DataModel; setBase restarts a pet that comes back.
local active: { [Model]: State } = {}
-- Weak keys: the bones are held by their pet's State while it animates; afterwards the entries can go.
local restRot: { [Instance]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
local GONE = 2 -- seconds out of the game before a pet is dropped (start() may run just before parenting)
local CULL = 120 -- studs: world pets farther than this from the camera are not animated this frame
local TELEPORT = 12 -- studs in one frame: a jump of the base this big is a teleport, not walking speed

local function drop(model: Model)
	local s = active[model]
	if not s then return end
	active[model] = nil
	for _, jj in s.joints do
		if typeof(jj) == "Instance" then restRot[jj] = nil end
	end
end

local function jointPos(j: any, part: BasePart?): Vector3?
	if j == nil then return nil end
	if j:IsA("Bone") and part then return part.CFrame:PointToObjectSpace(j.WorldPosition) end
	if j:IsA("Motor6D") and j.Part0 then return j.Part0.CFrame:PointToObjectSpace((j.Part0.CFrame * j.C0).Position) end
	return nil
end

-- "CT_Pet_Raptor" / "Pet_Raptor" -> "Raptor"
local function speciesOf(model: Model): string?
	return model.Name:match("^CT_Pet_(.+)$") or model.Name:match("^Pet_(.+)$")
end

function PetMotion.start(model: Model)
	if active[model] then return end
	local joints: { [string]: any } = {}
	local part: BasePart? = nil
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") or d:IsA("Bone") then joints[d.Name:match("_(%a+)$") or d.Name] = d end
		if d:IsA("Bone") then
			local p = d:FindFirstAncestorWhichIsA("BasePart")
			if p then
				part = p
				restRot[d] = p.CFrame.Rotation:Inverse() * d.WorldCFrame.Rotation
			end
		end
	end
	-- which way the face points along the part's Z: the head sits in front of the tail (tail first: a tall bird's
	-- head is right above its body)
	local fwd = 1
	local a = jointPos(joints.Head or joints.Jaw, part)
	local b = jointPos(joints.Tail or joints.Body, part)
	if a and b and math.abs(a.Z - b.Z) > 0.01 then fwd = if a.Z < b.Z then -1 else 1 end
	local hasMotors = false
	for _, jj in joints do if jj:IsA("Motor6D") then hasMotors = true end end
	local root = model.PrimaryPart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.Anchored = (not hasMotors) or d == root
		end
	end
	local over = model:GetAttribute("Gait")
	local attr = model:GetAttribute("Species") -- set by PetModel; followers are renamed Pet_<uid>_n
	local id = if type(attr) == "string" then attr else speciesOf(model)
	local gait = if type(over) == "string" and PetPose.GAITS[over] then over
		else PetPose.gaitFor(id, model.Name, model:GetAttribute("Kind") :: string?, if next(joints) then joints.LegBL ~= nil else nil)
	local seed = 0
	for k = 1, #model.Name do seed = (seed * 31 + string.byte(model.Name, k)) % 9973 end
	active[model] = {
		pose = PetPose.new(seed + math.random(0, 50)), base = model:GetPivot(), gone = 0, joints = joints, fwd = fwd,
		height = math.max(model:GetExtentsSize().Y, 0.3), scale = model:GetScale(), gait = gait,
		rigged = next(joints) ~= nil, speed = 0, lastPos = nil,
	}
	model.Destroying:Once(function() drop(model) end)
end

function PetMotion.setBase(model: Model, cf: CFrame)
	local s = active[model]
	if not s and model.Parent and model:IsDescendantOf(game) then
		-- dropped while it was out of the game (a follower hidden over a respawn): pick it up again
		PetMotion.start(model)
		s = active[model]
	end
	if s then s.base = cf end
end

local function pop(model: Model, kind: string)
	PetMotion.start(model)
	local s = active[model]
	if s then PetPose.pop(s.pose, kind) end
end
-- Hatch: crouch, happy hop, land with a squash.
function PetMotion.hatch(model: Model) pop(model, "hatch") end
-- Celebrate: two hops with a spin (no roar).
function PetMotion.celebrate(model: Model) pop(model, "celebrate") end
-- Spin: one hop with a full turn (a pet levelling up).
function PetMotion.spin(model: Model) pop(model, "spin") end
-- Hop: one small hop on the spot (the owner jumped). Never cuts a hatch / celebrate / spin short.
function PetMotion.hop(model: Model) pop(model, "hop") end

-- One-shot clip (attack / hit / win) over whatever the pet is doing; it returns to the loop when done.
function PetMotion.play(model: Model, name: string): boolean
	PetMotion.start(model)
	local s = active[model]
	return s ~= nil and PetPose.play(s.pose, name)
end

-- Head yaw / pitch (pitch + = nose down) toward a world point, in the head's own frame; nil when unknown.
local function aimAt(j: any, f: number, at: Vector3): (number?, number?)
	if j == nil then return nil end
	local frame: BasePart? = nil
	local pos: Vector3? = nil
	if j:IsA("Bone") then
		frame = j:FindFirstAncestorWhichIsA("BasePart")
		pos = j.WorldPosition
	elseif j:IsA("Motor6D") and j.Part0 then
		frame = j.Part0
		pos = (j.Part0.CFrame * j.C0).Position
	end
	if not frame or not pos then return nil end
	local lp = frame.CFrame:VectorToObjectSpace(at - pos)
	local flat = math.sqrt(lp.X * lp.X + lp.Z * lp.Z)
	if flat < 0.3 then return nil end
	return math.atan2(f * lp.X, f * lp.Z), -math.atan2(lp.Y, flat)
end

local function set(j: { [string]: any }, name: string, cf: CFrame)
	local m = j[name]
	if not m then return end
	local r = restRot[m]
	if r then
		m.Transform = r:Inverse() * cf * r
	else
		m.Transform = cf
	end
end

-- a > 0 = nose / tip down, whichever way the pet faces (f = +1 faces +Z, -1 faces -Z)
local function pitchF(f: number, a: number, yaw: number?, roll: number?): CFrame
	return CFrame.Angles(a * f, (yaw or 0), (roll or 0) * f)
end

local input: { [string]: any } = {}

RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 1 / 15)
	local cam = Workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else nil
	for model, s in active do
		local inWorld = model:IsDescendantOf(Workspace)
		if not inWorld and not model:IsDescendantOf(game) then
			s.gone += dt
			if s.gone >= GONE then drop(model) end
			continue
		end
		s.gone = 0
		-- distance culling (world pets only; ViewportFrame pets have their own camera)
		if inWorld and camPos and (s.base.Position - camPos).Magnitude > CULL then continue end
		local f = s.fwd
		local j = s.joints

		-- ground speed from how far the base moved (feet keep pace with it in PetPose)
		local pos = s.base.Position
		local inst = 0
		if s.lastPos then
			local d = Vector3.new(pos.X - s.lastPos.X, 0, pos.Z - s.lastPos.Z).Magnitude
			if d < TELEPORT then inst = d / math.max(dt, 1e-3) end
		end
		s.lastPos = pos
		s.speed += (inst - s.speed) * math.min(1, dt * 8)
		local sc = model:GetScale()
		if sc ~= s.scale then -- re-scaled after start (followers are fitted to one height)
			s.height = math.max(s.height * sc / s.scale, 0.3)
			s.scale = sc
		end

		local lookAt = model:GetAttribute("LookAt")
		local aimYaw, aimPitch = nil, nil
		if typeof(lookAt) == "Vector3" then
			aimYaw, aimPitch = aimAt(j.Head, f, lookAt)
		end
		local look = s.base.LookVector
		local anim = model:GetAttribute("Anim")
		local rate = model:GetAttribute("WalkRate")
		input.moving = model:GetAttribute("Moving") == true
		input.speed = if input.moving then s.speed else 0
		input.height = s.height
		input.gait = s.gait
		input.rigged = s.rigged
		input.anim = if type(anim) == "string" then anim else nil
		input.walkRate = if type(rate) == "number" then rate else nil
		input.sleepy = model:GetAttribute("Sleepy") == true
		input.aimYaw, input.aimPitch = aimYaw, aimPitch
		input.yaw = math.atan2(-look.X, -look.Z)
		local V = PetPose.step(s.pose, input, dt)

		set(j, "LegL", pitchF(f, V.legFL))
		set(j, "LegR", pitchF(f, V.legFR))
		set(j, "LegBL", pitchF(f, V.legBL))
		set(j, "LegBR", pitchF(f, V.legBR))
		set(j, "Tail", pitchF(f, V.tailP, V.tailY))
		set(j, "Arms", pitchF(f, V.arms))
		set(j, "WingL", CFrame.Angles(0, 0, V.wing))
		set(j, "WingR", CFrame.Angles(0, 0, -V.wing))
		set(j, "Head", pitchF(f, V.headP, V.headY, V.headR))
		set(j, "Jaw", CFrame.identity) -- owner rule (2026-10-12): the mouth / beak never opens
		-- the whole-body moves use the pivot, which always faces -Z (PetModel turns backwards meshes round), so a
		-- lunge goes forward and "nose down" is down even for a mesh modelled facing +Z
		local offset = CFrame.new(0, V.rootY, -V.rootZ)
			* CFrame.Angles(0, V.rootYaw, V.rootR)
			* CFrame.Angles(-V.rootP, 0, 0)
		model:PivotTo(s.base * offset)
	end
end)

return PetMotion
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="118">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="119">
        <Properties>
          <string name="Name">ActionRules</string>
          <string name="Source"><![CDATA[--!strict
-- The contextual primary action as ONE pure function (Master Prompt 4, section 26). The client reads
-- the server snapshot and the avatar's position, builds an `Inputs` table, and gets back exactly one
-- context: what the button says, what a press sends, and where (if anywhere) a route hint points.
-- The label and the request can never disagree because both come from this one result.
-- The server still validates every request (RoundRocks / RockService); nothing here is trusted.
--
-- Ids (visible): pickup take deposit crush machine collect sell bagfull closer
-- Ids (no button): wait securing none
-- Priority: sell hopper (only with rubble) > own table > pile > nothing. At the own table Deposit beats
-- crush; a running machine only ever deposits. A button is shown only where there is something useful:
-- `closer` appears only when a relevant place is just outside its range, never for scenery.
local ActionRules = {}

export type Inputs = {
	Phase: string?, -- nil outside a hunt
	Active: boolean, -- the pile view is live (round initialised, not over)
	HasStation: boolean,
	Basket: number,
	Capacity: number, -- basket capacity
	Queue: number, -- rocks in the tray
	QueueCapacity: number,
	Current: boolean, -- a rock is on the plate
	Machine: boolean, -- an automatic machine is installed AND not paused (it will ignore hand hits)
	MachineFull: boolean, -- machine state is "Full" (rubble storage blocked)
	Rubble: number,
	RubbleFull: boolean,
	NearHopper: boolean,
	AtTable: boolean, -- inside the own table's crush range (server range minus a margin)
	NearTable: boolean, -- within a few studs outside that range
	HasTarget: boolean, -- a pickable rock in reach (the one that would be outlined and sent)
	NearPile: boolean, -- within a few studs outside pickup reach of the pile
}

export type Context = { Id: string, Arrow: string? }

-- Ids that draw no button at all.
local HIDDEN = { wait = true, securing = true, none = true }
function ActionRules.visible(id: string): boolean
	return not HIDDEN[id]
end

function ActionRules.decide(i: Inputs): Context
	if i.Phase == nil or i.Phase == "Countdown" then
		return { Id = "wait" }
	elseif i.Phase == "RewardPending" or i.Phase == "Reveal" then
		return { Id = "securing" }
	elseif i.Phase ~= "Searching" or not i.Active or not i.HasStation then
		return { Id = "wait" }
	end
	local queued = i.Queue + (if i.Current then 1 else 0)
	if i.Rubble > 0 and i.NearHopper then
		return { Id = "sell" }
	end
	if i.AtTable then
		if i.Basket > 0 and i.Queue < i.QueueCapacity then
			return { Id = "deposit" }
		elseif i.Basket > 0 and not i.Machine then
			return { Id = if i.RubbleFull and not i.Current then "bagfull" else "crush" }
		elseif i.Basket > 0 then
			return { Id = "machine" }
		elseif i.Machine then
			return { Id = if i.MachineFull then "bagfull" else "machine", Arrow = "pile" }
		elseif queued > 0 then
			return { Id = if i.RubbleFull and not i.Current then "bagfull" else "crush" }
		end
		return { Id = "collect", Arrow = "pile" }
	end
	-- away from the table
	local wantsTable = i.Basket > 0 and (i.Basket >= i.Capacity or not i.HasTarget) or (queued > 0 and not i.Machine)
	if i.HasTarget then
		if i.Basket < i.Capacity then
			return { Id = "pickup" }
		end
		return { Id = "take", Arrow = "table" }
	end
	local arrow = if wantsTable then "table" elseif i.Basket == 0 and queued == 0 then "pile" else nil
	if wantsTable and i.NearTable then
		return { Id = "closer", Arrow = arrow }
	elseif not wantsTable and i.Basket < i.Capacity and i.NearPile then
		return { Id = "closer", Arrow = arrow }
	end
	return { Id = "none", Arrow = arrow }
end

return ActionRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="120">
        <Properties>
          <string name="Name">AimResolve</string>
          <string name="Source"><![CDATA[--!strict
-- First-person aiming as pure functions (docs/m6/FIRST_PERSON.md). The client collects explicitly tagged
-- candidates (source rocks, the own table, a sell hopper, a lobby counter), each a point with a radius,
-- and gets back the ONE the camera-centre ray points at. Nothing here touches the engine, so it is tested
-- offline. The client's choice is a convenience only: the server validates every request on its own.
local AimResolve = {}

export type Candidate = {
	Key: any, -- stable id (rock id, "table", "sell", a prompt)
	Kind: string, -- "rock" | "table" | "sell" | "counter"
	Pos: Vector3,
	Radius: number, -- studs: how big the thing is to the ray
}

-- Perpendicular miss distance and distance along the ray of a point, or nil when it is behind the origin.
local function approach(origin: Vector3, dir: Vector3, pos: Vector3): (number?, number)
	local v = pos - origin
	local t = v:Dot(dir)
	if t < 0 then
		return nil, 0
	end
	local miss = (v - dir * t).Magnitude
	return t, miss
end

-- The candidate the ray passes through (within Radius + slack), nearest along the ray first; a rock the
-- ray passes through beats one it only grazes. Candidates farther than maxDist (plus their radius) are
-- ignored. Returns the candidate and its distance along the ray.
function AimResolve.pick(origin: Vector3, dir: Vector3, cands: { Candidate }, maxDist: number, slack: number): (Candidate?, number?)
	local best: Candidate? = nil
	local bestScore = math.huge
	local bestT = 0
	for _, c in cands do
		local t, miss = approach(origin, dir, c.Pos)
		if t ~= nil and t <= maxDist + c.Radius then
			local allow = c.Radius + slack
			if miss <= allow then
				local score = t + miss * 2
				if score < bestScore or (score == bestScore and best ~= nil and tostring(c.Key) < tostring(best.Key)) then
					best, bestScore, bestT = c, score, t
				end
			end
		end
	end
	return best, if best then bestT else nil
end

-- Reticle presentation from the contextual action id (ActionRules ids) and whether the ray is on a target.
--   eligible    the press does something now
--   unavailable the ray is on something that cannot be used; Reason is one concise line (nil = no text)
--   neutral     nothing to say (exploring)
export type Reticle = { State: string, Reason: string? }

local ELIGIBLE = { pickup = true, deposit = true, crush = true, sell = true, collect = false }
local REASONS: { [string]: string } = {
	take = "Basket full: put your eggs in your nest",
	bagfull = "Candy bag full: sell it",
	closer = "Move closer",
}

function AimResolve.reticle(ctxId: string, aimed: boolean): Reticle
	if ELIGIBLE[ctxId] then
		return { State = "eligible" }
	end
	local reason = REASONS[ctxId]
	if reason and (aimed or ctxId == "bagfull") then
		return { State = "unavailable", Reason = reason }
	end
	return { State = "neutral" }
end

return AimResolve
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="121">
        <Properties>
          <string name="Name">ArrivalGate</string>
          <string name="Source"><![CDATA[--!strict
-- WaitingForParty state machine for the Match server (pure; time is passed in).
--
--   Idle      nobody has arrived yet (the wait clock has not started)
--   Waiting   some expected members are missing, inside the wait window
--   Ready     every expected member is here: the hunt may begin
--   TimedOut  window over with members missing: the leader may START WITH ARRIVED or RETURN
--   Started   a hunt began for the Roster; later arrivals are only reconnects of roster members
--   Cancelled the leader sent everyone back
--   Empty     everyone who ever arrived has left
-- Arrivals are still accepted while TimedOut (a slow member can still make it), never after
-- Started unless they were on the roster.

local ArrivalGate = {}
ArrivalGate.__index = ArrivalGate

export type Gate = {
	Members: { number },
	TicketLeader: number,
	Wait: number,
	Arrived: { [number]: boolean },
	Roster: { number }?,
	T0: number?,
	Cancelled: boolean,
	arrivedList: (Gate) -> { number },
	missing: (Gate) -> { number },
	leader: (Gate) -> number?,
	status: (Gate, number) -> string,
	remaining: (Gate, number) -> number,
	arrive: (Gate, number, number) -> (boolean, string?),
	leave: (Gate, number) -> (),
	start: (Gate, number?, number) -> ({ number }?, string?),
	cancel: (Gate, number, number) -> (boolean, string?),
}

function ArrivalGate.new(members: { number }, ticketLeader: number, waitSeconds: number): Gate
	local g = {
		Members = table.clone(members),
		TicketLeader = ticketLeader,
		Wait = waitSeconds,
		Arrived = {},
		Roster = nil,
		T0 = nil,
		Cancelled = false,
	}
	return setmetatable(g, ArrivalGate) :: any
end

function ArrivalGate.arrivedList(self: Gate): { number }
	local out = {}
	for _, uid in self.Members do
		if self.Arrived[uid] then
			table.insert(out, uid)
		end
	end
	return out
end

function ArrivalGate.missing(self: Gate): { number }
	local out = {}
	for _, uid in self.Members do
		if not self.Arrived[uid] then
			table.insert(out, uid)
		end
	end
	return out
end

-- Effective leader: the ticket leader while present, else the earliest present member.
function ArrivalGate.leader(self: Gate): number?
	if self.Arrived[self.TicketLeader] then
		return self.TicketLeader
	end
	for _, uid in self.Members do
		if self.Arrived[uid] then
			return uid
		end
	end
	return nil
end

function ArrivalGate.status(self: Gate, now: number): string
	if self.Cancelled then
		return "Cancelled"
	end
	local t0 = self.T0
	if t0 == nil then
		return "Idle"
	end
	if next(self.Arrived) == nil then
		return "Empty"
	end
	if self.Roster then
		return "Started"
	end
	if #self:missing() == 0 then
		return "Ready"
	end
	if now - t0 >= self.Wait then
		return "TimedOut"
	end
	return "Waiting"
end

-- Seconds left in the wait window (the full window before anyone has arrived).
function ArrivalGate.remaining(self: Gate, now: number): number
	local t0 = self.T0
	if t0 == nil then
		return self.Wait
	end
	return math.max(0, self.Wait - (now - t0))
end

function ArrivalGate.arrive(self: Gate, userId: number, now: number): (boolean, string?)
	if self.Cancelled then
		return false, "Cancelled"
	end
	if not table.find(self.Members, userId) then
		return false, "NotExpected"
	end
	local roster = self.Roster
	if roster and not table.find(roster, userId) then
		return false, "Started" -- late: the hunt began without you
	end
	if self.T0 == nil then
		self.T0 = now
	end
	self.Arrived[userId] = true
	return true, nil
end

function ArrivalGate.leave(self: Gate, userId: number)
	self.Arrived[userId] = nil
end

-- Begins the hunt. Ready: the server calls it. TimedOut: only the leader may, and only with at
-- least one arrival. Returns the roster (arrived members, party order) or nil + reason.
function ArrivalGate.start(self: Gate, userId: number?, now: number): ({ number }?, string?)
	local st = self:status(now)
	if st == "Ready" then
		self.Roster = self:arrivedList()
		return self.Roster, nil
	elseif st == "TimedOut" then
		if userId == nil or userId ~= self:leader() then
			return nil, "NotLeader"
		end
		self.Roster = self:arrivedList()
		return self.Roster, nil
	elseif st == "Waiting" or st == "Idle" then
		return nil, "StillWaiting"
	end
	return nil, st
end

-- Leader sends everyone back before the hunt began.
function ArrivalGate.cancel(self: Gate, userId: number, now: number): (boolean, string?)
	local st = self:status(now)
	if st == "Started" or st == "Cancelled" or st == "Empty" or st == "Idle" then
		return false, st
	end
	if userId ~= self:leader() then
		return false, "NotLeader"
	end
	self.Cancelled = true
	return true, nil
end

return ArrivalGate
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="122">
        <Properties>
          <string name="Name">Boards</string>
          <string name="Source"><![CDATA[--!strict
-- Lobby leaderboard definitions and the pure rules around them (tested offline): which profile
-- number feeds which board, how a value is shown, when a write is due and how raw store rows
-- become a ranked list. The server owns the DataStores (LeaderboardService); the lobby boards
-- (LobbyBoards) only draw what it hands over.
--
-- Solo Finds are a separate board on purpose: only multiplayer hunts count as Wins.

local TreeBoard = require(script.Parent.TreeBoard)

local Boards = {}

export type Info = {
	Id: string,
	Title: string, -- big board title
	Sub: string, -- one line under it
	Unit: string, -- shown after the value
	Accent: Color3,
	Money: boolean?,
}

-- Owner: the lobby shows only two boards, RAREST PET (the crowned board) and HIGHEST FLOOR. The other boards keep
-- their definitions and values (nothing is wiped) but are no longer read or drawn.
-- Owner 2026-10-14 (lobby hangout): MOST COINS joins them (coins earned ever, so spending never drops a rank).
-- 2026-10-14 leaderboard tree: STRONGEST PET (best pet POWER) feeds the tree (server/TreeBoardService).
Boards.Order = { "Biggest", "Tower", "Coins", "Power" }

Boards.Info = {
	Wins = { Id = "Wins", Title = "MULTIPLAYER WINS", Sub = "Pet hunts won against friends", Unit = "wins", Accent = Color3.fromRGB(244, 198, 68) },
		-- Owner: "rarest pet" board. The score is the best pet's value (rarity x trait x size), so a rarer pet ranks higher.
	Biggest = { Id = "Biggest", Title = "RAREST PET", Sub = "Best pet ever hatched (rarity, trait, size)", Unit = "pts", Accent = Color3.fromRGB(166, 106, 255) },
	Collection = { Id = "Collection", Title = "PETS HATCHED", Sub = "Pets hatched (released ones count)", Unit = "pets", Accent = Color3.fromRGB(105, 218, 232) },
	Solo = { Id = "Solo", Title = "SOLO FINDS", Sub = "Pets found in solo hunts", Unit = "finds", Accent = Color3.fromRGB(88, 196, 108) },
	Power = { Id = "Power", Title = "STRONGEST PET", Sub = "Best pet POWER (the leaderboard tree)", Unit = "power", Accent = Color3.fromRGB(255, 120, 80) },
	Coins = { Id = "Coins", Title = "MOST COINS", Sub = "Coins earned ever", Unit = "coins", Accent = Color3.fromRGB(255, 196, 64) },
	Tower = { Id = "Tower", Title = "HIGHEST FLOOR", Sub = "Highest pet tower floor cleared", Unit = "floor", Accent = Color3.fromRGB(150, 96, 230) },
} :: { [string]: Info }

local function nonNegInt(n: any): number
	if type(n) ~= "number" or n ~= n or n == math.huge or n < 0 then
		return 0
	end
	return math.floor(n)
end

-- Profile data -> value per board. Collection counts every geode ever collected (the discovery
-- index keeps counting after a sale), so selling never lowers a rank.
function Boards.values(data: any): { [string]: number }
	local stats = if type(data) == "table" and type(data.Stats) == "table" then data.Stats else {}
	local collected = 0
	if type(data) == "table" and type(data.DiscoveryIndex) == "table" then
		for _, n in data.DiscoveryIndex do
			collected += nonNegInt(n)
		end
	end
	return {
		Wins = nonNegInt(stats.MultiplayerWins),
		Biggest = nonNegInt(stats.BestGeodeValue),
		Collection = collected,
		Solo = nonNegInt(stats.SoloFinds),
		Tower = if type(data) == "table" then nonNegInt(data.TowerBest) else 0,
		Coins = nonNegInt(stats.CashEarned),
		Power = nonNegInt((select(2, TreeBoard.bestPet(data)))),
	}
end

local function commas(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end
Boards.commas = commas

function Boards.format(id: string, value: number): string
	local info = Boards.Info[id]
	if info and info.Money then
		return "$" .. commas(value)
	end
	return commas(value)
end

-- A write is due when the value grew (boards only ever go up), is above zero, and the last
-- write for that board was long enough ago.
function Boards.writeDue(lastWritten: number?, newValue: number, lastWriteTime: number?, now: number, minSeconds: number): boolean
	if newValue <= 0 or newValue <= (lastWritten or 0) then
		return false
	end
	if lastWriteTime and now - lastWriteTime < minSeconds then
		return false
	end
	return true
end

-- Raw sorted rows ({ key = "u"-less user id string, value = number }) -> ranked rows. Skips
-- malformed keys and non-positive values, orders by value then lower UserId, keeps `top`.
export type Row = { Rank: number, UserId: number, Value: number }

function Boards.rank(raw: { any }, top: number): { Row }
	local rows: { Row } = {}
	local seen: { [number]: boolean } = {}
	for _, r in raw do
		local uid = if type(r) == "table" then tonumber(r.key) else nil
		local v = if type(r) == "table" and type(r.value) == "number" then r.value else 0
		if uid and uid > 0 and uid == math.floor(uid) and v > 0 and not seen[uid] then
			seen[uid] = true
			table.insert(rows, { Rank = 0, UserId = uid, Value = math.floor(v) })
		end
	end
	table.sort(rows, function(a, b)
		if a.Value ~= b.Value then
			return a.Value > b.Value
		end
		return a.UserId < b.UserId
	end)
	while #rows > top do
		table.remove(rows)
	end
	for i, r in rows do
		r.Rank = i
	end
	return rows
end

return Boards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="123">
        <Properties>
          <string name="Name">BotRules</string>
          <string name="Source"><![CDATA[--!strict
-- Practice buddies (pure rules; tests/test_retention.luau drives them). The first hunt a new player plays (the
-- practice pile, Config.Tutorial) has a few friendly bots racing next to them, so the very first round feels like a
-- race with no queue wait. The bots only act it out: they walk to the pile, grab, walk to their own nest and tap
-- it. They never take a real egg, never crack one and can never find the pet (the practice pet is always the new
-- player's: RoundRocks TutorialBreak). The server (src/server/PracticeBots.luau) moves their characters.

local BotRules = {}

BotRules.Names = { "Pip", "Bolt", "Mo" }
BotRules.Count = 3 -- at most this many bots (one per free nest)

-- Fun outfits so the practice crew never reads as default avatars (walkthrough 10-14): a pet onesie each, body
-- colours plus a few chunky parts welded on (ears, spikes, tail). Procedural only (no catalog ids). Part offsets are
-- studs from the attach part's centre, R15 facing -Z (so +Z is the back); Rot is degrees.
export type OutfitPart = { Name: string, Attach: string, Shape: string, Size: { number }, Offset: { number }, Rot: { number }?, Color: Color3 }
export type Outfit = { Name: string, Skin: Color3, Body: Color3, Legs: Color3, Parts: { OutfitPart } }
local PINK, WHITE, ORANGE, CREAM, GREEN, LIME = Color3.fromRGB(255, 150, 200), Color3.fromRGB(255, 250, 245), Color3.fromRGB(255, 140, 50), Color3.fromRGB(255, 236, 205), Color3.fromRGB(90, 200, 100), Color3.fromRGB(200, 240, 90)
BotRules.Outfits = {
	{
		Name = "Bunny", Skin = Color3.fromRGB(255, 214, 170), Body = PINK, Legs = PINK,
		Parts = {
			{ Name = "EarL", Attach = "Head", Shape = "Block", Size = { 0.32, 1.1, 0.16 }, Offset = { -0.28, 1.05, 0 }, Rot = { 0, 0, 10 }, Color = PINK },
			{ Name = "EarR", Attach = "Head", Shape = "Block", Size = { 0.32, 1.1, 0.16 }, Offset = { 0.28, 1.05, 0 }, Rot = { 0, 0, -10 }, Color = PINK },
			{ Name = "EarInL", Attach = "Head", Shape = "Block", Size = { 0.16, 0.8, 0.05 }, Offset = { -0.29, 1.02, -0.09 }, Rot = { 0, 0, 10 }, Color = WHITE },
			{ Name = "EarInR", Attach = "Head", Shape = "Block", Size = { 0.16, 0.8, 0.05 }, Offset = { 0.29, 1.02, -0.09 }, Rot = { 0, 0, -10 }, Color = WHITE },
			{ Name = "Tail", Attach = "LowerTorso", Shape = "Ball", Size = { 0.6, 0.6, 0.6 }, Offset = { 0, 0, 0.55 }, Color = WHITE },
		},
	},
	{
		Name = "Fox", Skin = Color3.fromRGB(240, 190, 150), Body = ORANGE, Legs = Color3.fromRGB(60, 50, 50),
		Parts = {
			{ Name = "EarL", Attach = "Head", Shape = "Wedge", Size = { 0.2, 0.6, 0.5 }, Offset = { -0.38, 0.8, 0 }, Rot = { 0, 90, 0 }, Color = ORANGE },
			{ Name = "EarR", Attach = "Head", Shape = "Wedge", Size = { 0.2, 0.6, 0.5 }, Offset = { 0.38, 0.8, 0 }, Rot = { 0, 90, 0 }, Color = ORANGE },
			{ Name = "Tail", Attach = "LowerTorso", Shape = "Ball", Size = { 0.7, 0.7, 1.6 }, Offset = { 0, 0.2, 1.0 }, Rot = { -30, 0, 0 }, Color = ORANGE },
			{ Name = "TailTip", Attach = "LowerTorso", Shape = "Ball", Size = { 0.5, 0.5, 0.6 }, Offset = { 0, 0.62, 1.68 }, Rot = { -30, 0, 0 }, Color = CREAM },
		},
	},
	{
		Name = "Dino", Skin = Color3.fromRGB(200, 150, 110), Body = GREEN, Legs = GREEN,
		Parts = {
			{ Name = "Spike1", Attach = "Head", Shape = "Wedge", Size = { 0.2, 0.45, 0.45 }, Offset = { 0, 0.7, 0.15 }, Color = LIME },
			{ Name = "Spike2", Attach = "UpperTorso", Shape = "Wedge", Size = { 0.2, 0.5, 0.5 }, Offset = { 0, 0.5, 0.55 }, Rot = { 0, 0, 0 }, Color = LIME },
			{ Name = "Spike3", Attach = "UpperTorso", Shape = "Wedge", Size = { 0.2, 0.5, 0.5 }, Offset = { 0, -0.1, 0.55 }, Color = LIME },
			{ Name = "Tail", Attach = "LowerTorso", Shape = "Wedge", Size = { 0.6, 0.6, 1.6 }, Offset = { 0, -0.2, 1.05 }, Rot = { 0, 180, 0 }, Color = GREEN },
		},
	},
} :: { Outfit }

-- The outfit for bot number `i` (wraps around).
function BotRules.outfit(i: number): Outfit
	local n = #BotRules.Outfits
	return BotRules.Outfits[((math.max(1, i) - 1) % n) + 1]
end

-- Seconds each step lasts (walking steps end early when the bot arrives; WalkMax is the give-up time).
BotRules.Timing = {
	Grab = { 0.8, 1.6 },
	Crack = { 1.6, 3.2 },
	WalkMax = 7,
	FirstDelay = { 0.3, 1.5 }, -- a small random start so the bots do not move in lockstep
}
BotRules.WalkSpeed = 13 -- a little slower than a player (Roblox default 16), so the new player can keep up

export type Step = string -- "Wait" | "ToPile" | "Grab" | "ToNest" | "Crack"
BotRules.Order = { "ToPile", "Grab", "ToNest", "Crack" } :: { Step }

export type Bot = { Index: number, Name: string, Step: Step, Until: number, Carry: boolean }

local function range(rng: Random, r: { number }): number
	return r[1] + rng:NextNumber() * (r[2] - r[1])
end

-- The bots for a practice round with `freeNests` nests nobody uses (0..Count bots).
function BotRules.make(freeNests: number, rng: Random, now: number): { Bot }
	local out = {}
	for i = 1, math.clamp(freeNests, 0, BotRules.Count) do
		table.insert(out, {
			Index = i,
			Name = BotRules.Names[i],
			Step = "Wait" :: Step,
			Until = now + range(rng, BotRules.Timing.FirstDelay),
			Carry = false,
		})
	end
	return out
end

-- The step after `step` (Wait goes to ToPile, Crack goes round to ToPile again).
function BotRules.next(step: Step): Step
	local i = table.find(BotRules.Order, step)
	if not i then
		return "ToPile"
	end
	return BotRules.Order[(i % #BotRules.Order) + 1]
end

-- Moves `bot` on when its step is over: `arrived` = the walk reached its target. Returns true when the step changed.
-- Carry is true from the grab until the crack is done (the bot shows an egg over its head).
function BotRules.advance(bot: Bot, now: number, arrived: boolean, rng: Random): boolean
	local walking = bot.Step == "ToPile" or bot.Step == "ToNest"
	if not (now >= bot.Until or (walking and arrived)) then
		return false
	end
	local nextStep = BotRules.next(bot.Step)
	bot.Step = nextStep
	if nextStep == "Grab" then
		bot.Until = now + range(rng, BotRules.Timing.Grab)
	elseif nextStep == "Crack" then
		bot.Until = now + range(rng, BotRules.Timing.Crack)
	else
		bot.Until = now + BotRules.Timing.WalkMax
	end
	if nextStep == "ToNest" then
		bot.Carry = true
	elseif nextStep == "ToPile" then
		bot.Carry = false
	end
	return true
end

return BotRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="124">
        <Properties>
          <string name="Name">CameraModeRules</string>
          <string name="Source"><![CDATA[--!strict
-- What the camera and cursor should be, as one pure decision (docs/m6/FIRST_PERSON.md section 1).
-- The client coordinator (src/client/CameraMode.luau) feeds it the facts and applies the answer; nothing
-- else in the game decides camera mode, cursor or reticle.
--   Blocked   at least one blocking panel / reveal / results holds the screen (UI.block keys)
--   Cinematic a deliberate presentation camera owns the view (none by default)
--   Peek      desktop: the free-cursor key is held in a first-person hunt (Config.Camera.FreeCursorKeys), so HUD
--             buttons can be clicked without opening a menu
-- First person is a HUNT-only view (owner decision 2026-10-10): the lobby uses the normal Roblox Classic third-person
-- camera with a free mouse. `CameraModeRules.firstPerson` is that rule; FirstPerson below is its answer.
local CameraModeRules = {}

export type Inputs = { FirstPerson: boolean, Blocked: boolean, Cinematic: boolean, Peek: boolean? }

-- Is the view first person? Only when the switch is on AND the player is in a hunt (an arena round from Init until
-- Left, or the Match place of Teleport mode). The lobby is always third person.
function CameraModeRules.firstPerson(enabled: boolean, inHunt: boolean): boolean
	return enabled and inHunt
end
export type Decision = {
	Mode: string, -- "LockFirstPerson" | "Classic"
	CursorFree: boolean, -- the mouse is FREED by a menu / cinematic / peek (in third person it is free anyway)
	Reticle: boolean, -- draw the centre reticle
	Actions: boolean, -- gameplay input may act
}

function CameraModeRules.decide(i: Inputs): Decision
	local free = i.Blocked or i.Cinematic or (i.FirstPerson and i.Peek == true)
	return {
		Mode = if i.FirstPerson then "LockFirstPerson" else "Classic",
		CursorFree = free,
		Reticle = i.FirstPerson and not free,
		Actions = not free,
	}
end

-- A keyed holder set: the camera returns to play only when the LAST holder lets go. Used for the tests of the
-- modal-stack rule (UI.block is the live implementation; it has the same semantics).
export type Stack = { Keys: { [string]: boolean } }

function CameraModeRules.newStack(): Stack
	return { Keys = {} }
end

function CameraModeRules.hold(s: Stack, key: string, on: boolean): boolean -- returns blocked after the change
	if on then
		s.Keys[key] = true
	else
		s.Keys[key] = nil
	end
	return next(s.Keys) ~= nil
end

-- May an input that arrives now act? An input that was already down when the last menu closed, or arrives within
-- `grace` seconds of it, must not (closing a menu with a key cannot fire the tool).
function CameraModeRules.mayAct(blocked: boolean, now: number, unblockedAt: number, grace: number): boolean
	return not blocked and now - unblockedAt >= grace
end

-- The hatch close-up (client HatchFocus): when the pet egg is found, the finder's camera leaves first person and
-- looks down at their own nest from the side they stood on, so the in-world hatch is seen before the big reveal
-- card (walkthrough 10-14: "Pet hatched!" showed while the camera faced bare ground). `plate` = the nest plate,
-- `viewer` = where the camera was. Back NEST_BACK studs toward the viewer, NEST_UP up, looking just above the plate.
CameraModeRules.NestBack, CameraModeRules.NestUp, CameraModeRules.NestLookUp = 9, 6, 1.5
function CameraModeRules.nestShot(plate: Vector3, viewer: Vector3): CFrame
	local d = Vector3.new(viewer.X - plate.X, 0, viewer.Z - plate.Z)
	local dir = if d.Magnitude > 0.1 then d.Unit else Vector3.new(0, 0, 1)
	local eye = plate + dir * CameraModeRules.NestBack + Vector3.new(0, CameraModeRules.NestUp, 0)
	local look = (plate + Vector3.new(0, CameraModeRules.NestLookUp, 0) - eye).Unit
	local right = look:Cross(Vector3.yAxis).Unit
	return CFrame.fromMatrix(eye, right, right:Cross(look)) -- = CFrame.lookAt(eye, target)
end

return CameraModeRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="125">
        <Properties>
          <string name="Name">CameraSolve</string>
          <string name="Source"><![CDATA[--!strict
-- Pure helpers for the client camera guard (src/client/CameraGuard.luau, Master Prompt 4 section 28).
-- The guard casts from the head towards the camera the default camera script chose; this module turns the
-- distances of what was hit into a safe camera distance and eases it back out smoothly.
local CameraSolve = {}

CameraSolve.Margin = 0.6 -- studs kept between the camera and the surface it stops at
CameraSolve.MinDistance = 2.2 -- never pull the camera closer to the head than this
CameraSolve.Recover = 9 -- studs per second the camera is allowed to move back out

-- `wanted`: distance the default camera chose. `hits`: distance to the first blocking surface of each probe
-- ray (nil = that ray hit nothing). Returns the distance to use now (<= wanted).
function CameraSolve.allowed(wanted: number, hits: { number? }): number
	local nearest = wanted
	for _, h in hits do
		if h then
			nearest = math.min(nearest, h - CameraSolve.Margin)
		end
	end
	return math.clamp(nearest, math.min(CameraSolve.MinDistance, wanted), wanted)
end

-- Snap in at once (never show the inside of a wall), ease out at Recover studs per second.
function CameraSolve.smooth(current: number?, target: number, dt: number): number
	if current == nil or target <= current then
		return target
	end
	return math.min(target, current + CameraSolve.Recover * dt)
end

local function exitAxis(o: number, d: number, lo: number, hi: number): number
	if d > 1e-6 then
		return (hi - o) / d
	elseif d < -1e-6 then
		return (lo - o) / d
	end
	return math.huge
end

-- Room box for the third-person lobby camera: when `origin` (the head) is inside the axis-aligned box, the distance
-- along the unit `dir` to the first face it would leave through, else nil. The lodge's walls and ceiling are
-- invisible, non-queryable colliders under non-colliding kit meshes, so no ray can find them; this keeps the camera
-- in the room by geometry instead (CameraGuard adds it as one more hit).
function CameraSolve.boxExit(origin: Vector3, dir: Vector3, min: Vector3, max: Vector3): number?
	if origin.X <= min.X or origin.X >= max.X or origin.Y <= min.Y or origin.Y >= max.Y or origin.Z <= min.Z or origin.Z >= max.Z then
		return nil
	end
	local best = math.min(exitAxis(origin.X, dir.X, min.X, max.X), exitAxis(origin.Y, dir.Y, min.Y, max.Y), exitAxis(origin.Z, dir.Z, min.Z, max.Z))
	return if best == math.huge then nil else best
end

return CameraSolve
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="126">
        <Properties>
          <string name="Name">ColumnFit</string>
          <string name="Source"><![CDATA[--!strict
-- Pure fit rule for a vertical column of tiles on a short screen (HUD left column). Given the height the column may
-- use, how many tiles it holds, the gap between them and the smallest / largest tile height, it picks the tile size and
-- how many columns are needed. Tall screens get maxSize back unchanged; the size never drops below minSize.

local ColumnFit = {}

export type Fit = { size: number, cols: number }

function ColumnFit.fit(avail: number, count: number, gap: number, minSize: number, maxSize: number): Fit
	if count <= 0 then
		return { size = maxSize, cols = 1 }
	end
	local minS = math.min(minSize, maxSize)
	local cols = 1
	while cols < count do
		local rows = math.ceil(count / cols)
		if rows * minS + gap * (rows - 1) <= avail then
			break
		end
		cols += 1
	end
	local rows = math.ceil(count / cols)
	local size = (avail - gap * (rows - 1)) / rows
	return { size = math.max(minS, math.min(maxSize, size)), cols = cols }
end

return ColumnFit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="127">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- All tuning lives here. Numbers are the brief's starting defaults (docs/BRIEF.txt),
-- not measured truths: tune after playtests.

local Config = {}

Config.Version = 1 -- config version stamped on every specimen

Config.Palette = {
	Slate = Color3.fromRGB(38, 50, 60), -- #26323C
	SlateLight = Color3.fromRGB(58, 72, 84),
	Orange = Color3.fromRGB(242, 138, 38), -- #F28A26
	Yellow = Color3.fromRGB(244, 198, 68), -- #F4C644
	Cream = Color3.fromRGB(243, 233, 216), -- #F3E9D8
	Rock = Color3.fromRGB(120, 129, 138), -- #78818A
	Violet = Color3.fromRGB(166, 106, 255), -- #A66AFF
	Cyan = Color3.fromRGB(105, 218, 232), -- #69DAE8
	Green = Color3.fromRGB(88, 196, 108),
	Red = Color3.fromRGB(226, 76, 64),
	Dirt = Color3.fromRGB(196, 168, 128),
}

-- Delivery tiers. Rocks is the logical pile size (it does not grow with party size).
-- Radius/RockSize shape the mound: Gravel ~17 studs across and ~5-6 tall, Meteor ~30 across.
export type Tier = {
	Id: string,
	Name: string,
	Order: number,
	Rocks: number,
	HP: number,
	CashPerRubble: number,
	GeodeBase: number,
	UnlockCash: number,
	UnlockFinds: number,
	Radius: number,
	RockSize: number,
	Minerals: { string },
	Recommended: string,
}

Config.TierOrder = { "Gravel", "Quarry", "Cavern", "Volcanic", "Meteor" }

Config.Tiers = {
	Gravel = {
		Id = "Gravel", Name = "Meadow", Order = 1, Rocks = 150, HP = 1, CashPerRubble = 2,
		GeodeBase = 40, UnlockCash = 0, UnlockFinds = 0, Radius = 10, RockSize = 2.2,
		Minerals = { "Raptor", "Ostrich", "Puffquill", "Pebblehorn", "Mosswhip", "Honeyhoof", "Bramblebat", "Clovercrest", "SunpetalDrake", "Bunny", "Frog" },
		Recommended = "Lucky Collar",
	},
	Quarry = {
		Id = "Quarry", Name = "Forest", Order = 2, Rocks = 150, HP = 2, CashPerRubble = 5,
		GeodeBase = 150, UnlockCash = 500, UnlockFinds = 5, Radius = 12, RockSize = 2.2, -- Forest: 500 coins + 5 pets found (owner pick 2026-10-11)
		Minerals = { "DireWolf", "Griffin", "Duskwing", "Oakmaw", "Thornhoof", "Vinetail", "Mossback", "Hollowfang", "Elderhorn", "Panda", "Turtle" },
		Recommended = "Treat Bag",
	},
	Cavern = {
		Id = "Cavern", Name = "Snow", Order = 3, Rocks = 150, HP = 4, CashPerRubble = 12,
		GeodeBase = 500, UnlockCash = 3000, UnlockFinds = 15, Radius = 14, RockSize = 2.1,
		Minerals = { "FrostWyvern", "Mammoth", "Frostpaw", "Yetiboo", "Shiverclaw", "AuroraHoot", "Waddlefrost", "Hailwing", "FrostcrownDragon", "Shark" },
		Recommended = "Pet Whistle",
	},
	Volcanic = {
		Id = "Volcanic", Name = "Volcano", Order = 4, Rocks = 150, HP = 7, CashPerRubble = 25,
		GeodeBase = 1500, UnlockCash = 25000, UnlockFinds = 35, Radius = 15, RockSize = 2.0,
		Minerals = { "LavaTRex", "Phoenix", "Cinderpup", "Magmaw", "Obsidihorn", "Emberclaw", "Ashwing", "Flarestrut", "InfernalHydra" },
		Recommended = "Pet Whistle + Auto Nest",
	},
	Meteor = {
		Id = "Meteor", Name = "Space", Order = 5, Rocks = 150, HP = 10, CashPerRubble = 50,
		GeodeBase = 4000, UnlockCash = 100000, UnlockFinds = 75, Radius = 16, RockSize = 1.9,
		Minerals = { "CosmicDragon", "Cometpup", "Moonhoot", "Nebuclaw", "LunarTusk", "GalaxyStrut", "Zapstar", "QuasarRex" },
		Recommended = "Best incubator",
	},
} :: { [string]: Tier }

-- Hand tools. Rate is strikes (or pulses) per second; Hold means held input repeats.
export type Handheld = {
	Id: string,
	Name: string,
	Order: number,
	Price: number,
	Damage: number,
	Rate: number,
	Hold: boolean,
	Requires: string?,
}

Config.HandheldOrder = { "Hammer", "SteelHammer", "Jackhammer" }
Config.Handhelds = {
	Hammer = { Id = "Hammer", Name = "Lucky Collar", Order = 1, Price = 0, Damage = 1, Rate = 0.9, Hold = false },
	SteelHammer = { Id = "SteelHammer", Name = "Treat Bag", Order = 2, Price = 150, Damage = 2, Rate = 1.2, Hold = false },
	Jackhammer = { Id = "Jackhammer", Name = "Pet Whistle", Order = 3, Price = 1200, Damage = 1, Rate = 5, Hold = true },
} :: { [string]: Handheld }

-- Machines install at the owner's crushing table and crush that station's queue ONE rock at a time
-- (docs/V3_LOOP.md). Throughput = RocksPerBatch / BatchSeconds rocks per second, so one rock takes
-- BatchSeconds / RocksPerBatch seconds (RoundRocks.machineSeconds): Auto Cracker 2 rocks/s,
-- Hydraulic Press 4/s, Industrial Crusher 12/s. The two fields stay as the shop shows them.
Config.MachinesEnabled = true
Config.MachineOrder = { "AutoCracker", "HydraulicPress", "IndustrialCrusher" }
Config.Machines = {
	AutoCracker = { Id = "AutoCracker", Name = "Auto Nest", Price = 6000, RocksPerBatch = 1, BatchSeconds = 0.5 },
	HydraulicPress = { Id = "HydraulicPress", Name = "Warm Incubator", Price = 45000, RocksPerBatch = 8, BatchSeconds = 2 },
	IndustrialCrusher = { Id = "IndustrialCrusher", Name = "Mega Incubator", Price = 180000, RocksPerBatch = 12, BatchSeconds = 1 },
}

-- V3 loop (docs/V3_LOOP.md): rocks are picked up from the shared pile into a basket, deposited at
-- the player's own crushing table and crushed there. Nothing is cracked at the pile.
-- Carry: Capacity = uncrushed rocks per basket (independent of rubble storage); PickupInterval =
-- seconds between pickups (held input repeats at this rate); PickupRange = xz studs from the
-- player to the rock; ReachLevels = highest pile layer that can be picked without climbing.
-- SightCheck: the server refuses pickups through walls (RockService hasSight). Set false if real play shows false refusals.
-- PickupHeight: most studs the rock may sit above or below the avatar's root (stops picks from far above the pile).
Config.Carry = { Capacity = 3, PickupInterval = 0.45, PickupTolerance = 0.12, PickupRange = 8, PickupHeight = 12, ReachLevels = 3, SightCheck = true }
-- Motion sanity check on rock actions (RockService). The server keeps a trusted point per hunter and judges every
-- scheduler step AND the live position at every Pickup / Deposit / Crush against it: a horizontal move farther
-- than WalkSpeed * SpeedFactor * elapsed + Slack studs is a teleport; that action is refused and the player's rock
-- actions are ignored for Lock seconds. The trusted point moves at most every Anchor seconds (Slack is forgiven
-- once per Anchor) and never to an impossible spot. Server moves (spawns) give Grace seconds to settle.
-- Slack forgives about a second of bunched-up network updates on a laggy phone. Enabled = false turns it off.
Config.Motion = { Enabled = true, Anchor = 2, Grace = 1, SpeedFactor = 1.25, Slack = 6, Lock = 1.5 }
-- First person (docs/m6/FIRST_PERSON.md), in hunts only. FirstPerson = false makes hunts third person too
-- (CameraGuard guards every third-person camera). Reach = studs along the camera-centre ray a target may be aimed
-- from (the server still checks the avatar's own distance); Slack = studs of forgiveness around a target
-- (a rock is small, the reticle is a dot); WorkRadius = within this many studs of the own table the table
-- wins over a pile rock the reticle happens to cover; PromptCone = cos of the half angle in which a lobby
-- prompt may be offered (0.8 is about 37 degrees); LocalHide* = what the local view hides.
Config.Camera = {
	FirstPerson = true,
	Fov = 70,
	Reach = 11,
	FarReach = 30,
	Slack = 0.35,
	WorkRadius = 5.5,
	PromptCone = 0.8,
	GraceAfterModal = 0.25, -- seconds after the last menu closes in which the same input cannot act
	Glimpse = { Offset = Vector3.new(1.5, -1.9, -3.2), Max = 5 }, -- lower right, clear of the hotbar (phone video: it peeked out behind it)
	-- First person is the HUNT view only (owner decision 2026-10-10, docs/m11/CAMERA_SPAWN_FIX.md). The lobby uses the
	-- normal Roblox Classic camera: free mouse, right-drag to turn, zoom between these distances; CameraGuard keeps it
	-- inside the lodge room (Config.Lodge) and out of solid geometry.
	Lobby = { MinZoom = 8, MaxZoom = 25 },
	-- Desktop, first-person hunt: holding one of these keys frees the mouse so HUD buttons can be clicked (the view
	-- and the avatar hold still while it is held; releasing it locks the view again).
	FreeCursorKeys = { "LeftAlt", "RightAlt" },
}

-- The lobby park box in world studs (the outdoor dino-jungle pet park, ParkConfig.Bounds): the ground top, a sky
-- ceiling well above the longest lobby zoom (outdoors: no roof) and the invisible boundary walls. Used by the lobby
-- builders (Interior), the lobby spawn check and the lobby camera box (CameraGuard).
Config.Lodge = { FloorY = 0, CeilingY = 60, MinX = -100, MaxX = 100, MinZ = -164, MaxZ = 160 } -- = ParkConfig.Bounds

-- Station (crushing table): four tables evenly around the pile at Radius studs, one per member.
-- QueueCapacity = input tray size; DepositRange / CrushRange = xz studs from the table centre.
Config.Station = {
	Count = 4,
	Radius = 25,
	QueueCapacity = 10,
	DepositRange = 10,
	CrushRange = 9,
	DepositInterval = 0.25,
	DepositTolerance = 0.1,
	MaxMachineSteps = 24, -- rocks one scheduler step may finish for one station (catch-up bound)
}

-- Rubble storage. Level 1 is free.
Config.Capacity = {
	{ Size = 30, Price = 0 },
	{ Size = 100, Price = 200 },
	{ Size = 300, Price = 1000 },
	{ Size = 1000, Price = 5000 },
	{ Size = 3000, Price = 50000 },
}

-- Pet Book storage (owner: 100 pets). Profiles.petCapacity adds a save's ExtraPetSlots (0 unless a future, owner-made
-- game pass raises it). A save already holding more keeps every pet; it only stops new pets until some are sold.
Config.Inventory = { Max = 100 }

-- Lobby gallery display slots per player alcove. Level 1 is free.
Config.Display = {
	{ Slots = 3, Price = 0 },
	{ Slots = 6, Price = 500 },
	{ Slots = 12, Price = 2000 },
	{ Slots = 20, Price = 12000 },
}
-- FullDetailSlots: the first N specimens of an alcove use the shelf model; the rest use the tiny one
-- (fewest parts) so 16 full galleries stay light (docs/PERF.md).
Config.Gallery = { Alcoves = 16, FullDetailSlots = 8 }

-- Geode generation.
Config.Rarities = { "Common", "Uncommon", "Rare", "Epic", "Legendary" }
-- Owner: the rarest pet is 1 in 1000 (Legendary 0.1 of 100).
Config.RarityWeights = { Common = 60, Uncommon = 25, Rare = 11, Epic = 3.9, Legendary = 0.1 }
Config.RarityMult = { Common = 1, Uncommon = 1.5, Rare = 3, Epic = 6, Legendary = 12 }
Config.RarityColors = {
	Common = Color3.fromRGB(138, 148, 158),
	Uncommon = Color3.fromRGB(64, 170, 110),
	Rare = Color3.fromRGB(52, 120, 230),
	Epic = Color3.fromRGB(150, 80, 220),
	Legendary = Color3.fromRGB(240, 160, 30),
}
-- Rarity colours for TEXT on the dark panels and plaques: lighter tints of the colours above (Epic purple was hard to
-- read on charcoal). The rarity word is always written next to the colour, never colour alone.
Config.RarityTextColors = {
	Common = Color3.fromRGB(206, 212, 218),
	Uncommon = Color3.fromRGB(110, 222, 150),
	Rare = Color3.fromRGB(126, 178, 255),
	Epic = Color3.fromRGB(204, 156, 255),
	Legendary = Color3.fromRGB(255, 198, 84),
}

Config.Formations = { "Cluster", "Spire", "TwinCore", "HollowBloom" }
Config.FormationWeights = { Cluster = 45, Spire = 25, TwinCore = 20, HollowBloom = 10 }
-- Formation is the pet's pose on stands and in the book (ids kept from the geode saves).
Config.FormationNames = { Cluster = "Sitting", Spire = "Standing", TwinCore = "Waving", HollowBloom = "Sleepy" }

-- Pet variants (Find The Pet; owner's roster). Old geode saves used Glowing / Cosmic; Profiles migrates them.
Config.Modifiers = { "Natural", "Golden", "Skeleton", "Rainbow", "SilverCosmic" }
Config.ModifierWeights = { Natural = 90, Golden = 7, Skeleton = 2, Rainbow = 0.8, SilverCosmic = 0.2 }
Config.ModifierMult = { Natural = 1, Golden = 1.5, Skeleton = 2, Rainbow = 3, SilverCosmic = 5 }
Config.ModifierNames = { Natural = "", Golden = "Golden", Skeleton = "Skeleton", Rainbow = "Rainbow", SilverCosmic = "Silver Cosmic" }
Config.ModifierMigration = { Glowing = "Golden", Cosmic = "SilverCosmic" }

-- Mass bands (kg): weight, min, max.
Config.MassBands = {
	{ Weight = 90, Min = 0.5, Max = 4 },
	{ Weight = 9, Min = 4.01, Max = 12 },
	{ Weight = 1, Min = 12.01, Max = 30 },
}

-- Find The Pet: the round's prize is a pet. For save and code compatibility the species table keeps the old name
-- Config.Minerals (a specimen's Mineral field holds the species id). Crystal = main body colour, Rim = accent colour,
-- Kind = which procedural body PetModel builds (REPLACE with real meshes when the owner uploads them).
-- BoostKind: what the pet helps with while it follows you (Coins = shell sell price, Speed = walk speed in hunts,
-- Luck = better rarity odds on the pet YOU hatch; luck never changes which egg hides the pet or who finds it).
-- Boost: extra fraction this species adds on top of the rarity bonus (Config.Pets.RarityBoost).
Config.Minerals = {
	Raptor = { Name = "Razorclaw", Kind = "raptor", Crystal = Color3.fromRGB(110, 190, 90), Rim = Color3.fromRGB(250, 210, 90), BoostKind = "Speed", Boost = 0 },
	Ostrich = { Name = "Thunderstrut", Kind = "ostrich", Crystal = Color3.fromRGB(70, 60, 60), Rim = Color3.fromRGB(250, 190, 170), BoostKind = "Coins", Boost = 0 },
	DireWolf = { Name = "Shadowfang", Kind = "wolf", Crystal = Color3.fromRGB(120, 124, 140), Rim = Color3.fromRGB(235, 235, 245), BoostKind = "Speed", Boost = 0.02 },
	Griffin = { Name = "Stormtalon", Kind = "griffin", Crystal = Color3.fromRGB(210, 160, 80), Rim = Color3.fromRGB(250, 250, 240), BoostKind = "Luck", Boost = 0.02 },
	FrostWyvern = { Name = "Glacier Wyrm", Kind = "wyvern", Crystal = Color3.fromRGB(130, 200, 250), Rim = Color3.fromRGB(235, 250, 255), BoostKind = "Luck", Boost = 0.04 },
	Mammoth = { Name = "Titan Tusk", Kind = "mammoth", Crystal = Color3.fromRGB(150, 100, 70), Rim = Color3.fromRGB(250, 245, 230), BoostKind = "Coins", Boost = 0.04 },
	LavaTRex = { Name = "Inferno Rex", Kind = "trex", Crystal = Color3.fromRGB(60, 44, 44), Rim = Color3.fromRGB(255, 110, 30), BoostKind = "Speed", Boost = 0.06 },
	Phoenix = { Name = "Solar Phoenix", Kind = "phoenix", Crystal = Color3.fromRGB(240, 80, 40), Rim = Color3.fromRGB(255, 210, 60), BoostKind = "Luck", Boost = 0.06 },
	CosmicDragon = { Name = "Void Dragon", Kind = "dragon", Crystal = Color3.fromRGB(70, 60, 170), Rim = Color3.fromRGB(240, 140, 255), BoostKind = "Luck", Boost = 0.1, Chase = true },
	StarPterodactyl = { Name = "Nova Ptera", Kind = "pterodactyl", Crystal = Color3.fromRGB(60, 90, 200), Rim = Color3.fromRGB(255, 230, 120), BoostKind = "Coins", Boost = 0.08, Retired = true }, -- retired from eggs 2026-10-15 (owner); owned ones keep working
	-- Meadow pets added 2026-10-11 (Kind = a stand-in body until the owner's mesh exists; REPLACE: Pet_<id> under PetModels).
	Puffquill = { Name = "Puffquill", Kind = "ostrich", Crystal = Color3.fromRGB(250, 200, 220), Rim = Color3.fromRGB(255, 250, 250), BoostKind = "Coins", Boost = 0.01 },
	Pebblehorn = { Name = "Pebblehorn", Kind = "mammoth", Crystal = Color3.fromRGB(150, 140, 120), Rim = Color3.fromRGB(230, 220, 190), BoostKind = "Coins", Boost = 0.01 },
	Mosswhip = { Name = "Mosswhip", Kind = "raptor", Crystal = Color3.fromRGB(90, 160, 80), Rim = Color3.fromRGB(200, 240, 140), BoostKind = "Speed", Boost = 0.01 },
	Honeyhoof = { Name = "Unicorn", Kind = "mammoth", Crystal = Color3.fromRGB(240, 180, 60), Rim = Color3.fromRGB(255, 240, 180), BoostKind = "Luck", Boost = 0.01 },
	Bramblebat = { Name = "Bramblebat", Kind = "pterodactyl", Crystal = Color3.fromRGB(110, 80, 120), Rim = Color3.fromRGB(170, 220, 110), BoostKind = "Speed", Boost = 0.01, Weekly = true },
	Clovercrest = { Name = "Clovercrest", Kind = "griffin", Crystal = Color3.fromRGB(90, 190, 110), Rim = Color3.fromRGB(255, 255, 200), BoostKind = "Luck", Boost = 0.01, Weekly = true },
	SunpetalDrake = { Name = "Sunpetal Drake", Kind = "dragon", Crystal = Color3.fromRGB(250, 210, 70), Rim = Color3.fromRGB(255, 130, 170), BoostKind = "Luck", Boost = 0.03, Chase = true },
	-- Forest pets added 2026-10-11 (Kind = a stand-in body until the owner's mesh exists; REPLACE: Pet_<id> under PetModels).
	Duskwing = { Name = "Duskwing", Kind = "griffin", Crystal = Color3.fromRGB(90, 70, 120), Rim = Color3.fromRGB(250, 210, 120), BoostKind = "Luck", Boost = 0.02 },
	Oakmaw = { Name = "Oakmaw", Kind = "mammoth", Crystal = Color3.fromRGB(120, 80, 50), Rim = Color3.fromRGB(150, 200, 90), BoostKind = "Coins", Boost = 0.02 },
	Thornhoof = { Name = "Thornhoof", Kind = "ostrich", Crystal = Color3.fromRGB(170, 120, 80), Rim = Color3.fromRGB(130, 200, 90), BoostKind = "Speed", Boost = 0.02 },
	Vinetail = { Name = "Vinetail", Kind = "wolf", Crystal = Color3.fromRGB(230, 110, 50), Rim = Color3.fromRGB(140, 210, 90), BoostKind = "Speed", Boost = 0.02 },
	Mossback = { Name = "Mossback", Kind = "trex", Crystal = Color3.fromRGB(80, 120, 70), Rim = Color3.fromRGB(180, 220, 120), BoostKind = "Coins", Boost = 0.02, Weekly = true },
	Hollowfang = { Name = "Tiger", Kind = "wolf", Crystal = Color3.fromRGB(70, 70, 80), Rim = Color3.fromRGB(160, 240, 200), BoostKind = "Speed", Boost = 0.02, Weekly = true },
	Elderhorn = { Name = "Crystal Deer", Kind = "mammoth", Crystal = Color3.fromRGB(200, 240, 230), Rim = Color3.fromRGB(120, 255, 200), BoostKind = "Luck", Boost = 0.04, Chase = true },
	-- Snow pets added 2026-10-11 (Kind = a stand-in body until the owner's mesh exists; REPLACE: Pet_<id> under PetModels).
	Frostpaw = { Name = "Ice Lion", Kind = "wolf", Crystal = Color3.fromRGB(200, 230, 250), Rim = Color3.fromRGB(120, 180, 240), BoostKind = "Speed", Boost = 0.04 },
	Yetiboo = { Name = "Grizzly Bear", Kind = "mammoth", Crystal = Color3.fromRGB(240, 245, 255), Rim = Color3.fromRGB(150, 200, 240), BoostKind = "Coins", Boost = 0.04 },
	Shiverclaw = { Name = "Shiverclaw", Kind = "raptor", Crystal = Color3.fromRGB(120, 190, 230), Rim = Color3.fromRGB(240, 250, 255), BoostKind = "Speed", Boost = 0.04 },
	AuroraHoot = { Name = "Aurora Hoot", Kind = "griffin", Crystal = Color3.fromRGB(110, 220, 200), Rim = Color3.fromRGB(220, 150, 255), BoostKind = "Luck", Boost = 0.04 },
	Waddlefrost = { Name = "Waddlefrost", Kind = "ostrich", Crystal = Color3.fromRGB(40, 50, 70), Rim = Color3.fromRGB(250, 250, 255), BoostKind = "Coins", Boost = 0.04, Weekly = true },
	Hailwing = { Name = "Hailwing", Kind = "pterodactyl", Crystal = Color3.fromRGB(170, 200, 230), Rim = Color3.fromRGB(255, 255, 255), BoostKind = "Speed", Boost = 0.04, Weekly = true },
	FrostcrownDragon = { Name = "Frostcrown Dragon", Kind = "dragon", Crystal = Color3.fromRGB(150, 220, 255), Rim = Color3.fromRGB(255, 255, 255), BoostKind = "Luck", Boost = 0.06, Chase = true },
	-- Volcano pets added 2026-10-11 (Kind = a stand-in body until the owner's mesh exists; REPLACE: Pet_<id> under PetModels).
	Cinderpup = { Name = "Cinderpup", Kind = "wolf", Crystal = Color3.fromRGB(90, 60, 50), Rim = Color3.fromRGB(255, 140, 40), BoostKind = "Speed", Boost = 0.06 },
