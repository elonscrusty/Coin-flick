	Ashwing = { Golden = "rbxassetid://139107589087795", Rainbow = "rbxassetid://129938277255482", SilverCosmic = "rbxassetid://75749729361767", Skeleton = "rbxassetid://82132434875177" }, -- realistic colours 10-15
