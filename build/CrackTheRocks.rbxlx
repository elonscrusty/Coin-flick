			{ Name = "FrameDark", Slot = "FrameDark", Material = "Metal", Color = Color3.fromRGB(54, 63, 72), Offset = { 0, 0, -0.08 }, Size = { 0.62, 1.15, 0.16 } },
			{ Name = "SteelLight", Slot = "SteelLight", Material = "Metal", Color = Color3.fromRGB(184, 192, 200), Offset = { 0, 0, -0.19 }, Size = { 0.1386, 0.96, 0.06 } },
			{ Name = "Lamp", Slot = "Lamp", Material = "Neon", Color = Color3.fromRGB(255, 201, 58), Offset = { 0, -0.32, -1.4 }, Size = { 0.4, 0.6, 0.4 } },
		},
	},
}

return Catalog
]]></string>
