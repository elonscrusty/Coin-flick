            </Vector3>
            <Content name="TextureID">
              <url>rbxassetid://107725290581100</url>
            </Content>
          </Properties>
          <Item class="Bone" referent="15">
            <Properties>
              <string name="Name">CosmicDragon_Body</string>
              <CoordinateFrame name="CFrame">
                <X>0</X>
                <Y>-0.80000305</Y>
                <Z>0.099998474</Z>
                <R00>1</R00>
