                <CoordinateFrame name="CFrame">
                  <X>-0.38000107</X>
                  <Y>1</Y>
                  <Z>0.099998474</Z>
                  <R00>0.9997851</R00>
                  <R01>-0.015317678</R01>
                  <R02>0.013967358</R02>
                  <R10>0.015317676</R10>
                  <R11>0.09190607</R11>
                  <R12>-0.99564993</R12>
                  <R20>0.0139673585</R20>
                  <R21>0.99564993</R21>
                  <R22>0.09212095</R22>
                </CoordinateFrame>
              </Properties>
            </Item>
            <Item class="Bone" referent="17">
              <Properties>
                <string name="Name">CosmicDragon_LegR</string>
                <CoordinateFrame name="CFrame">
                  <X>0.37999725</X>
                  <Y>1</Y>
                  <Z>0.099998474</Z>
                  <R00>0.9997851</R00>
                  <R01>-0.015317678</R01>
