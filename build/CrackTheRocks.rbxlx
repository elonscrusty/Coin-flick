local function sources(zone: string?): ({ [string]: MeshPart }, { [string]: MeshPart })
	local pieces: { [string]: MeshPart } = {}
	local props: { [string]: MeshPart } = {}
	local function collect(folder: Instance?)
		if folder then
			for _, d in folder:GetDescendants() do
				if d:IsA("MeshPart") then
					-- "Hunt_Ground_Snow.001" and "Hunt_Ground" both count as Hunt_Ground
					local name = string.gsub(string.gsub(d.Name, "%.%d+$", ""), "_(%a+)$", function(z)
						return if z == zone then "" else "_" .. z
					end)
					pieces[name] = pieces[name] or d
				end
			end
		end
	end
	if zone and zone ~= "Meadow" then
		collect(ServerStorage:FindFirstChild("HuntLowPoly_" .. zone))
	end
	collect(ServerStorage:FindFirstChild("HuntLowPoly"))
	local lib = ServerStorage:FindFirstChild("LowPolyLib")
	if lib then
		for _, m in lib:GetChildren() do
			local stem = string.match(m.Name, "^(.-)_LowPoly$")
			local mp = stem and m:FindFirstChildWhichIsA("MeshPart", true)
			if stem and mp then
				props[stem] = mp
			end
		end
	end
	return pieces, props
end

function HuntLowPoly.available(): boolean
	local pieces = sources()
	local ground: MeshPart? = pieces["Hunt_Ground"]
	return ground ~= nil
end

-- A textured mesh ignores Color: drop its texture so the flat zone colour shows (flat low-poly style). Clones only:
-- each zone builds fresh copies, so the Meadow keeps the textures as built.
local function flatColor(p: BasePart, col: Color3)
	if p:IsA("MeshPart") then
		p.TextureID = ""
	end
	for _, c in p:GetChildren() do
		if c:IsA("SurfaceAppearance") then
			c:Destroy()
		end
	end
	p.Color = col
end

local function finish(p: BasePart)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p:SetAttribute("CameraIgnore", true)
end

-- worksite props the set replaces (no lamps in the meadow, owner rule; hay and crates come back as low-poly props)
local function worksiteCovered(name: string): boolean
	return name == "CT_Rocks_LampMast" or string.match(name, "Wall_Lamp") ~= nil or name == "CT_Rocks_HayBale" or name == "CT_Rocks_Pallet"
		or string.match(name, "^CT_Rocks_Crate") ~= nil or string.match(name, "Shelter") ~= nil
end

local function hideIn(container: Instance, hide: boolean)
	for _, d in container:GetDescendants() do
		if d:IsA("BasePart") and not KEEP_VISIBLE[d.Name] then
			local saved = d:GetAttribute("LPHidden")
			if hide and saved == nil then
				d:SetAttribute("LPHidden", d.Transparency)
				d.Transparency = 1
				-- hidden props must not block (invisible roofs, trunks, crates); floors, pads, walls and rails stay solid
				if d.CanCollide and not KEEP_SOLID[d.Name] and not (d.Parent and KEEP_SOLID_IN[d.Parent.Name]) then
					d:SetAttribute("LPCollide", true)
					d.CanCollide = false
				end
			elseif hide then
				-- already hidden, but a zone re-skin (ZoneScenery) may have shown it again: keep it hidden
				d.Transparency = 1
			elseif not hide and type(saved) == "number" then
				d.Transparency = saved
				d:SetAttribute("LPHidden", nil)
				if d:GetAttribute("LPCollide") then
					d.CanCollide = true
					d:SetAttribute("LPCollide", nil)
				end
			end
		elseif d:IsA("Light") then
			-- remember lights that were on, so restoring never switches on one that was off
			if hide and d.Enabled then
				d:SetAttribute("LPLight", true)
				d.Enabled = false
			elseif not hide and d:GetAttribute("LPLight") then
				d.Enabled = true
				d:SetAttribute("LPLight", nil)
			end
		elseif d:IsA("LayerCollector") and not (d.Parent and KEEP_VISIBLE[d.Parent.Name]) then
			-- a sign's words go with its part: the hidden gate sign left "PET MEADOW" floating in the sky (sweep 191)
			if hide and d.Enabled then
				d:SetAttribute("LPGui", true)
				d.Enabled = false
			elseif not hide and d:GetAttribute("LPGui") then
				d.Enabled = true
				d:SetAttribute("LPGui", nil)
			end
		end
	end
end

local function setCovered(root: Instance, hide: boolean)
	for _, name in COVERED do
		local f = root:FindFirstChild(name)
		if f then
			hideIn(f, hide)
		end
	end
	local site = root:FindFirstChild("CT_Rocks_Worksite")
	if site then
		for _, m in site:GetChildren() do
			if worksiteCovered(m.Name) then
				hideIn(m, hide)
			end
		end
	end
end

-- the worksite's hay bales and crates as low-poly props at the same spots and heights
local function swapWorksite(root: Instance, f: Instance, props: { [string]: MeshPart }, tex: { [string]: string }?, fenceHalf: number, c: Vector3)
	local site = root:FindFirstChild("CT_Rocks_Worksite")
	if not site then
		return
	end
	-- a few props only (the full set crowded the path by the shell stall): the rest stay hidden with the procedural site
	local KEEP = { HayBale = 2, Crate = 1 }
	local count: { [string]: number } = {}
	for _, m in site:GetChildren() do
		local stem = if m.Name == "CT_Rocks_HayBale" then "HayBale" elseif string.match(m.Name, "^CT_Rocks_Crate") then "Crate" else nil
		if stem then
			count[stem] = (count[stem] or 0) + 1
			if count[stem] > KEEP[stem] then
				stem = nil
			end
		end
		local src = stem and props[stem]
		if src and m:IsA("Model") then
			local cf, size = m:GetBoundingBox()
			local p = src:Clone()
			p.Name = stem :: string
			p.Size = src.Size * (size.Y / src.Size.Y) * 0.65 -- the kit props read oversized next to the tables
			local _, yaw = m:GetPivot():ToEulerAnglesYXZ()
			-- the arena-local spot steps off the fence like any prop (cf is world space, c the arena centre)
			local ox, oz = c.X, c.Z
			local nx, nz = HuntPlacement.spot(stem :: string, cf.X - ox, cf.Z - oz, 0.5 * math.max(p.Size.X, p.Size.Z), fenceHalf)
			p.CFrame = CFrame.new(ox + nx, cf.Y - size.Y / 2 + p.Size.Y / 2, oz + nz) * CFrame.Angles(0, yaw, 0) * FLIP
			if tex and tex[stem :: string] then
				p.TextureID = tex[stem :: string]
			end
			finish(p)
			p.Parent = f
		end
	end
end

-- water: a slow bob (the only moving piece)
local function bobWater(p: BasePart)
	local TweenService = game:GetService("TweenService")
	local tw = TweenService:Create(p, TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { CFrame = p.CFrame * CFrame.new(0, 0.18, 0) })
	tw:Play()
	p.Destroying:Once(function()
		tw:Cancel()
	end)
	-- a few soft glints drifting on the surface (polish #38); tagged so Low Effects can switch them off
	local glint = Instance.new("ParticleEmitter")
	glint.Name = "WaterSparkle"
	glint.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	glint.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 240, 255))
	glint.LightEmission = 0.8
	glint.Rate = 6
	glint.Lifetime = NumberRange.new(0.6, 1.2)
	glint.Speed = NumberRange.new(0, 0.3)
	glint.SpreadAngle = Vector2.new(180, 0)
	glint.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, 0.45), NumberSequenceKeypoint.new(1, 0) })
	glint.Transparency = NumberSequence.new(0.2)
	glint.Parent = p
	game:GetService("CollectionService"):AddTag(glint, "PetSparkle")
end

-- props that are trees or bushes (zone LeafTint; the extra Forest trees use the tree ones)
local LEAFY: { [string]: boolean } = { PineTree = true, Kit_Pine_A = true, RoundTree = true, Kit_Tree_A = true, Kit_Tree_B = true, FlowerBush = true, Kit_Bush_A = true }
local BOULDERS: { [string]: boolean } = { Rock = true, Kit_Rock_A = true }
-- pieces that are the pale wood (deck, stalls, fence) and take the zone Wood tint
local WOODEN: { [string]: boolean } = { Hunt_Ledge = true, Hunt_Stalls = true, Hunt_Fence = true }
local WHITE = Color3.new(1, 1, 1)

local FOREST_EXTRAS = HuntPlacement.forestExtras()

-- ground height under arena-local (x, z): ray onto the low-poly ground and ledge (CanQuery is off on them, so it is
-- switched on for the cast only); falls back to the flat floor / bench
local function groundY(f: Instance, base: CFrame, x: number, z: number): number
	local hits: { BasePart } = {}
	for _, n in { "Hunt_Ground", "Hunt_Ledge" } do
		local g = f:FindFirstChild(n)
		if g and g:IsA("BasePart") then
			table.insert(hits, g)
		end
	end
	local fallback = if x > ZoneThemes.Layout.DropX then ZoneThemes.Layout.BenchY else 0
	if #hits == 0 then
		return fallback
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = table.clone(hits) :: { any }
	for _, g in hits do
		g.CanQuery = true
	end
	local from = base * CFrame.new(x, 40, z)
	local hit = workspace:Raycast(from.Position, Vector3.new(0, -80, 0), params)
	for _, g in hits do
		g.CanQuery = false
	end
	return if hit then hit.Position.Y - base.Y else fallback
end

local function deco(f: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CastShadow = false
	finish(p)
	p.Parent = f
	return p
end

-- Space: shallow craters on the floor between the nests and crystal clusters just outside the fence (procedural,
-- no asset ids; REPLACE with real meshes when uploaded). Built after the set is parented (ground rays need it).
local function spaceDressing(f: Instance, base: CFrame, t: ZoneThemes.Theme, fenceHalf: number)
	local rng = Random.new(5151)
	local rim, pit = Color3.fromRGB(150, 128, 196), Color3.fromRGB(112, 92, 160)
	for k = 0, 11 do
		local a = math.rad(k * 30 + 15)
		local r = if k % 2 == 0 then 24 else 38
		local x, z = math.cos(a) * r, math.sin(a) * r
		local dia = rng:NextNumber(5, 8)
		if not keptOut(x, z, dia / 2) and not (z < 0 and math.abs(x) < ZoneThemes.Layout.RoadHalfWidth + 3) then
			local y = groundY(f, base, x, z)
			local at = base * CFrame.new(x, y, z)
			-- cylinders run along X: stand them on end
			deco(f, "CraterRim", Vector3.new(0.5, dia, dia), at * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)), rim, Enum.Material.Slate, Enum.PartType.Cylinder)
			deco(f, "CraterPit", Vector3.new(0.5, dia * 0.7, dia * 0.7), at * CFrame.new(0, 0.14, 0) * CFrame.Angles(0, 0, math.rad(90)), pit, Enum.Material.Slate, Enum.PartType.Cylinder)
		end
	end
	for _, ring in ZoneThemes.ringSpots() do
		-- pushed out to 6 studs past the fence square (3 clear + the cluster's own 3 of spread); the clusters stood on the fence
		local cx, cz = HuntPlacement.pushOut(ring.X, ring.Z, fenceHalf, 6)
		local spot = Vector3.new(cx, 0, cz)
		local y = groundY(f, base, spot.X, spot.Z)
		for k = 1, 3 do
			local h = rng:NextNumber(3, 7)
			local w = rng:NextNumber(0.9, 1.5)
			local cf = base * CFrame.new(spot.X + rng:NextNumber(-1.5, 1.5), y, spot.Z + rng:NextNumber(-1.5, 1.5))
				* CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, math.pi), rng:NextNumber(-0.35, 0.35))
			local neon = k == 1
			deco(f, "Crystal", Vector3.new(w, h, w), cf * CFrame.new(0, h * 0.4, 0) * CFrame.Angles(0, math.rad(45), 0),
				if neon then t.Accent else t.Rock, if neon then Enum.Material.Neon else Enum.Material.Glass)
		end
	end
end

-- The zone's own piece set (ServerStorage.HuntZoneKit_<Zone>, contract in Shared.HuntZoneKit): key -> source piece
-- (MeshPart or Model) and the roles present. Empty when the zone has no kit yet (the tinted meadow set is used).
local function kitPieces(zone: string): ({ [string]: Instance }, HuntZoneKit.Plan)
	local found: { [string]: Instance } = {}
	local names: { string } = {}
	local function walk(folder: Instance)
		for _, ch in folder:GetChildren() do
			if ch:IsA("Folder") then
				walk(ch)
			elseif ch:IsA("BasePart") or ch:IsA("Model") then
				local _, key = HuntZoneKit.roleOf(ch.Name, zone)
				if key and not found[key] then
					found[key] = ch
					table.insert(names, ch.Name)
				end
			end
		end
	end
	local folder = ServerStorage:FindFirstChild(HuntZoneKit.folderName(zone))
	if folder then
		walk(folder)
	end
	return found, HuntZoneKit.plan(names, zone)
end

-- Places one kit piece on arena spot `slot`: its box bottom on the floor (y 0, the bench past the east drop), its
-- box centre on the spot, front toward the arena; the piece's Offset / Yaw / Scale attributes tune it in Studio.
-- Visual only (no collision, no queries) except the Ground, which is walked on. `fit` scales on top of Scale and
-- `y` overrides the floor height (scatter rows carry their own).
local function placeKit(f: Instance, src: Instance, role: string, slot: HuntZoneKit.Slot, base: CFrame, fit: number?, y: number?): Instance
	local copy = src:Clone()
	local scale = src:GetAttribute("Scale")
	local offset = src:GetAttribute("Offset")
	local yaw = src:GetAttribute("Yaw")
	-- (a scatter piece ignores Scale: it is fitted to the footprint the fence checks were made for)
	local k = (if typeof(scale) == "number" and scale > 0 and role ~= "Scatter" then scale else 1) * (fit or 1)
	local floorY = y or (if slot.X > ZoneThemes.Layout.DropX and role ~= "Ground" then ZoneThemes.Layout.BenchY else 0)
	local cf = base * CFrame.new(slot.X, floorY, slot.Z)
		* CFrame.Angles(0, slot.Yaw + (if typeof(yaw) == "number" then math.rad(yaw) else 0), 0)
		* CFrame.new(if typeof(offset) == "Vector3" then offset else Vector3.zero)
	local walk = role == "Ground"
	local function setup(p: BasePart)
		finish(p)
		p.CanCollide = walk
		p.CastShadow = not walk and role ~= "PathEdge"
	end
	if copy:IsA("Model") then
		if k ~= 1 then
			copy:ScaleTo(copy:GetScale() * k)
		end
		copy:PivotTo(cf)
		local bcf, bsize = copy:GetBoundingBox()
		local bottom = bcf.Position - Vector3.new(0, bsize.Y / 2, 0)
		copy:PivotTo(copy:GetPivot() + (cf.Position - bottom))
		for _, d in copy:GetDescendants() do
			if d:IsA("BasePart") then
				setup(d)
			end
		end
	elseif copy:IsA("BasePart") then
		copy.Size *= k
		copy.CFrame = cf * CFrame.new(0, copy.Size.Y / 2, 0)
		setup(copy)
		for _, d in copy:GetDescendants() do
			if d:IsA("BasePart") then
				setup(d)
			end
		end
	end
	copy:SetAttribute("ZoneKit", role) -- the client can find the hero and the gate (animation, VFX)
	copy.Parent = f
	return copy
end

-- Shows the low-poly set of hunt tier `tierId` (its zone: Meadow, Forest, Snow, Volcano, Space) on arena `root`
-- (centre `c`), rebuilding it when the zone changes; without the meshes it removes the set and restores the
-- procedural parts. Safe to call every round.
-- ground colour of the skirt under each zone's arena
local SKIRT: { [string]: Color3 } = {
	Meadow = Color3.fromRGB(116, 196, 74),
	Forest = Color3.fromRGB(62, 122, 52),
	Snow = Color3.fromRGB(226, 234, 245),
	Volcano = Color3.fromRGB(96, 70, 60),
	Space = Color3.fromRGB(150, 130, 190), -- lilac rock (the sky stays bright day)
}

function HuntLowPoly.apply(root: Instance, c: Vector3, tierId: string?)
	local zone = ZONE_OF_TIER[tierId or "Gravel"] or "Meadow"
	local theme = ZoneThemes.get(tierId)
	local old = root:FindFirstChild(FOLDER)
	if old and old:GetAttribute("Zone") ~= zone then
		old:Destroy()
		old = nil
	end
	if not HuntLowPoly.available() then
		if old then
			old:Destroy()
		end
		if root:GetAttribute("LPCovered") then
			-- (also after a zone change destroyed the old set above) put the procedural parts back
			setCovered(root, false)
			root:SetAttribute("LPCovered", nil)
		end
		return
	end
	if old then
		setCovered(root, true) -- zone re-skins re-create ZoneScenery: keep it hidden
		return
	end
	local pieces, props = sources(zone)
	local tex = PROP_TEX[zone]
	-- the zone's own pieces swap in role by role; every role it lacks keeps the tinted meadow piece
	local kit, kitPlan = kitPieces(zone)
	local scatterKeys: { string } = kitPlan.Scatter or {}
	local ownSkyline = kitPlan.Skyline ~= nil
	local hasKit = next(kit) ~= nil
	local style = HuntZoneKit.Style[zone] or HuntZoneKit.Style.Meadow
	local function replaced(prop: string): boolean
		return (#scatterKeys > 0 and HuntZoneKit.Scatterable[prop] == true)
			or (ownSkyline and string.sub(prop, 1, 5) == "Cliff" and prop ~= "CliffPine")
	end
	-- the fence line, measured from the fence mesh (a square about 85 x 85: half of its box is where the line runs)
	local fenceSrc = pieces.Hunt_Fence
	local fenceHalf = if fenceSrc then math.min(fenceSrc.Size.X, fenceSrc.Size.Z) / 2 else HuntPlacement.FenceHalf
	local f = Instance.new("Folder")
	f.Name = FOLDER
	f:SetAttribute("Zone", zone)
	local base = CFrame.new(c)
	-- the owner's StonePad mesh (Shared.WorldKit) on each station pad instead of the merged Hunt_Pads piece: stretched
	-- to the hidden procedural Pad slab's box (11.6 x PAD_TOP x 8.8, ArenaBuilder), so its top is where the nest
	-- table stands; visual only, the hidden Pad keeps the collision
	local stonePads = WorldKit.has("StonePad")
	if stonePads then
		local padsFolder = root:FindFirstChild("CT_Rocks_StationPads")
		local padModels: { Instance } = if padsFolder then padsFolder:GetChildren() else {}
		for _, pad in padModels do
			local slab = pad:FindFirstChild("Pad")
			local p = if slab and slab:IsA("BasePart") then WorldKit.clone("StonePad", "StonePad") else nil
			if p and slab and slab:IsA("BasePart") then
				WorldKit.fitBox(p, slab.CFrame, slab.Size)
				if zone ~= "Meadow" then
					flatColor(p, theme.Stone) -- the zone's stepping-stone colour (the Meadow keeps the mesh as built)
				end
				finish(p)
				p.CastShadow = false
				p.Parent = f
			end
		end
	end
	for name, at in PIECES do
		local skip = SKIP_PIECE[name] or (stonePads and name == "Hunt_Pads") or (theme.HideWater and name == "Hunt_Water")
			or (name == "Hunt_Ground" and kitPlan.Ground ~= nil)
		local src = if skip then nil else pieces[name]
		if src then
			local p = src:Clone()
			p.Name = name
			p.CFrame = base * CFrame.new(at) * FLIP
			finish(p)
			p.CastShadow = name ~= "Hunt_Ground" and name ~= "Hunt_Nest" and name ~= "Hunt_Pads" and name ~= "Hunt_Water"
			if name == "Hunt_Pads" then
				-- hex stepping stones: the zone's stone (Meadow: warm sandy, the plain blue-grey read as unfinished)
				p.Color = theme.Stone
			elseif WOODEN[name] and theme.Wood ~= WHITE then
				p.Color = theme.Wood
			elseif name == "Hunt_Ground" and theme.GroundTint then
				p.Color = theme.GroundTint -- a tint only: the ground keeps its own texture (dirt path, facets)
			end
			if name == "Hunt_Ground" or name == "Hunt_Ledge" then
				-- walk on the low-poly ground itself (it rises gently toward the fence; the flat floor stays under it).
				-- (Default collision fidelity: a convex decomposition of the mesh)
				p.CanCollide = true
			end
			p.Parent = f
		end
	end
	-- merged meshes (IMPORT_NOW4 merged/, pieces HuntMerged_<Prop>): one mesh stands in for every scenery copy of
	-- that prop, so the arena has far fewer parts
	-- a prop with any spot inside the keep-out is placed one by one (its merged mesh would bring that copy along)
	local function propRadius(s: { any }): number
		local src = props[s[1]]
		return if src then 0.5 * math.max(src.Size.X, src.Size.Z) * s[6] else 0
	end
	-- where a prop stands: props that would clip the square fence (within 3 studs of it, trees by their trunk) step 3
	-- studs clear of it, perpendicular to the line (the cliffs are the backdrop and stay put)
	local function spot(s: { any }): (number, number)
		return HuntPlacement.spot(s[1], s[2], s[4], propRadius(s), fenceHalf)
	end
	-- a prop that had to move (its merged mesh would bring the old copy), or that would crowd a shell stand
	local function blocked(s: { any }): boolean
		local x, z = spot(s)
		return x ~= s[2] or z ~= s[4] or nearHopper(x, z, propRadius(s))
	end
	local mergeOk: { [string]: boolean } = {}
	for prop in MERGED do
		mergeOk[prop] = not NO_MERGE[prop] and not replaced(prop)
	end
	for _, s in SCENERY do
		if mergeOk[s[1]] and (keptOut(s[2], s[4], propRadius(s)) or blocked(s)) then
			mergeOk[s[1]] = false
		end
	end
	local merged: { [string]: boolean } = {}
	for prop, at in MERGED do
		local src = if mergeOk[prop] then pieces["HuntMerged_" .. prop] else nil
		if src then
			merged[prop] = true
			local p = src:Clone()
			p.Name = "HuntMerged_" .. prop
			p.CFrame = base * CFrame.new(at) * FLIP
			if tex and tex[prop] then
				p.TextureID = tex[prop]
			end
			if BOULDERS[prop] and theme.Boulder then
				flatColor(p, theme.Boulder)
			elseif prop == "Kit_Rock_A" then
				p.Color = Color3.fromRGB(255, 226, 178) -- the flat stone slabs by the nests: warm, not pale blue-grey
			elseif LEAFY[prop] and theme.LeafTint then
				p.Color = theme.LeafTint
			end
			finish(p)
			p.Parent = f
		end
	end
	-- the owner's small mushroom cluster (ServerStorage.WorldKit_LowPoly) stands in for the giant mushroom
	local wk = game:GetService("ServerStorage"):FindFirstChild("WorldKit_LowPoly")
	local smallShroom = wk and wk:FindFirstChild("Mushrooms_Small")
	local scenery = SCENERY
	if theme.ExtraTrees then
		scenery = table.clone(SCENERY)
		table.move(FOREST_EXTRAS, 1, #FOREST_EXTRAS, #scenery + 1, scenery)
	end
	for i, s in scenery do
		local swapKey = HuntZoneKit.scatterFor(s[1], i, scatterKeys)
		local swap = if swapKey then kit[swapKey] else nil
		local sx, sz = spot(s)
		if swap then
			-- the zone's scatter prop, fitted to the footprint of the meadow prop it stands in for (the placement
			-- checks were made for that footprint), BigScatter times that outside the fence (re-spotted for the bigger
			-- footprint, so it still clears the fence); a meadow prop without its mesh keeps the scatter's own size
			local r0 = propRadius(s)
			local big = HuntZoneKit.outside(s[2], s[4], r0 * HuntZoneKit.BigScatter, fenceHalf)
			local rr = if big then r0 * HuntZoneKit.BigScatter else r0
			local bx, bz = sx, sz
			if big then
				bx, bz = HuntPlacement.spot(s[1], s[2], s[4], rr, fenceHalf)
			end
			if not keptOut(bx, bz, rr) and not nearHopper(bx, bz, rr) and not HuntZoneKit.inLane(bx, bz, rr, fenceHalf) then
				local ext = if swap:IsA("Model") then swap:GetExtentsSize() elseif swap:IsA("BasePart") then swap.Size else Vector3.one
				local fit = if rr > 0 then HuntZoneKit.fitScale(math.max(ext.X, ext.Z), 2 * rr) else (if big then HuntZoneKit.BigScatter else 1)
				placeKit(f, swap, "Scatter", { X = bx, Z = bz, Yaw = s[5] }, base, fit, s[3])
			end
			continue
		end
		if hasKit and HuntZoneKit.inLane(sx, sz, propRadius(s), fenceHalf) then
			continue -- the clear central path
		end
		if replaced(s[1]) then
			continue
		end
		local small = s[1] == "Mushroom" and smallShroom and smallShroom:IsA("MeshPart")
		local src = if small then smallShroom :: MeshPart else props[s[1]]
		if src and not merged[s[1]] and not keptOut(sx, sz, propRadius(s)) and not nearHopper(sx, sz, propRadius(s)) then
			local p = src:Clone()
			p.Name = s[1]
			p.Size = if small then src.Size * 1.6 else src.Size * s[6]
			p.CFrame = base * CFrame.new(sx, s[3] + p.Size.Y / 2, sz) * CFrame.Angles(0, s[5], 0) * FLIP
			if tex and tex[s[1]] and not small then
				p.TextureID = tex[s[1]]
			end
			if string.sub(s[1], 1, 5) == "Cliff" then
				p.Color = Color3.new(1, 1, 1) -- full texture brightness: the default grey tint made the cliffs gloomy
			elseif BOULDERS[s[1]] and theme.Boulder then
				flatColor(p, theme.Boulder)
			elseif LEAFY[s[1]] and theme.LeafTint and not small then
				p.Color = theme.LeafTint
			end
			finish(p)
			p.Parent = f
		end
	end
	swapWorksite(root, f, props, tex, fenceHalf, c)
	-- a wide meadow skirt under the arena so the island edge and the sea never show past the cliffs
	do
		local skirt = Instance.new("Part")
		skirt.Name = "HuntSkirt"
		skirt.Size = Vector3.new(256, 1, 256) -- arenas sit 260 apart: never reach the next one
		skirt.CFrame = base * CFrame.new(0, -0.6, 0)
		skirt.Color = SKIRT[zone] or SKIRT.Meadow -- the zone ground colour (the ground mesh itself is white and textured)
		skirt.Material = Enum.Material.SmoothPlastic
		skirt.Anchored = true
		skirt.CanCollide = false
		skirt.CanQuery = false
		skirt.CanTouch = false
		skirt.CastShadow = false
		skirt.Parent = f
	end
	-- the zone's skyline, hero, best-pet statue, gate arch, road trim and ground tile on their spots
	for role, keys in kitPlan do
		if role ~= "Scatter" and role ~= "LaneMarker" then
			-- ring roles: the narrowest piece sets the spacing, so the ring closes whatever the art's width
			local width: number? = nil
			if role == "Skyline" or role == "SkylineFill" then
				for _, key in keys do
					local src = kit[key]
					local sc = src:GetAttribute("Scale")
					local ext = if src:IsA("Model") then src:GetExtentsSize() elseif src:IsA("BasePart") then src.Size else nil
					if ext then
						local w = ext.X * (if typeof(sc) == "number" and sc > 0 then sc else 1)
						width = if width then math.min(width, w) else w
					end
				end
			end
			for _, slot in HuntZoneKit.slots(role, fenceHalf, keys, width) do
				local src = kit[slot.Variant or keys[1]]
				if src then
					local p = placeKit(f, src, role, slot, base)
					if role == "Ground" then
						p.Name = if p:IsA("BasePart") then "Hunt_Ground" else "ZoneGround" -- ground rays find a mesh ground
					end
				end
			end
		end
	end
	if hasKit then
		-- dense scatter clusters behind every nest, just outside the fence
		if #scatterKeys > 0 then
			local angles = {}
			for i = 1, Config.Station.Count do
				table.insert(angles, RoundRocks.stationAngle(i))
			end
			for k, cs in HuntZoneKit.clusterSpots(fenceHalf, angles) do
				local src = kit[scatterKeys[(k - 1) % #scatterKeys + 1]]
				local ext = if src:IsA("Model") then src:GetExtentsSize() elseif src:IsA("BasePart") then src.Size else Vector3.one
				local want = cs.Size * HuntZoneKit.BigScatter
				placeKit(f, src, "Scatter", { X = cs.X, Z = cs.Z, Yaw = cs.Yaw }, base, HuntZoneKit.fitScale(math.max(ext.X, ext.Z), want))
			end
		end
		-- lane markers along the north road (the kit's LaneMarker, else a glowing crystal pillar)
		local marker = kit.LaneMarker
		for _, m in HuntZoneKit.laneMarkers(fenceHalf) do
			if marker then
				placeKit(f, marker, "LaneMarker", m, base)
			else
				local cf = base * CFrame.new(m.X, 3.4, m.Z) * CFrame.Angles(0, m.Yaw, 0.12)
				local p = deco(f, "LaneMarker", Vector3.new(1.6, 7, 1.6), cf, style.Accent, Enum.Material.Neon)
				p:SetAttribute("ZoneKit", "LaneMarker")
				deco(f, "LaneMarkerBase", Vector3.new(3, 1, 3), base * CFrame.new(m.X, 0.5, m.Z) * CFrame.Angles(0, m.Yaw + 0.4, 0), style.Path, Enum.Material.SmoothPlastic)
			end
		end
	end
	f:SetAttribute("ZoneKit", hasKit)
	f.Parent = root
	if hasKit then
		-- the clear central path: flat strips on the ground from the hero's pad, down the road, through the gate, to
		-- the mound's edge (each strip on the ground under it)
		local half, zFar, zNear = HuntZoneKit.lane(fenceHalf)
		local z = zFar
		while z < zNear do
			local len = math.min(8, zNear - z)
			local y = groundY(f, base, 0, z + len / 2)
			local strip = deco(f, "ZonePath", Vector3.new(half * 2, 0.3, len + 0.4), base * CFrame.new(0, y + 0.12, z + len / 2), style.Path, Enum.Material.SmoothPlastic)
			strip.CastShadow = false
			z += len
		end
		-- contrasting pad + beacon light shaft at the two focal points: the hero and the gate
		for _, fp in { { 0, HuntZoneKit.HeroZ, 30, 160 }, { 0, -(fenceHalf + 4), 16, 0 } } do
			local px, pz, d, tall = fp[1], fp[2], fp[3], fp[4]
			local y = groundY(f, base, px, pz)
			local disc = CFrame.Angles(0, 0, math.pi / 2)
			deco(f, "FocalRing", Vector3.new(0.4, d + 2, d + 2), base * CFrame.new(px, y + 0.18, pz) * disc, style.Accent, Enum.Material.Neon, Enum.PartType.Cylinder)
			local pad = deco(f, "FocalPad", Vector3.new(0.5, d, d), base * CFrame.new(px, y + 0.3, pz) * disc, style.Pad, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
			local light = Instance.new("PointLight")
			light.Color = style.Accent
			light.Range = 24
			light.Brightness = 2
			light.Parent = pad
			if tall > 0 then
				local shaft = deco(f, "Beacon", Vector3.new(tall, 7, 7), base * CFrame.new(px, y + tall / 2, pz) * disc, style.Accent, Enum.Material.Neon, Enum.PartType.Cylinder)
				shaft.Transparency = 0.55
				shaft:SetAttribute("ZoneKit", "Beacon")
			end
		end
	end
	if theme.Craters then
		spaceDressing(f, base, theme, fenceHalf)
	end
	if hasKit or theme.Craters or zone == "Volcano" or zone == "Meadow" then
		-- a ring of hills past the fence hides the sea and the blue horizon (the sky itself stays bright day):
		-- lilac in Space, dark rock in the Volcano, grass green in the Meadow
		local volcano = zone == "Volcano"
		local meadowHills = zone == "Meadow"
		local hr = Random.new(7373)
		for k = 0, 17 do
			local a = math.rad(k * 20 + hr:NextNumber(-6, 6))
			local r = hr:NextNumber(150, 175)
			local d = hr:NextNumber(70, 110)
			-- (with a zone kit: always, in the zone's hill colours, as the backstop behind its skyline)
			local hill = deco(f, "SpaceHill", Vector3.new(d, d, d), base * CFrame.new(math.cos(a) * r, -d * 0.18, math.sin(a) * r),
				if hasKit then style.Hill[k % #style.Hill + 1]
				elseif volcano then (if k % 2 == 0 then Color3.fromRGB(88, 70, 66) else Color3.fromRGB(110, 84, 74))
					elseif meadowHills then (if k % 2 == 0 then Color3.fromRGB(112, 172, 88) else Color3.fromRGB(96, 154, 76))
					else (if k % 2 == 0 then Color3.fromRGB(176, 150, 226) else Color3.fromRGB(150, 124, 204)),
				Enum.Material.SmoothPlastic, Enum.PartType.Ball)
			hill.CastShadow = false
		end
	end
	-- the arena's own built pieces under the low-poly set (nest bases, machine-bay decks, the hopper apron) take the
	-- zone's stone / wood colours too; the Meadow puts back the colours they were built with
	local meadow = theme.Boulder == nil
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			local parent = d.Parent
			local pname = if parent then parent.Name else ""
			local col: Color3? = nil
			local kind = false
			if d.Name == "Clearance" and string.sub(pname, 1, 19) == "CT_Rocks_MachineBay" then
				d.Transparency = 1 -- the machine deck's corner brackets read as white litter on the deck
			elseif d.Name == "NestBase" then
				col, kind = theme.Stone, true
			elseif (d.Name == "Plate" or d.Name == "InputTray" or d.Name == "OutputTray") and string.sub(pname, 1, 16) == "CT_Rocks_Station" then
				-- the nest table's plate and trays: half way to the zone stone, so they still read as their own pieces
				local was = d:GetAttribute("ZoneBase")
				local orig: Color3 = if typeof(was) == "Color3" then was else d.Color
				col, kind = orig:Lerp(theme.Stone, 0.5), true
			elseif (d.Name == "ShieldFrame" or d.Name == "ShieldPost" or d.Name == "DockPost" or d.Name == "DockBrace") and string.sub(pname, 1, 16) == "CT_Rocks_Station" then
				-- the nest table's pale pink shield and dock posts read as white litter in every zone: plain wood brown, a
				-- touch of the zone stone outside the meadow
				local brown = Color3.fromRGB(150, 108, 72)
				d.Color = if meadow then brown else brown:Lerp(theme.Stone, 0.35)
			elseif (d.Name == "Pad" and string.sub(pname, 1, 19) == "CT_Rocks_MachineBay") or d.Name == "HopperApron" then
				col, kind = if theme.Wood ~= WHITE then theme.Wood else nil, true
			end
			if kind then
				local was = d:GetAttribute("ZoneBase")
				if typeof(was) ~= "Color3" then
					was = d.Color
					d:SetAttribute("ZoneBase", was)
				end
				d.Color = if meadow or not col then was :: Color3 else col
			end
		end
	end
	setCovered(root, true)
	root:SetAttribute("LPCovered", true)
	local water = f:FindFirstChild("Hunt_Water")
	if water and water:IsA("BasePart") then
		bobWater(water)
	end
end

return HuntLowPoly
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="226">
        <Properties>
          <string name="Name">KitParts</string>
          <string name="Source"><![CDATA[--!strict
-- Small reusable kit helpers for the lobby (LobbyBuilder) and anything else built from Parts:
-- part/model helpers, V4 palette, a blocky pixel font that makes sign titles out of real geometry
-- (the offline preview does not draw SurfaceGuis, and block letters never wrap), a fitted
-- SurfaceGui text label, and a few props (planter, bench, crate stack, lamp, tree, cliff).
-- Convention: kit frames put +Z toward the viewer (the "front" of a sign or building), -Z is the
-- back wall, +Y up. Pixel text and SurfaceGui labels on the +Z face read left to right.
-- REPLACE markers: these are procedural stand-ins for meshes (docs/ASSET_MANIFEST.md, lobby kit).

local Kit = {}

-- V4 section C palette
Kit.Char = Color3.fromRGB(32, 40, 51) -- #202833 deep charcoal
Kit.Slate = Color3.fromRGB(77, 91, 102) -- #4D5B66
Kit.Conc = Color3.fromRGB(193, 182, 162) -- #C1B6A2 warm concrete
Kit.Wood = Color3.fromRGB(168, 117, 72) -- #A87548
Kit.Amber = Color3.fromRGB(244, 190, 67) -- #F4BE43
Kit.Cream = Color3.fromRGB(244, 239, 229) -- #F4EFE5
Kit.Mint = Color3.fromRGB(114, 204, 160) -- #72CCA0
-- supporting tones derived from the palette
Kit.Pad = Color3.fromRGB(122, 115, 101) -- darker workshop pad
Kit.Paver = Color3.fromRGB(214, 204, 184) -- lighter inset stone
Kit.Wall = Color3.fromRGB(226, 218, 200) -- light wall panel
Kit.Shrub = Color3.fromRGB(96, 142, 96)
Kit.Soil = Color3.fromRGB(86, 70, 56)

local M = Enum.Material

function Kit.part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or M.SmoothPlastic
	p.Shape = shape or Enum.PartType.Block
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Decoration: no collision, never hit by raycasts.
function Kit.deco(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

function Kit.folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Kit.model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- A cylinder whose axis points up (Roblox cylinders run along X, so turn it).
function Kit.upCylinder(parent: Instance, name: string, diameter: number, height: number, cf: CFrame, color: Color3, mat: Enum.Material?): Part
	return Kit.part(parent, name, Vector3.new(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.rad(90)), color, mat, Enum.PartType.Cylinder)
end

-- A cylinder whose axis points along the frame's Z (a round disc facing the viewer).
function Kit.discZ(parent: Instance, name: string, diameter: number, thick: number, cf: CFrame, color: Color3, mat: Enum.Material?): Part
	return Kit.part(parent, name, Vector3.new(thick, diameter, diameter), cf * CFrame.Angles(0, math.rad(90), 0), color, mat, Enum.PartType.Cylinder)
end

function Kit.light(parent: Instance, kind: string, color: Color3, brightness: number, range: number, angle: number?): Light
	local l = Instance.new(kind) :: any
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	if angle and kind == "SpotLight" then
		l.Angle = angle
		l.Face = Enum.NormalId.Bottom
	end
	l.Parent = parent
	return l
end

-- One fitted single-line (or explicit multi-line) label on a part face. Text can never wrap
-- mid-line: TextWrapped is off, TextScaled shrinks it to the box, and a size cap keeps short
-- text from growing huge. `lines` splits the box height evenly when text holds "\n".
function Kit.label(p: BasePart, face: Enum.NormalId, text: string, color: Color3?, bg: Color3?, font: Enum.Font?, pxPerStud: number?): TextLabel
	local g = Instance.new("SurfaceGui")
	g.Name = "Label"
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = pxPerStud or 50
	g.LightInfluence = 0
	g.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = bg or Kit.Char
	t.BackgroundTransparency = if bg then 0 else 1
	t.TextColor3 = color or Kit.Cream
	t.Font = font or Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextWrapped = false
	t.Text = text
	t.Parent = g
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.PaddingTop = UDim.new(0.1, 0)
	pad.PaddingBottom = UDim.new(0.1, 0)
	pad.Parent = t
	return t
end

function Kit.prompt(p: BasePart, action: string, object: string, panel: string, dist: number?): ProximityPrompt
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = dist or 10
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R -- E is the crack key on keyboards
	if panel ~= "" then
		pp:SetAttribute("Panel", panel)
	end
	pp.Parent = p
	return pp
end

-- Pixel font ----------------------------------------------------------------------------------

local FONT: { [string]: { string } } = {
	A = { "01110", "10001", "10001", "11111", "10001", "10001", "10001" },
	B = { "11110", "10001", "10001", "11110", "10001", "10001", "11110" },
	C = { "01111", "10000", "10000", "10000", "10000", "10000", "01111" },
	D = { "11110", "10001", "10001", "10001", "10001", "10001", "11110" },
	E = { "11111", "10000", "10000", "11110", "10000", "10000", "11111" },
	F = { "11111", "10000", "10000", "11110", "10000", "10000", "10000" },
	G = { "01111", "10000", "10000", "10011", "10001", "10001", "01111" },
	H = { "10001", "10001", "10001", "11111", "10001", "10001", "10001" },
	I = { "11111", "00100", "00100", "00100", "00100", "00100", "11111" },
	J = { "00111", "00010", "00010", "00010", "00010", "10010", "01100" },
	K = { "10001", "10010", "10100", "11000", "10100", "10010", "10001" },
	L = { "10000", "10000", "10000", "10000", "10000", "10000", "11111" },
	M = { "10001", "11011", "10101", "10101", "10001", "10001", "10001" },
	N = { "10001", "11001", "10101", "10011", "10001", "10001", "10001" },
	O = { "01110", "10001", "10001", "10001", "10001", "10001", "01110" },
	P = { "11110", "10001", "10001", "11110", "10000", "10000", "10000" },
	Q = { "01110", "10001", "10001", "10001", "10101", "10010", "01101" },
	R = { "11110", "10001", "10001", "11110", "10100", "10010", "10001" },
	S = { "01111", "10000", "10000", "01110", "00001", "00001", "11110" },
	T = { "11111", "00100", "00100", "00100", "00100", "00100", "00100" },
	U = { "10001", "10001", "10001", "10001", "10001", "10001", "01110" },
	V = { "10001", "10001", "10001", "10001", "10001", "01010", "00100" },
	W = { "10001", "10001", "10001", "10101", "10101", "11011", "10001" },
	X = { "10001", "10001", "01010", "00100", "01010", "10001", "10001" },
	Y = { "10001", "10001", "01010", "00100", "00100", "00100", "00100" },
	Z = { "11111", "00001", "00010", "00100", "01000", "10000", "11111" },
}

-- Width in studs of `text` set in the pixel font with the given cell size.
function Kit.pixelWidth(text: string, cell: number): number
	local cols = 0
	for i = 1, #text do
		local ch = string.sub(text, i, i)
		cols += if ch == " " then 4 else 6
	end
	return math.max(0, cols - 1) * cell
end

-- Blocky letters centred on `cf` (text faces +Z of cf, reads along +X, cf.Position is the
-- centre of the text block). One Part per horizontal run, so "START" is about 25 parts.
function Kit.pixelText(parent: Instance, text: string, cf: CFrame, cell: number, color: Color3, depth: number?, mat: Enum.Material?): Model
	local m = Kit.model(parent, "PixelText_" .. string.gsub(text, " ", "_"))
	local w = Kit.pixelWidth(text, cell)
	local d = depth or cell
	local x0 = -w / 2
	local col = 0
	for i = 1, #text do
		local ch = string.sub(text, i, i)
		local rows = FONT[ch]
		if rows then
			for r, bits in rows do
				local c = 1
				while c <= 5 do
					if string.sub(bits, c, c) == "1" then
						local e = c
						while e < 5 and string.sub(bits, e + 1, e + 1) == "1" do
							e += 1
						end
						local runW = (e - c + 1) * cell
						local cx = x0 + (col + c - 1) * cell + runW / 2
						local cy = (3.5 - (r - 1) - 0.5) * cell
						local p = Kit.part(m, "L", Vector3.new(runW, cell, d), cf * CFrame.new(cx, cy, d / 2), color, mat)
						p.CanQuery = false
						p.CanTouch = false
						p.CanCollide = false
						c = e + 1
					else
						c += 1
					end
				end
			end
			col += 6
		else
			col += 4
		end
	end
	return m
end

-- Props ---------------------------------------------------------------------------------------

function Kit.crate(parent: Instance, cf: CFrame, s: number, variant: number?): Model
	local m = Kit.model(parent, "CT_Rocks_Crate")
	Kit.part(m, "Box", Vector3.one * s, cf * CFrame.new(0, s / 2, 0), Kit.Wood, M.WoodPlanks)
	if (variant or 1) == 1 then
		Kit.deco(Kit.part(m, "Band", Vector3.new(s * 1.03, s * 0.14, s * 1.03), cf * CFrame.new(0, s * 0.5, 0), Kit.Char, M.Metal))
	else
		Kit.deco(Kit.part(m, "BandA", Vector3.new(s * 0.14, s * 1.03, s * 1.03), cf * CFrame.new(-s * 0.3, s * 0.5, 0), Kit.Slate, M.Metal))
		Kit.deco(Kit.part(m, "BandB", Vector3.new(s * 0.14, s * 1.03, s * 1.03), cf * CFrame.new(s * 0.3, s * 0.5, 0), Kit.Slate, M.Metal))
	end
	return m
end

function Kit.planter(parent: Instance, cf: CFrame, length: number): Model
	local m = Kit.model(parent, "CT_Rocks_Planter")
	Kit.part(m, "Box", Vector3.new(length, 1.5, 1.8), cf * CFrame.new(0, 0.75, 0), Kit.Stone, M.Concrete)
	Kit.deco(Kit.part(m, "Base", Vector3.new(length + 0.2, 0.4, 2.0), cf * CFrame.new(0, 0.2, 0), Kit.Slate, M.Slate))
	Kit.deco(Kit.part(m, "Rim", Vector3.new(length + 0.2, 0.25, 2.0), cf * CFrame.new(0, 1.5, 0), Kit.Conc, M.Concrete))
	Kit.deco(Kit.part(m, "Soil", Vector3.new(length - 0.4, 0.2, 1.4), cf * CFrame.new(0, 1.55, 0), Kit.Soil, M.Ground))
	local n = math.max(2, math.floor(length / 1.6))
	for i = 1, n do
		local x = -length / 2 + (i - 0.5) * length / n
		local s = 1.2 + ((i * 7) % 3) * 0.25
		Kit.deco(Kit.part(m, "Shrub", Vector3.one * s, cf * CFrame.new(x, 1.65 + s * 0.4, 0) * CFrame.Angles(0.2 * i, i, 0), Kit.Shrub:Lerp(Kit.Mint, (i % 3) * 0.12), M.Grass, Enum.PartType.Ball))
	end
	return m
end

function Kit.bench(parent: Instance, cf: CFrame): Model
	local m = Kit.model(parent, "CT_Rocks_Bench")
	Kit.part(m, "Seat", Vector3.new(5, 0.4, 1.5), cf * CFrame.new(0, 1.5, 0), Kit.Wood, M.WoodPlanks)
	Kit.deco(Kit.part(m, "Back", Vector3.new(5, 1.2, 0.3), cf * CFrame.new(0, 2.4, -0.7) * CFrame.Angles(math.rad(-8), 0, 0), Kit.Wood, M.WoodPlanks))
	for _, x in { -2.1, 2.1 } do
		Kit.deco(Kit.part(m, "Leg", Vector3.new(0.4, 1.5, 1.3), cf * CFrame.new(x, 0.75, 0), Kit.Char, M.Metal))
	end
	return m
end

function Kit.lampPost(parent: Instance, pos: Vector3, withLight: boolean): Model
	local m = Kit.model(parent, "CT_Rocks_LampPost")
	Kit.part(m, "Foot", Vector3.new(1.4, 0.8, 1.4), CFrame.new(pos + Vector3.new(0, 0.4, 0)), Kit.Slate, M.Concrete)
	Kit.part(m, "Pole", Vector3.new(0.4, 8.4, 0.4), CFrame.new(pos + Vector3.new(0, 4.6, 0)), Kit.Char, M.Metal)
	Kit.part(m, "Arm", Vector3.new(1.6, 0.3, 0.3), CFrame.new(pos + Vector3.new(0.6, 8.7, 0)), Kit.Char, M.Metal)
	local head = Kit.deco(Kit.part(m, "Head", Vector3.new(1.3, 0.7, 1.3), CFrame.new(pos + Vector3.new(1.2, 8.4, 0)), Kit.Amber, M.SmoothPlastic))
	if withLight then
		Kit.light(head, "PointLight", Color3.fromRGB(255, 226, 170), 0.8, 22)
	end
	return m
end

function Kit.tree(parent: Instance, pos: Vector3, rng: Random, scale: number?): Model
	local k = scale or 1
	local m = Kit.model(parent, "CT_Rocks_Tree")
	local h = rng:NextNumber(6, 9) * k
	Kit.part(m, "Trunk", Vector3.new(1.3 * k, h, 1.3 * k), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Kit.Wood:Lerp(Kit.Char, 0.25), M.Wood)
	for i = 1, 3 do
		local s = (rng:NextNumber(5, 7.5) - i * 0.7) * k
		Kit.deco(Kit.part(m, "Leaves", Vector3.one * s, CFrame.new(pos + Vector3.new(rng:NextNumber(-0.6, 0.6), h + i * 1.5 - 1.2, rng:NextNumber(-0.6, 0.6))) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), 0), Color3.fromRGB(86, 140, 84):Lerp(Color3.fromRGB(66, 112, 76), rng:NextNumber(0, 0.7)), M.Grass))
	end
	return m
end

function Kit.boulder(parent: Instance, cf: CFrame, size: number, rng: Random): Model
	local m = Kit.model(parent, "CT_Rocks_Boulder")
	for i = 1, 3 do
		local s = size * (1 - i * 0.18)
		Kit.part(m, "Chunk", Vector3.new(s, s * 0.75, s * 0.9), cf * CFrame.new(rng:NextNumber(-0.25, 0.25) * size, s * 0.3, rng:NextNumber(-0.25, 0.25) * size) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6.28), rng:NextNumber(-0.4, 0.4)), Kit.Slate:Lerp(Kit.Conc, rng:NextNumber(0.1, 0.45)), M.Slate)
	end
	return m
end

-- A cliff band: broad slate faces with warm sandstone layers. `cf` faces +Z toward the play area.
function Kit.cliff(parent: Instance, cf: CFrame, length: number, height: number, rng: Random): Model
	local m = Kit.model(parent, "CT_Rocks_Cliff")
	local x = -length / 2
	while x < length / 2 do
		local w = rng:NextNumber(8, 13)
		local h = height * rng:NextNumber(0.75, 1.1)
		Kit.part(m, "Face", Vector3.new(w, h, rng:NextNumber(8, 12)), cf * CFrame.new(x + w / 2, h / 2 - 1, rng:NextNumber(-1.5, 1.5)) * CFrame.Angles(rng:NextNumber(-0.06, 0.06), rng:NextNumber(-0.22, 0.22), rng:NextNumber(-0.04, 0.04)), Kit.Slate:Lerp(Kit.Conc, rng:NextNumber(0.15, 0.5)), M.Slate)
		Kit.deco(Kit.part(m, "Layer", Vector3.new(w * 0.98, 1.2, 0.6), cf * CFrame.new(x + w / 2, h * 0.45, 5.6), Color3.fromRGB(196, 170, 130), M.Sandstone))
		x += w * 0.8
	end
	return m
end

-- Stone-and-steel kit (owner reference sheets 01-04) -------------------------------------------

Kit.Stone = Color3.fromRGB(206, 196, 174) -- warm cut stone for pillars, planters, steps

-- Stone pillar with dark steel bands; cf is the centre of the base on the ground.
function Kit.pillar(parent: Instance, cf: CFrame, h: number, w: number): Model
	local m = Kit.model(parent, "CT_Rocks_Pillar")
	Kit.part(m, "Base", Vector3.new(w * 1.25, 0.9, w * 1.25), cf * CFrame.new(0, 0.45, 0), Kit.Slate, M.Slate)
	Kit.part(m, "Shaft", Vector3.new(w, h - 1.8, w), cf * CFrame.new(0, 0.9 + (h - 1.8) / 2, 0), Kit.Stone, M.Concrete)
	Kit.deco(Kit.part(m, "BandLow", Vector3.new(w * 1.12, 0.5, w * 1.12), cf * CFrame.new(0, 1.7, 0), Kit.Char, M.Metal))
	Kit.deco(Kit.part(m, "BandHigh", Vector3.new(w * 1.12, 0.5, w * 1.12), cf * CFrame.new(0, h - 1.5, 0), Kit.Char, M.Metal))
	Kit.part(m, "Cap", Vector3.new(w * 1.3, 0.9, w * 1.3), cf * CFrame.new(0, h - 0.45, 0), Kit.Char, M.Metal)
	for _, sx in { -1, 1 } do
		Kit.deco(Kit.part(m, "Bolt", Vector3.new(0.22, 0.22, 0.12), cf * CFrame.new(sx * w * 0.35, h - 1.5, w * 0.57), Kit.Slate, M.Metal))
	end
	return m
end

-- Glowing lantern box (amber core in a dark frame). cf is the centre.
function Kit.lantern(parent: Instance, cf: CFrame, scale: number?, withLight: boolean?): Model
	local k = scale or 1
	local m = Kit.model(parent, "CT_Rocks_Lantern")
	Kit.deco(Kit.part(m, "Core", Vector3.new(0.7, 1.1, 0.7) * k, cf, Kit.Amber, M.Neon))
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.deco(Kit.part(m, "Post", Vector3.new(0.14, 1.3, 0.14) * k, cf * CFrame.new(sx * 0.4 * k, 0, sz * 0.4 * k), Kit.Char, M.Metal))
		end
	end
	Kit.deco(Kit.part(m, "Cap", Vector3.new(1.1, 0.2, 1.1) * k, cf * CFrame.new(0, 0.7 * k, 0), Kit.Char, M.Metal))
	Kit.deco(Kit.part(m, "Foot", Vector3.new(1.0, 0.16, 1.0) * k, cf * CFrame.new(0, -0.68 * k, 0), Kit.Char, M.Metal))
	if withLight then
		local core = m:FindFirstChild("Core") :: BasePart
		Kit.light(core, "PointLight", Color3.fromRGB(255, 214, 150), 0.8, 18)
	end
	return m
end

-- Bracketed wall lantern; cf origin is on the wall surface, +Z is out of the wall.
function Kit.wallLamp(parent: Instance, cf: CFrame, withLight: boolean?): Model
	local m = Kit.model(parent, "CT_Rocks_WallLamp")
	Kit.deco(Kit.part(m, "Plate", Vector3.new(0.9, 1.6, 0.25), cf * CFrame.new(0, 0, 0.12), Kit.Char, M.Metal))
	Kit.deco(Kit.part(m, "Arm", Vector3.new(0.25, 0.25, 1.0), cf * CFrame.new(0, 0.5, 0.7), Kit.Char, M.Metal))
	Kit.lantern(m, cf * CFrame.new(0, -0.1, 1.1), 0.8, withLight)
	return m
end

-- Standing lamp: stone foot, dark frame, glowing core (reference 12). cf is the ground centre.
function Kit.standingLamp(parent: Instance, pos: Vector3, withLight: boolean?): Model
	local m = Kit.model(parent, "CT_Rocks_StandingLamp")
	Kit.part(m, "Foot", Vector3.new(1.7, 1.3, 1.7), CFrame.new(pos + Vector3.new(0, 0.65, 0)), Kit.Stone, M.Concrete)
	Kit.part(m, "FootBand", Vector3.new(1.85, 0.3, 1.85), CFrame.new(pos + Vector3.new(0, 1.45, 0)), Kit.Char, M.Metal)
	local core = Kit.deco(Kit.part(m, "Core", Vector3.new(0.9, 2.8, 0.9), CFrame.new(pos + Vector3.new(0, 3.2, 0)), Kit.Amber, M.Neon))
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Kit.part(m, "Post", Vector3.new(0.3, 3.0, 0.3), CFrame.new(pos + Vector3.new(sx * 0.6, 3.2, sz * 0.6)), Kit.Char, M.Metal)
		end
	end
	Kit.part(m, "Cap", Vector3.new(1.9, 0.5, 1.9), CFrame.new(pos + Vector3.new(0, 4.85, 0)), Kit.Char, M.Metal)
	if withLight then
		Kit.light(core, "PointLight", Color3.fromRGB(255, 214, 150), 0.8, 24)
	end
	return m
end

-- Short kiosk bollard with a glowing slot (reference 15).
function Kit.bollard(parent: Instance, pos: Vector3): Model
	local m = Kit.model(parent, "CT_Rocks_Bollard")
	Kit.part(m, "Body", Vector3.new(1.5, 2.6, 1.5), CFrame.new(pos + Vector3.new(0, 1.3, 0)), Kit.Slate, M.Slate)
	Kit.deco(Kit.part(m, "Slot", Vector3.new(0.5, 1.5, 0.12), CFrame.new(pos + Vector3.new(0, 1.4, 0.78)), Kit.Amber, M.Neon))
	Kit.part(m, "Top", Vector3.new(1.8, 0.4, 1.8), CFrame.new(pos + Vector3.new(0, 2.8, 0)), Kit.Char, M.Metal)
	return m
end

-- Dark rail fence with glowing post slots (reference 8). cf: centre on the ground, runs along X.
function Kit.fence(parent: Instance, cf: CFrame, length: number): Model
	local m = Kit.model(parent, "CT_Rocks_Fence")
	local n = math.max(1, math.floor(length / 6))
	for i = 0, n do
		local x = -length / 2 + i * length / n
		Kit.part(m, "Post", Vector3.new(1.0, 3.6, 1.0), cf * CFrame.new(x, 1.8, 0), Kit.Char, M.Metal)
		Kit.deco(Kit.part(m, "Slot", Vector3.new(0.3, 1.5, 0.1), cf * CFrame.new(x, 2.0, 0.54), Kit.Amber, M.Neon))
		Kit.deco(Kit.part(m, "PostCap", Vector3.new(1.2, 0.3, 1.2), cf * CFrame.new(x, 3.7, 0), Kit.Slate, M.Metal))
	end
	for _, y in { 1.2, 2.0, 2.8 } do
		Kit.deco(Kit.part(m, "Rail", Vector3.new(length, 0.3, 0.4), cf * CFrame.new(0, y, 0), Kit.Slate, M.Metal))
	end
	Kit.deco(Kit.part(m, "Curb", Vector3.new(length, 0.5, 1.4), cf * CFrame.new(0, 0.25, 0), Kit.Stone, M.Concrete))
	return m
end

-- Octagon-style stone emblem with an amber crystal cluster. Decoration only, never a collectible.
-- cf: centre of the emblem, +Z toward the viewer.
function Kit.emblem(parent: Instance, cf: CFrame, d: number): Model
	local m = Kit.model(parent, "CT_Rocks_Emblem")
	Kit.deco(Kit.discZ(m, "Rock", d, d * 0.12, cf, Kit.Slate, M.Slate))
	Kit.deco(Kit.discZ(m, "Rim", d * 0.86, d * 0.14, cf * CFrame.new(0, 0, d * 0.01), Kit.Stone, M.Slate))
	Kit.deco(Kit.discZ(m, "Inner", d * 0.66, d * 0.16, cf * CFrame.new(0, 0, d * 0.02), Kit.Char, M.SmoothPlastic))
	for i, a in { -30, 0, 30 } do
		local len = (if i == 2 then 0.5 else 0.38) * d
		Kit.deco(Kit.part(m, "Crystal", Vector3.new(0.17 * d, len, 0.1 * d), cf * CFrame.new(0, -0.2 * d, d * 0.1) * CFrame.Angles(0, 0, math.rad(-a)) * CFrame.new(0, len / 2, 0), Kit.Amber, M.SmoothPlastic))
		Kit.deco(Kit.part(m, "CrystalTip", Vector3.new(0.17 * d, 0.14 * d, 0.1 * d), cf * CFrame.new(0, -0.2 * d, d * 0.1) * CFrame.Angles(0, 0, math.rad(-a)) * CFrame.new(0, len + 0.04 * d, 0) * CFrame.Angles(0, 0, math.rad(45)), Color3.fromRGB(255, 220, 120), M.SmoothPlastic))
	end
	return m
end

-- Crossed hammers emblem (workshop identity), +Z toward the viewer.
function Kit.hammerEmblem(parent: Instance, cf: CFrame, d: number): Model
	local m = Kit.model(parent, "CT_Rocks_HammerEmblem")
	Kit.deco(Kit.part(m, "Plate", Vector3.new(d, d * 0.8, d * 0.1), cf, Kit.Char, M.SmoothPlastic))
	for _, a in { 38, -38 } do
		local r = cf * CFrame.new(0, 0, d * 0.08) * CFrame.Angles(0, 0, math.rad(a))
		Kit.deco(Kit.part(m, "Handle", Vector3.new(0.08 * d, 0.7 * d, 0.07 * d), r, Kit.Wood, M.Wood))
		Kit.deco(Kit.part(m, "Head", Vector3.new(0.36 * d, 0.16 * d, 0.1 * d), r * CFrame.new(0, 0.3 * d, 0), Kit.Amber, M.Metal))
	end
	return m
end

-- Glowing chevron path inset pointing toward -Z (reference 14). cf: centre on the paving surface.
function Kit.chevron(parent: Instance, cf: CFrame, size: number): Model
	local m = Kit.model(parent, "CT_Rocks_PathArrow")
	Kit.deco(Kit.part(m, "Border", Vector3.new(size, 0.07, size), cf * CFrame.new(0, 0.035, 0), Kit.Stone, M.Concrete))
	Kit.deco(Kit.part(m, "Inset", Vector3.new(size * 0.8, 0.09, size * 0.8), cf * CFrame.new(0, 0.045, 0), Kit.Char, M.Concrete))
	for _, s in { -1, 1 } do
		Kit.deco(Kit.part(m, "Bar", Vector3.new(size * 0.12, 0.05, size * 0.46), cf * CFrame.new(s * size * 0.15, 0.1, size * 0.02) * CFrame.Angles(0, math.rad(s * 45), 0), Kit.Amber, M.Neon))
	end
	return m
end

-- Entrance arch: two stone pillars with lanterns and a stepped dark header carrying an emblem.
-- cf: centre on the ground, +Z toward the viewer; `span` is the clear width between the pillars.
function Kit.arch(parent: Instance, cf: CFrame, span: number, h: number): Model
	local m = Kit.model(parent, "CT_Rocks_EntranceArch")
	for _, s in { -1, 1 } do
		local pc = cf * CFrame.new(s * (span / 2 + 1), 0, 0)
		Kit.pillar(m, pc, h, 2.0)
		Kit.deco(Kit.part(m, "Slot", Vector3.new(0.5, 4.2, 0.14), pc * CFrame.new(0, h * 0.5, 1.12), Kit.Amber, M.Neon))
	end
	local w = span + 4
	Kit.deco(Kit.part(m, "HeaderLow", Vector3.new(w, 1.4, 2.0), cf * CFrame.new(0, h + 0.5, 0), Kit.Char, M.Metal))
	Kit.deco(Kit.part(m, "HeaderMid", Vector3.new(w * 0.7, 1.2, 1.9), cf * CFrame.new(0, h + 1.7, 0), Kit.Slate, M.Metal))
	Kit.deco(Kit.part(m, "HeaderTop", Vector3.new(w * 0.4, 1.0, 1.8), cf * CFrame.new(0, h + 2.8, 0), Kit.Char, M.Metal))
	Kit.emblem(m, cf * CFrame.new(0, h + 1.9, 1.05), 3.2)
	return m
end

return Kit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="227">
        <Properties>
          <string name="Name">KitPlace</string>
          <string name="Source"><![CDATA[--!strict
-- Placement helpers for the Blender kit models (ReplicatedStorage.Assets.Kit, see shared/KitModels and
-- docs/MODELING.md) used by LobbyBuilder, ArenaBuilder and GalleryService. Every function returns nil
-- (or does nothing) when the kit model is missing, so the caller keeps building its Part stand-in.
--
-- Kit frame: +Y up, the FRONT of a model faces -Z. To make a model face world direction d (a unit
-- vector on the ground plane) use `KitPlace.facing(pos, d)`.
-- Kit meshes are non-colliding (MeshService strips collision); structures that players can bump into get
-- invisible blockers from `blocker`.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KitModels = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("KitModels"))
local SignLayout = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SignLayout"))

local KitPlace = {}

-- Owner-made mesh props (Studio: ServerStorage.MeshyAssets). meshy(name, cf, size) clones one, scales it uniformly so it
-- fits inside `size` (studs), centres it on `cf` and returns it unparented; nil when the asset is missing.
function KitPlace.meshy(name: string, cf: CFrame, size: Vector3): Model?
	local folder = game:GetService("ServerStorage"):FindFirstChild("MeshyAssets")
	local src = folder and folder:FindFirstChild(name)
	if not (src and src:IsA("Model")) then
		return nil
	end
	local m = src:Clone()
	local ext = m:GetExtentsSize()
	local k = math.min(size.X / math.max(ext.X, 0.01), size.Y / math.max(ext.Y, 0.01), size.Z / math.max(ext.Z, 0.01))
	if k > 0 and k ~= 1 then
		m:ScaleTo(m:GetScale() * k)
	end
	local box = m:GetBoundingBox()
	m:PivotTo(cf * box:ToObjectSpace(m:GetPivot()))
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	return m
end

-- True when every named kit model is present.
function KitPlace.has(...: string): boolean
	for _, n in { ... } do
		if not KitModels.template(n) then
			return false
		end
	end
	return true
end

-- CFrame at `pos` whose kit front (-Z) points along `dir` (ground plane).
function KitPlace.facing(pos: Vector3, dir: Vector3): CFrame
	return CFrame.new(pos) * CFrame.Angles(0, math.atan2(-dir.X, -dir.Z), 0) -- yaw only; front (-Z) along dir
end

-- Clone a kit model, place it at `cf` (floor-centre frame, front -Z) and parent it. nil when absent.
function KitPlace.place(parent: Instance, name: string, cf: CFrame, scale: number?, modelName: string?): Model?
	local m = KitModels.clone(name, scale)
	if not m then
		return nil
	end
	m.Name = modelName or ("CT_Rocks_" .. name)
	m:PivotTo(cf)
	m.Parent = parent
	return m
end

-- World position of a named attachment of a placed model, or nil.
function KitPlace.attach(m: Model, point: string): Vector3?
	local root = m:FindFirstChild("Root")
	local a = root and root:FindFirstChild(point)
	if a and a:IsA("Attachment") then
		return (a :: Attachment).WorldPosition
	end
	return nil
end

-- Invisible solid box (collision for a kit structure). `cf` is the box centre.
function KitPlace.blocker(parent: Instance, cf: CFrame, size: Vector3, name: string?): Part
	local p = Instance.new("Part")
	p.Name = name or "Blocker"
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.Transparency = 1
	p.CanCollide = true
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

-- Writes a fitted label into `gui`'s TextLabel: explicit TextSize and PixelsPerStud from SignLayout.fit
-- (never TextScaled), so the text size is known and checkable. Returns the fit.
function KitPlace.applyFit(gui: SurfaceGui, label: TextLabel, text: string, boardW: number, boardH: number, preset: string): SignLayout.Fit
	local f = SignLayout.fit(text, boardW, boardH, preset)
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = f.PPS
	label.Text = f.Text
	label.TextScaled = false
	label.TextWrapped = false
	label.TextSize = f.TextSize
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	if label.Parent then
		label.Parent:SetAttribute("SignFill", f.Fill)
	end
	return f
end

-- Size in studs (W, H) of `part`'s `face`.
function KitPlace.faceSize(part: BasePart, face: Enum.NormalId): (number, number)
	local s = part.Size
	if face == Enum.NormalId.Left or face == Enum.NormalId.Right then
		return s.Z, s.Y
	elseif face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then
		return s.X, s.Z
	end
	return s.X, s.Y
end

-- Text on a sign or board the owner built in Studio (a TextLabel in a SurfaceGui on the board part). The owner's
-- labels used TextScaled or a small fixed TextSize, so long or multi-line text came out tiny on a phone. The code
-- owns the words' size and colour; the frame, face colour and layout stay the owner's:
--   * a label that is the only thing in its SurfaceGui gets the full sign fit (KitPlace.applyFit: explicit TextSize,
--     PixelsPerStud from it);
--   * a label inside the owner's own frames keeps the gui's pixel density (switching it would move offset-sized
--     frames) and only gets an explicit TextSize from the same fit, capped at 100 px.
-- Ink is white with the lodge black outline (KitPlace.outline): high contrast on any face colour. The SurfaceGui
-- ignores the hall lighting (LightInfluence 0), so a board in shade never reads as a black slab.
function KitPlace.fitMapLabel(label: TextLabel, text: string, preset: string): SignLayout.Fit?
	local gui = label:FindFirstAncestorWhichIsA("SurfaceGui")
	if not gui then
		label.Text = text
		return nil
	end
	local part = gui.Adornee or gui.Parent
	if not (part and part:IsA("BasePart")) then
		label.Text = text
		return nil
	end
	local W, H = KitPlace.faceSize(part, gui.Face)
	gui.LightInfluence = 0
	label.RichText = false
	local others = 0
	for _, d in gui:GetDescendants() do
		if d:IsA("GuiObject") and d ~= label then
			others += 1
		end
	end
	local f: SignLayout.Fit
	if others == 0 and label.Parent == gui then
		f = KitPlace.applyFit(gui, label, text, W, H, preset)
	else
		-- the label's share of the face: its scale size times the scale sizes of the frames it sits in
		local sx, sy = 1, 1
		local node: Instance? = label
		while node and node ~= gui do
			if node:IsA("GuiObject") then
				sx *= if node.Size.X.Scale > 0.05 then node.Size.X.Scale else 1
				sy *= if node.Size.Y.Scale > 0.05 then node.Size.Y.Scale else 1
			end
			node = node.Parent
		end
		f = SignLayout.fit(text, W * sx, H * sy, preset)
		local pps = if gui.SizingMode == Enum.SurfaceGuiSizingMode.PixelsPerStud
			then gui.PixelsPerStud
			else math.min(gui.CanvasSize.X / math.max(W, 0.01), gui.CanvasSize.Y / math.max(H, 0.01))
		label.Text = f.Text
		label.TextScaled = false
		label.TextWrapped = false
		label.TextSize = math.clamp(math.floor(f.Em * pps), 8, 100)
	end
	KitPlace.outline(label)
	return f
end

export type SignOpts ={ Face: Color3?, Ink: Color3?, Trim: Color3?, Depth: number?, Frame: Color3?, Outline: boolean? }

-- Framed timber sign. `cf` = centre of the sign front, +Z pointing at the viewer (the Kit.* frame).
-- W x H studs is the readable FACE; the frame, bolts and trim are built around it so the board and the
-- text are one object (no separate plate that can drift from the board). opts: Face colour, Ink colour,
-- Trim colour, Depth. Returns the face part, its label and the fit. Attributes on the face (SignText,
-- SignPreset, SignW, SignH) let tools/preview/scenes/signs.luau audit every sign numerically.
function KitPlace.signBoard(parent: Instance, name: string, cf: CFrame, W: number, H: number, text: string, preset: string, opts: SignOpts?): (Part, TextLabel, SignLayout.Fit)
	local o: SignOpts = opts or ({} :: SignOpts)
	local depth = o.Depth or 0.35
	local faceCol = o.Face or Color3.fromRGB(104, 72, 46)
	local frameCol = o.Frame or Color3.fromRGB(70, 50, 34)
	local trim = o.Trim or Color3.fromRGB(196, 152, 80)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	local function box(n: string, size: Vector3, off: CFrame, col: Color3, mat: Enum.Material): Part
		local p = Instance.new("Part")
		p.Name = n
		p.Size = size
		p.CFrame = cf * off
		p.Anchored = true
		p.Color = col
		p.Material = mat
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p:SetAttribute("CameraIgnore", true)
		p.Parent = m
		return p
	end
	local bw = math.min(0.32, H * 0.2)
	-- the owner's MeshySign as the frame behind the face when it exists; otherwise the timber frame below
	local meshFrame = KitPlace.meshy("MeshySign", cf * CFrame.new(0, 0, -depth * 0.3), Vector3.new(W + bw * 2, H + bw * 2, depth))
	if meshFrame then
		meshFrame.Name = "Frame"
		for _, d in meshFrame:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d:SetAttribute("CameraIgnore", true)
			end
		end
		meshFrame.Parent = m
	end
	-- frame: four timber rails around the face, a backing board behind
	if not meshFrame then
	box("Back", Vector3.new(W + bw * 2, H + bw * 2, depth * 0.6), CFrame.new(0, 0, -depth * 0.3), frameCol, Enum.Material.WoodPlanks)
	box("RailTop", Vector3.new(W + bw * 2, bw, depth), CFrame.new(0, H / 2 + bw / 2, 0), frameCol, Enum.Material.Wood)
	box("RailBottom", Vector3.new(W + bw * 2, bw, depth), CFrame.new(0, -H / 2 - bw / 2, 0), frameCol, Enum.Material.Wood)
	box("RailL", Vector3.new(bw, H, depth), CFrame.new(-W / 2 - bw / 2, 0, 0), frameCol, Enum.Material.Wood)
	box("RailR", Vector3.new(bw, H, depth), CFrame.new(W / 2 + bw / 2, 0, 0), frameCol, Enum.Material.Wood)
	end
	local face = box("Face", Vector3.new(W, H, 0.1), CFrame.new(0, 0, depth / 2 - 0.12), faceCol, Enum.Material.WoodPlanks)
	-- thin muted-gold inset line just inside the frame, four corner bolts
	local inset = math.min(0.1, H * 0.06)
	box("TrimTop", Vector3.new(W - inset * 2, inset * 0.6, 0.04), CFrame.new(0, H / 2 - inset * 1.2, depth / 2 - 0.06), trim, Enum.Material.SmoothPlastic)
	box("TrimBottom", Vector3.new(W - inset * 2, inset * 0.6, 0.04), CFrame.new(0, -H / 2 + inset * 1.2, depth / 2 - 0.06), trim, Enum.Material.SmoothPlastic)
	for _, sx in { -1, 1 } do
		for _, sy in { -1, 1 } do
			local b = box("Bolt", Vector3.new(0.2, 0.2, 0.1), CFrame.new(sx * (W / 2 + bw / 2), sy * (H / 2 + bw / 2), depth / 2 + 0.02), Color3.fromRGB(44, 46, 52), Enum.Material.Metal)
			b.Shape = Enum.PartType.Ball
		end
	end
	local g = Instance.new("SurfaceGui")
	g.Name = "Label"
	g.Face = Enum.NormalId.Back
	g.LightInfluence = 0.15
	g.Parent = face
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.BackgroundTransparency = 1
	t.TextColor3 = o.Ink or Color3.fromRGB(246, 238, 220)
	t.Font = Enum.Font.FredokaOne
	t.TextStrokeTransparency = 1
	t.Parent = g
	local f = KitPlace.applyFit(g, t, text, W, H, preset)
	face:SetAttribute("SignText", f.Text)
	face:SetAttribute("SignPreset", preset)
	face:SetAttribute("SignW", W)
	face:SetAttribute("SignH", H)
	face:SetAttribute("SignFill", f.Fill)
	if o.Outline then
		KitPlace.outline(t) -- landmark lettering: white ink, black outline
	end
	return face, t, f
end

-- Lodge landmark lettering: white ink and a controlled black outline (SignLayout.Outline) on a fitted label. A
-- UIStroke in Contextual mode outlines the glyphs only; its thickness follows the label's TextSize. Marks the sign
-- part (attribute SignOutline = px) so the `signs` audit can check every lodge landmark has it.
function KitPlace.outline(label: TextLabel)
	local o = SignLayout.Outline
	local st = label:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	st.Color = o.Stroke
	st.Transparency = o.Transparency
	st.LineJoinMode = Enum.LineJoinMode.Round
	st.Thickness = SignLayout.outlinePx(label.TextSize)
	st.Parent = label
	label.TextColor3 = o.Ink
	label.TextStrokeTransparency = 1 -- the UIStroke is the outline (the legacy 1 px stroke would only blur it)
	local gui = label.Parent
	local part = gui and gui.Parent
	if part and part:IsA("BasePart") then
		part:SetAttribute("SignOutline", st.Thickness)
	end
end

-- Unframed fitted text laid on an existing surface (a counter front, a screen). `cf` = centre of the
-- surface, +Z toward the viewer. Same attributes as signBoard so the audit sees it. `outline` = the lodge
-- landmark look (white, black outline: KitPlace.outline).
function KitPlace.signText(parent: Instance, name: string, cf: CFrame, W: number, H: number, text: string, preset: string, ink: Color3?, backing: Color3?, outline: boolean?): (Part, TextLabel, SignLayout.Fit)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = Vector3.new(W, H, 0.06)
	p.CFrame = cf
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	if backing then
		p.Color = backing
	else
		p.Transparency = 1
	end
	p:SetAttribute("CameraIgnore", true)
	p.Parent = parent
	local g = Instance.new("SurfaceGui")
	g.Name = "Label"
	g.Face = Enum.NormalId.Back
	g.LightInfluence = 0
	g.Parent = p
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.BackgroundTransparency = 1
	t.TextColor3 = ink or Color3.fromRGB(246, 238, 220)
	t.Font = Enum.Font.FredokaOne
	t.Parent = g
	local f = KitPlace.applyFit(g, t, text, W, H, preset)
	p:SetAttribute("SignText", f.Text)
	p:SetAttribute("SignPreset", preset)
	p:SetAttribute("SignW", W)
	p:SetAttribute("SignH", H)
	if outline then
		KitPlace.outline(t)
	end
	return p, t, f
end

-- Marks every part under `inst` as purely decorative for the client camera (attribute CameraIgnore):
-- roofs, canopies, foliage, lamps and other pieces a camera can end up inside near a walk route.
-- Floors, walls and boundaries are NOT passed here (they stay collidable and occluding).
function KitPlace.cameraIgnore(inst: Instance?)
	if not inst then
		return
	end
	if inst:IsA("BasePart") then
		inst:SetAttribute("CameraIgnore", true)
	end
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			d:SetAttribute("CameraIgnore", true)
		end
	end
end

-- Repaints pieces of a placed kit model by piece name (the kit catalog colours are the Blender palette;
-- the lobby tones the lime foliage and the near-black pads down). `map` = { PieceName = Color3 }.
function KitPlace.tone(m: Model?, map: { [string]: Color3 })
	if not m then
		return
	end
	for _, d in m:GetDescendants() do
		local c = map[d.Name]
		if c and d:IsA("BasePart") then
			d.Color = c
		end
	end
end

-- Simple collision for a placed kit prop (kit meshes never collide): one invisible box over the model's
-- footprint in its own frame, shrunk 0.15 studs on each side and at most `maxH` tall (default 4: what an avatar
-- bumps into). Returns the blocker, or nil for a missing model. Audited by the `placement` scene (NOCOLLIDE).
function KitPlace.solidify(m: Model?, maxH: number?): Part?
	if not m then
		return nil
	end
	local cf, size = m:GetBoundingBox()
	local h = math.min(size.Y, maxH or 4)
	local bottom = cf.Position.Y - size.Y / 2
	local at = CFrame.new(cf.Position.X, bottom + h / 2, cf.Position.Z) * cf.Rotation
	return KitPlace.blocker(m, at, Vector3.new(math.max(0.4, size.X - 0.3), h, math.max(0.4, size.Z - 0.3)), "Solid")
end

-- Decor policy (Master 8 sections 5 and 23): every visible, non-colliding part under `root` that is not a
-- functional target (no ProximityPrompt / SurfaceGui on it, not a named contract part) is camera-ignored and
-- does not answer raycasts or touches, so trims, labels, shrubs and display pieces never push the camera in,
-- block the line-of-sight check or catch the interaction ray. Applied now and to parts added later (owner
-- cabinets rebuilt by SetCapacity, the record boards, specimens placed by the gallery). Audited by the
-- preview scene `placement` (tools/run_regressions.sh).
local FUNCTIONAL = {
	Body = true, Counter = true, Cabinet = true, Floor = true, Surface = true, Plate = true, Pad = true,
	PreviewAnchor = true, Nameplate = true, Sign = true, Light = true, Stand = true,
}
local function applyDecor(d: Instance)
	if d:IsA("BasePart") and not d.CanCollide and d.Transparency < 1 and not FUNCTIONAL[d.Name]
		and d:GetAttribute("HuntPortal") == nil and d:GetAttribute("TowerPortal") == nil -- portals keep CanTouch
		and not d:FindFirstChildWhichIsA("ProximityPrompt") and not d:FindFirstChildWhichIsA("SurfaceGui") then
		d.CanQuery = false
		d.CanTouch = false
		d:SetAttribute("CameraIgnore", true)
	end
end

function KitPlace.decorPolicy(root: Instance)
	for _, d in root:GetDescendants() do
		applyDecor(d)
	end
	root.DescendantAdded:Connect(function(d)
		-- builders set CanCollide / Transparency right after parenting: look once the frame settles
		task.defer(applyDecor, d)
	end)
end

-- Marks a decorative tree for the client's gentle sway (src/client/LobbyAmbience.luau). The canopy parts are the
-- ones named Leaf / LeafDark / Leaves; `pivot` is the world point they rock about (low on the trunk). Visual only:
-- the server never moves them and nothing else reads the attributes.
function KitPlace.sway(m: Instance?, pivot: Vector3)
	if m then
		m:SetAttribute("Sway", true)
		m:SetAttribute("SwayPivot", pivot)
	end
end

-- Shared rubble hopper from the prop kit (Prop_RubbleHopper): keeps the contract EconomyService and the
-- client rely on: Model attribute Hopper, a `Body` part carrying the ProximityPrompt `SellPrompt` with
-- attribute Sell. `cf` is the floor centre; the hopper's front (receipt, ramp) faces -Z of `cf`.
function KitPlace.hopper(parent: Instance, cf: CFrame, scale: number, panelAttr: boolean): Model?
	local m = KitPlace.place(parent, "Prop_RubbleHopper", cf, scale, "CT_Rocks_SellHopper")
	if not m then
		return nil
	end
	local s = scale
	local body = KitPlace.blocker(m, cf * CFrame.new(-0.5 * s, 2.4 * s, -0.4 * s), Vector3.new(7.2, 4.8, 5.6) * s, "Body")
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "SellPrompt"
	pp.ActionText = "Sell Candy"
	pp.ObjectText = "Hopper"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R -- E is the crack key on keyboards
	pp.UIOffset = Vector2.new(0, 30)
	if panelAttr then
		pp:SetAttribute("Panel", "")
	end
	pp:SetAttribute("Sell", true)
	pp.Parent = body
	m:SetAttribute("Hopper", true)
	-- one fitted SELL label on the slate plate of the front (kit frame: front is -Z, so face the plate toward it)
	KitPlace.signText(m, "SellLabel", cf * CFrame.new(-0.975 * s, 2.525 * s, -2.02 * s) * CFrame.Angles(0, math.pi, 0), 6.0 * s, 1.3 * s, "SELL CANDY", "Plaque", Color3.fromRGB(244, 190, 67))
	return m
end

return KitPlace
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="228">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--!strict
-- Global leaderboards on OrderedDataStores (shared/Boards.luau defines the four boards):
-- Multiplayer Wins, Biggest Geode (value), Collection Count and Solo Finds (kept apart on purpose).
--
-- Writes: noteChange(player) is called whenever a profile changes; it only records the new
-- numbers. A flush loop writes a value when it grew, at most once per board per player per
-- Config.Leaderboards.WriteMinSeconds, and only while the request budget leaves MinBudget in
-- reserve. UpdateAsync keeps the larger of the stored and the new value, so a rank is never
-- lowered, deleted or reset. Everything is pcall'd; a failed write is retried on the next flush.
--
-- Reads: the top Config.Leaderboards.Top rows of each board are re-read every RefreshSeconds into a
-- cache (status "loading" until the first read, "ok", "error" keeping the last good rows (production
-- retries on the next refresh), "unavailable" in a Studio test whose saves are off or whose DataStores
-- cannot be reached: the boards then show one calm "Records unavailable in this Studio test" note and
-- stop reading for the rest of that Studio session; no rows are invented and nothing is written). Names come from players in this server (display name), else
-- Players:GetNameFromUserIdAsync (cached; a failure shows "Player <id>" and is retried later).
-- Studio uses its own stores ("_Studio" suffix), like Profiles.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Boards = require(Shared.Boards)
local PlaceRole = require(Shared.PlaceRole)
local Profiles = require(script.Parent.Profiles)

local Leaderboards = {}

local L = Config.Leaderboards
local SUFFIX = if RunService:IsStudio() then "_Studio" else ""

export type Row = { Rank: number, UserId: number, Name: string, Value: number, Text: string }
export type State = { Status: string, Rows: { Row }, Updated: number }

local IS_STUDIO = RunService:IsStudio()
local available = true -- false once DataStores proved unreachable in Studio (saves off / no API access)
local stores: { [string]: OrderedDataStore } = {}
local pending: { [number]: { [string]: number } } = {} -- userId -> board -> value to write
local written: { [number]: { [string]: number } } = {} -- userId -> board -> last value written
local lastWrite: { [number]: { [string]: number } } = {} -- userId -> board -> os.clock()
local cache: { [string]: State } = {}
local names: { [number]: string } = {}
local nameFailed: { [number]: number } = {}
local listeners: { (string) -> () } = {}
local reading = false

for _, id in Boards.Order do
	cache[id] = { Status = "loading", Rows = {}, Updated = 0 }
end

local function storeFor(board: string): OrderedDataStore?
	local s = stores[board]
	if s then
		return s
	end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(L.StorePrefix .. board .. SUFFIX)
	end)
	if ok and result then
		stores[board] = result
		return result
	end
	return nil
end

local function budget(kind: Enum.DataStoreRequestType): number
	local ok, n = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(kind)
	end)
	return if ok and type(n) == "number" then n else 0
end

local function unreachable(err: string): boolean
	return RunService:IsStudio() and (string.find(err, "403") ~= nil or string.find(err, "API") ~= nil or string.find(err, "Studio") ~= nil)
end

-- Writes ---------------------------------------------------------------------------------

-- Records the player's current numbers (cheap; called on every profile change).
function Leaderboards.noteChange(player: Player)
	local data = Profiles.get(player)
	if not data or Profiles.isOffline(player) then
		return -- session-only profiles are never ranked
	end
	local vals = Boards.values(data)
	local uid = player.UserId
	for id, v in vals do
		local w = written[uid]
		if v > 0 and v > ((w and w[id]) or 0) then
			local p = pending[uid]
			if not p then
				p = {}
				pending[uid] = p
			end
			p[id] = v
		end
	end
end

local function writeOne(uid: number, board: string, value: number): boolean
	local store = storeFor(board)
	if not store then
		return false
	end
	local ok, err = pcall(function()
		store:UpdateAsync(tostring(uid), function(old: unknown): any -- nil keeps the stored value (the API type has no nil return)
			if type(old) == "number" and old >= value then
				return nil -- keep the stored (higher or equal) value
			end
			return value
		end)
	end)
	if not ok then
		if unreachable(tostring(err)) then
			available = false
		end
		return false
	end
	return true
end

-- One pass over the pending writes. force = ignore the per-board throttle (player leaving).
local function flush(force: boolean, only: number?)
	if not available then
		return
	end
	-- writes yield and noteChange adds entries meanwhile: walk snapshots, never the live tables
	local uids: { number } = {}
	for uid in pending do
		if not only or uid == only then
			table.insert(uids, uid)
		end
	end
	for _, uid in uids do
		local boardsMap = pending[uid]
		if not boardsMap then
			continue
		end
		for board, value in table.clone(boardsMap) do
			local w = written[uid]
			local lw = lastWrite[uid]
			local due = if force then value > ((w and w[board]) or 0) else Boards.writeDue(w and w[board], value, lw and lw[board], os.clock(), L.WriteMinSeconds)
			if not due then
				if value <= ((w and w[board]) or 0) and boardsMap[board] == value then
					boardsMap[board] = nil
				end
				continue
			end
			if budget(Enum.DataStoreRequestType.UpdateAsync) < L.MinBudget then
				return -- try again on the next flush
			end
			if writeOne(uid, board, value) then
				written[uid] = written[uid] or {}
				written[uid][board] = value
				lastWrite[uid] = lastWrite[uid] or {}
				lastWrite[uid][board] = os.clock()
				if boardsMap[board] == value then
					boardsMap[board] = nil
				end
			elseif not available then
				return
			end
		end
		if next(boardsMap) == nil and pending[uid] == boardsMap then
			pending[uid] = nil
		end
	end
end

-- Reads -----------------------------------------------------------------------------------

local function nameOf(uid: number): string
	local p = Players:GetPlayerByUserId(uid)
	if p then
		names[uid] = p.DisplayName
		return p.DisplayName
	end
	local n = names[uid]
	if n then
		return n
	end
	local failedAt = nameFailed[uid]
	if failedAt and os.clock() - failedAt < L.NameFailRetrySeconds then
		return "Player " .. uid
	end
	local ok, result = pcall(function()
		return Players:GetNameFromUserIdAsync(uid)
	end)
	if ok and type(result) == "string" and result ~= "" then
		names[uid] = result
		nameFailed[uid] = nil
		return result
	end
	nameFailed[uid] = os.clock()
	return "Player " .. uid
end

local function toRows(board: string, ranked: { Boards.Row }): { Row }
	local out: { Row } = {}
	for _, r in ranked do
		table.insert(out, { Rank = r.Rank, UserId = r.UserId, Name = nameOf(r.UserId), Value = r.Value, Text = Boards.format(board, r.Value) })
	end
	return out
end

local function fire(board: string)
	for _, fn in listeners do
		task.spawn(fn, board)
	end
end

-- A Studio test with saves off (any profile in this server is session-only): global records cannot be read
-- or written here, so the boards say so once instead of looking like a failing retry.
local function studioSavesOff(): boolean
	if not IS_STUDIO then
		return false
	end
	for _, p in Players:GetPlayers() do
		if Profiles.isOffline(p) then
			return true
		end
	end
	return false
end

-- Marks the board "unavailable" (Studio only) and tells the listeners once.
local function setUnavailable(c: State, board: string)
	available = false
	local changed = c.Status ~= "unavailable" or #c.Rows > 0
	c.Status = "unavailable"
	c.Rows = {}
	c.Updated = os.clock()
	if changed then
		fire(board)
	end
end

local function refreshBoard(board: string)
	local c = cache[board]
	if not available or studioSavesOff() then
		setUnavailable(c, board)
		return
	end
	local store = storeFor(board)
	if not store then
		if IS_STUDIO then
			setUnavailable(c, board) -- e.g. an unpublished place: DataStores cannot be opened in this test
			return
		end
		c.Status = "error"
		fire(board)
		return
	end
	if budget(Enum.DataStoreRequestType.GetSortedAsync) < 1 then
		return -- keep what we have; the next refresh tries again
	end
	local raw: { any } = {}
	local ok, err = pcall(function()
		local pages = store:GetSortedAsync(false, L.Top)
		for _, entry in pages:GetCurrentPage() do
			table.insert(raw, { key = entry.key, value = entry.value })
		end
	end)
	if ok then
		c.Rows = toRows(board, Boards.rank(raw, L.Top))
		c.Status = "ok"
		c.Updated = os.clock()
	elseif IS_STUDIO then -- any failed read in a Studio test: records are not available here (never retried in a loop)
		setUnavailable(c, board)
		return
	else
		c.Status = "error" -- the last good rows stay
		warn("[Leaderboards] read failed for", board, err)
	end
	fire(board)
end

function Leaderboards.refreshAll()
	if reading then
		return
	end
	reading = true
	for _, id in Boards.Order do
		local ok: boolean, err: any = pcall(refreshBoard, id)
		if not ok then
			warn("[Leaderboards] refresh failed for", id, err)
		end
	end
	reading = false
end

-- Latest cached state of a board (a copy-safe read-only table).
function Leaderboards.get(board: string): State
	return cache[board] or { Status = "error", Rows = {}, Updated = 0 }
end

function Leaderboards.onUpdated(fn: (string) -> ())
	table.insert(listeners, fn)
end

function Leaderboards.start()
	Profiles.onChanged(Leaderboards.noteChange)
	Players.PlayerRemoving:Connect(function(player)
		-- best-effort final write for what the player earned this visit
		Leaderboards.noteChange(player)
		task.spawn(flush, true, player.UserId)
		task.delay(L.FlushSeconds * 4, function()
			-- forget per-player bookkeeping once the last write had its chance
			if Players:GetPlayerByUserId(player.UserId) == nil then
				pending[player.UserId] = nil
				written[player.UserId] = nil
				lastWrite[player.UserId] = nil
			end
		end)
	end)
	-- Server shutdown: write what everyone still here earned; BindToClose (Profiles) waits for it within its budget.
	Profiles.onShutdown(function()
		for _, p in Players:GetPlayers() do
			Leaderboards.noteChange(p)
		end
		flush(true)
	end)
	-- the Match place has no boards: it only records changes and flushes writes
	local isMatch = PlaceRole.resolve(Config.Places.Mode, game.PlaceId, Config.Places.LobbyPlaceId, Config.Places.MatchPlaceId) == "Match"
	if not isMatch then
		task.delay(1, function()
			pcall(Leaderboards.refreshAll)
		end)
	end
	task.spawn(function()
		local sinceRead = 0
		while true do
			task.wait(L.FlushSeconds)
			pcall(flush, false)
			sinceRead += L.FlushSeconds
			if sinceRead >= L.RefreshSeconds and not isMatch then
				sinceRead = 0
				pcall(Leaderboards.refreshAll)
			end
		end
	end)
end

return Leaderboards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="229">
        <Properties>
          <string name="Name">LobbyBloom</string>
          <string name="Source"><![CDATA[--!strict
-- Flowers and sparkles along the lobby paths (idea 33, owner pick 2026-10-15). Lobby only, built once at boot.
-- Small chunky low-poly flower clusters (stem + flat petal disc + round centre, bright cartoon colours) stand on the
-- grass beside every path segment (parts inside a folder or model named "Paths", the lobby build's path layer).
-- Every spot is checked before a cluster goes there: a ray must land on grass (Grass / LeafyGrass, or a green part)
-- and the cluster's box (plus a 1 stud margin) must touch no other part. The lobby build sets CanQuery = false on its
-- paths and decor, so raycasts and overlap queries cannot see them: every part of the map is read once into a flat
-- grid (shared/PathGrid) and the box is checked against that, plus a GetPartBoundsInBox for queryable parts.
-- Every third cluster twinkles (tagged PetSparkle: Low Effects turns the twinkles off).
-- Lighting and colours of the map are the polish thread's; this only adds the props.

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local PathGrid = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").PathGrid)

local LobbyBloom = {}

local SPACING = 12 -- studs between samples along a path side
local GRID = 10 -- no two clusters closer than this
local MAX = 140
-- a clump's real spread: flowers up to 1.8 studs from its centre with 1 stud petal discs (2x size, runner 2026-10-15)
local BOX = Vector3.new(6, 4.8, 6)
local MARGIN = 0.3 -- studs of clear grass between a clump and a walkway
local SOLID_MARGIN = 0.6 -- and between a clump and a prop (bench, lamp, fence)
local CLEAR = BOX.X / 2 + 0.9 -- first try: the clump's edge just outside the edge stones (0.85 past the strip side)
local LIFT = 0.5 -- a part blocks only when its top is more than this above the ground under the cluster
local PETALS = {
	Color3.fromRGB(255, 120, 170), -- pink
	Color3.fromRGB(255, 220, 70), -- yellow
	Color3.fromRGB(255, 255, 255), -- white
	Color3.fromRGB(190, 130, 255), -- purple
	Color3.fromRGB(255, 110, 90), -- coral red
	Color3.fromRGB(120, 200, 255), -- sky blue
}
local STEM = Color3.fromRGB(80, 170, 70)
local CENTRE = Color3.fromRGB(255, 200, 60)

local function prop(parent: Instance, shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3): Part
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- One flower: stem, a flat petal disc and a round centre, `h` studs tall, standing on `base` (ground point).
local function flower(parent: Instance, base: Vector3, h: number, color: Color3, rng: Random)
	local tilt = CFrame.Angles(rng:NextNumber(-0.12, 0.12), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.12, 0.12))
	local root = CFrame.new(base) * tilt
	prop(parent, Enum.PartType.Block, Vector3.new(0.36, h, 0.36), root * CFrame.new(0, h / 2, 0), STEM)
	local head = root * CFrame.new(0, h, 0)
	-- a cylinder's axis is X: turn it upright so the disc lies flat
	prop(parent, Enum.PartType.Cylinder, Vector3.new(0.36, 2.0, 2.0), head * CFrame.Angles(0, 0, math.pi / 2), color)
	prop(parent, Enum.PartType.Ball, Vector3.new(0.84, 0.84, 0.84), head * CFrame.new(0, 0.24, 0), CENTRE)
end

local function twinkle(part: BasePart)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "BloomTwinkle"
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 255, 220), Color3.fromRGB(255, 190, 240))
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, 0.5), NumberSequenceKeypoint.new(1, 0) })
	pe.Lifetime = NumberRange.new(0.8, 1.4)
	pe.Rate = 1.6
	pe.Speed = NumberRange.new(0.2, 0.6)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Parent = part
	CollectionService:AddTag(pe, "PetSparkle")
end

-- Grass: a grass material, or a green part (the lobby ground is a flat-shaded green part, not grass material).
function LobbyBloom.isGrass(material: Enum.Material, color: Color3?): boolean
	if material == Enum.Material.Grass or material == Enum.Material.LeafyGrass then
		return true
	end
	if not color then
		return false
	end
	local r, g, b = color.R * 255, color.G * 255, color.B * 255
	return g > r + 12 and g > b + 12
end

local function grass(hit: RaycastResult): boolean
	local inst = hit.Instance
	return LobbyBloom.isGrass(hit.Material, if inst:IsA("BasePart") then inst.Color else nil)
end

-- Every part of the map that a flower must not touch (everything but characters, the bloom itself, Terrain and parts
-- nobody can see or bump into).
-- Returns (solid, trim, tall): trim = small edge / lawn decor (LobbyBloom.isTrim), checked with no margin; tall = gate
-- and arch parts (LobbyBloom.isOverhead), checked at any height (Studio 2026-10-15: a clump stood under a yard gate).
local function obstacles(bloom: Instance): (PathGrid.Grid, PathGrid.Grid, PathGrid.Grid)
	local g = PathGrid.new(16)
	local trim = PathGrid.new(16)
	local tall = PathGrid.new(16)
	local Players = game:GetService("Players")
	for _, d in Workspace:GetDescendants() do
		-- Terrain counts as one world-sized box (Studio 2026-10-15: it blocked every spot), so it and anything
		-- absurdly big are left out; the ground itself drops out by height (only boxes above its top block)
		local huge = d:IsA("BasePart") and (d.Size.X > 2000 or d.Size.Z > 2000)
		if d:IsA("BasePart") and d ~= Workspace.Terrain and d.ClassName ~= "Terrain" and not huge and not d:IsDescendantOf(bloom) and not d:FindFirstAncestor("Paths") then
			local model = d:FindFirstAncestorOfClass("Model")
			if model and Players:GetPlayerFromCharacter(model) then
				continue
			end
			local box = PathGrid.fromPart(d)
			if LobbyBloom.isOverhead(d) then
				PathGrid.add(tall, box)
			elseif d.Transparency < 1 or d.CanCollide then
				PathGrid.add(if LobbyBloom.isTrim(d.Name) then trim else g, box)
			end
		end
	end
	return g, trim, tall
end

-- Gates and arches over the lanes (the lobby build's YardGates and ZoneArches folders): nothing grows under them.
function LobbyBloom.isOverhead(part: Instance): boolean
	return part:FindFirstAncestor("YardGates") ~= nil or part:FindFirstAncestor("ZoneArches") ~= nil
end

-- Small decor that sits at a path's edge or on the lawn (edge stones, curbs, lawn tufts): a flower may stand right
-- beside it (no margin), it just must not overlap it. Everything else in "Paths" is walkway (1 stud margin).
function LobbyBloom.isTrim(name: string): boolean
	local n = string.lower(name)
	return string.find(n, "edge", 1, true) ~= nil or string.find(n, "stone", 1, true) ~= nil
		or string.find(n, "curb", 1, true) ~= nil or string.find(n, "tuft", 1, true) ~= nil
end

-- Tries out from a strip's side, nearest first: an edge stone, a joint or a joining strip at the edge pushes the clump out.
local STEPS = { 0, 0.75, 1.5, 2.5, 3.5, 5, 6.5, 8, 10 }

-- Last build's rejection counts by reason (printed by build, read by tests / Studio checks).
LobbyBloom.Stats = {} :: { [string]: number }

-- Builds the flowers; returns how many clusters were placed (0 when the lobby has no "Paths").
function LobbyBloom.build(): number
	local folders: { Instance } = {}
	for _, d in Workspace:GetDescendants() do
		if d.Name == "Paths" and (d:IsA("Folder") or d:IsA("Model")) then
			table.insert(folders, d)
		end
	end
	if #folders == 0 then
		LobbyBloom.Stats = {}
		print("[LobbyBloom] no Paths folder: no flowers")
		return 0
	end
	local bloom = Instance.new("Folder")
	bloom.Name = "LobbyBloom"
	bloom.Parent = Workspace
	local ray = RaycastParams.new()
	ray.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = table.clone(folders)
	table.insert(exclude, bloom)
	for _, p in game:GetService("Players"):GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	ray.FilterDescendantsInstances = exclude
	local solid, trimGrid, tall = obstacles(bloom) -- trimGrid: edge stones, curbs, tufts (no margin); tall: gates
	local pathGrid = PathGrid.new(16) -- walkway: 1 stud margin, any height
	local walkways: { PathGrid.Box } = {}
	for _, f in folders do
		for _, d in f:GetDescendants() do
			if d:IsA("BasePart") then
				local box = PathGrid.fromPart(d)
				if LobbyBloom.isTrim(d.Name) then
					PathGrid.add(trimGrid, box)
				else
					PathGrid.add(pathGrid, box)
					if not box.Round and math.max(box.HX, box.HZ) >= 2 then
						table.insert(walkways, box)
					end
				end
			end
		end
	end

	local hits: { [string]: RaycastResult } = {}
	local function ground(x: number, z: number, y: number): number?
		local hit = Workspace:Raycast(Vector3.new(x, y + 8, z), Vector3.new(0, -24, 0), ray)
		if not (hit and grass(hit) and hit.Normal.Y > 0.85) then
			return nil
		end
		hits[x .. ":" .. z] = hit
		return hit.Position.Y
	end
	local function extra(x: number, y: number, z: number): string?
		local hx = BOX.X / 2
		if PathGrid.touchesExact(solid, x, z, hx, hx, y + LIFT, y + BOX.Y, SOLID_MARGIN) then
			return "solid"
		end
		if PathGrid.touchesExact(tall, x, z, hx, hx, -math.huge, math.huge, 1) then
			return "gate"
		end
		local over = OverlapParams.new()
		over.FilterType = Enum.RaycastFilterType.Exclude
		local hit = hits[x .. ":" .. z]
		over.FilterDescendantsInstances = if hit then { hit.Instance, bloom } else { bloom }
		for _, other in Workspace:GetPartBoundsInBox(CFrame.new(x, y + BOX.Y / 2 + 0.05, z), BOX, over) do
			local top = other.Position.Y + other.Size.Y / 2
			if (other.Transparency < 1 or other.CanCollide) and top > y + LIFT and not LobbyBloom.isTrim(other.Name) and not other:FindFirstAncestor("Paths") then
				return "query"
			end
		end
		return nil
	end
	local spots, stats = PathGrid.spots(walkways, pathGrid, trimGrid, {
		Half = BOX.X / 2, Height = BOX.Y, Margin = MARGIN, Clear = CLEAR, Spacing = SPACING, Steps = STEPS, Cell = GRID, Max = MAX,
		Ground = ground, Extra = extra,
	})
	LobbyBloom.Stats = stats

	local rng = Random.new(20261015)
	for placed, s in spots do
		local g = Vector3.new(s[1], s[2], s[3])
		local cluster = Instance.new("Model")
		cluster.Name = "Flowers"
		cluster.Parent = bloom
		local color = PETALS[rng:NextInteger(1, #PETALS)]
		for k = 1, 3 do
			local a = (k / 3) * math.pi * 2 + rng:NextNumber(-0.4, 0.4)
			local r = if k == 1 then 0 else rng:NextNumber(1.0, 1.8)
			local base = g + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			flower(cluster, base, rng:NextNumber(1.8, 3.2), if k == 3 then PETALS[rng:NextInteger(1, #PETALS)] else color, rng)
		end
		if placed % 3 == 0 then
			local first = cluster:FindFirstChildWhichIsA("BasePart")
			if first then
				twinkle(first)
			end
		end
	end
	-- one line per build: placed and every rejection reason (the last reason tried per sample)
	local parts = {}
	for _, k in { "placed", "samples", "tries", "notGrass", "path", "trim", "solid", "gate", "query", "spaced" } do
		table.insert(parts, k .. "=" .. (stats[k] or 0))
	end
	print("[LobbyBloom] " .. table.concat(parts, " "))
	return #spots
end

return LobbyBloom
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="230">
        <Properties>
          <string name="Name">LobbyBoards</string>
          <string name="Source"><![CDATA[--!strict
-- World leaderboards in the lobby (SurfaceGui), fed by LeaderboardService, with loading / empty / error / Studio
-- unavailable states. The pet park places the two lobby boards (owner pick: RAREST PET = Biggest, crowned, and
-- HIGHEST FLOOR = Tower; LodgeBuilder.buildBoards) beside the nests and marks their mounts `Bare`: the rows go straight
-- onto the mount (createLodgeContent, five rows).
-- A mount without `Bare` gets the classic framed pale board (createContent, top 10). Boards without a mount are
-- not drawn (LeaderboardService still keeps every board). The content builders are separate from the 3D stands
-- so the offline preview can draw them on a ScreenGui.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Boards = require(Shared.Boards)
local Leaderboards = require(script.Parent.LeaderboardService)
local KitPlace = require(script.Parent.KitPlace)

local LobbyBoards = {}

local ROWS = Config.Leaderboards.Top
-- Pale board faces with charcoal text (Master 7: readable boards, not dark walls). The board's accent colour is
-- only a thin bar under the title, never text on the pale face.
local FACE = Color3.fromRGB(234, 228, 214)
local ROW_A = Color3.fromRGB(222, 215, 200)
local ROW_B = Color3.fromRGB(242, 237, 226)
local INK = Color3.fromRGB(44, 46, 52)
local INK_SOFT = Color3.fromRGB(96, 98, 104)
local MEDAL = { Color3.fromRGB(150, 108, 30), Color3.fromRGB(96, 104, 112), Color3.fromRGB(140, 86, 48) }

export type Handle = { Set: (Leaderboards.State) -> (), Root: Frame }

local function label(parent: Instance, name: string, pos: UDim2, size: UDim2, font: Enum.Font, color: Color3, align: Enum.TextXAlignment): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.Position = pos
	t.Size = size
	t.Font = font
	t.TextColor3 = color
	t.TextXAlignment = align
	t.TextScaled = true
	t.Text = ""
	t.Parent = parent
	return t
end

-- Builds the board face inside `parent` (any GuiObject / SurfaceGui) and returns a handle whose
-- Set(state) redraws it. Rows are created once and only their text changes.
function LobbyBoards.createContent(parent: Instance, boardId: string): Handle
	local info = Boards.Info[boardId]
	local root = Instance.new("Frame")
	root.Name = "Board_" .. boardId
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = FACE
	root.BorderSizePixel = 0
	root.Parent = parent

	local bar = Instance.new("Frame")
	bar.Name = "AccentBar"
	bar.Size = UDim2.new(1, 0, 0.012, 0)
	bar.Position = UDim2.fromScale(0, 0.1)
	bar.BackgroundColor3 = info.Accent
	bar.BorderSizePixel = 0
	bar.Parent = root

	local title = label(root, "Title", UDim2.fromScale(0.04, 0.012), UDim2.fromScale(0.92, 0.07), Enum.Font.FredokaOne, INK, Enum.TextXAlignment.Center)
	title.Text = info.Title
	local sub = label(root, "Sub", UDim2.fromScale(0.04, 0.118), UDim2.fromScale(0.92, 0.04), Enum.Font.GothamBold, INK_SOFT, Enum.TextXAlignment.Center)
	sub.Text = info.Sub

	local rowFrames: { { Frame: Frame, Rank: TextLabel, Name: TextLabel, Value: TextLabel } } = {}
	local top, rowH = 0.175, 0.073
	for i = 1, ROWS do
		local f = Instance.new("Frame")
		f.Name = "Row" .. i
		f.Position = UDim2.fromScale(0.03, top + (i - 1) * rowH)
		f.Size = UDim2.fromScale(0.94, rowH - 0.008)
		f.BackgroundColor3 = if i % 2 == 0 then ROW_B else ROW_A
		f.BorderSizePixel = 0
		f.Visible = false
		f.Parent = root
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = f
		local rank = label(f, "Rank", UDim2.fromScale(0.02, 0.1), UDim2.fromScale(0.12, 0.8), Enum.Font.FredokaOne, MEDAL[i] or INK, Enum.TextXAlignment.Center)
		local name = label(f, "Name", UDim2.fromScale(0.16, 0.1), UDim2.fromScale(0.5, 0.8), Enum.Font.GothamBold, INK, Enum.TextXAlignment.Left)
		local value = label(f, "Value", UDim2.fromScale(0.66, 0.1), UDim2.fromScale(0.32, 0.8), Enum.Font.FredokaOne, INK, Enum.TextXAlignment.Right)
		for _, t in { rank, name, value } do
			local c = Instance.new("UITextSizeConstraint")
			c.MaxTextSize = 40
			c.MinTextSize = 8
			c.Parent = t
		end
		table.insert(rowFrames, { Frame = f, Rank = rank, Name = name, Value = value })
	end

	local note = label(root, "Note", UDim2.fromScale(0.06, 0.28), UDim2.fromScale(0.88, 0.4), Enum.Font.GothamBold, INK, Enum.TextXAlignment.Center)
	note.TextWrapped = true
	local foot = label(root, "Foot", UDim2.fromScale(0.04, 0.93), UDim2.fromScale(0.92, 0.05), Enum.Font.GothamBold, INK_SOFT, Enum.TextXAlignment.Center)
	for _, t in { title, sub, note, foot } do
		local c = Instance.new("UITextSizeConstraint")
		c.MaxTextSize = if t == title then 56 else 34
		c.MinTextSize = 8
		c.Parent = t
	end

	local function set(state: Leaderboards.State)
		local rows = state.Rows
		for i, r in rowFrames do
			local row = rows[i]
			r.Frame.Visible = row ~= nil
			if row then
				r.Rank.Text = tostring(row.Rank)
				r.Name.Text = row.Name
				r.Value.Text = row.Text .. (if info.Unit ~= "" then " " .. info.Unit else "")
			end
		end
		if #rows > 0 then
			note.Text = ""
		elseif state.Status == "loading" then
			note.Text = "Loading..."
		elseif state.Status == "unavailable" then
			note.Text = "Records unavailable in this Studio test"
		elseif state.Status == "error" then
			note.Text = "Could not load this board.\nTrying again soon."
		else
			note.Text = "No records yet \u{2014} start a hunt!"
		end
		if state.Status == "error" and #rows > 0 then
			foot.Text = "Showing the last saved list"
		elseif state.Status == "ok" then
			foot.Text = "Top " .. ROWS .. " · ranks never reset"
		else
			foot.Text = ""
		end
	end
	set({ Status = "loading", Rows = {}, Updated = 0 })
	return { Set = set, Root = root }
end

-- The Prospector Lodge boards (docs/lodge/): the kit frame carries the heading (a fitted world sign, LodgeBuilder), so
-- this face is the ranking: FIVE permanent row slots (owner brief 2026-10-10: "each leaderboard permanently displays
-- five prominent ranking rows"), each with a rank chip (gold / silver / bronze for the top three), the player's avatar
-- head shot, name and real score, and one status line under them. A slot without a ranked player stays visible but
-- empty (rank chip, blank avatar, a dash): nothing is invented. The status line always says what the board is doing
-- (loading, empty, unavailable in a Studio test, a failed read and its retry), so the face is never an unexplained
-- black rectangle. Never an example name or score: rows come from LeaderboardService only.
local LODGE_ROWS = 5
-- (phone video 2026-10-13: the near-black face read as a dark slab; a lifted slate face with lighter rows keeps the
-- white names and gold scores high contrast without the black-wall look)
-- (Studio check 2026-10-13: the slate was still too dark; now a bright sky blue face with lighter rows, the same
-- white names and gold scores)
local LODGE_FACE = Color3.fromRGB(46, 118, 206)
local LODGE_ROW = Color3.fromRGB(86, 152, 230)
local LODGE_ROW_EMPTY = Color3.fromRGB(70, 136, 218)
local LODGE_INK = Color3.fromRGB(255, 255, 255)
local LODGE_SOFT = Color3.fromRGB(214, 220, 228)
local LODGE_MEDAL = { Color3.fromRGB(240, 192, 64), Color3.fromRGB(196, 202, 210), Color3.fromRGB(214, 140, 78) }
local LODGE_CHIP = Color3.fromRGB(36, 84, 156)
local LODGE_SCORE = Color3.fromRGB(250, 214, 92)
local LODGE_EMPTY: { [string]: string } = {
	Solo = "No solo finds yet \u{2014} be the first!",
	Wins = "No competitive wins yet \u{2014} be the first!",
	Biggest = "No pets hatched yet \u{2014} be the first!",
	Collection = "No pets hatched yet \u{2014} be the first!",
	Tower = "Nobody has climbed the tower yet \u{2014} be the first!",
}

-- Status line for a board state (also used by the preview check): never empty.
function LobbyBoards.lodgeStatus(boardId: string, state: Leaderboards.State): string
	local n = #state.Rows
	if state.Status == "loading" then
		return "Loading records\u{2026}"
	elseif state.Status == "unavailable" then
		return "Records unavailable in this Studio test"
	elseif state.Status == "error" then
		return if n > 0 then "Showing the last saved list \u{00B7} retrying" else "Records unavailable right now \u{00B7} retrying"
	elseif n == 0 then
		return LODGE_EMPTY[boardId] or "No records yet \u{2014} start a hunt!"
	end
	local info = Boards.Info[boardId]
	return if info then info.Sub else ""
end

function LobbyBoards.createLodgeContent(parent: Instance, boardId: string): Handle
	local root = Instance.new("Frame")
	root.Name = "Board_" .. boardId
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = LODGE_FACE
	root.BorderSizePixel = 0
	root.Parent = parent
	local rowFrames: { { Frame: Frame, Chip: Frame, Rank: TextLabel, Name: TextLabel, Value: TextLabel, Head: ImageLabel } } = {}
	local top, rowH = 0.02, 0.168
	for i = 1, LODGE_ROWS do
		local f = Instance.new("Frame")
		f.Name = "Row" .. i
		f.Position = UDim2.fromScale(0.025, top + (i - 1) * rowH)
		f.Size = UDim2.fromScale(0.95, rowH - 0.022)
		f.BackgroundColor3 = LODGE_ROW_EMPTY
		f.BorderSizePixel = 0
		f.Visible = true
		f.Parent = root
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = f
		local chip = Instance.new("Frame")
		chip.Name = "RankChip"
		chip.Position = UDim2.fromScale(0.015, 0.1)
		chip.Size = UDim2.fromScale(0.12, 0.8)
		chip.BackgroundColor3 = LODGE_MEDAL[i] or LODGE_CHIP
		chip.BorderSizePixel = 0
		chip.Parent = f
		local cc = Instance.new("UICorner")
		cc.CornerRadius = UDim.new(0, 8)
		cc.Parent = chip
		local rank = label(chip, "Rank", UDim2.fromScale(0, 0.06), UDim2.fromScale(1, 0.88), Enum.Font.FredokaOne, if i <= 3 then Color3.fromRGB(36, 28, 16) else LODGE_INK, Enum.TextXAlignment.Center)
		rank.Text = tostring(i)
		local head = Instance.new("ImageLabel")
		head.Name = "Avatar"
		head.BackgroundColor3 = Color3.fromRGB(40, 96, 176)
		head.BorderSizePixel = 0
		head.Position = UDim2.fromScale(0.15, 0.08)
		head.Size = UDim2.fromScale(0.115, 0.84)
		head.Image = ""
		head.Parent = f
		local ar = Instance.new("UIAspectRatioConstraint")
		ar.AspectRatio = 1
		ar.Parent = head
		local hc = Instance.new("UICorner")
		hc.CornerRadius = UDim.new(0.5, 0)
		hc.Parent = head
		local name = label(f, "Name", UDim2.fromScale(0.29, 0.14), UDim2.fromScale(0.45, 0.72), Enum.Font.GothamBold, LODGE_INK, Enum.TextXAlignment.Left)
		name.TextTruncate = Enum.TextTruncate.AtEnd
		local value = label(f, "Value", UDim2.fromScale(0.75, 0.12), UDim2.fromScale(0.225, 0.76), Enum.Font.FredokaOne, LODGE_SCORE, Enum.TextXAlignment.Right)
		for _, t in { rank, name, value } do
			local c = Instance.new("UITextSizeConstraint")
			c.MaxTextSize = 72
			c.MinTextSize = 20 -- big rows: readable on a phone from across the hall
			c.Parent = t
		end
		table.insert(rowFrames, { Frame = f, Chip = chip, Rank = rank, Name = name, Value = value, Head = head })
	end
	-- the status line under the five slots (never empty)
	local status = label(root, "Status", UDim2.fromScale(0.04, 0.865), UDim2.fromScale(0.92, 0.11), Enum.Font.GothamBold, LODGE_SOFT, Enum.TextXAlignment.Center)
	status.TextWrapped = true
	local sc = Instance.new("UITextSizeConstraint")
	sc.MaxTextSize = 34
	sc.MinTextSize = 12
	sc.Parent = status
	local function set(state: Leaderboards.State)
		local rows = state.Rows
		for i, r in rowFrames do
			local row = rows[i]
			if row then
				r.Frame.BackgroundColor3 = LODGE_ROW
				r.Chip.BackgroundTransparency = 0
				r.Rank.Text = tostring(row.Rank)
				r.Name.Text = row.Name
				r.Name.TextColor3 = LODGE_INK
				r.Value.Text = row.Text
				r.Value.TextColor3 = if i <= 3 then LODGE_SCORE else LODGE_INK
				-- avatar head shot from the Roblox thumbnail service (content URL, no web call from this server)
				local img = if row.UserId > 0 then ("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150"):format(row.UserId) else ""
				if r.Head.Image ~= img then -- same picture: leave it alone, so a refresh never reloads (flickers) the avatar
					r.Head.Image = img
				end
			else
				-- an open slot: the rank and a dash, no name, no score, no picture (never an example row)
				r.Frame.BackgroundColor3 = LODGE_ROW_EMPTY
				r.Chip.BackgroundTransparency = 0.55
				r.Rank.Text = tostring(i)
				r.Name.Text = "\u{2014}"
				r.Name.TextColor3 = LODGE_SOFT
				r.Value.Text = ""
				if r.Head.Image ~= "" then
					r.Head.Image = ""
				end
			end
		end
		status.Text = LobbyBoards.lodgeStatus(boardId, state)
		status.TextColor3 = if #rows == 0 then LODGE_INK else LODGE_SOFT
	end
	set({ Status = "loading", Rows = {}, Updated = 0 })
	return { Set = set, Root = root }
end

local function block(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Builds the four boards at the BoardMounts the lobby builder placed on the north records wall (an
-- invisible Mount_<id> part per board whose +Z side faces the viewer, plus Mount_Header). The
-- boards are compact and framed; one fitted text title serves the wall.
-- Plain-text board (the owner's hand-built boards: one TextLabel, attribute BoardId set by MapHooks): the title, then
-- one line per row ("1. Name   12,345"), or the honest status line when there are no rows.
function LobbyBoards.textFor(boardId: string, state: Leaderboards.State, maxRows: number?): string
	local info = Boards.Info[boardId]
	local lines = { if info then info.Title else boardId }
	if #state.Rows == 0 then
		table.insert(lines, LobbyBoards.lodgeStatus(boardId, state))
	else
		for i, row in state.Rows do
			if i > (maxRows or 5) then
				break
			end
			table.insert(lines, ("%d. %s   %s"):format(row.Rank, row.Name, row.Text))
		end
	end
	return table.concat(lines, "\n")
end

-- Every TextLabel in the world marked with attribute BoardId (MapHooks: the hand-built lobby's leaderboards) gets
-- the board as text, now and on every refresh.
local function bindTextBoards()
	local labels: { [string]: { TextLabel } } = {}
	for _, d in game:GetService("Workspace"):GetDescendants() do
		local id = d:GetAttribute("BoardId")
		if d:IsA("TextLabel") and type(id) == "string" and Boards.Info[id] then
			labels[id] = labels[id] or {}
			table.insert(labels[id], d)
		end
	end
	local function set(board: string)
		local list = labels[board]
		if list then
			-- fitted to the owner's board face, white with a black outline, unlit (KitPlace.fitMapLabel): the owner's
			-- labels were TextScaled dark text on a dark face, unreadable on a phone. The label paints a bright sky
			-- blue backing over the dark face, and the board shows its top three so each row can be big.
			local text = LobbyBoards.textFor(board, Leaderboards.get(board), 3)
			for _, l in list do
				l.BackgroundColor3 = LODGE_FACE
				l.BackgroundTransparency = 0
				local ok: boolean, err: any = pcall(KitPlace.fitMapLabel, l, text, "Landmark")
				if not ok then
					l.Text = text
					warn("[LobbyBoards] text board", board, "not fitted:", err)
				end
			end
		end
	end
	Leaderboards.onUpdated(set)
	for id in labels do
		set(id)
	end
end

function LobbyBoards.build(lobbyRoot: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "CT_Rocks_Leaderboards"
	folder.Parent = lobbyRoot
	local handles: { [string]: Handle } = {}
	local okText: boolean, errText: any = pcall(bindTextBoards)
	if not okText then
		warn("[LobbyBoards] text boards not bound:", errText)
	end
	local mounts = lobbyRoot:FindFirstChild("BoardMounts")
	if not mounts then
		warn("[LobbyBoards] no BoardMounts folder in the lobby; boards not built")
		return handles
	end
	for _, id in Boards.Order do
		local info = Boards.Info[id]
		local mount = mounts:FindFirstChild("Mount_" .. id) :: BasePart?
		if mount and mount:GetAttribute("Bare") then
			-- lodge board: the kit frame and heading exist; draw the rows straight onto the mount (+Z = viewer side)
			-- (LightInfluence 0: a display face reads at its own colours whatever the hall lighting does)
			local gui = Instance.new("SurfaceGui")
			gui.Name = "BoardGui"
			gui.Face = Enum.NormalId.Back
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 60
			gui.LightInfluence = 0
			gui.Parent = mount
			local ok, h = pcall(LobbyBoards.createLodgeContent, gui, id)
			if ok then
				handles[id] = h
			else
				warn("[LobbyBoards] board", id, "could not be drawn:", h)
			end
		elseif mount then
			local W, H = mount.Size.X, mount.Size.Y
			local cf = mount.CFrame
			local m = Instance.new("Model")
			m.Name = "Board_" .. id
			m.Parent = folder
			block(m, "Frame", Vector3.new(W + 0.5, H + 0.5, 0.4), cf * CFrame.new(0, 0, -0.3), Color3.fromRGB(110, 78, 52), Enum.Material.Wood)
			local face = block(m, "Face", Vector3.new(W, H, 0.2), cf * CFrame.new(0, 0, -0.1), FACE, Enum.Material.SmoothPlastic)
			local accent = block(m, "AccentBar", Vector3.new(W * 0.6, 0.1, 0.45), cf * CFrame.new(0, H / 2 + 0.3, -0.25), info.Accent, Enum.Material.SmoothPlastic)
			accent.CanCollide = false
			local gui = Instance.new("SurfaceGui")
			gui.Name = "BoardGui"
			gui.Face = Enum.NormalId.Back
			gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
			gui.CanvasSize = Vector2.new(580, 710)
			gui.LightInfluence = 0
			gui.Parent = face
			handles[id] = LobbyBoards.createContent(gui, id)
		end
	end
	-- ONE title for the whole records wall: a wood plate with a single fitted SurfaceGui line. (The first kit
	-- pass spelled RECORDS in 5x7 pixel-font blocks with 0.25-stud gaps, so rounded letters read as broken
	-- segments, and two wall lamps hung over the R, E and O. Text is now font text, lamps sit beside it.)
	local header = mounts:FindFirstChild("Mount_Header") :: BasePart?
	if header then
		local hm = Instance.new("Model")
		hm.Name = "Header"
		hm.Parent = folder
		-- one framed Landmark sign (KitPlace.signBoard fits the text to the board: explicit TextSize, PixelsPerStud
		-- derived from it, width fill checked by tools/preview/scenes/signs.luau)
		KitPlace.signBoard(hm, "Plate", header.CFrame * CFrame.new(0, 0, -0.1), header.Size.X, header.Size.Y, "RECORDS", "Landmark", { Face = Color3.fromRGB(58, 61, 67), Ink = Color3.fromRGB(232, 226, 212), Frame = Color3.fromRGB(58, 61, 67), Trim = Color3.fromRGB(217, 164, 65) })
	end

	local lastSig: { [string]: string } = {}
	local function refresh(board: string)
		local h = handles[board]
		if h then
			-- redraw only when the rows changed (a refresh with the same data repaints nothing)
			local st = Leaderboards.get(board)
			local parts = { st.Status }
			for _, row in st.Rows do
				table.insert(parts, row.Rank .. "|" .. row.Name .. "|" .. row.Text .. "|" .. row.UserId)
			end
			local sig = table.concat(parts, ";")
			if lastSig[board] == sig then
				return
			end
			local ok: boolean, err: any = pcall(h.Set, Leaderboards.get(board))
			if ok then
				lastSig[board] = sig -- only a board that painted skips the same rows next time
			else
				warn("[LobbyBoards] board", board, "could not be updated:", err)
			end
		end
	end
	Leaderboards.onUpdated(refresh)
	for id in handles do
		refresh(id)
	end
	return handles
end

return LobbyBoards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="231">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the public shared lobby: the dino-jungle pet park (owner picks 2026-10-10). ParkBuilder makes the valley,
-- the paths, the clearing with the queue nests, the 12 plots, the spawn plaza and the PET TOWER gate; this module puts
-- the stalls (LodgeBuilder: UPGRADES, PET BOOK, SHELL SELL on the plaza, the EGG SHOP at the north end, the crowned
-- HUNT WINS board in the clearing and two boards on the plaza) on it and makes the spawn on the plaza, facing the
-- clearing. Layout numbers: src/shared/ParkConfig.luau.
-- World.buildLobby (WorldBuilder) delegates here and returns the same fields as before:
-- { Root, Spawn, Alcoves (= the plots, see ParkBuilder.Plot), Stands }.
-- World frame: the ground top is y = Config.Lodge.FloorY (0); the plaza and the spawn are at +Z, the EGG SHOP at -Z.

local Workspace = game:GetService("Workspace")
local Kit = require(script.Parent.KitParts)
local KitPlace = require(script.Parent.KitPlace)
local LodgeBuilder = require(script.Parent.LodgeBuilder)
local ParkBuilder = require(script.Parent.ParkBuilder)
local MapHooks = require(script.Parent.MapHooks)
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local ParkConfig = require(Shared.ParkConfig)
local MapNames = require(Shared.MapNames)

local folder = Kit.folder

local LobbyBuilder = {}

export type Alcove = ParkBuilder.Plot

local FLOOR = Config.Lodge.FloorY
local PAVE_TOP = FLOOR + 0.05 -- plaza paving top (ParkBuilder)

-- Ground height under a world point (the park is flat) and whether it is inside the walkable park. Used by the
-- placement audit (tools/preview/scenes/placement.luau).
function LobbyBuilder.groundAt(_p: Vector3): number
	return FLOOR
end

function LobbyBuilder.insideLodge(p: Vector3): boolean
	return ParkConfig.inside(p.X, p.Z)
end

-- Walking routes that must stay clear (world X / Z), audited by tools/preview/scenes/placement.luau and
-- tools/preview/check_lobby.py: the spawn walk, the main and ring paths, the walk between the nests, the stall,
-- shop, tower and board fronts.
LobbyBuilder.ClearZones = {
	{ Name = "SpawnWalk", MinX = -6, MaxX = 6, MinZ = 96, MaxZ = 124 },
	{ Name = "MainSouth", MinX = -4.5, MaxX = 4.5, MinZ = 50, MaxZ = 92 },
	{ Name = "MainNorth", MinX = -4.5, MaxX = 4.5, MinZ = -96, MaxZ = -50 },
	{ Name = "RingSouth", MinX = -84, MaxX = 84, MinZ = 40, MaxZ = 48 },
	{ Name = "RingNorth", MinX = -84, MaxX = 84, MinZ = -48, MaxZ = -40 },
	{ Name = "RingWest", MinX = -48, MaxX = -40, MinZ = -84, MaxZ = 84 },
	{ Name = "RingEast", MinX = 40, MaxX = 48, MinZ = -84, MaxZ = 84 },
	{ Name = "ClearingWalk", MinX = -4, MaxX = 4, MinZ = -30, MaxZ = 30 },
	{ Name = "UpgradesFront", MinX = -43, MaxX = -36, MinZ = 101, MaxZ = 123 },
	{ Name = "PetBookFront", MinX = 36, MaxX = 43, MinZ = 101, MaxZ = 123 },
	{ Name = "SellerFront", MinX = -30, MaxX = -22, MinZ = 118, MaxZ = 124 },
	{ Name = "EggShopFront", MinX = -5, MaxX = 5, MinZ = -100, MaxZ = -96 },
	{ Name = "TowerApproach", MinX = -92, MaxX = -86, MinZ = -4, MaxZ = 4 },
	{ Name = "BoardFront", MinX = 20, MaxX = 27, MinZ = -14, MaxZ = 14 },
	{ Name = "HatchFront", MinX = 14, MaxX = 28, MinZ = -90, MaxZ = -86 },
	{ Name = "NewsFront", MinX = 15, MaxX = 29, MinZ = 99, MaxZ = 104 },
}

-- Lobby spawn pad (docs/m11/CAMERA_SPAWN_FIX.md): a SOLID, invisible 8 x 0.2 x 6 SpawnLocation lying on the plaza
-- paving at LobbyBuilder.spawnCFrame (top 0.02 above the paving), facing the clearing. Made once (Main.server calls
-- this before the mesh wait); build() re-parents it into the lobby folder.
LobbyBuilder.SpawnPadSize = Vector3.new(8, 0.2, 6)

function LobbyBuilder.spawnCFrame(): CFrame
	local p = Vector3.new(ParkConfig.Spawn.X, PAVE_TOP, ParkConfig.Spawn.Z)
	return CFrame.new(p) -- faces -Z (north, toward the clearing)
end

local spawnPad: SpawnLocation? = nil
function LobbyBuilder.ensureSpawn(): SpawnLocation
	if spawnPad and spawnPad.Parent then
		return spawnPad
	end
	local hand = MapHooks.root()
	local own = if hand then (hand:FindFirstChild(MapNames.Spawn, true) or hand:FindFirstChildWhichIsA("SpawnLocation", true)) else nil
	if own and own:IsA("SpawnLocation") then
		return own -- the hand-built map's spawn
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "CT_Rocks_LobbySpawn"
	spawn.Size = LobbyBuilder.SpawnPadSize
	spawn.CFrame = LobbyBuilder.spawnCFrame() * CFrame.new(0, 0.02 - LobbyBuilder.SpawnPadSize.Y / 2, 0)
	spawn.Anchored = true
	spawn.Transparency = 1
	spawn.CanCollide = true
	spawn.CanQuery = false
	spawn.CastShadow = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = Workspace
	spawnPad = spawn
	return spawn
end

-- The stall spot Parts in a hand-built map (shared/MapNames.StallSpots): the stall's front faces the Part's
-- LookVector, its base sits on the Part's bottom.
local function spotFrame(map: Instance, name: string): CFrame?
	local p = map:FindFirstChild(name, true)
	if p and p:IsA("BasePart") then
		local look = p.CFrame.LookVector
		return KitPlace.facing(p.Position - Vector3.new(0, p.Size.Y / 2, 0), Vector3.new(look.X, 0, look.Z))
	end
	return nil
end

function LobbyBuilder.build(_toolModel: (string) -> Model): { [string]: any }
	local handMap = MapHooks.root()
	-- with a hand-built map there is NO CT_Rocks_Lobby (no lodge, no park, no code spawn, and the client's park camera
	-- box stays off); the few helper pieces (hidden queue board, board mounts, stalls on stall spots) go in
	-- CT_Rocks_LobbyHooks
	local root = folder(Workspace, if handMap then "CT_Rocks_LobbyHooks" else "CT_Rocks_Lobby")
	local stalls = folder(root, "CT_Rocks_Lodge")
	local lights = folder(stalls, "CT_Rocks_LodgeLights")
	if handMap then
		-- the owner's hand-built lobby (Workspace.FTP_Lobby; also Lobby / PetPark): no procedural park and no old lodge or
		-- code spawn; only the hooks it holds are adopted (docs/MAP_HOOKS.md), and the code stalls are built on any
		-- stall spots it marks
		local hooks = MapHooks.ensure(handMap, root, true)
		local S = MapNames.StallSpots
		local up, book, sell = spotFrame(handMap, S.Upgrades), spotFrame(handMap, S.PetBook), spotFrame(handMap, S.Seller)
		if up then
			LodgeBuilder.buildUpgrades(stalls, lights, up)
		end
		if book then
			LodgeBuilder.buildCollection(stalls, lights, book)
		end
		if sell then
			LodgeBuilder.buildSeller(stalls, lights, sell)
		end
		local spawn = handMap:FindFirstChild(MapNames.Spawn, true) or handMap:FindFirstChildWhichIsA("SpawnLocation", true)
		local spawnCF: CFrame
		if spawn and spawn:IsA("BasePart") then
			spawnCF = spawn.CFrame * CFrame.new(0, spawn.Size.Y / 2, 0)
			if spawnPad and spawnPad ~= spawn then
				spawnPad:Destroy() -- the map's own spawn wins
				spawnPad = nil
			end
		else
			spawnCF = LobbyBuilder.spawnCFrame()
			LobbyBuilder.ensureSpawn().Parent = root
		end
		KitPlace.decorPolicy(stalls)
		return { Root = root, Spawn = spawnCF * CFrame.new(0, 3.5, 0), Alcoves = hooks.Plots, Stands = {}, HandBuilt = true }
	end

	-- fallback: the procedural park (same hook names, shared/MapNames)
	local park = ParkBuilder.build(root)
	-- the plaza stalls and the record boards (BoardMounts must be a direct child of the lobby root: LobbyBoards)
	local fr = ParkBuilder.stallFrames()
	LodgeBuilder.buildUpgrades(stalls, lights, fr.Upgrades)
	LodgeBuilder.buildCollection(stalls, lights, fr.PetBook)
	LodgeBuilder.buildSeller(stalls, lights, fr.Seller)
	LodgeBuilder.buildEggShop(stalls, lights, fr.EggShop)
	LodgeBuilder.buildBoards(root, lights, fr.Boards)

	local spawnCF = LobbyBuilder.spawnCFrame()
	LobbyBuilder.ensureSpawn().Parent = root

	-- every decorative part in the lobby (now and added later) ignores the camera and the interaction ray
	KitPlace.decorPolicy(root)
	MapHooks.ensure(root, root, false) -- the same hook checks as a hand-built map (all present here)

	return {
		Root = root,
		Spawn = spawnCF * CFrame.new(0, 3.5, 0),
		Alcoves = park.Plots,
		Stands = {},
	}
end

return LobbyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="232">
        <Properties>
          <string name="Name">LobbyEvents</string>
          <string name="Source"><![CDATA[--!strict
-- Hourly lobby events (owner pick 2026-10-14, lobby hangout idea 7). At the start of every UTC hour every server runs
-- the same event (Hangout.eventAt), with a toast one minute before:
--   CoinRain    coins fall around the event spot for CoinRain.Seconds; touch one to take it (PlayerCap per player)
--   GoldenRock  a big golden rock everyone cracks together ("Crack" prompt, one hit per HitGap per player); when it
--               breaks, everyone who hit it gets GoldenRock.Prize coins. If time runs out, nobody gets anything.
--   MysteryEgg  an egg drops at an event spot; the first player to open it gets a free pet (RobuxService.giftEgg,
--               Basic egg odds), or FallbackCoins when their Pet Book is full.
-- Event spots: parts named EventSpot or EventSpot1..N in the lobby; without one, the lobby spawn is used.
-- Every event part lives in Workspace.CT_HangoutEvents (outside the lobby folder and its decor policy).

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Hangout = require(Shared.Hangout)
local Net = require(Shared.Net)
local H = require(script.Parent.LobbyHangout)

local LobbyEvents = {}

local E = Hangout.Events
local spots: { Vector3 } = {}
local fallback = Vector3.new(0, 5, 0)
local gift: ((Player, string, string) -> any?)? = nil

type Current = { Kind: string, Ends: number, Id: number, Parts: { Instance } }
local current: Current? = nil
local serial = 0
local rainGot: { [Player]: number } = {}
local rockHits: { [Player]: number } = {}
local rockLast: { [Player]: number } = {}
local rockTotal, rockNeed = 0, 0
local eggOpened = false

local folder: Folder? = nil
local function partsFolder(): Folder
	local f = folder
	if f and f.Parent then
		return f
	end
	local made = Instance.new("Folder")
	made.Name = "CT_HangoutEvents"
	made.Parent = Workspace
	folder = made
	return made
end

local function spot(): Vector3
	return if #spots > 0 then spots[math.random(1, #spots)] else fallback
end

local function broadcast(kind: string, payload: any)
	Net.event("HangoutEvent"):FireAllClients(kind, payload)
end

local function finish(c: Current, line: string?)
	if current ~= c then
		return
	end
	current = nil
	for _, p in c.Parts do
		p:Destroy()
	end
	table.clear(rainGot)
	table.clear(rockHits)
	table.clear(rockLast)
	broadcast("Event", { Kind = c.Kind, State = "End" })
	if line then
		H.toastAll(line, "ok")
	end
end

-- Coin rain -----------------------------------------------------------------------------------------------------------

-- A player touched (or the test took) a coin. Returns the coins paid.
function LobbyEvents.collect(player: Player, coin: Instance): number
	local c = current
	if not c or c.Kind ~= "CoinRain" or coin:GetAttribute("Taken") or not coin:IsDescendantOf(partsFolder()) then
		return 0
	end
	local room = Hangout.rainRoom(rainGot[player] or 0)
	if room <= 0 then
		return 0
	end
	coin:SetAttribute("Taken", true)
	local value = math.min(E.CoinRain.CoinValue, room)
	local at = if coin:IsA("BasePart") then coin.Position else nil
	coin:Destroy()
	local paid = H.pay(player, value)
	rainGot[player] = (rainGot[player] or 0) + paid
	Net.event("HangoutEvent"):FireClient(player, "Coin", { Pos = at, Coins = paid })
	return paid
end

local function dropCoin(c: Current)
	local cfg = E.CoinRain
	local centre = c.Parts[1] and (c.Parts[1] :: any).Position or spot()
	local a = math.random() * math.pi * 2
	local r = math.sqrt(math.random()) * cfg.Radius
	local coin = Instance.new("Part")
	coin.Name = "RainCoin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.4, 2, 2)
	coin.Color = Color3.fromRGB(255, 200, 40)
	coin.Material = Enum.Material.SmoothPlastic
	coin.Reflectance = 0.15
	coin.CFrame = CFrame.new(centre + Vector3.new(math.cos(a) * r, cfg.DropHeight, math.sin(a) * r)) * CFrame.Angles(0, 0, math.rad(90))
	coin.CanCollide = true
	coin.Touched:Connect(function(hit: BasePart)
		local model = hit:FindFirstAncestorOfClass("Model")
		local p = if model then Players:GetPlayerFromCharacter(model) else nil
		if p then
			LobbyEvents.collect(p, coin)
		end
	end)
	coin.Parent = partsFolder()
	table.insert(c.Parts, coin)
	task.delay(cfg.Life, function()
		if coin.Parent then
			coin:Destroy()
		end
	end)
end

local function coinRain(c: Current)
	local cfg = E.CoinRain
	local marker = Instance.new("Part") -- an invisible centre (the first event part: dropCoin reads it)
	marker.Name = "RainCentre"
	marker.Transparency = 1
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.Size = Vector3.new(1, 1, 1)
	marker.Position = spot()
	marker.Parent = partsFolder()
	table.insert(c.Parts, marker)
	H.toastAll("COIN RAIN! Grab the falling coins!", "rare")
	for _ = 1, cfg.Coins do
		if current ~= c then
			return
		end
		dropCoin(c)
		task.wait(cfg.Seconds / cfg.Coins)
	end
	task.wait(2)
	finish(c, nil)
end

-- Golden rock ---------------------------------------------------------------------------------------------------------

local function rockLabel(c: Current)
	local gui = c.Parts[1] and c.Parts[1]:FindFirstChild("RockGui", true)
	local label = gui and gui:FindFirstChild("Text")
	if label and label:IsA("TextLabel") then
		label.Text = "GOLDEN EGG\n" .. math.max(0, rockNeed - rockTotal) .. " taps left"
	end
end

-- A "Crack" hit on the golden rock (prompt, range checked by LobbyHangout).
function LobbyEvents.hitRock(player: Player): boolean
	local c = current
	if not c or c.Kind ~= "GoldenRock" then
		return false
	end
	local t = os.clock()
	if rockLast[player] and t - rockLast[player] < E.GoldenRock.HitGap then
		return false
	end
	rockLast[player] = t
	rockHits[player] = (rockHits[player] or 0) + 1
	rockTotal += 1
	rockLabel(c)
	broadcast("RockHit", { Left = math.max(0, rockNeed - rockTotal), Pos = (c.Parts[1] :: any).Position })
	if rockTotal >= rockNeed then
		local helpers = 0
		for p in rockHits do
			if p.Parent then
				helpers += 1
				H.pay(p, E.GoldenRock.Prize)
			end
		end
		finish(c, "The GOLDEN EGG hatched! " .. helpers .. " helpers got " .. E.GoldenRock.Prize .. " coins each!")
	end
	return true
end

H.onPrompt("GoldRock", function(player, _prompt)
	LobbyEvents.hitRock(player)
end)

local function goldenRock(c: Current)
	local cfg = E.GoldenRock
	rockTotal = 0
	rockNeed = Hangout.rockHits(#Players:GetPlayers())
	local rock = Instance.new("Part")
	rock.Name = "GoldenRock"
	rock.Size = Vector3.new(7, 6, 7)
	rock.Color = Color3.fromRGB(255, 196, 46)
	rock.Material = Enum.Material.SmoothPlastic
	rock.Reflectance = 0.2
	rock.Anchored = true
	rock.CFrame = CFrame.new(spot() + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.rad(20), math.rad(8))
	local light = Instance.new("PointLight")
	light.Color = rock.Color
	light.Range = 20
	light.Brightness = 2
	light.Parent = rock
	local gui = Instance.new("BillboardGui")
	gui.Name = "RockGui"
	gui.Size = UDim2.fromScale(10, 3)
	gui.StudsOffset = Vector3.new(0, 6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 236, 160)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	gui.Parent = rock
	H.prompt(rock, "GoldRock", "Tap", "Golden Egg", cfg.Range)
	rock.Parent = partsFolder()
	table.insert(c.Parts, rock)
	rockLabel(c)
	H.toastAll("A GOLDEN EGG appeared! Everyone tap it together!", "rare")
	task.wait(cfg.Seconds)
	finish(c, "The golden egg rolled away... next time!")
end

-- Mystery egg ---------------------------------------------------------------------------------------------------------

function LobbyEvents.openEgg(player: Player): boolean
	local c = current
	if not c or c.Kind ~= "MysteryEgg" or eggOpened then
		return false
	end
	eggOpened = true
	local g = gift
	local pet = if g then g(player, E.MysteryEgg.Egg, "mystery:" .. c.Id .. ":" .. player.UserId) else nil
	if not pet then
		local paid = H.pay(player, E.MysteryEgg.FallbackCoins)
		H.toast(player, "Your Pet Book is full, so the mystery egg gave you " .. paid .. " coins!", "ok")
	end
	finish(c, player.DisplayName .. " opened the MYSTERY EGG!")
	return true
end

H.onPrompt("MysteryEgg", function(player, _prompt)
	LobbyEvents.openEgg(player)
end)

local function mysteryEgg(c: Current)
	local cfg = E.MysteryEgg
	eggOpened = false
	local egg = Instance.new("Part")
	egg.Name = "MysteryEgg"
	egg.Shape = Enum.PartType.Ball
	egg.Size = Vector3.new(3.4, 3.4, 3.4)
	egg.Color = Color3.fromRGB(170, 110, 255)
	egg.Material = Enum.Material.SmoothPlastic
	egg.Anchored = true
	egg.Position = spot() + Vector3.new(0, 1.7, 0)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.3, 1)
	mesh.Parent = egg
	local light = Instance.new("PointLight")
	light.Color = egg.Color
	light.Range = 14
	light.Parent = egg
	H.prompt(egg, "MysteryEgg", "Open", "Mystery Egg", cfg.Range, 1)
	egg.Parent = partsFolder()
	table.insert(c.Parts, egg)
	H.toastAll("A MYSTERY EGG dropped in the lobby! First to open it wins a pet!", "rare")
	task.wait(cfg.Seconds)
	finish(c, "Nobody found the mystery egg in time!")
end

-- Runner --------------------------------------------------------------------------------------------------------------

local RUN = { CoinRain = coinRain, GoldenRock = goldenRock, MysteryEgg = mysteryEgg }

-- Starts event `kind` now (the hourly schedule, /event in Studio, tests). False when one is already running.
function LobbyEvents.run(kind: string): boolean
	local fn = (RUN :: any)[kind]
	if not fn or current then
		return false
	end
	serial += 1
	local c: Current = { Kind = kind, Ends = 0, Id = os.time() * 10 + serial % 10, Parts = {} }
	current = c
	broadcast("Event", { Kind = kind, State = "Start", Name = E.Names[kind] })
	task.spawn(fn, c)
	return true
end

-- The running event (tests): { Kind, Parts } or nil.
function LobbyEvents.current(): any
	return current
end

-- Tests only: the pet gift used by the mystery egg.
function LobbyEvents.setGift(fn: (Player, string, string) -> any?)
	gift = fn
end

local function schedule()
	while true do
		local now = os.time()
		local at = Hangout.nextEventTime(now)
		local kind = Hangout.eventAt(at)
		local warnAt = at - E.WarnSeconds
		if warnAt > now then
			task.wait(warnAt - now)
			H.toastAll(E.Names[kind] .. " starts in 1 minute! Come to the plaza!", "info")
		end
		task.wait(math.max(0, at - os.time()))
		LobbyEvents.run(kind)
		task.wait(5)
	end
end

function LobbyEvents.start(roots: { Instance }, spawnAt: Vector3?, giftFn: ((Player, string, string) -> any?)?)
	if giftFn and not gift then
		gift = giftFn
	end
	if spawnAt then
		fallback = spawnAt
	end
	for _, r in roots do
		for _, d in r:GetDescendants() do
			if d:IsA("BasePart") and string.match(d.Name, "^EventSpot%d*$") then
				table.insert(spots, d.Position + Vector3.new(0, d.Size.Y / 2, 0))
			end
		end
	end
	Players.PlayerRemoving:Connect(function(p)
		rainGot[p] = nil
		rockHits[p] = nil
		rockLast[p] = nil
	end)
	task.spawn(schedule)
end

return LobbyEvents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="233">
        <Properties>
          <string name="Name">LobbyGames</string>
          <string name="Source"><![CDATA[--!strict
-- Lobby mini-games (owner pick 2026-10-14, lobby hangout idea 4). Small coin prizes, all paid through one daily cap
-- (Hangout.Games.DailyCoinCap, LobbyHangout.payGame). The server decides every hit, tap and place; clients only draw
-- (client/HangoutView). The pet race and the egg toss were removed (owner picks 2026-10-14); leftover RaceTrack /
-- EggToss models are cleared.
--
--   WhackStump   "Play": rocks pop out of the stump's holes for Whack.Seconds; tap a rock (ClickDetector) before it
--                drops back. One player at a time. Holes: parts / attachments named Hole1..N, else a ring on the top.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Hangout = require(Shared.Hangout)
local Net = require(Shared.Net)
local H = require(script.Parent.LobbyHangout)

local LobbyGames = {}

local G = Hangout.Games
local clock = function(): number
	return Workspace:GetServerTimeNow()
end
-- Tests only: replace the server clock.
function LobbyGames.setClock(fn: () -> number)
	clock = fn
end

local folder: Folder? = nil
local function partsFolder(): Folder
	local f = folder
	if f and f.Parent then
		return f
	end
	local made = Instance.new("Folder")
	made.Name = "CT_HangoutGames" -- outside the lobby folder: the lobby's decor policy turns clicks off
	made.Parent = Workspace
	folder = made
	return made
end

local function event(player: Player?, kind: string, payload: any)
	if player then
		Net.event("HangoutEvent"):FireClient(player, kind, payload)
	else
		Net.event("HangoutEvent"):FireAllClients(kind, payload)
	end
end

local function partOf(inst: Instance?): BasePart?
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst
	end
	if inst:IsA("Model") and inst.PrimaryPart then
		return inst.PrimaryPart
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

-- Whack-a-rock --------------------------------------------------------------------------------------------------------

type Whack = { Stump: BasePart, Holes: { Vector3 }, Player: Player?, Hits: number, Rock: BasePart?, Ends: number }
local whacks: { Whack } = {}
local whackCool: { [Player]: number } = {}

local function holesOf(stump: Instance, top: BasePart): { Vector3 }
	local out: { Vector3 } = {}
	for _, d in stump:GetDescendants() do
		if string.match(d.Name, "^Hole%d+$") then
			if d:IsA("BasePart") then
				table.insert(out, d.Position + Vector3.new(0, d.Size.Y / 2, 0))
			elseif d:IsA("Attachment") then
				table.insert(out, d.WorldPosition)
			end
		end
	end
	if #out == 0 then
		local w = G.Whack
		local c = top.CFrame * CFrame.new(0, top.Size.Y / 2, 0)
		for i = 1, w.Holes do
			local a = (i - 1) / w.Holes * math.pi * 2
			table.insert(out, (c * CFrame.new(math.cos(a) * w.HoleRadius, 0, math.sin(a) * w.HoleRadius)).Position)
		end
	end
	return out
end

local function popRock(w: Whack, at: Vector3): BasePart
	local rock = Instance.new("Part")
	rock.Name = "WhackRock"
	rock.Size = Vector3.new(1.8, 1.6, 1.8)
	rock.Color = Color3.fromRGB(150, 140, 128)
	rock.Material = Enum.Material.Slate
	rock.Anchored = true
	rock.CanCollide = false
	rock.CFrame = CFrame.new(at + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0)
	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 40
	cd.Parent = rock
	cd.MouseClick:Connect(function(clicker: Player)
		if clicker == w.Player and w.Rock == rock then
			w.Hits += 1
			w.Rock = nil
			rock:Destroy()
			event(clicker, "Whack", { Hits = w.Hits, Ends = w.Ends, Pos = at })
		end
	end)
	rock.Parent = partsFolder()
	return rock
end

local function runWhack(w: Whack, player: Player)
	local cfg = G.Whack
	w.Player, w.Hits = player, 0
	w.Ends = clock() + cfg.Seconds
	event(player, "Whack", { Hits = 0, Ends = w.Ends })
	local last = 0
	while clock() < w.Ends and player.Parent and H.near(player, w.Stump.Position, cfg.LeaveDistance) do
		local i = math.random(1, #w.Holes)
		if i == last and #w.Holes > 1 then
			i = i % #w.Holes + 1
		end
		last = i
		local rock = popRock(w, w.Holes[i])
		w.Rock = rock
		local t0 = clock()
		while w.Rock == rock and clock() - t0 < cfg.PopSeconds do
			task.wait(0.05)
		end
		if w.Rock == rock then
			w.Rock = nil
			rock:Destroy()
		end
		task.wait(cfg.Gap)
	end
	local hits = w.Hits
	w.Player = nil
	whackCool[player] = os.clock() + cfg.Cooldown
	if player.Parent then
		local paid = H.payGame(player, Hangout.whackPrize(hits))
		event(player, "WhackDone", { Hits = hits, Coins = paid })
		H.toast(player, "Egg Pop: " .. hits .. " taps! +" .. paid .. " coins" .. (if paid == 0 and hits > 0 then " (daily game coins all won!)" else ""), "ok")
	end
end

H.onPrompt("Whack", function(player, prompt)
	local w: Whack? = nil
	for _, x in whacks do
		if prompt:IsDescendantOf(x.Stump) or prompt.Parent == x.Stump then
			w = x
		end
	end
	if not w then
		return
	end
	if w.Player then
		H.toast(player, if w.Player == player then "Tap the eggs!" else w.Player.DisplayName .. " is playing. Wait your turn!", "info")
		return
	end
	if (whackCool[player] or 0) > os.clock() then
		return
	end
	task.spawn(runWhack, w, player)
end)

-- Test hook: the rock up right now on stump `i` (nil = none).
function LobbyGames.whackRock(i: number?): BasePart?
	local w = whacks[i or 1]
	return if w then w.Rock else nil
end

-- Hooks -----------------------------------------------------------------------------------------------------------------

function LobbyGames.adopt(root: Instance)
	for _, d in root:GetDescendants() do
		if d.Name == "WhackStump" then
			local top = partOf(d)
			if top then
				local known = false
				for _, w in whacks do
					known = known or w.Stump == top
				end
				if not known then
					table.insert(whacks, { Stump = top, Holes = holesOf(d, top), Player = nil, Hits = 0, Rock = nil, Ends = 0 })
					H.prompt(top, "Whack", "Play", "Egg Pop", G.Range)
				end
			end
		elseif d.Name == "RaceTrack" or d.Name == "EggToss" then
			d:Destroy() -- the pet race and the egg toss were removed (owner picks 2026-10-14)
		end
	end
end

function LobbyGames.start(roots: { Instance })
	for _, r in roots do
		LobbyGames.adopt(r)
	end
	Players.PlayerRemoving:Connect(function(p)
		whackCool[p] = nil
	end)
end

return LobbyGames
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="234">
        <Properties>
          <string name="Name">LobbyHangout</string>
          <string name="Source"><![CDATA[--!strict
-- Lobby hangout, shared server part (shared/Hangout has the rules and tuning; docs/HANGOUT.md the hooks):
--   * one prompt router: every hangout prompt carries the attribute `Hangout` (its kind); Triggered is re-checked for
--     range here and handed to the handler registered for that kind (LobbyGames, LobbyEvents register theirs);
--   * coin payouts (pay / payGame with the daily mini-game cap), counted in Stats.CashEarned (MOST COINS board);
--   * sit spots (idea 8): parts named SitSpot*, Bench*, Swing*, DockSeat*, CampfireLog* get a "Sit" prompt (a part
--     that is not a Seat gets an invisible Seat on its top); a Campfire gets a warm light (static, no flames);
--   * secret spots (idea 9): HiddenEgg1..N pay coins once each, the LookoutChest once per UTC day;
--   * the ONE group reward (idea 10 + the first-five-minutes daily group gift, merged): membership of
--     Retention.Group.Id is asked once per join (or on the GroupGift prompt); a member gets a free pet once
--     (RobuxService.giftEgg), the daily group coins (RetentionService.groupDaily) and the player attribute GroupMember
--     (MatchService adds Hangout.groupLuck to the finder's luck). Off while the id is 0.
-- Hooks are found by name under the lobby roots when the lobby starts (adopt), so the hand-built LobbyMeadow and
-- the fallback park work the same. A missing hook just means that feature is not in the map.

local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Hangout = require(Shared.Hangout)
local Net = require(Shared.Net)
local Profiles = require(script.Parent.Profiles)

local LobbyHangout = {}

local handlers: { [string]: (Player, ProximityPrompt) -> () } = {}
local lastPrompt: { [Player]: number } = {}
local secretTotal = 0
local groupCheck = function(player: Player): any
	return GroupService:GetGroupsAsync(player.UserId)
end
local giftEgg: ((Player, string, string) -> any?)? = nil
local groupDaily: ((Player, boolean) -> number)? = nil

local function toast(player: Player, text: string, kind: string?)
	Net.event("Toast"):FireClient(player, text, kind or "info")
end
LobbyHangout.toast = toast

function LobbyHangout.toastAll(text: string, kind: string?)
	Net.event("Toast"):FireAllClients(text, kind or "info")
end

-- The player's saved hangout state (repaired in place), or nil before the profile loads / after it was released.
function LobbyHangout.state(player: Player): Hangout.State?
	local data = Profiles.get(player)
	if not data or Profiles.isReleased(player) then
		return nil
	end
	data.Hangout = Hangout.sanitize(data.Hangout)
	return data.Hangout
end

function LobbyHangout.today(): number
	return Hangout.day(os.time())
end

-- Pays coins now (counted as earned: MOST COINS board). Returns the coins paid.
function LobbyHangout.pay(player: Player, coins: number): number
	local data = Profiles.get(player)
	local n = math.floor(coins)
	if not data or Profiles.isReleased(player) or n <= 0 then
		return 0
	end
	data.Cash += n
	data.Stats.CashEarned += n
	Profiles.changed(player)
	return n
end

-- A mini-game prize: paid up to what is left of today's Hangout.Games.DailyCoinCap. Returns the coins paid.
function LobbyHangout.payGame(player: Player, want: number): number
	local h = LobbyHangout.state(player)
	if not h then
		return 0
	end
	local n = Hangout.payGame(h, LobbyHangout.today(), want)
	return LobbyHangout.pay(player, n)
end

-- The avatar's root part, or nil.
function LobbyHangout.root(player: Player): BasePart?
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local function promptAt(prompt: ProximityPrompt): Vector3?
	local parent = prompt.Parent
	if parent and parent:IsA("BasePart") then
		return parent.Position
	elseif parent and parent:IsA("Attachment") then
		return parent.WorldPosition
	end
	return nil
end

-- Is the player's avatar within `range` studs of `pos`?
function LobbyHangout.near(player: Player, pos: Vector3, range: number): boolean
	local r = LobbyHangout.root(player)
	return r ~= nil and (r.Position - pos).Magnitude <= range
end

-- A hangout prompt on `part` (made once; kind in the attribute `Hangout`).
function LobbyHangout.prompt(part: Instance, kind: string, action: string, object: string, range: number?, hold: number?): ProximityPrompt
	local pp = part:FindFirstChild("HangoutPrompt") :: ProximityPrompt?
	if not pp then
		local made = Instance.new("ProximityPrompt")
		made.Name = "HangoutPrompt"
		made.RequiresLineOfSight = false
		made.Parent = part
		pp = made
	end
	local p = pp :: ProximityPrompt
	p.ActionText = action
	p.ObjectText = object
	p.MaxActivationDistance = range or 10
	p.HoldDuration = hold or 0
	p:SetAttribute("Hangout", kind)
	return p
end

function LobbyHangout.onPrompt(kind: string, fn: (Player, ProximityPrompt) -> ())
	handlers[kind] = fn
end

-- Routes one Triggered prompt (also called by tests). Out of range or too fast = ignored.
function LobbyHangout.trigger(prompt: ProximityPrompt, player: Player)
	local kind = prompt:GetAttribute("Hangout")
	local fn = if type(kind) == "string" then handlers[kind] else nil
	if not fn then
		return
	end
	local at = promptAt(prompt)
	if not at or not LobbyHangout.near(player, at, prompt.MaxActivationDistance + 6) then
		return
	end
	local t = os.clock()
	if lastPrompt[player] and t - lastPrompt[player] < 0.2 then
		return
	end
	lastPrompt[player] = t
	fn(player, prompt)
end

-- Sit spots (idea 8) --------------------------------------------------------------------------------------------------

local function seatFor(part: BasePart): Seat
	if part:IsA("Seat") then
		return part
	end
	local existing = part:FindFirstChild("HangoutSeat")
	if existing and existing:IsA("Seat") then
		return existing
	end
	local seat = Instance.new("Seat")
	seat.Name = "HangoutSeat"
	seat.Size = Vector3.new(2, 0.4, 2)
	seat.Transparency = 1
	seat.Anchored = true
	seat.CanCollide = false
	seat.CFrame = part.CFrame * CFrame.new(0, part.Size.Y / 2 + 0.2, 0)
	seat.Parent = part
	return seat
end

local function hookSit(part: BasePart)
	local seat = seatFor(part)
	LobbyHangout.prompt(seat, "Sit", "Sit", "", 8)
end

LobbyHangout.onPrompt("Sit", function(player, prompt)
	local seat = prompt.Parent
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if seat and seat:IsA("Seat") and hum and hum.Health > 0 and seat.Occupant == nil then
		seat:Sit(hum)
	end
end)

local function hookCampfire(inst: Instance)
	local part = if inst:IsA("BasePart") then inst else inst:FindFirstChildWhichIsA("BasePart", true)
	if part and not part:FindFirstChild("CampfireLight") then
		local light = Instance.new("PointLight")
		light.Name = "CampfireLight"
		light.Color = Color3.fromRGB(255, 170, 90)
		light.Brightness = 1.6
		light.Range = 16
		light.Parent = part
	end
end

-- Secret spots (idea 9) ------------------------------------------------------------------------------------------------

-- Tells this player's client which hidden eggs to hide (Hangout.foundList).
function LobbyHangout.publishSecrets(player: Player)
	local h = LobbyHangout.state(player)
	if h then
		player:SetAttribute(Hangout.Secrets.FoundAttr, Hangout.foundList(h))
	end
end

LobbyHangout.onPrompt("Secret", function(player, prompt)
	local h = LobbyHangout.state(player)
	local name = prompt:GetAttribute("Secret")
	if not h or type(name) ~= "string" then
		return
	end
	if not Hangout.claimSecret(h, name) then
		toast(player, "You already found this hidden egg!", "info")
		LobbyHangout.publishSecrets(player)
		return
	end
	LobbyHangout.publishSecrets(player)
	local paid = LobbyHangout.pay(player, Hangout.Secrets.Coins)
	toast(player, "Hidden egg " .. Hangout.secretsFound(h) .. "/" .. math.max(secretTotal, Hangout.secretsFound(h)) .. " found! +" .. paid .. " coins", "rare")
	Net.event("Fx"):FireClient(player, "HiddenEgg", { Pos = promptAt(prompt) })
end)

LobbyHangout.onPrompt("Lookout", function(player, prompt)
	local h = LobbyHangout.state(player)
	if not h then
		return
	end
	if not Hangout.claimLookout(h, LobbyHangout.today()) then
		toast(player, "Come back tomorrow for more lookout coins!", "info")
		return
	end
	local paid = LobbyHangout.pay(player, Hangout.Secrets.LookoutCoins)
	toast(player, "You climbed to the lookout! +" .. paid .. " coins", "rare")
	Net.event("Fx"):FireClient(player, "HiddenEgg", { Pos = promptAt(prompt) })
end)

-- Group bonus (idea 10) ------------------------------------------------------------------------------------------------

local checking: { [Player]: boolean } = {}
local lastGroup: { [Player]: number } = {}

-- Asks Roblox whether the player is in the group, sets GroupMember and gives the free pet once. `loud` = the player
-- asked (the GroupGift prompt), so a "join first" line is shown.
function LobbyHangout.checkGroup(player: Player, loud: boolean?)
	if not Hangout.groupOn() or checking[player] then
		return
	end
	checking[player] = true
	local ok, rows = pcall(groupCheck, player)
	checking[player] = nil
	if not ok then
		warn("[LobbyHangout] group check failed:", rows)
		return
	end
	local member = Hangout.inGroup(rows)
	if player.Parent then
		player:SetAttribute("GroupMember", member)
	end
	local h = LobbyHangout.state(player)
	if not h then
		return
	end
	if not member then
		if loud then
			toast(player, "Join our Roblox group, then tap here for a free pet!", "info")
		end
		return
	end
	local daily = groupDaily
	local coins = if daily then daily(player, true) else 0
	if h.GroupGift then
		if loud and coins == 0 then
			toast(player, "You already got your group gifts today. Thanks for joining!", "info")
		end
		return
	end
	local gift = giftEgg
	local pet = if gift then gift(player, Hangout.Group.GiftEgg, "group:" .. player.UserId) else nil
	if pet then
		h.GroupGift = true
		Profiles.changed(player)
		toast(player, "Thanks for joining the group! Here is a free pet!", "rare")
	else
		toast(player, "Make room in your Pet Book to get your free group pet!", "warn")
	end
end

LobbyHangout.onPrompt("GroupGift", function(player, _prompt)
	local t = os.clock()
	if lastGroup[player] and t - lastGroup[player] < 10 then
		return
	end
	lastGroup[player] = t
	if not Hangout.groupOn() then
		toast(player, "The group gift is coming soon!", "info")
		return
	end
	task.spawn(LobbyHangout.checkGroup, player, true)
end)

-- Tests only: replace the group lookup (player -> GetGroupsAsync rows) and the pet gift.
function LobbyHangout.setGroupCheck(fn: (Player) -> any)
	groupCheck = fn
end
function LobbyHangout.setGift(fn: (Player, string, string) -> any?)
	giftEgg = fn
end
function LobbyHangout.setGroupDaily(fn: (Player, boolean) -> number)
	groupDaily = fn
end

-- Hooks ---------------------------------------------------------------------------------------------------------------

-- Finds the hangout hooks under `root` (sit spots, campfire, hidden eggs, lookout chest, group gift). Safe to call
-- again: every prompt is made once.
function LobbyHangout.adopt(root: Instance)
	local n = 0
	for _, d in root:GetDescendants() do
		local name = d.Name
		if d:IsA("BasePart") and d.Name ~= "HangoutSeat" and Hangout.isSitName(name) then
			hookSit(d)
		elseif name == Hangout.Sit.Campfire then
			hookCampfire(d)
		elseif Hangout.secretIndex(name) then
			local part = if d:IsA("BasePart") then d elseif d:IsA("Model") then d:FindFirstChildWhichIsA("BasePart", true) else nil
			if part then
				n += 1
				local pp = LobbyHangout.prompt(part, "Secret", "Take", "Hidden Egg", Hangout.Secrets.Range)
				pp:SetAttribute("Secret", name)
			end
		elseif name == Hangout.Secrets.Lookout or name == Hangout.Group.GiftPrompt then
			local part = if d:IsA("BasePart") then d elseif d:IsA("Model") then d:FindFirstChildWhichIsA("BasePart", true) else nil
			if part then
				if name == Hangout.Secrets.Lookout then
					LobbyHangout.prompt(part, "Lookout", "Open", "Lookout Chest", Hangout.Secrets.Range)
				else
					LobbyHangout.prompt(part, "GroupGift", "Claim", "Group Gift", Hangout.Secrets.Range)
				end
			end
		end
	end
	secretTotal = math.max(secretTotal, n)
end

-- `roots`: the lobby map(s) to search for hooks (the hand-built map, the code's lobby folder); never the arenas.
function LobbyHangout.start(roots: { Instance }, gift: ((Player, string, string) -> any?)?)
	if gift and not giftEgg then
		giftEgg = gift
	end
	if not groupDaily then
		groupDaily = require(script.Parent.RetentionService).groupDaily
	end
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		if prompt:GetAttribute("Hangout") ~= nil then
			LobbyHangout.trigger(prompt, player)
		end
	end)
	for _, r in roots do
		LobbyHangout.adopt(r)
	end
	Profiles.onLoaded(function(player)
		LobbyHangout.publishSecrets(player)
		task.spawn(LobbyHangout.checkGroup, player, false)
	end)
	Players.PlayerRemoving:Connect(function(p)
		lastPrompt[p] = nil
		lastGroup[p] = nil
		checking[p] = nil
	end)
end

return LobbyHangout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="235">
        <Properties>
          <string name="Name">LobbyLaunch</string>
          <string name="Source"><![CDATA[--!strict
-- Lobby side of Teleport mode: turns "leader taps START" into a ticketed teleport of the whole
-- party to a private (reserved) Match server.
--
-- Order matters and every step can fail without losing anything:
--   1. reserve a server (ReserveServer) and store an expiring ticket keyed by its PrivateServerId
--   2. save + release every profile (bounded retries; a profile that cannot be released stops the
--      launch, nobody is sent with a locked save)
--   3. TeleportAsync with the reserved access code (teleport data is only a hint)
--   4. failures (TeleportInitFailed, a throw, or a member still here after a watchdog): take the
--      profile lock back, keep the party and the ticket, show RETRY (once per member) / CANCEL
-- Members who did leave stay seated in the party for Config.Teleport.AwayHoldSeconds so the party
-- can come back together; the party stays locked until they are back or the hold runs out.
-- Teleports cannot run in Studio: this path is verified by offline tests of the pure rules only.

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local MatchTicket = require(Shared.MatchTicket)
local TeleportBook = require(Shared.TeleportBook)
local Profiles = require(script.Parent.Profiles)
local PartyService = require(script.Parent.PartyService)
local Tickets = require(script.Parent.Tickets)

local LobbyLaunch = {}

type Launch = {
	Id: string,
	Party: PartyService.Party,
	Ticket: MatchTicket.Ticket?,
	Code: string?,
	Phase: string, -- Preparing | Teleporting | Failed | Partial | Done
	Message: string,
	Sent: { [number]: boolean }, -- teleport requested for this member
	Away: { [number]: boolean }, -- member has left this server (is in the Match place)
	Failed: { [number]: string },
	Retries: { [number]: number },
	Reacquiring: { [number]: boolean },
	AwayDeadline: number,
	Gen: number, -- bumps on every send so old watchdogs do nothing
}

local launches: { [string]: Launch } = {} -- by party id
local launchOf: { [number]: string } = {} -- user id -> party id

local function playerOf(uid: number): Player?
	return Players:GetPlayerByUserId(uid)
end

local function nameOf(uid: number): string
	local p = playerOf(uid)
	return if p then p.DisplayName else "?"
end

-- UI -----------------------------------------------------------------------------------------

local function memberStates(l: Launch): { any }
	local out = {}
	for _, uid in l.Party.Members do
		local state = "Pending"
		if l.Away[uid] then
			state = "Away"
		elseif l.Failed[uid] then
			state = "Failed"
		elseif l.Sent[uid] then
			state = "Sent"
		end
		table.insert(out, { UserId = uid, Name = nameOf(uid), State = state, Reason = l.Failed[uid] })
	end
	return out
end

local function pushTo(l: Launch, uid: number)
	local p = playerOf(uid)
	if not p then
		return
	end
	local isLeader = l.Party.Leader == uid
	local canRetry = false
	if l.Phase == "Failed" or l.Phase == "Partial" then
		if isLeader then
			for fu in l.Failed do
				if (l.Retries[fu] or 0) < Config.Teleport.MaxRetries then
					canRetry = true
				end
			end
		else
			canRetry = l.Failed[uid] ~= nil and (l.Retries[uid] or 0) < Config.Teleport.MaxRetries
		end
		local ticket = l.Ticket
		if ticket and os.time() > ticket.ArriveBy - 10 then
			canRetry = false -- too late to enter the Match place with this ticket
		end
	end
	Net.event("LaunchEvent"):FireClient(p, "Launch", {
		Phase = l.Phase,
		Message = l.Message,
		Members = memberStates(l),
		Leader = l.Party.Leader,
		CanRetry = canRetry,
		CanCancel = l.Phase == "Failed" or l.Phase == "Partial" or l.Phase == "Done",
		Tier = l.Party.Tier,
	})
end

local function push(l: Launch)
	for _, uid in l.Party.Members do
		pushTo(l, uid)
	end
end

local function hideFor(uid: number)
	local p = playerOf(uid)
	if p then
		Net.event("LaunchEvent"):FireClient(p, "Hide", {})
	end
end

-- Ending a launch ------------------------------------------------------------------------------

local function dissolve(l: Launch, dropAway: boolean)
	launches[l.Party.Id] = nil
	-- every entry of this launch, not just the current roster: a member who left the party (seat dropped
	-- mid-prepare, CANCEL, server leave) would otherwise keep a stale entry that blocks their next START
	TeleportBook.dissolve(launchOf, l.Party.Id)
	local party = l.Party
	if dropAway then
		for uid in l.Away do
			if PartyService.of(uid) == party then
				PartyService.leave(uid)
			end
		end
	end
	if PartyService.get(party.Id) == party then
		PartyService.setLocked(party, false, nil)
	end
	for _, uid in table.clone(party.Members) do
		hideFor(uid)
	end
end

local function alive(l: Launch): boolean
	return launches[l.Party.Id] == l
end

local function reacquireAsync(l: Launch, uid: number)
	local p = playerOf(uid)
	if not p or l.Reacquiring[uid] then
		return
	end
	l.Reacquiring[uid] = true
	task.spawn(function()
		local ok = Profiles.reacquire(p)
		l.Reacquiring[uid] = nil
		if not ok and p.Parent then
			p:Kick("Your save moved to another server. Please rejoin.")
		end
	end)
end

-- The launch ended (CANCEL, someone left mid-prepare) while a save step was yielding: give back
-- any profile that step released, nobody is sent.
local function handBack(l: Launch, uids: { number })
	for _, uid in uids do
		local p = playerOf(uid)
		if p and Profiles.isReleased(p) then
			reacquireAsync(l, uid)
		end
	end
end

local function abort(l: Launch, message: string)
	-- before anyone was sent: hand every profile back and unlock the party
	for _, uid in l.Party.Members do
		local p = playerOf(uid)
		if p and Profiles.isReleased(p) then
			reacquireAsync(l, uid)
		end
		local pl = playerOf(uid)
		if pl then
			PartyService.toast(pl, message, "warn")
		end
	end
	dissolve(l, false)
end

-- Sent / failed bookkeeping --------------------------------------------------------------------

local function settle(l: Launch)
	-- Preparing counts too: a failed save on a retry must land on Failed / Partial, not hang
	if l.Phase == "Done" or not alive(l) then
		return
	end
	local pending = false
	local failed = false
	local away = false
	for _, uid in l.Party.Members do
		if l.Away[uid] then
			away = true
		elseif l.Failed[uid] then
			failed = true
		else
			pending = true
		end
	end
	if pending then
		return
	end
	if failed then
		l.Phase = if away then "Partial" else "Failed"
		l.Message = if away then "Some of your party could not make it. Try again, or cancel." else "The teleport did not work. Nothing was lost."
	else
		l.Phase = "Done"
		l.Message = "Your party is in the hunt."
	end
	push(l)
end

local function markFailed(l: Launch, uid: number, reason: string)
	if l.Away[uid] or l.Failed[uid] then
		return
	end
	l.Failed[uid] = reason
	l.Sent[uid] = nil
	reacquireAsync(l, uid)
	settle(l)
	push(l)
end

local function teleportMembers(l: Launch, uids: { number })
	local ticket, code = l.Ticket, l.Code
	if not ticket or not code then
		return
	end
	local players: { Player } = {}
	for _, uid in uids do
		local p = playerOf(uid)
		if p then
			table.insert(players, p)
			l.Sent[uid] = true
		else
			l.Away[uid] = true
		end
	end
	if #players == 0 then
		settle(l)
		return
	end
	l.Gen += 1
	local gen = l.Gen
	l.Phase = "Teleporting"
	l.Message = "Heading to the hunt..."
	push(l)

	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = code
	-- A hint for the client only. The Match server never trusts it; it reads the ticket by PrivateServerId.
	options:SetTeleportData({ TicketId = ticket.Id, Hint = true })
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(Config.Places.MatchPlaceId, players, options)
	end)
	if not ok then
		warn("[LobbyLaunch] TeleportAsync failed:", err)
		for _, p in players do
			markFailed(l, p.UserId, "Teleport failed")
		end
		return
	end
	-- Anyone still here after the watchdog was not sent (TeleportInitFailed covers loud failures).
	task.delay(Config.Teleport.SentWatchdog, function()
		if l.Gen ~= gen or launches[l.Party.Id] ~= l then
			return
		end
		for _, p in players do
			if p.Parent and not l.Away[p.UserId] and not l.Failed[p.UserId] then
				markFailed(l, p.UserId, "Timed out")
			end
		end
	end)
end

-- Starting --------------------------------------------------------------------------------------

local function releaseAll(l: Launch, uids: { number }): (boolean, string?)
	for _, uid in uids do
		local p = playerOf(uid)
		if not p then
			return false, "A party member left."
		end
		local ok, why = Profiles.releaseForTeleport(p)
		if not ok then
			return false, nameOf(uid) .. ": " .. tostring(why or "save failed")
		end
	end
	return true, nil
end

-- Saving yields: a member can leave the server (or the party) while another member's save runs, after
-- releaseAll already checked them. Re-check right before the teleport so nobody gone is marked as sent.
local function stillHere(l: Launch, uids: { number }): (boolean, string?)
	return TeleportBook.stillHere(l.Party.Members, uids, function(uid)
		return playerOf(uid) ~= nil
	end)
end

local function run(l: Launch)
	l.Phase = "Preparing"
	l.Message = "Saving and getting your hunt ready..."
	push(l)
	local party = l.Party
	if not l.Ticket then
		local okR, code, privateId = pcall(function()
			return TeleportService:ReserveServer(Config.Places.MatchPlaceId)
		end)
		if not okR or type(code) ~= "string" or type(privateId) ~= "string" then
			warn("[LobbyLaunch] ReserveServer failed:", code)
			abort(l, "Could not start the hunt. Try again in a moment.")
			return
		end
		local names = {}
		for i, uid in party.Members do
			names[i] = nameOf(uid)
		end
		local ticket, why = MatchTicket.create({
			Id = privateId,
			Leader = party.Leader,
			Members = party.Members,
			Names = names,
			Tier = party.Tier,
			Now = os.time(),
			ArriveSeconds = Config.Teleport.ArriveSeconds,
			LifetimeSeconds = Config.Teleport.TicketSeconds,
			MaxMembers = Config.Places.MatchMaxPlayers,
			LobbyJobId = game.JobId,
		})
		if not ticket then
			abort(l, "Could not set up the match (" .. tostring(why) .. ").")
			return
		end
		local stored, serr = Tickets.put(ticket)
		if not stored then
			warn("[LobbyLaunch] ticket store failed:", serr)
			abort(l, "Could not set up the match. Try again in a moment.")
			return
		end
		l.Ticket, l.Code = ticket, code
		if not alive(l) then
			return -- aborted while reserving; nothing was released yet
		end
	end
	-- Members that still need sending: everyone not already away.
	local targets: { number } = {}
	for _, uid in party.Members do
		if not l.Away[uid] then
			table.insert(targets, uid)
		end
	end
	local ok, why = releaseAll(l, targets)
	if not alive(l) then
		handBack(l, targets)
		return
	end
	if ok then
		ok, why = stillHere(l, targets)
	end
	if not ok then
		-- first attempt: nothing was sent, so stop and hand everything back
		local anySent = next(l.Away) ~= nil
		if anySent then
			for _, uid in targets do
				if not l.Failed[uid] then
					l.Failed[uid] = why or "save failed"
				end
				reacquireAsync(l, uid)
			end
			settle(l)
			push(l)
		else
			abort(l, why or "Could not save safely. Try again in a moment.")
		end
		return
	end
	teleportMembers(l, targets)
end

function LobbyLaunch.startParty(party: PartyService.Party): (boolean, string?)
	if Config.Places.MatchPlaceId == 0 then
		return false, "Match place is not set up yet."
	end
	if launches[party.Id] then
		return false, "Already launching."
	end
	for _, uid in party.Members do
		local p = playerOf(uid)
		if not p or not Profiles.isLoaded(p) then
			return false, "Waiting for every member to load."
		end
		local held = launchOf[uid]
		if held and launches[held] then
			return false, "Someone is still away from a hunt."
		elseif held then
			launchOf[uid] = nil -- left over from a launch that already ended
		end
	end
	local l: Launch = {
		Id = HttpService:GenerateGUID(false),
		Party = party,
		Ticket = nil,
		Code = nil,
		Phase = "Preparing",
		Message = "",
		Sent = {},
		Away = {},
		Failed = {},
		Retries = {},
		Reacquiring = {},
		AwayDeadline = os.clock() + Config.Teleport.AwayHoldSeconds,
		Gen = 0,
	}
	launches[party.Id] = l
	for _, uid in party.Members do
		launchOf[uid] = party.Id
	end
	PartyService.setLocked(party, true, l.Id) -- roster locked for the launch
	task.spawn(run, l)
	return true, nil
end

-- Player actions (RETRY / CANCEL) -----------------------------------------------------------------

local function onAction(player: Player, action: any)
	local pid = launchOf[player.UserId]
	local l = pid and launches[pid]
	if not l then
		return
	end
	local uid = player.UserId
	local isLeader = l.Party.Leader == uid
	if action == "Retry" then
		if l.Phase ~= "Failed" and l.Phase ~= "Partial" then
			return
		end
		local ticket = l.Ticket
		if not ticket or os.time() > ticket.ArriveBy - 10 then
			PartyService.toast(player, "That hunt spot ran out. Start again.", "warn")
			return
		end
		local targets: { number } = {}
		for fu in l.Failed do
			if (isLeader or fu == uid) and (l.Retries[fu] or 0) < Config.Teleport.MaxRetries then
				table.insert(targets, fu)
			end
		end
		if #targets == 0 then
			return
		end
		for _, fu in targets do
			l.Retries[fu] = (l.Retries[fu] or 0) + 1
			l.Failed[fu] = nil
		end
		-- Preparing right away: CANCEL is refused from here until the retry lands, so a cancel can
		-- no longer dissolve the launch while this retry goes on to release saves and teleport.
		l.Phase = "Preparing"
		l.Message = "Trying again..."
		push(l)
		task.spawn(function()
			-- let a running lock re-acquire finish before releasing again
			local t0 = os.clock()
			while os.clock() - t0 < 10 do
				local busy = false
				for _, fu in targets do
					busy = busy or l.Reacquiring[fu] == true
				end
				if not busy then
					break
				end
				task.wait(0.25)
			end
			if not alive(l) then
				return
			end
			local ok, why = releaseAll(l, targets)
			if not alive(l) then
				handBack(l, targets)
				return
			end
			if ok then
				ok, why = stillHere(l, targets)
			end
			if not ok then
				for _, fu in targets do
					l.Failed[fu] = why or "save failed"
					reacquireAsync(l, fu)
				end
				settle(l)
				push(l)
				return
			end
			teleportMembers(l, targets)
		end)
	elseif action == "Cancel" then
		if l.Phase == "Preparing" or l.Phase == "Teleporting" then
			return
		end
		if isLeader then
			-- everyone still in this lobby is free again; members already in the Match place are
			-- dropped from the party (the ticket simply runs out there)
			dissolve(l, true)
		else
			l.Failed[uid] = nil
			PartyService.leave(uid)
			launchOf[uid] = nil
			hideFor(uid)
			settle(l)
		end
	end
end

-- Teleport failures ---------------------------------------------------------------------------------

local function onInitFailed(player: Player, result: any, message: any)
	local pid = launchOf[player.UserId]
	local l = pid and launches[pid]
	if not l or not l.Sent[player.UserId] then
		return
	end
	warn("[LobbyLaunch] TeleportInitFailed", player.UserId, tostring(result), tostring(message))
	markFailed(l, player.UserId, "Teleport failed")
end

-- Members leaving / returning ----------------------------------------------------------------------

local function onRemoving(player: Player)
	local uid = player.UserId
	local pid = launchOf[uid]
	local l = pid and launches[pid]
	if not l then
		return
	end
	if l.Sent[uid] and not l.Failed[uid] and l.Phase ~= "Preparing" then
		l.Away[uid] = true
		l.Sent[uid] = nil
		settle(l)
		push(l)
	elseif l.Phase == "Preparing" then
		-- left mid-prepare (party seat is dropped by PartyService): stop and hand profiles back
		task.defer(function()
			if launches[l.Party.Id] == l then
				abort(l, nameOf(uid) .. " left. Launch cancelled.")
			end
		end)
	elseif l.Phase ~= "Teleporting" then
		-- Left a Failed / Partial / Done launch without being sent: this member is gone, not in the Match place.
		-- Forget them, and end the launch once nobody of it is left on this server and nobody is away (a launch
		-- with members away is ended by the AwayDeadline loop in start()).
		if launchOf[uid] == pid then
			launchOf[uid] = nil
		end
		task.defer(function()
			if launches[l.Party.Id] ~= l or next(l.Away) ~= nil then
				return
			end
			for _, m in l.Party.Members do
				if m ~= uid and playerOf(m) ~= nil then
					return
				end
			end
			dissolve(l, false)
		end)
	end
end

local function onAdded(player: Player)
	local uid = player.UserId
	local pid = launchOf[uid]
	local l = pid and launches[pid]
	if not l or not l.Away[uid] then
		return
	end
	l.Away[uid] = nil
	l.Sent[uid] = nil
	l.Failed[uid] = nil
	if next(l.Away) == nil then
		dissolve(l, false)
	else
		pushTo(l, uid)
	end
end

function LobbyLaunch.start()
	PartyService.onStart(LobbyLaunch.startParty)
	PartyService.setKeepOnLeave(function(uid)
		local pid = launchOf[uid]
		local l = pid and launches[pid]
		return l ~= nil and l.Phase ~= "Preparing" and (l.Sent[uid] == true or l.Away[uid] == true)
	end)
	Net.event("LaunchAction").OnServerEvent:Connect(onAction)
	TeleportService.TeleportInitFailed:Connect(onInitFailed)
	Players.PlayerRemoving:Connect(onRemoving)
	Players.PlayerAdded:Connect(onAdded)
	task.spawn(function()
		while true do
			task.wait(5)
			for _, l in table.clone(launches) do
				if os.clock() > l.AwayDeadline and next(l.Away) ~= nil then
					dissolve(l, true) -- the party never came back: free everyone left here
				end
			end
		end
	end)
end

return LobbyLaunch
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="236">
        <Properties>
          <string name="Name">LodgeBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Park stalls (dino-jungle pet park, owner picks 2026-10-10): the counters around the open spawn plaza, built from
-- the uploaded lodge kit (ReplicatedStorage.Assets.Kit via MeshService) where it fits and Parts elsewhere. The old
-- Prospector Lodge hall (building, hunt bays, wall pockets, chandelier) is gone; LobbyBuilder / ParkBuilder build the
-- park around these stalls. Each builder takes a WORLD frame `cf` whose kit front (-Z) faces the plaza.
--
-- What each destination keeps (contracts grepped before this change, docs/lodge/INTEGRATION.md):
--   UPGRADES    Part `Counter` + prompt (Panel "Shop"); model CT_Rocks_UpgradePedestal with PreviewAnchor /
--               PreviewLabel on the counter (src/client/UpgradePreview.luau draws the selected item, per player)
--   PET BOOK    Part `Counter` + prompt (Panel "Collection"); three decorative EXAMPLE pets (tagged Decorative, no Id,
--               in no profile) on the counter pedestals
--   SELL CANDY  Model attribute Hopper, part `Body` with ProximityPrompt `SellPrompt` (attribute Sell) = the one
--               EconomyService sell endpoint
--   EGG SHOP    Part `Counter` with a DISABLED prompt (attribute ShopHook "EggShop"): what it sells is still being
--               decided with the owner, so nothing is wired (no price, no purchase); an egg display shelf inside
--   BOARDS      BoardMounts/Mount_<id> (attribute Bare): LobbyBoards puts the live SurfaceGui rows of
--               LeaderboardService on them; the headings are fitted signs
-- Kit meshes never collide (MeshService); every solid thing has an invisible box collider. Every kit asset has a
-- Part stand-in (REPLACE marker) used when its mesh did not load.

local Workspace = game:GetService("Workspace")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local GeodeModel = require(Shared.GeodeModel)
local MeshCatalog = require(Shared.MeshCatalog)
local MapNames = require(Shared.MapNames)
local Kit = require(script.Parent.KitParts)
local KitPlace = require(script.Parent.KitPlace)

local part, deco, model = Kit.part, Kit.deco, Kit.model
local M = Enum.Material

local LodgeBuilder = {}

LodgeBuilder.FLOOR_Y = Config.Lodge.FloorY -- the park ground top (world y)
LodgeBuilder.Interior = Config.Lodge -- the walkable park box (lobby camera box, spawn check)

-- Palette: warm timber, stone, the park's teal and orange accents
local C = {
	Wood = Color3.fromRGB(176, 112, 64),
	WoodDark = Color3.fromRGB(116, 74, 44),
	WoodLight = Color3.fromRGB(214, 156, 98),
	Plaster = Color3.fromRGB(236, 220, 190),
	Stone = Color3.fromRGB(176, 164, 144),
	Charcoal = Color3.fromRGB(70, 60, 56),
	Gold = Color3.fromRGB(250, 204, 84),
	AwningCream = Color3.fromRGB(246, 230, 196),
	AwningOrange = Color3.fromRGB(236, 128, 44),
	AwningTeal = Color3.fromRGB(32, 150, 140),
	Ink = Color3.fromRGB(255, 240, 208),
	InkDark = Color3.fromRGB(44, 46, 52),
	LightWarm = Color3.fromRGB(255, 200, 140),
	LightDay = Color3.fromRGB(255, 246, 232),
	Leaf = Color3.fromRGB(70, 132, 48),
}

local function catalogAttach(name: string, point: string): Vector3?
	local e = (MeshCatalog :: any)[name]
	local p = e and e.Attach and e.Attach[point]
	if p then
		return Vector3.new(p[1], p[2], p[3])
	end
	return nil
end

-- Test hook: the `lodge-fallback` preview check sets this Workspace attribute before boot to build every Part stand-in.
local function kitAllowed(): boolean
	return Workspace:GetAttribute("LodgeFallbackTest") ~= true
end

-- One invisible collider box in an asset's frame (`cf` = the asset's placed frame, offset / size in its model space).
local function collider(parent: Instance, cf: CFrame, size: Vector3, offset: Vector3, name: string?): Part
	return KitPlace.blocker(parent, cf * CFrame.new(offset), size, name or "Collider")
end

-- A generic Part stand-in from the catalog bounds and first piece colour (REPLACE: the kit mesh goes here).
local function boundsBox(parent: Instance, name: string, cf: CFrame, color: Color3?): BasePart?
	local e = (MeshCatalog :: any)[name]
	if not e then
		return nil
	end
	local lo, hi = e.Bounds[1], e.Bounds[2]
	local size = Vector3.new(hi[1] - lo[1], hi[2] - lo[2], hi[3] - lo[3])
	local centre = Vector3.new((hi[1] + lo[1]) / 2, (hi[2] + lo[2]) / 2, (hi[3] + lo[3]) / 2)
	local p0 = e.Pieces[1]
	local mat = (Enum.Material :: any)[p0.Material] or M.SmoothPlastic
	return deco(part(parent, "StandIn", size, cf * CFrame.new(centre), color or p0.Color, mat))
end

-- Places kit asset `name` at `cf` in its own model (name `id`). The kit clone when loaded, else `fallback(m, cf)`
-- (or a bounds box). Returns the model and whether the kit mesh is used.
local function asset(parent: Instance, id: string, name: string, cf: CFrame, fallback: ((Model, CFrame) -> ())?): (Model, boolean)
	local m = if kitAllowed() then KitPlace.place(parent, name, cf, 1, "CT_Rocks_" .. id) else nil
	if m then
		return m, true
	end
	local s = model(parent, "CT_Rocks_" .. id)
	s:SetAttribute("StandIn", name) -- REPLACE: kit mesh `name` did not load
	if fallback then
		fallback(s, cf)
	else
		boundsBox(s, name, cf)
	end
	return s, false
end
LodgeBuilder.asset = asset

-- Items resting on an assembly share a MountGroup (the placement audit treats them as mounted, not clipping).
local function mountGroup(m: Instance, group: string)
	m:SetAttribute("MountGroup", group)
end

-- Fitted sign text on a kit face. `faceCF` = the asset frame, `attach` = the face's front centre in model space; kit
-- faces look toward model -Z. The text part stands 0.05 studs in front of the face and is turned half a turn so its
-- SurfaceGui (Face = Back = +Z) looks out of the face. Landmark and Heading signs: bold white with a black outline.
local function faceText(parent: Instance, name: string, faceCF: CFrame, attach: Vector3, W: number, H: number, text: string, preset: string, ink: Color3?, backing: Color3?): (Part, TextLabel)
	local cf = faceCF * CFrame.new(attach + Vector3.new(0, 0, -0.05)) * CFrame.Angles(0, math.pi, 0)
	local landmark = preset == "Landmark" or preset == "Heading"
	local p, t = KitPlace.signText(parent, name, cf, W, H, text, preset, ink or C.Ink, backing, landmark)
	return p, t
end

-- A small invisible light anchor (the kit lantern is the fixture).
local function lightAt(parent: Instance, pos: Vector3, brightness: number, range: number, color: Color3?): PointLight
	local a = deco(part(parent, "Light", Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), C.Charcoal, M.SmoothPlastic))
	a.Transparency = 1
	a.CastShadow = false
	return Kit.light(a, "PointLight", color or C.LightWarm, brightness, range) :: PointLight
end

local function prompt(p: BasePart, action: string, object: string, panel: string, range: number): ProximityPrompt
	local pp = Kit.prompt(p, action, object, panel, range)
	pp.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	return pp
end

-- Stall stand-in (REPLACE): counter, back panel, striped awning slab, sign board.
local function stallStandIn(stripe: Color3): (Model, CFrame) -> ()
	return function(s: Model, f: CFrame)
		part(s, "CounterBody", Vector3.new(24, 3.8, 5.5), f * CFrame.new(0, 1.9, -1.25), C.Wood, M.WoodPlanks).CanCollide = false
		part(s, "Countertop", Vector3.new(24.4, 0.25, 5.9), f * CFrame.new(0, 3.9, -1.25), C.WoodLight, M.Wood).CanCollide = false
		part(s, "BackPanel", Vector3.new(24, 12.7, 0.6), f * CFrame.new(0, 6.35, 3.6), C.Plaster, M.SmoothPlastic).CanCollide = false
		for i = 0, 10 do
			local p = part(s, "Awning", Vector3.new(25 / 11, 0.3, 7.2), f * CFrame.new(-12.5 + (i + 0.5) * 25 / 11, 11.5, 0.4) * CFrame.Angles(math.rad(-16), 0, 0), if i % 2 == 0 then stripe else C.AwningCream, M.Fabric)
			deco(p)
		end
		part(s, "SignFrame", Vector3.new(12, 3, 0.3), f * CFrame.new(0, 11.25, -4.0), C.WoodDark, M.Wood).CanCollide = false
	end
end

-- Kit awnings come in the lodge's red / purple; the park tones them to its orange / teal.
local function toneAwning(m: Model, stripe: Color3)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and (string.find(d.Name, "Awning", 1, true) or string.find(d.Name, "Canopy", 1, true)) then
			local h, sat, v = d.Color:ToHSV()
			if sat > 0.25 and v > 0.4 and (h < 0.08 or h > 0.7) then
				d.Color = stripe
			end
		end
	end
end

-- UPGRADES: counter -> Shop panel; the preview pedestal on the counter; cashbox, basket, lantern, runner.
function LodgeBuilder.buildUpgrades(root: Instance, lights: Instance, cf: CFrame)
	local g = Kit.folder(root, "CT_Rocks_Upgrades")
	local stall = asset(g, "Upgrades_Stall", "Lodge_UpgradesStall", cf, stallStandIn(C.AwningOrange))
	toneAwning(stall, C.AwningOrange)
	mountGroup(stall, "Upgrades")
	KitPlace.cameraIgnore(stall)
	local counter = collider(g, cf, Vector3.new(24, 4, 5.5), Vector3.new(0, 2, -1.25), "Counter")
	counter.CanQuery = true
	prompt(counter, "Browse equipment", "Upgrades", "Shop", 12)
	collider(g, cf, Vector3.new(24, 12.7, 1.2), Vector3.new(0, 6.35, 3.6), "StallBack")
	faceText(stall, "Title", cf, catalogAttach("Lodge_UpgradesStall", "SignFace") or Vector3.new(0, 11.25, -4.16), 11.5, 2.5, "UPGRADES", "Landmark")
	for _, d in { { "Upgrades_Cashbox", "Lodge_Cashbox", "Cashbox" }, { "Upgrades_Basket", "Lodge_RockBasket", "Basket" }, { "Upgrades_Lantern", "Lodge_Lantern", "Lantern" }, { "Upgrade_Runner", "Lodge_RunnerRug", "Runner" } } do
		local p = catalogAttach("Lodge_UpgradesStall", d[3])
		if p then
			local m = asset(g, d[1], d[2], cf * CFrame.new(p) + (if d[3] == "Runner" then Vector3.new(0, 0.03, 0) else Vector3.zero))
			mountGroup(m, "Upgrades")
			KitPlace.cameraIgnore(m)
			if d[3] == "Lantern" then
				lightAt(lights, (cf * CFrame.new(p + Vector3.new(0, 0.66, 0))).Position, 0.8, 12)
			end
		end
	end
	-- The ONE preview pedestal on the counter (UpgradePreview shows the selected tool on PreviewAnchor, client-only).
	local pm = model(g, "CT_Rocks_UpgradePedestal")
	pm:SetAttribute("UpgradePedestal", true)
	mountGroup(pm, "Upgrades")
	local pcf = cf * CFrame.new(5.2, 4, -1.7)
	local ped = asset(pm, "UpgradePreviewStand", "Lodge_SpecimenPedestal", pcf)
	mountGroup(ped, "Upgrades")
	local top = catalogAttach("Lodge_SpecimenPedestal", "Specimen") or Vector3.new(0, 1.2, 0)
	local anchor = deco(part(pm, "PreviewAnchor", Vector3.new(0.4, 0.1, 0.4), pcf * CFrame.new(top + Vector3.new(0, 0.05, 0)), C.Gold, M.SmoothPlastic))
	anchor.Transparency = 1
	anchor:SetAttribute("PreviewAnchor", true)
	anchor:SetAttribute("PreviewHeight", 2.6) -- normalised model height the client scales to (studs)
	local label = KitPlace.signText(pm, "PreviewLabel", pcf * CFrame.new(0, 0.6, -1.4) * CFrame.Angles(0, math.pi, 0), 2.3, 0.45, "PREVIEW", "Plaque", C.InkDark, C.AwningCream)
	label.Name = "PreviewLabel"
	KitPlace.cameraIgnore(pm)
end

-- PET BOOK: counter -> Collection panel; three EXAMPLE pets on the pedestals.
local EXAMPLES: { { any } } = { { "Raptor", 11 }, { "Griffin", 35 }, { "Phoenix", 23 } }

local function examplePet(parent: Instance, cf: CFrame, i: number): Model?
	local ex = EXAMPLES[i]
	local ok, g = pcall(GeodeModel.example, ex[1], ex[2], { Scale = 0.7, Lod = true, NoLight = true })
	if not ok or not g then
		return nil
	end
	g.Name = "CT_Rocks_DisplayExample"
	g:SetAttribute("Decorative", true) -- made up: no Id, in no profile, never a reward
	g:PivotTo(cf) -- pets face -Z, the kit front: toward the plaza
	g.Parent = parent
	for _, d in g:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	KitPlace.cameraIgnore(g)
	return g
end

function LodgeBuilder.buildCollection(root: Instance, lights: Instance, cf: CFrame)
	local g = Kit.folder(root, "CT_Rocks_Collection")
	local stall = asset(g, "Collection_Stall", "Lodge_CollectionStall", cf, stallStandIn(C.AwningTeal))
	toneAwning(stall, C.AwningTeal)
	mountGroup(stall, "Collection")
	KitPlace.cameraIgnore(stall)
	local counter = collider(g, cf, Vector3.new(24, 4, 5.5), Vector3.new(0, 2, -1.25), "Counter")
	counter.CanQuery = true
	prompt(counter, "Open Pet Book", "Pet Book", "Collection", 12)
	collider(g, cf, Vector3.new(24, 12.7, 1.2), Vector3.new(0, 6.35, 3.6), "StallBack")
	faceText(stall, "Title", cf, catalogAttach("Lodge_CollectionStall", "SignFace") or Vector3.new(0, 11.25, -4.16), 11.5, 2.5, "PET BOOK", "Landmark")
	faceText(g, "ExamplesPlaque", cf, Vector3.new(0, 8.55, 2.95), 7.0, 0.8, "EXAMPLE PETS", "Plaque", C.Ink, C.WoodDark)
	for _, d in stall:GetDescendants() do
		if d:IsA("BasePart") and d.Name == "Glass" then
			d.Transparency = 0.86
			d.Color = Color3.fromRGB(232, 240, 242)
		end
	end
	for i = 1, 3 do
		local p = catalogAttach("Lodge_CollectionStall", "Specimen" .. i)
		if p then
			local pedCF = cf * CFrame.new(p)
			local ped = asset(g, "Collection_Pedestal" .. i, "Lodge_SpecimenPedestal", pedCF)
			mountGroup(ped, "Collection")
			KitPlace.cameraIgnore(ped)
			local top = catalogAttach("Lodge_SpecimenPedestal", "Specimen") or Vector3.new(0, 1.2, 0)
			local pet = examplePet(g, pedCF * CFrame.new(top), i)
			if pet then
				mountGroup(pet, "Collection")
			end
		end
	end
	local lp = catalogAttach("Lodge_CollectionStall", "Lantern")
	if lp then
		local m = asset(g, "Collection_Lantern", "Lodge_Lantern", cf * CFrame.new(lp))
		mountGroup(m, "Collection")
		KitPlace.cameraIgnore(m)
		lightAt(lights, (cf * CFrame.new(lp + Vector3.new(0, 0.66, 0))).Position, 0.8, 12)
	end
end

-- SELL CANDY: the kit counter is the seller (same Hopper / Body / SellPrompt contract as before).
function LodgeBuilder.buildSeller(root: Instance, lights: Instance, cf: CFrame)
	local m = asset(root, "SellHopper", "Lodge_RubbleSell", cf, function(s, f)
		part(s, "Counter", Vector3.new(7, 3.6, 3), f * CFrame.new(0, 1.8, -0.55), C.Wood, M.WoodPlanks).CanCollide = false
		part(s, "Back", Vector3.new(7, 10, 0.8), f * CFrame.new(0, 5, 1.6), C.WoodDark, M.Wood).CanCollide = false
		part(s, "SignBoard", Vector3.new(5.6, 2.6, 0.3), f * CFrame.new(0, 8.2, 1.2), C.WoodDark, M.Wood).CanCollide = false
	end)
	m:SetAttribute("Hopper", true)
	mountGroup(m, "Seller")
	KitPlace.cameraIgnore(m)
	local body = collider(m, cf, Vector3.new(7, 3.6, 3), Vector3.new(0, 1.8, -0.55), "Body")
	collider(m, cf, Vector3.new(7, 10, 0.8), Vector3.new(0, 5, 1.6), "SellerBack")
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "SellPrompt"
	pp.ActionText = "Sell Candy"
	pp.ObjectText = "Candy stand"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R -- E is the crack key on keyboards
	pp.UIOffset = Vector2.new(0, 30)
	pp.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	pp:SetAttribute("Sell", true)
	pp.Parent = body
	faceText(m, "SellSign", cf, catalogAttach("Lodge_RubbleSell", "SignFace") or Vector3.new(0, 8.2, 1.16), 5.3, 2.3, "SELL CANDY", "Landmark")
	for _, d in { { "Rubble_Basket", "Lodge_RockBasket", "Basket" }, { "Rubble_Lantern", "Lodge_Lantern", "Lantern" } } do
		local p = catalogAttach("Lodge_RubbleSell", d[3])
		if p then
			local k = asset(root, d[1], d[2], cf * CFrame.new(p))
			mountGroup(k, "Seller")
			KitPlace.cameraIgnore(k)
			if d[3] == "Lantern" then
				lightAt(lights, (cf * CFrame.new(p + Vector3.new(0, 0.66, 0))).Position, 0.7, 11)
			end
		end
	end
	-- a striped jungle awning on two poles over the small counter, so it reads as a stall from the plaza
	local aw = model(root, "CT_Rocks_SellAwning")
	mountGroup(aw, "Seller")
	for _, x in { -4.4, 4.4 } do
		part(aw, "Pole", Vector3.new(0.5, 9, 0.5), cf * CFrame.new(x, 4.5, -3.4), C.WoodDark, M.Wood)
	end
	for i = 0, 5 do
		deco(part(aw, "Awning", Vector3.new(9.6 / 6, 0.25, 5), cf * CFrame.new(-4.8 + (i + 0.5) * 1.6, 9.1, -1.2) * CFrame.Angles(math.rad(-14), 0, 0), if i % 2 == 0 then C.AwningOrange else C.AwningCream, M.Fabric))
	end
	KitPlace.cameraIgnore(aw)
end

-- EGG SHOP: a timber jungle hut at the north end of the main path (Parts, REPLACE: real mesh) with an egg display
-- shelf behind the counter (procedural eggs, REPLACE: real egg meshes). What it sells is still being decided with the
-- owner, so NOTHING is wired: the counter carries a DISABLED ProximityPrompt (attribute ShopHook = "EggShop") for the
-- shop code to enable later, no price, no purchase, and a COMING SOON plaque says so.
local EGG_TINTS = {
	Color3.fromRGB(255, 214, 64), Color3.fromRGB(80, 190, 255), Color3.fromRGB(255, 110, 206), Color3.fromRGB(110, 232, 110),
	Color3.fromRGB(255, 140, 50), Color3.fromRGB(170, 120, 255),
}
local function egg(parent: Instance, cf: CFrame, h: number, tint: Color3)
	local body = Instance.new("Part")
	body.Name = "Egg" -- REPLACE: real egg mesh
	body.Size = Vector3.new(h * 0.76, h, h * 0.76)
	body.CFrame = cf * CFrame.new(0, h / 2, 0)
	body.Color = tint
	body.Material = M.SmoothPlastic
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CanTouch = false
	local sm = Instance.new("SpecialMesh")
	sm.MeshType = Enum.MeshType.Sphere
	sm.Parent = body
	body.Parent = parent
	local spot = deco(part(parent, "EggSpot", Vector3.new(h * 0.3, h * 0.24, 0.1), cf * CFrame.new(0, h * 0.62, -h * 0.37), tint:Lerp(Color3.new(1, 1, 1), 0.55), M.SmoothPlastic))
	spot.CastShadow = false
end

function LodgeBuilder.buildEggShop(root: Instance, lights: Instance, cf: CFrame)
	local g = model(root, MapNames.EggShop)
	mountGroup(g, "EggShop")
	local W, D, H = 18, 10, 8.5
	-- the owner's Meshy hut (ServerStorage.MeshyAssets.MeshyEggShop) when present: it replaces the deck, walls, posts
	-- and roof (invisible blockers keep the walls solid); the shelf, counter, eggs and sign below stay either way
	local hut = KitPlace.meshy("MeshyEggShop", cf * CFrame.new(0, (H + 5.5) / 2, 0.5) * CFrame.Angles(0, math.pi, 0), Vector3.new(W + 1, H + 5.5, D + 3.6))
	if hut then
		hut.Name = "HutMesh"
		hut.Parent = g
		KitPlace.blocker(g, cf * CFrame.new(0, 0.6 + H / 2, D / 2 + 0.7), Vector3.new(W, H, 0.6), "WallBackBlock")
		for _, sx in { -1, 1 } do
			KitPlace.blocker(g, cf * CFrame.new(sx * (W / 2 - 0.3), 0.6 + H / 2, 0.7), Vector3.new(0.6, H, D), "WallSideBlock")
		end
	else
	-- floor deck, back and side walls (solid), corner posts, a pitched roof with an orange ridge
	part(g, "Deck", Vector3.new(W + 1, 0.6, D + 1), cf * CFrame.new(0, 0.3, 0.5), C.WoodDark, M.WoodPlanks)
	part(g, "WallBack", Vector3.new(W, H, 0.6), cf * CFrame.new(0, 0.6 + H / 2, D / 2 + 0.7), C.Wood, M.WoodPlanks)
	for _, sx in { -1, 1 } do
		part(g, "WallSide", Vector3.new(0.6, H, D), cf * CFrame.new(sx * (W / 2 - 0.3), 0.6 + H / 2, 0.7), C.Wood, M.WoodPlanks)
		for _, z in { -D / 2 + 0.7, D / 2 + 0.7 } do
			part(g, "Post", Vector3.new(1.1, H + 1.4, 1.1), cf * CFrame.new(sx * (W / 2), 0.6 + (H + 1.4) / 2, z), C.WoodDark, M.Wood)
		end
		deco(part(g, "Roof", Vector3.new(W / 2 + 1.8, 0.7, D + 3.6), cf * CFrame.new(sx * (W / 4 + 0.2), H + 2.9, 0.5) * CFrame.Angles(0, 0, -sx * math.rad(24)), C.AwningTeal, M.WoodPlanks))
	end
	deco(part(g, "Ridge", Vector3.new(1.3, 0.9, D + 3.8), cf * CFrame.new(0, H + 4.9, 0.5), C.AwningOrange, M.Wood))
	end
	-- the egg display shelf on the back wall: three tiers of procedural eggs (REPLACE: real egg meshes)
	for tier = 0, 2 do
		local y = 0.6 + 1.6 + tier * 2.0
		part(g, "Shelf", Vector3.new(W - 3, 0.3, 1.6), cf * CFrame.new(0, y, D / 2 - 0.4), C.WoodLight, M.Wood).CanCollide = false
		for k = 0, 5 do
			local x = -6.25 + k * 2.5
			egg(g, cf * CFrame.new(x, y + 0.15, D / 2 - 0.4), 1.25 + ((k + tier) % 2) * 0.2, EGG_TINTS[(k + tier * 2) % #EGG_TINTS + 1])
		end
	end
	-- the counter across the open front (the hook part for the future shop) and a big nest of eggs on it
	part(g, "CounterBody", Vector3.new(W - 4, 3.4, 1.8), cf * CFrame.new(0, 0.6 + 1.7, -D / 2 + 1.4), C.WoodLight, M.WoodPlanks).CanCollide = false
	local counter = collider(g, cf, Vector3.new(W - 4, 3.9, 2), Vector3.new(0, 0.6 + 1.95, -D / 2 + 1.4), "Counter")
	counter.CanQuery = true
	local pp = Kit.prompt(counter, "Egg Shop", "Coming soon", "", 12)
	pp.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	pp.Enabled = false -- nothing is for sale yet: the shop code enables this once the owner decides what it sells
	pp:SetAttribute("ShopHook", "EggShop")
	deco(part(g, "Countertop", Vector3.new(W - 3.6, 0.3, 2.3), cf * CFrame.new(0, 0.6 + 3.55, -D / 2 + 1.4), C.WoodDark, M.Wood))
	for k = 0, 2 do
		egg(g, cf * CFrame.new(-2.2 + k * 2.2, 0.6 + 3.7, -D / 2 + 1.4), 1.5, EGG_TINTS[k * 2 + 1])
	end
	-- the sign over the front and a COMING SOON plaque on the counter front
	local signCF = cf * CFrame.new(0, H + 2.4, -D / 2 - 1.3) * CFrame.Angles(0, math.pi, 0) * CFrame.Angles(math.rad(-8), 0, 0)
	KitPlace.signBoard(g, "ShopSign", signCF, 10, 2.4, "EGG SHOP", "Landmark", { Face = C.WoodDark, Frame = C.Wood, Trim = Color3.fromRGB(250, 204, 84), Outline = true })
	KitPlace.signText(g, "SoonPlaque", cf * CFrame.new(0, 0.6 + 1.9, -D / 2 + 0.45) * CFrame.Angles(0, math.pi, 0), 6, 1, "COMING SOON", "Plaque", C.Ink, C.WoodDark)
	lightAt(lights, (cf * CFrame.new(0, H - 1, 0.5)).Position, 0.9, 18)
	for _, d in g:GetDescendants() do
		if d:IsA("BasePart") and (d.Name == "Roof" or d.Name == "Ridge") then
			d:SetAttribute("CameraIgnore", true)
		end
	end
end

-- BOARDS: kit frames; the live rows are LobbyBoards' SurfaceGui on Mount_<id>, the heading a fitted sign.
local function boardStandIn(s: Model, f: CFrame)
	part(s, "Frame", Vector3.new(13.4, 13.2, 1.2), f * CFrame.new(0, 8.9, 0.4), C.Wood, M.Wood).CanCollide = false
	part(s, "BoardFace", Vector3.new(11.5, 11.1, 0.2), f * CFrame.new(0, 9.05, -0.2), C.Charcoal, M.SmoothPlastic).CanCollide = false
	for _, x in { -6, 6 } do
		part(s, "Foot", Vector3.new(0.8, 3.4, 2.4), f * CFrame.new(x, 1.7, 0.2), C.WoodDark, M.Wood).CanCollide = false
	end
end

local HEAD_H = 2.0 -- heading band height (studs) at the top of each board face

-- boards = { { Id, Heading, CFrame (kit front -Z toward the viewer) } }; BoardMounts goes straight under `root`.
function LodgeBuilder.buildBoards(root: Instance, lights: Instance, boards: { { any } })
	local g = Kit.folder(root, "CT_Rocks_Boards")
	local mounts = Kit.folder(root, "BoardMounts")
	for _, b in boards do
		local id, heading, cf = b[1] :: string, b[2] :: string, b[3] :: CFrame
		local m = asset(g, "Leaderboard_" .. id, "Lodge_Leaderboard", cf, boardStandIn)
		mountGroup(m, "Board" .. id)
		KitPlace.cameraIgnore(m)
		collider(g, cf, Vector3.new(13.2, 15, 2.5), Vector3.new(0, 7.5, 0.15), "BoardBody")
		local face = catalogAttach("Lodge_Leaderboard", "BoardFace") or Vector3.new(0, 9.05, -0.1)
		local headTop = face.Y + 11.1 / 2 - 0.15
		local headY = headTop - HEAD_H / 2
		faceText(m, "Heading", cf, Vector3.new(0, headY, face.Z), 10.8, HEAD_H, heading, "Heading")
		local rowsTop = headTop - HEAD_H - 0.1
		local rowsBottom = face.Y - 11.1 / 2 + 0.25
		local mount = part(mounts, "Mount_" .. id, Vector3.new(11.0, rowsTop - rowsBottom, 0.05), cf * CFrame.new(0, (rowsTop + rowsBottom) / 2, face.Z - 0.06) * CFrame.Angles(0, math.pi, 0), C.Charcoal, M.SmoothPlastic)
		mount.Transparency = 1
		mount.CanCollide = false
		mount.CanQuery = false
		mount.CanTouch = false
		mount.CastShadow = false
		mount:SetAttribute("Bare", true) -- LobbyBoards: draw the rows straight onto this mount (dark theme, five rows)
		local tp = catalogAttach("Lodge_Leaderboard", "Trophy")
		if tp then
			local t = asset(g, id .. "_Trophy", "Lodge_TrophyEmblem", cf * CFrame.new(tp))
			mountGroup(t, "Board" .. id)
			KitPlace.cameraIgnore(t)
		end
	end
end

return LodgeBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="237">
        <Properties>
          <string name="Name">LowPolyStation</string>
          <string name="Source"><![CDATA[--!strict
-- The owner's low-poly station kit (IMPORT_NOW2/StationKit_LowPoly.fbx, imported into ServerStorage.StationKit_LowPoly):
-- the carried basket and the three tappers become kit templates in ReplicatedStorage.Assets.Kit (the same names
-- MeshService builds from the uploaded meshes, so CarryView and the tool code pick them up unchanged), and
-- StationModels asks `nestPieces` for the straw nest. Untextured meshes: colours and materials are set here.
-- Without the imported kit everything stays as it was.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local LowPolyStation = {}

local WOOD = Color3.fromRGB(196, 140, 86)
local WOOD_DARK = Color3.fromRGB(150, 98, 56)
local STRAW = Color3.fromRGB(240, 204, 120)

local function kit(): Instance?
	return ServerStorage:FindFirstChild("StationKit_LowPoly")
end

-- Kit pieces as unparented copies in studs. An import that came in centimetre-sized (a 190-stud tapper handle)
-- is scaled down 100x, positions included, so the pieces keep their layout.
local function pieces(names: { string }): { [string]: MeshPart }
	local out: { [string]: MeshPart } = {}
	local k = kit()
	if k then
		for _, d in k:GetDescendants() do
			if d:IsA("MeshPart") then
				local base = string.gsub(d.Name, "%.%d+$", "")
				if table.find(names, base) and not out[base] then
					out[base] = d
				end
			end
		end
	end
	local big = 0
	for _, p in out do
		big = math.max(big, p.Size.X, p.Size.Y, p.Size.Z)
	end
	local u = if big > 40 then 0.01 else 1
	for name, src in out do
		local p = src:Clone()
		p.Size = src.Size * u
		p.CFrame = CFrame.new(src.Position * u) * src.CFrame.Rotation
		out[name] = p
	end
	return out
end

-- Rescales a group of pieces about the import origin so its size along `axis` is `want` studs (the size of the
-- uploaded mesh it stands in for, so the tool fit and the carry spots keep working).
local function fit(parts: { [string]: MeshPart }, axis: string, want: number)
	local lo, hi = math.huge, -math.huge
	for _, p in parts do
		local c, h = (p.Position :: any)[axis], (p.Size :: any)[axis] / 2
		lo = math.min(lo, c - h)
		hi = math.max(hi, c + h)
	end
	local k = want / math.max(hi - lo, 0.01)
	for _, p in parts do
		p.Size *= k
		p.CFrame = CFrame.new(p.Position * k) * p.CFrame.Rotation
	end
end

-- bottom centre of a group of parts (world space of the import)
local function baseOf(parts: { [string]: MeshPart }): Vector3
	local lo = Vector3.new(math.huge, math.huge, math.huge)
	local hi = -lo
	for _, p in parts do
		local h = p.Size / 2
		lo = lo:Min(p.Position - h)
		hi = hi:Max(p.Position + h)
	end
	return Vector3.new((lo.X + hi.X) / 2, lo.Y, (lo.Z + hi.Z) / 2)
end

local function template(name: string, parts: { [string]: MeshPart }, look: { [string]: { Color3 | Enum.Material } }, attach: { [string]: Vector3 }): Model
	local origin = baseOf(parts)
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new()
	root.Parent = model
	for point, at in attach do
		local a = Instance.new("Attachment")
		a.Name = point
		a.Position = at
		a.Parent = root
	end
	for pieceName, src in parts do
		local p = src:Clone()
		for _, c in p:GetChildren() do
			c:Destroy()
		end
		p.Name = pieceName
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CFrame = CFrame.new(src.Position - origin) * src.CFrame.Rotation
		local l = look[pieceName]
		if l then
			p.Color = l[1] :: Color3
			p.Material = l[2] :: Enum.Material
		end
		p.Parent = model
	end
	model.PrimaryPart = root
	model.WorldPivot = CFrame.new()
	model:SetAttribute("Ready", true)
	model:SetAttribute("LowPoly", true)
	return model
end

-- Builds the basket and tapper templates over MeshService's. Call after MeshService.start().
function LowPolyStation.apply()
	if not kit() then
		return
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets") or Instance.new("Folder")
	assets.Name = "Assets"
	assets.Parent = ReplicatedStorage
	local kitFolder = assets:FindFirstChild("Kit") or Instance.new("Folder")
	kitFolder.Name = "Kit"
	kitFolder.Parent = assets
	local function put(m: Model)
		local old = kitFolder:FindFirstChild(m.Name)
		if old then
			old:Destroy()
		end
		m.Parent = kitFolder
	end

	local basket = pieces({ "Basket_Body", "Basket_Rim", "Basket_Handle" })
	if basket.Basket_Body then
		fit(basket, "X", 2.37)
		local h = 0
		for _, p in basket do
			h = math.max(h, p.Position.Y + p.Size.Y / 2 - baseOf(basket).Y)
		end
		put(template("Basket_Empty", basket, {
			Basket_Body = { WOOD, Enum.Material.Wood },
			Basket_Rim = { WOOD_DARK, Enum.Material.Wood },
			Basket_Handle = { WOOD_DARK, Enum.Material.Wood },
		}, { Grip = Vector3.new(0, h * 0.95, 0) }))
	end

	local tapper = pieces({ "Tapper_Handle", "Tapper_Head", "Tapper_Band" })
	local head = tapper.Tapper_Head
	if head and tapper.Tapper_Handle then
		fit(tapper, "Y", 4.39)
		local origin = baseOf(tapper)
		local hc = head.Position - origin
		local strike = Vector3.new(hc.X - head.Size.X / 2, hc.Y, hc.Z)
		-- Wooden Mallet, Golden Mallet, Rainbow Tapper (the kit names the tool code maps them to)
		local looks: { [string]: { any } } = {
			Tool_StarterHammer = { WOOD_DARK, Enum.Material.Wood },
			Tool_SteelHammer = { Color3.fromRGB(255, 200, 60), Enum.Material.Metal },
			Tool_Jackhammer = { Color3.fromRGB(255, 120, 200), Enum.Material.Neon },
		}
		for name, headLook in looks do
			put(template(name, tapper, {
				Tapper_Handle = { WOOD, Enum.Material.Wood },
				Tapper_Head = headLook,
				Tapper_Band = { Color3.fromRGB(244, 190, 67), Enum.Material.SmoothPlastic },
			}, { Grip = Vector3.zero, Strike = strike }))
		end
	end
end

-- The low-poly nest for a station plate: { base, straw } MeshParts (clones, unparented) or nil without the kit.
function LowPolyStation.nestPieces(): (MeshPart?, MeshPart?)
	local n = pieces({ "Station_NestBase", "Station_NestStraw" })
	local base = n.Station_NestBase
	local straw = n.Station_NestStraw
	if not (base and straw) then
		return nil, nil
	end
	local b, s = base:Clone(), straw:Clone()
	for _, p in { b, s } do
		for _, c in p:GetChildren() do
			c:Destroy()
		end
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
	end
	b.Color = Color3.fromRGB(240, 208, 124)
	b.Material = Enum.Material.SmoothPlastic
	s.Color = STRAW
	s.Material = Enum.Material.SmoothPlastic
	return b, s
end

return LowPolyStation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="238">
        <Properties>
          <string name="Name">MachineModels</string>
          <string name="Source"><![CDATA[--!strict
-- Procedural machine models for the arena bays: cute pastel egg-cracking gadgets (peach / lavender / mint paint; the
-- shapes and motion roles are the old crusher machines). Original note: (orange / slate industrial style, see
-- docs/refs/02_tools_machines.png). Everything is anchored parts; the moving bits are animated on
-- each client by src/client/MachineView.luau, found through attributes:
--   Role = Belt | Spin | Jaw | Plate | Piston | Light | Beacon | Dust   (Dir = +1 / -1, Order = n)
-- Moving parts never collide and never answer queries (collision-safe animation): only the frame,
-- housing and base can be bumped, and they never move. Bay-local axes: -Z faces the pile (intake),
-- +Z is the outlet, the pad top is y = 0.
-- REPLACE: swap these builders for uploaded meshes (CT_Rocks_Machine_<Id>) once art exists.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local KitModels = require(Shared.KitModels)
local KitPlace = require(script.Parent.KitPlace)
local GearKit = require(Shared.GearKit)

local P = Config.Palette
local ORANGE = Color3.fromRGB(255, 160, 150) -- peach pink
local SLATE = Color3.fromRGB(176, 158, 214) -- lavender
local SLATEL = Color3.fromRGB(206, 232, 214) -- mint
local YELLOW = Color3.fromRGB(255, 218, 110)
local CREAM = P.Cream
local DARK = Color3.fromRGB(150, 118, 150)
local STEEL = Color3.fromRGB(252, 244, 232)
local BELT = Color3.fromRGB(190, 170, 226)
local NEON_OFF = Color3.fromRGB(92, 98, 106)

local MachineModels = {}

local function mk(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, solid: boolean?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Shape = shape or Enum.PartType.Block
	p.Anchored = true
	p.CanCollide = solid == true
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function cyl(parent: Instance, name: string, length: number, dia: number, cf: CFrame, color: Color3, mat: Enum.Material?): Part
	return mk(parent, name, Vector3.new(length, dia, dia), cf, color, mat, false, Enum.PartType.Cylinder)
end

-- A sub-model whose pivot is its core part, so clients can rotate it around that centre.
local function rotor(parent: Instance, name: string, role: string, dir: number, cf: CFrame, length: number, dia: number, ridges: number): Model
	local m = Instance.new("Model")
	m.Name = name
	local core = cyl(m, "Core", length, dia, cf, STEEL)
	for i = 1, ridges do
		local a = (i / ridges) * math.pi * 2
		mk(m, "Ridge", Vector3.new(length * 0.96, dia * 0.22, dia * 0.22), cf * CFrame.Angles(a, 0, 0) * CFrame.new(0, 0, dia * 0.5), if i % 2 == 0 then ORANGE else DARK)
	end
	m.PrimaryPart = core
	m:SetAttribute("Role", role)
	m:SetAttribute("Dir", dir)
	m.Parent = parent
	return m
end

-- Hinged plate: pivot part sits on the hinge, the plate hangs off it.
local function jaw(parent: Instance, name: string, dir: number, hinge: CFrame, plate: Vector3, off: Vector3): Model
	local m = Instance.new("Model")
	m.Name = name
	local pivot = mk(m, "Hinge", Vector3.new(0.4, 0.4, 0.4), hinge, DARK)
	mk(m, "Plate", plate, hinge * CFrame.new(off), STEEL)
	for i = -1, 1 do
		mk(m, "Teeth", Vector3.new(0.4, plate.Y * 0.14, plate.Z * 0.96), hinge * CFrame.new(off + Vector3.new(dir * 0.4, i * plate.Y * 0.3, 0)), ORANGE)
	end
	m.PrimaryPart = pivot
	m:SetAttribute("Role", "Jaw")
	m:SetAttribute("Dir", dir)
	m.Parent = parent
	return m
end

local function stateLight(parent: Instance, base: CFrame, x: number, z: number, height: number)
	mk(parent, "LightPost", Vector3.new(0.3, height, 0.3), base * CFrame.new(x, height / 2, z), DARK, Enum.Material.SmoothPlastic, true)
	local bulb = mk(parent, "StateLight", Vector3.new(0.9, 0.9, 0.9), base * CFrame.new(x, height + 0.4, z), NEON_OFF, Enum.Material.Neon, false, Enum.PartType.Ball)
	bulb:SetAttribute("Role", "Light")
	local pl = Instance.new("PointLight")
	pl.Range = 8
	pl.Brightness = 0.5
	pl.Color = NEON_OFF
	pl.Enabled = false
	pl.Parent = bulb
end

-- On/off panel with a prompt; only the owner's press counts (checked on the server).
local function panel(parent: Instance, base: CFrame, x: number, z: number, y: number)
	local post = mk(parent, "PanelPost", Vector3.new(0.4, y, 0.4), base * CFrame.new(x, y / 2, z), DARK, Enum.Material.SmoothPlastic, true)
	local box = mk(parent, "Panel", Vector3.new(1.5, 1.6, 0.5), base * CFrame.new(x, y + 0.1, z - 0.1), SLATE, Enum.Material.SmoothPlastic, true)
	mk(parent, "PanelOn", Vector3.new(0.5, 0.5, 0.12), base * CFrame.new(x - 0.38, y + 0.35, z - 0.4), Color3.fromRGB(110, 220, 140), Enum.Material.Neon)
	mk(parent, "PanelOff", Vector3.new(0.5, 0.5, 0.12), base * CFrame.new(x + 0.38, y + 0.35, z - 0.4), P.Red, Enum.Material.Neon)
	mk(parent, "PanelStrip", Vector3.new(1.2, 0.3, 0.1), base * CFrame.new(x, y - 0.35, z - 0.4), YELLOW, Enum.Material.SmoothPlastic)
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "MachineToggle"
	pp.ActionText = "Start / Stop"
	pp.ObjectText = "Machine"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 9
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R
	pp:SetAttribute("MachineToggle", true)
	pp.Parent = box
	post.Name = "PanelPost"
end

local function belt(parent: Instance, base: CFrame, width: number, z0: number, z1: number, y: number, tiles: number)
	local len = z1 - z0
	mk(parent, "BeltBed", Vector3.new(width + 0.2, 0.5, len), base * CFrame.new(0, y - 0.3, (z0 + z1) / 2), DARK, Enum.Material.SmoothPlastic, true)
	for _, sx in { -1, 1 } do
		mk(parent, "BeltRail", Vector3.new(0.3, 0.8, len), base * CFrame.new(sx * (width / 2 + 0.2), y + 0.1, (z0 + z1) / 2), ORANGE)
	end
	local pitch = len / tiles
	for i = 1, tiles do
		local t = mk(parent, "BeltTile", Vector3.new(width, 0.14, pitch * 0.82), base * CFrame.new(0, y, z0 + (i - 0.5) * pitch), if i % 2 == 0 then BELT else Color3.fromRGB(214, 198, 240), Enum.Material.SmoothPlastic)
		t:SetAttribute("Role", "Belt")
		t:SetAttribute("Order", i)
		t:SetAttribute("Count", tiles)
		t:SetAttribute("Z0", z0)
		t:SetAttribute("Length", len)
		if i % 4 == 0 then
			mk(t, "Chevron", Vector3.new(width * 0.5, 0.04, pitch * 0.3), t.CFrame * CFrame.new(0, 0.08, 0), YELLOW, Enum.Material.SmoothPlastic)
		end
	end
end

local function dust(parent: BasePart, offset: Vector3)
	local a = Instance.new("Attachment")
	a.Name = "DustPoint"
	a.Position = offset
	a:SetAttribute("Role", "Dust")
	a.Parent = parent
	local e = Instance.new("ParticleEmitter")
	e.Name = "Dust"
	e.Enabled = false
	e.Rate = 8
	e.Lifetime = NumberRange.new(0.5, 0.9)
	e.Speed = NumberRange.new(1, 2.5)
	e.SpreadAngle = Vector2.new(35, 35)
	e.Color = ColorSequence.new(Color3.fromRGB(255, 244, 214))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1.5) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = a
end

-- Soft padded tray the geode lands in (width 2.2, depth d).
local function geodeTray(parent: Instance, base: CFrame, x: number, y: number, z: number, d: number)
	mk(parent, "TrayBody", Vector3.new(2.2, 0.5, d), base * CFrame.new(x, y, z), SLATEL, Enum.Material.SmoothPlastic, true)
	mk(parent, "TrayPad", Vector3.new(1.8, 0.2, d - 0.4), base * CFrame.new(x, y + 0.35, z), CREAM, Enum.Material.Fabric)
	for _, sx in { -1, 1 } do
		mk(parent, "TrayRim", Vector3.new(0.2, 0.5, d), base * CFrame.new(x + sx * 1.1, y + 0.4, z), YELLOW)
	end
	mk(parent, "TrayRim", Vector3.new(2.2, 0.5, 0.2), base * CFrame.new(x, y + 0.4, z + d / 2), YELLOW)
end

local function chute(parent: Instance, base: CFrame, x: number, y: number, z: number, width: number, length: number)
	local tilt = CFrame.Angles(math.rad(22), 0, 0) -- outlet end lower
	mk(parent, "OutletChute", Vector3.new(width, 0.25, length), base * CFrame.new(x, y, z) * tilt, SLATEL, Enum.Material.SmoothPlastic)
	for _, sx in { -1, 1 } do
		mk(parent, "ChuteLip", Vector3.new(0.25, 0.7, length), base * CFrame.new(x + sx * (width / 2), y + 0.25, z) * tilt, ORANGE)
	end
end

-- AUTO CRACKER: intake conveyor, rollers, motor, guarded housing, outlet, soft geode tray -------

local function autoCracker(m: Model, base: CFrame)
	mk(m, "Base", Vector3.new(9.4, 0.5, 9), base * CFrame.new(0, 0.25, 0), SLATEL, Enum.Material.SmoothPlastic, true)
	belt(m, base, 2.6, -4.5, -0.7, 1.15, 9)
	-- housing: walls, roof, floor around a front opening; yellow guard bars across the opening
	local hy, hz = 2.7, 1.5
	mk(m, "HousingWallL", Vector3.new(0.4, 4.2, 4.4), base * CFrame.new(-3.4, hy, hz), ORANGE, Enum.Material.SmoothPlastic, true)
	mk(m, "HousingWallR", Vector3.new(0.4, 4.2, 4.4), base * CFrame.new(3.4, hy, hz), ORANGE, Enum.Material.SmoothPlastic, true)
	mk(m, "HousingBack", Vector3.new(6.4, 4.2, 0.4), base * CFrame.new(0, hy, hz + 2.1), ORANGE, Enum.Material.SmoothPlastic, true)
	mk(m, "HousingRoof", Vector3.new(7.2, 0.4, 4.6), base * CFrame.new(0, hy + 2.3, hz), ORANGE, Enum.Material.SmoothPlastic, true)
	mk(m, "HousingFloor", Vector3.new(6.4, 0.3, 4.4), base * CFrame.new(0, 0.65, hz), DARK, Enum.Material.SmoothPlastic, true)
	mk(m, "FrontPostL", Vector3.new(1.6, 4.2, 0.4), base * CFrame.new(-2.4, hy, hz - 2.2), ORANGE, Enum.Material.SmoothPlastic, true)
	mk(m, "FrontPostR", Vector3.new(1.6, 4.2, 0.4), base * CFrame.new(2.4, hy, hz - 2.2), ORANGE, Enum.Material.SmoothPlastic, true)
	mk(m, "FrontLintel", Vector3.new(3.2, 1.4, 0.4), base * CFrame.new(0, hy + 1.5, hz - 2.2), ORANGE, Enum.Material.SmoothPlastic, true)
	for i = -1, 1 do
		mk(m, "GuardBar", Vector3.new(0.14, 2.2, 0.14), base * CFrame.new(i * 0.9, hy - 0.2, hz - 2.4), YELLOW)
	end
	mk(m, "Stripe", Vector3.new(7.3, 0.4, 0.1), base * CFrame.new(0, hy + 1.7, hz - 2.36), YELLOW, Enum.Material.SmoothPlastic)
	-- three rollers inside the opening
	for i = 0, 2 do
		rotor(m, "Roller" .. (i + 1), "Spin", if i % 2 == 0 then 1 else -1, base * CFrame.new(0, 1.95, hz - 1.5 + i * 1.5), 2.6, 0.95, 4)
	end
	-- motor on the roof with cooling fins
	cyl(m, "Motor", 2.8, 1.6, base * CFrame.new(0, hy + 3.2, hz), SLATE)
	for i = -1, 1 do
		cyl(m, "MotorFin", 0.2, 1.9, base * CFrame.new(i * 0.9, hy + 3.2, hz), DARK)
	end
	mk(m, "MotorMount", Vector3.new(2.2, 0.6, 2.2), base * CFrame.new(0, hy + 2.7, hz), DARK, Enum.Material.SmoothPlastic)
	-- outlet and soft geode tray
	chute(m, base, 0, 1.3, hz + 2.9, 2.4, 1.6)
	geodeTray(m, base, 4.9, 0.7, 2.6, 1.8)
	local out = m:FindFirstChild("OutletChute") :: BasePart
	dust(out, Vector3.new(0, 0.3, 0.8))
	stateLight(m, base, -5.2, -2.6, 3.4)
	panel(m, base, -5.2, -2.6, 1.8)
end

-- HYDRAULIC PRESS: frame, piston, plate, tray, warning beacon, guard rail, recovery chute -------

local function press(m: Model, base: CFrame)
	mk(m, "Base", Vector3.new(9.4, 0.5, 8.2), base * CFrame.new(0, 0.25, 0.4), SLATEL, Enum.Material.SmoothPlastic, true)
	local pz = 0.6
	for _, sx in { -3.3, 3.3 } do
		for _, dz in { -2.5, 2.5 } do
			mk(m, "FramePost", Vector3.new(0.9, 7.2, 0.9), base * CFrame.new(sx, 0.5 + 3.6, pz + dz), ORANGE, Enum.Material.SmoothPlastic, true)
		end
	end
	mk(m, "FrameBeam", Vector3.new(7.8, 1.0, 5.9), base * CFrame.new(0, 8.2, pz), ORANGE, Enum.Material.SmoothPlastic, true)
	mk(m, "BeamStripe", Vector3.new(7.9, 0.3, 0.1), base * CFrame.new(0, 8.2, pz - 2.96), YELLOW, Enum.Material.SmoothPlastic)
	cyl(m, "PistonHousing", 1.8, 1.9, base * CFrame.new(0, 7.0, pz) * CFrame.Angles(0, 0, math.pi / 2), SLATE)
	-- tray (the bed the plate presses onto) with side lips
	mk(m, "TrayBed", Vector3.new(5.4, 0.7, 4.2), base * CFrame.new(0, 0.85, pz), SLATE, Enum.Material.SmoothPlastic, true)
	for _, sx in { -1, 1 } do
		mk(m, "TrayLip", Vector3.new(0.25, 0.7, 4.2), base * CFrame.new(sx * 2.75, 1.25, pz), YELLOW)
	end
	-- moving parts, drawn in the raised pose: plate top 5.95, rod from the beam (7.7) down to it
	local plate = mk(m, "PressPlate", Vector3.new(4.6, 0.7, 3.6), base * CFrame.new(0, 5.6, pz), STEEL, Enum.Material.SmoothPlastic)
	plate:SetAttribute("Role", "Plate")
	for i = 0, 3 do
		mk(plate, "PlateHazard", Vector3.new(0.7, 0.05, 0.18), plate.CFrame * CFrame.new(-1.6 + i * 1.07, 0.38, -1.6), if i % 2 == 0 then YELLOW else DARK, Enum.Material.SmoothPlastic)
	end
	local rod = cyl(m, "PistonRod", 1.75, 1.0, base * CFrame.new(0, (7.7 + 5.95) / 2, pz) * CFrame.Angles(0, 0, math.pi / 2), STEEL)
	rod:SetAttribute("Role", "Piston")
	rod:SetAttribute("Top", 7.7)
	-- warning beacon
	cyl(m, "BeaconBase", 0.4, 1.2, base * CFrame.new(2.6, 8.9, pz + 1.6) * CFrame.Angles(0, 0, math.pi / 2), DARK)
	local beacon = mk(m, "Beacon", Vector3.new(1.0, 1.0, 1.0), base * CFrame.new(2.6, 9.5, pz + 1.6), NEON_OFF, Enum.Material.Neon, false, Enum.PartType.Ball)
	beacon:SetAttribute("Role", "Beacon")
	-- guard rail along both sides and the front corners
	for _, sx in { -4.5, 4.5 } do
		for _, dz in { -3.3, 0, 3.3 } do
			mk(m, "RailPost", Vector3.new(0.25, 2.4, 0.25), base * CFrame.new(sx, 1.7, pz + dz), YELLOW)
		end
		for _, ry in { 1.2, 2.2 } do
			mk(m, "RailBar", Vector3.new(0.2, 0.2, 6.9), base * CFrame.new(sx, ry + 0.5, pz), YELLOW)
		end
	end
	-- intake ramp (front) and recovery chute (back) with the geode pad
	mk(m, "IntakeRamp", Vector3.new(2.8, 0.25, 2.4), base * CFrame.new(0, 1.0, pz - 3.5) * CFrame.Angles(math.rad(14), 0, 0), SLATEL, Enum.Material.SmoothPlastic)
	chute(m, base, 0, 1.15, pz + 2.8, 2.6, 1.6)
	geodeTray(m, base, 0, 0.7, pz + 3.75, 1.2)
	dust(m:FindFirstChild("OutletChute") :: BasePart, Vector3.new(0, 0.3, 0.8))
	stateLight(m, base, -5.4, -2.8, 3.2)
	panel(m, base, -5.4, -2.8, 1.8)
end

-- INDUSTRIAL CRUSHER: conveyor, jaws and rollers, motor, guards, outlet, dust, recovery tray ----

local function crusher(m: Model, base: CFrame)
	mk(m, "Base", Vector3.new(10.6, 0.6, 9.4), base * CFrame.new(0, 0.3, 0), SLATEL, Enum.Material.SmoothPlastic, true)
	belt(m, base, 3.2, -4.6, -2.2, 1.3, 8)
	-- crushing chamber: dark body open at the top
	local cy, cz = 2.6, 0.6
	mk(m, "BodyFloor", Vector3.new(8.6, 0.5, 5.2), base * CFrame.new(0, 0.85, cz), DARK, Enum.Material.SmoothPlastic, true)
	mk(m, "BodyFront", Vector3.new(8.6, 3.4, 0.5), base * CFrame.new(0, cy + 0.2, cz - 2.6), SLATE, Enum.Material.SmoothPlastic, true)
	mk(m, "BodyBack", Vector3.new(8.6, 3.4, 0.5), base * CFrame.new(0, cy + 0.2, cz + 2.6), SLATE, Enum.Material.SmoothPlastic, true)
	for _, sx in { -4.3, 4.3 } do
		mk(m, "BodyWall", Vector3.new(0.5, 3.4, 5.2), base * CFrame.new(sx, cy + 0.2, cz), SLATE, Enum.Material.SmoothPlastic, true)
	end
	mk(m, "BodyBand", Vector3.new(8.7, 0.45, 5.3), base * CFrame.new(0, cy + 1.7, cz), ORANGE, Enum.Material.SmoothPlastic)
	-- feed slot in the front wall is the belt's mouth
	mk(m, "FeedHood", Vector3.new(3.8, 0.4, 1.4), base * CFrame.new(0, 3.0, cz - 3.1), ORANGE, Enum.Material.SmoothPlastic)
	-- two counter-rotating rollers and two swinging jaw plates inside
	rotor(m, "RollerA", "Spin", 1, base * CFrame.new(0, 3.1, cz - 0.9), 6.0, 1.7, 5)
	rotor(m, "RollerB", "Spin", -1, base * CFrame.new(0, 3.1, cz + 0.9), 6.0, 1.7, 5)
	jaw(m, "JawL", 1, base * CFrame.new(-3.7, 4.2, cz), Vector3.new(0.5, 2.6, 4.2), Vector3.new(0.35, -1.3, 0))
	jaw(m, "JawR", -1, base * CFrame.new(3.7, 4.2, cz), Vector3.new(0.5, 2.6, 4.2), Vector3.new(-0.35, -1.3, 0))
	-- guard cage over the open top
	for i = -3, 3 do
		mk(m, "GuardBar", Vector3.new(0.16, 0.16, 5.3), base * CFrame.new(i * 1.15, cy + 2.15, cz), YELLOW)
	end
	for _, dz in { -2.6, 2.6 } do
		mk(m, "GuardBeam", Vector3.new(8.7, 0.22, 0.22), base * CFrame.new(0, cy + 2.15, cz + dz), YELLOW)
	end
	-- motor with a turning flywheel on the right
	cyl(m, "Motor", 1.6, 1.9, base * CFrame.new(5.2, 2.0, cz - 1.4), SLATE)
	cyl(m, "MotorFin", 0.2, 2.2, base * CFrame.new(4.7, 2.0, cz - 1.4), DARK)
	rotor(m, "Flywheel", "Spin", 1, base * CFrame.new(5.3, 2.2, cz + 1.2), 0.5, 2.4, 6)
	-- outlet chute with dust and the recovery tray
	chute(m, base, 0, 1.2, cz + 3.6, 3.0, 1.5)
	geodeTray(m, base, -3.4, 0.9, cz + 3.7, 1.2)
	dust(m:FindFirstChild("OutletChute") :: BasePart, Vector3.new(0, 0.3, 0.8))
	local top = m:FindFirstChild("BodyBand") :: BasePart
	dust(top, Vector3.new(0, 1.0, 0))
	stateLight(m, base, -5.4, -3.3, 3.6)
	panel(m, base, -5.4, -3.3, 1.8)
end

-- Kit machines (Auto_Cracker, Hydraulic_Press, Industrial_Crusher; motion notes in docs/ASSET_MANIFEST.md).
-- The mesh is turned 90 degrees so its feed side (+X) faces the pile side of the bay (-Z), and shifted so
-- its footprint is centred on the pad. The meshes are visual; the server marks the moving pieces with
-- attributes for MachineView (world-space values, the arena never moves):
--   Role KitJaw    Delta (open -> closed slide)        Role KitPress  Travel (platen drop in studs)
--   Role KitRoller Pivot, Axis, Dir (spin about Axis)  Role KitFill   hidden until the machine runs
--   Role Light     the lamp (state colour + PointLight)
-- and the model gets PathStart / PathBeltEnd / PathRoller / PathMid / PathOut (pad-top frame) for the cosmetic
-- feed stones, taken from the kit attachment points.
local KIT_MACHINES = { AutoCracker = "Auto_Cracker", HydraulicPress = "Hydraulic_Press", IndustrialCrusher = "Industrial_Crusher" }

local function kitMachine(m: Model, base: CFrame, id: string): boolean
	if true then
		return false -- the quarry kit machines are not used for the pastel gadgets (REPLACE: real gadget mesh)
	end
	local t = KitModels.template(KIT_MACHINES[id])
	if not t then
		return false
	end
	local lo, hi = KitModels.extents(t)
	local origin = base * CFrame.new(-(lo.Z + hi.Z) / 2, 0, 0) * CFrame.Angles(0, math.rad(90), 0)
	local function at(point: string): Vector3
		return KitModels.attach(t, point) or Vector3.zero
	end
	local function world(v: Vector3): Vector3
		return origin:PointToWorldSpace(v)
	end
	local function toBase(v: Vector3): Vector3
		return base:PointToObjectSpace(world(v))
	end
	local pad = mk(m, "Base", Vector3.new(hi.Z - lo.Z, 0.5, hi.X - lo.X), base * CFrame.new(0, 0.25, 0), SLATEL, Enum.Material.SmoothPlastic, false)
	pad.Transparency = 1
	local parts: { [string]: BasePart } = {}
	for _, src in t:GetChildren() do
		if src:IsA("MeshPart") then
			local p = src:Clone()
			for _, ch in p:GetChildren() do
				ch:Destroy()
			end
			p.Anchored = true
			p.CFrame = origin * src.CFrame
			p.CanCollide = src.Name == "Concrete"
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = src.Transparency < 0.5
			p.Parent = m
			parts[src.Name] = p
		end
	end
	-- moving pieces
	local function slide(name: string, openPt: string, closedPt: string)
		local p = parts[name]
		if p then
			p:SetAttribute("Role", "KitJaw")
			p:SetAttribute("Delta", origin:VectorToWorldSpace(at(closedPt) - at(openPt)))
		end
	end
	if id == "AutoCracker" then
		slide("JawL", "JawL_Open", "JawL_Closed")
		slide("JawR", "JawR_Open", "JawR_Closed")
	elseif id == "HydraulicPress" then
		for _, n in { "Piston", "Platen" } do
			if parts[n] then
				parts[n]:SetAttribute("Role", "KitPress")
				parts[n]:SetAttribute("Travel", (at("Platen_Open") - at("Platen_Down")).Magnitude)
			end
		end
	else
		for n, dir in ({ RollerL = 1, RollerR = -1 } :: { [string]: number }) do
			local p = parts[n]
			if p then
				p:SetAttribute("Role", "KitRoller")
				p:SetAttribute("Pivot", world(at(n)))
				p:SetAttribute("Axis", origin:VectorToWorldSpace(Vector3.xAxis))
				p:SetAttribute("Dir", dir)
			end
		end
	end
	for _, n in { "Fill", "HopperFill" } do
		local p = parts[n]
		if p then
			p:SetAttribute("Role", "KitFill")
			p.Transparency = 1
		end
	end
	local lamp = parts.Lamp
	if lamp then
		lamp:SetAttribute("Role", "Light")
		lamp.Material = Enum.Material.Neon
		lamp.Color = NEON_OFF
		local pl = Instance.new("PointLight")
		pl.Range = 8
		pl.Brightness = 0.5
		pl.Color = NEON_OFF
		pl.Enabled = false
		pl.Parent = lamp
	end
	-- start / stop prompt on the panel (only the owner's press counts, checked on the server)
	local box = mk(m, "Panel", Vector3.new(1.4, 1.2, 0.6), origin * CFrame.new(at("Panel")), SLATE, Enum.Material.SmoothPlastic, false)
	box.Transparency = 1
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "MachineToggle"
	pp.ActionText = "Start / Stop"
	pp.ObjectText = "Machine"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 9
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R
	pp:SetAttribute("MachineToggle", true)
	pp.Parent = box
	-- dust where the pieces come out
	local out = mk(m, "OutletChute", Vector3.new(1, 1, 1), origin * CFrame.new(at("Output")), DARK, Enum.Material.SmoothPlastic, false)
	out.Transparency = 1
	dust(out, Vector3.new(0, 0.3, 0))
	if id == "IndustrialCrusher" then
		local top = mk(m, "DustTop", Vector3.new(1, 1, 1), origin * CFrame.new(at("Hopper")), DARK, Enum.Material.SmoothPlastic, false)
		top.Transparency = 1
		dust(top, Vector3.new(0, 0.5, 0))
	end
	-- cosmetic feed stone path, from the attachment points
	local outP = at("Output")
	local startP, beltEnd, roller
	if id == "AutoCracker" then
		startP, beltEnd, roller = at("FeedStart"), at("FeedEnd"), at("Chamber")
	elseif id == "HydraulicPress" then
		startP, roller = at("FeedStart"), at("RockSpot")
		beltEnd = roller
	else
		startP, beltEnd, roller = at("Hopper") + Vector3.new(3.4, 0, 0), at("Hopper"), at("RollerL"):Lerp(at("RollerR"), 0.5)
	end
	local mid = if id == "IndustrialCrusher" then at("BeltStart") else roller:Lerp(outP, 0.5)
	m:SetAttribute("PathStart", toBase(startP))
	m:SetAttribute("PathBeltEnd", toBase(beltEnd))
	m:SetAttribute("PathRoller", toBase(roller))
	m:SetAttribute("PathMid", toBase(mid))
	m:SetAttribute("PathOut", toBase(outP))
	m:SetAttribute("Kit", true)
	return true
end

local BUILDERS: { [string]: (Model, CFrame) -> () } = {
	AutoCracker = autoCracker,
	HydraulicPress = press,
	IndustrialCrusher = crusher,
}

-- Owner's Gear_<Id> model (Assets.Kit, Ready=true) as the machine's look, fitted to the Parts footprint and
-- pad-top pivot. The Parts build stays underneath for everything the game uses (Base, hopper / outlet / panel
-- points, the start prompt, state lights, dust, Role pieces MachineView animates); its body parts are only
-- made invisible. No Ready gear model: nothing changes (Parts fallback).
function MachineModels.dressWithGear(m: Model, machineId: string, padTop: CFrame)
	local tpl = KitModels.template("Gear_" .. machineId)
	if GearKit.source(tpl ~= nil, tpl ~= nil and tpl:GetAttribute("Ready") == true) ~= "Gear" or not tpl then
		return
	end
	local ok, err = pcall(function()
		local _, box = m:GetBoundingBox()
		local gear = tpl:Clone()
		local _, gsize = gear:GetBoundingBox()
		local s = GearKit.fitScale(gsize, Vector3.new(box.X, 0, box.Z))
		gear.Name = "GearModel"
		gear:ScaleTo(gear:GetScale() * s)
		local bcf = (m:GetBoundingBox())
		local gcf, gs = gear:GetBoundingBox()
		-- bottom centre of the gear on the bottom centre of the old footprint (pad top)
		local want = CFrame.new(bcf.Position.X, padTop.Position.Y, bcf.Position.Z) * padTop.Rotation
		local have = gcf * CFrame.new(0, -gs.Y / 2, 0)
		gear:PivotTo(want * have:ToObjectSpace(gear:GetPivot()))
		for _, d in gear:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
		end
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") and d.Name ~= "Base" then
				if GearKit.hideUnderGear(d.Name, d:GetAttribute("Role")) then
					d.Transparency = 1
					for _, l in d:GetChildren() do
						if l:IsA("Light") then
							l.Enabled = false -- the state bulb / beacon glow would float beside the gear model
						end
					end
					d.CastShadow = false
					for _, g in d:GetChildren() do
						if g:IsA("SurfaceGui") then
							g.Enabled = false
						end
					end
				end
			end
		end
		gear.Parent = m
	end)
	if not ok then
		warn("[MachineModels] gear model failed, keeping Parts: " .. tostring(err))
	end
end

-- Builds the machine for a bay (bayCF = the bay pad's CFrame, -Z toward the pile).
function MachineModels.build(machineId: string, bayCF: CFrame, parent: Instance, ownerId: number, ownerName: string): Model?
	local builder = BUILDERS[machineId]
	if not builder then
		return nil
	end
	local m = Instance.new("Model")
	m.Name = "CT_Rocks_Machine_" .. machineId
	m:SetAttribute("MachineId", machineId)
	m:SetAttribute("OwnerId", ownerId)
	m:SetAttribute("Frame", bayCF * CFrame.new(0, 0.3, 0)) -- pad-top frame, read by the client animation
	local padTop = bayCF * CFrame.new(0, 0.3, 0)
	local okKit = false
	if KIT_MACHINES[machineId] then
		local ok, res = pcall(kitMachine, m, padTop, machineId)
		okKit = ok and res == true
		if not okKit then
			if not ok then
				warn("[MachineModels] kit machine failed, using Parts: " .. tostring(res))
			end
			m:ClearAllChildren() -- drop a half-built kit model
		end
	end
	if not okKit then
		builder(m, padTop) -- Part stand-in
	end
	local base = m:FindFirstChild("Base") :: BasePart?
	if base then
		m.PrimaryPart = base
	end
	if not okKit then
		MachineModels.dressWithGear(m, machineId, padTop)
	end
	-- owner plate
	local info = Config.Machines[machineId]
	-- (on the slab's outer side, facing the quiet lane between stations: the pad edge towards the table
	-- is hidden behind the table, so a plate there could never be read)
	local plate = mk(m, "OwnerPlate", Vector3.new(4.4, 1.3, 0.16), bayCF * CFrame.new(5.8, 0.8, 0) * CFrame.Angles(0, -math.pi / 2, 0), SLATE, Enum.Material.SmoothPlastic)
	-- fitted text (SignLayout via KitPlace.applyFit, explicit TextSize) with the sign audit attributes
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Label"
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.Parent = plate
	local t = Instance.new("TextLabel")
	t.Name = "Text"
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = CREAM
	t.Parent = gui
	-- two lines (owner, machine): on one line the pair overran the plate and the machine name was cut off
	local f = KitPlace.applyFit(gui, t, ownerName .. "\n" .. info.Name, plate.Size.X, plate.Size.Y, "Placard")
	plate:SetAttribute("SignText", f.Text)
	plate:SetAttribute("SignPreset", "Placard")
	plate:SetAttribute("SignW", plate.Size.X)
	plate:SetAttribute("SignH", plate.Size.Y)
	m.Parent = parent
	return m
end

return MachineModels
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="239">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server boot: remotes, world, saves, services, profile sync to clients.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Config = require(Shared.Config)
local PlaceRole = require(Shared.PlaceRole)
Net.init()

-- "Single" (default, Studio): lobby + private arenas in this server, exactly as in Phase 1.
-- "Lobby" / "Match": Teleport mode (Config.Places), see docs/OWNER_STEPS.md.
local role = PlaceRole.resolve(Config.Places.Mode, game.PlaceId, Config.Places.LobbyPlaceId, Config.Places.MatchPlaceId)
local isMatch = role == "Match"

local Profiles = require(script.Parent.Profiles)
local Ledger = require(script.Parent.AwardLedger)
local World = require(script.Parent.WorldBuilder)
local PartyService = require(script.Parent.PartyService)
local MatchService = require(script.Parent.MatchService)
local Economy = require(script.Parent.EconomyService)
local Gallery = require(script.Parent.GalleryService)
local Leaderboards = require(script.Parent.LeaderboardService)
local LobbyBoards = require(script.Parent.LobbyBoards)
local Store = require(script.Parent.StoreService)

-- The lobby spawn pad exists BEFORE the mesh wait below (up to 8 s): a player who joins in that window (Studio Play
-- does) used to spawn with no SpawnLocation at all, at the centre of the lodge, and could end up on the ceiling
-- collider once the lodge appeared around them (docs/m11/CAMERA_SPAWN_FIX.md).
if not isMatch then
	require(script.Parent.LobbyBuilder).ensureSpawn()
end
require(script.Parent.MeshService).start() -- uploaded CT_Rocks_ meshes -> ReplicatedStorage.Assets (optional)
require(script.Parent.LowPolyStation).apply() -- owner's low-poly basket and tappers over those templates (when imported)
require(script.Parent.PreviewKit).build() -- shop pictures of the real tool / machine models
local lobby: { [string]: any } = if isMatch then {} else World.buildLobby()

-- Profile -> client sync, debounced so a burst of changes sends one update.
local dirty: { [Player]: boolean } = {}
Profiles.onChanged(function(player)
	if dirty[player] then
		return
	end
	dirty[player] = true
	task.delay(0.15, function()
		dirty[player] = nil
		if player.Parent then
			local view = Profiles.publicView(player, Profiles.takeInventoryDirty(player))
			if view then
				Net.event("ProfileState"):FireClient(player, view)
			end
		end
	end)
end)

Profiles.onLoaded(function(player)
	Ledger.reconcile(player)
	Economy.attachTool(player)
	PartyService.sync(player.UserId)
end)

Economy.onToolChanged(MatchService.toolChanged)
Economy.onMachine(MatchService.machineChanged)
-- One plot rebuild per player per half second, however fast the display buttons are tapped.
local renderPending: { [Player]: boolean } = {}
Economy.onDisplayChanged(function(player)
	if renderPending[player] then
		return
	end
	renderPending[player] = true
	task.delay(0.5, function()
		renderPending[player] = nil
		if player.Parent then
			Gallery.render(player)
		end
	end)
end)

local function onCharacter(player: Player)
	local char = player.Character
	if char then
		char:WaitForChild("Humanoid", 5)
		if not (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")) then
			char:WaitForChild("RightHand", 5)
		end
	end
	if Profiles.isLoaded(player) then
		Economy.attachTool(player)
	end
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function()
		onCharacter(player)
	end)
	-- appearance (bundle body parts) may finish after CharacterAdded: attach again
	player.CharacterAppearanceLoaded:Connect(function()
		if Profiles.isLoaded(player) then
			Economy.attachTool(player)
		end
	end)
	if player.Character then
		task.spawn(onCharacter, player)
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do
	onPlayer(p)
end

local lastReady: { [Player]: number } = {}
Players.PlayerRemoving:Connect(function(p)
	lastReady[p] = nil
end)
Net.event("ClientReady").OnServerEvent:Connect(function(player)
	local t = os.clock()
	if lastReady[player] and t - lastReady[player] < 5 then
		return -- once per player per 5 s
	end
	lastReady[player] = t
	local view = Profiles.publicView(player, true)
	if view then
		Net.event("ProfileState"):FireClient(player, view)
	end
	PartyService.sync(player.UserId)
end)

if not isMatch then
	PartyService.start()
end
MatchService.start(lobby)
require(script.Parent.EggEvents).start() -- wobble hint + speed boots
if role == "Lobby" then
	require(script.Parent.LobbyLaunch).start() -- replaces the in-server arena hand-off
elseif isMatch then
	require(script.Parent.MatchPlace).start() -- before Profiles.start: sets the ticket join gate
end
Economy.start()
if not isMatch then
	Gallery.start(lobby)
	LobbyBoards.build(lobby.Root)
	require(script.Parent.WinnerBoard).start(lobby.Root) -- LAST WINNERS screen over the WHAT'S NEW board (memory only)
	local okStatue, statueErr = pcall(require(script.Parent.VoidStatue).build, lobby.Root, lobby.Spawn) -- the 1 in 1000 dream pet
	if not okStatue then
		warn("[Main] Void Dragon statue failed: " .. tostring(statueErr))
	end
end
Store.start()
require(script.Parent.RobuxService).start() -- Robux shop + luck events (receipts via Store.addReceiptRoute)
Leaderboards.start()
if not isMatch then
	require(script.Parent.TopStatues).start() -- top 3 STRONGEST PET players as statues on TopStatue pedestals
	task.defer(function()
		local ok, n = pcall(require(script.Parent.LobbyBloom).build) -- flowers + twinkles beside the lobby paths
		if not ok then
			warn("[Main] lobby flowers failed: " .. tostring(n))
		end
	end)
end
local PetService = require(script.Parent.PetService)
PetService.start() -- pets: starter, follower attribute, equip, renaming
local RetentionService = require(script.Parent.RetentionService)
RetentionService.start(isMatch) -- starter egg, play-time gifts, away nest, friend + group gifts
Economy.onTutorialSkipped(function(p)
	RetentionService.hatchStarter(p) -- skipping the tutorial still hatches the free starter pet (with its show)
end)
if not isMatch then
	PetService.onRenamed(Gallery.render) -- a renamed pet on display gets its new plaque
end
require(script.Parent.FriendBonus).start() -- friend bonus luck (Roblox friends in this server)
require(script.Parent.PetIndex).start() -- first-find coins, Pet Master title, name tag attributes
require(script.Parent.RareHatch).start() -- rare hatch banners from other servers (MessagingService)
if not isMatch then
	-- lobby hangout (shared/Hangout, docs/HANGOUT.md): sit spots, hidden eggs, lookout, group gift, mini-games, events
	local Robux = require(script.Parent.RobuxService)
	local hangoutRoots: { Instance } = { lobby.Root }
	local handMap = require(script.Parent.MapHooks).root()
	if handMap and handMap ~= lobby.Root then
		table.insert(hangoutRoots, handMap)
	end
	local meadow = workspace:FindFirstChild("LobbyMeadow")
	if meadow and not table.find(hangoutRoots, meadow) then
		table.insert(hangoutRoots, meadow)
	end
	require(script.Parent.LobbyHangout).start(hangoutRoots, Robux.giftEgg)
	require(script.Parent.LobbyGames).start(hangoutRoots)
	require(script.Parent.TreeBoardService).start(hangoutRoots) -- leaderboard tree: top pets by POWER + BATTLE pad
	require(script.Parent.LobbyEvents).start(hangoutRoots, if lobby.Spawn then lobby.Spawn.Position else nil, Robux.giftEgg)
end
Profiles.start() -- last, so every onLoaded handler is registered first
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="240">
        <Properties>
          <string name="Name">MapHooks</string>
          <string name="Source"><![CDATA[--!strict
-- Lobby map hooks (shared/MapNames, docs/MAP_HOOKS.md). The owner builds the lobby by hand in Studio
-- (Workspace.FTP_Lobby); this module finds the named pieces and makes sure each one carries what the game logic needs
-- (attributes, attachments, prompts, text labels), adding anything missing. Every lookup is guarded: a missing piece is
-- skipped with one warn, never an error. It runs on the procedural fallback park too (which already has everything),
-- so both maps go through the same checks.
--
--   MapHooks.root()                    -> the hand-built map Model (first of MapNames.Roots under Workspace) or nil
--   MapHooks.ensure(map, lobby, adopt) -> fixes up the hooks under `map`; `lobby` is the code's CT_Rocks_Lobby folder
--                                         (helper parts go there). With `adopt`, also adopts the hand-built plots,
--                                         boards and WHAT'S NEW board and returns { Plots }.

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local MapNames = require(Shared.MapNames)
local ParkConfig = require(Shared.ParkConfig)
local WhatsNew = require(Shared.WhatsNew)
local KitPlace = require(script.Parent.KitPlace)

local MapHooks = {}

local function warnMissing(what: string)
	warn("[MapHooks] lobby map has no " .. what .. "; that feature is skipped")
end

local function find(parent: Instance, name: string): Instance?
	return parent:FindFirstChild(name, true)
end

local function findAny(parent: Instance, names: { string }): Instance?
	for _, n in names do
		local d = parent:FindFirstChild(n, true)
		if d then
			return d
		end
	end
	return nil
end

-- A part for `inst`: itself, a Model's PrimaryPart, else its first part.
local function asPart(inst: Instance?): BasePart?
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst
	end
	if inst:IsA("Model") and inst.PrimaryPart then
		return inst.PrimaryPart
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

local function findPart(parent: Instance, name: string): BasePart?
	return asPart(find(parent, name))
end

-- The highest part (by top face) inside `inst`, skipping signs.
local function topPart(inst: Instance): BasePart?
	if inst:IsA("BasePart") then
		return inst
	end
	local best: BasePart? = nil
	local bestTop = -math.huge
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= MapNames.BuildingSign and d.Transparency < 1 then
			local top = d.Position.Y + d.Size.Y / 2
			if top > bestTop then
				best, bestTop = d, top
			end
		end
	end
	return best or asPart(inst)
end

-- A TextLabel on the Front face (LookVector side) of `part`, made once.
local function faceLabel(part: BasePart, labelName: string, text: string): TextLabel
	local existing = part:FindFirstChild(labelName, true)
	if existing and existing:IsA("TextLabel") then
		return existing
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = labelName .. "Gui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part
	local t = Instance.new("TextLabel")
	t.Name = labelName
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = Color3.fromRGB(255, 244, 220)
	t.TextStrokeTransparency = 0.4
	t.TextScaled = true
	t.Text = text
	t.Parent = gui
	return t
end

-- The first TextLabel inside `inst` with one of `names` (any name when `names` is empty).
local function findLabel(inst: Instance, names: { string }): TextLabel?
	for _, d in inst:GetDescendants() do
		if d:IsA("TextLabel") and (#names == 0 or table.find(names, d.Name)) then
			return d
		end
	end
	return nil
end

local function hasPrompt(inst: Instance): boolean
	return inst:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
end

local function prompt(part: BasePart, name: string, action: string, object: string, dist: number): ProximityPrompt
	local existing = part:FindFirstChildWhichIsA("ProximityPrompt")
	if existing then
		return existing
	end
	local pp = Instance.new("ProximityPrompt")
	pp.Name = name
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = dist
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R
	pp.Parent = part
	return pp
end

function MapHooks.root(): Instance?
	return MapNames.findRoot(Workspace:GetChildren())
end

-- Hunt queue ------------------------------------------------------------------------------------------------------

-- QueuePad1..4: the touch part ("Pad" in a pad Model, or the pad Part itself) gets HuntPortal and PadIndex.
-- PartyService writes the queue text into the first QueueBoard/QueueText it finds; when the map has no QueueBoard an
-- invisible one is made in the code's lobby folder, and its text is copied onto every pad's "Countdown" sign.
local function ensureQueue(map: Instance, lobby: Instance)
	local countdowns: { TextLabel } = {}
	local any = false
	for n = 1, MapNames.QueuePadCount do
		local padInst = find(map, MapNames.queuePad(n))
		local touch = if padInst then (findPart(padInst, MapNames.QueuePadTouch) or asPart(padInst)) else nil
		if touch then
			any = true
			touch:SetAttribute("HuntPortal", true)
			touch:SetAttribute("PadIndex", n)
			touch.CanTouch = true
			-- a flat disc lying in the ground may never overlap a walking avatar: add an invisible touch volume
			-- (a short cylinder over the disc, named HuntPortal so PartyService does not light it as a pad)
			local thin = math.min(touch.Size.X, touch.Size.Y, touch.Size.Z)
			if thin < 2 and not touch:FindFirstChild("HuntPortal") then
				local wide = math.max(touch.Size.X, touch.Size.Y, touch.Size.Z)
				local vol = Instance.new("Part")
				vol.Name = "HuntPortal"
				vol.Shape = Enum.PartType.Cylinder
				vol.Size = Vector3.new(4, wide * 0.9, wide * 0.9)
				vol.CFrame = CFrame.new(touch.Position + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
				vol.Transparency = 1
				vol.Anchored = true
				vol.CanCollide = false
				vol.CanQuery = false
				vol.CanTouch = true
				vol.CastShadow = false
				vol:SetAttribute("PadIndex", n)
				vol:SetAttribute("HuntPortal", true)
				vol.Parent = touch
			end
		end
		local cd = if padInst then find(padInst, MapNames.QueueCountdown) else nil
		if cd then
			for _, d in cd:GetDescendants() do
				if d:IsA("TextLabel") and d.Name == MapNames.CountdownText then
					table.insert(countdowns, d) -- front and back
				end
			end
		end
	end
	if not any then
		warnMissing(MapNames.QueuePad .. "1-" .. MapNames.QueuePadCount)
	end
	local board = findPart(map, MapNames.QueueBoard)
	if not board and #countdowns > 0 then
		local hidden = Instance.new("Part")
		hidden.Name = MapNames.QueueBoard
		hidden.Size = Vector3.new(1, 1, 0.1)
		hidden.CFrame = CFrame.new(0, -50, 0)
		hidden.Transparency = 1
		hidden.Anchored = true
		hidden.CanCollide = false
		hidden.CanQuery = false
		hidden.CanTouch = false
		hidden.Parent = lobby
		board = hidden
		local gui = faceLabel(hidden, MapNames.QueueText, "STEP ON TO PLAY").Parent :: SurfaceGui
		gui.Enabled = false
	end
	if not board then
		warnMissing(MapNames.QueueBoard .. " / " .. MapNames.QueueCountdown .. " signs")
		return
	end
	local text = faceLabel(board :: BasePart, MapNames.QueueText, "STEP ON TO PLAY")
	if #countdowns > 0 then
		local last = ""
		local function copy()
			if text.Text ~= last then
				last = text.Text
				for _, l in countdowns do
					l.Text = last
				end
			end
		end
		copy()
		task.spawn(function()
			while text.Parent do
				task.wait(0.25)
				copy()
			end
		end)
	end
end

-- Buildings ------------------------------------------------------------------------------------------------------

-- The hatch stand is only the stage for the public hatch show now (HatchStandView). Coin eggs are sold in the Pet
-- Shop's Eggs tab at the EGG SHOP hut (2026-10-15), so the stand has no "Buy Eggs" prompt; an old one is removed.
local function ensureHatch(map: Instance)
	local inst = find(map, MapNames.HatchStand)
	if not inst then
		warnMissing(MapNames.HatchStand)
		return
	end
	-- already hooked (the fallback park, or a map that set it by hand)
	local stand: BasePart? = if inst:IsA("BasePart") and inst:GetAttribute("HatchStand") == true then inst else nil
	if not stand then
		for _, d in (inst :: Instance):GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("HatchStand") == true then
				stand = d
				break
			end
		end
	end
	if not stand then
		stand = topPart(inst)
		if not stand then
			warnMissing(MapNames.HatchStand .. " part")
			return
		end
		stand:SetAttribute("HatchStand", true)
		if not stand:FindFirstChild(MapNames.HatchPoint) then
			local at = Instance.new("Attachment")
			at.Name = MapNames.HatchPoint
			at.Position = Vector3.new(0, stand.Size.Y / 2, 0) -- the top face
			at.Parent = stand
		end
	end
	local old = (stand :: BasePart):FindFirstChild("ShrinePrompt")
	if old then
		old:Destroy()
	end
end

local function ensureTower(map: Instance)
	local entrance = find(map, MapNames.TowerEntrance)
	local door = if entrance and entrance.Name ~= MapNames.TowerPortal then entrance:FindFirstChild(MapNames.TowerPortal, true) else entrance
	door = door or find(map, MapNames.TowerPortal)
	if not door and entrance and entrance:IsA("BasePart") then
		door = entrance -- a single part entrance is its own doorway
	end
	if not door and entrance and entrance:IsA("Model") then
		-- no doorway part: an invisible touch box in the middle of the entrance, standing on its lowest point
		local cf, size = entrance:GetBoundingBox()
		local box = Instance.new("Part")
		box.Name = MapNames.TowerPortal
		box.Size = Vector3.new(math.clamp(size.X * 0.5, 3, 12), 8, math.clamp(size.Z * 0.5, 3, 12))
		box.CFrame = cf * CFrame.new(0, -size.Y / 2 + 4, 0)
		box.Transparency = 1
		box.Anchored = true
		box.CanCollide = false
		box.CanQuery = false
		box:SetAttribute("CameraIgnore", true)
		box.Parent = entrance
		door = box
	end
	if door and door:IsA("BasePart") then
		door:SetAttribute("TowerPortal", true)
		door.CanTouch = true
	else
		warnMissing(MapNames.TowerEntrance .. " / " .. MapNames.TowerPortal)
	end
end

local function ensureSecretEgg(map: Instance)
	local egg = findPart(map, MapNames.SecretEgg)
	if not egg then
		warnMissing(MapNames.SecretEgg)
		return
	end
	egg:SetAttribute("SecretEgg", true)
	local holder = find(map, MapNames.SecretEgg)
	if holder and holder ~= egg then
		holder:SetAttribute("SecretEgg", true)
	end
	if not (holder and hasPrompt(holder)) then
		local pp = prompt(egg, MapNames.SecretEggPrompt, "Take", "???", 6)
		pp.Name = MapNames.SecretEggPrompt
	end
end

-- EGG SHOP: a (disabled) prompt on its counter / sign; RobuxService enables the first prompt in the hut as the shop.
local function ensureEggShop(map: Instance)
	local shop = find(map, MapNames.EggShop)
	if not shop then
		warnMissing(MapNames.EggShop)
		return
	end
	if hasPrompt(shop) then
		return -- the fallback park's counter prompt, or RobuxService already hooked it
	end
	local anchor = findPart(shop, MapNames.ShopCounter) or findPart(shop, MapNames.BuildingSign) or asPart(shop)
	if anchor then
		local pp = prompt(anchor, "ShopPrompt", "Egg Shop", "EGG SHOP", 12)
		pp.Enabled = false -- RobuxService turns it on (it is the shop's only door)
		pp:SetAttribute("ShopHook", "EggShop")
	end
end

-- WHAT'S NEW: the title and the lines of shared/WhatsNew on the board's front face (or its own TextLabel "Text").
local function ensureWhatsNew(map: Instance)
	local inst = find(map, MapNames.WhatsNewBoard)
	local board = asPart(inst)
	if not inst or not board then
		warnMissing(MapNames.WhatsNewBoard)
		return
	end
	local t = findLabel(inst, { MapNames.BoardText, "WhatsNewText" }) or faceLabel(board, "WhatsNewText", "")
	-- fitted, white with a black outline (the owner's frame and face colour stay as built). Only the first 3 lines
	-- go on the board so the letters stay big enough to read from the path; the pop-up still shows them all.
	local lines = table.move(WhatsNew.Lines, 1, math.min(3, #WhatsNew.Lines), 1, {})
	KitPlace.fitMapLabel(t, WhatsNew.Title .. "\n" .. table.concat(lines, "\n"), "Placard")
	-- audit F26: the fitted 48 px text came out half a stud tall on the board (96 px per stud), unreadable on a phone
	-- walk-up; let it fill the board face instead
	if t:IsA("TextLabel") then
		t.TextWrapped = true
		t.TextScaled = true
	end
end

-- Building signs the owner lettered in Studio (EGG SHOP, the book shop, PET TOWER, ...): every SurfaceGui with one
-- TextLabel on a part under Buildings, or on any part whose name ends in "Sign", gets its own words refitted
-- (KitPlace.fitMapLabel, Landmark preset: big, white, black outline). Plot signs (owner names, written by the plot
-- code) and the code's own fitted signs (attribute SignText) are left alone.
local function ensureSigns(map: Instance)
	local buildings = map:FindFirstChild("Buildings", true)
	-- signs whose text other code writes (plots, queue pads and board, WHAT'S NEW, leaderboards)
	local skip = { MapNames.QueueBoard, MapNames.QueueCountdown, MapNames.WhatsNewBoard }
	for _, b in MapNames.Boards do
		table.move(b.Parts, 1, #b.Parts, #skip + 1, skip)
	end
	local function plotSign(inst: Instance): boolean
		local a: Instance? = inst
		while a and a ~= map do
			local n = a.Name
			if table.find(MapNames.PlotSign, n) or table.find(skip, n) or string.match(n, "^" .. MapNames.Plot .. "%d+$") or string.match(n, "^" .. MapNames.QueuePad .. "%d+$") then
				return true
			end
			a = a.Parent
		end
		return false
	end
	for _, gui in map:GetDescendants() do
		if not gui:IsA("SurfaceGui") then
			continue
		end
		local part = gui.Adornee or gui.Parent
		if not (part and part:IsA("BasePart")) or part:GetAttribute("SignText") ~= nil then
			continue
		end
		local signLike = string.sub(part.Name, -4) == "Sign" or (buildings ~= nil and part:IsDescendantOf(buildings))
		if not signLike or plotSign(part) then
			continue
		end
		local labels = {}
		for _, d in gui:GetDescendants() do
			if d:IsA("TextLabel") then
				table.insert(labels, d)
			end
		end
		local label = labels[1]
		if #labels == 1 and label and string.match(label.Text, "%S") and not string.find(label.Text, "<", 1, true) then
			KitPlace.fitMapLabel(label, label.Text, "Landmark")
		end
	end
end

-- Book shop sign (Studio check 2026-10-13): the BOOK lettering on the owner's ShopBook building is part of its mesh
-- texture, so it can't be refitted. A code-made framed board named BookSign carries big white outlined PET BOOK
-- lettering like the other shop signs. Placed on a part named BookSignSpot when the map has one (its LookVector = the
-- way the sign faces, its centre = the sign centre); otherwise above the front of ShopBook, facing the way the
-- PetBookSpot stall spot faces (else ShopBook's own front).
-- True when `inst` shows nothing: attribute Hidden, a see-through part, or a model / folder with no visible part.
function MapHooks.isHidden(inst: Instance): boolean
	if inst:GetAttribute("Hidden") == true then
		return true
	end
	if inst:IsA("BasePart") then
		return inst.Transparency >= 0.99
	end
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 0.99 then
			return false
		end
	end
	return true
end

-- The PET BOOK sign over the ShopBook stall. Skipped while the ShopBook is hidden (2026-10-14: the stall was hidden
-- and its sign floated in front of the Void Dragon statue's wing).
local function ensureBookSign(map: Instance, lobby: Instance)
	local shop = find(map, "ShopBook")
	if not shop or MapHooks.isHidden(shop) or lobby:FindFirstChild("BookSign", true) then
		return
	end
	local spot = findPart(map, "BookSignSpot")
	local cf: CFrame
	local W = 10
	if spot then
		-- level: a tilted spot part only gives the facing, never a lean
		local lv = spot.CFrame.LookVector
		local flat = Vector3.new(lv.X, 0, lv.Z)
		flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.zAxis
		cf = CFrame.lookAt(spot.Position, spot.Position - flat)
		W = math.clamp(spot.Size.X, 6, 16)
	else
		local box: CFrame, size: Vector3
		if shop:IsA("Model") then
			box, size = shop:GetBoundingBox()
		elseif shop:IsA("BasePart") then
			box, size = shop.CFrame, shop.Size
		else
			return
		end
		local stall = findPart(map, MapNames.StallSpots.PetBook)
		local look = if stall then stall.CFrame.LookVector else box.LookVector
		local front = Vector3.new(look.X, 0, look.Z)
		front = if front.Magnitude > 0.01 then front.Unit else Vector3.zAxis
		-- half the footprint along the front direction, so the board sits just in front of the top edge
		local depth = math.abs(box.RightVector:Dot(front)) * size.X + math.abs(box.LookVector:Dot(front)) * size.Z
		local pos = box.Position + Vector3.new(0, size.Y / 2 + 1.6, 0) + front * (depth / 2 + 0.3)
		W = math.clamp(size.X * 0.6, 6, 14)
		cf = CFrame.lookAt(pos, pos - front) -- +Z (the sign front) toward the viewer
	end
	local face = KitPlace.signBoard(lobby, "BookSign", cf, W, W * 0.25, "PET BOOK", "Landmark", { Outline = true, Depth = 0.3 })
	local board = face.Parent
	if board then
		for _, d in board:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide, d.CanQuery, d.CanTouch = false, false, false
			end
		end
	end
end

-- Leaderboards: a board with its own TextLabel ("Board" part > SurfaceGui > "Text") is marked BoardId and LobbyBoards
-- writes the rows there as text. A plain part gets an invisible mount over its front face in the code's BoardMounts
-- folder, marked Bare, and LobbyBoards draws the rows onto it.
local function ensureBoards(map: Instance, lobby: Instance)
	for _, b in MapNames.Boards do
		local inst = findAny(map, b.Parts)
		if not inst then
			warnMissing(b.Parts[1])
			continue
		end
		local face = findPart(inst, MapNames.BoardFace) or asPart(inst)
		local label = findLabel(inst, { MapNames.BoardText })
		if label then
			label:SetAttribute("BoardId", b.Id)
		elseif face then
			local mounts = lobby:FindFirstChild("BoardMounts")
			if not mounts then
				local folder = Instance.new("Folder")
				folder.Name = "BoardMounts"
				folder.Parent = lobby
				mounts = folder
			end
			local name = "Mount_" .. b.Id
			if not (mounts :: Instance):FindFirstChild(name) then
				local m = Instance.new("Part")
				m.Name = name
				m.Size = Vector3.new(face.Size.X, face.Size.Y, 0.05)
				m.CFrame = face.CFrame * CFrame.new(0, 0, -(face.Size.Z / 2 + 0.03)) * CFrame.Angles(0, math.pi, 0)
				m.Transparency = 1
				m.Anchored = true
				m.CanCollide = false
				m.CanQuery = false
				m.CanTouch = false
				m.CastShadow = false
				m:SetAttribute("Bare", true)
				m.Parent = mounts
			end
		end
	end
end

-- Plots ----------------------------------------------------------------------------------------------------------

-- Yaw-only frame at `pos` whose -Z (look) points along the flat direction (dx, dz).
local function facing(pos: Vector3, dx: number, dz: number): CFrame
	return CFrame.new(pos) * CFrame.Angles(0, math.atan2(-dx, -dz), 0)
end

-- One hand-built plot -> the plot interface GalleryService uses (ParkBuilder.Plot). The plot looks toward its sign
-- (the gate / street side); the pets on Dome1Base, Stand1 and Stand2 (display slots 1-3) face that way.
local function adoptPlot(m: Instance, i: number, centre: Vector3): any?
	local floor = (if m:IsA("Model") and m.PrimaryPart and m.PrimaryPart.Name == MapNames.PlotFloor then m.PrimaryPart else nil)
		or findPart(m, MapNames.PlotFloor)
	if not floor then
		warnMissing(MapNames.plot(i) .. "." .. MapNames.PlotFloor)
		return nil
	end
	m:SetAttribute("Plot", i)
	local top = floor.Position + Vector3.new(0, floor.Size.Y / 2, 0)
	-- the plot looks toward its sign (it stands at the gate, on the street side); without a sign, toward the map
	-- centre along the plot's main axis
	local signAt = asPart(findAny(m, MapNames.PlotSign))
	local to = if signAt then signAt.Position - top else centre - top
	local dx, dz = to.X, to.Z
	if not signAt then
		if math.abs(dx) >= math.abs(dz) then
			dz = 0
		else
			dx = 0
		end
	end
	if dx * dx + dz * dz < 1 then
		dx, dz = centre.X - top.X, centre.Z - top.Z
	end
	if dx * dx + dz * dz < 1e-4 then
		dz = -1
	end
	local F = facing(top, dx, dz)
	local domes = {}
	for k = 1, MapNames.DomeCount do
		local slot = findAny(m, MapNames.slotParts(k))
		local cf: CFrame? = nil
		local r = 2
		if slot and slot:IsA("BasePart") then
			cf = facing(slot.Position + Vector3.new(0, slot.Size.Y / 2, 0), dx, dz)
			r = math.max(slot.Size.X, slot.Size.Z) / 2
		elseif slot and slot:IsA("Attachment") then
			local p = slot.WorldPosition
			cf = facing(p, dx, dz)
		end
		if cf then
			local scale = slot and slot:GetAttribute("PetScale")
			table.insert(domes, {
				Slot = cf,
				Label = cf * CFrame.new(0, 0.35, -(r * 0.75)) * CFrame.Angles(0, math.pi, 0),
				Scale = if type(scale) == "number" and scale > 0 then scale else math.clamp(r / 2.2, 0.6, 1.3),
			})
		else
			warnMissing(MapNames.plot(i) .. "." .. (MapNames.slotParts(k)[1] or ("slot " .. k)))
		end
	end
	local signInst = findAny(m, MapNames.PlotSign)
	local signPart = asPart(signInst)
	local label: TextLabel? = (if signInst then findLabel(signInst, MapNames.SignText) else nil) or (function()
		local own = find(m, MapNames.OwnerText)
		return if own and own:IsA("TextLabel") then own else nil
	end)()
	-- bug 248: a hand-built sign can carry a big static "FREE PLOT" title next to a small owner line. The big title
	-- becomes the owner line ("<Name>'s Park", fitted), and the other small sign labels hide while the plot is owned.
	local extras: { TextLabel } = {}
	if signInst then
		local title: TextLabel? = nil
		for _, d in signInst:GetDescendants() do
			local up = if d:IsA("TextLabel") then string.upper(d.Text) else ""
			local hit = false
			for _, w in ParkConfig.SignMatch do
				hit = hit or string.find(up, w, 1, true) ~= nil
			end
			if d:IsA("TextLabel") and hit then
				title = d
				break
			end
		end
		if title then
			for _, d in signInst:GetDescendants() do
				if d:IsA("TextLabel") and d ~= title and table.find(MapNames.SignText, d.Name) then
					table.insert(extras, d)
				end
			end
			label = title
			title.TextScaled = true
		end
	end
	if not label and signPart then
		label = faceLabel(signPart, MapNames.OwnerText, ParkConfig.EmptyPlot)
	end
	local likeText = find(m, MapNames.LikeText)
	local likeBase = findPart(m, MapNames.LikePost) or signPart or floor
	local pp = prompt(likeBase, "LikePrompt", "Like", ParkConfig.EmptyPlot, 10)
	pp:SetAttribute("LikePlot", i)
	pp:SetAttribute("Off", true) -- GalleryService turns it on when someone owns the plot
	-- the sign shows the owner's name and, when there is no separate like counter, the likes under it
	local name, likes = ParkConfig.EmptyPlot, 0
	local function draw()
		if label then
			label.Text = if likes > 0 and not likeText then name .. "\n" .. likes .. (if likes == 1 then " LIKE" else " LIKES") else name
		end
		for _, x in extras do
			x.Visible = name == ParkConfig.EmptyPlot
		end
		if likeText and likeText:IsA("TextLabel") then
			likeText.Text = if likes == 1 then "1 LIKE" else tostring(likes) .. " LIKES"
		end
	end
	draw()
	-- Wandering pets roam the whole pen: the Floor's extent seen from the plot frame (the floor may be turned 90
	-- degrees against the frame), less a margin for the fence, posts and stands. The code default box is only the
	-- fallback when the floor is smaller than that default.
	local W = ParkConfig.Showcase.Wander
	local fr, fl = F.RightVector, F.LookVector
	local fx, fz = floor.CFrame.RightVector, floor.CFrame.LookVector
	local hx = math.abs(fr:Dot(fx)) * floor.Size.X / 2 + math.abs(fr:Dot(fz)) * floor.Size.Z / 2
	local hz = math.abs(fl:Dot(fx)) * floor.Size.X / 2 + math.abs(fl:Dot(fz)) * floor.Size.Z / 2
	-- bug 247: a hand-built fence can stand well inside the Floor's edge, so the box is also pulled in to the inner
	-- face of every outer fence run (parts named "...Fence..."); pieces inside the pen are ignored (ParkConfig.yardBox)
	local fences: { ParkConfig.YardFence } = {}
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and string.find(string.lower(d.Name), "fence", 1, true) then
			local lp = F:PointToObjectSpace(d.Position)
			local tx = math.abs(F:VectorToObjectSpace(d.CFrame.RightVector).X) * d.Size.X / 2
				+ math.abs(F:VectorToObjectSpace(d.CFrame.UpVector).X) * d.Size.Y / 2
				+ math.abs(F:VectorToObjectSpace(d.CFrame.LookVector).X) * d.Size.Z / 2
			local tz = math.abs(F:VectorToObjectSpace(d.CFrame.RightVector).Z) * d.Size.X / 2
				+ math.abs(F:VectorToObjectSpace(d.CFrame.UpVector).Z) * d.Size.Y / 2
				+ math.abs(F:VectorToObjectSpace(d.CFrame.LookVector).Z) * d.Size.Z / 2
			table.insert(fences, { X = lp.X, Z = lp.Z, TX = tx, TZ = tz })
		end
	end
	local wander = ParkConfig.yardBox(hx, hz, ParkConfig.Showcase.FloorMargin, fences, 1.5, W)
	return {
		Index = i,
		Root = m,
		Frame = F,
		Plate = label,
		SetLabel = function(text: string)
			name = text
			draw()
		end,
		Domes = domes,
		SetLikes = function(n: number)
			likes = n
			draw()
		end,
		CrownAt = F * CFrame.new(0, ParkConfig.Likes.CrownHeight, 0),
		Wander = wander,
		Shutters = {},
		SetCapacity = function(_n: number) end,
		LabelDepth = 1,
	}
end

-- (exposed for tests)
MapHooks.ensureBookSign = function(map: Instance, lobby: Instance)
	ensureBookSign(map, lobby)
end

function MapHooks.ensure(map: Instance, lobby: Instance, adopt: boolean): { Plots: { any } }
	for _, fn in { ensureHatch, ensureTower, ensureSecretEgg, ensureEggShop } do
		local ok: boolean, err: any = pcall(fn, map)
		if not ok then
			warn("[MapHooks] hook check failed:", err)
		end
	end
	local okQ: boolean, errQ: any = pcall(ensureQueue, map, lobby)
	if not okQ then
		warn("[MapHooks] queue hooks failed:", errQ)
	end
	local plots = {}
	if adopt then
		pcall(ensureWhatsNew, map)
		local okB: boolean, errB: any = pcall(ensureBookSign, map, lobby)
		if not okB then
			warn("[MapHooks] book sign not added:", errB)
		end
		local okS: boolean, errS: any = pcall(ensureSigns, map)
		if not okS then
			warn("[MapHooks] building signs not refitted:", errS)
		end
		pcall(ensureBoards, map, lobby)
		-- the map centre (the plots' gates face it): the middle of the map's bounding box
		local centre = Vector3.zero
		if map:IsA("Model") then
			local ok, cf = pcall(function(): CFrame
				return ((map :: Model):GetBoundingBox()) -- the frame only
			end)
			if ok and cf then
				centre = Vector3.new(cf.Position.X, 0, cf.Position.Z)
			end
		end
		-- Plot1..PlotCount are expected; extra plots the owner adds (Plot7, Plot8, ...) are picked up too
		local i = 0
		while true do
			i += 1
			local m = find(map, MapNames.plot(i))
			if not m and i > MapNames.PlotCount then
				break
			end
			if m then
				local okP, p = pcall(adoptPlot, m, i, centre)
				if okP and p then
					table.insert(plots, p)
				elseif not okP then
					warn("[MapHooks] plot", i, "not adopted:", p)
				end
			else
				warnMissing(MapNames.plot(i))
			end
		end
	end
	return { Plots = plots }
end

return MapHooks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="241">
        <Properties>
          <string name="Name">MatchPlace</string>
          <string name="Source"><![CDATA[--!strict
-- Match side of Teleport mode: one private reserved server runs one party's hunts.
--
-- Arrival: every player is checked against the ticket stored for THIS server's PrivateServerId
-- (never against teleport data). Unknown, expired, consumed or duplicate entries are sent back to
-- the lobby and their profile is never touched. Valid arrivals wait on the arena's spawn pads
-- (WaitingForParty): no tool activity, up to Config.Match.WaitForMembersSeconds for the rest.
-- When everyone is here the hunt starts through the normal MatchService round flow. If members
-- are missing after the wait, the leader picks START WITH ARRIVED or RETURN. A member who arrives
-- after the hunt began without them is turned away (no unfair late join); a roster member who
-- reconnects is let back in and watches the current round (no new target, no extra reward).
-- Leader leaving hands the lead to the earliest remaining member. An empty server marks the
-- ticket consumed and Roblox shuts the reservation down.

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local MatchTicket = require(Shared.MatchTicket)
local TeleportBook = require(Shared.TeleportBook)
local ArrivalGate = require(Shared.ArrivalGate)
local Profiles = require(script.Parent.Profiles)
local MatchService = require(script.Parent.MatchService)
local World = require(script.Parent.WorldBuilder)
local Tickets = require(script.Parent.Tickets)

local MatchPlace = {}

local ticket: MatchTicket.Ticket? = nil
local ticketReady = false
local state = MatchTicket.newState()
local gate: ArrivalGate.Gate? = nil
local arena: { [string]: any } = {}
local party: any = nil -- the party table handed to MatchService once the hunt starts
local starting = false
local consumed = false
-- uid -> token of the return in flight (cleared when it fails); a second Return while one is in flight is ignored
local returning: { [number]: number } = {}
local returnSeq = 0
local returnQueue: { Player } = {}
local returnFlushQueued = false
local reconnecting: { [number]: boolean } = {}

local REJECT_TEXT: { [string]: string } = {
	NoTicket = "This match is not available. Going back to the lobby.",
	Unknown = "This match is not available. Going back to the lobby.",
	NotMember = "You are not part of this party. Going back to the lobby.",
	Consumed = "That match is over. Going back to the lobby.",
	Duplicate = "You are already in this match.",
	Expired = "That match invitation ran out. Going back to the lobby.",
	ReconnectLimit = "You have rejoined too many times. Going back to the lobby.",
	Started = "The hunt began without you. Going back to the lobby.",
	NotExpected = "You are not part of this party. Going back to the lobby.",
	Cancelled = "The leader sent the party back. Going back to the lobby.",
}

local function playerOf(uid: number): Player?
	return Players:GetPlayerByUserId(uid)
end

local function nowClock(): number
	return os.clock()
end

local function toast(p: Player, text: string, kind: string?)
	Net.event("Toast"):FireClient(p, text, kind or "info")
end

-- Returning to the lobby ------------------------------------------------------------------------

local function reacquireAll(players: { Player })
	for _, p in players do
		returning[p.UserId] = nil
		if Profiles.isReleased(p) then
			task.spawn(function()
				if not Profiles.reacquire(p) and p.Parent then
					p:Kick("Your save moved to another server. Please rejoin.")
				end
			end)
		end
	end
end

local function sendBack(players: { Player }, attempt: number?)
	local list: { Player } = {}
	returnSeq += 1
	local token = returnSeq
	-- a player already on their way back is skipped: a second teleport would race the first, and its
	-- failure path would take the save lock back while the first teleport is still landing
	local byId: { [number]: Player } = {}
	local ids: { number } = {}
	for _, p in players do
		if p.Parent then
			table.insert(ids, p.UserId)
			byId[p.UserId] = p
		end
	end
	for _, uid in TeleportBook.takeReturns(returning, ids, token, attempt ~= nil) do
		table.insert(list, byId[uid])
	end
	if #list == 0 then
		return
	end
	-- Hand the saves over first. If a release fails the player still leaves with the normal
	-- release-on-leave save, so the teleport goes ahead (the lobby waits on the lock, bounded).
	for _, p in list do
		if Profiles.isLoaded(p) then
			local ok = Profiles.releaseForTeleport(p)
			if not ok then
				warn("[MatchPlace] release before return failed for", p.UserId)
			end
		end
		Net.event("LaunchEvent"):FireClient(p, "Returning", { Message = "Heading back to the lobby..." })
	end
	local try = attempt or 1
	local options = Instance.new("TeleportOptions")
	local t = ticket
	if try == 1 and t and t.LobbyJobId ~= "" then
		options.ServerInstanceId = t.LobbyJobId -- same lobby server, so the party lands together
	end
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(Config.Places.LobbyPlaceId, list, options)
	end)
	if ok then
		task.delay(Config.Teleport.ReturnWatchdog, function()
			local stuck: { Player } = {}
			for _, p in list do
				if p.Parent and TeleportBook.stillOwns(returning, p.UserId, token) then
					table.insert(stuck, p)
				end
			end
			if #stuck > 0 then
				reacquireAll(stuck)
				for _, p in stuck do
					toast(p, "Could not go back yet. Tap LOBBY to try again.", "warn")
					Net.event("LaunchEvent"):FireClient(p, "ReturnFailed", {})
				end
			end
		end)
		return
	end
	warn("[MatchPlace] return teleport failed:", err)
	if try == 1 then
		sendBack(list, 2) -- one retry without pinning a lobby server (it may be gone)
		return
	end
	reacquireAll(list)
	for _, p in list do
		toast(p, "Could not go back yet. Tap LOBBY to try again.", "warn")
		Net.event("LaunchEvent"):FireClient(p, "ReturnFailed", {})
	end
end

local function queueReturn(p: Player)
	table.insert(returnQueue, p)
	if returnFlushQueued then
		return
	end
	returnFlushQueued = true
	task.defer(function()
		returnFlushQueued = false
		local batch = returnQueue
		returnQueue = {}
		sendBack(batch)
	end)
end

-- Waiting UI ---------------------------------------------------------------------------------------

local function broadcast(force: string?)
	local g, t = gate, ticket
	if not g or not t then
		return
	end
	local now = nowClock()
	local st = g:status(now)
	if not force and (st == "Started" or st == "Cancelled" or st == "Empty" or st == "Idle") then
		return
	end
	local leader = g:leader() or t.Leader
	local members = {}
	for i, uid in t.Members do
		local p = playerOf(uid)
		table.insert(members, {
			UserId = uid,
			Name = if p then p.DisplayName else (t.Names[i] or "?"),
			Arrived = g.Arrived[uid] == true,
			Leader = uid == leader,
		})
	end
	local status = force or st
	if st == "Ready" then
		status = "Loading"
	end
	for uid in g.Arrived do
		local p = playerOf(uid)
		if p then
			Net.event("LaunchEvent"):FireClient(p, "Waiting", {
				Members = members,
				Leader = leader,
				Status = status, -- Waiting | TimedOut | Loading
				Remaining = math.ceil(g:remaining(now)),
				CanStart = st == "TimedOut" and uid == leader,
				CanReturnAll = uid == leader,
				Tier = t.Tier,
			})
		end
	end
end

-- Admission (called by Profiles before it touches a save) ----------------------------------------

local function reject(player: Player, reason: string)
	warn("[MatchPlace] rejected", player.UserId, reason)
	Net.event("LaunchEvent"):FireClient(player, "Rejected", { Message = REJECT_TEXT[reason] or "Going back to the lobby." })
	task.delay(2.5, function()
		if player.Parent then
			sendBack({ player })
		end
	end)
	task.delay(15, function()
		if player.Parent then
			player:Kick("This match is not available for you.")
		end
	end)
end

local function placeOnPad(player: Player)
	local t = ticket
	local spawns = arena.Spawns
	if not t or not spawns then
		return
	end
	local idx = table.find(t.Members, player.UserId) or 1
	local char = player.Character
	if char then
		char:PivotTo(spawns[((idx - 1) % #spawns) + 1])
	end
end

local function admit(player: Player): boolean
	local t0 = os.clock()
	while not ticketReady and os.clock() - t0 < 60 do
		task.wait(0.2)
	end
	local g = gate
	local verdict = MatchTicket.validate(ticket, state, player.UserId, os.time(), Config.Teleport.MaxReconnects)
	if not verdict.Ok or not g then
		reject(player, verdict.Reason or "NoTicket")
		return false
	end
	local ok, why = g:arrive(player.UserId, nowClock())
	if not ok then
		reject(player, why or "NotExpected")
		return false
	end
	MatchTicket.recordArrive(state, player.UserId)
	if verdict.Reconnect then
		reconnecting[player.UserId] = true
	end
	player.CharacterAdded:Connect(function()
		task.wait()
		if MatchService.isBusy(player.UserId) then
			return -- MatchService places players in a running hunt
		end
		placeOnPad(player)
	end)
	if player.Character then
		task.defer(placeOnPad, player)
	end
	Net.event("LaunchEvent"):FireClient(player, "Mode", { Teleport = true })
	broadcast()
	-- Reconnect to a running hunt: come back as a watcher once the save has loaded.
	if g:status(nowClock()) == "Started" then
		task.spawn(function()
			local w = os.clock()
			while player.Parent and not Profiles.isLoaded(player) and os.clock() - w < 40 do
				task.wait(0.25)
			end
			if not player.Parent then
				return
			end
			if Profiles.isLoaded(player) and MatchService.rejoin(player.UserId) then
				Net.event("LaunchEvent"):FireClient(player, "Hide", {})
				toast(player, "Welcome back. You join again from the next round.", "info")
			else
				toast(player, "That hunt is over. Going back to the lobby.", "warn")
				sendBack({ player })
			end
		end)
	end
	return true
end

-- Starting the hunt -----------------------------------------------------------------------------------

local function beginHunt(by: number?)
	local g, t = gate, ticket
	if not g or not t or starting then
		return
	end
	local roster, why = g:start(by, nowClock())
	if not roster then
		if by then
			local p = playerOf(by)
			if p then
				toast(p, if why == "NotLeader" then "Only the party leader can do that." else "Not ready yet.", "warn")
			end
		end
		return
	end
	starting = true
	broadcast("Loading")
	task.spawn(function()
		-- members need their saves (tool, storage) before the countdown; those that fail are kicked
		-- by Profiles and simply drop out
		local w = os.clock()
		while os.clock() - w < 30 do
			local waiting = false
			for _, uid in roster do
				local p = playerOf(uid)
				if p and not Profiles.isLoaded(p) then
					waiting = true
				end
			end
			if not waiting then
				break
			end
			task.wait(0.25)
		end
		local members: { number } = {}
		for _, uid in roster do
			local p = playerOf(uid)
			if p and Profiles.isLoaded(p) then
				table.insert(members, uid)
			end
		end
		if #members == 0 then
			starting = false
			return
		end
		party = {
			Id = t.Id,
			Leader = g:leader() or members[1],
			Members = members,
			Ready = {},
			Tier = t.Tier,
			Locked = false,
			MatchKey = nil,
		}
		for _, uid in members do
			local p = playerOf(uid)
			if p then
				Net.event("LaunchEvent"):FireClient(p, "Hide", {})
			end
		end
		local started, err = false, nil
		for _ = 1, 12 do
			started, err = MatchService.startParty(party)
			if started then
				break
			end
			task.wait(1)
		end
		if not started then
			warn("[MatchPlace] could not start:", err)
			local ps: { Player } = {}
			for _, uid in members do
				local p = playerOf(uid)
				if p then
					toast(p, "Could not start the hunt. Going back to the lobby.", "warn")
					table.insert(ps, p)
				end
			end
			sendBack(ps)
		end
		starting = false
	end)
end

-- Actions from the waiting screen -------------------------------------------------------------------

local function onAction(player: Player, action: any)
	local g = gate
	if not g or not state.Present[player.UserId] then
		return
	end
	local uid = player.UserId
	if action == "Return" then
		if MatchService.isBusy(uid) then
			return -- inside a hunt: the normal LOBBY button (MatchAction) handles it
		end
		sendBack({ player })
	elseif action == "StartWithArrived" then
		if g:status(nowClock()) == "TimedOut" then
			beginHunt(uid)
		end
	elseif action == "ReturnAll" then
		local st = g:status(nowClock())
		if st == "Started" then
			if uid ~= g:leader() then
				return
			end
			local ph = MatchService.phaseOf(uid)
			if ph ~= nil and ph ~= "Results" then
				toast(player, "Finish or leave the round first.", "warn")
				return
			end
			local list: { Player } = {}
			for u in table.clone(state.Present) do
				local p = playerOf(u)
				if p then
					MatchService.removePlayer(u)
					table.insert(list, p)
				end
			end
			sendBack(list)
		else
			local ok = g:cancel(uid, nowClock())
			if ok then
				local list: { Player } = {}
				for u in state.Present do
					local p = playerOf(u)
					if p then
						table.insert(list, p)
					end
				end
				sendBack(list)
			end
		end
	end
end

-- Leaving ---------------------------------------------------------------------------------------------

local function closeTicket()
	if consumed then
		return
	end
	consumed = true
	local t = ticket
	MatchTicket.close(t, state)
	if t then
		Tickets.consume(t.Id)
	end
end

local function onRemoving(player: Player)
	local uid = player.UserId
	returning[uid] = nil
	reconnecting[uid] = nil
	local g = gate
	if not g or not state.Present[uid] then
		return
	end
	MatchTicket.recordLeave(state, uid)
	g:leave(uid)
	if party then
		local lead = g:leader()
		if lead then
			party.Leader = lead -- earliest remaining member
		end
	end
	if next(state.Present) == nil then
		task.spawn(closeTicket) -- empty server: nobody can start a new hunt on this reservation
	else
		broadcast()
	end
end

function MatchPlace.start()
	World.useOriginArena()
	Profiles.setLoadAttempts(Config.Teleport.LoadAttempts)
	Profiles.setJoinGate(admit)
	MatchService.setReturnHandler(queueReturn)
	arena = MatchService.prepareArena(1)
	local spawns = arena.Spawns
	if spawns and spawns[1] then
		local pad = Instance.new("SpawnLocation")
		pad.Name = "CT_Rocks_ReadyPad"
		pad.Anchored = true
		pad.CanCollide = false
		pad.Transparency = 1
		pad.Neutral = true
		pad.Size = Vector3.new(6, 1, 6)
		pad.CFrame = (spawns[1] :: CFrame) * CFrame.new(0, -2.5, 0)
		pad.Parent = workspace
	end

	task.spawn(function()
		local id = game.PrivateServerId
		local t = Tickets.get(id)
		ticket = t
		if t then
			gate = ArrivalGate.new(t.Members, t.Leader, Config.Match.WaitForMembersSeconds)
		else
			warn("[MatchPlace] no ticket for this server (PrivateServerId '" .. id .. "'): refusing everyone")
		end
		ticketReady = true
	end)

	local limit: { [Player]: number } = {}
	Net.event("LaunchAction").OnServerEvent:Connect(function(player, action)
		local t = os.clock()
		if t - (limit[player] or 0) < 0.4 then
			return
		end
		limit[player] = t
		onAction(player, action)
	end)
	Players.PlayerRemoving:Connect(function(player)
		limit[player] = nil
		onRemoving(player)
	end)
	TeleportService.TeleportInitFailed:Connect(function(player, result, message)
		if returning[player.UserId] then
			warn("[MatchPlace] return TeleportInitFailed", player.UserId, tostring(result), tostring(message))
			reacquireAll({ player })
			toast(player, "Could not go back yet. Tap LOBBY to try again.", "warn")
			Net.event("LaunchEvent"):FireClient(player, "ReturnFailed", {})
		end
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			local g = gate
			if g then
				local st = g:status(nowClock())
				if st == "Ready" then
					beginHunt(nil)
				elseif st == "Waiting" or st == "TimedOut" then
					broadcast()
				end
			end
		end
	end)

	game:BindToClose(function()
		if ticket and not consumed then
			closeTicket()
		end
	end)
end

return MatchPlace
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="242">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source"><![CDATA[--!strict
-- Private hunts. Phase 1 runs in "SinglePlace" mode: each party gets its own walled quarry
-- arena in this server (far from the lobby, no paths in). Only party members are moved in and
-- only they can act on the pile. Phase 2 swaps the arena hand-off for a reserved Match place.
--
-- Lifecycle: Countdown (3 s, everyone frozen) -> Searching -> RewardPending -> Reveal ->
-- Results -> (Rematch -> Countdown) or Return to lobby.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local HuntPlacement = require(Shared.HuntPlacement)
local Net = require(Shared.Net)
local RoundRocks = require(Shared.RoundRocks)
local GeodeGen = require(Shared.GeodeGen)
local Profiles = require(script.Parent.Profiles)
local PartyService = require(script.Parent.PartyService)
local Ledger = require(script.Parent.AwardLedger)
local World = require(script.Parent.WorldBuilder)
local ArenaBuilder = require(script.Parent.ArenaBuilder)
local MachineModels = require(script.Parent.MachineModels)
local StationModels = require(script.Parent.StationModels)
local RockService = require(script.Parent.RockService)
local Economy = require(script.Parent.EconomyService)
local HuntLedger = require(Shared.HuntLedger)
local EggEvents = require(script.Parent.EggEvents)
local RareHatch = require(script.Parent.RareHatch)
local WinnerBoard = require(script.Parent.WinnerBoard)
local PetFlair = require(Shared.PetFlair)
local RacerCollision = require(script.Parent.RacerCollision)
local PracticeBots = require(script.Parent.PracticeBots)
local HuntQueue = require(Shared.HuntQueue)
local QueueConfig = require(Shared.QueueConfig)
local FriendBonus = require(script.Parent.FriendBonus)
local Hangout = require(Shared.Hangout)
local LuckEvents = require(Shared.LuckEvents)
local RobuxConfig = require(Shared.RobuxConfig)
local HuntFun = require(Shared.HuntFun)

local MatchService = {}

type Match = {
	Key: string,
	Slot: number,
	Arena: { [string]: any },
	Party: PartyService.Party,
	Round: number,
	Core: any,
	Phase: string,
	EndsAt: number,
	Tutorial: boolean,
	Solo: boolean,
	Present: { [number]: boolean },
	Rematch: { [number]: boolean },
	SpawnRot: number,
	Models: { [number]: Model }, -- machine model per owner
	ModelOf: { [number]: string }, -- machine id each model was built for
	BayOf: { [number]: number }, -- bay index per member for this round
	MachineSent: { [number]: string }, -- last machine state sent per owner
	LastFlush: number,
	Results: any?,
	Ledger: any,
	Start: number,
	SearchStart: number?,
	SearchEnd: number?, -- server time the geode was found (the hunt clock stops there)
	FullWarned: { [number]: number },
	FinishedRound: number?, -- round whose geode was already resolved (finishRound runs once per round)
	FoundRound: number?, -- RockService: round whose Found result was already applied
}

local matches: { [string]: Match } = {}
local matchOf: { [number]: string } = {}
local arenas: { [number]: { [string]: any } } = {}
local slotBusy: { [number]: boolean } = {}
local serverRng = Random.new()
local lobby: { [string]: any } = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function playerOf(uid: number): Player?
	return Players:GetPlayerByUserId(uid)
end

local function send(m: Match, kind: string, payload: any)
	local ev = Net.event("MatchEvent")
	for uid in m.Present do
		local p = playerOf(uid)
		if p then
			ev:FireClient(p, kind, payload)
		end
	end
end

local function memberList(m: Match)
	local out = {}
	for _, uid in m.Party.Members do
		local p = playerOf(uid)
		local core = m.Core and m.Core.Members[uid]
		table.insert(out, {
			UserId = uid,
			Name = if p then p.DisplayName else "?",
			Present = m.Present[uid] == true,
			Cracked = if core then core.Cracked else 0,
			Leader = m.Party.Leader == uid,
			Station = if core then core.Index else nil,
			Rematch = m.Rematch[uid] == true,
		})
	end
	return out
end

local function setFrozen(player: Player, frozen: boolean)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		-- Speed pets (Config.Pets) only count inside a hunt; PetService refuses pet swaps while MatchKey is set, so the
		-- pet that started the hunt is the one whose speed and luck apply.
		local pdata = if player:GetAttribute("MatchKey") ~= nil then Profiles.get(player) else nil
		local speed = if pdata then Profiles.petBoosts(pdata).Speed else 0
		local free = if pdata then Config.Pets.BaseWalkSpeed * (1 + speed) else Config.Lobby.WalkSpeed
		hum.WalkSpeed = if frozen then 0 else free
		hum.JumpPower = if frozen then 0 else 42
	end
end

-- Lobby spawn (docs/m11/CAMERA_SPAWN_FIX.md): every character that appears outside a hunt is put on the lobby spawn
-- pad by the server. Roblox's own spawn placement lifts a character above anything it thinks overlaps the spawn,
-- and a character that spawned before the lobby was built stood at the lodge centre; either way it could end up on
-- the ceiling collider ("I spawn in the roof"). PivotTo does no such lift.
local function toLobbySpawn(player: Player)
	local char = player.Character
	-- A tower climber's respawn is put back on their floor by TowerService (InTower), never on the lobby pad.
	if char and lobby and lobby.Spawn and matchOf[player.UserId] == nil and player:GetAttribute("InTower") ~= true
		and player:GetAttribute("InBattle") ~= true then
		RacerCollision.apply(char, false)
		char:PivotTo(lobby.Spawn)
		-- lobby only: a touch faster than Roblox's 16 (hunts set their own speed; speed boots re-set theirs)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and math.abs(hum.WalkSpeed - 16) < 0.01 then
			hum.WalkSpeed = Config.Lobby.WalkSpeed
		end
	end
end

-- Spawn spot (and machine bay) of a member this round: party order, rotated between rounds.
local function spawnIndex(m: Match, uid: number): number
	local idx = table.find(m.Party.Members, uid) or 1
	return ((idx - 1 + m.SpawnRot) % #m.Arena.Spawns) + 1
end

local function placeAtSpawn(m: Match, player: Player)
	local spawns = m.Arena.Spawns
	-- This round's bay (fixed at round start), so a member who leaves the party mid-round does not shift the others'
	-- respawn spots onto someone else's table; spawnIndex only for someone not in this round's core.
	local uid = player.UserId
	local bay = if m.Core and m.Core.Members[uid] then m.BayOf[uid] else nil
	local cf = spawns[bay or spawnIndex(m, uid)]
	if typeof(m.Arena.Center) == "Vector3" then
		cf = HuntPlacement.faceCentre(cf, m.Arena.Center) -- start every round looking at the egg pile
	end
	local char = player.Character
	if char then
		RacerCollision.apply(char, true) -- hunters pass through each other
		char:PivotTo(cf)
		RockService.resetMotion(player.UserId) -- a server move, not a teleport cheat
	end
end

local function phase(m: Match, name: string, duration: number?)
	m.Phase = name
	m.EndsAt = if duration then now() + duration else 0
	if name ~= "Countdown" and name ~= "Searching" then
		PracticeBots.clear(m.Key) -- practice bots only live while the hunt runs, whatever ended it
	end
	if m.Core then
		m.Core:setPhase(name)
	end
	local frozen = name == "Countdown"
	for uid in m.Present do
		local p = playerOf(uid)
		if p then
			setFrozen(p, frozen)
		end
	end
	send(m, "Phase", { Phase = name, EndsAt = m.EndsAt, Round = m.Round, Members = memberList(m), SearchStart = m.SearchStart, SearchEnd = m.SearchEnd })
end

-- Machines ----------------------------------------------------------------------------------

local function machineList(m: Match): { any }
	local out = {}
	local core = m.Core
	if not core then
		return out
	end
	for uid, mem in core.Members do
		if mem.Machine and mem.Active and m.Present[uid] then
			table.insert(out, { UserId = uid, Bay = m.BayOf[uid], Id = mem.Machine, State = core:machineState(uid) })
		end
	end
	table.sort(out, function(a, b)
		return a.UserId < b.UserId
	end)
	return out
end

-- Tells the match's clients the machine states, only when something changed.
local function broadcastMachines(m: Match, force: boolean?)
	local core = m.Core
	if not core then
		return
	end
	local changed = force == true
	for uid, mem in core.Members do
		local st = if mem.Machine and mem.Active then core:machineState(uid) .. ":" .. mem.Machine else "None"
		if m.MachineSent[uid] ~= st then
			m.MachineSent[uid] = st
			changed = true
		end
	end
	if changed then
		send(m, "Machines", { Round = m.Round, List = machineList(m) })
	end
end

-- Keeps each owner's model in the bay matching the machine the core is running.
local function syncMachineModel(m: Match, uid: number)
	local core = m.Core
	local mem = core and core.Members[uid]
	local want = if mem and mem.Active then mem.Machine else nil
	if m.ModelOf[uid] == want then
		return
	end
	local old = m.Models[uid]
	if old then
		old:Destroy()
		m.Models[uid] = nil
	end
	m.ModelOf[uid] = want
	if want then
		local bayCf = m.Arena.Bays[m.BayOf[uid] or 1]
		local p = playerOf(uid)
		local model = MachineModels.build(want, bayCf, m.Arena.MachineFolder, uid, if p then p.DisplayName else "?")
		if model then
			m.Models[uid] = model
		end
	end
end

local function clearMachineModels(m: Match)
	for _, model in m.Models do
		model:Destroy()
	end
	table.clear(m.Models)
	table.clear(m.ModelOf)
	local folder = m.Arena.MachineFolder
	if folder then
		folder:ClearAllChildren()
	end
end

local function initPayload(m: Match)
	local core = m.Core
	local payload = {
		Key = m.Key,
		Round = m.Round,
		Tier = core.Tier,
		Seed = core.Seed,
		Tutorial = m.Tutorial,
		Center = m.Arena.Center,
		Phase = m.Phase,
		EndsAt = m.EndsAt,
		SearchStart = m.SearchStart,
		SearchEnd = m.SearchEnd,
		Members = memberList(m),
		Machines = machineList(m),
		Hp = {}, -- pre-V3 field: progress now lives in Stations[i].Progress
	}
	-- pile layout (Stacks), what left it (Removed), stations, tables and counters: ids and states only
	for k, v in RockService.initFields(m) do
		payload[k] = v
	end
	return payload
end

local function startRound(m: Match)
	m.Round += 1
	m.SearchStart, m.SearchEnd = nil, nil -- the hunt clock restarts with this round's Searching phase
	table.clear(m.Rematch)
	m.Results = nil
	local members = {}
	for _, uid in m.Party.Members do
		if m.Present[uid] then
			local p = playerOf(uid)
			local data = p and Profiles.get(p)
			local machine = nil
			if Config.MachinesEnabled and data and data.InstalledMachine and data.EquipmentOwned[data.InstalledMachine] then
				machine = data.InstalledMachine
			end
			local station = spawnIndex(m, uid) -- spawn spot = crushing table = machine bay, same index
			m.BayOf[uid] = station
			table.insert(members, {
				UserId = uid,
				Tool = if data then data.EquippedHandheld else "Hammer",
				Machine = machine,
				Station = station,
			})
		end
	end
	m.Solo = #members == 1
	local tutorial = false
	if m.Solo then
		local p = playerOf(members[1].UserId)
		local data = p and Profiles.get(p)
		tutorial = data ~= nil and data.TutorialStep == 0
	end
	m.Tutorial = tutorial
	if tutorial then
		Profiles.onboard(playerOf(members[1].UserId) :: Player, "Started")
	end
	m.Ledger = HuntLedger.new()
	local tier = if tutorial then Config.Tutorial.Tier else m.Party.Tier
	-- the reused arena takes this round's zone look (ground, boundary tint, landmarks); scenery never blocks a round
	local okZone, zoneErr = pcall(function()
		ArenaBuilder.applyZone(m.Arena, tier)
		return nil
	end)
	if not okZone then
		warn("[MatchService] zone scenery failed: " .. tostring(zoneErr))
	end
	m.Core = RoundRocks.new({
		MatchKey = m.Key,
		RoundId = m.Round,
		Tier = tier,
		Seed = serverRng:NextInteger(1, 2 ^ 30),
		TargetRng = Random.new(serverRng:NextInteger(1, 2 ^ 30)),
		Members = members,
		Tutorial = tutorial,
	})
	for _, mem in members do
		RockService.refreshSpace(m, mem.UserId)
	end
	-- tables: owners' names and accents on, the rest stay calm (plain "TABLE n")
	for i, tbl in m.Arena.Tables do
		local owner: number? = nil
		for _, mem in members do
			if mem.Station == i then
				owner = mem.UserId
			end
		end
		local p = if owner then playerOf(owner) else nil
		StationModels.setOwner(tbl, owner, if p then p.DisplayName else nil)
	end
	-- the practice pile: friendly bots race at the free nests (scenery only, they can never find the pet)
	if tutorial then
		local used: { [number]: boolean } = {}
		for _, mem in members do
			used[mem.Station] = true
		end
		PracticeBots.spawn(m.Key, m.Arena, used)
	else
		PracticeBots.clear(m.Key)
	end
	clearMachineModels(m)
	table.clear(m.MachineSent)
	for _, mem in members do
		syncMachineModel(m, mem.UserId)
	end
	m.Start = now()
	m.FullWarned = {}
	for uid in m.Present do
		local p = playerOf(uid)
		if p then
			placeAtSpawn(m, p)
		end
	end
	m.Phase = "Countdown"
	m.EndsAt = now() + Config.Match.CountdownSeconds
	send(m, "Init", initPayload(m))
	phase(m, "Countdown", Config.Match.CountdownSeconds)
	m.SpawnRot += 1 -- next round starts from rotated spots
end

-- The profile's rubble bag as the results screen shows it: count, capacity and what the bag would sell for.
local function bagOf(p: Player?): { Count: number, Capacity: number, Value: number }
	local data = p and Profiles.get(p)
	if not data then
		return { Count = 0, Capacity = 0, Value = 0 }
	end
	return { Count = Profiles.rubbleTotal(data), Capacity = Profiles.capacity(data), Value = Profiles.rubbleValue(data) }
end

local leaveMatch: (number, boolean) -> ()

local COMMON_ONLY = { Common = 1 } -- rarity table for practice and bonus pets

-- Helpers' lucky common: a non-finder who cracked enough eggs this round may get a Common pet of the zone.
-- Server-rolled; granted as "Bonus" (no win or find stat, never auto-follows) under its own award key.
local function rollBonusPets(m: Match, core: any, winnerUid: number, tierId: string, awardKey: string): { [number]: string }
	local out: { [number]: string } = {}
	if m.Tutorial then
		return out
	end
	for uid, mem in core.Members do
		local p = playerOf(uid)
		local data = p and Profiles.get(p)
		local eligible = p and data and mem.Active and Profiles.isLoaded(p) and not Profiles.isReleased(p)
			and HuntQueue.bonusEligible(mem.Cracked or 0, uid == winnerUid, m.Tutorial, QueueConfig.Bonus.MinCracked)
			and serverRng:NextNumber() < QueueConfig.Bonus.Chance
		local full = eligible and #(data :: any).InventoryGeodes >= Profiles.petCapacity(data)
		if full then
			-- the bonus is skipped, but never silently
			task.delay(Config.Match.RevealSeconds, function()
				if p and p.Parent then
					PartyService.toast(p, "Your Pet Book is full, so a bonus pet was missed. Sell or release a pet!", "warn")
				end
			end)
		end
		if p and data and eligible and not full then
			-- rolled from a Common-only table, so the species is a Common one too (never a Common chase pet)
			local pet = GeodeGen.roll(Random.new(serverRng:NextInteger(1, 2 ^ 30)), tierId, HttpService:GenerateGUID(false), awardKey, os.time(), true, 0, COMMON_ONLY)
			pet.Modifier = Config.Modifiers[1]
			pet.Value = GeodeGen.value(tierId, pet.Rarity, pet.Modifier, pet.Mass, pet.Shiny)
			if Profiles.grantSpecimen(p, awardKey .. ":bonus:" .. uid, pet, "Bonus") then
				local name = GeodeGen.displayName(pet)
				out[uid] = name
				task.delay(Config.Match.RevealSeconds, function() -- after the finder's reveal, not over it
					if p.Parent then
						PartyService.toast(p, "Lucky! You found a Common " .. name .. " in your eggs!", "rare")
					end
				end)
			end
		end
	end
	return out
end

-- Prizes for everyone (owner pick 2026-10-15, shared/HuntFun.Prizes): the racers who did not find the pet get a medal
-- by eggs finished, coins and pet XP, paid now (before the award yields) so a racer who leaves keeps them.
local function payPrizes(m: Match, core: any, winnerUid: number, tierId: string): { [number]: HuntFun.Prize }
	if m.Tutorial then
		return {}
	end
	local racers = {}
	for uid, mem in core.Members do
		if mem.Active then
			table.insert(racers, { UserId = uid, Eggs = mem.Cracked or 0 })
		end
	end
	local prizes = HuntFun.prizes(racers, winnerUid, tierId)
	for uid, prize in prizes do
		local p = playerOf(uid)
		local data = p and Profiles.get(p)
		if p and data and uid ~= winnerUid and Profiles.isLoaded(p) and not Profiles.isReleased(p) then
			data.Cash += prize.Coins
			if RockService.onPetXp then
				RockService.onPetXp(p, prize.Xp)
			end
			Profiles.changed(p, true)
		end
	end
	return prizes
end

local function finishRound(m: Match, winnerUid: number, rockId: number)
	-- Exactly one finish per round: a second report (duplicate result, late callback) changes nothing.
	if m.FinishedRound == m.Round or not m.Core then
		return
	end
	m.FinishedRound = m.Round
	PracticeBots.clear(m.Key) -- the pet is found: the practice bots step off for the reveal
	RockService.flush(m)
	HuntLedger.close(m.Ledger) -- later sales no longer count as "this hunt"
	local core = m.Core
	local awardKey = m.Key .. ":" .. m.Round
	local tierId = core.Tier
	local kind = if m.Tutorial then "Tutorial" elseif m.Solo then "Solo" else "Multiplayer"
	local winner = playerOf(winnerUid)
	m.SearchEnd = now()
	phase(m, "RewardPending")
	send(m, "Found", { Round = m.Round, RockId = rockId, Winner = winnerUid, WinnerName = if winner then winner.DisplayName else "?" })

	-- Hold the winner's profile open until the prize is saved, even if they leave right now.
	if winner then
		Profiles.hold(winner)
	end
	-- The award runs under pcall: an error (roll, ledger, reveal) must never leave the winner's profile held
	-- or the phase stuck at RewardPending. The hold is released exactly once, whatever happens.
	local held = winner ~= nil
	local function release()
		if held and winner then
			held = false
			Profiles.unhold(winner)
		end
	end
	local round = m.Round
	-- Helpers' bonus pets are rolled and granted now, before the award below yields on the DataStore: a helper who
	-- leaves the server during that wait still has the pet in their profile when it is saved on the way out.
	local bonusOk, bonusRes = pcall(rollBonusPets, m, core, winnerUid, tierId, awardKey)
	local bonusPets: { [number]: string } = if bonusOk then bonusRes else {}
	if not bonusOk then
		warn("[MatchService] bonus pets for " .. awardKey .. " failed: " .. tostring(bonusRes))
	end
	local prizeOk, prizeRes = pcall(payPrizes, m, core, winnerUid, tierId)
	local prizes: { [number]: HuntFun.Prize } = if prizeOk then prizeRes else {}
	if not prizeOk then
		warn("[MatchService] hunt prizes for " .. awardKey .. " failed: " .. tostring(prizeRes))
	end
	task.spawn(function()
		local ok, err = pcall(function()
			local wdata = winner and Profiles.get(winner)
			local luck = if wdata then Profiles.petBoosts(wdata).Luck else 0
			-- friend bonus (QueueConfig.FriendLuck): Roblox friends of the finder in this server lift the odds a little
			local friendLuck = 0
			if winner and not m.Tutorial then
				friendLuck = FriendBonus.luck(winner) -- added below by LuckEvents.total
				-- Roblox group members (lobby hangout idea 10; LobbyHangout sets GroupMember from GroupService)
				friendLuck += Hangout.groupLuck(winner:GetAttribute("GroupMember") == true)
			end
			-- Robux luck potion + weekend 2x luck + luck storm (LuckEvents); every source adds up, the total is clamped.
			local storm = game:GetService("ReplicatedStorage"):GetAttribute("LuckStormUntil")
			local timed = LuckEvents.timed(os.time(), if wdata then tonumber(wdata.Robux.LuckUntil) else 0, if type(storm) == "number" then storm else 0)
			local eventLuck = timed.Potion + timed.Weekend + timed.Storm + timed.Hour
			luck = LuckEvents.total({ Pet = luck, Friends = friendLuck, Potion = timed.Potion, Weekend = timed.Weekend, Storm = timed.Storm, Hour = timed.Hour, Vip = if wdata then RobuxConfig.vipLuck(wdata.Robux) else 0 })
			local specimen = GeodeGen.roll(Random.new(serverRng:NextInteger(1, 2 ^ 30)), tierId, HttpService:GenerateGUID(false), awardKey, os.time(), kind ~= "Multiplayer", luck, if m.Tutorial then COMMON_ONLY else nil)
			if m.Tutorial then
				-- the practice pile always gives a plain Common pet (never a 1-in-1000 chase pet on the first round)
				specimen.Modifier = Config.Modifiers[1]
				specimen.Shiny = nil
				specimen.Value = GeodeGen.value(tierId, specimen.Rarity, specimen.Modifier, specimen.Mass, specimen.Shiny)
			end
			local offline = winner ~= nil and Profiles.isOffline(winner)
			if not m.Tutorial and not offline then
				-- Durable decision first; the stored entry is canonical if one already exists.
				local entry = Ledger.record(awardKey, winnerUid, specimen)
				specimen = entry.Specimen or specimen
			end
			local stillHere = winner ~= nil and Profiles.isLoaded(winner)
			if stillHere then
				Ledger.apply(winner :: Player, awardKey, specimen, kind)
				if m.Tutorial then
					local data = Profiles.get(winner :: Player)
					if data then
						data.TutorialStep = math.max(data.TutorialStep, 1)
						Profiles.changed(winner :: Player)
					end
				end
			elseif not m.Tutorial and not offline then
				Ledger.ensurePending(winnerUid, awardKey)
			end
			release()
			-- Stats for everyone who took part (not the practice pile).
			for uid, mem in core.Members do
				local p = playerOf(uid)
				local data = p and Profiles.get(p)
				if data and not m.Tutorial and mem.Active then
					data.Stats.MatchesPlayed += 1
					Profiles.changed(p :: Player, true)
				end
			end
			if matches[m.Key] ~= m then
				return nil
			end
			-- the reveal lasts as long as this rarity's hatch (about 2 s, Rare+ about 6 s slow motion; Config.Hatch)
			local revealFor = PetFlair.revealSeconds(specimen.Rarity)
			phase(m, "Reveal", revealFor)
			-- Owner: rare hatches get fireworks and a gold banner in this server and a banner in every other server
			-- (RareHatch), after the finder's own reveal has played.
			if not m.Tutorial and winner and Config.Pets.AnnounceRarities[specimen.Rarity] then
				local finder: Player, hatched = winner, specimen
				task.delay(revealFor, function()
					RareHatch.announce(finder, hatched)
				end)
			end
			if not m.Tutorial and winner then
				WinnerBoard.record(winner.DisplayName, GeodeGen.displayName(specimen), specimen.Rarity) -- lobby LAST WINNERS (memory only)
			end
			local results = {
				Round = m.Round,
				Winner = winnerUid,
				WinnerName = if winner then winner.DisplayName else "?",
				Kind = kind,
				Specimen = GeodeGen.public(specimen),
				Tier = tierId,
				Elapsed = if m.SearchStart and m.SearchEnd then math.max(0, m.SearchEnd - m.SearchStart) else nil, -- informational only
				Members = {},
				FriendLuck = friendLuck, -- extra Luck the finder had from Roblox friends in the server (informational)
				EventLuck = eventLuck, -- potion + weekend + storm luck before the clamp (informational)
			}
			for uid, mem in core.Members do
				local p = playerOf(uid)
				-- the results row is the ledger snapshot plus who it is (a wider record than HuntLedger.Snapshot)
				local snap: { [string]: any } = HuntLedger.snapshot(m.Ledger, uid, bagOf(p), if uid == winnerUid then specimen.Value else nil) :: any
				snap.UserId = uid
				snap.Name = if p then p.DisplayName else "?"
				snap.Winner = uid == winnerUid
				snap.BonusPet = bonusPets[uid] -- "Common <name>" a helper found in their eggs (nil for most)
				snap.Prize = prizes[uid] -- medal, coins and pet XP for the racers who did not find the pet (shared/HuntFun)
				table.insert(results.Members, snap)
			end
			m.Results = results
			send(m, "Reveal", results)
			task.wait(revealFor)
			if matches[m.Key] == m and m.Phase == "Reveal" then
				phase(m, "Results")
				send(m, "Results", results)
				-- Idle parties must not hold an arena forever.
				task.delay(Config.Match.ResultsReturnSeconds, function()
					if matches[m.Key] == m and m.Round == round and m.Phase == "Results" then
						for uid in table.clone(m.Present) do
							leaveMatch(uid, true)
						end
					end
				end)
			end
			return nil -- explicit value: under --!strict pcall then types as (boolean, any)
		end)
		release()
		if not ok then
			warn("[MatchService] finishing round " .. awardKey .. " failed: " .. tostring(err))
			if matches[m.Key] == m and m.Round == round and (m.Phase == "RewardPending" or m.Phase == "Reveal") then
				for uid in table.clone(m.Present) do
					local p = playerOf(uid)
					if p then
						PartyService.toast(p, "Something went wrong finishing this hunt. Back to the lobby.", "warn")
					end
					leaveMatch(uid, true)
				end
			end
		end
	end)
end

-- Hopper sales: the hunt counters take what the server really sold; a sale after the snapshot only
-- refreshes the bag figures (never the hunt counters) so the results screen is not stale.
Economy.setSaleListener(function(player: Player, count: number, cash: number)
	local m = matches[matchOf[player.UserId] or ""]
	if not m or not m.Ledger then
		return
	end
	HuntLedger.sold(m.Ledger, player.UserId, count, cash)
	if m.Results and (m.Phase == "Results" or m.Phase == "Reveal") then
		for _, row in m.Results.Members do
			if row.UserId == player.UserId then
				local bag = bagOf(player)
				row.BagCount, row.BagCapacity, row.BagValue = bag.Count, bag.Capacity, bag.Value
				Net.event("MatchEvent"):FireClient(player, "ResultsBag", { Round = m.Round, Bag = bag })
			end
		end
	end
end)

local function endMatch(m: Match)
	PracticeBots.clear(m.Key)
	clearMachineModels(m)
	for _, tbl in m.Arena.Tables do
		StationModels.setOwner(tbl, nil, nil)
	end
	matches[m.Key] = nil
	slotBusy[m.Slot] = false
	-- an extra arena that stays empty is taken down (every client holds its parts; Config.Match.ArenaIdleSeconds)
	local slot, built = m.Slot, m.Arena
	if slot > Config.Match.ArenaKeepWarm then
		task.delay(Config.Match.ArenaIdleSeconds, function()
			if not slotBusy[slot] and arenas[slot] == built then
				arenas[slot] = nil
				local root = built.Root
				if typeof(root) == "Instance" then
					root:Destroy()
				end
			end
		end)
	end
	for uid in m.Present do
		matchOf[uid] = nil
	end
	if PartyService.get(m.Party.Id) == m.Party then
		PartyService.setLocked(m.Party, false, nil)
	end
end

-- Teleport mode: the Match place sets this so "back to the lobby" is a teleport. Nil = the
-- Phase 1 single-place behaviour (walk back to the lobby spawn).
local returnHandler: ((Player) -> ())? = nil

function MatchService.setReturnHandler(fn: (Player) -> ())
	returnHandler = fn
end

local function sendToLobby(player: Player)
	local handler = returnHandler
	if handler then
		player:SetAttribute("MatchKey", nil)
		Net.event("MatchEvent"):FireClient(player, "Left", {})
		handler(player)
		return
	end
	player:SetAttribute("MatchKey", nil)
	setFrozen(player, false)
	local char = player.Character
	RacerCollision.apply(char, false)
	if char and lobby.Spawn then
		char:PivotTo(lobby.Spawn * CFrame.new(math.random(-6, 6), 0, math.random(-3, 3)))
	end
	Net.event("MatchEvent"):FireClient(player, "Left", {})
end

-- Removes a member from the hunt (return to lobby, disconnect). Party membership is kept
-- unless they left the game.
function leaveMatch(uid: number, toLobby: boolean)
	local key = matchOf[uid]
	local m = key and matches[key]
	if not m then
		return
	end
	matchOf[uid] = nil
	m.Present[uid] = nil
	m.Rematch[uid] = nil
	if m.Core and (m.Phase == "Countdown" or m.Phase == "Searching") then
		RockService.leave(m, uid) -- forfeits this hunt; resolved rubble stays; carried, queued and plate rocks go back to the pile
		syncMachineModel(m, uid)
	end
	local p = playerOf(uid)
	if p and toLobby then
		sendToLobby(p)
	end
	local anyone = next(m.Present) ~= nil
	if not anyone then
		endMatch(m)
		return
	end
	send(m, "Members", { Members = memberList(m) })
	broadcastMachines(m)
end

-- Match place helpers (Teleport mode). A member leaves the hunt without any lobby walk-back.
function MatchService.removePlayer(uid: number)
	leaveMatch(uid, false)
end

-- A roster member came back to the same live Match server. They watch the current round (their
-- seat in it was given up when they left: no second target, no extra reward) and play again from
-- the next round. Returns false when no hunt of theirs is running any more.
function MatchService.rejoin(uid: number): boolean
	local p = playerOf(uid)
	if not p or matchOf[uid] then
		return p ~= nil and matchOf[uid] ~= nil
	end
	for key, m in matches do
		if table.find(m.Party.Members, uid) then
			m.Present[uid] = true
			matchOf[uid] = key
			p:SetAttribute("MatchKey", key)
			placeAtSpawn(m, p)
			if m.Core then
				Net.event("MatchEvent"):FireClient(p, "Init", initPayload(m))
				if m.Results and (m.Phase == "Results" or m.Phase == "Reveal") then
					Net.event("MatchEvent"):FireClient(p, "Results", m.Results)
				end
			end
			send(m, "Members", { Members = memberList(m) })
			return true
		end
	end
	return false
end

-- Match place: build the single arena up front so arrivals wait on its spawn pads.
function MatchService.prepareArena(slot: number): { [string]: any }
	if not arenas[slot] then
		arenas[slot] = World.buildArena(slot)
	end
	return arenas[slot]
end

function MatchService.phaseOf(uid: number): string?
	local key = matchOf[uid]
	local m = key and matches[key]
	return if m then m.Phase else nil
end

-- The live match a user is in (server-side only; offline tests in tests/server use it to inspect state).
function MatchService.matchFor(uid: number): Match?
	local key = matchOf[uid]
	return if key then matches[key] else nil
end

function MatchService.isBusy(uid: number): boolean
	return matchOf[uid] ~= nil
end

local function freeSlot(): number?
	for i = 1, Config.Match.MaxArenas do
		if not slotBusy[i] then
			return i
		end
	end
	return nil
end

function MatchService.startParty(party: PartyService.Party): (boolean, string?)
	for _, uid in party.Members do
		if matchOf[uid] then
			return false, "Someone is still in a hunt."
		end
		local p = playerOf(uid)
		if not p or not p.Character then
			return false, "Waiting for every member to spawn."
		end
	end
	local slot = freeSlot()
	if not slot then
		return false, "All quarries are busy. Try again in a moment."
	end
	slotBusy[slot] = true
	if not arenas[slot] then
		-- A builder error must not leak the slot or leave half an arena behind (it would block every later start).
		local ok, built = pcall(World.buildArena, slot)
		if not ok then
			slotBusy[slot] = false
			local half = Workspace:FindFirstChild("CT_Rocks_Arena_" .. slot)
			if half then
				half:Destroy()
			end
			warn("[MatchService] arena build failed: " .. tostring(built))
			return false, "Could not build the hunt area. Try again."
		end
		arenas[slot] = built
	end
	local key = HttpService:GenerateGUID(false)
	local m: Match = {
		Key = key,
		Slot = slot,
		Arena = arenas[slot],
		Party = party,
		Round = 0,
		Core = nil,
		Phase = "Waiting",
		EndsAt = 0,
		Tutorial = false,
		Solo = false,
		Present = {},
		Rematch = {},
		SpawnRot = 0,
		Models = {},
		ModelOf = {},
		BayOf = {},
		MachineSent = {},
		LastFlush = 0,
		Results = nil,
		Start = 0,
		FullWarned = {},
	}
	matches[key] = m
	for _, uid in party.Members do
		m.Present[uid] = true
		matchOf[uid] = key
		local p = playerOf(uid) :: Player
		p:SetAttribute("MatchKey", key)
	end
	if PartyService.get(party.Id) == party then
		PartyService.setLocked(party, true, key)
	end
	startRound(m)
	return true, nil
end

local function onRockAction(player: Player, action: any, round: any, rockId: any)
	local key = matchOf[player.UserId]
	local m = key and matches[key]
	if m then
		RockService.action(m, player, action, round, rockId)
	end
end

local function step()
	local t = os.clock()
	for _, m in matches do
		if m.Phase == "Countdown" and now() >= m.EndsAt then
			m.SearchStart = now()
			phase(m, "Searching")
		end
		if m.Phase ~= "Searching" then
			continue
		end
		RockService.step(m, t)
		EggEvents.step(m, t) -- wobble hint
		if m.Phase == "Searching" then
			for uid in m.Present do
				syncMachineModel(m, uid) -- a swap lands here
			end
			broadcastMachines(m)
		end
	end
end

local SYNC_GAP = 2
local lastSync: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any

local function onMatchAction(player: Player, action: any)
	local uid = player.UserId
	local key = matchOf[uid]
	local m = key and matches[key]
	if not m then
		return
	end
	if action == "Return" then
		leaveMatch(uid, true)
	elseif action == "Rematch" then
		if m.Phase == "Results" or m.Phase == "Reveal" then
			m.Rematch[uid] = not m.Rematch[uid]
			send(m, "Members", { Members = memberList(m) })
		end
	elseif action == "StartRematch" then
		if m.Phase ~= "Results" then
			return
		end
		-- leader = party leader if present, else earliest present member
		local leader = m.Party.Leader
		if not m.Present[leader] then
			for _, u in m.Party.Members do
				if m.Present[u] then
					leader = u
					break
				end
			end
		end
		if uid ~= leader then
			return
		end
		for u in m.Present do
			if u ~= leader and not m.Rematch[u] then
				PartyService.toast(player, "Waiting for everyone to tap REMATCH.", "warn")
				return
			end
			local p = playerOf(u)
			local data = p and Profiles.get(p)
			if data and #data.InventoryGeodes >= Profiles.petCapacity(data) then
				PartyService.toast(player, (p :: Player).DisplayName .. "'s Pet Book is full.", "warn")
				return
			end
		end
		startRound(m)
	elseif action == "Sync" then
		-- a full Init is big: at most one per SYNC_GAP seconds per player
		local t = os.clock()
		if t - (lastSync[player] or -math.huge) < SYNC_GAP then
			return
		end
		lastSync[player] = t
		if m.Core then
			Net.event("MatchEvent"):FireClient(player, "Init", initPayload(m))
			EggEvents.resend(m, player) -- the overtime glow, if it is already on
			if m.Results and (m.Phase == "Results" or m.Phase == "Reveal") then
				Net.event("MatchEvent"):FireClient(player, "Results", m.Results)
			end
		end
	end
end

-- Machine install / start-stop from the shop or the bay panel. An install during a batch waits
-- for that batch to resolve (the core keeps it pending), so a swap never resets a cooldown.
function MatchService.machineChanged(player: Player, kind: string, id: string?)
	local uid = player.UserId
	local key = matchOf[uid]
	local m = key and matches[key]
	local core = m and m.Core
	if not m or not core then
		return
	end
	local mem = core.Members[uid]
	if not mem or not mem.Active then
		return
	end
	if kind == "Install" then
		local data = Profiles.get(player)
		if id and data and Config.MachinesEnabled and data.EquipmentOwned[id] then
			core:setMachine(uid, id)
			syncMachineModel(m, uid)
		end
	elseif kind == "Toggle" and mem.Machine then
		core:setMachineRunning(uid, not mem.Running, os.clock())
	end
	broadcastMachines(m)
end

-- Equipped tool changes mid-hunt apply to the next strike; cadence is not reset.
function MatchService.toolChanged(player: Player, tool: string)
	local key = matchOf[player.UserId]
	local m = key and matches[key]
	if m and m.Core then
		m.Core:setTool(player.UserId, tool)
	end
end

-- Studio-only dev shortcut (DevCommands.server, "/endround"): ends the caller's hunt round as if they found the pet
-- egg, through the normal finishRound path (award, results). Refused outside Studio.
function MatchService.devEndRound(player: Player): (boolean, string)
	if not RunService:IsStudio() then
		return false, "studio only"
	end
	local key = matchOf[player.UserId]
	local m = key and matches[key]
	if not m or not m.Core then
		return false, "not in a hunt"
	end
	if m.Phase ~= "Searching" then
		return false, "round is not running (" .. m.Phase .. ")"
	end
	local target = m.Core.TargetId
	finishRound(m, player.UserId, if type(target) == "number" then target else 1)
	return true, "round ended"
end

-- Studio-only dev shortcut (DevCommands.server, "/zone <name>"): shows hunt zone `name` (a zone name such as Forest
-- or a tier id such as Quarry, any case) on an arena. In a hunt it re-skins your own arena (looks only; the round's
-- rules stay); otherwise it skins a free arena and moves you onto its spawn pad. applyZone takes the arena record
-- ({ Root, Center, ... }), never the CT_Rocks_Arena_N model. Refused outside Studio.
function MatchService.devZone(player: Player, name: string): (boolean, string)
	if not RunService:IsStudio() then
		return false, "studio only"
	end
	local valid = {}
	local tierId: string? = nil
	for _, id in Config.TierOrder do
		local zoneName = Config.Tiers[id].Name
		table.insert(valid, string.lower(zoneName))
		if string.lower(name) == string.lower(zoneName) or string.lower(name) == string.lower(id) then
			tierId = id
		end
	end
	if not tierId then
		return false, "unknown zone '" .. name .. "'. Try: " .. table.concat(valid, ", ")
	end
	local zoneName = Config.Tiers[tierId].Name
	local key = matchOf[player.UserId]
	local m = key and matches[key]
	local arena = m and m.Arena
	local move = false
	if not arena then
		local slot = freeSlot()
		if not slot then
			return false, "no free arena"
		end
		if not arenas[slot] then
			local ok, built = pcall(World.buildArena, slot)
			if not ok then
				return false, "arena build failed: " .. tostring(built)
			end
			arenas[slot] = built
		end
		arena = arenas[slot]
		move = true
	end
	local zoneArena = arena :: { [string]: any }
	local ok, err = pcall(function()
		ArenaBuilder.applyZone(zoneArena, tierId)
		return nil
	end)
	if not ok then
		return false, "zone failed: " .. tostring(err)
	end
	if move then
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local spawns = zoneArena.Spawns
		if char and root and root:IsA("BasePart") and type(spawns) == "table" and typeof(spawns[1]) == "CFrame" then
			char:PivotTo(spawns[1])
		end
		return true, zoneName .. " shown on an empty arena (you were moved there)"
	end
	return true, zoneName .. " shown on your hunt arena (looks only)"
end

function MatchService.start(lobbyInfo)
	lobby = lobbyInfo
	PartyService.onStart(MatchService.startParty)
	PartyService.setBusyCheck(MatchService.isBusy)
	-- The only gameplay remote of the V3 loop. There is no pile-damage remote any more.
	Net.event("RockAction").OnServerEvent:Connect(onRockAction)
	RockService.onFound(finishRound)
	local actLimit: { [Player]: number } = {}
	Net.event("MatchAction").OnServerEvent:Connect(function(player, action)
		local t = os.clock()
		if t - (actLimit[player] or 0) < 0.25 then
			return
		end
		actLimit[player] = t
		onMatchAction(player, action)
	end)
	-- Start / stop panel on the machine; only the owner's press counts.
	local promptLimit: { [Player]: number } = {}
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		if not prompt:GetAttribute("MachineToggle") then
			return
		end
		local t = os.clock()
		if t - (promptLimit[player] or 0) < 0.4 then
			return
		end
		promptLimit[player] = t
		local model = if prompt.Parent then prompt.Parent.Parent else nil
		if not model or model:GetAttribute("OwnerId") ~= player.UserId then
			PartyService.toast(player, "Only the owner can start or stop this machine.", "warn")
			return
		end
		MatchService.machineChanged(player, "Toggle", nil)
	end)
	Players.PlayerRemoving:Connect(function(player)
		promptLimit[player] = nil
		actLimit[player] = nil
		RockService.forget(player)
		leaveMatch(player.UserId, false)
	end)
	local function hook(player: Player)
		player.CharacterAdded:Connect(function()
			task.wait()
			local key = matchOf[player.UserId]
			local m = key and matches[key]
			if m then
				RockService.characterReset(m, player.UserId) -- a reset drops the basket back on the pile
				placeAtSpawn(m, player)
				setFrozen(player, m.Phase == "Countdown")
			else
				toLobbySpawn(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in Players:GetPlayers() do
		hook(p)
		toLobbySpawn(p) -- a character that appeared before the lobby existed
	end
	RacerCollision.start()
	-- Fall safety (about once a second): anyone far below the ground goes back to their hunt spot or the lobby spawn.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, p in Players:GetPlayers() do
				local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") and root.Position.Y < -40 then
					local key = matchOf[p.UserId]
					local m = key and matches[key]
					if m then
						placeAtSpawn(m, p)
					else
						toLobbySpawn(p)
					end
				end
			end
		end
	end)
	RunService.Heartbeat:Connect(step)
end

return MatchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="243">
        <Properties>
          <string name="Name">MeadowKit</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED by lobby_blender/meadow_kit.py (Blender). ModuleScript: ServerScriptService.Server.MeadowKit
-- (next to ArenaKit). Soft meadow props for the hunt arena: trees, bushes, hills, hedges, flowers, boulder, fern.
-- Needs the imported roblox/MeadowKit.fbx model in ServerStorage named "MeadowKit". Without it, has() is false and
-- ArenaKit builds its old ball-and-block props.
-- Each kit: natural size in studs (x width, y height, z depth) and its parts:
--   { mesh name, role (part name in game), offset from the base centre, size, Roblox material, colour }

local ServerStorage = game:GetService("ServerStorage")

type PartRow = { any }
type KitDef = { size: { number }, parts: { PartRow } }

local KITS: { [string]: KitDef } = {
	Tree_A = { size = {14.433,14.781,11.256}, parts = {
		{"Tree_A__Trunk0","Trunk",{0.237,4.661,0.198},{7.437,10.057,4.269},"Wood","#7A4E2C"},
		{"Tree_A__Crown1","Crown",{0,10.829,0},{14.433,7.903,11.256},"SmoothPlastic","#3F9E2E"},
	} },
	Tree_B = { size = {18.171,18.576,14.657}, parts = {
		{"Tree_B__Trunk0","Trunk",{-0.016,5.876,0.514},{9.204,12.522,5.302},"Wood","#7A4E2C"},
		{"Tree_B__Crown1","Crown",{0,13.586,0},{18.171,9.979,14.657},"SmoothPlastic","#3F9E2E"},
	} },
	Bush_A = { size = {6.856,3.597,6.684}, parts = {
		{"Bush_A__Crown0","Crown",{0,1.581,-0},{6.856,4.032,6.684},"SmoothPlastic","#3F9E2E"},
	} },
	Bush_B = { size = {9.446,4.923,9.577}, parts = {
		{"Bush_B__Crown0","Crown",{-0,2.041,-0},{9.446,5.763,9.577},"SmoothPlastic","#3F9E2E"},
	} },
	Flowers_0 = { size = {2.884,1.192,3.577}, parts = {
		{"Flowers_0__Bloom0","Bloom",{0.772,0.888,0.003},{1.34,0.362,3.571},"SmoothPlastic","#FFD52A"},
		{"Flowers_0__Heart1","Heart",{-0.052,0.963,0.003},{2.032,0.458,2.664},"SmoothPlastic","#FFB21E"},
		{"Flowers_0__Leaf2","Leaf",{-0.12,0.332,-0.271},{1.956,0.665,3.035},"SmoothPlastic","#3A9A2A"},
		{"Flowers_0__Bloom3","Bloom",{-0.344,0.961,0.125},{2.195,0.249,2.274},"SmoothPlastic","#FFFFFF"},
	} },
	Flowers_1 = { size = {3.189,1.14,1.769}, parts = {
		{"Flowers_1__Bloom0","Bloom",{-0.263,0.775,0.047},{2.664,0.517,1.675},"SmoothPlastic","#FFFFFF"},
		{"Flowers_1__Heart1","Heart",{-0.182,0.841,-0},{2.077,0.597,0.861},"SmoothPlastic","#FFB21E"},
		{"Flowers_1__Leaf2","Leaf",{0.063,0.332,0.014},{3.062,0.665,1.202},"SmoothPlastic","#3A9A2A"},
		{"Flowers_1__Bloom3","Bloom",{0.682,0.848,-0.282},{1.305,0.257,1.206},"SmoothPlastic","#FF7FB8"},
	} },
	Flowers_2 = { size = {3.409,1.262,3.7}, parts = {
		{"Flowers_2__Bloom0","Bloom",{0.256,0.919,0.144},{2.06,0.473,3.413},"SmoothPlastic","#FF7FB8"},
		{"Flowers_2__Heart1","Heart",{0.075,0.867,0.144},{2.304,0.79,2.505},"SmoothPlastic","#FFB21E"},
		{"Flowers_2__Leaf2","Leaf",{-0.287,0.332,-0.272},{2.835,0.665,3.155},"SmoothPlastic","#3A9A2A"},
		{"Flowers_2__Bloom3","Bloom",{0.127,0.613,-0.906},{3.155,0.335,1.194},"SmoothPlastic","#B65CF0"},
	} },
	Flowers_3 = { size = {3.283,1.294,2.452}, parts = {
		{"Flowers_3__Bloom0","Bloom",{-0.595,0.946,-0.148},{1.364,0.485,2.156},"SmoothPlastic","#B65CF0"},
		{"Flowers_3__Heart1","Heart",{-0.052,1.002,-0.105},{2.431,0.584,1.334},"SmoothPlastic","#FFB21E"},
		{"Flowers_3__Leaf2","Leaf",{-0.154,0.332,0.146},{2.69,0.665,2.159},"SmoothPlastic","#3A9A2A"},
		{"Flowers_3__Bloom3","Bloom",{-0,0.918,0.408},{3.283,0.469,1.215},"SmoothPlastic","#FFD52A"},
	} },
	Boulder_A = { size = {4.802,2.596,3.585}, parts = {
		{"Boulder_A__Rock0","Rock",{0,1.009,0},{4.802,2.689,3.585},"Slate","#9A938E"},
		{"Boulder_A__Moss1","Moss",{-0.787,2.164,-0.284},{2.972,0.865,2.62},"SmoothPlastic","#66B82C"},
	} },
	Fern_A = { size = {6.479,1.572,6.266}, parts = {
		{"Fern_A__Leaf0","Leaf",{-0,0.779,0},{6.479,1.557,6.266},"SmoothPlastic","#74C424"},
		{"Fern_A__Leaf1","Leaf",{0.316,0.786,-0.31},{4.791,1.572,4.91},"SmoothPlastic","#3A9A2A"},
	} },
	Hill_A = { size = {2.2,0.73,1.568}, parts = {
		{"Hill_A__Dome0","Dome",{0,0.365,-0},{2.2,0.73,1.568},"Grass","#74BE36"},
		{"Hill_A__Rock1","Rock",{-0.023,0.092,0.349},{1.528,0.173,0.188},"Slate","#9A938E"},
	} },
	Hill_B = { size = {2.2,0.768,1.407}, parts = {
		{"Hill_B__Dome0","Dome",{0,0.384,0},{2.2,0.768,1.407},"Grass","#74BE36"},
		{"Hill_B__Rock1","Rock",{-0.334,0.087,0.372},{0.302,0.126,0.178},"Slate","#9A938E"},
	} },
	Hedge_A = { size = {3.682,2.405,2.321}, parts = {
		{"Hedge_A__Crown0","Crown",{0,1.275,-0},{3.682,2.26,2.321},"SmoothPlastic","#3F9E2E"},
	} },
}

local MeadowKit = {}

local sources: { [string]: MeshPart }? = nil
local function src(): { [string]: MeshPart }
	if sources then
		return sources
	end
	local found: { [string]: MeshPart } = {}
	local root = ServerStorage:FindFirstChild("MeadowKit")
	if root then
		for _, d in root:GetDescendants() do
			if d:IsA("MeshPart") then
				local base = string.gsub(d.Name, "%.%d+$", "")
				found[base] = found[base] or d
			end
		end
	end
	sources = found
	return found
end

function MeadowKit.has(name: string): boolean
	local k = KITS[name]
	if not k then
		return false
	end
	local s = src()
	for _, row in k.parts do
		if not s[row[1]] then
			return false
		end
	end
	return true
end

-- natural size in studs
function MeadowKit.size(name: string): Vector3
	local s = KITS[name].size
	return Vector3.new(s[1], s[2], s[3])
end

-- cf = base centre on the floor (its -Z is the front), scale = number (uniform) or Vector3 (per axis).
-- Pieces are visual only unless `solidRoles` names roles that should collide (e.g. { Trunk = true }).
function MeadowKit.place(parent: Instance, name: string, modelName: string, cf: CFrame, scale: number | Vector3,
	solidRoles: { [string]: boolean }?): Model?
	if not MeadowKit.has(name) then
		return nil
	end
	local sv: Vector3 = if typeof(scale) == "Vector3" then scale else Vector3.new(scale, scale, scale)
	local s = src()
	local m = Instance.new("Model")
	m.Name = modelName
	for _, row in KITS[name].parts do
		local p = s[row[1]]:Clone()
		local off, size = row[3], row[4]
		p.Name = row[2]
		p.TextureID = ""
		p.Size = Vector3.new(size[1] * sv.X, size[2] * sv.Y, size[3] * sv.Z)
		p.CFrame = cf * CFrame.new(off[1] * sv.X, off[2] * sv.Y, off[3] * sv.Z)
		local ok, mat = pcall(function()
			return (Enum.Material :: any)[row[5]]
		end)
		p.Material = if ok and mat then mat else Enum.Material.SmoothPlastic
		p.Color = Color3.fromHex(row[6])
		p.Anchored = true
		local solid = solidRoles ~= nil and solidRoles[row[2]] == true
		p.CanCollide = solid
		p.CanQuery = solid
		p.CanTouch = false
		p.CastShadow = p.Size.Magnitude > 4
		p.Parent = m
	end
	m.Parent = parent
	return m
end

return MeadowKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="244">
        <Properties>
          <string name="Name">MeshService</string>
          <string name="Source"><![CDATA[--!strict
-- Loads the uploaded meshes at boot (InsertService) into ReplicatedStorage.Assets. Anything not uploaded
-- (id 0) or that fails to load (Studio without asset access, offline preview) is simply absent, and the
-- procedural Part stand-ins in GeodeModel / WorldBuilder / StationModels are used instead.
--
-- Two kinds of asset (ids in shared/MeshIds, generated by tools/gen_mesh_catalog.py):
--   * Legacy single meshes (CT_Rocks_*, tools/gen_meshes.py): one MeshPart template each,
--     ReplicatedStorage.Assets.<Name>; its pivot is the mesh file's origin.
--   * Blender kit models (blender/build.py, listed in shared/MeshCatalog): one Model each,
--     ReplicatedStorage.Assets.Kit.<Name>. The uploaded FBX holds one uncoloured mesh per piece; this
--     service paints every MeshPart from the catalog (Color, Material, Transparency), places it at its
--     recorded offset from the model origin, and adds an invisible anchored Root part at the origin
--     (PrimaryPart, WorldPivot = origin) carrying one Attachment per catalog Attach point. Animated
--     pieces get attributes Anim (string) and Pivot (Vector3, joint relative to the piece centre).
--     Clone the Model and PivotTo the wanted floor-centre CFrame. Model attributes: Sheet, Ready.
-- Convention: studs, +Y up, front -Z, origin = floor centre unless the catalog's Origin says otherwise.

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MeshIds = require(Shared:WaitForChild("MeshIds")) :: { [string]: number }
local MeshCatalog = require(Shared:WaitForChild("MeshCatalog"))

local MeshService = {}

local RETRIES = 3
local OPTIONAL_PIECES: { [string]: boolean } = { Fill = true }
local pendingCount = 0 -- assets still loading
local started = false

local MATERIALS: { [string]: Enum.Material } = {
	SmoothPlastic = Enum.Material.SmoothPlastic,
	Plastic = Enum.Material.Plastic,
	Metal = Enum.Material.Metal,
	DiamondPlate = Enum.Material.DiamondPlate,
	Wood = Enum.Material.Wood,
	WoodPlanks = Enum.Material.WoodPlanks,
	Glass = Enum.Material.Glass,
	Neon = Enum.Material.Neon,
	Slate = Enum.Material.Slate,
	Concrete = Enum.Material.Concrete,
	Rock = Enum.Material.Rock,
	Rubber = Enum.Material.Rubber,
}

local function vec(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

local function fetch(name: string, id: number): Instance?
	for attempt = 1, RETRIES do
		local ok, result = pcall(function()
			return InsertService:LoadAsset(id)
		end)
		if ok and result then
			return result :: Instance
		end
		if attempt < RETRIES then
			task.wait(attempt)
		else
			warn(("[MeshService] %s (%d) failed to load: %s"):format(name, id, tostring(result)))
		end
	end
	return nil
end

local function strip(p: BasePart)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
end

-- Legacy single-mesh template.
local function loadLegacy(name: string, id: number): BasePart?
	local asset = fetch(name, id)
	if not asset then
		return nil
	end
	local found: BasePart? = nil
	for _, d in asset:GetDescendants() do
		if d:IsA("MeshPart") then
			found = d
			break
		end
	end
	local clone = if found then found:Clone() else nil
	asset:Destroy()
	if not clone then
		warn(("[MeshService] %s (%d) loaded but holds no MeshPart"):format(name, id))
		return nil
	end
	clone.Name = name
	strip(clone)
	return clone
end

-- Blender kit model: rebuild the uploaded pieces as a coloured Model around an origin Root part.
local function loadKit(name: string, id: number, entry: MeshCatalog.Model): Model?
	local asset = fetch(name, id)
	if not asset then
		return nil
	end
	local byName: { [string]: MeshPart } = {}
	for _, d in asset:GetDescendants() do
		if d:IsA("MeshPart") then
			local clean = string.gsub(d.Name, "%.%d+$", "")
			if not byName[clean] then
				byName[clean] = d
			end
		end
	end
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("Sheet", entry.Sheet)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.CFrame = CFrame.new()
	strip(root)
	root.Parent = model
	for pointName, p in entry.Attach do
		local a = Instance.new("Attachment")
		a.Name = pointName
		a.Position = vec(p)
		a.Parent = root
	end
	local missing = 0
	for _, piece in entry.Pieces do
		local mesh = byName[piece.Name]
		if not mesh then
			if OPTIONAL_PIECES[piece.Name] then
				-- cosmetic fill pieces that the uploaded FBX does not contain (Station_RubbleBin.Fill:
				-- the game fills the bin itself); the rest of the model is still usable
				continue
			end
			missing += 1
			warn(("[MeshService] %s is missing piece %s"):format(name, piece.Name))
			continue
		end
		local part = mesh:Clone()
		for _, child in part:GetChildren() do
			child:Destroy() -- imported welds / attachments / SurfaceAppearance
		end
		part.Name = piece.Name
		strip(part)
		part.CastShadow = true
		part.TextureID = ""
		part.Color = piece.Color
		part.Material = MATERIALS[piece.Material] or Enum.Material.SmoothPlastic
		part.Transparency = piece.Transparency or 0
		-- The FBX node may carry the Y-up axis rotation over Z-up vertex data. If the importer kept it on
		-- the MeshPart instead of baking it, keep that rotation and express the catalog size in its axes.
		local rot = mesh.CFrame.Rotation
		local size = vec(piece.Size)
		if rot.UpVector.Y < 0.99 then
			local v = rot:VectorToObjectSpace(size)
			size = Vector3.new(math.abs(v.X), math.abs(v.Y), math.abs(v.Z))
			part:SetAttribute("ImportRotation", rot)
		end
		part.Size = size
		part.CFrame = CFrame.new(vec(piece.Offset)) * rot
		if piece.Anim then
			part:SetAttribute("Anim", piece.Anim)
		end
		if piece.Pivot then
			part:SetAttribute("Pivot", vec(piece.Pivot))
		end
		part.Parent = model
	end
	asset:Destroy()
	if missing > 0 then
		model:Destroy()
		return nil
	end
	model.PrimaryPart = root
	model.WorldPivot = CFrame.new()
	model:SetAttribute("Ready", true)
	return model
end

local function ensureFolder(parent: Instance, name: string): Instance
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Template Model for a Blender kit asset (ReplicatedStorage.Assets.Kit.<name>), or nil when absent.
function MeshService.kit(name: string): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local kit = assets and assets:FindFirstChild("Kit")
	local m = kit and kit:FindFirstChild(name)
	if m and m:IsA("Model") and m:GetAttribute("Ready") then
		return m
	end
	return nil
end

-- Loads every uploaded template in parallel; returns how many arrived. Safe to call once at boot.
function MeshService.start(): number
	if started then
		return 0
	end
	started = true
	local folder = ensureFolder(ReplicatedStorage, "Assets")
	local kitFolder = ensureFolder(folder, "Kit")
	local catalog = MeshCatalog :: { [string]: MeshCatalog.Model }
	local loaded = 0
	for name, id in MeshIds do
		local entry = catalog[name]
		local target = if entry then kitFolder else folder
		if id > 0 and not target:FindFirstChild(name) then
			pendingCount += 1
			task.spawn(function()
				local ok, res = pcall(function(): Instance?
					return if entry then loadKit(name, id, entry) else loadLegacy(name, id)
				end)
				local inst: Instance? = if ok then res else nil
				if not ok then
					warn(("[MeshService] %s failed: %s"):format(name, tostring(res)))
				end
				if inst then
					inst.Parent = target
					loaded += 1
				end
				pendingCount -= 1
			end)
		end
	end
	-- wait briefly so the first lobby build sees the templates; stragglers still appear later
	local waited = 0
	while pendingCount > 0 and waited < 8 do
		task.wait(0.25)
		waited += 0.25
	end
	return loaded
end

-- Waits (at most `timeout` seconds, never errors) until every asset that was started has either
-- loaded or failed; true when nothing is pending. Callers that build kit-based models (arenas)
-- use it so the first build after boot does not fall back to Parts just because a load was slow.
function MeshService.waitReady(timeout: number?): boolean
	local limit = timeout or 5
	local waited = 0
	while pendingCount > 0 and waited < limit do
		task.wait(0.25)
		waited += 0.25
	end
	return pendingCount <= 0
end

return MeshService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="245">
        <Properties>
          <string name="Name">ParkBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Dino-jungle pet park (the public lobby, owner picks 2026-10-10, latest layout picture in the project thread): a
-- central grass clearing with the four queue nests (2 x 2, each glowing its own colour, each with a small count sign)
-- and a tall crowned leaderboard; 12 square fenced plots all around it with stone paths between them; the spawn plaza
-- with the stalls at the south end of the main stone path and the EGG SHOP hut at its north end. The park sits on
-- normal ground in a jungle valley closed by tall mossy cliffs and a spaced-out jungle edge (simple low-poly palms and
-- trees, a couple of giant dino skulls). Warm lanterns on fence posts and along the paths. No floating island, no
-- fountain, no waterfalls. Owner feedback built in: open space, bold shapes, few small props, few parts per tree.
--
-- Layout numbers: src/shared/ParkConfig.luau. LobbyBuilder calls ParkBuilder.build and puts the stalls (LodgeBuilder)
-- and the spawn on it. Everything is procedural Parts (REPLACE: real jungle / dino / nest meshes) except the kit cliffs
-- (Blender kit via MeshService, Part fallbacks when absent).
--
-- Contracts built here (for the queue and tower helpers; what they do is not implemented here):
--   * Part `TowerPortal` (attribute TowerPortal = true, CanTouch, no collision) in the PET TOWER doorway at the west
--     end of the cross path
--   * four queue nests: Parts `QueuePad1..4` (the glowing disc in each nest; attribute HuntPortal = true, QueuePad = n,
--     QueueColour = "Yellow" / "Blue" / "Pink" / "Green"; CanTouch, solid, stand-on height 0.4)
--   * one small sign per nest: Part `QueueSign` (attribute QueuePad = n) with a SurfaceGui holding the TextLabel
--     `QueueText` (default "STEP ON"), for that nest's count / countdown
--   * per plot a model CT_Rocks_Alcove_<i> (GalleryService; Main.client's "YOUR GALLERY" marker uses its `Floor`)

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ParkConfig = require(Shared.ParkConfig)
local WhatsNew = require(Shared.WhatsNew)
local MapNames = require(Shared.MapNames)
local Kit = require(script.Parent.KitParts)
local KitPlace = require(script.Parent.KitPlace)

local part, deco, folder, model = Kit.part, Kit.deco, Kit.folder, Kit.model
local M = Enum.Material

local ParkBuilder = {}

-- Palette: lush deep greens, warm stone and timber, golden lantern light, teal and orange accents (not pastel).
local C = {
	Grass = Color3.fromRGB(72, 176, 52),
	GrassLight = Color3.fromRGB(110, 200, 60),
	Leaf = Color3.fromRGB(46, 170, 56),
	LeafDark = Color3.fromRGB(26, 128, 52),
	LeafLime = Color3.fromRGB(140, 214, 50),
	FernOrange = Color3.fromRGB(255, 122, 28),
	Trunk = Color3.fromRGB(160, 100, 52),
	TrunkDark = Color3.fromRGB(122, 74, 40),
	Stone = Color3.fromRGB(186, 176, 160),
	StoneWarm = Color3.fromRGB(214, 188, 146),
	StoneDark = Color3.fromRGB(124, 116, 104),
	Moss = Color3.fromRGB(78, 128, 48),
	Wood = Color3.fromRGB(176, 104, 48),
	WoodDark = Color3.fromRGB(122, 70, 36),
	Twig = Color3.fromRGB(168, 108, 50),
	TwigDark = Color3.fromRGB(124, 78, 38),
	Bone = Color3.fromRGB(236, 224, 196),
	BoneShade = Color3.fromRGB(196, 182, 152),
	Socket = Color3.fromRGB(54, 44, 40),
	Teal = Color3.fromRGB(0, 224, 204),
	TealDeep = Color3.fromRGB(22, 130, 126),
	Orange = Color3.fromRGB(255, 132, 24),
	Lantern = Color3.fromRGB(255, 190, 90),
	Iron = Color3.fromRGB(62, 52, 46),
	Glass = Color3.fromRGB(196, 242, 236),
	Cream = Color3.fromRGB(246, 232, 200),
	Gold = Color3.fromRGB(250, 196, 60),
}
ParkBuilder.Palette = C

-- Nest glow colours (ParkConfig.QueuePads.Colours)
local NEST = {
	Yellow = Color3.fromRGB(255, 212, 64),
	Blue = Color3.fromRGB(70, 186, 255),
	Pink = Color3.fromRGB(255, 104, 206),
	Green = Color3.fromRGB(104, 232, 104),
}
ParkBuilder.NestColours = NEST

local Y0 = 0 -- ground top (Config.Lodge.FloorY)
local PAVE_TOP = 0.05 -- paving / plot floor tops

-- Primitives -----------------------------------------------------------------------------------------------------

-- An ellipsoid (block + sphere mesh, any proportions).
local function blob(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?): Part
	local p = part(parent, name, size, cf, color, mat or M.SmoothPlastic)
	local sm = Instance.new("SpecialMesh")
	sm.MeshType = Enum.MeshType.Sphere
	sm.Parent = p
	return p
end

local function upCyl(parent: Instance, name: string, d: number, h: number, cf: CFrame, color: Color3, mat: Enum.Material?): Part
	return Kit.upCylinder(parent, name, d, h, cf, color, mat)
end

-- A flat walking surface (top at PAVE_TOP + lift).
local function pave(parent: Instance, name: string, w: number, d: number, cf: CFrame, color: Color3, mat: Enum.Material?, lift: number?): Part
	local h = 0.1 + (lift or 0) * 2
	local p = part(parent, name, Vector3.new(w, h, d), cf * CFrame.new(0, PAVE_TOP - h / 2 + (lift or 0), 0), color, mat or M.Cobblestone)
	p.CastShadow = false
	return p
end

local function quiet(m: Instance)
	KitPlace.cameraIgnore(m)
end

-- A warm lantern (dark cap + glowing body) sitting on `top` (world point). `light` adds a small PointLight.
-- Owner's Meshy prop (ServerStorage.MeshyAssets) fitted into `size`, bottom on `base`, turned by `yaw`, parented and
-- quieted; nil when that asset is missing so the caller builds its Part stand-in.
local function meshAt(parent: Instance, name: string, modelName: string, base: Vector3, size: Vector3, yaw: number?): Model?
	local mesh = KitPlace.meshy(name, CFrame.new(base + Vector3.new(0, size.Y / 2, 0)) * CFrame.Angles(0, yaw or 0, 0), size)
	if not mesh then
		return nil
	end
	mesh.Name = modelName
	local box, ext = mesh:GetBoundingBox()
	mesh:PivotTo(mesh:GetPivot() + Vector3.new(0, base.Y + ext.Y / 2 - box.Position.Y, 0)) -- bottom on the ground
	mesh.Parent = parent
	quiet(mesh)
	return mesh
end

local function lantern(parent: Instance, top: Vector3, s: number, light: boolean?)
	local glow = deco(part(parent, "Lantern", Vector3.new(0.6, 0.75, 0.6) * s, CFrame.new(top + Vector3.new(0, 0.4 * s, 0)), C.Lantern, M.Neon))
	glow.CastShadow = false
	deco(part(parent, "LanternCap", Vector3.new(0.85, 0.2, 0.85) * s, CFrame.new(top + Vector3.new(0, 0.86 * s, 0)), C.Iron, M.Metal)).CastShadow = false
	if light then
		Kit.light(glow, "PointLight", Color3.fromRGB(255, 186, 110), 1.1, 14)
	end
end

-- Lantern post along a path: one timber post with a lantern on top.
local function lanternPost(parent: Instance, pos: Vector3, light: boolean)
	local mm = meshAt(parent, "MeshyLantern", "CT_Park_LanternPost", pos, Vector3.new(1.8, 5.4, 1.8))
	if mm then
		if light then
			local glow = Instance.new("Part")
			glow.Name = "LanternGlow"
			glow.Size = Vector3.new(0.2, 0.2, 0.2)
			glow.Transparency = 1
			glow.Position = pos + Vector3.new(0, 4.6, 0)
			Kit.deco(glow)
			glow.Parent = mm
			Kit.light(glow, "PointLight", Color3.fromRGB(255, 186, 110), 1.1, 14)
		end
		return
	end
	local m = model(parent, "CT_Park_LanternPost")
	part(m, "Post", Vector3.new(0.7, 4.2, 0.7), CFrame.new(pos + Vector3.new(0, 2.1, 0)), C.WoodDark, M.Wood)
	lantern(m, pos + Vector3.new(0, 4.2, 0), 1.3, light)
	quiet(m)
end

-- Simple low-poly palm (5 parts): one leaning trunk, four broad drooping fronds (Leaf / LeafDark sway on the client).
local function palm(parent: Instance, base: Vector3, h: number, rng: Random): Model
	local mm = meshAt(parent, "MeshyPalm", "CT_Park_Palm", base, Vector3.new(h * 0.9, h * 1.2, h * 0.9), rng:NextNumber(0, math.pi * 2))
	if mm then
		KitPlace.blocker(mm, CFrame.new(base + Vector3.new(0, h / 2, 0)), Vector3.new(1.3, h, 1.3), "TrunkBlock")
		return mm
	end
	local m = model(parent, "CT_Park_Palm")
	local lean = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit * (h * 0.12)
	local top = base + Vector3.new(0, h, 0) + lean
	local mid = (base + top) / 2
	local trunk = part(m, "Trunk", Vector3.new(h + 0.4, 1.3, 1.3), CFrame.lookAt(mid, top) * CFrame.Angles(0, math.rad(90), 0), C.Trunk, M.Wood, Enum.PartType.Cylinder)
	trunk.CanCollide = true
	local a0 = rng:NextNumber(0, math.pi * 2)
	for i = 1, 4 do
		local a = a0 + i / 4 * math.pi * 2
		local L = h * 0.55
		deco(part(m, if i % 2 == 0 then "Leaf" else "LeafDark", Vector3.new(h * 0.2, 0.3, L), CFrame.new(top) * CFrame.Angles(0, a, 0) * CFrame.Angles(-math.rad(24), 0, 0) * CFrame.new(0, 0, -L / 2), if i % 2 == 0 then C.Leaf else C.LeafDark, M.Grass))
	end
	KitPlace.sway(m, base + Vector3.new(0, h * 0.5, 0))
	quiet(m)
	return m
end

-- Simple low-poly broad tree (3 parts): trunk and two round canopies.
local function tree(parent: Instance, base: Vector3, s: number, rng: Random): Model
	local h = 9 * s
	-- the owner's MeshyTree (ServerStorage.MeshyAssets) at the same spot and about the same height; the code tree below
	-- is the fallback when it is missing
	local tall = h + 10 * s
	local mesh = KitPlace.meshy("MeshyTree", CFrame.new(base + Vector3.new(0, tall / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), Vector3.new(tall, tall, tall))
	if mesh then
		mesh.Name = "CT_Park_Tree"
		local box, ext = mesh:GetBoundingBox()
		mesh:PivotTo(mesh:GetPivot() + Vector3.new(0, base.Y + ext.Y / 2 - box.Position.Y, 0)) -- bottom on the ground
		mesh.Parent = parent
		quiet(mesh)
		return mesh
	end
	local m = model(parent, "CT_Park_Tree")
	part(m, "Trunk", Vector3.new(h, 1.8 * s, 1.8 * s), CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), C.TrunkDark, M.Wood, Enum.PartType.Cylinder)
	local d = rng:NextNumber(10, 12) * s
	deco(blob(m, "Leaves", Vector3.new(d, d * 0.75, d), CFrame.new(base + Vector3.new(0, h + 1 * s, 0)), if rng:NextNumber() < 0.5 then C.Leaf else C.LeafDark, M.Grass))
	deco(blob(m, "Leaves", Vector3.new(d * 0.6, d * 0.5, d * 0.6), CFrame.new(base + Vector3.new(d * 0.3, h + 3.4 * s, -d * 0.15)), C.LeafLime, M.Grass))
	KitPlace.sway(m, base + Vector3.new(0, h * 0.6, 0))
	quiet(m)
	return m
end

-- One round bush (1 part), green or orange.
local function bush(parent: Instance, base: Vector3, s: number, color: Color3)
	local b = deco(blob(parent, "Bush", Vector3.new(4, 2.6, 4) * s, CFrame.new(base + Vector3.new(0, 0.9 * s, 0)), color, M.Grass))
	b.CastShadow = false
	b:SetAttribute("CameraIgnore", true)
end

-- Giant dino skull lying on the ground (9 parts), snout toward cf's look direction.
local function skull(parent: Instance, cf: CFrame, s: number): Model
	local sk = KitPlace.meshy("MeshySkull", cf * CFrame.new(0, 3.2 * s, 0) * CFrame.Angles(0, math.pi, 0), Vector3.new(8, 6.4, 13) * s)
	if sk then
		sk.Name = "CT_Park_Skull"
		sk.Parent = parent
		quiet(sk)
		return sk
	end
	local m = model(parent, "CT_Park_Skull")
	blob(m, "Cranium", Vector3.new(6.4, 4.8, 7) * s, cf * CFrame.new(0, 2.4 * s, 1.8 * s), C.Bone, M.SmoothPlastic)
	blob(m, "Snout", Vector3.new(4.2, 3.0, 7.4) * s, cf * CFrame.new(0, 1.9 * s, -3.6 * s) * CFrame.Angles(math.rad(-6), 0, 0), C.Bone, M.SmoothPlastic)
	for _, sx in { -1, 1 } do
		deco(blob(m, "Socket", Vector3.new(1.0, 1.9, 2.0) * s, cf * CFrame.new(sx * 2.9 * s, 2.9 * s, 0.4 * s), C.Socket, M.SmoothPlastic))
		deco(part(m, "Horn", Vector3.new(0.9, 2.6, 0.9) * s, cf * CFrame.new(sx * 2.4 * s, 5.0 * s, 2.4 * s) * CFrame.Angles(math.rad(-25), 0, sx * math.rad(-20)), C.BoneShade, M.SmoothPlastic))
		deco(part(m, "Tooth", Vector3.new(0.5, 1.3, 0.5) * s, cf * CFrame.new(sx * 1.6 * s, 0.9 * s, -5.6 * s), C.Cream, M.SmoothPlastic))
	end
	deco(part(m, "Jaw", Vector3.new(3.8, 0.8, 7.6) * s, cf * CFrame.new(0, 0.45 * s, -2.8 * s) * CFrame.Angles(math.rad(4), 0, 0), C.BoneShade, M.SmoothPlastic))
	quiet(m)
	return m
end

-- Fence run in a plot frame F from local a to b (ground plane): posts every ~5.4 studs, two rails, an invisible wall.
-- `lanterns` puts a warm lantern on the first and last post.
local function fenceRun(m: Instance, F: CFrame, a: Vector3, b: Vector3, lanterns: boolean)
	local len = (b - a).Magnitude
	local n = math.max(1, math.floor(len / 5.4 + 0.5))
	for k = 0, n do
		local p = a:Lerp(b, k / n)
		part(m, "FencePost", Vector3.new(0.8, 3.5, 0.8), F * CFrame.new(p + Vector3.new(0, 1.75, 0)), C.WoodDark, M.Wood)
		if lanterns and (k == 0 or k == n) then
			lantern(m, (F * CFrame.new(p + Vector3.new(0, 3.5, 0))).Position, 1)
		end
	end
	local mid = (a + b) / 2
	local dir = CFrame.lookAt(mid, b)
	for _, y in { 1.25, 2.5 } do
		part(m, "FenceRail", Vector3.new(0.3, 0.42, len), F * dir * CFrame.new(0, y, 0), C.Wood, M.Wood)
	end
	KitPlace.blocker(m, F * dir * CFrame.new(0, 2, 0), Vector3.new(0.6, 4, len), "FenceBlock")
end

-- A gold crown (7 parts), gem on the front (-Z of cf), base at cf. Used on the RAREST PET board and, scaled up,
-- floating over the most-liked plot (GalleryService moves that one).
function ParkBuilder.crown(parent: Instance, name: string, cf: CFrame, s: number): Model
	local cm = model(parent, name)
	deco(upCyl(cm, "CrownBand", 3.6 * s, 1.0 * s, cf * CFrame.new(0, 0.5 * s, 0), C.Gold, M.SmoothPlastic))
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		deco(part(cm, "CrownPoint", Vector3.new(0.8, 1.6, 0.8) * s, cf * CFrame.new(math.cos(a) * 1.5 * s, 1.6 * s, math.sin(a) * 1.5 * s) * CFrame.Angles(0, -a, 0), C.Gold, M.SmoothPlastic))
	end
	deco(part(cm, "CrownGem", Vector3.new(0.7, 0.7, 0.7) * s, cf * CFrame.new(0, 0.6 * s, -1.8 * s), Color3.fromRGB(230, 40, 60), M.Neon, Enum.PartType.Ball))
	quiet(cm)
	return cm
end

-- Plots ----------------------------------------------------------------------------------------------------------

export type Plot = {
	Index: number,
	Root: Model,
	Frame: CFrame, -- plot frame on the ground, LookVector toward the gate
	Plate: TextLabel,
	SetLabel: (string) -> (),
	-- the 3 glass domes (display slot k = dome k): pet frame (feet on the stand, facing the gate), plaque frame
	-- (+Z toward the viewer) and the pet scale
	Domes: { { Slot: CFrame, Label: CFrame, Scale: number } },
	SetLikes: (number) -> (), -- the LIKE sign's count
	CrownAt: CFrame, -- where the most-liked crown floats over this plot
	Wander: { MinX: number, MaxX: number, MinZ: number, MaxZ: number }, -- plot-local box for wandering pets
	-- kept for the old alcove interface (GalleryService, older tools)
	Shutters: { BasePart },
	SetCapacity: (number) -> (),
	LabelDepth: number,
}

local function buildPlot(parent: Instance, i: number): Plot
	local P = ParkConfig.Plot
	local S = ParkConfig.Showcase
	local F = ParkConfig.plotFrame(i, Y0)
	local half = P.Size / 2
	local m = model(parent, MapNames.plot(i))
	m:SetAttribute("Plot", i)
	-- yard floor (the "YOUR GALLERY" marker targets `Floor`) and a dirt patch where the commons wander
	pave(m, "Floor", P.Size - 0.4, P.Size - 0.4, F, C.GrassLight, M.Grass)
	local W = S.Wander
	pave(m, "RouteYard", W.MaxX - W.MinX + 3, W.MaxZ - W.MinZ + 3, F * CFrame.new((W.MinX + W.MaxX) / 2, 0, (W.MinZ + W.MaxZ) / 2), Color3.fromRGB(176, 136, 88), M.Ground, 0.02)
	-- fence with the gate gap toward the path; lanterns on the corner posts
	local g = 3.4
	fenceRun(m, F, Vector3.new(-half, 0, half), Vector3.new(half, 0, half), true)
	fenceRun(m, F, Vector3.new(-half, 0, -half), Vector3.new(-half, 0, half), false)
	fenceRun(m, F, Vector3.new(half, 0, -half), Vector3.new(half, 0, half), false)
	fenceRun(m, F, Vector3.new(-half, 0, -half), Vector3.new(-g - 0.6, 0, -half), true)
	fenceRun(m, F, Vector3.new(g + 0.6, 0, -half), Vector3.new(half, 0, -half), true)
	-- gate: two thick posts with lanterns, a beam, the owner's name sign facing the path
	for _, sx in { -1, 1 } do
		part(m, "GatePost", Vector3.new(1.3, 7.4, 1.3), F * CFrame.new(sx * (g + 0.2), 3.7, -half), C.WoodDark, M.Wood)
		lantern(m, (F * CFrame.new(sx * (g + 0.2), 7.4, -half)).Position, 1.4, sx > 0)
	end
	deco(part(m, "GateBeam", Vector3.new(2 * g + 2.4, 0.8, 1.0), F * CFrame.new(0, 6.6, -half), C.Wood, M.Wood))
	local plateFace, plateText = KitPlace.signBoard(m, "Nameplate", F * CFrame.new(0, 8.1, -half - 0.35) * CFrame.Angles(0, math.pi, 0), 8.4, 1.7, ParkConfig.EmptyPlot, "Nameplate", { Face = C.WoodDark, Frame = C.Wood, Trim = C.Orange, Ink = C.Cream })
	local NW, NH = 8.4, 1.7
	local function setLabel(text: string)
		local fit = KitPlace.applyFit(plateText.Parent :: SurfaceGui, plateText, text, NW, NH, "Nameplate")
		plateFace:SetAttribute("SignText", fit.Text)
		plateFace:SetAttribute("SignFill", fit.Fill)
		-- a free plot's sign glows soft green (text colour only, no light); an owned plot's name stays cream
		plateText.TextColor3 = if text == ParkConfig.EmptyPlot then Color3.fromRGB(150, 235, 160) else C.Cream
	end
	setLabel(ParkConfig.EmptyPlot)
	-- the 3 glass domes on stone stands at the back (owner pick: the player chooses the pets inside); the middle one
	-- is bigger and carries the plot's glow light
	local domes = {}
	for k, D in S.Domes do
		local bc = F * CFrame.new(D.X, 0, D.Z)
		upCyl(m, "DomePlinth", D.Plinth, 0.9, bc * CFrame.new(0, 0.45, 0), C.Stone, M.Slate)
		upCyl(m, "DomeTier", D.Plinth - 0.8, D.Height - 0.9 + 0.01, bc * CFrame.new(0, 0.9 + (D.Height - 0.9) / 2, 0), C.StoneDark, M.Slate)
		deco(upCyl(m, "ShelfLight", D.Plinth + 0.35, 0.22, bc * CFrame.new(0, 0.78, 0), C.Teal, M.Neon)).CastShadow = false
		local dome = part(m, "Dome", Vector3.new(D.Dome, D.Dome, D.Dome), bc * CFrame.new(0, D.Height, 0), C.Glass, M.Glass, Enum.PartType.Ball)
		dome.Transparency = 0.64
		dome.CastShadow = false
		dome.CanQuery = false
		if k == 1 then
			local glow = deco(part(m, "Light", Vector3.new(0.2, 0.2, 0.2), bc * CFrame.new(0, D.Height + 3, 0), C.Teal, M.SmoothPlastic))
			glow.Transparency = 1
			Kit.light(glow, "PointLight", Color3.fromRGB(120, 255, 236), 1.0, 14)
		end
		local pw = math.min(3.6, D.Plinth * 0.48)
		part(m, "PlaqueStand", Vector3.new(pw + 0.4, 0.9, 0.7), bc * CFrame.new(0, 0.45, -D.Plinth / 2 - 0.5), C.StoneDark, M.Slate)
		table.insert(domes, {
			Slot = bc * CFrame.new(0, D.Height, 0),
			Label = bc * CFrame.new(0, 0.48, -D.Plinth / 2 - 0.88) * CFrame.Angles(0, math.pi, 0),
			Scale = D.PetScale,
		})
	end
	-- LIKE post just inside the gate: a wooden post with a pink like sign; its prompt (attribute LikePlot = i) is
	-- handled by GalleryService (one like per visitor per plot owner per server session, server-checked)
	local lp = F * CFrame.new(g + 6, 0, -half + 2.4)
	local post = part(m, "LikePost", Vector3.new(0.8, 4.2, 0.8), lp * CFrame.new(0, 2.1, 0), C.WoodDark, M.Wood)
	local likeFace, likeText = KitPlace.signText(m, "LikeSign", lp * CFrame.new(0, 4.4, -0.45) * CFrame.Angles(0, math.pi, 0), 3.0, 1.3, "0 LIKES", "Plaque", C.Cream, Color3.fromRGB(226, 70, 150))
	local likePrompt = Kit.prompt(post, "Like", ParkConfig.EmptyPlot, "", 9)
	likePrompt.Name = "LikePrompt"
	likePrompt:SetAttribute("Off", true) -- GalleryService turns it on when someone owns the plot
	likePrompt:SetAttribute("LikePlot", i)
	local function setLikes(n: number)
		local text = if n == 1 then "1 LIKE" else tostring(n) .. " LIKES"
		local fit = KitPlace.applyFit(likeText.Parent :: SurfaceGui, likeText, text, 3.0, 1.3, "Plaque")
		likeFace:SetAttribute("SignText", fit.Text)
	end
	-- one bush in a back corner (alternating sides and colours)
	local side = if i % 2 == 0 then 1 else -1
	bush(m, (F * CFrame.new(side * (half - 3), 0, half - 3)).Position, 0.9, if i % 3 == 0 then C.FernOrange else C.Leaf)
	return {
		SetLikes = setLikes,
		CrownAt = F * CFrame.new(0, ParkConfig.Likes.CrownHeight, 4),
		Index = i,
		Root = m,
		Frame = F,
		Plate = plateText,
		SetLabel = setLabel,
		Domes = domes,
		Wander = { MinX = W.MinX, MaxX = W.MaxX, MinZ = W.MinZ, MaxZ = W.MaxZ },
		Shutters = {},
		SetCapacity = function(_n: number) end,
		LabelDepth = 1,
	}
end

-- Paths, clearing, nests ----------------------------------------------------------------------------------------

local function buildPaths(root: Instance)
	local f = folder(root, "CT_Park_Paths")
	local Pa, Cl = ParkConfig.Path, ParkConfig.Clearing
	local ring, w = Pa.Ring, Pa.Width
	local outer = 88 -- the plots' outer edge (cells at 66 +- 16, plus a margin)
	-- the stone ring around the clearing, out to the plots' outer edge on all four sides
	for _, s in { -1, 1 } do
		pave(f, "RouteRing", outer * 2, w, CFrame.new(0, Y0, s * ring), C.Stone, M.Cobblestone)
		pave(f, "RouteRing", w, ring * 2 - w - 0.2, CFrame.new(s * ring, Y0, 0), C.Stone, M.Cobblestone)
		pave(f, "RouteRing", w, outer - ring - w / 2 - 0.1, CFrame.new(s * ring, Y0, (ring + w / 2 + outer) / 2), C.Stone, M.Cobblestone)
		pave(f, "RouteRing", w, outer - ring - w / 2 - 0.1, CFrame.new(s * ring, Y0, -(ring + w / 2 + outer) / 2), C.Stone, M.Cobblestone)
	end
	-- the main path (x = 0) from the spawn plaza to the ring and on from the ring to the EGG SHOP, and the cross paths
	-- between the west / east plots (z = 0)
	local Pz, Sh = ParkConfig.Plaza, ParkConfig.Shop
	local southFrom, southTo = Pz.MinZ, ring + w / 2
	pave(f, "RouteMain", w, southFrom - southTo, CFrame.new(0, Y0, (southFrom + southTo) / 2), C.StoneWarm, M.Cobblestone)
	local northFrom, northTo = -(ring + w / 2), Sh.Z + 6
	pave(f, "RouteMain", w, northFrom - northTo, CFrame.new(0, Y0, (northFrom + northTo) / 2), C.StoneWarm, M.Cobblestone)
	for _, s in { -1, 1 } do
		local from, to = ring + w / 2, outer
		pave(f, "RouteCross", to - from, w, CFrame.new(s * (from + to) / 2, Y0, 0), C.Stone, M.Cobblestone)
	end
	-- a short stone apron from the ring into the clearing on the main path (where people walk in)
	local apron = ring - w / 2 - (Cl.Half - 8)
	for _, s in { -1, 1 } do
		pave(f, "RouteApron", w, apron, CFrame.new(0, Y0, s * (ring - w / 2 - apron / 2)), C.StoneWarm, M.Cobblestone)
	end
	-- lantern posts along the paths (every third one lit)
	local k = 0
	local function post(x: number, z: number)
		k += 1
		lanternPost(f, Vector3.new(x, 0, z), k % 3 == 0)
	end
	for _, z in { 62, 80, -62, -80, -98 } do
		post(-(w / 2 + 1), z)
		post(w / 2 + 1, z)
	end
	for _, s in { -1, 1 } do
		for _, t in { -30, 30 } do
			post(t, s * (ring - w / 2 - 1)) -- inner side of the north / south ring
			post(s * (ring - w / 2 - 1), t) -- inner side of the west / east ring
		end
	end
end

-- One woven nest around a glowing pad, a small count sign beside it.
local function nest(parent: Instance, n: number, x: number, z: number, colourName: string)
	local Q = ParkConfig.QueuePads
	local col = NEST[colourName] or C.Teal
	local m = model(parent, "CT_Park_Nest" .. n)
	local c = CFrame.new(x, Y0, z)
	local R = Q.Size / 2
	-- the woven rim: twig rolls around the pad (two rows, alternating tones). REPLACE: real woven nest mesh.
	local ring = meshAt(m, "MeshyNestRing", "NestRim", c.Position, Vector3.new(Q.Size + 4.6, 2.2, Q.Size + 4.6), n)
	local segs = if ring then 0 else 10
	for k = 0, segs - 1 do
		local a = k / segs * math.pi * 2
		local p = c * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.7 + (k % 2) * 0.08, -(R + 0.9))
		deco(blob(m, "Twig", Vector3.new(3.4, 1.4, 1.7), p * CFrame.Angles(0, 0, math.rad(if k % 2 == 0 then 12 else -12)), if k % 2 == 0 then C.Twig else C.TwigDark, M.Wood))
	end
	for k = 0, segs - 1 do
		local a = (k + 0.5) / segs * math.pi * 2
		local p = c * CFrame.Angles(0, a, 0) * CFrame.new(0, 1.45 + (k % 2) * 0.08, -(R + 0.7)) -- alternate heights: no coplanar tops
		deco(blob(m, "Twig", Vector3.new(3.2, 0.9, 1.3), p, if k % 2 == 0 then C.TwigDark else C.Twig, M.Wood))
	end
	local pad = Instance.new("Part")
	pad.Name = MapNames.QueuePad .. n
	pad:SetAttribute("HuntPortal", true)
	pad:SetAttribute("PadIndex", n) -- PartyService lights the pads in this order, one per queued player
	pad:SetAttribute("QueuePad", n)
	pad:SetAttribute("QueueColour", colourName)
	pad.Shape = Enum.PartType.Cylinder
	pad.Size = Vector3.new(0.4, Q.Size, Q.Size)
	pad.CFrame = c * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90))
	pad.Color = col
	pad.Material = M.Neon
	pad.Transparency = 0.05
	pad.Anchored = true
	pad.CanCollide = true
	pad.CanTouch = true
	pad.CanQuery = false
	pad.CastShadow = false
	pad.Parent = m
	Kit.light(pad, "PointLight", col, 1.4, 14)
	quiet(m)
end

local function buildClearing(root: Instance, rng: Random)
	local f = folder(root, "CT_Park_Clearing")
	local Q = ParkConfig.QueuePads
	for n, s in Q.Spots do
		nest(f, n, s[1], s[2], Q.Colours[n])
	end
	-- the one queue board (PartyService writes the count / countdown into QueueBoard/QueueText) on a timber arch just
	-- north of the nests, facing the spawn; the arch posts stand outside the middle walk
	local bz = -21
	for _, sx in { -1, 1 } do
		part(f, "QueueArchPost", Vector3.new(1, 9.6, 1), CFrame.new(sx * 6, 4.8, bz), C.WoodDark, M.Wood)
	end
	deco(part(f, "QueueArchFrame", Vector3.new(11.4, 3.4, 0.5), CFrame.new(0, 8.2, bz - 0.1), C.Wood, M.Wood))
	local qb = Instance.new("Part")
	qb.Name = MapNames.QueueBoard
	qb.Size = Vector3.new(10.6, 2.8, 0.1)
	qb.CFrame = CFrame.new(0, 8.2, bz + 0.2) * CFrame.Angles(0, math.pi, 0) -- Front face toward +Z (the spawn side)
	qb.Color = Color3.fromRGB(36, 30, 28)
	qb.Material = M.SmoothPlastic
	qb.Anchored = true
	qb.CanCollide = false
	qb.CanQuery = false
	qb.CanTouch = false
	qb.CastShadow = false
	qb:SetAttribute("CameraIgnore", true)
	qb.Parent = f
	local gui = Instance.new("SurfaceGui")
	gui.Name = "QueueGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = qb
	local text = Instance.new("TextLabel")
	text.Name = MapNames.QueueText
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextColor3 = C.Gold
	text.TextScaled = true
	text.Text = "STEP ON TO PLAY"
	text.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.14, 0)
	padding.PaddingBottom = UDim.new(0.14, 0)
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.Parent = text
	-- (the RAREST PET board wears the kit's own trophy emblem on top: LodgeBuilder.buildBoards; no extra crown there)
	-- a few bushes in the clearing corners (not in the walk lines)
	for _, p in { Vector3.new(-32, 0, -32), Vector3.new(32, 0, 30), Vector3.new(-33, 0, 28), Vector3.new(30, 0, -32) } do
		bush(f, p, rng:NextNumber(1.0, 1.3), if p.X > 0 then C.Leaf else C.FernOrange)
	end
end

-- Jungle edge, cliffs and the valley floor -------------------------------------------------------------------------

local CLIFFS = { "Cliff_A", "Cliff_B", "Cliff_C", "Cliff_D", "Cliff_E", "Cliff_F", "Cliff_Corner" }
local CLIFF_TONE: { [string]: Color3 } = {
	Cliff = Color3.fromRGB(128, 120, 104),
	CliffDark = Color3.fromRGB(98, 92, 82),
	RockLight = Color3.fromRGB(150, 140, 120),
	Moss = Color3.fromRGB(70, 124, 46),
}

local function buildValley(root: Instance, rng: Random)
	local B = ParkConfig.Bounds
	local f = folder(root, "CT_Park_Jungle")
	part(root, "CT_Rocks_Ground", Vector3.new(800, 2, 800), CFrame.new(0, Y0 - 1, 0), C.Grass, M.Grass)
	-- tall mossy cliffs all round (kit cliffs, toned; procedural bands when the kit is missing)
	local edge = folder(f, "CT_Park_Cliffs")
	local function row(from: Vector3, to: Vector3, faceDir: Vector3, lo: number, hi: number, pitch: number)
		local len = (to - from).Magnitude
		local dir = (to - from).Unit
		local n = math.max(1, math.floor(len / pitch))
		for k = 0, n - 1 do
			local pos = from + dir * (len * (k + 0.5) / n) + faceDir * rng:NextNumber(-3, 3)
			local cf = KitPlace.facing(Vector3.new(pos.X, -0.5, pos.Z), faceDir) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), 0)
			local c = KitPlace.place(edge, CLIFFS[rng:NextInteger(1, #CLIFFS)], cf, rng:NextNumber(lo, hi))
			if c then
				KitPlace.tone(c, CLIFF_TONE)
				quiet(c)
			end
		end
	end
	if KitPlace.has("Cliff_A", "Cliff_B", "Cliff_C") then
		row(Vector3.new(B.MinX - 26, 0, B.MinZ - 30), Vector3.new(B.MinX - 26, 0, B.MaxZ + 30), Vector3.xAxis, 2.2, 2.8, 32)
		row(Vector3.new(B.MaxX + 26, 0, B.MinZ - 30), Vector3.new(B.MaxX + 26, 0, B.MaxZ + 30), -Vector3.xAxis, 2.2, 2.8, 32)
		row(Vector3.new(B.MinX - 26, 0, B.MinZ - 28), Vector3.new(B.MaxX + 26, 0, B.MinZ - 28), Vector3.zAxis, 2.6, 3.2, 32)
		row(Vector3.new(B.MinX - 26, 0, B.MaxZ + 26), Vector3.new(B.MaxX + 26, 0, B.MaxZ + 26), -Vector3.zAxis, 2.0, 2.5, 32)
	else
		Kit.cliff(edge, CFrame.new(0, 0, B.MinZ - 28), 280, 44, rng)
		Kit.cliff(edge, CFrame.new(0, 0, B.MaxZ + 26) * CFrame.Angles(0, math.pi, 0), 280, 32, rng)
		Kit.cliff(edge, CFrame.new(B.MinX - 26, 0, 0) * CFrame.Angles(0, math.rad(90), 0), 320, 38, rng)
		Kit.cliff(edge, CFrame.new(B.MaxX + 26, 0, 0) * CFrame.Angles(0, math.rad(-90), 0), 320, 38, rng)
	end
	-- the jungle edge: simple palms and broad trees, spaced out, just outside the boundary
	local function edgeRow(from: Vector3, to: Vector3, pitch: number)
		local len = (to - from).Magnitude
		local n = math.max(1, math.floor(len / pitch))
		for k = 0, n - 1 do
			local p = from:Lerp(to, (k + rng:NextNumber(0.3, 0.7)) / n)
			if k % 2 == 0 then
				palm(f, p, rng:NextNumber(16, 22), rng)
			else
				tree(f, p, rng:NextNumber(1.3, 1.7), rng)
			end
		end
	end
	edgeRow(Vector3.new(B.MinX - 4, 0, B.MinZ), Vector3.new(B.MinX - 4, 0, B.MaxZ), 20)
	edgeRow(Vector3.new(B.MaxX + 4, 0, B.MinZ), Vector3.new(B.MaxX + 4, 0, B.MaxZ), 20)
	edgeRow(Vector3.new(B.MinX + 8, 0, B.MinZ - 4), Vector3.new(B.MaxX - 8, 0, B.MinZ - 4), 20)
	edgeRow(Vector3.new(B.MinX + 8, 0, B.MaxZ + 4), Vector3.new(B.MaxX - 8, 0, B.MaxZ + 4), 20)
	-- the margins between the plots' outer fences (|x| = 82) and the boundary: a few palms, trees, bushes
	for _, s in { -1, 1 } do
		for k, z in { -110, -70, -34, 24, 50, 90, 124 } do
			local x = s * rng:NextNumber(91, 97)
			if k % 2 == 0 then
				palm(f, Vector3.new(x, 0, z), rng:NextNumber(14, 19), rng)
			else
				tree(f, Vector3.new(x, 0, z), rng:NextNumber(1.0, 1.2), rng)
			end
			bush(f, Vector3.new(x - s * 5, 0, z + 6), 1.1, if k % 3 == 0 then C.FernOrange else C.Leaf)
		end
		-- north margin beside the EGG SHOP
		for _, x in { 30, 70 } do
			palm(f, Vector3.new(s * x, 0, -112 + rng:NextNumber(-4, 4)), rng:NextNumber(14, 18), rng)
		end
	end
	-- two giant dino skulls in the margins (bold shapes, not clutter)
	skull(f, KitPlace.facing(Vector3.new(-95, 0, -34), Vector3.new(0.35, 0, 1).Unit), 1.3)
	skull(f, CFrame.lookAt(Vector3.new(93, 0, 70), Vector3.new(70, 0, 60)), 1.1)
	-- secret egg: a small mossy speckled egg tucked behind a bush in the far north-east corner of the jungle edge,
	-- reachable on foot. Only the hook lives here (part SecretEgg, attribute SecretEgg = true, prompt "Take");
	-- the award side is handled elsewhere through that attribute. REPLACE: real mesh
	local SE = ParkConfig.SecretEgg
	bush(f, Vector3.new(SE.X - 3.2, 0, SE.Z + 2.6), 1.15, C.LeafDark)
	bush(f, Vector3.new(SE.X + 1.4, 0, SE.Z + 3.6), 0.8, C.Leaf)
	local egg = blob(f, MapNames.SecretEgg, Vector3.new(1.2, 1.6, 1.2), CFrame.new(SE.X, Y0 + 0.75, SE.Z) * CFrame.Angles(0, 0, math.rad(12)), Color3.fromRGB(96, 132, 70), M.SmoothPlastic)
	egg.CanCollide = true
	egg.CanQuery = true
	egg:SetAttribute("SecretEgg", true)
	for k = 1, 3 do
		local a = k * 2.1
		deco(blob(f, "SecretEggSpot", Vector3.new(0.34, 0.34, 0.12), CFrame.new(SE.X + math.cos(a) * 0.58, Y0 + 0.5 + k * 0.22, SE.Z + math.sin(a) * 0.58) * CFrame.Angles(0, -a + math.pi / 2, 0), Color3.fromRGB(196, 170, 70), M.SmoothPlastic))
	end
	local take = Kit.prompt(egg, "Take", "???", "", 6)
	take.Name = "Take"
	take.RequiresLineOfSight = false
	-- invisible boundary around the park
	local bounds = folder(f, "CT_Park_Bounds")
	for _, bd in {
		{ Vector3.new(0, 40, B.MaxZ), Vector3.new(B.MaxX - B.MinX, 80, 1) },
		{ Vector3.new(0, 40, B.MinZ), Vector3.new(B.MaxX - B.MinX, 80, 1) },
		{ Vector3.new(B.MinX, 40, (B.MinZ + B.MaxZ) / 2), Vector3.new(1, 80, B.MaxZ - B.MinZ) },
		{ Vector3.new(B.MaxX, 40, (B.MinZ + B.MaxZ) / 2), Vector3.new(1, 80, B.MaxZ - B.MinZ) },
	} do
		local w = part(bounds, "Bounds", bd[2], CFrame.new(bd[1]), Color3.new(), M.SmoothPlastic)
		w.Transparency = 1
		w.CanQuery = false
		w.CastShadow = false
	end
end

local function buildPlaza(root: Instance, rng: Random)
	local Pz = ParkConfig.Plaza
	local f = folder(root, "CT_Park_Plaza")
	pave(f, "RoutePlaza", Pz.MaxX - Pz.MinX, Pz.MaxZ - Pz.MinZ, CFrame.new((Pz.MinX + Pz.MaxX) / 2, Y0, (Pz.MinZ + Pz.MaxZ) / 2), C.StoneWarm, M.Cobblestone)
	-- the park sign on a timber arch where the main path leaves the plaza toward the clearing
	local az = Pz.MinZ + 1
	for _, sx in { -1, 1 } do
		part(f, "ArchPost", Vector3.new(1.8, 11, 1.8), CFrame.new(sx * 7.5, 5.5, az), C.WoodDark, M.Wood)
		lantern(f, Vector3.new(sx * 7.5, 11, az), 1.6, true)
	end
	deco(part(f, "ArchBeam", Vector3.new(17.4, 1.2, 1.4), CFrame.new(0, 10.5, az), C.Wood, M.Wood))
	KitPlace.signBoard(f, "ParkSign", CFrame.new(0, 12.6, az + 0.8), 12, 2.6, "PET PARK", "Landmark", { Face = C.WoodDark, Frame = C.Wood, Trim = C.Orange, Outline = true })
	-- a few lantern posts and two palms around the plaza
	for _, p in { Vector3.new(-14, 0, 94), Vector3.new(14, 0, 94), Vector3.new(-6, 0, 131), Vector3.new(6, 0, 131) } do
		lanternPost(f, p, true)
	end
	for _, p in { Vector3.new(-14, 0, 136), Vector3.new(14, 0, 136) } do
		palm(f, p, rng:NextNumber(15, 18), rng)
	end
	-- WHAT'S NEW board beside the arch, facing the spawn: a heading sign over a pale notes panel (shared/WhatsNew)
	local N = ParkConfig.NewsBoard
	local nb = model(f, "CT_Park_WhatsNew")
	local bottom = 1.6
	for _, sx in { -1, 1 } do
		part(nb, "NewsPost", Vector3.new(1.2, bottom + N.H + 3.6, 1.2), CFrame.new(N.X + sx * (N.W / 2 + 0.7), (bottom + N.H + 3.6) / 2, N.Z - 0.3), C.WoodDark, M.Wood)
	end
	part(nb, "NewsBack", Vector3.new(N.W + 0.6, N.H + 0.6, 0.4), CFrame.new(N.X, bottom + N.H / 2, N.Z - 0.35), C.Wood, M.WoodPlanks)
	KitPlace.signText(nb, "WhatsNewText", CFrame.new(N.X, bottom + N.H / 2, N.Z - 0.1), N.W, N.H, table.concat(WhatsNew.Lines, "\n"), "Placard", Color3.fromRGB(44, 40, 36), Color3.fromRGB(246, 236, 210))
	KitPlace.signBoard(nb, "WhatsNewSign", CFrame.new(N.X, bottom + N.H + 1.9, N.Z - 0.1), N.W * 0.7, 2.4, WhatsNew.Title, "Landmark", { Face = C.Orange, Frame = C.WoodDark, Trim = C.Gold, Outline = true })
end


-- PET TOWER entrance at the west end of the cross path (the tower thread hooks `TowerPortal`; nothing here does it):
-- two mossy stone pillars, a beam with the PET TOWER sign facing the park, a glowing purple doorway Part
-- `TowerPortal` (attribute TowerPortal = true, CanTouch, no collision) and a solid back.
local function buildTower(root: Instance)
	local T = ParkConfig.Tower
	local f = model(root, MapNames.TowerEntrance)
	local x, z = T.X, T.Z
	pave(f, "RouteTower", -88 - x, ParkConfig.Path.Width, CFrame.new((x - 88) / 2, Y0, z), C.Stone, M.Cobblestone)
	pave(f, "RouteTowerApron", 8, 18, CFrame.new(x + 1, Y0, z), C.StoneWarm, M.Cobblestone, 0.01)
	local H, W = 15, 12
	-- the owner's Meshy temple (front -Z turned to face +X, toward the path from the plaza); it stands behind the portal
	-- and is solid (precise mesh collision, so its steps are walkable); the plain Part door is hidden and moved onto the
	-- foot of the steps
	local gate = meshAt(f, "MeshyTowerGate", "TowerGate", Vector3.new(x - 9, Y0, z), Vector3.new(24, 34, 24), math.rad(-90))
	if gate then
		-- glowing aura: flame curtains that hug the temple and flow upward (TowerAuraFx; Beams with a scrolling texture,
		-- so it animates on every client with no script). It raycasts the temple, so it is built once the temple is in
		-- the workspace.
		task.spawn(function()
			for _ = 1, 50 do
				if gate:IsDescendantOf(workspace) then
					break
				end
				task.wait(0.1)
			end
			if gate.Parent then
				require(script.Parent.TowerAuraFx).build(gate, Y0).Parent = gate
			end
		end)
	end
	for _, sz in (if gate then {} else { -1, 1 }) :: { number } do
		part(f, "TowerPillar", Vector3.new(3.4, H, 3.4), CFrame.new(x, H / 2, z + sz * (W / 2 + 1.7)), C.Stone, M.Slate)
		deco(part(f, "Moss", Vector3.new(3.7, 1.6, 3.7), CFrame.new(x, H - 0.6, z + sz * (W / 2 + 1.7)), C.Moss, M.Grass))
		lantern(f, Vector3.new(x, H, z + sz * (W / 2 + 1.7)), 1.8, sz > 0)
	end
	if not gate then deco(part(f, "TowerBeam", Vector3.new(3.8, 2, W + 7.4), CFrame.new(x, H - 1.6, z), C.StoneDark, M.Slate)) end
	local signX, signY, signZ, signW, signH = x + 2.1, H - 1.6, z, 11, 2.4
	if gate then
		signX, signY, signZ, signW, signH = x - 6.6, 18.9, z + 0.9, 5.6, 1.5 -- on the temple's blank wooden plaque above its door
	end
	KitPlace.signBoard(f, "TowerSign", CFrame.lookAt(Vector3.new(signX, signY, signZ), Vector3.new(signX - 1, signY, signZ)), signW, signH, "TRAINING TOWER", "Landmark", { Face = Color3.fromRGB(70, 40, 110), Frame = C.WoodDark, Trim = C.Gold, Outline = true })
	local door = Instance.new("Part")
	door.Name = MapNames.TowerPortal
	door:SetAttribute("TowerPortal", true)
	door:SetAttribute("CameraIgnore", true)
	door.Size = Vector3.new(0.6, H - 3.6, W)
	door.CFrame = CFrame.new(x, (H - 3.6) / 2, z)
	door.Color = Color3.fromRGB(178, 110, 255)
	door.Material = M.Neon
	door.Transparency = 0.35
	door.Anchored = true
	door.CanCollide = false
	door.CanTouch = true
	door.CanQuery = false
	door.CastShadow = false
	door.Parent = f
	Kit.light(door, "PointLight", Color3.fromRGB(190, 130, 255), 1.4, 18)
	if gate then
		door.Transparency = 1
		door.CFrame = CFrame.new(x + 3.5, (H - 3.6) / 2, z)
		local glow = door:FindFirstChildWhichIsA("PointLight")
		if glow then -- a soft glow only: the full light tinted the temple's stone purple
			glow.Brightness = 0.5
			glow.Range = 9
		end
	end
	if not gate then
		KitPlace.blocker(f, CFrame.new(x - 1.4, H / 2, z), Vector3.new(1, H, W + 2), "TowerBack")
	end
end

-- Public HATCH STAND beside the EGG SHOP: a round two-tier stone stage with a glowing ring, a square gold top Part
-- `HatchStand` (attribute HatchStand = true) carrying the Attachment `HatchPoint` on its top face, and a sign on two
-- posts behind it. Only the hook lives here: the hatch show is played at HatchPoint by the shop side.
local function buildHatchStand(root: Instance)
	local HS = ParkConfig.HatchStand
	local f = model(root, "CT_Park_HatchStand")
	local base = CFrame.new(HS.X, Y0, HS.Z)
	local podium = meshAt(f, "MeshyHatchStand", "StageMesh", base.Position, Vector3.new(HS.D, 2.0, HS.D))
	if podium then
		KitPlace.blocker(f, base * CFrame.new(0, 1.0, 0), Vector3.new(HS.D * 0.7, 2.0, HS.D * 0.7), "StageBlock")
	else
	upCyl(f, "StageBase", HS.D, 0.8, base * CFrame.new(0, 0.4, 0), C.Stone, M.Slate)
	upCyl(f, "StageTier", HS.D - 2.6, 1.2, base * CFrame.new(0, 0.8 + 0.6, 0), C.StoneDark, M.Slate)
	end
	deco(upCyl(f, "StageRing", HS.D - 2.2, 0.2, base * CFrame.new(0, 1.7, 0), C.Orange, M.Neon)).CastShadow = false
	local top = Instance.new("Part")
	top.Name = MapNames.HatchStand
	top:SetAttribute("HatchStand", true)
	top.Size = Vector3.new(5, 0.6, 5)
	top.CFrame = base * CFrame.new(0, 2.0 + 0.3, 0)
	top.Color = C.Gold
	top.Material = M.SmoothPlastic
	top.Anchored = true
	top.CanCollide = true
	top.Parent = f
	local at = Instance.new("Attachment")
	at.Name = MapNames.HatchPoint
	at.Position = Vector3.new(0, 0.3, 0) -- the top face
	at.Parent = top
	local sz = HS.Z - HS.D / 2 - 0.8
	for _, sx in { -1, 1 } do
		part(f, "SignPost", Vector3.new(1, 9, 1), CFrame.new(HS.X + sx * 5.2, 4.5, sz), C.WoodDark, M.Wood)
		lantern(f, Vector3.new(HS.X + sx * 5.2, 9, sz), 1.4, sx > 0)
	end
	KitPlace.signBoard(f, "HatchSign", CFrame.new(HS.X, 7.6, sz + 0.2), 9, 2.0, "HATCH STAND", "Landmark", { Face = C.TealDeep, Frame = C.WoodDark, Trim = C.Gold, Outline = true })
	quiet(f)
end

-- Build ----------------------------------------------------------------------------------------------------------

-- Stall frames (kit front -Z toward where people stand) and the board frames.
function ParkBuilder.stallFrames(): { [string]: any }
	local Pz, Sh, L, TB = ParkConfig.Plaza, ParkConfig.Shop, ParkConfig.Leaderboard, ParkConfig.TowerBoard
	return {
		Upgrades = KitPlace.facing(Vector3.new(Pz.MinX + 8, 0, 112), Vector3.xAxis),
		PetBook = KitPlace.facing(Vector3.new(Pz.MaxX - 8, 0, 112), -Vector3.xAxis),
		Seller = KitPlace.facing(Vector3.new(-26, 0, Pz.MaxZ - 3), -Vector3.zAxis),
		EggShop = KitPlace.facing(Vector3.new(Sh.X, 0, Sh.Z), Vector3.zAxis),
		-- owner: only two lobby boards, side by side facing the nests
		Boards = {
			{ "Biggest", "RAREST PET", KitPlace.facing(Vector3.new(L.X, 0, L.Z), -Vector3.xAxis) } :: { any },
			{ "Tower", "HIGHEST FLOOR", KitPlace.facing(Vector3.new(TB.X, 0, TB.Z), -Vector3.xAxis) } :: { any },
		},
	}
end

function ParkBuilder.build(root: Instance): { Plots: { Plot } }
	local rng = Random.new(2027)
	buildValley(root, rng)
	buildPaths(root)
	buildClearing(root, rng)
	buildPlaza(root, rng)
	buildTower(root)
	buildHatchStand(root)
	local gallery = folder(root, "CT_Rocks_Gallery")
	local plots: { Plot } = {}
	for i = 1, ParkConfig.Plot.Count do
		table.insert(plots, buildPlot(gallery, i))
	end
	return { Plots = plots }
end

return ParkBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="246">
        <Properties>
          <string name="Name">PartyService</string>
          <string name="Source"><![CDATA[--!strict
-- Parties in the shared lobby. Invite-only; standing somewhere never enrols anyone.
-- Leader picks the tier and starts once every member is ready and has no blockers.
-- Any roster or tier change clears readiness. The roster is locked while a hunt is running.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local HuntQueue = require(Shared.HuntQueue)
local QueueConfig = require(Shared.QueueConfig)
local Profiles = require(script.Parent.Profiles)

local PartyService = {}

export type Party = {
	Id: string,
	Leader: number,
	Members: { number }, -- UserIds, join order
	Ready: { [number]: boolean },
	Tier: string,
	Locked: boolean,
	MatchKey: string?,
	-- Public hunts (lobby queue): a party object built for one hunt and never registered here. GroupOf maps each
	-- member to the group they queued with (a real party id, or "u:<id>" alone) (informational: the friend bonus counts Roblox friends in the server, server/FriendBonus).
	Public: boolean?,
	GroupOf: { [number]: string }?,
}

local parties: { [string]: Party } = {}
local partyOf: { [number]: string } = {}
local invites: { [number]: { [string]: { From: number, Expires: number } } } = {} -- invitee -> partyId -> info

local inviteCooldown: { [string]: number } = {} -- "from:to" -> os.clock() of last invite
local startHandler: ((Party) -> (boolean, string?))? = nil
local isBusy: ((number) -> boolean)? = nil
local keepOnLeave: ((number) -> boolean)? = nil

local function playerOf(userId: number): Player?
	return Players:GetPlayerByUserId(userId)
end

local function toast(player: Player, text: string, kind: string?)
	Net.event("Toast"):FireClient(player, text, kind or "info")
end
PartyService.toast = toast

function PartyService.get(id: string): Party?
	return parties[id]
end

function PartyService.of(userId: number): Party?
	local id = partyOf[userId]
	return if id then parties[id] else nil
end

-- Reasons a member cannot start the chosen tier. Empty table = good to go.
function PartyService.blockers(party: Party, userId: number): { string }
	local out = {}
	local p = playerOf(userId)
	local data = p and Profiles.get(p)
	if not data then
		table.insert(out, "Loading profile")
		return out
	end
	if p and p:GetAttribute("InTower") then
		table.insert(out, "In the pet tower") -- TowerService sets InTower while they climb
	end
	if p and p:GetAttribute("InBattle") then
		table.insert(out, "In a pet battle") -- PvpService sets InBattle while they fight
	end
	if not data.UnlockedTiers[party.Tier] then
		table.insert(out, party.Tier .. " locked")
	end
	if #data.InventoryGeodes >= Profiles.petCapacity(data) then
		table.insert(out, "Pet Book full (" .. Profiles.petCapacity(data) .. ")")
	end
	return out
end

local function view(party: Party)
	local members = {}
	for _, uid in party.Members do
		local p = playerOf(uid)
		local data = p and Profiles.get(p)
		table.insert(members, {
			UserId = uid,
			Name = if p then p.DisplayName else "?",
			Leader = uid == party.Leader,
			Ready = party.Ready[uid] == true,
			Tool = if data then data.EquippedHandheld else "Hammer",
			Blockers = PartyService.blockers(party, uid),
		})
	end
	local reason: string? = nil
	for _, m in members do
		if #m.Blockers > 0 then
			reason = m.Name .. ": " .. m.Blockers[1]
			break
		end
		if not m.Ready then
			reason = "Waiting for " .. m.Name .. " to ready"
			break
		end
	end
	if party.Locked then
		reason = "Hunt in progress"
	end
	local tier = Config.Tiers[party.Tier]
	local tutorial = false
	if #party.Members == 1 then
		local p = playerOf(party.Members[1])
		local data = p and Profiles.get(p)
		tutorial = data ~= nil and data.TutorialStep == 0
	end
	return {
		Id = party.Id,
		Leader = party.Leader,
		Members = members,
		Tier = party.Tier,
		TierRocks = if tutorial then Config.Tutorial.Rocks else tier.Rocks,
		Recommended = tier.Recommended,
		Tutorial = tutorial,
		Locked = party.Locked,
		CanStart = reason == nil,
		Reason = reason,
		Max = Config.Party.MaxSize,
	}
end
PartyService.view = view

local function invitesFor(userId: number)
	local out = {}
	local now = os.clock()
	local mine = invites[userId]
	if not mine then
		return out
	end
	for pid, inv in mine do
		local party = parties[pid]
		local from = playerOf(inv.From)
		if party and inv.Expires > now and from then
			table.insert(out, { PartyId = pid, From = from.DisplayName })
		end
	end
	return out
end

function PartyService.sync(userId: number)
	local p = playerOf(userId)
	if not p then
		return
	end
	local party = PartyService.of(userId)
	Net.event("PartyState"):FireClient(p, if party then view(party) else nil, invitesFor(userId))
	PartyService.sendQueue(p)
end

function PartyService.syncParty(party: Party)
	for _, uid in party.Members do
		PartyService.sync(uid)
	end
end

local function clearReady(party: Party)
	table.clear(party.Ready)
end

local function create(userId: number): Party
	local party: Party = {
		Id = HttpService:GenerateGUID(false),
		Leader = userId,
		Members = { userId },
		Ready = {},
		Tier = "Gravel",
		Locked = false,
	}
	parties[party.Id] = party
	partyOf[userId] = party.Id
	return party
end

function PartyService.leave(userId: number)
	local party = PartyService.of(userId)
	if not party then
		return
	end
	local idx = table.find(party.Members, userId)
	if idx then
		table.remove(party.Members, idx)
	end
	partyOf[userId] = nil
	party.Ready[userId] = nil
	if #party.Members == 0 then
		parties[party.Id] = nil
		for _, inv in invites do
			inv[party.Id] = nil
		end
	else
		if party.Leader == userId then
			party.Leader = party.Members[1] -- earliest remaining member
		end
		if not party.Locked then
			clearReady(party)
		end
		PartyService.syncParty(party)
	end
	PartyService.sync(userId)
end

function PartyService.setLocked(party: Party, locked: boolean, matchKey: string?)
	party.Locked = locked
	party.MatchKey = matchKey
	clearReady(party)
	PartyService.syncParty(party)
end

function PartyService.onStart(fn: (Party) -> (boolean, string?))
	startHandler = fn
end

-- Teleport mode: a member who leaves this server because the party is teleporting keeps their
-- seat (the party comes back together later). Return true to keep the seat.
function PartyService.setKeepOnLeave(fn: (number) -> boolean)
	keepOnLeave = fn
end

function PartyService.setBusyCheck(fn: (number) -> boolean)
	isBusy = function(uid: number): boolean
		-- a player climbing the pet tower (TowerService sets InTower) is busy like a hunter
		local p = playerOf(uid)
		if p and (p:GetAttribute("InTower") or p:GetAttribute("InBattle")) then
			return true
		end
		return fn(uid)
	end
end


local joinToastAt: { [number]: number } = {} -- userId -> os.clock() of the last "joined the queue" toast

-- Public hunt queue (lobby portal pads and the PLAY button) -----------------------------------------------------
-- Rules live in shared/HuntQueue (tested). A player or a whole party joins; the hunt starts QueueConfig.Seconds
-- after the first join with whoever is there (1..Size); a joiner who does not fit opens the next queue.

local queue = HuntQueue.new({ Size = QueueConfig.Size, Seconds = QueueConfig.Seconds, StartWhenFull = QueueConfig.StartWhenFull })
PartyService.Queue = queue -- read-only for offline tests

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function groupKey(uid: number): string
	local party = PartyService.of(uid)
	return if party then party.Id else "u:" .. uid
end

-- What one player's PLAY button shows: their queue (Mine) or the queue a new joiner would land in (Open).
function PartyService.sendQueue(p: Player)
	local now = serverNow()
	local mine = HuntQueue.find(queue, p.UserId)
	Net.event("LaunchEvent"):FireClient(p, "Queue", {
		Mine = HuntQueue.view(queue, mine, now),
		Open = HuntQueue.view(queue, HuntQueue.openQueue(queue), now),
	})
end

-- Coalesced: queue changes mark it dirty and the 0.25 s loop sends once, so button spam cannot fan out per call.
local queueDirty = false
local function broadcastQueue()
	queueDirty = true
end
local function flushQueue()
	if not queueDirty then
		return
	end
	queueDirty = false
	for _, p in Players:GetPlayers() do
		PartyService.sendQueue(p)
	end
end

-- Takes a group out of the queue (cancel, roster change, someone started another hunt).
local function unqueueGroup(key: string, why: string?)
	local members = HuntQueue.leaveGroup(queue, key)
	if #members == 0 then
		return
	end
	for _, uid in members do
		local p = playerOf(uid)
		if p and why then
			toast(p, why, "info")
		end
	end
	broadcastQueue()
end

local function unqueuePlayer(uid: number)
	if HuntQueue.leave(queue, uid) then
		broadcastQueue()
	end
end
PartyService.unqueue = unqueuePlayer

-- Why a player cannot be queued right now (nil = fine). Zone locks never block: the public hunt runs in the
-- highest zone everyone in it has unlocked.
local function queueBlocker(uid: number): string?
	local p = playerOf(uid)
	local data = p and Profiles.get(p)
	if not p or not data then
		return "Loading profile"
	end
	if isBusy and isBusy(uid) then
		return "Still in a hunt"
	end
	if #data.InventoryGeodes >= Profiles.petCapacity(data) then
		return "Pet Book full (" .. Profiles.petCapacity(data) .. ")"
	end
	return nil
end

local soloAction: ((Player) -> ())? = nil -- set below: the existing Solo path (first-time practice)

-- Join the public queue. Returns true when the player is queued (or already was).
local function queueJoin(player: Player, fromPortal: boolean): boolean
	local uid = player.UserId
	if (HuntQueue.find(queue, uid)) then
		return true
	end
	local data = Profiles.get(player)
	if not data then
		if not fromPortal then
			toast(player, "Loading your profile...", "info")
		end
		return false
	end
	-- First-time players get the practice pile, exactly as SOLO HUNT does.
	if data.TutorialStep == 0 then
		local solo = soloAction
		if solo then
			solo(player)
		end
		return false
	end
	local party = PartyService.of(uid)
	local members = { uid }
	if party then
		if party.Locked then
			toast(player, "Your party is still hunting.", "warn")
			return false
		end
		if #party.Members > 1 and party.Leader ~= uid then
			toast(player, "Your party leader joins the hunt for the whole party.", "info")
			return false
		end
		members = table.clone(party.Members)
	end
	for _, m in members do
		local why = queueBlocker(m)
		if why then
			local mp = playerOf(m)
			toast(player, (if m == uid or not mp then "" else mp.DisplayName .. ": ") .. why, "warn")
			return false
		end
	end
	local q, why = HuntQueue.join(queue, groupKey(uid), members, serverNow())
	if not q then
		if why == "AlreadyQueued" then
			toast(player, "Someone in your party is already queued.", "info")
		end
		return false
	end
	for _, m in members do
		local mp = playerOf(m)
		-- once per join: a re-join a few seconds later (portal pad touched again, PLAY tapped again after a leave)
		-- does not pop the same toast again while the HUNT IN countdown runs
		if mp and os.clock() - (joinToastAt[m] or -math.huge) > 15 then
			joinToastAt[m] = os.clock()
			toast(mp, "You joined the hunt queue!", "ok")
		end
	end
	broadcastQueue()
	return true
end

-- Starts a due queue's hunt. A single real party keeps its own party (and tier); mixed groups hunt as a public
-- party in the highest zone they all unlocked. A failed start waits RetrySeconds and tries again.
local function launch(q: HuntQueue.Queue)
	local groupOf: { [number]: string } = {}
	local members: { number } = {}
	for _, g in q.Groups do
		for i = #g.Members, 1, -1 do
			local uid = g.Members[i]
			local p = playerOf(uid)
			local why = queueBlocker(uid)
			if why or not p or not p.Character then
				table.remove(g.Members, i)
				if p then
					toast(p, "You were taken out of the hunt queue (" .. (why or "still spawning") .. ").", "warn")
				end
			end
		end
		for _, uid in g.Members do
			table.insert(members, uid)
			groupOf[uid] = g.Key
		end
	end
	if #members == 0 or not startHandler then
		return
	end
	local unlocked = {}
	for _, uid in members do
		local p = playerOf(uid)
		local data = p and Profiles.get(p)
		table.insert(unlocked, if data then data.UnlockedTiers else {})
	end
	local tier = HuntQueue.commonTier(Config.TierOrder, unlocked)
	local only = if #q.Groups == 1 then parties[q.Groups[1].Key] else nil
	local party: Party
	if only and not only.Locked and #only.Members == #members then
		party = only
		local ok = true
		for _, set in unlocked do
			ok = ok and set[party.Tier] == true
		end
		if not ok then
			party.Tier = tier
		end
	else
		party = {
			Id = "public:" .. HttpService:GenerateGUID(false),
			Leader = members[1],
			Members = members,
			Ready = {},
			Tier = tier,
			Locked = false,
			Public = true,
			GroupOf = groupOf,
		}
	end
	local start = startHandler :: (Party) -> (boolean, string?)
	local ok, err = start(party)
	if not ok then
		for _, uid in members do
			local p = playerOf(uid)
			if p then
				toast(p, (err or "Could not start the hunt.") .. " Trying again...", "warn")
			end
		end
		HuntQueue.restore(queue, q, serverNow() + QueueConfig.RetrySeconds)
	end
end

-- Lobby board and pads (built by the lobby builder; any of them may be missing).
local board: TextLabel? = nil
local pads: { BasePart } = {}
local padLook: { [BasePart]: { Color: Color3, Material: Enum.Material } } = {}
local lastBoard = ""

local function findBoard(): TextLabel?
	if board and board.Parent then
		return board
	end
	local part = Workspace:FindFirstChild("QueueBoard", true)
	local label = part and part:FindFirstChild("QueueText", true)
	board = if label and label:IsA("TextLabel") then label else nil
	return board
end

local function updateBoard()
	local first = queue.Queues[1]
	local text = QueueConfig.Board.Idle
	local count = 0
	if first then
		count = HuntQueue.count(first)
		local left = math.max(0, math.ceil(first.StartsAt - serverNow()))
		text = string.format(QueueConfig.Board.Counting, left, count, queue.Size)
	end
	local label = findBoard()
	if label and text ~= lastBoard then
		label.Text = text
	end
	lastBoard = if label then text else ""
	for i, pad in pads do
		local look = padLook[pad]
		if pad.Parent and look then
			local lit = i <= count
			pad.Color = if lit then QueueConfig.Board.PadLit else look.Color
			pad.Material = if lit then Enum.Material.Neon else look.Material
		end
	end
end

local portalLast: { [Player]: number } = {}
-- Players who tapped LEAVE: the portal pads do not queue them again until they step off (audit F02: standing on a
-- pad re-joined at the next touch, so one LEAVE looked like "You left the hunt queue. x2").
local padHold: { [Player]: true? } = {}

local function onPortalTouch(hit: BasePart)
	local model = hit:FindFirstAncestorOfClass("Model")
	local player = model and Players:GetPlayerFromCharacter(model)
	if not player then
		return
	end
	local t = os.clock()
	if t - (portalLast[player] or -math.huge) < QueueConfig.TouchDebounce then
		return
	end
	if padHold[player] then
		return
	end
	portalLast[player] = t
	if (isBusy and isBusy(player.UserId)) or not Profiles.isLoaded(player) then
		return
	end
	if not queueJoin(player, true) then
		portalLast[player] = t + 4 -- a refusal toast once, not on every step while standing on the pad
	end
end

local watched: { [BasePart]: boolean } = {}
local function watchPortal(inst: Instance)
	if not inst:IsA("BasePart") or watched[inst] or inst:GetAttribute("HuntPortal") ~= true then
		return
	end
	watched[inst] = true
	inst.Touched:Connect(onPortalTouch)
	if inst.Name ~= "HuntPortal" then
		-- the glowing pads in front of the portal light up one per queued player
		padLook[inst] = { Color = inst.Color, Material = inst.Material }
		table.insert(pads, inst)
		table.sort(pads, function(a, b)
			local ia, ib = a:GetAttribute("PadIndex"), b:GetAttribute("PadIndex")
			if type(ia) == "number" and type(ib) == "number" and ia ~= ib then
				return ia < ib
			end
			if a.Name ~= b.Name then
				return a.Name < b.Name
			end
			return a.Position.X < b.Position.X
		end)
	end
end

-- True when `player` stands on or right next to a hunt portal / queue pad (QueueConfig.PadClear studs around it).
local function onAPad(player: Player): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return false
	end
	local m = QueueConfig.PadClear
	for part in watched do
		if part.Parent then
			local rel = part.CFrame:PointToObjectSpace(root.Position)
			local half = part.Size / 2
			if math.abs(rel.X) <= half.X + m and math.abs(rel.Z) <= half.Z + m and math.abs(rel.Y) <= half.Y + 8 then
				return true
			end
		end
	end
	return false
end

local function startQueue()
	for _, d in Workspace:GetDescendants() do
		watchPortal(d)
	end
	Workspace.DescendantAdded:Connect(watchPortal)
	Players.PlayerRemoving:Connect(function(player)
		portalLast[player] = nil
		padHold[player] = nil
		joinToastAt[player.UserId] = nil
		unqueuePlayer(player.UserId)
		HuntQueue.forget(queue, player.UserId) -- no kept HUNT IN time for someone who left the server
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			for p in padHold do
				if not p.Parent or not onAPad(p) then
					padHold[p] = nil
				end
			end
			local due = HuntQueue.popDue(queue, serverNow())
			for _, q in due do
				launch(q)
			end
			if #due > 0 then
				broadcastQueue()
			end
			flushQueue()
			updateBoard()
		end
	end)
end

local function handle(player: Player, action: any, arg: any)
	if type(action) ~= "string" then
		return
	end
	local uid = player.UserId
	local party = PartyService.of(uid)
	if isBusy and isBusy(uid) and action ~= "Sync" then
		toast(player, "Tap LOBBY to leave the hunt first.", "warn")
		return
	end
	-- Someone who already went back to the lobby can still leave a party that is hunting.
	if party and party.Locked and action ~= "Sync" and action ~= "Leave" then
		toast(player, "Your party is still hunting. Leave the party to start a new one.", "warn")
		return
	end

	local kind: string = tostring(action) -- a plain string copy (the guards above over-narrow `action`)
	-- Public queue intents (PLAY button). The portal pads call queueJoin directly.
	if kind == "Queue" then
		queueJoin(player, false)
		return
	elseif kind == "Unqueue" then
		local _, g = HuntQueue.find(queue, uid)
		if g then
			padHold[player] = onAPad(player) or nil
			unqueueGroup(g.Key, "You left the hunt queue.")
		end
		return
	end
	-- Starting another hunt or changing the roster takes the group out of the queue.
	if kind == "Solo" or kind == "Start" then
		local _, g = HuntQueue.find(queue, uid)
		if g then
			unqueueGroup(g.Key, nil)
		end
	elseif kind == "Leave" or kind == "Accept" then
		unqueuePlayer(uid)
		-- only a real invite may pull a queued group out (a forged id must not kick other players)
		if kind == "Accept" and type(arg) == "string" and invites[uid] and invites[uid][arg] then
			unqueueGroup(arg, "Your party changed. Join the hunt queue again.")
		end
	elseif kind == "Kick" and type(arg) == "number" and arg ~= uid and party and party.Leader == uid and table.find(party.Members, arg) then
		-- only a member of the caller's own party: a forged id must not pull strangers out of the queue
		unqueuePlayer(arg)
	end

	if action == "Sync" then
		-- nothing, sync below
	elseif action == "Create" then
		if not party then
			party = create(uid)
		end
	elseif action == "Solo" then
		-- One-member party that starts right away when nothing blocks it.
		if party and #party.Members > 1 then
			PartyService.leave(uid)
			party = nil
		end
		local solo = party or create(uid)
		solo.Ready[uid] = true
		local v = view(solo)
		if v.CanStart and startHandler then
			local ok, err = startHandler(solo)
			if not ok then
				toast(player, err or "Could not start the hunt.", "warn")
			end
		elseif v.Reason then
			toast(player, v.Reason, "warn")
		end
		party = solo
	elseif action == "Leave" then
		PartyService.leave(uid)
		return
	elseif action == "Invite" then
		local target = if type(arg) == "number" then playerOf(arg) else nil
		if not party then
			party = create(uid)
		end
		local pt = party :: Party
		if pt.Leader ~= uid then
			toast(player, "Only the leader can invite.", "warn")
		elseif not target or target == player then
			toast(player, "That player is not in this lobby.", "warn")
		elseif #pt.Members >= Config.Party.MaxSize then
			toast(player, "Party is full (" .. Config.Party.MaxSize .. ").", "warn")
		elseif PartyService.of(target.UserId) == pt then
			toast(player, target.DisplayName .. " is already in your party.", "info")
		elseif os.clock() - (inviteCooldown[uid .. ":" .. target.UserId] or -math.huge) < 10 then
			toast(player, "Invite already sent. Wait a few seconds.", "info")
		else
			inviteCooldown[uid .. ":" .. target.UserId] = os.clock()
			invites[target.UserId] = invites[target.UserId] or {}
			invites[target.UserId][pt.Id] = { From = uid, Expires = os.clock() + Config.Party.InviteSeconds }
			PartyService.sync(target.UserId)
			toast(player, "Invite sent to " .. target.DisplayName .. ".", "ok")
			toast(target, player.DisplayName .. " invited you to a pet hunt party.", "info")
		end
	elseif action == "Accept" or action == "Decline" then
		local pid = if type(arg) == "string" then arg else ""
		local inv = invites[uid] and invites[uid][pid]
		if invites[uid] then
			invites[uid][pid] = nil
		end
		if action == "Accept" then
			local target = parties[pid]
			if not inv or inv.Expires < os.clock() or not target then
				toast(player, "That invite expired.", "warn")
			elseif target.Locked then
				toast(player, "That party is already hunting.", "warn")
			elseif #target.Members >= Config.Party.MaxSize then
				toast(player, "That party is full.", "warn")
			else
				if party then
					PartyService.leave(uid)
				end
				table.insert(target.Members, uid)
				partyOf[uid] = target.Id
				clearReady(target)
				PartyService.syncParty(target)
				return
			end
		end
	elseif action == "Kick" then
		if party and party.Leader == uid and type(arg) == "number" and arg ~= uid and table.find(party.Members, arg) then
			PartyService.leave(arg)
			local kicked = playerOf(arg)
			if kicked then
				toast(kicked, "You were removed from the party.", "info")
			end
		end
	elseif action == "Ready" then
		if party then
			party.Ready[uid] = arg == true
			PartyService.syncParty(party)
			return
		end
	elseif action == "Tier" then
		if party and party.Leader == uid and type(arg) == "string" and Config.Tiers[arg] then
			party.Tier = arg
			clearReady(party)
			PartyService.syncParty(party)
			return
		end
	elseif action == "Start" then
		if not party or party.Leader ~= uid then
			toast(player, "Only the party leader can start.", "warn")
		else
			local v = view(party)
			if not v.CanStart then
				toast(player, v.Reason or "Not ready", "warn")
			elseif startHandler then
				local ok, err = startHandler(party)
				if not ok then
					toast(player, err or "Could not start the hunt.", "warn")
				end
			end
		end
	end
	PartyService.sync(uid)
end

soloAction = function(player: Player)
	handle(player, "Solo", nil)
end

function PartyService.start()
	startQueue()
	local limiter: { [Player]: { n: number, t: number } } = {}
	Net.event("PartyAction").OnServerEvent:Connect(function(player, action, arg)
		local l = limiter[player]
		local now = os.clock()
		if not l or now - l.t > 1 then
			local fresh = { n = 0, t = now }
			limiter[player] = fresh
			l = fresh
		end
		l.n += 1
		if l.n > 8 then
			return
		end
		handle(player, action, arg)
	end)
	Players.PlayerRemoving:Connect(function(player)
		limiter[player] = nil
		invites[player.UserId] = nil
		-- keys are "from:to": drop exactly this player's pairs (a plain substring match also hit other ids)
		local id = tostring(player.UserId)
		for k in table.clone(inviteCooldown) do
			local a, b = string.match(k, "^(%d+):(%d+)$")
			if a == id or b == id then
				inviteCooldown[k] = nil
			end
		end
		local keep = keepOnLeave
		if keep and keep(player.UserId) then
			return
		end
		PartyService.leave(player.UserId)
	end)
	Profiles.onChanged(function(player)
		local party = PartyService.of(player.UserId)
		if party and not party.Locked then
			PartyService.syncParty(party)
		end
	end)
	-- Expire invites.
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for uid, list in invites do
				local changed = false
				for pid, inv in list do
					if inv.Expires < now or not parties[pid] then
						list[pid] = nil
						changed = true
					end
				end
				if changed then
					PartyService.sync(uid)
				end
			end
		end
	end)
end

return PartyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="247">
        <Properties>
          <string name="Name">PetIndex</string>
          <string name="Source"><![CDATA[--!strict
-- Pet index rewards and the lobby name tag data (owner picks). Full zone pages pay a lasting bonus (shared/EggPerks).
--   * First find: Profiles.grantSpecimen pays Config.PetIndex.FirstFindCoins the first time a species is hatched
--     (idempotent: the discovery row is written in the same save). This module only tells the player, after the
--     hatch reveal so the notice is not swept away by it.
--   * Pet Master: every species found (PetFlair.allFound). The title is derived from the saved discovery index, so
--     it can never be lost or double-granted; the badge is BadgeService "AllHuntPets" (id in ProgressConfig.Badges).
--   * Name tag: the server copies the title and the best pet tower floor (profile TowerBest) to Player attributes
--     "Title" and "TowerBest"; client NameTag draws them over the head in the lobby.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local PetFlair = require(Shared.PetFlair)
local PetModel = require(Shared.PetModel)
local EggPerks = require(Shared.EggPerks)
local Profiles = require(script.Parent.Profiles)

local PetIndex = {}

local NOTICE_DELAY = PetFlair.longestReveal() + 1.5 -- after even a slow-motion Rare+ reveal

function PetIndex.refresh(player: Player)
	local data = Profiles.get(player)
	if not data or not player.Parent then
		return
	end
	local title = PetFlair.title(data.DiscoveryIndex, data.PetMaster == true)
	if player:GetAttribute("Title") ~= title then
		player:SetAttribute("Title", title)
	end
	local best = tonumber(data.TowerBest) or 0
	best = if best == best then math.max(0, math.floor(best)) else 0
	if player:GetAttribute("TowerBest") ~= best then
		player:SetAttribute("TowerBest", best)
	end
end

local function onSpeciesFound(player: Player, species: string, coins: number)
	local data = Profiles.get(player)
	local master = data ~= nil and PetFlair.allFound(data.DiscoveryIndex)
	local found = if data then PetFlair.foundCount(data.DiscoveryIndex) else 0
	local page = if data then EggPerks.pageJustDone(data.DiscoveryIndex, species) else nil
	task.delay(NOTICE_DELAY, function()
		if not player.Parent then
			return
		end
		local toast = Net.event("Toast")
		toast:FireClient(player, "New in your Pet Book: " .. PetModel.name(species) .. "! +" .. coins .. " coins (" .. found .. "/" .. #PetFlair.species() .. ")", "ok")
		if page then
			local pct = math.floor(EggPerks.Pages.CoinsPerPage * 100 + 0.5)
			toast:FireClient(player, page.Name:upper() .. " PAGE COMPLETE! +" .. pct .. "% coins and +" .. pct .. "% pet XP forever!", "rare")
		end
		if master then
			toast:FireClient(player, "Every pet found! New title: " .. Config.PetIndex.MasterTitle, "ok")
		end
	end)
end

local started = false
function PetIndex.start()
	if started then
		return
	end
	started = true
	Profiles.onSpeciesFound(onSpeciesFound)
	Profiles.onLoaded(function(player)
		PetIndex.refresh(player)
	end)
	Profiles.onChanged(PetIndex.refresh)
end

return PetIndex
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="248">
        <Properties>
          <string name="Name">PetService</string>
          <string name="Source"><![CDATA[--!strict
-- Find The Pet: which pet follows each player, the free starter pet, and the "PetsShown" attribute every client
-- reads to draw followers (client/PetFollow). Pets themselves are specimens in the profile inventory; the server
-- decides everything here, the client only asks to equip or unequip an id it owns.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GeodeGen = require(Shared.GeodeGen)
local Net = require(Shared.Net)
local PetRules = require(Shared.PetRules)
local Retention = require(Shared.Retention)
local Profiles = require(script.Parent.Profiles)

local PetService = {}

local lastAction: { [Player]: number } = {}
local lastRename: { [Player]: number } = {}
local lastRenameWarn: { [Player]: number } = {}
local renaming: { [Player]: boolean } = {}
local renamedHandler: ((Player) -> ())? = nil

-- Tests only: replaces the Roblox text filter (asked text, user id) -> filtered text; it may error.
local filter = function(text: string, userId: number): string
	local result = TextService:FilterStringAsync(text, userId, Enum.TextFilterContext.PublicChat)
	return result:GetNonChatStringForBroadcastAsync()
end
function PetService.setFilter(fn: (string, number) -> string)
	filter = fn
end

-- Called after a pet's nickname changed or a roaming pet was called to follow (the lobby display re-renders).
function PetService.onRenamed(fn: (Player) -> ())
	renamedHandler = fn
end

local function public(g: any): { [string]: any }
	return { Id = g.Id, Mineral = g.Mineral, Rarity = g.Rarity, Modifier = g.Modifier, Formation = g.Formation, Seed = g.Seed, Mass = g.Mass, Nickname = g.Nickname, Evolve = g.Evolve }
end

-- The public fields a follower needs (no match internals). A player in the pet tower (InTower) or a Pet Battle shows
-- none, so the follower is never mistaken for one of the fighting pets. In a hunt (server attribute MatchKey) only
-- the pet helper follows (owner pick 2026-10-15, Profiles.huntHelper: one pet, never a Robux pet), marked Helper.
local function shown(player: Player, data): string
	local out = {}
	if player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true then
		return "[]"
	end
	if player:GetAttribute("MatchKey") ~= nil then
		local g = Profiles.huntHelper(data)
		if g then
			local v = public(g)
			v.Helper = true
			table.insert(out, v)
		end
		return HttpService:JSONEncode(out)
	end
	for _, id in data.EquippedPets do
		local _, g = Profiles.findGeode(data, id)
		if g then
			table.insert(out, public(g))
		end
	end
	return HttpService:JSONEncode(out)
end

-- Drops followers that are no longer owned (sold) and refreshes the attribute when it changed.
function PetService.refresh(player: Player)
	local data = Profiles.get(player)
	if not data then
		return
	end
	local dropped = false
	for i = #data.EquippedPets, 1, -1 do
		if not select(2, Profiles.findGeode(data, data.EquippedPets[i])) then
			table.remove(data.EquippedPets, i)
			dropped = true
		end
	end
	if dropped then
		-- a sold team pet's slot goes to the strongest pet left in the Pet Book (the team of 3 stays full)
		if PetRules.fillTeam(data.EquippedPets, data.InventoryGeodes, Config.Pets.Slots, if type(data.TowerXP) == "table" then data.TowerXP else nil) > 0 then
			Profiles.changed(player) -- sync the refilled team (the next refresh finds nothing dropped, so no loop)
		end
	end
	local json = shown(player, data)
	if player:GetAttribute("PetsShown") ~= json then
		player:SetAttribute("PetsShown", json)
	end
end

-- The free starter pet, once per player (a gift, not a hunt prize: no ledger, no stats, no wins). New players hatch it
-- from the starter egg near the lobby spawn (RetentionService "Starter"); skipping the tutorial hatches it too. Its
-- rarity is always Rare or better and never the zone's 1 in 1000 chase pet (Retention.Starter). Returns the pet when
-- it was hatched just now, nil when it was hatched before or there is no room in the Pet Book yet.
function PetService.ensureStarter(player: Player): { [string]: any }?
	local data = Profiles.get(player)
	if not data or data.StarterPet then
		return nil
	end
	if #data.InventoryGeodes >= Profiles.petCapacity(data) then
		return nil -- no room: the flag stays false, so the egg waits until there is room
	end
	local st = Retention.Starter
	local pet = GeodeGen.roll(Random.new(), st.Tier, HttpService:GenerateGUID(false), "starter", os.time(), true, 0, st.Weights)
	if not Profiles.grantSpecimen(player, "starter:" .. player.UserId, pet, "Gift") then
		return nil
	end
	data.StarterPet = true -- only now that the pet is really in the book
	-- the first pet always follows right away (owner pick 2026-10-14): first in the follow list, even when a pet
	-- already follows (an older save, a dev pet); the last one steps back if the list is full
	local at = table.find(data.EquippedPets, pet.Id)
	if at then
		table.remove(data.EquippedPets, at)
	end
	table.insert(data.EquippedPets, 1, pet.Id)
	while #data.EquippedPets > Config.Pets.Slots do
		table.remove(data.EquippedPets)
	end
	Profiles.changed(player)
	return pet
end

local function toast(player: Player, text: string, kind: string)
	Net.event("Toast"):FireClient(player, text, kind)
end

-- Free renaming (Pet Book detail): the client names a pet it owns and the wanted name; the server checks the shape
-- (PetRules.cleanName), runs Roblox text filtering for text other players see (FilterStringAsync +
-- GetNonChatStringForBroadcastAsync, in a pcall: a filter failure refuses the name) and saves it as the pet's
-- Nickname. An empty name clears it. One rename at a time and one per Config.Pets.RenameCooldown seconds per player.
local function rename(player: Player, id: any, raw: any)
	local data = Profiles.get(player)
	if not data or type(id) ~= "string" or not select(2, Profiles.findGeode(data, id)) then
		return
	end
	if renaming[player] then
		return
	end
	local t = os.clock()
	if t - (lastRename[player] or -math.huge) < Config.Pets.RenameCooldown then
		if t - (lastRenameWarn[player] or -math.huge) >= 1 then -- one toast a second, so spam can't flood toasts
			lastRenameWarn[player] = t
			toast(player, "Wait a moment before renaming again.", "warn")
		end
		return
	end
	local name, why = PetRules.cleanName(raw, Config.Pets.NameMax)
	if not name then
		toast(player, why or "That name can't be used.", "warn")
		return
	end
	lastRename[player] = t
	local final: string? = nil
	if name ~= "" then
		renaming[player] = true
		local ok, res = pcall(filter, name, player.UserId)
		renaming[player] = nil
		if not ok then
			toast(player, "Names can't be checked right now. Try again soon.", "warn")
			return
		end
		if not PetRules.filterAccepted(name, res) then
			toast(player, "Oops! That name can't be used. Try a different one!", "warn")
			return
		end
		final = res :: string
	end
	-- the filter yields: the player may have left, sold the pet or handed the profile over meanwhile
	if not player.Parent or not Profiles.isLoaded(player) or Profiles.isReleased(player) then
		return
	end
	local d2 = Profiles.get(player)
	if not d2 then
		return
	end
	local _, g = Profiles.findGeode(d2, id)
	if not g then
		return
	end
	g.Nickname = final
	Profiles.changed(player)
	toast(player, if final then "Your pet is now called " .. final .. "!" else "Name cleared.", "ok")
	if renamedHandler then
		renamedHandler(player)
	end
end

-- Pets called to follow leave the pen (they would show twice); they stay on display in a dome. The plot re-renders
-- through the same hook a rename uses (Gallery.render).
local function unroam(player: Player, data: any, ids: { string })
	if type(data.RoamPets) ~= "table" then
		return
	end
	local hit = false
	for _, id in ids do
		local r = table.find(data.RoamPets, id)
		if r then
			table.remove(data.RoamPets, r)
			hit = true
		end
	end
	if hit and renamedHandler then
		task.defer(renamedHandler, player)
	end
end

local function onAction(player: Player, action: any, id: any, extra: any)
	if action == "RenamePet" then
		if Profiles.isLoaded(player) and not Profiles.isReleased(player) then
			task.spawn(rename, player, id, extra)
		end
		return
	end
	if action ~= "EquipPet" and action ~= "UnequipPet" and action ~= "EquipBest" then
		return -- other collection actions belong to EconomyService
	end
	local t = os.clock()
	if t - (lastAction[player] or 0) < 0.3 then
		return
	end
	lastAction[player] = t
	if not Profiles.isLoaded(player) or Profiles.isReleased(player) then
		return -- teleport hand-off: this server no longer owns the profile
	end
	if player:GetAttribute("MatchKey") ~= nil then
		Net.event("Toast"):FireClient(player, "Change pets in the lobby.", "warn")
		return -- the hunt keeps the pet it started with (speed and luck are read from it)
	end
	local data = Profiles.get(player)
	if action == "EquipBest" then
		-- the server picks: the owned pets with the highest POWER fill the follower slots (PetRules.best)
		if not data then
			return
		end
		local best = PetRules.best(data.InventoryGeodes, Config.Pets.Slots, if type(data.TowerXP) == "table" then data.TowerXP else nil)
		if #best == 0 then
			return
		end
		local same = #best == #data.EquippedPets
		for i, bid in best do
			if data.EquippedPets[i] ~= bid then
				same = false
			end
		end
		if same then
			Net.event("Toast"):FireClient(player, "Your best pet is already following you.", "info")
			return
		end
		data.EquippedPets = best
		unroam(player, data, best)
		Profiles.changed(player)
		return
	end
	if not data or type(id) ~= "string" or not select(2, Profiles.findGeode(data, id)) then
		return
	end
	local list = data.EquippedPets
	local at = table.find(list, id)
	if action == "EquipPet" then
		if at then
			return
		end
		if #list >= Config.Pets.Slots then
			-- team full: the player picks the slot to swap (MY PETS asks); never a silent replace (carter 2026-10-15)
			local slot = PetRules.swapSlot(extra, #list)
			if not slot then
				Net.event("Toast"):FireClient(player, "Your team is full! Pick a team slot to swap.", "warn")
				return
			end
			list[slot] = id
		else
			table.insert(list, id)
		end
		unroam(player, data, { id })
	elseif at then
		table.remove(list, at)
	else
		return
	end
	Profiles.changed(player)
end

function PetService.start()
	Net.event("CollectionAction").OnServerEvent:Connect(onAction)
	Profiles.onLoaded(function(player)
		PetService.refresh(player) -- the starter pet now hatches from the starter egg (RetentionService)
	end)
	Profiles.onChanged(PetService.refresh)
	local function watch(player: Player)
		player:GetAttributeChangedSignal("MatchKey"):Connect(function()
			PetService.refresh(player)
		end)
		player:GetAttributeChangedSignal("InTower"):Connect(function()
			PetService.refresh(player)
		end)
		player:GetAttributeChangedSignal("InBattle"):Connect(function()
			PetService.refresh(player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, p in Players:GetPlayers() do
		watch(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
		lastRename[player] = nil
		lastRenameWarn[player] = nil
		renaming[player] = nil
	end)
end

return PetService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="249">
        <Properties>
          <string name="Name">PracticeBots</string>
          <string name="Source"><![CDATA[--!strict
-- Practice buddies on the first hunt (rules: shared/BotRules). The bots are plain R15 characters owned by the server
-- that act out the loop next to the new player: walk to the pile, grab, walk to their nest, tap it. They are scenery
-- only: no RockAction, no eggs taken or cracked, never a finder (the practice pet is always the player's).
-- If a character cannot be made (Roblox avatar service down) the round simply has no bots.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local BotRules = require(Shared.BotRules)
local Config = require(Shared.Config)
local StationModels = require(script.Parent.StationModels)
local RacerCollision = require(script.Parent.RacerCollision)

local PracticeBots = {}

type Live = { Bot: BotRules.Bot, Model: Model, Humanoid: Humanoid, Root: BasePart, Nest: Vector3, NestAt: Vector3, Pile: Vector3, Egg: BasePart?, Arrived: boolean, Table: Model, Target: Vector3?, LastPos: Vector3, LastMoveAt: number, LastOrderAt: number, Cycles: number }
type Group = { Live: { Live }, Running: boolean }

local groups: { [string]: Group } = {}
local rng = Random.new()
local loops = 0 -- step loops still running (tests: 0 once every practice round is over)

local factory: ((string, Color3) -> Model?)? = nil

-- Tests only: build bot characters with `fn` instead of the Roblox avatar service (the offline mock has none).
function PracticeBots.setFactory(fn: ((string, Color3) -> Model?)?)
	factory = fn
end

-- (Tests) the live bots of match `key`: name, step, carrying.
function PracticeBots.peek(key: string): { { [string]: any } }
	local out = {}
	local group = groups[key]
	local list: { Live } = if group then group.Live else {}
	for _, live in list do
		table.insert(out, { Name = live.Bot.Name, Step = live.Bot.Step, Carry = live.Bot.Carry, Cycles = live.Cycles, Pos = live.Root.Position, Pile = live.Pile, Nest = live.Nest })
	end
	return out
end

local SHAPES = { Ball = Enum.PartType.Ball, Block = Enum.PartType.Block, Wedge = Enum.PartType.Wedge }

-- Welds the outfit's chunky parts (ears, spikes, tail) onto the character, in a folder named "Outfit".
local function dress(m: Model, outfit: BotRules.Outfit)
	local folder = Instance.new("Folder")
	folder.Name = "Outfit"
	for _, op in outfit.Parts do
		local attach = (m:FindFirstChild(op.Attach) or m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")) :: BasePart?
		if attach then
			local p = Instance.new("Part")
			p.Name = op.Name
			p.Shape = SHAPES[op.Shape] or Enum.PartType.Block
			p.Size = Vector3.new(op.Size[1], op.Size[2], op.Size[3])
			p.Color = op.Color
			p.Material = Enum.Material.SmoothPlastic
			p.CanCollide, p.CanQuery, p.CanTouch, p.Massless = false, false, false, true
			local r = op.Rot or { 0, 0, 0 }
			p.CFrame = attach.CFrame * CFrame.new(op.Offset[1], op.Offset[2], op.Offset[3]) * CFrame.Angles(math.rad(r[1]), math.rad(r[2]), math.rad(r[3]))
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = attach, p
			weld.Parent = p
			p.Parent = folder
		end
	end
	folder.Parent = m
	m:SetAttribute("Outfit", outfit.Name)
end

local function makeCharacter(name: string, index: number): Model?
	local f = factory
	local outfit = BotRules.outfit(index)
	local ok, model = pcall(function()
		if f then
			return f(name, outfit.Body)
		end
		local d = Instance.new("HumanoidDescription")
		d.HeadColor = outfit.Skin
		d.LeftArmColor, d.RightArmColor = outfit.Body, outfit.Body
		d.TorsoColor = outfit.Body
		d.LeftLegColor, d.RightLegColor = outfit.Legs, outfit.Legs
		return Players:CreateHumanoidModelFromDescription(d, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[PracticeBots] no bot character: " .. tostring(model))
		return nil
	end
	local m = model :: Model
	m.Name = "PracticeBot_" .. name
	-- the default avatar's grey shirt / blue pants clothing would hide the onesie colours
	for _, c in m:GetDescendants() do
		if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") then
			c:Destroy()
		end
	end
	pcall(dress, m, outfit)
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayName = name
		hum.NameDisplayDistance = 60
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		hum.WalkSpeed = BotRules.WalkSpeed
		hum.BreakJointsOnDeath = false
	end
	m:SetAttribute("PracticeBot", true)
	return m
end

local function carryEgg(live: Live, on: boolean)
	if on and not live.Egg then
		local egg = Instance.new("Part")
		egg.Name = "BotEgg"
		egg.Shape = Enum.PartType.Ball
		egg.Size = Vector3.new(1.4, 1.8, 1.4)
		egg.Color = Color3.fromRGB(250, 244, 226)
		egg.Material = Enum.Material.SmoothPlastic
		egg.CanCollide, egg.CanQuery, egg.CanTouch, egg.Massless = false, false, false, true
		local head = live.Model:FindFirstChild("Head") :: BasePart?
		local anchor = head or live.Root
		egg.CFrame = anchor.CFrame * CFrame.new(0, 2, 0)
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1 = anchor, egg
		weld.Parent = egg
		egg.Parent = live.Model
		live.Egg = egg
	elseif not on and live.Egg then
		live.Egg:Destroy()
		live.Egg = nil
	end
end

local ARRIVE = 2.5 -- studs (flat) from the target counts as arrived
local REORDER = 2 -- seconds: MoveTo is given again (Roblox drops a MoveTo after 8 s or when it is pushed off)
local STUCK = 1 -- seconds without moving STUCK_STUDS: the bot is nudged along (a nest edge or the pile holds it)
local STUCK_STUDS = 0.4
local NUDGE = 2.5 -- studs per nudge
local logSteps = game:GetService("RunService"):IsStudio() -- Studio output: one line per bot when its first loop is done

local function flat(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function walk(live: Live, to: Vector3, now: number)
	live.Arrived = false
	live.Target = to
	live.LastOrderAt = now
	live.LastMoveAt = now
	live.LastPos = live.Root.Position
	live.Humanoid:MoveTo(to)
end

-- One movement check for a walking bot: arrival by distance, MoveTo given again, a nudge when it is stuck.
local function steer(live: Live, now: number)
	local to = live.Target
	if not to or live.Arrived then
		return
	end
	local pos = live.Root.Position
	if flat(pos, to) <= ARRIVE then
		live.Arrived = true
		return
	end
	if (pos - live.LastPos).Magnitude >= STUCK_STUDS then
		live.LastPos = pos
		live.LastMoveAt = now
	elseif now - live.LastMoveAt >= STUCK then
		-- held by something: step it along the ground toward the target and walk on from there
		local d = Vector3.new(to.X - pos.X, 0, to.Z - pos.Z)
		local stepLen = math.min(NUDGE, d.Magnitude)
		local nextPos = pos + d.Unit * stepLen
		live.Model:PivotTo(CFrame.lookAt(nextPos, nextPos + d.Unit))
		live.LastPos = nextPos
		live.LastMoveAt = now
		live.Humanoid:MoveTo(to)
		live.LastOrderAt = now
		return
	end
	if now - live.LastOrderAt >= REORDER then
		live.Humanoid:MoveTo(to)
		live.LastOrderAt = now
	end
end

-- Bots for practice match `key`: one per free nest (tables whose index is not in `used`), up to BotRules.Count.
function PracticeBots.spawn(key: string, arena: { [string]: any }, used: { [number]: boolean })
	PracticeBots.clear(key)
	local center = arena.Center
	local tables = arena.Tables
	if typeof(center) ~= "Vector3" or type(tables) ~= "table" or typeof(arena.Root) ~= "Instance" then
		return
	end
	local free = {}
	for i, tbl in tables do
		if not used[i] and typeof(tbl) == "Instance" and tbl:IsA("Model") then
			table.insert(free, { Index = i, Model = tbl })
		end
	end
	local group: Group = { Live = {}, Running = true }
	groups[key] = group
	local spawns = arena.Spawns
	local radius = 10
	local okTier, tier = pcall(function()
		return Config.Tiers[Config.Tutorial.Tier]
	end)
	if okTier and tier and type(tier.Radius) == "number" then
		radius = tier.Radius
	end
	-- the step loop runs from the start; bots join it as their characters are made (making one can take a second)
	-- The loop also ends on its own when this group is no longer the match's current one, or once every bot model is
	-- gone (arena cleared under it): a practice crew can never outlive its round (walkthrough 10-14: bots kept
	-- looping ToPile/Grab/ToNest/Crack in the Output after the player was back in the lobby).
	local born = os.clock()
	local function alive(): boolean
		if not group.Running or groups[key] ~= group then
			return false
		end
		for _, live in group.Live do
			if live.Model.Parent then
				return true
			end
		end
		return #group.Live == 0 and os.clock() - born < 30 -- characters still being made
	end
	task.spawn(function()
		loops += 1
		while alive() do
			local now = os.clock()
			for _, live in group.Live do
				local before = live.Bot.Step
				steer(live, now)
				if BotRules.advance(live.Bot, now, live.Arrived, rng) then
					local step = live.Bot.Step
					if step == "ToPile" then
						walk(live, live.Pile, now)
					elseif step == "ToNest" then
						walk(live, live.Nest, now)
					else
						live.Target = nil
						live.Humanoid:Move(Vector3.zero)
						if step == "Crack" then
							live.Cycles += 1
							live.Root.CFrame = CFrame.lookAt(live.Root.Position, Vector3.new(live.NestAt.X, live.Root.Position.Y, live.NestAt.Z))
						end
					end
					if logSteps and step == "Crack" and live.Cycles == 1 then
						print(("[PracticeBots] %s finished its first pile -> nest loop"):format(live.Bot.Name)) -- once, not every step
					end
					if before ~= step then
						carryEgg(live, live.Bot.Carry)
					end
					if step == "Crack" then
						-- a little hop on each tap so the crack reads from across the arena
						task.spawn(function()
							for _ = 1, 3 do
								if not group.Running or not live.Model.Parent then
									return
								end
								live.Humanoid.Jump = true
								task.wait(0.6)
							end
						end)
					end
				end
			end
			task.wait(0.2)
		end
		group.Running = false
		loops -= 1
	end)
	for i, bot in BotRules.make(#free, rng, os.clock()) do
		task.spawn(function()
			local slot = free[i]
			local model = makeCharacter(bot.Name, i)
			if not model then
				return
			end
			if not group.Running then
				model:Destroy()
				return
			end
			local hum = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not hum or not root then
				model:Destroy()
				return
			end
			local nest = slot.Model:GetPivot().Position
			local away = Vector3.new(nest.X - center.X, 0, nest.Z - center.Z)
			local dir = if away.Magnitude > 0.1 then away.Unit else Vector3.new(0, 0, 1)
			-- stand where a player of that nest spawns (always clear ground), else a little in front of the nest
			local spot = if type(spawns) == "table" and typeof(spawns[slot.Index]) == "CFrame" then (spawns[slot.Index] :: CFrame).Position else nest - dir * 4
			local nestStand = Vector3.new(spot.X, center.Y, spot.Z)
			local pileEdge = center + dir * (radius + 2) -- just outside the pile, facing this bot's nest
			model:PivotTo(CFrame.lookAt(spot + Vector3.new(0, 1, 0), Vector3.new(center.X, spot.Y + 1, center.Z)))
			model.Parent = arena.Root
			RacerCollision.apply(model, true) -- bots pass through players like racers do
			pcall(function()
				root:SetNetworkOwner(nil)
			end)
			StationModels.setOwner(slot.Model, -i, bot.Name)
			local t = os.clock()
			local live: Live = {
				Bot = bot, Model = model, Humanoid = hum, Root = root, Nest = nestStand, NestAt = nest, Pile = pileEdge, Egg = nil,
				Arrived = false, Table = slot.Model, Target = nil, LastPos = root.Position, LastMoveAt = t, LastOrderAt = t, Cycles = 0,
			}
			table.insert(group.Live, live)
		end)
	end
end

-- Removes match `key`'s bots (round over, player left). Safe to call when there are none.
function PracticeBots.clear(key: string)
	local group = groups[key]
	if not group then
		return
	end
	group.Running = false
	groups[key] = nil
	for _, live in group.Live do
		if live.Model.Parent then
			live.Model:Destroy()
		end
		if live.Table.Parent then
			StationModels.setOwner(live.Table, nil, nil)
		end
	end
end

-- (Tests) how many bot step loops are still running across all matches.
function PracticeBots.loops(): number
	return loops
end

-- How many bots match `key` has (tests and the dev tools).
function PracticeBots.count(key: string): number
	local group = groups[key]
	return if group then #group.Live else 0
end

return PracticeBots
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="250">
        <Properties>
          <string name="Name">PreviewKit</string>
          <string name="Source"><![CDATA[--!strict
-- Shop preview models: one clone of every hand tool and machine in ReplicatedStorage.Assets.Previews,
-- built from the SAME factories the world uses (WorldBuilder.toolModel, MachineModels.build), so the
-- shop shows the real model: uploaded mesh when present, the Part model otherwise. The client
-- (ui/ItemView) prefers ReplicatedStorage.Assets.Kit.<name> when a kit model of that name is Ready.
-- Cheap: a handful of models built once at boot, never per UI open.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local World = require(script.Parent.WorldBuilder)
local MachineModels = require(script.Parent.MachineModels)

local PreviewKit = {}

local function anchorAll(m: Instance)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		elseif d:IsA("SurfaceGui") then
			d:Destroy() -- the owner plate text is not part of a shop picture
		end
	end
end

function PreviewKit.build()
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		assets = Instance.new("Folder")
		assets.Name = "Assets"
		assets.Parent = ReplicatedStorage
	end
	local old = (assets :: Instance):FindFirstChild("Previews")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Previews"
	for _, id in Config.HandheldOrder do
		local ok, m = pcall(World.toolModel, id, 1)
		if ok and m then
			m.Name = id
			anchorAll(m)
			m.Parent = folder
		end
	end
	for _, id in Config.MachineOrder do
		local holder = Instance.new("Folder")
		local ok, m = pcall(MachineModels.build, id, CFrame.new(), holder, 0, "")
		if ok and m then
			m.Name = id
			anchorAll(m)
			m.Parent = folder
		end
		holder:Destroy()
	end
	folder.Parent = assets
end

return PreviewKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="251">
        <Properties>
          <string name="Name">Profiles</string>
          <string name="Source"><![CDATA[--!strict
-- Player profiles: load with a session lock, autosave, release on leave and on shutdown.
-- Rules: never save a default profile over data we could not read; never save a profile we
-- do not hold the lock for. Studio uses separate "_Studio" stores. If DataStores are not
-- reachable in Studio (API access off), the player gets a session-only profile that is never
-- written, and the HUD shows "SAVES OFF".

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local GeodeGen = require(Shared.GeodeGen)
local Cosmetics = require(Shared.Cosmetics)
local Materials = require(Shared.Materials)
local ProgressConfig = require(Shared.ProgressConfig)
local Quests = require(Shared.Quests)
local Retention = require(Shared.Retention)
local Hangout = require(Shared.Hangout)
local PetRules = require(Shared.PetRules)
local PetStats = require(Shared.PetStats)

-- A loaded save (reconciled against the defaults below); fields are read loosely, as saved.
type Data = { [string]: any }
local PetFlair = require(Shared.PetFlair)
local RobuxConfig = require(Shared.RobuxConfig)
local EggPerks = require(Shared.EggPerks)
local HuntFun = require(Shared.HuntFun)
local LaunchPerks = require(Shared.LaunchPerks)
local Net = require(Shared.Net)

local Profiles = {}

local IS_STUDIO = RunService:IsStudio()
local SUFFIX = if IS_STUDIO then "_Studio" else ""
local JOB = if game.JobId ~= "" then game.JobId else ("studio-" .. HttpService:GenerateGUID(false))

local store: DataStore? = nil
local storeOk = pcall(function()
	store = DataStoreService:GetDataStore(Config.Save.StoreName .. SUFFIX)
end)

local loaded: { [Player]: any } = {}
local releasing: { [Player]: boolean } = {}
local loadAttempts: number = Config.Save.LoadAttempts
local joinGate: ((Player) -> boolean)? = nil
local loading: { [Player]: boolean } = {}
local holds: { [Player]: number } = {} -- award code holding a profile open (hold / unhold)
local changedHandlers: { (Player) -> () } = {}
local loadedHandlers: { (Player, any) -> () } = {}
local speciesHandlers: { (Player, string, number) -> () } = {}
local shutdownHandlers: { () -> () } = {} -- final writes BindToClose waits for (leaderboards, ledger)
-- run (spawned) after every committed save of a player's profile, with the os.clock() the winning attempt started at
local savedHandlers: { (Player, number) -> () } = {}
local shuttingDown = false -- BindToClose started: retries back off briefly so every save fits the shutdown budget

function Profiles.isStudio(): boolean
	return IS_STUDIO
end

function Profiles.defaults(): { [string]: any }
	return {
		Schema = Config.Save.SchemaVersion,
		Cash = 0,
		RubbleByTier = {},
		EquipmentOwned = { Hammer = true },
		EquippedHandheld = "Hammer",
		InstalledMachine = nil,
		CapacityTier = 1,
		UnlockedTiers = { Gravel = true },
		InventoryGeodes = {},
		DisplayAssignments = {},
		-- display picks the owner set to roam (owner ask 2026-10-13): they walk around the plot pen instead of a dome.
		-- Always a subset of DisplayAssignments (EconomyService "Roam"); added without a schema bump.
		RoamPets = {},
		DisplayCapacity = 1,
		DiscoveryIndex = {},
		-- mineral -> rarity -> count: the index silhouettes (Discovery index, mineral x rarity)
		DiscoveryRarity = {},
		-- Robux cosmetics only: Owned, Equipped (kind -> id), Receipts (PurchaseId keys, idempotent grants)
		Cosmetics = Cosmetics.empty(),
		-- Material Discoveries: Found (category -> true) and Counts (category -> finished ordinary crushes).
		-- Presentation only; added without a schema bump (reconcile fills it for older profiles).
		Materials = Materials.empty(),
		TutorialStep = 0, -- 0 until the practice pile is done
		-- Onboarding steps, tracked apart from the prize so the order can vary and nothing repeats:
		-- Started (practice begun), Cracked (an ordinary rock), Geode (first find), Sold (rubble
		-- sold), Displayed (a specimen in the gallery), Goal (saw the cash / first upgrade goal).
		Onboard = { Started = false, PickedUp = false, Deposited = false, Cracked = false, Geode = false, Sold = false, Displayed = false, Goal = false, Skipped = false },
		Settings = { Music = 0.6, Sfx = 0.8, CameraSensitivity = 0.5, ReducedMotion = false, LowEffects = false, Hints = true },
		Stats = { SoloFinds = 0, MultiplayerWins = 0, MatchesPlayed = 0, RocksCracked = 0, CashEarned = 0, BestGeodeValue = 0 },
		RecentAwardIds = {},
		PendingAwards = {},
		-- Find The Pet: specimen ids of the pets following the player (max Config.Pets.Slots); StarterPet = the free
		-- starter pet every player hatches once (Rare or better, PetService.ensureStarter).
		EquippedPets = {},
		StarterPet = false,
		TowerBest = 0, -- highest pet tower floor cleared (TowerService)
		TowerXP = {}, -- pet id -> tower XP (TowerService owns levels)
		TowerReviveCredits = 0, -- bought tower revives not yet used (TowerService)
		TowerReceipts = {}, -- PurchaseIds already granted for tower revives
		-- Tower pet pity (TowerRules.dropChance / TowerConfig.Pity): boss clears in a row without a pet drop.
		TowerPity = 0,
		-- Pet Battle (PvpService): trophies, current and best win streak, wins and losses.
		Pvp = { Trophies = 0, Streak = 0, BestStreak = 0, Wins = 0, Losses = 0 },
		-- Pet Master title earned (PetFlair.allFound once true). Kept so a weekly pet released later never takes it away.
		PetMaster = false,
		-- Pet Book slots on top of Config.Inventory.Max (Profiles.petCapacity). 0 for everyone now; a future game pass
		-- helper (made by the owner) may raise it. Never lowered by this build.
		ExtraPetSlots = 0,
		LastSeenNews = "", -- last WHAT'S NEW version the player saw (shared/WhatsNew, set via SettingsAction)
		-- Find The Pet part 2 (shared/ProgressConfig): basket and nest upgrade levels (1 = free starter), the daily
		-- gift + daily quests (shared/Quests, server/QuestService) and the badges already awarded (server/BadgeService).
		BasketLevel = 1,
		NestLevel = 1,
		Daily = Quests.empty(),
		SecretEggFound = false, -- found the hidden lobby egg (BadgeService)
		TowerFloorsToday = 0, -- tower floors cleared on Daily.Day (QuestService resets it each UTC day)
		Badges = {},
		-- Robux shop (shared/RobuxConfig, server/RobuxService): Receipts (granted PurchaseIds), LuckUntil (potion end,
		-- os.time), Passes (owned game passes), purchase counters. Added without a schema bump (reconcile fills it).
		Robux = RobuxConfig.emptyState(),
		-- First five minutes and comeback hooks (shared/Retention, server/RetentionService): last seen time, today's
		-- play-time gifts, friend gifts paid today, last group gift day. Added without a schema bump.
		Retention = Retention.empty(),
		-- Lobby hangout (shared/Hangout): daily likes, mini-game coins today, hidden eggs, lookout, group gift.
		-- Added without a schema bump (reconcile fills it; Hangout.sanitize repairs it).
		Hangout = Hangout.empty(),
		-- Reasons to want eggs (shared/EggPerks): Lucky Meter, banked free eggs, fight-win and quest-egg counters.
		-- Added without a schema bump (reconcile fills it; EggPerks.sanitize repairs it).
		EggPerks = EggPerks.empty(),
		-- Launch picks (shared/LaunchPerks): spin wheel clock and count, the auto-hatch egg. Added without a schema bump.
		Perks = LaunchPerks.empty(),
	}
end

-- Fills missing fields from defaults (never removes data). Migrations go here by Schema.
local function reconcile(data: Data): Data
	local def = Profiles.defaults()
	local hadRarity = type(data.DiscoveryRarity) == "table"
	for k, v in def do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) ~= "table" then
			data[k] = v -- a corrupt value where a table belongs (nothing to keep): use the default
		elseif type(v) == "table" and (k == "Settings" or k == "Stats" or k == "Pvp") then
			for k2, v2 in v do
				local cur = data[k][k2]
				if type(v2) == "number" and (type(cur) ~= "number" or cur ~= cur) then
					local n = tonumber(cur)
					data[k][k2] = if n and n == n then n else v2 -- missing or wrong type (an old or hand-edited save)
				elseif type(cur) ~= type(v2) then
					data[k][k2] = v2
				end
			end
		elseif type(v) == "number" and (type(data[k]) ~= "number" or data[k] ~= data[k]) then
			local n = tonumber(data[k])
			data[k] = if n and n == n then n else v
		end
	end
	local st = data.Settings
	for _, k in { "Music", "Sfx" } do
		st[k] = if st[k] == st[k] then math.clamp(st[k], 0, 1) else def.Settings[k]
	end
	-- Rubble counts must be whole non-negative numbers; unknown tier ids (a newer build) are kept untouched.
	for tierId, n in data.RubbleByTier do
		if type(tierId) ~= "string" or type(n) ~= "number" or n ~= n or n < 0 then
			data.RubbleByTier[tierId] = nil
		else
			data.RubbleByTier[tierId] = math.floor(n)
		end
	end
	-- Specimens are tables; anything else in the list is corrupt and cannot be shown, sold or displayed.
	for i = #data.InventoryGeodes, 1, -1 do
		local g = data.InventoryGeodes[i]
		if type(g) ~= "table" then
			table.remove(data.InventoryGeodes, i)
		else
			if type(g.Mass) ~= "number" or g.Mass ~= g.Mass then
				g.Mass = 2 -- every rolled specimen has a mass; the gallery sizes models from it (GeodeGen.visualScale)
			end
			if g.Nickname ~= nil and (type(g.Nickname) ~= "string" or g.Nickname == "") then
				g.Nickname = nil -- a pet nickname is a filtered string (PetService) or absent
			end
			if g.Shiny ~= nil and g.Shiny ~= true then
				g.Shiny = nil -- shiny pets (LaunchPerks.Shiny) carry true; anything else is not shiny
			end
			if g.Evolve ~= nil and (type(g.Evolve) ~= "number" or g.Evolve ~= g.Evolve or g.Evolve < 1) then
				g.Evolve = nil -- evolve stage (PvpService): a whole number from 1, or absent
			elseif g.Evolve ~= nil then
				g.Evolve = math.floor(g.Evolve)
			end
		end
	end
	for i = #data.DisplayAssignments, 1, -1 do
		if type(data.DisplayAssignments[i]) ~= "string" then
			table.remove(data.DisplayAssignments, i)
		end
	end
	data.RoamPets = Profiles.roamList(data)
	if type(data.EquippedHandheld) ~= "string" or not Config.Handhelds[data.EquippedHandheld] then
		data.EquippedHandheld = "Hammer" -- unknown (future) tool id: hold the hammer, keep the ownership record
	end
	-- Older saves: rebuild the mineral x rarity index from the specimens still owned (sold ones
	-- are lost to the index silhouettes; the per-mineral counts above stay as they were).
	if not hadRarity and type(data.InventoryGeodes) == "table" then
		for _, g in data.InventoryGeodes do
			if type(g) == "table" and type(g.Mineral) == "string" and type(g.Rarity) == "string" then
				local row = data.DiscoveryRarity[g.Mineral] or {}
				data.DiscoveryRarity[g.Mineral] = row
				row[g.Rarity] = (row[g.Rarity] or 0) + 1
			end
		end
	end
	data.Materials = Materials.normalize(data.Materials)
	local cos = data.Cosmetics
	for k, v in Cosmetics.empty() do
		if type(cos[k]) ~= "table" then
			cos[k] = v
		end
	end
	-- Saves from before onboarding steps existed: infer what was already done (never repeat it).
	if type(data.Onboard) ~= "table" then
		data.Onboard = {}
	end
	local ob = data.Onboard
	for _, k in { "Started", "PickedUp", "Deposited", "Cracked", "Geode", "Sold", "Displayed", "Goal", "Skipped" } do
		if type(ob[k]) ~= "boolean" then
			ob[k] = false
		end
	end
	if data.TutorialStep >= 1 then
		ob.Started, ob.Cracked, ob.Geode = true, true, true
	end
	-- V3 loop: "Cracked" used to mean cracking at the pile. Saves that already crushed (or finished
	-- the practice round) have necessarily been through the new first two steps, so never repeat them.
	if ob.Cracked or ob.Geode then
		ob.PickedUp, ob.Deposited = true, true
	end
	if data.Stats.CashEarned > 0 then
		ob.Sold = true
	end
	if #data.DisplayAssignments > 0 then
		ob.Displayed = true
	end
	-- Find The Pet: geode saves name minerals and the old traits. Move each to a pet species / trait (the same specimen
	-- id, rarity, value and history), and merge the discovery rows the same way. Nothing is deleted.
	for _, g in data.InventoryGeodes do
		if type(g.Mineral) == "string" and not Config.Minerals[g.Mineral] and Config.MineralMigration[g.Mineral] then
			g.Mineral = Config.MineralMigration[g.Mineral] -- an id from a newer build is kept as it is
		end
		if type(g.Modifier) == "string" and Config.ModifierMigration[g.Modifier] then
			g.Modifier = Config.ModifierMigration[g.Modifier]
		end
	end
	for oldId, n in table.clone(data.DiscoveryIndex) do
		if type(oldId) == "string" and not Config.Minerals[oldId] and Config.MineralMigration[oldId] then
			local newId = Config.MineralMigration[oldId]
			data.DiscoveryIndex[oldId] = nil
			data.DiscoveryIndex[newId] = (tonumber(data.DiscoveryIndex[newId]) or 0) + (tonumber(n) or 0)
		end
	end
	for oldId, row in table.clone(data.DiscoveryRarity) do
		if type(oldId) == "string" and not Config.Minerals[oldId] and Config.MineralMigration[oldId] and type(row) == "table" then
			local newId = Config.MineralMigration[oldId]
			data.DiscoveryRarity[oldId] = nil
			local dest = data.DiscoveryRarity[newId]
			if type(dest) ~= "table" then
				dest = {}
				data.DiscoveryRarity[newId] = dest
			end
			for r, c in row :: { [any]: any } do
				dest[r] = (tonumber(dest[r]) or 0) + (tonumber(c) or 0)
			end
		end
	end
	-- Equipped pets: only owned ids, no repeats, at most Config.Pets.Slots.
	local seen, kept = {}, {}
	for _, id in data.EquippedPets do
		if type(id) == "string" and not seen[id] and #kept < Config.Pets.Slots and select(2, Profiles.findGeode(data, id)) then
			seen[id] = true
			table.insert(kept, id)
		end
	end
	data.EquippedPets = kept
	if type(data.StarterPet) ~= "boolean" then
		data.StarterPet = false
	end
	if type(data.PetMaster) ~= "boolean" then
		data.PetMaster = false
	end
	if not data.PetMaster and PetFlair.allFound(data.DiscoveryIndex) then
		data.PetMaster = true -- saves from before the flag: earned under today's species list
	end
	data.TowerPity = math.max(0, math.floor(data.TowerPity))
	-- Upgrade levels: whole numbers from 1; a level above this build's table is kept (lookups clamp it).
	data.ExtraPetSlots = math.max(0, math.floor(data.ExtraPetSlots))
	data.BasketLevel = math.max(1, math.floor(data.BasketLevel))
	data.NestLevel = math.max(1, math.floor(data.NestLevel))
	data.Daily = Quests.sanitize(data.Daily)
	data.Retention = Retention.sanitize(data.Retention)
	for k, v in data.Badges do
		if type(k) ~= "string" or v ~= true then
			data.Badges[k] = nil
		end
	end
	data.Robux = RobuxConfig.sanitize(data.Robux)
	data.EggPerks = EggPerks.sanitize(data.EggPerks)
	data.Perks = LaunchPerks.sanitize(data.Perks)
	-- never lower the marker: a save written by a newer build keeps its schema when an older server (a rolling update)
	-- loads it, so the newer build does not run its migrations twice
	local schema = tonumber(data.Schema)
	data.Schema = if schema and schema == schema and schema > Config.Save.SchemaVersion then math.floor(schema) else Config.Save.SchemaVersion
	-- Only an owned, known machine can be installed.
	if data.InstalledMachine ~= nil and not (type(data.InstalledMachine) == "string" and Config.Machines[data.InstalledMachine] and data.EquipmentOwned[data.InstalledMachine]) then
		data.InstalledMachine = nil
	end
	data.EquipmentOwned.Hammer = true
	data.UnlockedTiers.Gravel = true
	if not data.EquipmentOwned[data.EquippedHandheld] then
		data.EquippedHandheld = "Hammer"
	end
	return data
end
Profiles.reconcile = reconcile -- tests (tests/server/profiles.luau)

local function key(userId: number): string
	return "u_" .. userId
end

-- A lock belongs to one load (session id), not to the server: a quick rejoin on the same
-- server must wait for the previous session's release save.
local function lockFree(lock: any): boolean
	if type(lock) ~= "table" then
		return true
	end
	return os.time() - (tonumber(lock.Time) or 0) > Config.Save.LockSeconds
end

local function budgetWait(kind: Enum.DataStoreRequestType)
	local t0 = os.clock()
	while DataStoreService:GetRequestBudgetForRequestType(kind) < 1 and os.clock() - t0 < (if shuttingDown then 2 else 10) do
		task.wait(0.5)
	end
end

-- Returns profile record or nil + reason. Never returns defaults when the read failed.
local function loadRecord(player: Player): (any?, string?)
	if not storeOk or not store then
		if IS_STUDIO then
			return { Data = reconcile(Profiles.defaults()), Offline = true }, nil
		end
		return nil, "DataStore unavailable"
	end
	local ds = store :: DataStore
	local lastErr = "unknown"
	local session = HttpService:GenerateGUID(false)
	for attempt = 1, loadAttempts do
		budgetWait(Enum.DataStoreRequestType.UpdateAsync)
		local result: any = nil
		local blocked = false
		local corrupt = false
		local ok, err = pcall(function()
			ds:UpdateAsync(key(player.UserId), function(old)
				old = old or nil
				-- our own lock from an earlier attempt of this same load (the write landed but the call errored)
				local mine = old and type(old.Lock) == "table" and old.Lock.Session == session
				if old and not mine and not lockFree(old.Lock) then
					blocked = true
					return nil -- keep stored value untouched
				end
				if old ~= nil and type(old.Data) ~= "table" then
					corrupt = true
					return nil -- never overwrite a save we cannot read
				end
				local data = if old then old.Data else Profiles.defaults()
				-- Rev moves on every lock take-over and release, so a server that lost the lock can tell a newer
				-- copy was written (saveRecord). Saves from before Rev existed count as 0.
				local rev = (if old and type(old.Rev) == "number" then old.Rev else 0) + (if mine then 0 else 1)
				result = { Data = data, Lock = { Job = JOB, Session = session, Time = os.time() }, Rev = rev }
				return result
			end)
		end)
		if ok and result then
			-- An odd save must never kill the join thread: on a reconcile error hand the lock straight back
			-- (the stored data is left exactly as it was) and report it, so the player is kicked with a message.
			local rok, rerr = pcall(reconcile, result.Data)
			if not rok then
				warn("[Profiles] save could not be prepared", player.UserId, rerr)
				pcall(function()
					ds:UpdateAsync(key(player.UserId), function(old)
						if old and type(old.Lock) == "table" and old.Lock.Session == session then
							old.Lock = nil
							return old
						end
						return nil
					end)
				end)
				return nil, "save could not be read"
			end
			result.Data = rerr
			result.Session = session
			result.Rev = result.Rev or 0
			return result, nil
		end
		if not ok then
			lastErr = tostring(err)
			-- Studio without API access: run offline, never write.
			if IS_STUDIO and (string.find(lastErr, "403") or string.find(lastErr, "API")) then
				return { Data = reconcile(Profiles.defaults()), Offline = true }, nil
			end
		elseif blocked then
			lastErr = "profile is open on another server"
		elseif corrupt then
			return nil, "save could not be read"
		end
		if not player.Parent then
			return nil, "left"
		end
		task.wait(math.min(2 ^ attempt, 12))
	end
	return nil, lastErr
end

-- The save lock was lost (another server took the profile): progress made here can no longer be saved. Never
-- silent: tell the player, then send them away so their next join loads the newest copy. Once per session;
-- not while the player is already leaving.
local function lockLostNotice(player: Player, rec: any)
	if rec.LockLostNotified or releasing[player] or loaded[player] ~= rec or not player.Parent then
		return
	end
	rec.LockLostNotified = true
	pcall(function()
		Net.event("Toast"):FireClient(player, "Your save moved to another server. Rejoin to keep saving!", "warn")
	end)
	task.delay(3, function()
		if player.Parent then
			player:Kick("FIND THE PET! Your save was opened on another server, so this one stopped saving. Rejoin to keep saving.")
		end
	end)
end

-- Writes the profile if we still own the lock. release=true clears the lock.
local function saveRecord(player: Player, rec: any, release: boolean, attempts: number?, maxWait: number?): boolean
	if rec.Released and not release then
		return false -- the lock was handed over (teleport): a late save would take it back
	end
	if rec.Offline or not store then
		return true
	end
	if rec.LockLost then
		return false -- another server owns this profile now: nothing this session holds may be written
	end
	local ds = store :: DataStore
	for attempt = 1, attempts or 4 do
		budgetWait(Enum.DataStoreRequestType.UpdateAsync)
		if rec.Released and not release then
			return false
		end
		local startedAt = os.clock() -- the data written below is at least this fresh
		local lost = false
		local skipped = false
		local newRev = rec.Rev or 0
		local ok, err = pcall(function()
			ds:UpdateAsync(key(player.UserId), function(old)
				if rec.Released and not release then
					skipped = true -- released while this save waited: leave the stored value alone
					return nil
				end
				-- A plain save also needs our lock to still be there: a missing lock means this session
				-- already released (a late save after leaving) or another server took and released it.
				local ours = old and type(old.Lock) == "table" and old.Lock.Session == rec.Session
				if old and (if release then type(old.Lock) == "table" and not ours else not ours) then
					lost = true
					return nil
				end
				-- Rev moves on every lock take-over and release. A stored Rev above ours means another server took
				-- this profile (and maybe released it) after us: its copy is newer, so never write over it, not
				-- even on our own release after a long DataStore outage.
				local storedRev = if old and type(old.Rev) == "number" then old.Rev else 0
				if old and storedRev > (rec.Rev or 0) then
					lost = true
					return nil
				end
				newRev = math.max(storedRev, rec.Rev or 0) + (if release then 1 else 0)
				return {
					Data = rec.Data,
					Lock = if release then nil else { Job = JOB, Session = rec.Session, Time = os.time() },
					Rev = newRev,
				}
			end)
		end)
		if ok then
			if skipped then
				return false
			end
			if lost then
				warn("[Profiles] lock lost for", player.UserId, "- not saving")
				rec.LockLost = true
				lockLostNotice(player, rec)
				return false
			end
			rec.Rev = newRev
			rec.Dirty = false
			rec.LastSave = os.clock()
			for _, fn in savedHandlers do
				task.spawn(fn, player, startedAt)
			end
			return true
		end
		warn("[Profiles] save failed", player.UserId, err)
		if attempt < (attempts or 4) then
			task.wait(math.min(2 ^ attempt, maxWait or math.huge, if shuttingDown then 2 else math.huge))
		end
	end
	return false
end

function Profiles.get(player: Player): { [string]: any }?
	local rec = loaded[player]
	return if rec then rec.Data else nil
end

function Profiles.isOffline(player: Player): boolean
	local rec = loaded[player]
	return rec ~= nil and rec.Offline == true
end

function Profiles.isLoaded(player: Player): boolean
	return loaded[player] ~= nil
end

function Profiles.onChanged(fn: (Player) -> ())
	table.insert(changedHandlers, fn)
end

-- A species hatched for the first time (pet index): (player, species id, coins already paid).
function Profiles.onSpeciesFound(fn: (Player, string, number) -> ())
	table.insert(speciesHandlers, fn)
end

function Profiles.onLoaded(fn: (Player, any) -> ())
	table.insert(loadedHandlers, fn)
end

-- Call after any mutation. Marks dirty and notifies listeners (UI sync, debounced there).
-- light = true when only cash / rubble / equipment changed (the client keeps its inventory).
function Profiles.changed(player: Player, light: boolean?)
	local rec = loaded[player]
	if rec then
		rec.Dirty = true
		if not light then
			rec.InventoryDirty = true
		end
	end
	for _, fn in changedHandlers do
		task.spawn(fn, player)
	end
end

-- True once per inventory change: the next client sync must include the inventory.
function Profiles.takeInventoryDirty(player: Player): boolean
	local rec = loaded[player]
	if rec and rec.InventoryDirty then
		rec.InventoryDirty = false
		return true
	end
	return false
end

function Profiles.saveNow(player: Player): boolean
	local rec = loaded[player]
	if not rec then
		return false
	end
	return saveRecord(player, rec, false)
end

-- Teleport hand-off ------------------------------------------------------------------------
-- Before a player is teleported to another place of this experience, the profile is saved and
-- the session lock released, so the destination can take it at once. Bounded retries; if the
-- release fails the caller must NOT teleport (the destination would wait on a held lock).
-- After a release the in-memory profile is frozen for writes: gameplay code checks isReleased.

function Profiles.isReleased(player: Player): boolean
	local rec = loaded[player]
	return rec ~= nil and rec.Released == true
end

-- True when another server took this player's session lock (this copy can no longer save).
function Profiles.lockLost(player: Player): boolean
	local rec = loaded[player]
	return rec ~= nil and rec.LockLost == true
end

function Profiles.releaseForTeleport(player: Player): (boolean, string?)
	local rec = loaded[player]
	if not rec then
		return false, "Profile not loaded"
	end
	if rec.Released then
		return true, nil
	end
	if releasing[player] then
		return false, "Leaving"
	end
	if rec.LockLost then
		return false, "Save lock lost"
	end
	-- an award being saved right now must land before the lock is handed over (bounded wait)
	local t0 = os.clock()
	while (holds[player] or 0) > 0 and os.clock() - t0 < Config.Match.RewardSaveTimeout do
		task.wait(0.1)
	end
	if rec.Released then
		return true, nil
	end
	if rec.Offline then
		rec.Released = true -- nothing stored, nothing to hand over
		return true, nil
	end
	if saveRecord(player, rec, true, Config.Teleport.ReleaseAttempts, 4) then
		rec.Released = true
		return true, nil
	end
	return false, "Could not save your profile"
end

-- Teleport failed: take the lock back. Only succeeds if nobody else holds the lock and nobody
-- released a newer copy (Rev unchanged); otherwise the profile is left alone and the caller
-- should send the player away from this server.
function Profiles.reacquire(player: Player): boolean
	local rec = loaded[player]
	if not rec then
		return false
	end
	if not rec.Released then
		return true
	end
	if rec.Offline or not store then
		rec.Released = false
		return true
	end
	local ds = store :: DataStore
	local session = HttpService:GenerateGUID(false)
	for attempt = 1, Config.Teleport.ReleaseAttempts do
		budgetWait(Enum.DataStoreRequestType.UpdateAsync)
		local refused = false
		local ok, err = pcall(function()
			ds:UpdateAsync(key(player.UserId), function(old)
				if old and ((type(old.Lock) == "table" and not lockFree(old.Lock)) or (old.Rev or 0) ~= (rec.Rev or 0)) then
					refused = true
					return nil
				end
				return { Data = rec.Data, Lock = { Job = JOB, Session = session, Time = os.time() }, Rev = rec.Rev or 0 }
			end)
		end)
		if ok then
			if refused then
				warn("[Profiles] profile moved to another server, not re-acquiring", player.UserId)
				rec.LockLost = true
				return false
			end
			rec.Session = session
			rec.Released = false
			rec.Dirty = false
			rec.LastSave = os.clock()
			return true
		end
		warn("[Profiles] re-acquire failed", player.UserId, err)
		task.wait(math.min(2 ^ attempt, 4))
	end
	return false
end

-- Match server: a player is only loaded after the gate says yes (ticket check).
function Profiles.setJoinGate(fn: (Player) -> boolean)
	joinGate = fn
end

function Profiles.setLoadAttempts(n: number)
	loadAttempts = n
end

-- Helpers ---------------------------------------------------------------------------------

function Profiles.rubbleTotal(data: Data): number
	local n = 0
	for _, v in data.RubbleByTier do
		if type(v) == "number" then
			n += v
		end
	end
	return n
end

-- What the rubble bag sells for (the server's price list; the HUD preview and the results screen use this).
function Profiles.rubbleValue(data: Data): number
	local _, value = Profiles.sellableRubble(data)
	return value
end

-- Rubble the current build can price: (count, cash). Rubble of a tier this build does not know (written
-- by a newer build) is neither priced nor sold, so a sale here can never destroy it for nothing.
function Profiles.sellableRubble(data: Data): (number, number)
	local count, value = 0, 0
	for tierId, n in data.RubbleByTier do
		local tier = Config.Tiers[tierId]
		if tier and type(n) == "number" and n > 0 then
			count += n
			value += n * tier.CashPerRubble
		end
	end
	-- EggPerks.coinMult: +10% per full Pet Book page
	return count, math.floor(value * (1 + Profiles.petCoinBoost(data)) * RobuxConfig.coinMult(data.Robux) * EggPerks.coinMult(data.DiscoveryIndex))
end

-- Boosts from the pets following the player: { Coins, Speed, Luck } fractions (Config.Pets). Pets are found in hunts,
-- never bought, so this is not pay-to-win. Coins only raise the shell sell price.
function Profiles.petBoosts(data: Data): { [string]: number }
	local out = { Coins = 0, Speed = 0, Luck = 0 }
	if type(data.EquippedPets) ~= "table" then
		return out
	end
	for _, id in data.EquippedPets do
		local _, g = Profiles.findGeode(data, id)
		local sp = g and Config.Minerals[g.Mineral]
		if g and sp and out[sp.BoostKind] then
			out[sp.BoostKind] += (sp.Boost + (Config.Pets.RarityBoost[g.Rarity] or 0)) * Config.Pets.KindScale[sp.BoostKind]
		end
	end
	for k, v in out do
		out[k] = math.clamp(math.floor(v * 100 + 0.5) / 100, 0, Config.Pets.KindCap[k])
	end
	return out
end

-- Pet Book size: Config.Inventory.Max, plus the Pet Storage+ game pass (RobuxConfig).
-- Same as petCapacity (kept for the Robux shop code).
function Profiles.inventoryMax(data: Data): number
	return Profiles.petCapacity(data)
end

function Profiles.petCoinBoost(data: Data): number
	return Profiles.petBoosts(data).Coins
end

-- Counts one finished ordinary crush toward the material discoveries. `key` identifies the rock
-- (match key, round, rock id); a key seen before changes nothing, so a duplicate completion cannot count twice.
-- Returns (counted, isNew).
local materialSeen: { [Player]: { [string]: boolean } } = {}
function Profiles.recordMaterial(player: Player, key: string, id: string): (boolean, boolean)
	local data = Profiles.get(player)
	if not data then
		return false, false
	end
	local seen = materialSeen[player]
	if not seen then
		seen = {}
		materialSeen[player] = seen
	end
	if seen[key] then
		return false, false
	end
	local counted, isNew = Materials.record(data.Materials, id)
	if counted then
		seen[key] = true
		Profiles.changed(player, true)
	end
	return counted, isNew
end

-- Level lookups clamp to the levels this build knows: a level bought in a newer build (above the table)
-- gets the biggest known size instead of falling back to level 1, and the stored level is never lowered.
local function level(list: { any }, n: any): any
	local i = if type(n) == "number" and n == n then math.clamp(math.floor(n), 1, #list) else 1
	return list[i]
end

function Profiles.capacity(data: Data): number
	return level(Config.Capacity, data.CapacityTier).Size
end

-- Pet Book capacity: Config.Inventory.Max plus the save's ExtraPetSlots. The hook a Robux game pass helper will use
-- later (it raises ExtraPetSlots); pets are cosmetic storage, never power, so more room is not pay-to-win.
-- Pet Book size: the base 100, plus the Pet Storage+ game pass (RobuxConfig), plus ExtraPetSlots.
function Profiles.petCapacity(data: any): number -- any: MatchService passes a Data? it narrowed at runtime
	return PetRules.capacity(RobuxConfig.inventoryMax(Config.Inventory.Max, data.Robux), data.ExtraPetSlots)
end

-- The roaming picks that are still on display, once each (older saves have no RoamPets).
function Profiles.roamList(data: Data): { string }
	local out, seen = {}, {}
	if type(data.RoamPets) == "table" then
		for _, id in data.RoamPets do
			if type(id) == "string" and not seen[id] and table.find(data.DisplayAssignments, id) then
				seen[id] = true
				table.insert(out, id)
			end
		end
	end
	return out
end

function Profiles.displaySlots(data: Data): number
	return RobuxConfig.displaySlots(level(Config.Display, data.DisplayCapacity).Slots, data.Robux)
end

function Profiles.onboardDone(data: Data): boolean
	local o = data.Onboard
	-- selling candy is optional (coins buy upgrades); the tutorial is the loop: find, show, then the goal card
	return o.Skipped or (o.Started and o.Cracked and o.Geode and o.Displayed and o.Goal)
end

-- Marks an onboarding step done (no-op if already done). Returns true if it changed.
function Profiles.onboard(player: Player, step: string): boolean
	local data = Profiles.get(player)
	if not data or data.Onboard[step] ~= false then
		return false
	end
	data.Onboard[step] = true
	Profiles.changed(player, true)
	return true
end

function Profiles.finds(data: Data): number
	return data.Stats.SoloFinds + data.Stats.MultiplayerWins
end

function Profiles.findGeode(data: Data, id: string): (number?, any)
	for i, g in data.InventoryGeodes do
		if g.Id == id then
			return i, g
		end
	end
	return nil, nil
end

-- Pets from Robux eggs sell for a token share of their value (audit fix: Robux must not buy coins / upgrades).
local BOUGHT_SELL_SHARE = 0.1

-- True for a pet that came out of a Robux egg: RobuxService grants them under the award key "robux:<PurchaseId>:<n>"
-- (kept as the pet's MatchKey by GeodeGen.roll); a pet may also carry Source = "Robux".
function Profiles.isBought(g: any): boolean
	if type(g) ~= "table" then
		return false
	end
	return g.Source == "Robux" or (type(g.MatchKey) == "string" and string.sub(g.MatchKey, 1, 6) == "robux:")
end

-- The pet that helps in the hunt (owner pick 2026-10-15, shared/HuntFun): the strongest equipped pet that was not
-- bought with Robux, and its POWER (tower XP book). nil when none qualifies.
function Profiles.huntHelper(data: Data): ({ [string]: any }?, number)
	local list = {}
	local book = (data :: any).TowerXP
	for _, id in data.EquippedPets do
		local _, g = Profiles.findGeode(data, id)
		if g then
			local xp = if type(book) == "table" then book[tostring(g.Id)] else nil
			table.insert(list, { Pet = g, Xp = if type(xp) == "number" and xp == xp then math.max(xp, 0) else 0, Bought = Profiles.isBought(g) })
		end
	end
	return HuntFun.pickHelper(list)
end

-- The value a pet sells for before Config.Sell.SpecimenFraction (EconomyService "Sell"); the client sees this as the
-- pet's Value (publicView), so the total it shows always matches what the server pays.
function Profiles.priceValue(g: any): number
	local v = if type(g) == "table" and type(g.Value) == "number" and g.Value == g.Value then g.Value else 0
	if Profiles.isBought(g) then
		return math.floor(v * BOUGHT_SELL_SHARE)
	end
	return v
end

-- Idempotent specimen grant keyed by award key. Returns true if newly granted.
-- Refused on a released profile (handed to another place for a teleport) or one whose lock was lost: the write would
-- never be saved here. The caller keeps the award pending (AwardLedger) so the next server grants it.
function Profiles.grantSpecimen(player: Player, awardKey: string, specimen, kind: string): boolean
	local rec = loaded[player]
	local data = if rec then rec.Data else nil
	if not data or rec.Released or rec.LockLost or rec.Closing then
		return false
	end
	for _, k in data.RecentAwardIds do
		if k == awardKey then
			return false
		end
	end
	if Profiles.findGeode(data, specimen.Id) then
		return false
	end
	table.insert(data.InventoryGeodes, specimen)
	table.insert(data.RecentAwardIds, awardKey)
	-- Find The Pet: the pet you just hatched joins the team when a slot is empty or when it is stronger than the weakest
	-- team member (PetRules.autoFollow, by POWER with the save's TowerXP). A "Bonus" pet (a helper's lucky common,
	-- MatchService) never auto-follows.
	if type(data.EquippedPets) == "table" and kind ~= "Bonus" then
		local xpBook = if type(data.TowerXP) == "table" then data.TowerXP else nil
		PetRules.autoFollow(data.EquippedPets, specimen.Id, Config.Pets.Slots, function(petId: string): number
			local _, g = Profiles.findGeode(data, petId)
			local xp = if xpBook then xpBook[petId] else nil
			return if g then PetStats.powerOfPet(g, if type(xp) == "number" then xp else nil) else -1
		end)
	end
	while #data.RecentAwardIds > Config.Save.RecentAwardsKept do
		table.remove(data.RecentAwardIds, 1)
	end
	-- Pet index reward: coins the first time this species is hatched. Read before the hatch is counted and paid in
	-- this same write, so the discovery row itself makes it idempotent (PetFlair.firstFindReward).
	local firstFind = PetFlair.firstFindReward(data.DiscoveryIndex, specimen.Mineral)
	if firstFind > 0 then
		data.Cash += firstFind
	end
	data.DiscoveryIndex[specimen.Mineral] = (data.DiscoveryIndex[specimen.Mineral] or 0) + 1
	local rarityRow = data.DiscoveryRarity[specimen.Mineral] or {}
	data.DiscoveryRarity[specimen.Mineral] = rarityRow
	rarityRow[specimen.Rarity] = (rarityRow[specimen.Rarity] or 0) + 1
	if not data.PetMaster and PetFlair.allFound(data.DiscoveryIndex) then
		data.PetMaster = true -- kept for good: a weekly pet released later never takes the title away
	end
	-- Competitive wins only come from multiplayer hunts; solo and practice finds are Solo Finds.
	-- A "Bonus" pet is neither a win nor a find. A "Bought" pet (Robux egg, RobuxService) is neither, and it does not
	-- count for the RAREST PET board either (boards stay earned in hunts). A "Gift" pet (the starter egg, an away-nest
	-- hatch: RetentionService) is none of these and does not count as the practice find either.
	if kind == "Multiplayer" then
		data.Stats.MultiplayerWins += 1
	elseif kind ~= "Bonus" and kind ~= "Bought" and kind ~= "Tower" and kind ~= "Gift" then
		data.Stats.SoloFinds += 1 -- tower drops are not finds (finds unlock zones)
	end
	if kind ~= "Gift" then
		data.Onboard.Geode = true
	end
	if kind ~= "Bought" and kind ~= "Tower" and kind ~= "Gift" then
		data.Stats.BestGeodeValue = math.max(data.Stats.BestGeodeValue, specimen.Value)
	end
	Profiles.changed(player)
	if firstFind > 0 then
		for _, fn in speciesHandlers do
			task.spawn(fn, player, specimen.Mineral, firstFind)
		end
	end
	return true
end

-- Public view sent to the owning client (no lock data, no ledger internals).
function Profiles.publicView(player: Player, withInventory: boolean?): { [string]: any }?
	local data = Profiles.get(player)
	if not data then
		return nil
	end
	local inv: { any }? = nil
	if withInventory ~= false then
		local list = table.create(#data.InventoryGeodes)
		inv = list
		local xpBook = if type(data.TowerXP) == "table" then data.TowerXP else nil
		for i, g in data.InventoryGeodes do
			local pub = GeodeGen.public(g)
			if Profiles.isBought(g) then
				pub.Value = Profiles.priceValue(g) -- the sell price the Pet Book shows and the server pays
				pub.Bought = true
			end
			local xp = xpBook and xpBook[tostring(g.Id)]
			if type(xp) == "number" then
				pub.TowerXP = xp -- tower XP lives in its own book (TowerService); the Pet Book level reads it here
			end
			list[i] = pub
		end
	end
	return {
		Cash = data.Cash,
		RubbleByTier = data.RubbleByTier,
		Rubble = Profiles.rubbleTotal(data),
		RubbleValue = Profiles.rubbleValue(data),
		Materials = Materials.publicView(data.Materials),
		Capacity = Profiles.capacity(data),
		CapacityTier = data.CapacityTier,
		EquipmentOwned = data.EquipmentOwned,
		EquippedHandheld = data.EquippedHandheld,
		InstalledMachine = data.InstalledMachine,
		UnlockedTiers = data.UnlockedTiers,
		Inventory = inv, -- nil = unchanged since the last full sync
		InventoryCount = #data.InventoryGeodes,
		InventoryMax = Profiles.petCapacity(data),
		DisplayAssignments = data.DisplayAssignments,
		RoamPets = Profiles.roamList(data),
		EquippedPets = data.EquippedPets,
		PetSlots = Config.Pets.Slots,
		PetCoinBoost = Profiles.petCoinBoost(data),
		PetBoosts = Profiles.petBoosts(data),
		PetBoost = (function(): { Kind: string?, Amount: number }
			local bs = Profiles.petBoosts(data)
			for _, k in { "Coins", "Speed", "Luck" } do
				if bs[k] > 0 then
					return { Kind = k, Amount = bs[k] }
				end
			end
			return { Kind = nil, Amount = 0 }
		end)(),
		BasketLevel = data.BasketLevel,
		NestLevel = data.NestLevel,
		TowerBest = data.TowerBest,
		Pvp = data.Pvp,
		SecretEggFound = data.SecretEggFound == true,
		CarryCapacity = ProgressConfig.carry(data.BasketLevel),
		NestQueue = ProgressConfig.queue(data.NestLevel),
		Daily = Quests.view(data.Daily, player.UserId, Quests.day(os.time())),
		Gifts = Retention.view(data.Retention, Retention.day(os.time())), -- play-time gifts (next one, time left)
		StarterEgg = data.StarterPet ~= true, -- the free starter egg near the spawn is still waiting
		DisplaySlots = Profiles.displaySlots(data),
		DisplayCapacity = data.DisplayCapacity,
		DiscoveryIndex = data.DiscoveryIndex,
		DiscoveryRarity = data.DiscoveryRarity,
		Cosmetics = { Owned = data.Cosmetics.Owned, Equipped = data.Cosmetics.Equipped },
		-- Robux shop: potion end (os.time, server clock), owned passes, plot slots (stub until plots exist)
		Robux = { LuckUntil = data.Robux.LuckUntil, Passes = data.Robux.Passes },
		EggPerks = EggPerks.view(data.EggPerks, data.DiscoveryIndex), -- Lucky Meter, free eggs, Pet Book pages
		Perks = LaunchPerks.view(data.Perks, data.Robux, os.time()), -- spin wheel, starter pack, limited egg, lucky hour
		TutorialStep = data.TutorialStep,
		Onboard = data.Onboard,
		OnboardDone = Profiles.onboardDone(data),
		Settings = data.Settings,
		LastSeenNews = data.LastSeenNews,
		Stats = data.Stats,
		Finds = Profiles.finds(data),
		SavesOff = Profiles.isOffline(player),
	}
end

-- Lifecycle -------------------------------------------------------------------------------

local releasingUser: { [number]: boolean } = {}
-- A leaver whose release save failed (DataStore outage): the record (pets, coins) stays here and the save is retried in
-- the background, at shutdown, or handed straight back to the same player if they rejoin this server. Our lock is still
-- on the stored copy, so no other server can load an older copy while this one waits.
local parked: { [number]: any } = {}
local PARK_RETRY_EVERY = 30
local PARK_RETRIES = 20 -- 10 minutes
local retryParked: (number, any) -> ()

-- Kick text for a failed load (plain words; the reason in brackets helps support).
local function loadFailText(err: string?): string
	if err == "profile is open on another server" then
		return "FIND THE PET! Your save is still open on another server (after a crash this can take up to 5 minutes). "
			.. "Your pets are safe. Please rejoin in a few minutes."
	end
	return "FIND THE PET! could not load your save safely. Your pets are safe. Please rejoin in a minute. (" .. tostring(err) .. ")"
end

local function onJoin(player: Player)
	if loading[player] or loaded[player] then
		return
	end
	loading[player] = true
	local rec: any = nil -- a record whose lock we took, so a failure below can hand it back
	local ok: boolean, perr: any = pcall(function()
		if joinGate and not (joinGate :: (Player) -> boolean)(player) then
			return -- not allowed here: no profile is touched
		end
		-- Same-server rejoin: let the previous session finish its release save first.
		local t0 = os.clock()
		while releasingUser[player.UserId] and os.clock() - t0 < 30 do
			task.wait(0.25)
		end
		local err: string? = nil
		local kept = parked[player.UserId]
		if kept then
			-- this server still holds the newest copy (its release save failed): hand it back, never reload an older one
			parked[player.UserId] = nil
			kept.Closing = nil
			rec, err = kept, nil
		else
			rec, err = loadRecord(player)
		end
		loading[player] = nil
		if not player.Parent then
			local r = rec
			rec = nil
			if r and not r.Offline then
				r.Closing = true
				-- release the lock we just took (or the copy we adopted); a failed release keeps the copy parked
				if not saveRecord(player, r, true) and not r.LockLost and store then
					parked[player.UserId] = r
					task.spawn(retryParked, player.UserId, r)
				end
			end
			return
		end
		if not rec then
			warn("[Profiles] could not load", player.UserId, err)
			player:Kick(loadFailText(err))
			return
		end
		rec.LastSave = os.clock()
		rec.Player = player
		loaded[player] = rec
		player:SetAttribute("ProfileLoaded", true)
		for _, fn in loadedHandlers do
			task.spawn(fn, player, rec.Data)
		end
		Profiles.changed(player)
	end)
	loading[player] = nil
	if not ok then
		-- Never leave a player in the game without a profile (and never leave our lock behind).
		warn("[Profiles] join failed", player.UserId, perr)
		local r = rec
		if r and loaded[player] ~= r and not r.Offline then
			task.spawn(saveRecord, player, r, true)
		end
		if loaded[player] == nil and player.Parent then
			player:Kick(loadFailText("join error"))
		end
	end
end

-- Award code can hold a profile open briefly so a leaving winner's prize lands before release.
function Profiles.hold(player: Player)
	holds[player] = (holds[player] or 0) + 1
end
function Profiles.unhold(player: Player)
	holds[player] = math.max(0, (holds[player] or 1) - 1)
end

-- Keeps trying a failed release save until it lands, the lock turns out lost, the player rejoins here (onJoin
-- adopts the record) or the retries run out.
retryParked = function(userId: number, rec: any)
	for _ = 1, PARK_RETRIES do
		task.wait(PARK_RETRY_EVERY)
		if parked[userId] ~= rec then
			return -- adopted by a rejoin, or saved by the shutdown pass
		end
		local ok = saveRecord(rec.Player, rec, true, 1)
		if parked[userId] ~= rec then
			return
		end
		if ok or rec.LockLost then
			parked[userId] = nil
			return
		end
	end
	if parked[userId] == rec then
		parked[userId] = nil
		warn("[Profiles] release save never landed for", userId, "- the lock expires on its own")
	end
end

local function onLeave(player: Player)
	local rec = loaded[player]
	if not rec or releasing[player] then
		return
	end
	releasing[player] = true
	releasingUser[player.UserId] = true
	local t0 = os.clock()
	while (holds[player] or 0) > 0 and os.clock() - t0 < Config.Match.RewardSaveTimeout do
		task.wait(0.2)
	end
	if type(rec.Data.Retention) == "table" then
		rec.Data.Retention.LastSeen = os.time() -- the away nest counts from here (RetentionService)
	end
	if not rec.Released then
		-- from here on a grant would miss the release save: grantSpecimen refuses it (the caller keeps it pending)
		rec.Closing = true
		-- a released profile was already saved; the lock is not ours
		if not saveRecord(player, rec, true) and not rec.LockLost and not rec.Offline and store then
			parked[player.UserId] = rec
			task.spawn(retryParked, player.UserId, rec)
		end
	end
	loaded[player] = nil
	releasing[player] = nil
	releasingUser[player.UserId] = nil
	holds[player] = nil
	materialSeen[player] = nil
end

function Profiles.start()
	Players.PlayerAdded:Connect(onJoin)
	Players.PlayerRemoving:Connect(onLeave)
	for _, p in Players:GetPlayers() do
		task.spawn(onJoin, p)
	end
	task.spawn(function()
		while true do
			task.wait(5)
			for player, rec in loaded do
				-- Clean profiles save too, so the lock's Time stays fresh and never looks abandoned.
				if not rec.Released and os.clock() - (rec.LastSave or 0) >= Config.Save.AutosaveSeconds and not releasing[player] then
					task.spawn(saveRecord, player, rec, false)
					rec.LastSave = os.clock()
				end
			end
		end
	end)
	game:BindToClose(function()
		shuttingDown = true
		-- Final writes of other services (leaderboards, ledger) run beside the profile saves, inside the same budget.
		-- They start first so they still see every loaded profile.
		local running = 0
		for _, fn in shutdownHandlers do
			running += 1
			task.spawn(function()
				local ok: boolean, err: any = pcall(fn)
				if not ok then
					warn("[Profiles] shutdown handler failed", err)
				end
				running -= 1
			end)
		end
		for player in loaded do
			task.spawn(onLeave, player)
		end
		-- leavers whose release save failed earlier: one last try each (their retry loop stops once they leave the list)
		for userId, rec in table.clone(parked) do
			running += 1
			task.spawn(function()
				local ok = saveRecord(rec.Player, rec, true)
				if parked[userId] == rec then
					parked[userId] = nil
				end
				if not ok then
					warn("[Profiles] shutdown: release save failed for", userId)
				end
				running -= 1
			end)
		end
		local t0 = os.clock()
		while next(loading) ~= nil and os.clock() - t0 < 10 do
			task.wait(0.2) -- a load still running takes a lock; let it land so it is released below
		end
		for player in loaded do
			task.spawn(onLeave, player) -- onLeave ignores players already releasing
		end
		while (next(loaded) ~= nil or running > 0) and os.clock() - t0 < 25 do
			task.wait(0.2)
		end
	end)
end

-- A final write BindToClose should wait for (bounded by the same 25 s as the profile saves). fn may yield.
function Profiles.onShutdown(fn: () -> ())
	table.insert(shutdownHandlers, fn)
end

-- Runs (spawned) after every committed save of a player's profile, including the release save on leave.
-- startedAt: os.clock() when that save attempt began; every in-memory change made before it is in the save.
function Profiles.onSaved(fn: (Player, number) -> ())
	table.insert(savedHandlers, fn)
end

return Profiles
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="252">
        <Properties>
          <string name="Name">Pvp</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Pet Battle + Pet Training boot (its own Script so Main.server.luau stays untouched). See PvpService.
require(script.Parent.PvpService).start()
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="253">
        <Properties>
          <string name="Name">PvpService</string>
          <string name="Source"><![CDATA[--!strict
-- Pet Battle (1v1, 3 pets each) and Pet Training (carter 2026-10-14: find the pet -> train the pet -> fight).
-- Server authority: matchmaking, the fight (shared/PvpRules), rewards, trophies, streaks and training XP are all
-- decided here; clients send intents only (ReplicatedStorage.PvpNet.PvpAction) and draw what PvpEvent tells them.
-- Fights reuse the tower: same team (TowerService.team), same XP book and levels, and the client draws them with
-- TowerView. Every fight gets its own floating island (SkyIsland, carter 2026-10-14): both fighters are moved onto
-- it and back to the lobby after the result; nobody spectates. Nobody waits more than PvpConfig.BotAfter seconds: a bot (shown with a BOT
-- tag) steps in.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetRules = require(Shared.PetRules)
local PvpConfig = require(Shared.PvpConfig)
local PvpRules = require(Shared.PvpRules)
local PetStats = require(Shared.PetStats)
local TowerConfig = require(Shared.TowerConfig)
local Profiles = require(script.Parent.Profiles)
local TowerService = require(script.Parent.TowerService)
local SkyIsland = require(script.Parent.SkyIsland)
local IslandRules = require(Shared.IslandRules)
local RockService = require(script.Parent.RockService)
local Gallery = require(script.Parent.GalleryService)
local FightBoard = require(script.Parent.FightBoard)
local GeodeGen = require(Shared.GeodeGen)
local EggPerks = require(Shared.EggPerks)
local Net = require(Shared.Net)

local PvpService = {}
PvpService.onSend = nil :: ((Player, any) -> ())? -- offline tests (tests/server/pvp.luau) watch every message

type Fight = {
	Key: string,
	Slot: number,
	Arena: Model,
	Origin: CFrame,
	Radius: number, -- the island's fight floor radius (the fall catcher puts anyone past it back on their mark)
	Layout: any, -- PvpConfig.Layouts entry
	Views: { CFrame }, -- [side] origin each side's client draws from (side 2 is mirrored, so both see their pets in front)
	Players: { [number]: Player? }, -- [side]; nil = bot
	Names: { string },
	BotSide: number?,
	Rules: PvpRules.Fight,
	Specs: { [string]: any },
	ForfeitAt: { Phase: string, Time: number }?, -- set when a side left before the result (settle pays the stayer)
	Info: { [string]: any }, -- unit id -> { Rarity, Level, Cap, Power } (the loser's finisher card shows the winner's)
	PetIds: { [string]: any }, -- unit id -> saved pet id (players only)
	Phase: string, -- "CountIn" | "Fighting" | "Cheer" | "Closed"
	Timer: number,
	Pending: { PvpRules.Event },
	SendIn: number,
	BotReadyAt: number?,
	BotTaps: number, -- bot taps owed (PvpConfig.Tap.BotTaps a second)
	Left: { [number]: boolean }, -- [side] forfeited (left mid-fight)
}

type Ticket = { Player: Player, Since: number, Power: number }

local queue: { Ticket } = {}
local boardLive: () -> ()
local boardSpot: () -> CFrame?
local catchFalls: () -> ()
local fightOf: { [Player]: Fight } = {}
local fights: { [string]: Fight } = {}
local returnCF: { [Player]: CFrame } = {}
local lastOp: { [Player]: { [string]: number } } = {}
local taps: { [Player]: { Tokens: number, At: number } } = {}
local syncAt: { [Player]: number } = {}
local serial = 0
local event: RemoteEvent

local SEND_EVERY = 0.2
-- Where a player stands: behind their own pets (z -14), closer than the tower's rug so the camera behind them stays
-- inside the arena walls.
local function standAt(view: CFrame, layout: any): CFrame
	local pos = view * Vector3.new(layout.StandX or 0, 3.5, layout.StandZ)
	local fight = view * Vector3.new(0, 3.5, (layout.PetZ + layout.FoeZ) / 2)
	return CFrame.lookAt(pos, fight) -- watching the middle of the fight
end

-- Side 2 sees the arena turned round about the middle of the two pet lines, so both see their own pets in front.
local function mirror(layout: any): CFrame
	return CFrame.new(0, 0, layout.PetZ + layout.FoeZ) * CFrame.Angles(0, math.pi, 0)
end

local function send(p: Player?, msg: any)
	if p and p.Parent then
		event:FireClient(p, msg)
		local hook = PvpService.onSend
		if hook then
			hook(p, msg)
		end
	end
end

-- Rate limit: true when `op` may run now for this player (at most one per `gap` seconds).
local function allow(p: Player, op: string, gap: number): boolean
	local book = lastOp[p]
	if not book then
		book = {}
		lastOp[p] = book
	end
	local now = os.clock()
	if now - (book[op] or -math.huge) < gap then
		return false
	end
	book[op] = now
	return true
end

local function stats(data: any): any
	local s = data and data.Pvp
	return if type(s) == "table" then s else { Trophies = 0, Streak = 0, BestStreak = 0, Wins = 0, Losses = 0 }
end

local function teamPets(p: Player, side: number): { PvpRules.TeamPet }
	local out = {}
	for i, g in TowerService.team(p) do
		if i > PvpConfig.TeamSize then
			break
		end
		table.insert(out, {
			Id = side .. ":" .. i,
			Name = PetRules.label(g),
			Xp = TowerService.xpOf(p, g.Id),
			Pet = g,
		})
	end
	return out
end

-- Pets that may not be used up by an evolve: following, shown on the plot or roaming it.
local function lockedPets(data: any): { [string]: boolean }
	local out: { [string]: boolean } = {}
	for _, key in { "EquippedPets", "DisplayAssignments", "RoamPets" } do
		local list = data[key]
		if type(list) == "table" then
			for _, id in list do
				if type(id) == "string" then
					out[id] = true
				end
			end
		end
	end
	return out
end

local function evolveCheck(p: Player, data: any, g: any): (boolean, string?, { string }, number)
	return PvpRules.evolveCheck(g, function(id: string): number
		return TowerService.xpOf(p, id)
	end, data.InventoryGeodes, lockedPets(data))
end

local function petCard(p: Player, g: any, data: any?)
	local xp = TowerService.xpOf(p, g.Id)
	local v: any = TowerService.petView(g, xp)
	local cap = PetStats.cap(g)
	local level, into, need = PetStats.level(xp, cap)
	v.Cap = cap
	v.Power2 = PvpRules.power(g, xp) -- THE power number (PvpRules.petPower)
	v.Level = level
	v.XpInto = into
	v.XpNeed = need
	v.Name = PetRules.label(g)
	v.Evolve = PetStats.stage(g)
	if data and TowerConfig.Evolve.Enabled then
		local ok, why, _, free = evolveCheck(p, data, g)
		v.CanEvolve = ok
		v.EvolveWhy = why
		v.Copies = math.min(free + 1, TowerConfig.Evolve.Copies) -- this pet + the free copies, out of Copies
	end
	return v
end

local function inQueue(p: Player): number?
	for i, t in queue do
		if t.Player == p then
			return i
		end
	end
	return nil
end

-- Lobby name tag numbers (NameTag via PetFlair.battleLine): team power, trophies, win streak. Everyone sees them,
-- so a strong team is something to show off and to want.
local function publish(p: Player)
	local data = Profiles.get(p)
	if not data or not p.Parent then
		return
	end
	local s = stats(data)
	local power = PvpRules.teamPower(teamPets(p, 1))
	if p:GetAttribute("TeamPower") ~= power then
		p:SetAttribute("TeamPower", power)
	end
	if p:GetAttribute("Trophies") ~= s.Trophies then
		p:SetAttribute("Trophies", s.Trophies)
	end
	if p:GetAttribute("PvpStreak") ~= s.Streak then
		p:SetAttribute("PvpStreak", s.Streak)
	end
end

-- Battle / training card data: every pet with its power and level, the team, trophies and rank.
local function roster(p: Player)
	local data = Profiles.get(p)
	if not data then
		return
	end
	local pets = {}
	for _, g in data.InventoryGeodes do
		table.insert(pets, petCard(p, g, data))
	end
	local team = {}
	local teamPower = 0
	for _, tp in teamPets(p, 1) do
		table.insert(team, (tp.Pet :: any).Id)
		teamPower += PvpRules.power(tp.Pet, tp.Xp)
	end
	local s = stats(data)
	local rank, nxt = PvpRules.rank(s.Trophies)
	send(p, {
		Kind = "Roster",
		Pets = pets,
		Team = team,
		Power = teamPower,
		Trophies = s.Trophies,
		Streak = s.Streak,
		BestStreak = s.BestStreak,
		Wins = s.Wins,
		Losses = s.Losses,
		Rank = rank.Name,
		NextRank = if nxt then nxt.Name else nil,
		NextAt = if nxt then nxt.Min else nil,
		Queued = inQueue(p) ~= nil,
	})
end

local function unqueue(p: Player, why: string?)
	local i = inQueue(p)
	if i then
		table.remove(queue, i)
		send(p, { Kind = "Unqueued", Why = why })
	end
end

local function moveTo(p: Player, cf: CFrame)
	local char = p.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		char:PivotTo(cf)
	end
end

-- Units as one side's client sees them: its own pets carry its UserId, the foes Owner 0 (TowerView draws Owner 0
-- across the arena). Foe pets carry their look (Spec), so they are drawn as real pets, not mobs.
local function unitsFor(f: Fight, side: number, ownerId: number)
	local out = {}
	for _, u in f.Rules.Units do
		table.insert(out, {
			Id = u.Id,
			Owner = if u.Side == side then ownerId else 0,
			Kind = u.Kind,
			Name = u.Name,
			Max = u.Max,
			Hp = u.Hp,
			Element = u.Element,
			Boss = false,
			Foe = u.Side ~= side,
			Spec = f.Specs[u.Id],
			Info = f.Info[u.Id],
		})
	end
	return out
end

local function hpView(f: Fight)
	local hp = {}
	for _, u in f.Rules.Units do
		hp[u.Id] = { u.Hp, u.Shield }
	end
	return hp
end

local function each(f: Fight, fn: (side: number, p: Player) -> ())
	for side = 1, 2 do
		local p = f.Players[side]
		if p and not f.Left[side] and fightOf[p] == f then
			fn(side, p)
		end
	end
end

local function flush(f: Fight)
	if #f.Pending == 0 then
		return
	end
	local list = f.Pending
	f.Pending = {}
	local hp = hpView(f)
	each(f, function(side, p)
		send(p, { Kind = "Events", List = list, Hp = hp, Meter = f.Rules.Meters[side] / PvpConfig.SpecialCharge })
	end)
end

local function sideCard(f: Fight, side: number)
	local p = f.Players[side]
	local data = p and Profiles.get(p)
	local s = stats(data)
	local power = 0
	for _, u in f.Rules.Units do
		if u.Side == side then
			-- the same POWER the BATTLE card and matchmaking show (unit Max HP also carries speed growth, so rebuilding
			-- power from the unit overstated it)
			local info = f.Info[u.Id]
			power += if info and type(info.Power) == "number" then info.Power else 0
		end
	end
	return {
		Name = f.Names[side],
		Bot = p == nil,
		Trophies = if p then s.Trophies else nil,
		Rank = if p then PvpRules.rank(s.Trophies).Name else nil,
		Power = power,
	}
end

local function release(p: Player)
	fightOf[p] = nil
	p:SetAttribute("InBattle", nil)
	local back = returnCF[p]
	returnCF[p] = nil
	if back and p.Parent then
		moveTo(p, back)
	end
end

-- The lobby board's LIVE row: the newest fight going on (on its island), or how to join.
boardLive = function()
	local newest: Fight? = nil
	for _, f in fights do
		local n = tonumber(string.sub(f.Key, 4)) or 0
		if f.Phase ~= "Closed" and (newest == nil or n > (tonumber(string.sub((newest :: Fight).Key, 4)) or 0)) then
			newest = f
		end
	end
	if newest then
		FightBoard.live(sideCard(newest, 1), sideCard(newest, 2))
	else
		FightBoard.live(nil)
	end
end

-- Where the lobby's fight board floats: a part marked FightBoard = true placed in Studio (FightBoard looks for it),
-- or over an old lobby arena (ArenaCenter part outside the islands). No spot: no board.
boardSpot = function(): CFrame?
	local islands = Workspace:FindFirstChild("PetBattleIslands")
	for _, d in Workspace:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("ArenaCenter") == true and not (islands and d:IsDescendantOf(islands)) then
			return CFrame.new(d.Position + Vector3.new(0, d.Size.Y / 2, 0)) * d.CFrame.Rotation
		end
	end
	return nil
end

-- A fighter who falls or walks off their island is put back on their mark.
catchFalls = function()
	for p, f in fightOf do
		local char = p.Character
		local rootPart = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if rootPart and f.Phase ~= "Closed" and not IslandRules.onIsland(f.Origin, f.Radius, rootPart.Position) then
			local side = if f.Players[1] == p then 1 else 2
			moveTo(p, standAt(f.Views[side], f.Layout))
		end
	end
end

local function closeFight(f: Fight)
	if f.Phase == "Closed" then
		return
	end
	f.Phase = "Closed"
	fights[f.Key] = nil
	for side = 1, 2 do
		local p = f.Players[side]
		if p and fightOf[p] == f then
			release(p)
		end
	end
	SkyIsland.free(f.Slot, f.Arena)
	boardLive()
end

-- Pays one side and sends its result card. `result` = "Win" | "Loss" | "Draw".
local function pay(f: Fight, side: number, result: string)
	local p = f.Players[side]
	local data = p and Profiles.get(p)
	if not p or not data or Profiles.isReleased(p) or f.Left[side] then
		return -- a side that left mid-fight was paid its loss when it left
	end
	local s = stats(data)
	data.Pvp = s
	local vsBot = f.BotSide ~= nil
	local o = PvpRules.outcome(result, s.Trophies, s.Streak, vsBot)
	data.Cash = (tonumber(data.Cash) or 0) + o.Coins
	s.Trophies = math.max(s.Trophies + o.Trophies, 0)
	s.Streak = o.Streak
	s.BestStreak = math.max(s.BestStreak, s.Streak)
	if result == "Win" then
		s.Wins += 1
		-- every 3rd win banks a free egg; RobuxService hatches banked eggs as soon as the Pet Book has room
		local perks = EggPerks.sanitize(data.EggPerks)
		data.EggPerks = perks
		local egg = EggPerks.fightWin(perks)
		if egg then
			Net.event("Toast"):FireClient(p, EggPerks.Free.FightWinsPerEgg .. " wins! You earned a FREE " .. EggPerks.eggName(egg) .. "!", "rare")
		end
	elseif result == "Loss" then
		s.Losses += 1
	end
	local ups = {}
	for unitId, petId in f.PetIds do
		if string.sub(unitId, 1, 2) == side .. ":" then
			local before = TowerService.xpOf(p, petId)
			TowerService.addXp(p, petId, o.Xp)
			local got = TowerService.xpOf(p, petId) - before -- with the Pet Book page bonus (EggPerks.xpMult)
			local g = TowerService.petById(p, tostring(petId))
			local lb, la = PvpRules.train(before, got, if g then PetStats.cap(g) else nil)
			if g and la > lb then
				table.insert(ups, { Name = PetRules.label(g), Level = la, Power = PvpRules.power(g, before + got) })
			end
		end
	end
	Profiles.changed(p)
	publish(p)
	local rank, nxt = PvpRules.rank(s.Trophies)
	send(p, {
		Kind = "Result",
		Result = result,
		Coins = o.Coins,
		TrophyChange = o.Trophies,
		Trophies = s.Trophies,
		Streak = s.Streak,
		Xp = o.Xp,
		Rank = rank.Name,
		NextRank = if nxt then nxt.Name else nil,
		NextAt = if nxt then nxt.Min else nil,
		LevelUps = ups,
		Foe = f.Names[3 - side],
		Bot = vsBot,
	})
end

local function settle(f: Fight)
	local w = f.Rules.Winner
	local wp = if w ~= 0 then f.Players[w] else nil
	if wp and not f.Left[3 - w] then
		-- the arena board keeps the day's biggest win (the biggest upset) for everyone to see
		local a, b = sideCard(f, w), sideCard(f, 3 - w)
		if FightBoard.won(a.Name, b.Name .. (if b.Bot then " BOT" else ""), a.Power, b.Power) and FightBoard.shown() then
			send(wp, { Kind = "Notice", Text = "Your win is today's BIGGEST WIN on the arena board!" })
		end
	end
	for side = 1, 2 do
		local result = if w == 0 then "Draw" elseif w == side then "Win" else "Loss"
		-- a rival who quit before the fight really started is no win (stops a second account feeding wins, trophies
		-- and free-egg progress): the side that stayed gets the draw reward (PvpRules.forfeitResult)
		if result == "Win" and f.ForfeitAt then
			result = PvpRules.forfeitResult(f.ForfeitAt.Phase, f.ForfeitAt.Time)
		end
		pay(f, side, result)
	end
	closeFight(f)
end

local function over(f: Fight)
	flush(f)
	f.Phase = "Cheer"
	f.Timer = PvpConfig.ResultHold
	each(f, function(side, p)
		send(p, { Kind = "Over", Winner = f.Rules.Winner, MySide = side })
	end)
end

-- A side leaves mid-fight: it loses, the other side wins at once (its reward is paid as normal).
local function forfeit(p: Player)
	local f = fightOf[p]
	if not f then
		return
	end
	local side = if f.Players[1] == p then 1 else 2
	if f.Phase == "CountIn" or f.Phase == "Fighting" then
		f.ForfeitAt = { Phase = f.Phase :: string, Time = f.Rules.Time }
		f.Rules.State = "Done"
		f.Rules.Winner = 3 - side
		table.insert(f.Pending, { Kind = "KO", Side = 3 - side, Id = "Forfeit" })
		pay(f, side, "Loss")
		f.Left[side] = true
		release(p)
		over(f)
	else
		if f.Phase == "Cheer" and not f.Left[side] then
			-- the fight is decided; a side that leaves during the cheer still gets its result now (its save is next)
			local w = f.Rules.Winner
			pay(f, side, if w == 0 then "Draw" elseif w == side then "Win" else "Loss")
			f.Left[side] = true
		end
		release(p)
	end
	send(p, { Kind = "Closed" })
	-- Nobody left to see the result (a bot fight, or the other side already left): free the island now. over() above
	-- has set the Cheer phase, so this must not wait on it (the old check did, and the island idled for ResultHold).
	local other = f.Players[3 - side]
	if other == nil or f.Left[3 - side] or not other.Parent then
		closeFight(f)
	end
end

local function startFight(a: Player, b: Player?)
	local teamA = teamPets(a, 1)
	local teamB: { PvpRules.TeamPet } = if b then teamPets(b, 2) else {}
	local botName: string? = nil
	if not b then
		teamB = PvpRules.botTeam(teamA, math.random)
		for i, tp in teamB do
			tp.Id = "2:" .. i
		end
		botName = PvpConfig.BotNames[math.random(1, #PvpConfig.BotNames)]
	end
	if #teamA == 0 or #teamB == 0 then
		send(a, { Kind = "Notice", Text = "Hatch a pet first! Pets fight in battles." })
		if b then
			send(b, { Kind = "Notice", Text = "Your rival left. Tap FIGHT to find a new one." })
		end
		return
	end
	-- this fight's own floating island
	local island = SkyIsland.claim()
	local slot, arena, origin, layout = island.Slot, island.Model, island.Origin, island.Layout
	serial += 1
	local specs, petIds, info = {}, {}, {}
	for side, team in { teamA, teamB } do
		for _, tp in team do
			local g: any = tp.Pet
			local cap = PetStats.cap(g)
			info[tp.Id] = { Rarity = g.Rarity, Modifier = g.Modifier, Level = (PetStats.level(tp.Xp, cap)), Cap = cap, Power = PvpRules.power(g, tp.Xp) }
			specs[tp.Id] = { Mineral = g.Mineral, Rarity = g.Rarity, Modifier = g.Modifier, Formation = g.Formation, Mass = g.Mass, Seed = g.Seed, Evolve = g.Evolve }
			if side == 1 or b then
				petIds[tp.Id] = g.Id
			end
		end
	end
	local f: Fight = {
		Key = "pvp" .. serial,
		Slot = slot,
		Arena = arena :: any,
		Origin = origin,
		Radius = island.Radius,
		Layout = layout,
		Views = { origin, origin * mirror(layout) },
		Players = { [1] = a, [2] = b },
		Names = { a.DisplayName, if b then b.DisplayName else (botName or "Rival") },
		BotSide = if b then nil else 2,
		Rules = PvpRules.newFight(teamA, teamB),
		Specs = specs,
		Info = info,
		PetIds = petIds,
		Phase = "CountIn",
		Timer = PvpConfig.CountIn,
		Pending = {},
		SendIn = 0,
		BotReadyAt = nil,
		BotTaps = 0,
		Left = {},
	}
	fights[f.Key] = f
	boardLive()
	for side = 1, 2 do
		local p = f.Players[side]
		if p then
			fightOf[p] = f
			p:SetAttribute("InBattle", true)
			local char = p.Character
			if char then
				returnCF[p] = char:GetPivot()
			end
			moveTo(p, standAt(f.Views[side], f.Layout))
		end
	end
	each(f, function(side, p)
		send(p, {
			Kind = "Start",
			Units = unitsFor(f, side, p.UserId),
			Origin = f.Views[side],
			Layout = f.Layout,
			Island = true,
			MySide = side,
			Me = sideCard(f, side),
			Foe = sideCard(f, 3 - side),
			CountIn = PvpConfig.CountIn,
			HasSpecial = PvpRules.hasSpecial(f.Rules, side),
			FightTime = PvpConfig.FightTime,
		})
	end)
end

local function canQueue(p: Player): (boolean, string?)
	if not Profiles.isLoaded(p) then
		return false, nil
	end
	if fightOf[p] or p:GetAttribute("MatchKey") ~= nil or TowerService.inTower(p) then
		return false, "Finish what you are doing first!"
	end
	if #teamPets(p, 1) == 0 then
		return false, "Hatch a pet first! Pets fight in battles."
	end
	return true, nil
end

local function enqueue(p: Player)
	if inQueue(p) then
		return
	end
	local ok, why = canQueue(p)
	if not ok then
		if why then
			send(p, { Kind = "Notice", Text = why })
		end
		return
	end
	local team = teamPets(p, 1)
	table.insert(queue, { Player = p, Since = os.clock(), Power = PvpRules.teamPower(team) })
	send(p, { Kind = "Queued", Power = PvpRules.teamPower(team), BotAfter = PvpConfig.BotAfter })
end

-- Pairs waiting players by power; anyone waiting BotAfter seconds gets a bot.
local function matchmake()
	local now = os.clock()
	local i = 1
	while i <= #queue do
		local t = queue[i]
		local paired = false
		if not t.Player.Parent then
			table.remove(queue, i)
			continue
		end
		if not (canQueue(t.Player)) then
			-- never a silent drop: the search strip would keep counting (audit F24)
			table.remove(queue, i)
			send(t.Player, { Kind = "Unqueued", Why = if #teamPets(t.Player, 1) == 0 then "NoTeam" else "Busy" })
			continue
		end
		for j = i + 1, #queue do
			local o = queue[j]
			if o.Player.Parent and canQueue(o.Player) and PvpRules.canMatch(t.Power, now - t.Since, o.Power, now - o.Since) then
				table.remove(queue, j)
				table.remove(queue, i)
				startFight(t.Player, o.Player)
				paired = true
				break
			end
		end
		if not paired then
			if now - t.Since >= PvpConfig.BotAfter then
				table.remove(queue, i)
				startFight(t.Player, nil)
			else
				i += 1
			end
		end
	end
end

local function train(p: Player, petId: any)
	if type(petId) ~= "string" or #petId > 64 then
		return
	end
	-- token bucket: TapsPerSecond taps a second, short bursts allowed up to the same number
	local rate = PvpConfig.Train.TapsPerSecond
	local now = os.clock()
	local b: { Tokens: number, At: number } = taps[p] or { Tokens = rate, At = now }
	taps[p] = b
	b.Tokens = math.min(rate, b.Tokens + (now - b.At) * rate)
	b.At = now
	if b.Tokens < 1 then
		return
	end
	b.Tokens -= 1
	local g = TowerService.petById(p, petId)
	if not g or fightOf[p] then
		return
	end
	local before = TowerService.xpOf(p, g.Id)
	local cap = PetStats.cap(g)
	if PvpRules.maxed(g, before) then
		-- rarity cap reached (carter 2026-10-14): no more training; rarer pets grow higher
		send(p, { Kind = "Trained", Pet = g.Id, Gain = 0, Level = cap, XpInto = 0, XpNeed = 0, Power = PvpRules.power(g, before), Maxed = true })
		return
	end
	TowerService.addXp(p, g.Id, PvpConfig.Train.TapXp)
	local gain = TowerService.xpOf(p, g.Id) - before -- with the Pet Book page bonus (EggPerks.xpMult)
	local lb, la, xp = PvpRules.train(before, gain, cap)
	-- the profile (Pet Book levels) syncs at most every 2 s while tapping; the save picks it up as usual
	if now - (syncAt[p] or -math.huge) >= 2 or la > lb then
		syncAt[p] = now
		Profiles.changed(p)
	end
	if la > lb then
		publish(p)
	end
	local level, into, need = PetStats.level(xp, cap)
	send(p, {
		Kind = "Trained",
		Pet = g.Id,
		Gain = gain,
		Level = level,
		XpInto = into,
		XpNeed = need,
		Power = PvpRules.power(g, xp),
		LevelUp = la > lb,
		Maxed = level >= cap,
		PowerBefore = if la > lb then PvpRules.power(g, before) else nil,
	})
end

-- EVOLVE: a pet at its cap uses up Copies - 1 free copies of itself (same species, rarity and stage) and steps up
-- one stage: higher cap, stronger stats, bigger glowing look. The used copies and their XP are gone for good.
local function evolve(p: Player, petId: string)
	local data = Profiles.get(p)
	if not data or Profiles.isReleased(p) or p:GetAttribute("MatchKey") ~= nil or TowerService.inTower(p) then
		return
	end
	local _, g = Profiles.findGeode(data, petId)
	if not g then
		return
	end
	local ok, why, use = evolveCheck(p, data, g)
	if not ok then
		send(p, { Kind = "Evolved", Ok = false, Pet = petId, Why = why })
		return
	end
	local powerBefore = PvpRules.power(g, TowerService.xpOf(p, g.Id))
	local gone: { [string]: boolean } = {}
	for _, id in use do
		gone[id] = true
	end
	for i = #data.InventoryGeodes, 1, -1 do
		local c = data.InventoryGeodes[i]
		if type(c) == "table" and gone[c.Id] then
			table.remove(data.InventoryGeodes, i)
			if type(data.TowerXP) == "table" then
				data.TowerXP[c.Id] = nil
			end
		end
	end
	g.Evolve = PetStats.stage(g) + 1
	Profiles.changed(p) -- full: the inventory changed (followers, Pet Book and plot refresh from it)
	send(p, {
		Kind = "Evolved",
		Ok = true,
		Pet = g.Id,
		Stage = g.Evolve,
		Cap = PetStats.cap(g),
		PowerBefore = powerBefore,
		Power = PvpRules.power(g, TowerService.xpOf(p, g.Id)),
		Used = #use,
	})
	roster(p)
	publish(p)
	pcall(Gallery.render, p) -- a displayed pet shows its new look on the plot
end

-- Hunt XP (RockService.onCracked): every egg a player finishes gives each following pet a little XP.
local function huntXp(p: Player, found: boolean)
	local data = Profiles.get(p)
	if not data or type(data.EquippedPets) ~= "table" then
		return
	end
	local gain = if found then PvpConfig.Hunt.FoundXp else PvpConfig.Hunt.CrackXp
	for _, id in data.EquippedPets do
		TowerService.addXp(p, id, gain)
	end
end

-- Pet XP from the hunt fun prizes (surprise eggs, places; shared/HuntFun): `amount` to each following pet.
local function petXp(p: Player, amount: number)
	local data = Profiles.get(p)
	if not data or type(data.EquippedPets) ~= "table" or amount <= 0 then
		return
	end
	for _, id in data.EquippedPets do
		TowerService.addXp(p, id, amount)
	end
end

-- Tap-to-inspect another player's pet (client PetInspectTap): only pets that player has following them, so nothing
-- private is read. The card shows the pet with its battle power and level, and the owner's trophies.
local function inspectPet(p: Player, userId: any, petId: any)
	if type(userId) ~= "number" or type(petId) ~= "string" or #petId > 64 then
		return
	end
	local owner = Players:GetPlayerByUserId(userId)
	local data = owner and Profiles.get(owner)
	if not owner or not data or type(data.EquippedPets) ~= "table" or not table.find(data.EquippedPets, petId) then
		return
	end
	local _, g = Profiles.findGeode(data, petId)
	if not g then
		return
	end
	local xp = TowerService.xpOf(owner, g.Id)
	local cap = PetStats.cap(g)
	local s = stats(data)
	Net.event("Inspect"):FireClient(p, {
		Owner = owner.DisplayName,
		IsYou = owner == p,
		Specimen = GeodeGen.public(g),
		Power = PvpRules.power(g, xp),
		Level = (PetStats.level(xp, cap)),
		Cap = cap,
		Evolve = PetStats.stage(g),
		Where = string.format("%s's pet  \u{1F3C6} %s", owner.DisplayName, tostring(s.Trophies)),
	})
end

local function onAction(p: Player, msg: any)
	if type(msg) ~= "table" or type(msg.Op) ~= "string" then
		return
	end
	local op = msg.Op
	local f = fightOf[p]
	if op == "Train" then
		train(p, msg.Pet)
	elseif op == "Tap" or op == "Block" then
		-- tap to fight: at most Tap.PerSecond taps count (a few ms of slack for network jitter); BLOCK as SPECIAL
		local gap = if op == "Tap" then 1 / PvpConfig.Tap.PerSecond - 0.02 else PvpConfig.ActionGap
		if f and f.Phase == "Fighting" and allow(p, op, gap) then
			local side = if f.Players[1] == p then 1 else 2
			local _ok: boolean, ev: { PvpRules.Event }
			if op == "Tap" then
				_ok, ev = PvpRules.tap(f.Rules, side)
			else
				_ok, ev = PvpRules.block(f.Rules, side)
			end
			for _, e in ev do
				table.insert(f.Pending, e)
			end
			if op == "Block" then
				flush(f) -- the ring answer goes out at once
			end
			if f.Rules.State == "Done" then
				flush(f)
				over(f)
			end
		end
	elseif op == "Special" then
		if f and f.Phase == "Fighting" and allow(p, "Special", PvpConfig.ActionGap) then
			local side = if f.Players[1] == p then 1 else 2
			local ok, ev = PvpRules.useSpecial(f.Rules, side, math.random())
			if ok then
				for _, e in ev do
					table.insert(f.Pending, e)
				end
				flush(f)
				if f.Rules.State == "Done" then
					over(f)
				end
			end
		end
	elseif op == "Open" then
		if allow(p, "Open", 1) then
			roster(p)
		end
	elseif op == "Queue" then
		if allow(p, "Queue", PvpConfig.QueueGap) then
			enqueue(p)
		end
	elseif op == "Cancel" then
		if allow(p, "Cancel", 0.3) then
			unqueue(p, "Cancel")
		end
	elseif op == "Leave" then
		if f and allow(p, "Leave", PvpConfig.QueueGap) then
			forfeit(p)
		end
	elseif op == "SetTeam" then
		if f or inQueue(p) or type(msg.Pets) ~= "table" or #msg.Pets > PvpConfig.TeamSize * 2 or not allow(p, "Team", PvpConfig.ActionGap) then
			return
		end
		local ids, seen = {}, {}
		for i = 1, #msg.Pets do
			local id = msg.Pets[i]
			if #ids >= PvpConfig.TeamSize then
				break
			end
			if type(id) == "string" and not seen[id] and TowerService.petById(p, id) then
				seen[id] = true
				table.insert(ids, id)
			end
		end
		TowerService.setTeam(p, if #ids > 0 then ids else nil)
		roster(p)
		publish(p)
	elseif op == "Inspect" then
		if allow(p, "Inspect", 0.5) then
			inspectPet(p, msg.UserId, msg.Pet)
		end
	elseif op == "Evolve" then
		if TowerConfig.Evolve.Enabled and not f and not inQueue(p) and type(msg.Pet) == "string" and #msg.Pet <= 64 and allow(p, "Evolve", 1) then
			evolve(p, msg.Pet)
		end
	elseif op == "EquipBest" then
		if not f and not inQueue(p) and allow(p, "Team", PvpConfig.ActionGap) then
			TowerService.setTeam(p, nil)
			roster(p)
			publish(p)
		end
	end
end

-- Idle training: pets following the player gain a little XP every IdleEvery seconds.
local function idleTrain()
	for _, p in Players:GetPlayers() do
		local data = Profiles.get(p)
		if data and not Profiles.isReleased(p) and type(data.EquippedPets) == "table" and #data.EquippedPets > 0 then
			local gain = PvpConfig.Train.IdleXp
			for _, id in data.EquippedPets do
				TowerService.addXp(p, id, gain)
			end
			Profiles.changed(p, true)
		end
	end
end

function PvpService.start()
	local folder = Instance.new("Folder")
	folder.Name = "PvpNet"
	local action = Instance.new("RemoteEvent")
	action.Name = "PvpAction"
	action.Parent = folder
	event = Instance.new("RemoteEvent")
	event.Name = "PvpEvent"
	event.Parent = folder
	folder.Parent = ReplicatedStorage
	action.OnServerEvent:Connect(onAction)
	-- the arena board (built once the lobby arena exists; the map may load a little after the server starts)
	FightBoard.ensure(boardSpot())
	task.delay(10, function()
		FightBoard.ensure(boardSpot())
	end)
	RockService.onCracked = huntXp
	RockService.onPetXp = petXp

	-- Lobby pads (parts with attribute PvpPad / TrainPad, placed in Studio): stepping on one opens its card.
	local touchedAt: { [Player]: number } = {}
	local function hookPad(d: Instance)
		if not d:IsA("BasePart") or d:GetAttribute("PvpHooked") then
			return
		end
		local kind = if d:GetAttribute("PvpPad") == true then "Battle" elseif d:GetAttribute("TrainPad") == true then "Train" else nil
		if not kind then
			return
		end
		d:SetAttribute("PvpHooked", true)
		d.Touched:Connect(function(hit)
			local char = hit.Parent
			local p = char and Players:GetPlayerFromCharacter(char)
			if not p or fightOf[p] or p:GetAttribute("MatchKey") ~= nil then
				return
			end
			local now = os.clock()
			if now - (touchedAt[p] or 0) < 4 then
				return
			end
			touchedAt[p] = now
			send(p, { Kind = "OpenCard", Card = kind })
			roster(p)
		end)
	end
	for _, d in Workspace:GetDescendants() do
		hookPad(d)
	end
	Workspace.DescendantAdded:Connect(hookPad)
	task.delay(10, function()
		for _, d in Workspace:GetDescendants() do
			hookPad(d)
		end
	end)

	local function watch(p: Player)
		p:GetAttributeChangedSignal("MatchKey"):Connect(function()
			if p:GetAttribute("MatchKey") ~= nil then
				unqueue(p, "Hunt")
				forfeit(p)
			end
		end)
		p.CharacterAdded:Connect(function()
			local f = fightOf[p]
			if f then
				task.defer(function()
					local side = if f.Players[1] == p then 1 else 2
					if fightOf[p] == f then
						moveTo(p, standAt(f.Views[side], f.Layout))
					end
				end)
			end
		end)

	end
	Players.PlayerAdded:Connect(watch)
	for _, p in Players:GetPlayers() do
		watch(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		unqueue(p)
		forfeit(p)
		lastOp[p] = nil
		taps[p] = nil
		syncAt[p] = nil
		touchedAt[p] = nil
		returnCF[p] = nil
	end)

	local acc, matchAcc, idleAcc, tagAcc = 0, 0, 0, 14
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		matchAcc += dt
		idleAcc += dt
		if matchAcc >= 0.5 then
			matchAcc = 0
			matchmake()
			catchFalls()
		end
		tagAcc += dt
		if tagAcc >= 15 then -- name tag numbers follow new pets, sales and levels
			tagAcc = 0
			for _, p in Players:GetPlayers() do
				publish(p)
			end
		end
		if idleAcc >= PvpConfig.Train.IdleEvery then
			idleAcc = 0
			idleTrain()
		end
		if acc < TowerConfig.Tick then
			return
		end
		local step = math.min(acc, 0.5)
		acc = 0
		for _, f in fights do
			if f.Phase == "CountIn" then
				f.Timer -= step
				if f.Timer <= 0 then
					f.Phase = "Fighting"
				end
			elseif f.Phase == "Fighting" then
				local bot = f.BotSide
				for _, e in PvpRules.step(f.Rules, step, math.random) do
					table.insert(f.Pending, e)
					-- the bot catches some rings (PvpConfig.Block.BotBlock)
					if bot and e.Kind == "Warn" and e.Side == bot and math.random() < PvpConfig.Block.BotBlock then
						PvpRules.block(f.Rules, bot)
					end
				end
				if bot and f.Rules.State == "Fighting" then
					f.BotTaps += step * PvpConfig.Tap.BotTaps
					while f.BotTaps >= 1 and f.Rules.State == "Fighting" do
						f.BotTaps -= 1
						local _, ev = PvpRules.tap(f.Rules, bot)
						for _, e in ev do
							table.insert(f.Pending, e)
						end
					end
				end
				if bot and f.Rules.State == "Fighting" and PvpRules.meterFull(f.Rules, bot) then
					f.BotReadyAt = f.BotReadyAt or (os.clock() + PvpConfig.BotSpecialDelay)
					if os.clock() >= (f.BotReadyAt :: number) then
						f.BotReadyAt = nil
						local _, ev = PvpRules.useSpecial(f.Rules, bot, math.random())
						for _, e in ev do
							table.insert(f.Pending, e)
						end
					end
				end
				f.SendIn -= step
				if #f.Pending > 0 and (f.SendIn <= 0 or f.Rules.State ~= "Fighting") then
					flush(f)
					f.SendIn = SEND_EVERY
				end
				if f.Rules.State ~= "Fighting" then
					over(f)
				end
			elseif f.Phase == "Cheer" then
				f.Timer -= step
				if f.Timer <= 0 then
					settle(f)
				end
			end
		end
	end)
end

-- Offline tests: the intent handler (as if PvpAction fired) and the live fight table.
PvpService.action = onAction
function PvpService.fightOf(p: Player): any
	return fightOf[p]
end

return PvpService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="254">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[--!strict
-- Daily login gift and daily quests (rules: shared/Quests.luau, tuning: shared/ProgressConfig.luau).
-- The server tracks everything: progress comes from what the server itself recorded (profile stats and the shell
-- sale), never from the client. Clients only send claims through ShopAction ("ClaimGift" / "ClaimQuest", index),
-- which EconomyService forwards here after its own rate limit. Coins only, never Robux.
--
-- Progress sources:
--   Crack  - Stats.RocksCracked goes up (RockService counts every egg a player finished)
--   Hunt   - Stats.MatchesPlayed goes up (MatchService counts every finished non-practice hunt)
--   Friend - the same, while a Roblox friend (Player:IsFriendsWith) is in the same hunt (same MatchKey attribute)
--   Hatch  - hatched pets (SoloFinds + MultiplayerWins) go up; the free starter pet does not count
--   Sell   - QuestService.note(player, "Sell") from EconomyService after a real shell sale
--   Display - QuestService.note(player, "Display") from EconomyService when a pet is put on display
--   TowerFloors - the profile counter TowerFloorsToday goes up. The tower calls QuestService.bump(player,
--            "TowerFloors", n) for each floor cleared (or adds to data.TowerFloorsToday itself and calls
--            Profiles.changed); either way each floor counts once. The counter resets every UTC day.
-- Every day has one race, one tower and one pet quest (shared/Quests.forDay).

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Retention = require(Shared.Retention)
local Quests = require(Shared.Quests)
local EggPerks = require(Shared.EggPerks)
local LaunchPerks = require(Shared.LaunchPerks)
local Profiles = require(script.Parent.Profiles)

local QuestService = {}

type Seen = { Cracked: number, Played: number, Finds: number, Tower: number }
local seen: { [Player]: Seen } = {}

local function today(): number
	return Quests.day(os.time())
end

local function toast(player: Player, text: string, kind: string?)
	Net.event("Toast"):FireClient(player, text, kind or "info")
end

local function towerToday(data): number
	local n = data.TowerFloorsToday
	return if type(n) == "number" and n == n and n >= 0 then math.floor(n) else 0
end

local function snapshot(data): Seen
	return { Cracked = data.Stats.RocksCracked, Played = data.Stats.MatchesPlayed, Finds = Profiles.finds(data), Tower = towerToday(data) }
end

-- Moves the player's quest state to `day`. A new day clears today's progress and the tower floor counter.
-- Returns true when it changed anything.
local function rollDay(player: Player, data, day: number): boolean
	if not Quests.rollover(data.Daily, day) then
		return false
	end
	data.TowerFloorsToday = 0
	local s = seen[player]
	if s then
		s.Tower = 0
	end
	return true
end

-- Counts `n` toward today's quests of `kind` for this player (server-side callers only).
function QuestService.note(player: Player, kind: string, n: number?)
	local data = Profiles.get(player)
	if not data or Profiles.isReleased(player) then
		return
	end
	local rolled = rollDay(player, data, today())
	if Quests.bump(data.Daily, player.UserId, today(), kind, n or 1) or rolled then
		Profiles.changed(player, true)
	end
end

-- Hook for other services (the pet tower): bump(player, "TowerFloors", floorsCleared) adds to TowerFloorsToday,
-- and the change counts toward today's tower quest. Any other kind is the same as note().
function QuestService.bump(player: Player, kind: string, n: number?)
	if kind ~= "TowerFloors" then
		QuestService.note(player, kind, n)
		return
	end
	local data = Profiles.get(player)
	local add = if type(n) == "number" and n == n then math.floor(n) else 1
	if not data or Profiles.isReleased(player) or add <= 0 then
		return
	end
	rollDay(player, data, today())
	data.TowerFloorsToday = towerToday(data) + add
	Profiles.changed(player, true) -- onChanged turns the counter change into quest progress
end

-- Roblox friendship answers (Player:IsFriendsWith yields and can fail), cached per pair while both are in this
-- server; a failed call counts as "not friends" and is asked again next time.
local friendCache: { [string]: boolean } = {}
local function pairKey(a: number, b: number): string
	return math.min(a, b) .. ":" .. math.max(a, b)
end
local function areFriends(a: Player, b: Player): boolean
	local k = pairKey(a.UserId, b.UserId)
	local cached = friendCache[k]
	if cached ~= nil then
		return cached
	end
	local ok, res = pcall(function()
		return a:IsFriendsWith(b.UserId)
	end)
	if ok then
		friendCache[k] = res == true
	end
	return ok and res == true
end

-- Other players in the same hunt right now (the MatchKey attribute is cleared when a player leaves a hunt).
-- Read without yielding, at the moment the hunt is counted.
local function huntMates(player: Player): { Player }
	local out = {}
	local key = player:GetAttribute("MatchKey")
	if key == nil then
		return out
	end
	for _, p in Players:GetPlayers() do
		if p ~= player and p:GetAttribute("MatchKey") == key then
			table.insert(out, p)
		end
	end
	return out
end

-- "Play N hunts with a friend": counts only when a Roblox friend of the player was in the same hunt (strangers from
-- the public queue do not count). The friendship check may yield, so it runs on its own after the hunt was counted.
local function bumpIfFriend(player: Player, mates: { Player }, day: number, n: number)
	if #mates == 0 then
		return
	end
	task.spawn(function()
		for _, mate in mates do
			if areFriends(player, mate) then
				local data = Profiles.get(player)
				if data and not Profiles.isReleased(player) and Quests.bump(data.Daily, player.UserId, day, "Friend", n) then
					Profiles.changed(player, true)
				end
				return
			end
		end
	end)
end

local function onChanged(player: Player)
	local data = Profiles.get(player)
	if not data or not seen[player] then
		return
	end
	local day = today()
	local changed = rollDay(player, data, day)
	local last = seen[player]
	local now = snapshot(data)
	seen[player] = now
	if now.Cracked > last.Cracked then
		changed = Quests.bump(data.Daily, player.UserId, day, "Crack", now.Cracked - last.Cracked) or changed
	end
	if now.Played > last.Played then
		local n = now.Played - last.Played
		changed = Quests.bump(data.Daily, player.UserId, day, "Hunt", n) or changed
		bumpIfFriend(player, huntMates(player), day, n)
	end
	if now.Finds > last.Finds then
		changed = Quests.bump(data.Daily, player.UserId, day, "Hatch", now.Finds - last.Finds) or changed
	end
	if now.Tower > last.Tower then
		changed = Quests.bump(data.Daily, player.UserId, day, "TowerFloors", now.Tower - last.Tower) or changed
	end
	if changed and not Profiles.isReleased(player) then
		Profiles.changed(player, true)
	end
end

local function pay(player: Player, data: { [string]: any }, coins: number)
	data.Cash += coins
	data.Stats.CashEarned += coins
	Profiles.changed(player, true)
end

-- ShopAction claims (forwarded by EconomyService). Returns true when the action was a quest action.
function QuestService.handle(player: Player, action: string, id: any): boolean
	if action ~= "ClaimGift" and action ~= "ClaimQuest" then
		return false
	end
	local data = Profiles.get(player)
	if not data then
		return true
	end
	local day = today()
	rollDay(player, data, day)
	if action == "ClaimGift" then
		local coins, streakDay, why, shieldUsed = Quests.claimGift(data.Daily, day)
		if coins then
			pay(player, data, coins)
			local streak = data.Daily.Streak
			toast(player, streak .. " day streak! Daily gift: +" .. coins .. " coins!", "cash")
			-- day 7 of the streak also banks a free egg (LaunchPerks.StreakEgg; RobuxService hatches it for free)
			local egg = LaunchPerks.streakEgg(streakDay or 0)
			if egg then
				local perks = EggPerks.sanitize(data.EggPerks)
				data.EggPerks = perks
				if EggPerks.bankAdd(perks, egg) then
					toast(player, "DAY 7! You earned a FREE " .. EggPerks.eggName(egg) .. "!", "rare")
					Profiles.changed(player, true)
				end
			end
			if shieldUsed then
				toast(player, "Your streak shield saved your streak!", "rare")
			elseif streak % Retention.Streak.ShieldEvery == 0 and (data.Daily.Shields or 0) > 0 then
				toast(player, "You earned a streak shield! It saves your streak if you miss a day.", "rare")
			end
		elseif why == "Claimed" then
			toast(player, "You already opened today's gift. Come back tomorrow!", "info")
		end
	else
		local coins, why = Quests.claim(data.Daily, player.UserId, day, id)
		if coins then
			pay(player, data, coins)
			toast(player, "Quest done: +" .. coins .. " coins!", "cash")
			-- all of today's quests claimed: a free egg once a day (banked; RobuxService hatches it)
			local allClaimed = true
			for _, q in Quests.view(data.Daily, player.UserId, day).Quests do
				allClaimed = allClaimed and q.Claimed
			end
			if allClaimed then
				local perks = EggPerks.sanitize(data.EggPerks)
				data.EggPerks = perks
				local egg = EggPerks.questsDone(perks, day)
				if egg then
					toast(player, "Every quest done! You earned a FREE " .. EggPerks.eggName(egg) .. "!", "rare")
					Profiles.changed(player, true)
				end
			end
		elseif why == "NotDone" then
			toast(player, "That quest is not finished yet.", "info")
		elseif why == "Claimed" then
			Profiles.changed(player, true) -- the screen was stale: send the real state
		end
	end
	return true
end

function QuestService.start()
	Profiles.onLoaded(function(player, data)
		seen[player] = snapshot(data)
		if rollDay(player, data, today()) then
			Profiles.changed(player, true)
		end
	end)
	Profiles.onChanged(onChanged)
	Players.PlayerRemoving:Connect(function(p)
		seen[p] = nil
		local prefix, suffix = p.UserId .. ":", ":" .. p.UserId
		for k in friendCache do
			if string.sub(k, 1, #prefix) == prefix or string.sub(k, -#suffix) == suffix then
				friendCache[k] = nil
			end
		end
	end)
	-- UTC midnight: move everyone to the new day so the quest screen and the HUD dot refresh on their own.
	task.spawn(function()
		local lastDay = today()
		while true do
			task.wait(30)
			local d = today()
			if d ~= lastDay then
				lastDay = d
				for _, p in Players:GetPlayers() do
					local data = Profiles.get(p)
					if data and not Profiles.isReleased(p) and rollDay(p, data, d) then
						Profiles.changed(p, true)
					end
				end
			end
		end
	end)
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="255">
        <Properties>
          <string name="Name">RacerCollision</string>
          <string name="Source"><![CDATA[--!strict
-- Racers never bump (owner pick): characters in a hunt use the collision group "Racers", which does not collide
-- with itself, so hunters pass through each other but still stand on the floor, the pile and the nests.
-- MatchService turns it on when it places a character at a hunt spawn and off when it sends them to the lobby.
-- Every PhysicsService call is wrapped in pcall: a failure only means players bump as before.

local GROUP = "Racers"
local DEFAULT = "Default"

local RacerCollision = {}

local ready = false
local watched: { [Model]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function setup()
	if ready then
		return true
	end
	local ok = pcall(function()
		local PhysicsService = game:GetService("PhysicsService")
		if not PhysicsService:IsCollisionGroupRegistered(GROUP) then
			PhysicsService:RegisterCollisionGroup(GROUP)
		end
		PhysicsService:CollisionGroupSetCollidable(GROUP, GROUP, false)
	end)
	ready = ok
	return ok
end

local function groupFor(char: Model): string
	return if char:GetAttribute("Racer") == true then GROUP else DEFAULT
end

local function setPart(part: Instance, group: string)
	if part:IsA("BasePart") then
		pcall(function()
			part.CollisionGroup = group
		end)
	end
end

-- Puts every part of `char` (and parts added later: accessories, held tools) in the racer group or back.
function RacerCollision.apply(char: Model?, on: boolean)
	if not char or not setup() then
		return
	end
	char:SetAttribute("Racer", on)
	local group = groupFor(char)
	for _, d in char:GetDescendants() do
		setPart(d, group)
	end
	if not watched[char] then
		watched[char] = true
		char.DescendantAdded:Connect(function(d)
			setPart(d, groupFor(char))
		end)
	end
end

function RacerCollision.start()
	setup()
end

return RacerCollision
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="256">
        <Properties>
          <string name="Name">RareHatch</string>
          <string name="Source"><![CDATA[--!strict
-- Rare hatch announcements (owner pick). A Rare, Epic or Legendary hatch (Config.Pets.AnnounceRarities) is shown:
--   * in this server: fireworks and a gold banner for every player (RareHatch remote, kind "Local");
--   * in every other server: the same gold banner, no fireworks (MessagingService topic Config.RareHatch.Topic,
--     kind "Global").
-- The message carries only the player's display name, the pet's display name and the rarity (PetFlair.payload),
-- never a user id, egg id or anything about a running round. Publishing is rate limited per server and per player
-- (PetFlair.allow); messages from other servers are checked again and limited to one banner per ReceiveGap.
-- Every MessagingService call is wrapped in pcall: if it fails (Studio without API access, an outage) the local
-- banner still plays and the error is only warned.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local GeodeGen = require(Shared.GeodeGen)
local PetFlair = require(Shared.PetFlair)

local RareHatch = {}

local cfg = Config.RareHatch
local messaging: any = nil
do
	local ok, svc = pcall(function()
		return game:GetService("MessagingService")
	end)
	if ok then
		messaging = svc
	end
end

local publishLimit = PetFlair.newLimiter(cfg.PublishGap, cfg.PlayerGap)
local receiveLimit = PetFlair.newLimiter(cfg.ReceiveGap)
local sent: { [string]: number } = {} -- echo key -> os.clock() of our own publish

local function fire(kind: string, p: PetFlair.Payload)
	Net.event("RareHatch"):FireAllClients(kind, p)
end

-- Called by MatchService once the finder's own reveal has played. The server decided the hatch; nothing here comes
-- from a client.
function RareHatch.announce(player: Player, specimen: { [string]: any })
	if type(specimen) ~= "table" or not (PetFlair.shouldAnnounce(specimen.Rarity) or specimen.Shiny == true) then
		return
	end
	local p = PetFlair.payload(player.DisplayName, GeodeGen.displayName(specimen :: any), specimen.Rarity)
	if not p then
		return
	end
	fire("Local", p)
	if not messaging then
		return
	end
	local now = os.clock()
	if not PetFlair.allow(publishLimit, tostring(player.UserId), now) then
		return -- this server just announced: the other servers skip this one (the local banner still played)
	end
	for k, t in sent do
		if now - t > cfg.EchoSeconds then
			sent[k] = nil
		end
	end
	sent[PetFlair.echoKey(p)] = now
	task.spawn(function()
		local ok, err = pcall(function()
			messaging:PublishAsync(cfg.Topic, { Name = p.Name, Pet = p.Pet, Rarity = p.Rarity })
		end)
		if not ok then
			warn("[RareHatch] publish failed:", err)
		end
	end)
end

local function onMessage(message: any)
	local data = if type(message) == "table" then message.Data else nil
	if type(data) ~= "table" then
		return
	end
	local p = PetFlair.payload(data.Name, data.Pet, data.Rarity)
	if not p then
		return
	end
	local now = os.clock()
	local key = PetFlair.echoKey(p)
	local mine = sent[key]
	if mine and now - mine <= cfg.EchoSeconds then
		sent[key] = nil -- our own message coming back: the local banner already played here
		return
	end
	if not PetFlair.allow(receiveLimit, "all", now) then
		return
	end
	fire("Global", p)
end

local started = false
function RareHatch.start()
	if started then
		return
	end
	started = true
	if not messaging then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			messaging:SubscribeAsync(cfg.Topic, onMessage)
		end)
		if not ok then
			warn("[RareHatch] subscribe failed (other servers will not show rare hatches here):", err)
		end
	end)
end

return RareHatch
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="257">
        <Properties>
          <string name="Name">RetentionService</string>
          <string name="Source"><![CDATA[--!strict
-- First five minutes and comeback hooks (rules and tuning: shared/Retention, streak extras: shared/Quests).
-- The server decides every reward; clients send intents only on RetentionAction:
--   "Ready"    the client UI is up: any waiting notice (away nest, friend gift) is sent now
--   "Starter"  hatch the free starter egg (lobby only, once per player; PetService.ensureStarter rolls Rare or better)
--   "Gift"     open the next play-time gift once its time is reached
-- Notices go back on the "Retention" event as (kind, payload):
--   ("Starter", { Pet })                    the starter pet that just hatched (public specimen) for the hatch show
--   ("Gift", { Coins, Index })              a play-time gift was opened
--   ("GiftReady", { Index })                a play-time gift is ready to open
--   ("Away", { Seconds, Eggs, Coins, Pet?, WelcomeBack })   eggs hatched while the player was away
--   ("Friend", { Name, Coins })             a Roblox friend is in this server: friend gift paid
--   ("Group", { Coins })                    the daily group gift was paid

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local GeodeGen = require(Shared.GeodeGen)
local Net = require(Shared.Net)
local Retention = require(Shared.Retention)
local LaunchPerks = require(Shared.LaunchPerks)
local RobuxConfig = require(Shared.RobuxConfig)
local EggPerks = require(Shared.EggPerks)
local Profiles = require(script.Parent.Profiles)
local PetService = require(script.Parent.PetService)

local RetentionService = {}

local TICK = 5 -- seconds between play-time ticks
local greeted: { [Player]: boolean } = {} -- away check done for this join (play time and LastSeen count after it)
type Notice = { Kind: string, Payload: { [string]: any } }
local pending: { [Player]: { Notice } } = {} -- notices waiting for the client's "Ready"
local ready: { [Player]: boolean } = {}
local lastAction: { [Player]: number } = {}
local lobbyServer = true

local friendCheck = function(a: Player, b: Player): boolean
	return a:IsFriendsWith(b.UserId)
end
-- Tests only: replace the Roblox friend check (it yields and can fail; failures pay nothing). The group check moved
-- to LobbyHangout (one group reward: LobbyHangout.checkGroup asks Roblox once and calls groupDaily); `_group` is kept
-- so old callers still work.
function RetentionService.setChecks(friend: ((Player, Player) -> boolean)?, _group: ((Player, number) -> boolean)?)
	if friend then
		friendCheck = friend
	end
end

local function today(): number
	return Retention.day(os.time())
end

local function notify(player: Player, kind: string, payload: { [string]: any })
	if ready[player] then
		Net.event("Retention"):FireClient(player, kind, payload)
	else
		local list = pending[player] or {}
		pending[player] = list
		table.insert(list, { Kind = kind, Payload = payload })
	end
end

local function pay(player: Player, data: { [string]: any }, coins: number)
	if coins <= 0 then
		return
	end
	data.Cash += coins
	data.Stats.CashEarned += coins
	Profiles.changed(player, true)
end

local function usable(player: Player): { [string]: any }?
	if not Profiles.isLoaded(player) or Profiles.isReleased(player) then
		return nil
	end
	return Profiles.get(player)
end

-- The best zone this player has unlocked (an away-nest pet comes from there).
local function bestTier(data: { [string]: any }): string
	local best = Config.TierOrder[1]
	for _, tid in Config.TierOrder do
		if type(data.UnlockedTiers) == "table" and data.UnlockedTiers[tid] == true then
			best = tid
		end
	end
	return best
end

-- Starter egg -----------------------------------------------------------------------------------

-- Hatches the starter pet and tells the client to play the show. Returns true when it hatched just now.
function RetentionService.hatchStarter(player: Player): boolean
	local pet = PetService.ensureStarter(player)
	if not pet then
		return false
	end
	notify(player, "Starter", { Pet = GeodeGen.public(pet :: any) })
	return true
end

-- Away nest --------------------------------------------------------------------------------------

local function greet(player: Player, data: { [string]: any })
	local st = data.Retention
	local now = os.time()
	local reward = if lobbyServer then Retention.away(st.LastSeen, now) else nil
	st.LastSeen = now
	greeted[player] = true
	if not reward then
		return
	end
	pay(player, data, reward.Coins)
	local petView = nil
	-- first pet rule: no free pet before the starter egg hatched (the coins still come)
	if reward.Pet and Retention.freePetReady(data) and #data.InventoryGeodes < Profiles.petCapacity(data) then
		local tier = bestTier(data)
		-- a Common pet of the best zone (never a chase pet: the chase pet is Legendary only)
		local pet = GeodeGen.roll(Random.new(), tier, HttpService:GenerateGUID(false), "away", now, true, 0, { Common = 1 })
		if Profiles.grantSpecimen(player, "away:" .. player.UserId .. ":" .. now, pet, "Gift") then
			petView = GeodeGen.public(pet)
		end
	end
	notify(player, "Away", {
		Seconds = reward.Seconds,
		Eggs = reward.Eggs,
		Coins = reward.Coins,
		Pet = petView,
		WelcomeBack = reward.WelcomeBack,
	})
end

RetentionService.greet = greet -- (tests) the away check a fresh join runs

-- Friend + group gifts ----------------------------------------------------------------------------

local function friendGifts(player: Player)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local ok, yes = pcall(friendCheck, player, other)
			if ok and yes == true then
				local day = today()
				for _, pair in { { player, other }, { other, player } } do
					local who, friend = pair[1], pair[2]
					local data = usable(who)
					if data then
						local coins = Retention.friendGift(data.Retention, day, friend.UserId)
						if coins > 0 then
							pay(who, data, coins)
							notify(who, "Friend", { Name = friend.DisplayName, Coins = coins })
						end
					end
				end
			end
		end
	end
end

-- The daily group coins (part of the one group reward; LobbyHangout.checkGroup decides membership and calls this).
-- Returns the coins paid (0 when off, not a member, or already paid today).
function RetentionService.groupDaily(player: Player, member: boolean): number
	if Retention.Group.Id == 0 then
		return 0
	end
	local data = usable(player)
	if not data then
		return 0
	end
	local coins = Retention.groupGift(data.Retention, today(), member)
	if coins > 0 then
		pay(player, data, coins)
		notify(player, "Group", { Coins = coins })
	end
	return coins
end

-- Play-time gifts -----------------------------------------------------------------------------------

-- One play-time tick for every greeted player (exposed for tests).
function RetentionService.tick(dt: number)
	local day = today()
	local now = os.time()
	for _, player in Players:GetPlayers() do
		local data = if greeted[player] then usable(player) else nil
		if data then
			local st = data.Retention
			st.LastSeen = now
			if Retention.tickPlay(st, day, dt) then
				Profiles.changed(player, true) -- the timer turns into OPEN
				notify(player, "GiftReady", { Index = st.Play.Claimed + Retention.readyGifts(st, day) })
			end
		end
	end
end

-- Spin wheel (LaunchPerks.Spin, idea 3): one free spin every 4 hours. The server rolls the slice and pays it; the
-- client only animates the wheel onto the slice it is told ("Spin", { Slice, Text }).
local spinRng = Random.new()
-- Every tap gets an answer: "Spin" { Slice, Text } or "SpinNo" { In = seconds left | Text }. force = Studio dev spin
-- (the 4-hour clock is ignored; DevCommands "/spin").
local function spinNow(player: Player, data: { [string]: any }, force: boolean?): (string?, string?)
	local perks = LaunchPerks.sanitize(data.Perks)
	data.Perks = perks
	local now = os.time()
	if force then
		perks.SpinAt = 0
	end
	local slice, why = LaunchPerks.spin(perks, now, spinRng:NextNumber())
	if not slice then
		if why == "NotYet" then
			Profiles.changed(player, true) -- the screen was early: send the real timer
			notify(player, "SpinNo", { In = LaunchPerks.spinLeft(perks, now) })
		end
		return nil, why
	end
	local tierId = RobuxConfig.eggTier(data.UnlockedTiers)
	local text = LaunchPerks.sliceText(slice, tierId)
	if slice.Kind == "Coins" then
		pay(player, data, LaunchPerks.sliceCoins(slice, tierId))
	elseif slice.Kind == "Potion" then
		RobuxConfig.addPotion(data.Robux, now, (slice.Minutes or 0) * 60)
		data.Robux.PotionsBought = math.max(0, (data.Robux.PotionsBought or 1) - 1) -- a free potion is not a purchase
	else
		local eggPerks = EggPerks.sanitize(data.EggPerks)
		data.EggPerks = eggPerks
		if not (slice.Egg and EggPerks.bankAdd(eggPerks, slice.Egg)) then
			-- the free egg bank is full: the same spin pays the big coin slice instead
			local big = LaunchPerks.slice("CoinsL") :: LaunchPerks.Slice
			pay(player, data, LaunchPerks.sliceCoins(big, tierId))
			text = LaunchPerks.sliceText(big, tierId)
		end
	end
	Profiles.changed(player, true)
	notify(player, "Spin", { Slice = slice.Id, Text = text })
	return slice.Id, text
end

function RetentionService.spin(player: Player, data: { [string]: any }, force: boolean?): (string?, string?)
	local ok, id, text = pcall(spinNow, player, data, force)
	if not ok then
		warn("[RetentionService] spin failed:", id)
		notify(player, "SpinNo", { Text = "Spin failed. Try again!" })
		return nil, "Error"
	end
	return id, text
end

local function onAction(player: Player, action: any)
	local t = os.clock()
	if lastAction[player] and t - lastAction[player] < 0.3 then
		return
	end
	lastAction[player] = t
	if action == "Ready" then
		ready[player] = true
		local list: { Notice } = pending[player] or {}
		pending[player] = nil
		for _, n in list do
			Net.event("Retention"):FireClient(player, n.Kind, n.Payload)
		end
		return
	end
	local data = usable(player)
	if not data then
		return
	end
	if action == "Starter" then
		if not lobbyServer then
			return
		end
		if not RetentionService.hatchStarter(player) and data.StarterPet ~= true then
			Net.event("Toast"):FireClient(player, "Your Pet Book is full. Sell a pet to hatch your starter egg!", "warn")
		end
	elseif action == "Spin" then
		RetentionService.spin(player, data)
	elseif action == "Gift" then
		local coins, index, why = Retention.claimGift(data.Retention, today())
		if coins then
			pay(player, data, coins)
			notify(player, "Gift", { Coins = coins, Index = index })
		elseif why == "NotYet" then
			Profiles.changed(player, true) -- the screen was early: send the real timer
		end
	end
end

function RetentionService.start(isMatch: boolean)
	lobbyServer = not isMatch
	Net.event("RetentionAction").OnServerEvent:Connect(onAction)
	Profiles.onLoaded(function(player, data)
		data = data or Profiles.get(player)
		if not data then
			return
		end
		greet(player, data)
		task.spawn(friendGifts, player) -- the group gift: LobbyHangout.checkGroup (one group reward)
	end)
	Players.PlayerRemoving:Connect(function(player)
		greeted[player] = nil
		pending[player] = nil
		ready[player] = nil
		lastAction[player] = nil
	end)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(TICK)
			local t = os.clock()
			RetentionService.tick(t - last)
			last = t
		end
	end)
end

return RetentionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="258">
        <Properties>
          <string name="Name">RobuxService</string>
          <string name="Source"><![CDATA[--!strict
-- Robux shop (owner decision 2026-10-11; tuning in shared/RobuxConfig, luck rules in shared/LuckEvents).
-- Sells: paid pet eggs (Basic / Rare / Mythic as 1x, 3x, 10x; GeodeGen rolls for the buyer's best zone with the egg's
-- rarity table, full odds shown on the card; one receipt = 1, 3 or 10 pets), 15-minute luck
-- potions and three game passes (2x coins, extra plot slots, more pet storage). Runs the free luck events too:
-- 2x luck every UTC weekend and random 15-minute server-wide luck storms.
--
-- Purchases: the client names an item (RobuxAction "Buy"); the server checks it (real id > 0, paid eggs allowed by
-- PolicyService for this player, Pet Book room for every pet of the batch, potion stack not at the cap, pass not owned) and
-- opens the Roblox prompt. Nothing is granted by the prompt. Developer Products are granted in ProcessReceipt, keyed by
-- the receipt's PurchaseId: the id is recorded in the profile (Robux.Receipts) together with the grant, the profile is
-- saved, and only then PurchaseGranted is returned. A replayed receipt changes nothing; a missing / released profile or
-- a failed save answers NotProcessedYet so Roblox retries later. Game passes are recorded in the profile when bought
-- (PromptGamePassPurchaseFinished) and re-checked on join (UserOwnsGamePassAsync).
--
-- The EGG SHRINE (the public hatch stand, prompt added by MapHooks) sells the same eggs for coins (RobuxAction
-- "BuyEggCoins"; prices in RobuxConfig.CoinEggs): same hatch code, show and notices as a Robux egg.
--
-- There is one ProcessReceipt per server (StoreService owns it); this service registers a receipt route there
-- (Store.addReceiptRoute) for its own product ids.
--
-- With every id at 0 (RobuxConfig, REPLACE markers) nothing can be prompted or granted. NOT tested against real
-- purchases (needs the owner's ids and a Studio / live test).

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local GeodeGen = require(Shared.GeodeGen)
local RobuxConfig = require(Shared.RobuxConfig)
local LuckEvents = require(Shared.LuckEvents)
local EggPerks = require(Shared.EggPerks)
local LaunchPerks = require(Shared.LaunchPerks)
local Profiles = require(script.Parent.Profiles)
local Kit = require(script.Parent.KitParts)
local RareHatch = require(script.Parent.RareHatch)

local Robux = {}

local HUT_NAME = require(Shared.MapNames).EggShop -- the hut model (hand-built map or fallback park)
local PANEL = "RobuxShop" -- client panel name (Main.client panels table)

local rng = Random.new()
-- PolicyService answer per player: false = paid random items allowed; true or missing = not allowed (hidden).
local restricted: { [Player]: boolean } = {}

local function toast(player: Player, text: string, kind: string?)
	Net.event("Toast"):FireClient(player, text, kind or "info")
end

local function toastAll(text: string, kind: string?)
	Net.event("Toast"):FireAllClients(text, kind or "info")
end

-- Paid random items (eggs, and the luck potion that boosts random pet odds) are only offered once PolicyService
-- said they are allowed for this player. The server-set attribute mirrors `restricted` (clients cannot change a
-- server attribute); either one saying "restricted" blocks.
function Robux.eggsAllowed(player: Player): boolean
	return restricted[player] == false and player:GetAttribute("PaidRandomRestricted") == false
end

-- A failed PolicyService call keeps the player locked out and retries with backoff until it answers.
local function checkPolicy(player: Player)
	local delay = 2
	while player.Parent do
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		if ok and type(info) == "table" and player.Parent then
			local blocked = info.ArePaidRandomItemsRestricted ~= false
			restricted[player] = blocked
			player:SetAttribute("PaidRandomRestricted", blocked) -- the shop hides paid eggs when true
			return
		end
		if player.Parent and restricted[player] == nil then
			restricted[player] = true
			player:SetAttribute("PaidRandomRestricted", true) -- locked until an answer arrives
		end
		task.wait(delay)
		delay = math.min(delay * 2, 60)
	end
end

local function stormUntil(): number
	local v = ReplicatedStorage:GetAttribute("LuckStormUntil")
	return if type(v) == "number" then v else 0
end

-- The luck a bought egg rolls with: 0 unless RobuxConfig.EggsUseLuck (then pets + potion + weekend + storm).
function Robux.eggLuck(data): number
	if not RobuxConfig.EggsUseLuck then
		return 0
	end
	local t = LuckEvents.timed(os.time(), tonumber(data.Robux.LuckUntil) or 0, stormUntil())
	return LuckEvents.total({ Pet = Profiles.petBoosts(data).Luck, Potion = t.Potion, Weekend = t.Weekend, Storm = t.Storm, Hour = t.Hour, Vip = RobuxConfig.vipLuck(data.Robux) })
end

-- Public hatch stand -------------------------------------------------------------------------------------------------

-- The stand (built by the park helper): a BasePart with attribute HatchStand = true (Attachment "HatchPoint" on it).
local function hatchStand(): BasePart?
	for _, d in Workspace:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("HatchStand") == true then
			return d
		end
	end
	return nil
end

-- Shows play one after another for every client (HatchStandView); with no stand in the world nothing is queued
-- (the buyer still gets the notice and the pets).
local shows: { any } = {}
local showing = false
local function queueShow(player: Player, egg: any, pets: { any }, best: any)
	if not hatchStand() or #shows >= RobuxConfig.Show.QueueMax then
		return
	end
	table.insert(shows, { Buyer = player.DisplayName, BuyerId = player.UserId, Egg = egg.Name, Count = #pets, Pet = GeodeGen.public(best) })
	if showing then
		return
	end
	showing = true
	task.spawn(function()
		while #shows > 0 do
			local s = table.remove(shows, 1) :: any
			s.Waiting = #shows
			Net.event("HatchShow"):FireAllClients(s)
			task.wait(RobuxConfig.Show.Seconds)
		end
		showing = false
	end)
end

-- Egg hatching (shared by the Robux receipt and the coin shrine) -------------------------------------------------------

-- Rolls `count` pets of `egg` for the buyer's best zone (GeodeGen.roll with the egg's rarity table; Basic = the race
-- egg odds) and grants each under the award key "<keyBase>:<n>". Bought pets are granted even into a full Pet Book
-- (the buy request checked room). Returns the pets actually granted.
local function hatchLoop(player: Player, data, egg: any, count: number, keyBase: string): { any }
	local pets = {}
	local tierId = RobuxConfig.eggTier(data.UnlockedTiers)
	local luck = Robux.eggLuck(data)
	local perks = EggPerks.sanitize(data.EggPerks)
	data.EggPerks = perks
	for i = 1, count do
		local awardKey = keyBase .. ":" .. i
		-- Lucky Meter full: this egg is Epic or better (its Legendary chance unchanged, EggPerks.pityWeights)
		local lucky = EggPerks.full(perks.Meter)
		local weights = RobuxConfig.eggRarity(egg)
		if lucky then
			weights = EggPerks.pityWeights(weights)
		end
		local pet = GeodeGen.roll(Random.new(rng:NextInteger(1, 2 ^ 30)), tierId, HttpService:GenerateGUID(false), awardKey, os.time(), true, luck, weights, egg.ShinyOneIn)
		if Profiles.grantSpecimen(player, awardKey, pet, "Bought") then
			table.insert(pets, pet)
			perks.Meter = EggPerks.meterAfter(perks.Meter, egg.Id, pet.Rarity)
			if lucky then
				toast(player, "LUCKY METER full! Guaranteed " .. pet.Rarity:upper() .. " pet!", "rare")
			end
		end
	end
	return pets
end

local hatching: { [Player]: boolean } = {}
local function hatchEggs(player: Player, data, egg: any, count: number, keyBase: string): { any }
	-- grantSpecimen fires Profiles.changed, whose handlers run at once: openFreeEggs must not hatch a banked egg in the
	-- middle of this loop (it would read the same full Lucky Meter, so one meter paid two pity eggs)
	local outer = not hatching[player]
	hatching[player] = true
	local ok, pets = pcall(function()
		return hatchLoop(player, data, egg, count, keyBase)
	end)
	if outer then
		hatching[player] = nil
		task.defer(function()
			Robux.openFreeEggs(player) -- banked eggs wait until this hatch is done
		end)
	end
	if not ok then
		error(pets, 0)
	end
	return pets
end

-- One notice for the buyer (the best pet of the batch), one server-wide line per Rare+ pet (owner rule), the rare
-- hatch alert for the best one (banner + fireworks, and the sky beam over the shrine for Epic / Legendary; lobby
-- hangout idea 2) and the public hatch-stand show.
local function announceHatch(player: Player, data, egg: any, pets: { any })
	local best = pets[1]
	for _, pet in pets do
		if table.find(Config.Rarities, pet.Rarity) > table.find(Config.Rarities, best.Rarity) then
			best = pet
		end
	end
	for _, pet in pets do
		if pet ~= best and Config.Pets.AnnounceRarities[pet.Rarity] then
			toastAll(player.DisplayName .. " hatched a " .. pet.Rarity:upper() .. " " .. GeodeGen.displayName(pet) .. " from a " .. egg.Name .. "!", "rare")
		end
	end
	if best then
		RareHatch.announce(player, best)
		queueShow(player, egg, pets, best)
		local name = best.Rarity:upper() .. " " .. GeodeGen.displayName(best)
		local follows = table.find(data.EquippedPets or {}, best.Id) ~= nil
		toast(player, if #pets == 1 then "You hatched a " .. name .. (if follows then "! It follows you now." else "! It is in your Pet Book.") else "You hatched " .. #pets .. " pets! Best: " .. name .. ". See your Pet Book.", "rare")
	end
end

-- Hatch / potion notice per receipt key, shown once the grant is saved (a failed first save is retried by Roblox and
-- the retry is no longer "fresh", so the notice waits here).
local pendingNotice: { [string]: () -> () } = {}

-- Receipts ------------------------------------------------------------------------------------------------------------

-- Grants one Robux shop product for a receipt. Returns nil for a product this service does not sell (the dispatcher
-- then hands it to StoreService).
function Robux.processReceipt(info: { PlayerId: number, PurchaseId: any, ProductId: number }): Enum.ProductPurchaseDecision?
	local kind, item, count = RobuxConfig.productKind(info.ProductId)
	if not kind then
		return nil
	end
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- granted when they are back on a server
	end
	local data = Profiles.get(player)
	if not data or Profiles.isReleased(player) or Profiles.lockLost(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- the grant must land on the server that can save it
	end
	local key = tostring(info.PurchaseId)
	local state = data.Robux
	local fresh = not RobuxConfig.granted(state, key)
	local pets: { any } = {}
	if fresh then
		if kind == "Egg" then
			-- `count` rolls under this one receipt: GeodeGen.roll for the buyer's best zone with the egg's rarity table
			-- (Basic = the race egg odds). Paid pets are granted even into a full Pet Book (the prompt checked room).
			pets = hatchEggs(player, data, item, count, "robux:" .. key)
			state.EggsBought += #pets
		elseif kind == "Pack" then
			-- Starter pack: its eggs (hatched like bought eggs, one award key each) and its potion time, once. A second
			-- receipt (bought on two servers at once) is still granted in full: Roblox charged it.
			local pack = RobuxConfig.StarterPack
			for eggId, n in pack.Eggs do
				local egg = RobuxConfig.egg(eggId)
				if egg then
					for _, pet in hatchEggs(player, data, egg, n, "robux:" .. key .. ":" .. eggId) do
						table.insert(pets, pet)
					end
				end
			end
			state.EggsBought += #pets
			RobuxConfig.addPotion(state, os.time(), pack.PotionSeconds)
			state.StarterPack = true
		else
			RobuxConfig.addPotion(state, os.time())
		end
		RobuxConfig.remember(state, key) -- same mutation as the grant: saved together or not at all
		Profiles.changed(player, kind == "Potion")
	end
	-- PurchaseGranted only once the grant and the receipt id are saved; a failed save is retried by Roblox.
	if fresh then
		pendingNotice[key] = if kind == "Egg"
			then function()
				announceHatch(player, data, item, pets)
			end
			elseif kind == "Pack" then function()
				toast(player, "STARTER PACK! " .. #pets .. " pets and 2x luck for " .. LuckEvents.clock(RobuxConfig.potionLeft(state, os.time())) .. "!", "rare")
				if #pets > 0 then
					announceHatch(player, data, RobuxConfig.egg("RareEgg"), pets)
				end
			end
			else function()
				toast(player, "Luck potion on: 2x luck for " .. LuckEvents.clock(RobuxConfig.potionLeft(state, os.time())) .. "!", "ok")
			end
	end
	if not Profiles.saveNow(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local notice = pendingNotice[key]
	if notice then
		pendingNotice[key] = nil
		notice()
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Game passes ---------------------------------------------------------------------------------------------------------

-- Pass looks other players see (server attributes; NameTag draws them): VIP = gold name tag.
local function passAttributes(player: Player, data: any)
	player:SetAttribute("VIP", if RobuxConfig.hasPass(data and data.Robux, "VIP") then true else nil)
end

local function grantPass(player: Player, key: string): boolean
	local data = Profiles.get(player)
	if not data or Profiles.isReleased(player) or RobuxConfig.hasPass(data.Robux, key) then
		return false
	end
	data.Robux.Passes[key] = true
	passAttributes(player, data)
	Profiles.changed(player, true)
	return true
end

local function checkPasses(player: Player)
	for key, pass in RobuxConfig.Passes do
		if pass.PassId > 0 then
			local ok, owns = false, nil
			for attempt = 1, 3 do -- a pass bought on the website must not be lost to one failed check
				ok, owns = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.PassId)
				end)
				if ok or not player.Parent then
					break
				end
				task.wait(2 * attempt)
			end
			if ok and owns == true and player.Parent then
				grantPass(player, key)
			end
		end
	end
end

-- Shop requests -------------------------------------------------------------------------------------------------------

local function buy(player: Player, data, id: string, count: any)
	local egg = RobuxConfig.egg(id)
	if egg then
		local n = if type(count) == "number" and table.find(RobuxConfig.EggCounts, count) then count else nil
		local productId = if n then egg.Products[n] or 0 else 0
		if productId <= 0 then
			return
		end
		if not RobuxConfig.eggOnSale(egg, os.time()) then
			toast(player, egg.Name .. " is not for sale anymore.", "info")
			return
		end
		if not Robux.eggsAllowed(player) then
			toast(player, "Pet eggs can't be bought with Robux on your account.", "warn")
			return
		end
		local full = RobuxConfig.roomRefusal(Profiles.inventoryMax(data) - #data.InventoryGeodes, n :: number)
		if full then
			toast(player, full, "warn")
			return
		end
		pcall(function()
			MarketplaceService:PromptProductPurchase(player, productId)
		end)
		return
	end
	local pack = RobuxConfig.StarterPack
	if id == pack.Id then
		if pack.ProductId <= 0 then
			return
		end
		if data.Robux.StarterPack == true then
			toast(player, "You already have the Starter Pack.", "info")
			return
		end
		if not Robux.eggsAllowed(player) then -- it holds eggs: a paid random item
			toast(player, "The Starter Pack can't be bought with Robux on your account.", "warn")
			return
		end
		local eggs = 0
		for _, n in pack.Eggs do
			eggs += n
		end
		local full = RobuxConfig.roomRefusal(Profiles.inventoryMax(data) - #data.InventoryGeodes, eggs)
		if full then
			toast(player, full, "warn")
			return
		end
		pcall(function()
			MarketplaceService:PromptProductPurchase(player, pack.ProductId)
		end)
		return
	end
	local potion = RobuxConfig.Potion
	if id == potion.Id then
		if potion.ProductId <= 0 then
			return
		end
		-- The potion raises the odds of a random pet reward, so it is a paid random-outcome item too: same
		-- PolicyService gate as the eggs. A receipt Roblox already charged is still granted (processReceipt).
		if not Robux.eggsAllowed(player) then
			toast(player, "Luck potions can't be bought with Robux on your account.", "warn")
			return
		end
		if RobuxConfig.potionLeft(data.Robux, os.time()) + potion.Seconds > potion.MaxStackSeconds then
			toast(player, "You have lots of potion time left. Try again later.", "warn")
			return
		end
		pcall(function()
			MarketplaceService:PromptProductPurchase(player, potion.ProductId)
		end)
		return
	end
	local pass = RobuxConfig.Passes[id]
	if pass then
		if pass.PassId <= 0 then
			return
		end
		if RobuxConfig.hasPass(data.Robux, id) then
			toast(player, "You already own " .. pass.Name .. ".", "info")
			return
		end
		pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, pass.PassId)
		end)
	end
end

-- Coin eggs at the EGG SHRINE (RobuxAction "BuyEggCoins", eggId, count; prices in RobuxConfig.CoinEggs) --------------

-- Same eggs, odds, pets and show as the Robux eggs, paid with coins. Checked here: the egg id and count, the paid
-- random item gate (PolicyService, same as the Robux eggs), Pet Book room for every pet (same refusal) and enough coins
-- for the buyer's zone price. The coins come off and the pets go in within one profile change, so a save holds both or
-- neither.
local SHRINE_SLACK = 10 -- studs beyond the prompt's reach
local buyCoinsAt: { [Player]: number } = {}
local hutPrompt: ProximityPrompt? = nil -- the EGG SHOP hut's prompt (hookHut): coin eggs sell there too

-- Near the EGG SHOP hut's prompt (the Pet Shop's Eggs tab sells the same eggs for coins).
local function nearHut(player: Player): boolean
	local pp = hutPrompt
	local part = if pp then pp.Parent else nil
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not (pp and part and part:IsA("BasePart") and root and root:IsA("BasePart")) then
		return false
	end
	return (root.Position - part.Position).Magnitude <= pp.MaxActivationDistance + SHRINE_SLACK
end

local function nearStand(player: Player): boolean
	local stand = hatchStand()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not (stand and root and root:IsA("BasePart")) then
		return false
	end
	local prompt = stand:FindFirstChildWhichIsA("ProximityPrompt", true)
	local range = if prompt then prompt.MaxActivationDistance else 12
	return (root.Position - stand.Position).Magnitude <= range + SHRINE_SLACK
end

-- Returns true when the eggs were bought (auto hatch keeps going only then).
local function buyEggCoins(player: Player, data, id: any, count: any): boolean
	local now = os.clock()
	local prev = buyCoinsAt[player]
	if prev and now - prev < 0.45 then
		return false
	end
	-- the HUD SHOP button opens the Pet Shop anywhere; coin eggs still sell only at the EGG SHOP hut / hatch stand
	-- (Studio 2026-10-15: far away the tap did nothing at all, so say why)
	if not (nearStand(player) or nearHut(player)) then
		buyCoinsAt[player] = now
		toast(player, "Walk to the EGG SHOP to buy eggs with coins!", "info")
		return false
	end
	buyCoinsAt[player] = now
	local egg = RobuxConfig.egg(id)
	if not egg or type(count) ~= "number" or not table.find(RobuxConfig.CoinEggs.Counts, count) then
		return false
	end
	if not Robux.eggsAllowed(player) then
		toast(player, "Pet eggs can't be bought on your account.", "warn")
		return false
	end
	-- 3x / 10x need the Open 3 Eggs pass once that pass is on sale (RobuxConfig.CountPass)
	local needs = RobuxConfig.countPass(count)
	if needs and not RobuxConfig.hasPass(data.Robux, needs) then
		toast(player, "Get the " .. RobuxConfig.Passes[needs].Name .. " pass to hatch " .. count .. " at once!", "info")
		return false
	end
	local tierId = RobuxConfig.eggTier(data.UnlockedTiers)
	local price, why = RobuxConfig.coinEggCheck(egg.Id, count, tierId, data.Cash, Profiles.inventoryMax(data) - #data.InventoryGeodes)
	if not price then
		if why then
			toast(player, why, "warn")
		end
		return false
	end
	data.Cash -= price
	local pets = hatchEggs(player, data, egg, count, "coins:" .. HttpService:GenerateGUID(false))
	if #pets < count then
		data.Cash += (price // count) * (count - #pets) -- a pet that could not be granted is not paid for
	end
	Profiles.changed(player)
	if #pets > 0 then
		announceHatch(player, data, egg, pets)
		-- the shrine's "You got: ..." strip: each pet once, with how many
		local order, n = {}, {}
		for _, pet in pets do
			local name = pet.Rarity:upper() .. " " .. GeodeGen.displayName(pet)
			if not n[name] then
				table.insert(order, name)
			end
			n[name] = (n[name] or 0) + 1
		end
		local parts = {}
		for _, name in order do
			table.insert(parts, if n[name] > 1 then name .. " x" .. n[name] else name)
		end
		Net.event("RobuxAction"):FireClient(player, "Hatched", "You got: " .. table.concat(parts, ", "))
	end
	return #pets > 0
end

-- Auto hatch (Auto Hatch pass, idea 43): RobuxAction "AutoHatch", eggId (or "" to stop). The shrine buys the same
-- coin egg every RobuxConfig.Auto.Every seconds (3 at once with the Open 3 Eggs pass) while the player stays near it;
-- any refusal (coins, room, walked away, left) stops it. The chosen egg is remembered in Perks.AutoEgg for the UI.
local autoRun: { [Player]: number } = {} -- player -> run token (a new start or a stop ends the old loop)
local function stopAuto(player: Player, data: any?, why: string?)
	autoRun[player] = nil
	if data and data.Perks and data.Perks.AutoEgg ~= nil then
		data.Perks.AutoEgg = nil
		Profiles.changed(player, true)
	end
	if why then
		toast(player, why, "info")
	end
end

local function startAuto(player: Player, data: any, eggId: string)
	if eggId == "" then
		stopAuto(player, data, "Auto hatch off.")
		return
	end
	if RobuxConfig.Passes.AutoHatch.PassId <= 0 or not RobuxConfig.hasPass(data.Robux, "AutoHatch") then
		toast(player, "Get the Auto Hatch pass to hatch eggs on their own!", "info")
		return
	end
	if not (RobuxConfig.egg(eggId) and RobuxConfig.CoinEggs.Rounds[eggId]) then
		return
	end
	local token = (autoRun[player] or 0) + 1
	autoRun[player] = token
	local perks = LaunchPerks.sanitize(data.Perks)
	data.Perks = perks
	perks.AutoEgg = eggId
	Profiles.changed(player, true)
	toast(player, "Auto hatch on! Stay near the shrine.", "ok")
	task.spawn(function()
		local count = if RobuxConfig.hasPass(data.Robux, "TripleHatch") then 3 else 1
		for _ = 1, RobuxConfig.Auto.MaxHatches do
			if autoRun[player] ~= token or not player.Parent then
				return
			end
			local d = Profiles.get(player)
			if not d or Profiles.isReleased(player) then
				return
			end
			buyCoinsAt[player] = nil -- the auto loop is the one paced buyer here
			if not buyEggCoins(player, d, eggId, count) then
				if autoRun[player] == token then
					stopAuto(player, d, "Auto hatch stopped.")
				end
				return
			end
			task.wait(RobuxConfig.Auto.Every)
		end
		if autoRun[player] == token then
			stopAuto(player, Profiles.get(player), "Auto hatch stopped.")
		end
	end)
end

-- A free pet (lobby hangout: mystery egg drop, group gift), hatched from egg `eggId` exactly like a bought one (same
-- odds, show, notices and rare alert), only into a Pet Book with room. `keyBase` makes the award idempotent (the same
-- key never grants twice). Returns the pet, or nil (no room, unknown egg, profile not loaded).
function Robux.giftEgg(player: Player, eggId: string, keyBase: string): any?
	local data = Profiles.get(player)
	local egg = RobuxConfig.egg(eggId)
	if not data or not egg or Profiles.isReleased(player) or #data.InventoryGeodes >= Profiles.inventoryMax(data) then
		return nil
	end
	local pets = hatchEggs(player, data, egg, 1, keyBase)
	Profiles.changed(player)
	if pets[1] then
		announceHatch(player, data, egg, pets)
	end
	return pets[1]
end

-- Free eggs the player EARNED (EggPerks: every 3rd Pet Battle win, all daily quests) wait in profile EggPerks.Bank and
-- hatch here, best first, exactly like a bought egg (odds, Lucky Meter, show, notices), while the Pet Book has room.
-- Runs on every profile change, so a banked egg opens the moment a pet is sold or the player rejoins.
local opening: { [Player]: boolean } = {}
function Robux.openFreeEggs(player: Player): number
	local data = Profiles.get(player)
	if opening[player] or hatching[player] or not data or Profiles.isReleased(player) or not player.Parent then
		return 0
	end
	local perks = EggPerks.sanitize(data.EggPerks)
	data.EggPerks = perks
	if EggPerks.bankCount(perks) == 0 or #data.InventoryGeodes >= Profiles.inventoryMax(data) then
		return 0
	end
	opening[player] = true
	local opened = 0
	local pending: string? = nil -- taken from the bank, not hatched yet
	local ok, err = pcall(function()
		while #data.InventoryGeodes < Profiles.inventoryMax(data) do
			local id = EggPerks.bankTake(perks)
			local egg = if id then RobuxConfig.egg(id) else nil
			if not (id and egg) then
				break
			end
			pending = id
			local pets = hatchEggs(player, data, egg, 1, "free:" .. HttpService:GenerateGUID(false))
			pending = nil
			if #pets == 0 then
				EggPerks.bankAdd(perks, id) -- not granted: keep it for later
				break
			end
			opened += 1
			announceHatch(player, data, egg, pets)
		end
	end)
	if pending then
		EggPerks.bankAdd(perks, pending) -- the hatch failed before the pet was made: the egg goes back
	end
	Profiles.changed(player) -- before the flag clears: its handlers must not re-enter (a failing egg would loop)
	opening[player] = nil -- always cleared, so one error never blocks free eggs until a rejoin
	if not ok then
		warn("[Robux] free egg hatch failed: " .. tostring(err))
	end
	return opened
end

-- Luck events ---------------------------------------------------------------------------------------------------------

-- Starts a luck storm on this server now (also used by tests / previews).
function Robux.startStorm(seconds: number?)
	local secs = seconds or RobuxConfig.Events.StormSeconds
	ReplicatedStorage:SetAttribute("LuckStormUntil", os.time() + secs)
	toastAll("LUCK STORM! 2x luck for " .. math.floor(secs / 60 + 0.5) .. " minutes!", "rare")
end

local function runEvents()
	ReplicatedStorage:SetAttribute("LuckStormUntil", 0)
	local weekend = LuckEvents.isWeekend(os.time())
	ReplicatedStorage:SetAttribute("LuckWeekend", weekend)
	task.spawn(function()
		while true do
			task.wait(30)
			local w = LuckEvents.isWeekend(os.time())
			if w ~= weekend then
				weekend = w
				ReplicatedStorage:SetAttribute("LuckWeekend", w)
				toastAll(if w then "WEEKEND LUCK! 2x luck all weekend!" else "Weekend luck is over.", if w then "rare" else "info")
			end
		end
	end)
	-- lucky hour (LaunchPerks.luckyHourUntil): the same UTC hours on every server, announced when it starts and ends
	local hourUntil = LaunchPerks.luckyHourUntil(os.time())
	ReplicatedStorage:SetAttribute("LuckyHourUntil", hourUntil)
	task.spawn(function()
		while true do
			task.wait(15)
			local u = LaunchPerks.luckyHourUntil(os.time())
			if (u > 0) ~= (hourUntil > 0) then
				toastAll(if u > 0 then "LUCKY HOUR! 2x luck for " .. RobuxConfig.Events.LuckyHourMinutes .. " minutes!" else "Lucky hour is over.", if u > 0 then "rare" else "info")
			end
			if u ~= hourUntil then
				hourUntil = u
				ReplicatedStorage:SetAttribute("LuckyHourUntil", u)
			end
		end
	end)
	task.spawn(function()
		local gap = LuckEvents.nextGap(rng, true)
		while true do
			task.wait(gap)
			Robux.startStorm()
			task.wait(RobuxConfig.Events.StormSeconds)
			toastAll("The luck storm is over.", "info")
			gap = LuckEvents.nextGap(rng)
		end
	end)
end

-- EGG SHOP hut ---------------------------------------------------------------------------------------------------------

-- The lobby hut (a Model or part named MapNames.EggShop, built elsewhere) opens the shop through a ProximityPrompt whose
-- "Panel" attribute is "RobuxShop". A prompt the hut already has is reused; otherwise one is added to its
-- "PromptAnchor" / "Counter" part, its PrimaryPart or its first part.
local function hookHut(hut: Instance)
	if hut:GetAttribute("RobuxShopHooked") then
		return
	end
	local existing = hut:FindFirstChildWhichIsA("ProximityPrompt", true)
	if existing then
		-- the map hooks leave the counter prompt disabled until a shop exists; this is that shop. It opens even while
		-- every id is still 0 (owner, 2026-10-15): the Pet Shop shows SOON on those prices instead of a dead door.
		existing.Enabled = true
		existing.ActionText = "Open"
		existing:SetAttribute("Panel", PANEL)
		-- the prompt card's big line names the shop, the small one the action (the lodge stand-in had them the other
		-- way round, so the card read "COMING SOON" big over a small shop name)
		existing.ObjectText = "Egg Shop"
		hutPrompt = existing
	else
		local anchor: Instance? = hut:FindFirstChild("PromptAnchor", true) or hut:FindFirstChild("Counter", true)
		if not (anchor and anchor:IsA("BasePart")) then
			anchor = if hut:IsA("BasePart") then hut elseif hut:IsA("Model") and hut.PrimaryPart then hut.PrimaryPart else hut:FindFirstChildWhichIsA("BasePart", true)
		end
		if not (anchor and anchor:IsA("BasePart")) then
			return -- no part yet: DescendantAdded tries again when the hut's parts arrive
		end
		-- ObjectText is the shop's name (the prompt card shows it as its big line, the action under it)
		local pp = Kit.prompt(anchor, "Open", "Egg Shop", PANEL, 12)
		pp.Enabled = true
		pp.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
		hutPrompt = pp
	end
	hut:SetAttribute("RobuxShopHooked", true)
end

local function watchHut()
	local found = Workspace:FindFirstChild(HUT_NAME, true)
	if found then
		hookHut(found)
	end
	Workspace.DescendantAdded:Connect(function(d)
		if d.Name == HUT_NAME then
			task.defer(hookHut, d)
		elseif d:IsA("BasePart") then
			local hut = d:FindFirstAncestor(HUT_NAME)
			if hut and not hut:GetAttribute("RobuxShopHooked") then
				task.defer(hookHut, hut)
			end
		end
	end)
end

-- Boot -----------------------------------------------------------------------------------------------------------------

function Robux.start()
	local Store = require(script.Parent.StoreService)
	local last: { [Player]: number } = {}
	local function onPlayer(p: Player)
		task.spawn(checkPolicy, p)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	-- banked free eggs (EggPerks) hatch on join and as soon as there is room
	Profiles.onLoaded(function(p)
		Robux.openFreeEggs(p)
	end)
	Profiles.onChanged(function(p)
		Robux.openFreeEggs(p)
	end)
	Players.PlayerRemoving:Connect(function(p)
		last[p] = nil
		restricted[p] = nil
		opening[p] = nil
		buyCoinsAt[p] = nil
		autoRun[p] = nil
	end)
	Profiles.onLoaded(function(player)
		passAttributes(player, Profiles.get(player))
		checkPasses(player)
		task.delay(8, function()
			if not player.Parent then
				return
			end
			if stormUntil() > os.time() then
				toast(player, "A LUCK STORM is on: 2x luck for " .. LuckEvents.clock(stormUntil() - os.time()) .. "!", "rare")
			elseif ReplicatedStorage:GetAttribute("LuckWeekend") == true then
				toast(player, "WEEKEND LUCK is on: 2x luck all weekend!", "rare")
			end
		end)
	end)
	Net.event("RobuxAction").OnServerEvent:Connect(function(player, action, arg, count)
		local t = os.clock()
		if last[player] and t - last[player] < 0.4 then
			return
		end
		last[player] = t
		local data = Profiles.get(player)
		if not data or Profiles.isReleased(player) or type(arg) ~= "string" then
			return
		end
		if action == "Buy" then
			buy(player, data, arg, count)
		elseif action == "BuyEggCoins" then
			buyEggCoins(player, data, arg, count)
		elseif action == "AutoHatch" then
			startAuto(player, data, arg)
		end
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local key = RobuxConfig.passKey(passId)
		if not (purchased and key) then
			return
		end
		task.spawn(function()
			-- bought before the profile finished loading: wait for it instead of waiting for a rejoin
			local t0 = os.clock()
			while player.Parent and not Profiles.get(player) and os.clock() - t0 < 60 do
				task.wait(0.5)
			end
			-- The finished event is not proof of a purchase (an exploit client can make it fire with purchased =
			-- true): only Roblox's own ownership check grants the pass. A few tries cover the moment right after a
			-- real purchase; if none says yes, the next join's checkPasses grants it.
			local owns = false
			for attempt = 1, 4 do
				if not player.Parent then
					return
				end
				local ok, res = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
				end)
				if ok and res == true then
					owns = true
					break
				end
				task.wait(2 * attempt)
			end
			if owns and player.Parent and grantPass(player, key) then
				toast(player, "Thanks! " .. RobuxConfig.Passes[key].Name .. " is yours.", "ok")
				Profiles.saveNow(player)
			end
		end)
	end)
	-- Roblox allows one ProcessReceipt: StoreService owns it and hands Robux shop products to this route.
	Store.addReceiptRoute(Robux.processReceipt)
	runEvents()
	watchHut()
end

return Robux
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="259">
        <Properties>
          <string name="Name">RockService</string>
          <string name="Source"><![CDATA[--!strict
-- The ONE authoritative service for the V3 loop (docs/V3_LOOP.md): pickup, deposit, crush and
-- machine ticks all go through here, on top of the pure rules in src/shared/RoundRocks.luau.
-- MatchService owns the lifecycle (arenas, countdown, reveal, results, saves) and calls in.
--
-- Clients send intents only: RockAction(action, roundId, rockId?). The server reads the player's
-- position itself, derives the station from round membership (never from the client), checks the
-- round id, phase, cadence, range and entitlement, and replicates opaque ids + states only. The
-- target rock is never sent anywhere before it is crushed. The old pile "Strike" remote is gone.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local HuntLedger = require(Shared.HuntLedger)
local SightRules = require(Shared.SightRules)
local ProgressConfig = require(Shared.ProgressConfig)
local HuntFun = require(Shared.HuntFun)
local EggPerks = require(Shared.EggPerks)
local Profiles = require(script.Parent.Profiles)
local EggEvents = require(script.Parent.EggEvents)

local RockService = {}
-- Set by PvpService: called once per egg a player finishes in a hunt (found = the egg with the pet inside).
RockService.onCracked = nil :: ((Player, boolean) -> ())?
-- Set by PvpService: gives `amount` pet XP to each pet following the player (surprise eggs, shared/HuntFun).
RockService.onPetXp = nil :: ((Player, number) -> ())?

local surpriseRng = Random.new()

local ACTIONS = { Pickup = true, Deposit = true, Crush = true, ToggleMachine = true }
local MIN_GAP = 0.03 -- any RockAction faster than ~33/s is dropped before it costs anything
local TOGGLE_GAP = 0.4
local REPLY_GAP = 0.15

local lastAny: { [Player]: number } = {}
local lastToggle: { [Player]: number } = {}
local lastReply: { [Player]: number } = {}

-- Motion sanity check (Config.Motion). Character positions are owned by the client, so a cheat can
-- teleport between the pile and its table. The server keeps one TRUSTED point per member (the last position
-- it judged reachable, and when). Every check (the scheduler each step, and every rock action on the LIVE
-- position) compares against it: a horizontal move farther than walking allows since then
-- (WalkSpeed * SpeedFactor * elapsed + Slack) is refused and locks that member's rock actions for a moment.
-- An impossible position never becomes trusted; it is accepted only once enough time has passed that walking
-- there would have been possible, so a fling or a lag spike heals by itself. The trusted point moves forward at
-- most every Anchor seconds, so the Slack is forgiven once per Anchor, not once per sample. Vertical moves
-- (jumps, falls) are not judged.
type Motion = { Pos: Vector3, T: number, LockUntil: number, GraceUntil: number }
local motion: { [number]: Motion } = {}

-- A server move (spawn, respawn, round start) is not a teleport: for Grace seconds the trusted point simply
-- follows the avatar (the client may still report the old spot for a moment), then checks start fresh.
function RockService.resetMotion(uid: number)
	local s = motion[uid]
	local grace = os.clock() + Config.Motion.Grace
	if s then
		s.GraceUntil = grace
	else
		motion[uid] = { Pos = Vector3.zero, T = -math.huge, LockUntil = 0, GraceUntil = grace }
	end
end

-- Judges `pos` (world) at time `t` (os.clock) against the trusted point. False for an impossible jump.
local function judgeMotion(uid: number, pos: Vector3, walkSpeed: number, t: number): boolean
	local cfg = Config.Motion
	local s = motion[uid]
	if not s then
		motion[uid] = { Pos = pos, T = t, LockUntil = 0, GraceUntil = 0 }
		return true
	end
	if t < s.GraceUntil or s.T == -math.huge then
		s.Pos, s.T = pos, t
		return true
	end
	local dt = math.max(0, t - s.T)
	local d = Vector2.new(pos.X - s.Pos.X, pos.Z - s.Pos.Z).Magnitude
	local allowed = math.max(walkSpeed, 16) * cfg.SpeedFactor * dt + cfg.Slack
	if d > allowed then
		s.LockUntil = math.max(s.LockUntil, t + cfg.Lock)
		return false -- the trusted point stays where it was
	end
	if dt >= cfg.Anchor then
		s.Pos, s.T = pos, t
	end
	return true
end

local function sampleMotion(uid: number, t: number)
	local p = Players:GetPlayerByUserId(uid)
	local char = p and p.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		return
	end
	judgeMotion(uid, root.Position, hum.WalkSpeed, t)
end

-- True while the member's rock actions are refused: the LIVE position `pos` (world) is farther from the
-- trusted point than walking allows right now, or a recent impossible jump still locks them.
local function motionLocked(uid: number, pos: Vector3, walkSpeed: number, t: number): boolean
	if Config.Motion.Enabled == false then
		return false
	end
	local live = judgeMotion(uid, pos, walkSpeed, t)
	local s = motion[uid]
	return not live or (s ~= nil and t < s.LockUntil)
end

local foundHandler: ((any, number, number) -> ())? = nil

-- MatchService registers what happens when the geode rock is crushed (finishRound).
function RockService.onFound(fn: (any, number, number) -> ())
	foundHandler = fn
end

local function playerOf(uid: number): Player?
	return Players:GetPlayerByUserId(uid)
end

-- Rubble storage left for a member, straight from the profile (sales change it at any time), and the member's
-- basket and nest tray sizes from the upgrade levels (ProgressConfig). MatchService calls this for every member
-- right after the round core is made, and every action and scheduler step refreshes it.
function RockService.refreshSpace(m: any, uid: number)
	local p = playerOf(uid)
	local data = p and Profiles.get(p)
	if data and m.Core then
		m.Core:setSpace(uid, Profiles.capacity(data) - Profiles.rubbleTotal(data))
		local help = RockService.helperOf(m, uid)
		m.Core:setCaps(uid, ProgressConfig.carry(data.BasketLevel) + (if help then help.Carry else 0), ProgressConfig.queue(data.NestLevel))
		m.Core:setHelper(uid, if help then help.Rate else 0)
	end
end

-- The pet helper step of a member for this round (shared/HuntFun.Helper), decided once per round from the pet that
-- follows them (pets cannot be changed during a hunt). None in the practice round, for bots or without a found pet.
function RockService.helperOf(m: any, uid: number): HuntFun.HelperStep?
	if m.HelperRound ~= m.Round then
		m.HelperRound = m.Round
		m.Helpers = {}
	end
	local cached = m.Helpers[uid]
	if cached ~= nil then
		return if cached == false then nil else cached
	end
	local p = playerOf(uid)
	local data = p and Profiles.get(p)
	if not data then
		return nil -- not cached: a profile still loading gets its helper on a later step
	end
	local step: HuntFun.HelperStep? = nil
	if not m.Tutorial then
		local pet, power = Profiles.huntHelper(data)
		step = if pet then HuntFun.helperStep(power) else nil
	end
	m.Helpers[uid] = step or false
	return step
end

-- Surprise eggs (shared/HuntFun.Surprise): one prize per ordinary egg, paid at once, plus a Lucky Meter point every
-- EggsPerMeter-th egg. Adds what to show to `out`.
local function surprise(m: any, p: Player, data: any, tierId: string, out: { HuntFun.Surprise })
	if not HuntFun.Surprise.Enabled or m.Tutorial then
		return
	end
	local s = HuntFun.surprise(surpriseRng, tierId)
	if s.Kind == "Coins" or s.Kind == "Jackpot" then
		data.Cash += s.Amount
	elseif s.Kind == "Xp" then
		if RockService.onPetXp then
			RockService.onPetXp(p, s.Amount)
		end
	end
	table.insert(out, s)
	local perks = EggPerks.sanitize(data.EggPerks)
	data.EggPerks = perks
	local count, tick = HuntFun.meterTick(perks.HuntEggs)
	perks.HuntEggs = count
	if tick and not EggPerks.full(perks.Meter) then
		perks.Meter = math.min(perks.Meter + 1, EggPerks.Meter.Need)
		table.insert(out, { Kind = "Meter", Amount = 1 })
	end
end

-- Entitlement: the tool / machine in a round must be one the profile owns and has equipped.
local function syncEntitlements(m: any, player: Player)
	local core = m.Core
	local mem = core.Members[player.UserId]
	local data = Profiles.get(player)
	if not mem or not data then
		return
	end
	local tool = data.EquippedHandheld
	if type(tool) == "string" and data.EquipmentOwned[tool] and mem.Tool ~= tool then
		core:setTool(player.UserId, tool)
	end
	if mem.Machine and not data.EquipmentOwned[mem.Machine] then
		core:setMachine(player.UserId, nil)
	end
end

local function reply(m: any, player: Player, action: string, ok: boolean, reason: string?, extra: { [string]: any }?)
	if reason == "TooFast" or reason == "StaleRound" then
		return -- silent: normal for held input and for requests that crossed a round change
	end
	local t = os.clock()
	if t - (lastReply[player] or 0) < REPLY_GAP then
		return
	end
	lastReply[player] = t
	local payload: { [string]: any } = { Round = m.Round, Action = action, Ok = ok, Reason = reason }
	if extra then
		for k, v in extra do
			payload[k] = v
		end
	end
	Net.event("MatchEvent"):FireClient(player, "RockReply", payload)
end

-- Pickup line of sight (SightRules, pure): a ray from the root part up to the head (so a head pushed into a wall is
-- caught), then from the head to just before the rock's shell. Characters,
-- decor (CameraIgnore), non-collidable and see-through parts are walked through, so only real world geometry refuses.
-- An arena with no geometry in the way passes. A cast that errors refuses the pick (fails closed) and warns once, so a
-- broken check shows up in the server log instead of quietly letting picks through walls.
local sightWarned = false
local function hasSight(m: any, char: Model, root: BasePart, rockLocal: Vector3, rockSize: number): boolean
	local head = char:FindFirstChild("Head") :: BasePart?
	local eye = SightRules.eye(root.Position, if head then head.Position else nil)
	local target = SightRules.target(eye, m.Arena.Center + rockLocal, rockSize)
	local skip: { Instance } = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(skip, p.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = skip
	params.IgnoreWater = true
	local ok, res = pcall(SightRules.clearFrom, root.Position, eye, target, function(origin: Vector3, dir: Vector3): SightRules.Hit?
		local hit = workspace:Raycast(origin, dir, params)
		if not hit then
			return nil
		end
		local inst = hit.Instance
		return {
			Distance = hit.Distance,
			Part = {
				CanCollide = inst.CanCollide,
				CameraIgnore = inst:GetAttribute("CameraIgnore") == true,
				Character = false,
				Transparency = inst.Transparency,
			},
		}
	end)
	if not ok then
		if not sightWarned then
			sightWarned = true
			warn("[RockService] line-of-sight check failed, pickup refused:", res)
		end
		return false
	end
	return res == true
end

-- Applies finished rocks to the profiles. Hits need nothing here (the event stream carries them).
function RockService.apply(m: any, results: { any })
	local core = m.Core
	local tier = Config.Tiers[core.Tier]
	-- Material discoveries from this batch, per player: told once at the end (a fast machine can finish
	-- many rocks in one step; the client never gets one message per rock).
	local news: { [number]: { string } } = {}
	local pops: { [number]: { HuntFun.Surprise } } = {} -- surprise eggs per player, sent once per batch
	-- One Profiles.changed per player per batch (it fans out to every listener), not one per egg; the profile is
	-- marked dirty all the same, so nothing is lost from the save.
	local touched: { [Player]: boolean } = {}
	local found: any = nil
	for _, r in results do
		if r.Kind == "Cracked" then
			local p = playerOf(r.UserId)
			local data = p and Profiles.get(p)
			if data then
				data.RubbleByTier[tier.Id] = (data.RubbleByTier[tier.Id] or 0) + 1
				HuntLedger.crushed(m.Ledger, r.UserId, true)
				data.Stats.RocksCracked += 1
				if RockService.onCracked then
					RockService.onCracked(p :: Player, false) -- the pets following them earn hunt XP (PvpService)
				end
				-- The material is decided by the core (Materials.pick) and only counted here, for the player who
				-- finished the rock; the key makes a repeated completion of the same rock a no-op.
				local counted, isNew = Profiles.recordMaterial(p :: Player, m.Key .. ":" .. m.Round .. ":" .. r.RockId, r.Material)
				if counted then
					if isNew then
						news[r.UserId] = news[r.UserId] or {}
						table.insert(news[r.UserId], r.Material)
					end
				end
				pops[r.UserId] = pops[r.UserId] or {}
				surprise(m, p :: Player, data, tier.Id, pops[r.UserId])
				touched[p :: Player] = true
				Profiles.onboard(p :: Player, "Cracked")
				EggEvents.cracked(m, r.UserId) -- maybe speed boots
			end
		elseif r.Kind == "Found" and found == nil then
			found = r -- handled after the loop, so the rest of the batch is still credited
		end
	end
	for p in touched do
		Profiles.changed(p, true)
	end
	-- One award per round, whatever path reports it (a late duplicate result is ignored).
	if found and m.FoundRound ~= m.Round then
		m.FoundRound = m.Round
		-- The finder's pet egg is an egg they finished too: the results (core Cracked) count it, so the quest stat does.
		local fp = playerOf(found.UserId)
		local fdata = fp and Profiles.get(fp)
		if fdata then
			fdata.Stats.RocksCracked += 1
			if RockService.onCracked then
				RockService.onCracked(fp :: Player, true)
			end
			Profiles.changed(fp :: Player, true)
		end
		HuntLedger.crushed(m.Ledger, found.UserId, false)
		RockService.flush(m)
		if foundHandler then
			foundHandler(m, found.UserId, found.RockId)
		end
	end
	for uid, list in pops do
		local p = playerOf(uid)
		local data = p and Profiles.get(p)
		if p and data and #list > 0 then
			Net.event("MatchEvent"):FireClient(p, "Surprise", { Round = m.Round, List = list, Meter = data.EggPerks.Meter, MeterNeed = EggPerks.Meter.Need, MeterEggs = data.EggPerks.HuntEggs, EggsPerMeter = HuntFun.Surprise.EggsPerMeter })
		end
	end
	for uid, list in news do
		local p = playerOf(uid)
		if p then
			Net.event("MatchEvent"):FireClient(p, "MaterialFound", { Round = m.Round, New = list })
		end
	end
end

-- One client intent. `m` is the caller's match (MatchService looked it up from its own tables).
function RockService.action(m: any, player: Player, action: any, roundId: any, rockId: any)
	if type(action) ~= "string" or not ACTIONS[action] or type(roundId) ~= "number" then
		return
	end
	local t = os.clock()
	if t - (lastAny[player] or 0) < MIN_GAP then
		return
	end
	lastAny[player] = t
	local core = m.Core
	if not core or roundId ~= m.Round or m.Phase ~= "Searching" or not m.Present[player.UserId] then
		return
	end
	local uid = player.UserId
	if action == "ToggleMachine" then
		if t - (lastToggle[player] or 0) < TOGGLE_GAP then
			return
		end
		lastToggle[player] = t
		local mem = core.Members[uid]
		if mem and mem.Active and mem.Machine then
			core:setMachineRunning(uid, not mem.Running, t)
		end
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then
		return
	end
	if motionLocked(uid, root.Position, hum.WalkSpeed, t) then
		return -- just teleported: ignored for a moment (Config.Motion); silent like other dropped input
	end
	local pos = root.Position - m.Arena.Center
	RockService.refreshSpace(m, uid)
	syncEntitlements(m, player)
	if action == "Pickup" then
		-- Line of sight only for a request the core would otherwise accept on range: a rock that is still in the
		-- pile (a taken rock keeps reporting Gone) and within reach of the player. The pick itself stays atomic in the core.
		if type(rockId) == "number" and core.Rocks[rockId] then
			local rl = core.Pile:localPosition(rockId)
			if rl and Vector2.new(rl.X - pos.X, rl.Z - pos.Z).Magnitude <= Config.Carry.PickupRange + core.Pile.RockSize * 0.5 then
				if Config.Carry.SightCheck ~= false and not hasSight(m, char :: Model, root, rl, core.Pile.RockSize) then
					reply(m, player, action, false, "NoSight")
					return
				end
			end
		end
		local err = core:pickup(uid, roundId, rockId, pos, t)
		if err then
			reply(m, player, action, false, err)
		else
			Profiles.onboard(player, "PickedUp")
		end
	elseif action == "Deposit" then
		local res, err = core:deposit(uid, roundId, pos, t)
		if res then
			Profiles.onboard(player, "Deposited")
			reply(m, player, action, true, nil, { Moved = #res.Moved, Left = res.Left, Queue = res.Queue })
		else
			reply(m, player, action, false, err)
		end
	elseif action == "Crush" then
		-- Machines first, up to this instant, so a hit never jumps ahead of a rock that finished earlier.
		RockService.apply(m, core:tickMachines(t))
		if m.Phase ~= "Searching" or core.Phase ~= "Searching" then
			return
		end
		local results, err = core:crush(uid, roundId, pos, t)
		if err then
			reply(m, player, action, false, err)
			if err == "StorageFull" and t - (m.FullWarned[uid] or 0) > 4 then
				m.FullWarned[uid] = t
				Net.event("Toast"):FireClient(player, "Candy bag full! Sell candy at the candy stand.", "warn")
			end
		else
			RockService.apply(m, results)
		end
	end
end

-- Scheduler step for one Searching match: machines, storage refresh, batched replication.
function RockService.step(m: any, t: number)
	local core = m.Core
	for uid in m.Present do
		RockService.refreshSpace(m, uid)
		sampleMotion(uid, t)
	end
	RockService.apply(m, core:tickMachines(t))
	if m.Phase == "Searching" and t - m.LastFlush >= 0.1 then
		m.LastFlush = t
		RockService.flush(m)
	end
end

-- Sends the batched rock events (ids only) with a fresh station snapshot and the shared counters.
function RockService.flush(m: any)
	local core = m.Core
	if not core then
		return
	end
	local ev = core:drainEvents()
	if #ev == 0 then
		return
	end
	local removed = {}
	for _, e in ev do
		if e.Kind == "Pick" then
			table.insert(removed, { e.Id, e.UserId }) -- legacy shape for the pre-V3 client view
		end
	end
	local payload = {
		Round = m.Round,
		Ev = ev,
		Removed = removed,
		Hits = {},
		Res = {},
		Stations = core:stationViews(os.clock()),
		Counts = core:counters(),
	}
	local remote = Net.event("MatchEvent")
	for uid in m.Present do
		local p = playerOf(uid)
		if p then
			remote:FireClient(p, "Rocks", payload)
		end
	end
end

-- A member leaves (return to lobby, disconnect): everything unresolved they hold goes back to the pile.
function RockService.leave(m: any, uid: number)
	motion[uid] = nil
	if m.Core then
		RockService.apply(m, m.Core:removeMember(uid, os.clock()))
		RockService.flush(m)
	end
end

-- A character respawn drops the basket back on the pile (the tray stays on the table).
function RockService.characterReset(m: any, uid: number)
	RockService.resetMotion(uid)
	if m.Core and m.Phase == "Searching" then
		if m.Core:dropCarried(uid) > 0 then
			RockService.flush(m)
		end
	end
end

-- The pile + station part of the Init / resync payload (ids and states only).
function RockService.initFields(m: any): { [string]: any }
	local core = m.Core
	local tables = {}
	for i = 1, Config.Station.Count do
		local cf = m.Arena.Tables and m.Arena.Tables[i] and m.Arena.Tables[i].PrimaryPart and m.Arena.Tables[i].PrimaryPart.CFrame
		local owner = 0
		for uid, mem in core.Members do
			if mem.Active and mem.Index == i then
				owner = uid
			end
		end
		table.insert(tables, { Index = i, Position = if cf then cf.Position else nil, Owner = owner })
	end
	return {
		Rocks = core.Total,
		MaxHp = core.MaxHp,
		Removed = core:removedIds(),
		Stacks = core.Pile:stacks(),
		Stations = core:stationViews(os.clock()),
		Tables = tables,
		Counts = core:counters(),
	}
end

function RockService.forget(player: Player)
	lastAny[player] = nil
	lastToggle[player] = nil
	lastReply[player] = nil
	motion[player.UserId] = nil
end

return RockService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="260">
        <Properties>
          <string name="Name">SkyIsland</string>
          <string name="Source"><![CDATA[--!strict
-- Pet Battle floating islands (carter 2026-10-14: "make a floating island. nobody will want to spectate the fights so
-- make them teleport to the small island"). Every fight claims its own island copy far up in the sky
-- (IslandRules.spot), the two fighters are moved onto it and back to the lobby after the result (PvpService).
-- The look: ServerStorage[PvpConfig.Island.Model] ("ArenaIsland", the owner's Blender model) is cloned when it
-- exists. Contract for that model: a Model with a part marked attribute ArenaCenter = true whose top face is the fight
-- floor (optional attribute FightRadius, default PvpConfig.Island.Radius), teams face each other along that part's X
-- axis. Without it a procedural stand-in is built (REPLACE: the owner's ArenaIsland): a round grass top, a rocky
-- underside, a few floating rocks, and invisible walls so nobody walks off.

local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PvpConfig = require(Shared.PvpConfig)
local IslandRules = require(Shared.IslandRules)

local SkyIsland = {}

export type Claim = { Slot: number, Model: Model, Origin: CFrame, Layout: any, Radius: number }

local free: { number } = {}
local used: { [number]: boolean } = {}
local folder: Folder? = nil

local GRASS = Color3.fromRGB(110, 200, 90)
local DIRT = Color3.fromRGB(150, 104, 70)
local ROCK = Color3.fromRGB(128, 118, 132)
local FLOOR = Color3.fromRGB(176, 146, 98) -- a natural sand path, not near-white under the lobby bloom

local function root(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "PetBattleIslands"
	f.Parent = Workspace
	folder = f
	return f
end

local function part(parent: Instance, name: string, shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- a Cylinder part lying flat (its axis pointing up)

-- REPLACE: the owner's ArenaIsland model (ServerStorage). Procedural stand-in, top face at `at`.
local function standIn(at: Vector3): Model
	local m = Instance.new("Model")
	m.Name = "ArenaIsland"
	local r = PvpConfig.Island.Radius
	local top = part(m, "Grass", Enum.PartType.Cylinder, Vector3.new(3, r * 2 + 6, r * 2 + 6), CFrame.new(at - Vector3.new(0, 1.5, 0)) * FLAT, GRASS, Enum.Material.Grass)
	top.CanCollide = true
	-- a sand strip down the middle where the pets fight, grass all round it
	part(m, "Strip", Enum.PartType.Block, Vector3.new(r * 1.5, 0.2, r * 0.9), CFrame.new(at + Vector3.new(0, 0.05, 0)), FLOOR, Enum.Material.Sand).CanCollide = false
	-- rocky underside: shrinking discs and a tip, a little off-centre so it looks hand made
	local y, w = -3, r * 2 + 2
	for i = 1, 5 do
		local h = 5 + i
		local off = Vector3.new(math.sin(i * 1.7) * i * 0.8, 0, math.cos(i * 2.3) * i * 0.8)
		part(m, "Underside" .. i, Enum.PartType.Cylinder, Vector3.new(h, w, w), CFrame.new(at + off + Vector3.new(0, y - h / 2, 0)) * FLAT, if i % 2 == 0 then ROCK else DIRT, Enum.Material.Slate).CanCollide = false
		y -= h - 1
		w *= 0.72
	end
	-- floating rocks around it
	for i = 1, 7 do
		local a = i * (math.pi * 2 / 7) + 0.4
		local d = r + 14 + (i % 3) * 6
		local s = 3 + (i % 3) * 2
		local rock = part(m, "FloatRock" .. i, Enum.PartType.Block, Vector3.new(s, s * 0.8, s * 1.1), CFrame.new(at + Vector3.new(math.cos(a) * d, -4 + (i % 4) * 5, math.sin(a) * d)) * CFrame.Angles(i, i * 0.7, i * 0.3), ROCK, Enum.Material.Slate)
		rock.CanCollide = false
	end
	-- invisible walls round the edge
	local n = 24
	for i = 1, n do
		local a = (i - 0.5) * (math.pi * 2 / n)
		local pos = at + Vector3.new(math.cos(a) * (r + 3), 8, math.sin(a) * (r + 3))
		local wall = part(m, "Wall", Enum.PartType.Block, Vector3.new(1, 18, (r + 3) * 2 * math.pi / n + 1), CFrame.lookAt(pos, at + Vector3.new(0, 8, 0)) * CFrame.Angles(0, math.rad(90), 0), ROCK)
		wall.Transparency = 1
		wall.CanQuery = false
	end
	-- the fight floor marker (hidden)
	local centre = part(m, "ArenaCenter", Enum.PartType.Block, Vector3.new(r * 2, 1, r * 2), CFrame.new(at - Vector3.new(0, 0.5, 0)), FLOOR)
	centre.Transparency = 1
	centre.CanCollide = false
	centre.CanQuery = false
	centre:SetAttribute("ArenaCenter", true)
	centre:SetAttribute("FightRadius", r)
	m.PrimaryPart = top
	return m
end

local function centreOf(m: Model): BasePart?
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("ArenaCenter") == true then
			return d
		end
	end
	return nil
end

-- An ArenaIsland without a marked fight floor still works: a ray straight down through the middle of the model finds
-- its top surface, and a hidden ArenaCenter part is added there (radius from the model's size, at most Island.Radius).
local function markFloor(m: Model): BasePart?
	local cf, size = m:GetBoundingBox()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { m }
	local hit = Workspace:Raycast(cf.Position + Vector3.new(0, size.Y, 0), Vector3.new(0, -size.Y * 2, 0), params)
	if not hit then
		return nil
	end
	local r = math.clamp(math.min(size.X, size.Z) / 2 - 4, 10, PvpConfig.Island.Radius)
	local c = part(m, "ArenaCenter", Enum.PartType.Block, Vector3.new(r * 2, 1, r * 2), CFrame.new(hit.Position - Vector3.new(0, 0.5, 0)), FLOOR)
	c.Transparency = 1
	c.CanCollide = false
	c.CanQuery = false
	c:SetAttribute("ArenaCenter", true)
	c:SetAttribute("FightRadius", r)
	return c
end

-- Claims an island for a new fight: its own copy at its own spot. Returns where the fight sits and its layout.
function SkyIsland.claim(): Claim
	local slot: number = table.remove(free, 1) or 0
	if slot == 0 then
		slot = 1
		while used[slot] do
			slot += 1
		end
	end
	used[slot] = true
	local at = IslandRules.spot(slot)
	local template = ServerStorage:FindFirstChild(PvpConfig.Island.Model)
	local m: Model? = nil
	if template and template:IsA("Model") then
		local copy = template:Clone()
		for _, d in copy:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true -- a floating island never falls
			end
		end
		-- move it out of the way first, then find (or mark) its fight floor and put the floor's top centre on the spot
		copy:PivotTo(CFrame.new(at) * copy:GetPivot().Rotation)
		copy.Parent = root()
		local c = centreOf(copy) or markFloor(copy)
		if c then
			local top = c.Position + Vector3.new(0, c.Size.Y / 2, 0)
			copy:PivotTo(copy:GetPivot() + (at - top))
			m = copy
		else
			warn("[SkyIsland] ArenaIsland has no floor to fight on (no ArenaCenter part, nothing under its middle); using the stand-in")
			copy:Destroy()
		end
	end
	local source = if m then "ArenaIsland" else "StandIn"
	if not m then
		m = standIn(at)
	end
	local island = m :: Model
	island:SetAttribute("IslandSource", source) -- Studio check: which island a fight got
	island.Name = "ArenaIsland_" .. slot
	island.Parent = root()
	local c = centreOf(island) :: BasePart
	local r = c:GetAttribute("FightRadius")
	local radius = if type(r) == "number" then r else PvpConfig.Island.Radius
	local origin, layoutName = IslandRules.origin(c.CFrame, c.Size, radius)
	return { Slot = slot, Model = island, Origin = origin, Layout = PvpConfig.Layouts[layoutName], Radius = radius }
end

function SkyIsland.free(slot: number, m: Model?)
	if m then
		m:Destroy()
	end
	if used[slot] then
		used[slot] = nil
		table.insert(free, slot)
		table.sort(free)
	end
end

-- Islands in use (tests).
function SkyIsland.count(): number
	local n = 0
	for _ in used do
		n += 1
	end
	return n
end

return SkyIsland
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="261">
        <Properties>
          <string name="Name">StationModels</string>
          <string name="Source"><![CDATA[--!strict
-- HATCH NESTS (was the crushing tables, V3 loop): four identical pastel nest stations: a round straw nest with a soft
-- cushion plate on a wooden stump table. (Original note: four identical steel work stations on a circle around the shared pile,
-- one per player slot. Procedural stand-ins in the chunky industrial style (REPLACE markers: swap
-- these builders for uploaded meshes named CT_Rocks_Station_<n> once art exists).
--
-- Table frame (local, y = 0 is the floor, the centre of the table is the origin):
--   -Z faces the pile: the player works on that side, +Z is the back (shield, sign, machine feed).
--   +X is the player's LEFT (input tray, basket dock), -X the player's RIGHT (output tray).
--   Size about 7 (X) x 4 (Z) x 3 (Y) studs, work surface top at y = 3.
--
-- Named parts and attachments the client uses (all anchored, none collide except frame + surface):
--   Plate            part    anvil / crushing plate; Attachment "Plate" on its top centre (y = 3.35; kit table 2.86)
--   InputTray        part    shallow tray; Attachments "Slot1".."Slot16" (queued rocks, slot 1 is the
--                            next to be crushed; 11..16 sit on top for the bigger nests) and "InputTray" (centre)
--   NestBase, NestStraw parts the nest ring round the plate: colour and material follow the owner's nest level
--                            (ProgressConfig.Nests: Straw, Wood, Stone, Gold; the names stay the same)
--   OutputTray       part    rubble tray; Attachment "OutputTray" (centre)
--   DockPad          part    basket dock shelf; Attachment "Dock" on top
--   Stand            part    invisible marker WORK_SPOT (4.2) studs in front; Attachment "Stand" (where the player
--                            works, camera framing target)
--   Feed             part    invisible marker at the back; Attachment "MachineFeed" (toward the machine bay)
--   Nameplate        part    SurfaceGui TextLabel "Name" (player name)
--   Sign             part    SurfaceGui TextLabel "Title" (station number / state)
--   Light            part    (kit tables only) status light; the Part nests have none (setOwner skips it)
-- Model attributes: StationIndex, Active (bool), OwnerId (number, 0 = nobody), SlotCount (tray slots built),
-- NestLevel (the look shown).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local RoundRocks = require(Shared.RoundRocks)
local KitModels = require(Shared.KitModels)
local KitPlace = require(script.Parent.KitPlace)
local LowPolyStation = require(script.Parent.LowPolyStation)
local ProgressConfig = require(Shared.ProgressConfig)
local WorldKit = require(Shared.WorldKit)
-- smooth Blender nest ring (Shared.EggKit + ReplicatedStorage.EggKitMeshes); nil = the old straw balls
local EggKit: any = nil
do
	local mod = Shared:FindFirstChild("EggKit")
	if mod and mod:IsA("ModuleScript") then
		local ok, m = pcall(require, mod)
		if ok then
			EggKit = m
		end
	end
end

local P = Config.Palette
local StationModels = {}

-- Where the player works, studs in front of the table centre (the plate is about the same distance). First person
-- (docs/m8/fp): at 3.2 the plate and rock filled a third of the view; from 4.2 the whole plate, both trays and the
-- hammer stroke fit calmly. The kit's own marker (4.95) is not used. Nothing enforces it: the server range is CrushRange.
local WORK_SPOT = 4.2
local STEEL = Color3.fromRGB(250, 240, 222)
local DARK = Color3.fromRGB(236, 196, 200)
local IRON = Color3.fromRGB(196, 146, 98) -- warm wood (the pale lilac read as plastic)
local RUBBER = Color3.fromRGB(150, 110, 84)
local WOOD = Color3.fromRGB(226, 170, 110)
local PLATE = Color3.fromRGB(255, 190, 208)
-- Restrained owner accents (small inset, tray stripe, sign border and name): warm orange, steel blue, sage
-- green, plum. No neon cyan / green / violet. ArenaBuilder uses the same list for the pad number inset.
local COLORS = {
	Color3.fromRGB(255, 160, 96),
	Color3.fromRGB(116, 180, 240),
	Color3.fromRGB(120, 210, 140),
	Color3.fromRGB(200, 150, 230),
}
StationModels.Accents = COLORS

-- Enough tray slots for the biggest nest upgrade (ProgressConfig.MaxQueue).
StationModels.SlotCount = math.max(Config.Station.QueueCapacity, ProgressConfig.MaxQueue)

local function mk(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, solid: boolean?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Shape = shape or Enum.PartType.Block
	p.Anchored = true
	p.CanCollide = solid == true
	p.CanQuery = solid == true
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- A bar from point a to point b (frame-local points are transformed by `base`).
local function beam(parent: Instance, name: string, base: CFrame, a: Vector3, b: Vector3, thick: number, color: Color3): Part
	local len = (b - a).Magnitude
	local cf = CFrame.lookAt(base:PointToWorldSpace(a), base:PointToWorldSpace(b)) * CFrame.new(0, 0, -len / 2)
	local p = mk(parent, name, Vector3.new(thick, thick, len), cf, color, Enum.Material.SmoothPlastic, false)
	return p
end

local function attach(p: BasePart, name: string, offset: Vector3): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = offset
	a.Parent = p
	return a
end

-- Lodge kit language (docs/lodge, ArenaKit.L): warm timber, dark iron, sign wood with cream letters, gold trim.
local LODGE_TIMBER = Color3.fromRGB(206, 138, 84)
local LODGE_TIMBER_LIGHT = Color3.fromRGB(234, 172, 112)
local LODGE_TIMBER_DARK = Color3.fromRGB(150, 96, 64)
local LODGE_IRON = Color3.fromRGB(124, 98, 90)
local LODGE_SIGN = Color3.fromRGB(172, 112, 72)
local LODGE_CHARCOAL = Color3.fromRGB(110, 82, 104)
local CREAM = Color3.fromRGB(246, 238, 220)
local IDLE_INK = Color3.fromRGB(236, 228, 214) -- idle plaque text: still 9:1 on the charcoal plate

-- Fitted text on the Front face of `p` (SignLayout via KitPlace.applyFit: explicit TextSize, never TextScaled) with the
-- sign attributes the numeric audit reads. `name` is the TextLabel's name (the client looks up "Name").
local function labelOn(p: BasePart, face: Enum.NormalId, name: string, text: string, color: Color3, bg: Color3?, preset: string?): TextLabel
	local w, h = p.Size.X, p.Size.Y
	local g = Instance.new("SurfaceGui")
	g.Name = "Label"
	g.Face = face
	g.LightInfluence = 0
	g.Parent = p
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundColor3 = bg or DARK
	t.BackgroundTransparency = if bg then 0 else 1
	t.TextColor3 = color
	t.Font = Enum.Font.FredokaOne
	t.Parent = g
	local f = KitPlace.applyFit(g, t, text, w, h, preset or "Plaque")
	p:SetAttribute("SignText", f.Text)
	p:SetAttribute("SignPreset", preset or "Plaque")
	p:SetAttribute("SignW", w)
	p:SetAttribute("SignH", h)
	return t
end

-- Re-fits a sign label after its text changed (setOwner): the size is recomputed for the new text.
local function refit(label: TextLabel, text: string)
	local g = label.Parent
	local p = g and g.Parent
	if not (g and g:IsA("SurfaceGui") and p and p:IsA("BasePart")) then
		label.Text = text
		return
	end
	local w, h = p:GetAttribute("SignW"), p:GetAttribute("SignH")
	local preset = p:GetAttribute("SignPreset")
	if type(w) == "number" and type(h) == "number" and type(preset) == "string" then
		local f = KitPlace.applyFit(g, label, text, w, h, preset)
		p:SetAttribute("SignText", f.Text)
	else
		label.Text = text
	end
end

-- The station sign: a framed lodge timber board on two timber posts at the BACK of the table, above the shield,
-- its face toward the work side (-Z) so it reads from the pile and from the work spot. Built as one object
-- (KitPlace.signBoard: face, frame and text together) in a Model named "Sign"; its label is named "Title".
-- Face 3.2 x 0.95 studs, centre 6.0 studs up: clear of the shield (top about 4.6) and of the machine bay behind.
local SIGN_W, SIGN_H, SIGN_Y, SIGN_Z = 3.2, 0.95, 6.0, 2.05
local function stationSign(m: Model, cf: CFrame, index: number, tint: Color3): BasePart
	for _, sx in { -1.55, 1.55 } do
		mk(m, "SignPost", Vector3.new(0.34, SIGN_Y + 0.1, 0.34), cf * CFrame.new(sx, (SIGN_Y + 0.1) / 2, SIGN_Z + 0.3), LODGE_TIMBER, Enum.Material.Wood, false)
	end
	local face, label = KitPlace.signBoard(m, "Sign", cf * CFrame.new(0, SIGN_Y, SIGN_Z) * CFrame.Angles(0, math.pi, 0), SIGN_W, SIGN_H, "NEST " .. index, "Plaque", {
		Face = LODGE_SIGN,
		Frame = LODGE_TIMBER_DARK,
		Ink = CREAM,
		Trim = tint,
		Depth = 0.3,
	})
	label.Name = "Title" -- the board model is "Sign" (setOwner finds the label under it); its face keeps the kit name "Face"
	-- the side rails are exactly as tall as the face, so on a table turned 45 degrees their top faces share a plane
	-- with the face's top (placement audit: z-fighting); 0.04 taller, they tuck into the top and bottom rails instead
	local board = face.Parent
	for _, n in { "RailL", "RailR" } do
		local r = board and board:FindFirstChild(n) :: BasePart?
		if r then
			r.Size += Vector3.new(0, 0.04, 0)
		end
	end
	return face
end

-- The owner's NestTable mesh (Shared.WorldKit, ReplicatedStorage.WorldKit_LowPoly) in place of the code-built table
-- body: legs, pads, rails, braces, work surface, edges, corner marks and the low bolts. Only those go: every named hook
-- part (Plate, InputTray + Slots, OutputTray, DockPad, Nameplate, Sign, Stand, Feed, NestBase/NestStraw, ColorStrip)
-- stays. The solid ones (Leg, Surface: the colliders, Surface is also the PrimaryPart the client frames on) turn
-- invisible and keep their collision; the rest are removed. The mesh is stretched to the old body box, 7 x 3 x 4
-- studs (its top = the work surface at y = 3, where the plate and trays sit), front (-Z) toward the pile like the table.
local TABLE_BODY = {
	Leg = true, RubberPad = true, RailX = true, RailLow = true, RailZ = true, Brace = true, Surface = true,
	SurfaceEdgeFront = true, SurfaceEdgeBack = true, CornerMark = true,
}
local TABLE_BOX = Vector3.new(7, 3, 4)
local function nestTable(m: Model, cf: CFrame)
	local mesh = if WorldKit.has("NestTable") then WorldKit.clone("NestTable", "NestTable") else nil
	if not mesh then
		return
	end
	for _, d in m:GetChildren() do
		if d:IsA("BasePart") then
			local y = cf:PointToObjectSpace(d.Position).Y
			if TABLE_BODY[d.Name] or (d.Name == "Bolt" and y < 3.1) then
				if d.CanCollide or d == m.PrimaryPart then
					d.Transparency = 1
					d.CastShadow = false
				else
					d:Destroy()
				end
			end
		end
	end
	mesh.Size = TABLE_BOX
	WorldKit.onFloor(mesh, cf)
	mesh.CastShadow = true
	mesh.Parent = m
	m:SetAttribute("NestTableMesh", true)
end

-- Builds one table from the Part stand-ins. `cf` = floor-level frame at the table centre, -Z toward the pile.
local function buildParts(index: number, cf: CFrame, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = "CT_Rocks_Station_" .. index
	m:SetAttribute("StationIndex", index)
	m:SetAttribute("Active", false)
	m:SetAttribute("OwnerId", 0)
	m.Parent = parent
	local function L(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	local tint = COLORS[index] or P.Orange

	-- legs, rubber pads, rails, diagonal braces
	for _, sx in { -3.1, 3.1 } do
		for _, sz in { -1.6, 1.6 } do
			mk(m, "Leg", Vector3.new(0.7, 2.5, 0.7), L(sx, 1.4, sz), LODGE_TIMBER, Enum.Material.Wood, true)
			mk(m, "RubberPad", Vector3.new(0.9, 0.15, 0.9), L(sx, 0.075, sz), RUBBER, Enum.Material.Rubber, false)
			mk(m, "Bolt", Vector3.new(0.18, 0.1, 0.18), L(sx, 0.2, sz), P.Yellow, Enum.Material.SmoothPlastic, false, Enum.PartType.Cylinder)
		end
	end
	for _, sz in { -1.6, 1.6 } do
		mk(m, "RailX", Vector3.new(6.2, 0.35, 0.35), L(0, 2.3, sz), LODGE_TIMBER_LIGHT, Enum.Material.Wood, false)
		mk(m, "RailLow", Vector3.new(6.2, 0.3, 0.3), L(0, 0.7, sz), IRON, Enum.Material.SmoothPlastic, false)
	end
	for _, sx in { -3.1, 3.1 } do
		-- 0.03 lower than RailX: the rails cross at the corners and equal tops z-fought (placement audit)
		mk(m, "RailZ", Vector3.new(0.35, 0.35, 3.2), L(sx, 2.27, 0), IRON, Enum.Material.SmoothPlastic, false)
		-- diagonal braces on both end frames
		beam(m, "Brace", cf, Vector3.new(sx, 0.7, -1.6), Vector3.new(sx, 2.3, 1.6), 0.22, DARK)
		beam(m, "Brace", cf, Vector3.new(sx, 0.7, 1.6), Vector3.new(sx, 2.3, -1.6), 0.22, DARK)
	end
	for _, sz in { -1.6, 1.6 } do
		beam(m, "Brace", cf, Vector3.new(-3.1, 0.7, sz), Vector3.new(3.1, 2.3, sz), 0.2, DARK)
	end

	-- thick worn work surface
	local top = mk(m, "Surface", Vector3.new(7, 0.5, 4), L(0, 2.75, 0), WOOD, Enum.Material.WoodPlanks, true)
	mk(m, "SurfaceEdgeFront", Vector3.new(7.1, 0.12, 0.2), L(0, 3.02, -1.95), DARK, Enum.Material.SmoothPlastic, false)
	mk(m, "SurfaceEdgeBack", Vector3.new(7.1, 0.12, 0.2), L(0, 3.02, 1.95), DARK, Enum.Material.SmoothPlastic, false)
	-- yellow corner marks (two bars per corner)
	for _, sx in { -3.3, 3.3 } do
		for _, sz in { -1.75, 1.75 } do
			mk(m, "CornerMark", Vector3.new(0.9, 0.05, 0.18), L(sx, 3.02, sz), P.Yellow, Enum.Material.SmoothPlastic, false)
			mk(m, "CornerMark", Vector3.new(0.18, 0.05, 0.9), L(sx, 3.02, sz), P.Yellow, Enum.Material.SmoothPlastic, false)
			mk(m, "Bolt", Vector3.new(0.2, 0.08, 0.2), L(sx - math.sign(sx) * 0.3, 3.03, sz - math.sign(sz) * 0.3), STEEL, Enum.Material.SmoothPlastic, false, Enum.PartType.Cylinder)
		end
	end

	-- anvil / crushing plate at the centre
	local plate = mk(m, "Plate", Vector3.new(1.9, 0.35, 1.9), L(0, 3.175, 0), PLATE, Enum.Material.Fabric, true)
	attach(plate, "Plate", Vector3.new(0, 0.175, 0))
	-- straw nest ring round the cushion plate (visual only). The owner's low-poly nest (LowPolyStation) when imported:
	-- same names, so setNestLevel still dresses it
	local lpBase, lpStraw = LowPolyStation.nestPieces()
	if lpBase and lpStraw then
		lpBase.Name = "NestBase"
		lpBase.CFrame = L(0, 3.03 + lpBase.Size.Y / 2, 0) * CFrame.Angles(0, math.pi, 0)
		lpBase.Parent = m
		lpStraw.Name = "NestStraw"
		lpStraw.CFrame = L(0, 3.03 + lpStraw.Size.Y / 2, 0) * CFrame.Angles(0, math.pi, 0)
		lpStraw.CastShadow = true
		lpStraw.Parent = m
	else
		mk(m, "NestBase", Vector3.new(0.12, 2.9, 2.9), L(0, 3.03, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(240, 208, 124), Enum.Material.SmoothPlastic, false, Enum.PartType.Cylinder)
	end
	local ring = (lpStraw == nil) and EggKit and EggKit.has("Nest_Ring") and EggKit.size("Nest_Ring")
	if ring then
		-- one woven straw ring mesh round the cushion plate (same name, so setNestLevel still dresses it)
		local k = 3.2 / ring.X
		local piece = EggKit.place(m, "Nest_Ring", "NestStraw", L(0, 3.0, 0), Vector3.new(k, k * 0.9, k), Color3.fromRGB(240, 204, 120), Enum.Material.SmoothPlastic)
		if piece then
			piece.CastShadow = true
		end
	end
	for k = 1, (if ring or lpStraw then 0 else 16) do
		local a = k / 16 * math.pi * 2
		local r = 1.28 + (k % 2) * 0.1
		local piece = mk(m, "NestStraw", Vector3.new(0.75, 0.5, 0.5), L(math.cos(a) * r, 3.22 + (k % 3) * 0.04, math.sin(a) * r) * CFrame.Angles(0, -a + math.pi / 2 + (k % 3) * 0.25, 0), Color3.fromRGB(246, 214, 128):Lerp(Color3.fromRGB(214, 170, 90), (k % 4) / 4), Enum.Material.SmoothPlastic, false, Enum.PartType.Ball)
		piece.Size = Vector3.new(0.9, 0.5, 0.55)
	end
	for _, sx in { -1, 1 } do
		mk(m, "PlateRim", Vector3.new(0.14, 0.18, 2.1), L(sx * 1.0, 3.44, 0), Color3.fromRGB(255, 222, 232), Enum.Material.SmoothPlastic, false)
		mk(m, "PlateRim", Vector3.new(2.1, 0.18, 0.14), L(0, 3.44, sx * 1.0), Color3.fromRGB(255, 222, 232), Enum.Material.SmoothPlastic, false)
		for _, sz in { -1, 1 } do
			mk(m, "Bolt", Vector3.new(0.2, 0.1, 0.2), L(sx * 0.78, 3.37, sz * 0.78), STEEL, Enum.Material.SmoothPlastic, false, Enum.PartType.Cylinder)
		end
	end

	-- input tray (player's left, +X): ten slots in two rows, slot 1 nearest the plate
	local input = mk(m, "InputTray", Vector3.new(1.9, 0.18, 3.2), L(2.4, 3.09, 0), DARK, Enum.Material.SmoothPlastic, false)
	for _, sx in { -1, 1 } do
		mk(m, "TrayWall", Vector3.new(0.12, 0.34, 3.3), L(2.4 + sx * 0.97, 3.26, 0), IRON, Enum.Material.SmoothPlastic, false)
	end
	for _, sz in { -1, 1 } do
		mk(m, "TrayWall", Vector3.new(2.0, 0.34, 0.12), L(2.4, 3.26, sz * 1.62), IRON, Enum.Material.SmoothPlastic, false)
	end
	attach(input, "InputTray", Vector3.new(0, 0.09, 0))
	for i = 1, StationModels.SlotCount do
		if i <= 10 then
			local row = (i - 1) % 2 -- 0 = row near the plate, 1 = outer row
			local col = (i - 1) // 2 -- 0..4 along Z, front to back
			local z = -1.2 + col * 0.6
			local x = if row == 0 then -0.42 else 0.42
			attach(input, "Slot" .. i, Vector3.new(x, 0.09 + 0.3, z))
		else
			-- bigger nests: a second layer resting between the two rows
			local z = -1.5 + (i - 11) * 0.6
			attach(input, "Slot" .. i, Vector3.new(0, 0.09 + 0.3 + 0.3, z))
		end
	end
	m:SetAttribute("SlotCount", StationModels.SlotCount)
	-- output tray (player's right, -X)
	local output = mk(m, "OutputTray", Vector3.new(1.9, 0.18, 3.2), L(-2.4, 3.09, 0), DARK, Enum.Material.SmoothPlastic, false)
	for _, sx in { -1, 1 } do
		mk(m, "TrayWall", Vector3.new(0.12, 0.3, 3.3), L(-2.4 + sx * 0.97, 3.24, 0), IRON, Enum.Material.SmoothPlastic, false)
	end
	for _, sz in { -1, 1 } do
		mk(m, "TrayWall", Vector3.new(2.0, 0.3, 0.12), L(-2.4, 3.24, sz * 1.62), IRON, Enum.Material.SmoothPlastic, false)
	end
	attach(output, "OutputTray", Vector3.new(0, 0.2, 0))

	-- basket dock: a bracketed shelf on the left end (the player's basket hangs here while they work)
	local dock = mk(m, "DockPad", Vector3.new(1.7, 0.25, 1.5), L(4.35, 1.5, -0.6), IRON, Enum.Material.SmoothPlastic, false)
	attach(dock, "Dock", Vector3.new(0, 0.125, 0))
	mk(m, "DockRim", Vector3.new(1.8, 0.06, 0.12), L(4.35, 1.65, -1.38), P.Yellow, Enum.Material.SmoothPlastic, false)
	beam(m, "DockBrace", cf, Vector3.new(3.4, 2.1, -0.6), Vector3.new(4.2, 1.4, -0.6), 0.2, DARK)
	mk(m, "DockPost", Vector3.new(0.2, 1.4, 0.2), L(5.1, 0.8, -1.2), DARK, Enum.Material.SmoothPlastic, false)

	-- tool rail at the back of the plate + tool hooks. (No glass pane any more: its Glass glare sat right behind the egg
	-- in the work view and in front of the NEST sign from the pile, owner video.)
	mk(m, "ShieldFrame", Vector3.new(3.6, 0.15, 0.2), L(0, 4.6, 1.7), DARK, Enum.Material.SmoothPlastic, false)
	for _, sx in { -1.8, 1.8 } do
		mk(m, "ShieldPost", Vector3.new(0.18, 1.7, 0.18), L(sx, 3.8, 1.7), DARK, Enum.Material.SmoothPlastic, false)
	end
	for _, sx in { -1.2, 1.2 } do
		mk(m, "ToolHook", Vector3.new(0.12, 0.12, 0.5), L(sx, 4.2, 1.45), STEEL, Enum.Material.SmoothPlastic, false)
		mk(m, "ToolHookTip", Vector3.new(0.12, 0.3, 0.12), L(sx, 4.05, 1.22), STEEL, Enum.Material.SmoothPlastic, false)
	end

	-- player colour strip + nameplate on the front edge
	mk(m, "ColorStrip", Vector3.new(7, 0.22, 0.12), L(0, 2.55, -2.04), tint, Enum.Material.SmoothPlastic, false)
	local name = mk(m, "Nameplate", Vector3.new(4.2, 0.7, 0.1), L(0, 2.3, -2.08), LODGE_CHARCOAL, Enum.Material.SmoothPlastic, false)
	labelOn(name, Enum.NormalId.Front, "Name", "NEST " .. index, IDLE_INK, LODGE_CHARCOAL, "Nameplate")

	-- readable sign on two posts at the back. No status lamp: the old one was a ball hanging in the air over the board
	-- (owner video: a green ball floating above the nest); the nameplate already shows who uses the nest.
	stationSign(m, cf, index, tint)

	-- invisible markers for the client (where to stand, where a machine feeds)
	local stand = mk(m, "Stand", Vector3.new(1, 0.2, 1), L(0, 0.1, -WORK_SPOT), P.Yellow, Enum.Material.SmoothPlastic, false)
	stand.Transparency = 1
	attach(stand, "Stand", Vector3.new(0, 0.1, 0))
	local feed = mk(m, "Feed", Vector3.new(1, 1, 1), L(0, 2.6, 2.4), P.Yellow, Enum.Material.SmoothPlastic, false)
	feed.Transparency = 1
	attach(feed, "MachineFeed", Vector3.zero)

	-- floor mark where the player works (yellow outline)
	for _, o in { Vector3.new(-1.6, 0, -3.2), Vector3.new(1.6, 0, -3.2) } do
		mk(m, "StandMark", Vector3.new(0.15, 0.04, 2.2), L(o.X, 0.03, o.Z), P.Yellow, Enum.Material.SmoothPlastic, false)
	end

	m.PrimaryPart = top
	nestTable(m, cf)
	return m
end

-- Kit version -------------------------------------------------------------------------------------
-- The same table assembled from the Blender kit meshes (docs/MODELING.md, Station_Assembled preview):
-- Station_Table with the anvil plate, input tray, rubble bin, shield and beacon at its attach points
-- and the sign beside it. The floor pad is a plain concrete slab built by ArenaBuilder (the kit's
-- hazard-striped Station_FloorPad is no longer used: owner colour and stripes competed with the work). The meshes are visual only; every part and
-- attachment the client and server use is rebuilt here as an invisible helper with the same name and
-- the same frame as in the Part version (Surface = PrimaryPart at y 2.75, Plate, InputTray with
-- Slot1..10, OutputTray, DockPad, Stand, Feed) plus the text carriers Nameplate and Sign and the
-- status Light (the beacon lens). Pieces of the Accent slot take the station colour.
-- (the kit Station_Sign is no longer placed: its 1.3 x 1.0 face was too small for readable text and its rock icon
-- stood in front of the text plate; the lodge timber board from stationSign replaces it)
local KIT_NEEDED = { "Station_Table", "Station_AnvilPlate", "Station_InputTray", "Station_RubbleBin", "Station_Shield", "Station_Beacon" }

function StationModels.kitAvailable(): boolean
	if true then
		return false -- the quarry-style kit table is not used for the hatch nests (REPLACE: real nest mesh)
	end
	for _, n in KIT_NEEDED do
		if not KitModels.template(n) then
			return false
		end
	end
	return true
end

-- Copies the MeshParts of a kit template into `m` at frame `at` (a kit model origin, scaled by `scale`).
-- Names get `prefix`; Accent pieces take `tint` and are tagged for the client; returns name -> part.
-- Palette pass (docs/BRIEF_V9_MASTER7_CORRECTIONS.md section 3): the kit meshes carry navy-black Slate / FrameDark
-- and cold blue-grey Frame colours that read black in the work view. Table, tray and bin frames become warm
-- wood, the rest warm charcoal; the Amber and Accent pieces are not touched.
local WOODEN_KITS = { Station_Table = true, Station_InputTray = true, Station_RubbleBin = true }
-- Lodge kit language (docs/lodge): the table, tray and bin bodies are lodge timber with darker timber grooves; every
-- frame, post, strap and rim is dark iron (so the table has a clean dark outline against the pale pad and the warm
-- floor, like the owner's quarry target); bolts a lighter iron. Plate steel, glass, lamp and accent are not touched.
local function warm(p: MeshPart, kitName: string)
	local n = string.match(p.Name, "_(.+)$") or p.Name
	local slot = string.match(n, "^([%a]+)") or n
	if slot == "Wood" then
		p.Color = if WOODEN_KITS[kitName] then LODGE_TIMBER else LODGE_TIMBER_LIGHT
		p.Material = Enum.Material.Wood
	elseif slot == "WoodDark" then
		p.Color = LODGE_TIMBER_DARK
		p.Material = Enum.Material.Wood
	elseif slot == "Frame" then
		p.Color = LODGE_IRON
		p.Material = Enum.Material.Metal
	elseif slot == "FrameDark" then
		p.Color = Color3.fromRGB(42, 44, 47)
	elseif slot == "Slate" then
		p.Color = Color3.fromRGB(70, 72, 76)
	elseif slot == "SteelLight" then
		p.Color = Color3.fromRGB(150, 148, 142)
	end
end

local function addKit(m: Model, kitName: string, prefix: string, at: CFrame, scale: number, tint: Color3, solidPiece: string?): { [string]: BasePart }
	local out: { [string]: BasePart } = {}
	local t = KitModels.template(kitName)
	if not t then
		return out
	end
	for _, src in t:GetChildren() do
		if src:IsA("MeshPart") then
			local p = src:Clone()
			for _, ch in p:GetChildren() do
				ch:Destroy()
			end
			p.Name = prefix .. "_" .. src.Name
			p.Size = src.Size * scale
			p.CFrame = at * CFrame.new(src.Position * scale) * src.CFrame.Rotation
			p.Anchored = true
			p.CanCollide = solidPiece == src.Name
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = src.Transparency < 0.5
			warm(p, kitName)
			if string.sub(src.Name, 1, 6) == "Accent" then
				p.Color = tint
				p:SetAttribute("AccentSlot", true)
			end
			p.Parent = m
			out[src.Name] = p
		end
	end
	return out
end

local function helper(parent: Instance, name: string, size: Vector3, cf: CFrame, solid: boolean): Part
	local p = mk(parent, name, size, cf, DARK, Enum.Material.SmoothPlastic, solid)
	p.Transparency = 1
	return p
end

local function buildKit(index: number, cf: CFrame, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = "CT_Rocks_Station_" .. index
	m:SetAttribute("StationIndex", index)
	m:SetAttribute("Active", false)
	m:SetAttribute("OwnerId", 0)
	m:SetAttribute("Kit", true)
	m.Parent = parent
	local function L(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	local tint = COLORS[index] or P.Orange
	local tableT = KitModels.template("Station_Table") :: Model
	local function pt(name: string): Vector3
		return KitModels.attach(tableT, name) or Vector3.zero
	end

	-- the floor pad, the table and the kit pieces on it
	addKit(m, "Station_Table", "Table", cf, 1, tint)
	local plateAt, trayAt, binAt = pt("Plate"), pt("InputTray"), pt("RubbleBin")
	-- First person (Master 7) was checked at the work spot: the eye is about 5 studs up and 3.2 back, so the rock on
	-- the plate (top about 4.4) is 10-20 degrees below a level gaze, inside the view and above the bottom HUD; a
	-- raised plate put the rock top at eye height and hid the hammer contact, so the height stays as it was.
	local plateKit = addKit(m, "Station_AnvilPlate", "Plate", cf * CFrame.new(plateAt), 1, tint)
	if plateKit.Amber then
		-- the hazard border is the table's one amber accent: kept, but muted so it does not shout over the rock
		plateKit.Amber.Color = Color3.fromRGB(176, 142, 86)
	end
	addKit(m, "Station_InputTray", "Tray", cf * CFrame.new(trayAt), 1, tint)
	local bin = addKit(m, "Station_RubbleBin", "Bin", cf * CFrame.new(binAt), 1, tint)
	if bin.Fill then
		bin.Fill:Destroy() -- the bin starts empty; the client drops rubble into it as rocks are crushed
	end
	addKit(m, "Station_Shield", "Shield", cf * CFrame.new(pt("Shield")), 1, tint)
	local beacon = addKit(m, "Station_Beacon", "Beacon", cf * CFrame.new(pt("Beacon")), 1, tint)

	-- invisible: the work surface (PrimaryPart, frame origin = 2.75 below its centre, the clients rely on it) and
	-- one solid body block under the kit table (top 2.5; replaces the four corner legs of the old table)
	local top = helper(m, "Surface", Vector3.new(7, 0.5, 4), L(0, 2.75, 0), false)
	helper(m, "TableBody", Vector3.new(7.2, 2.5, 3.5), L(0, 1.25, 0), true)

	-- anvil plate: the rock rests on the top (the AnvilPlate mesh is 0.36 high)
	local plate = helper(m, "Plate", Vector3.new(2.7, 0.36, 2.1), cf * CFrame.new(plateAt + Vector3.new(0, 0.18, 0)), true)
	attach(plate, "Plate", Vector3.new(0, 0.18, 0))

	-- input tray: ten slots in two rows of five, slot 1 nearest the plate (the tray is at +X)
	local trayFloor = 0.16 -- the kit tray's Slots attach height
	local input = helper(m, "InputTray", Vector3.new(2.2, 0.16, 1.75), cf * CFrame.new(trayAt + Vector3.new(0, 0.08, 0)), false)
	attach(input, "InputTray", Vector3.new(0, trayFloor - 0.08, 0))
	for i = 1, StationModels.SlotCount do
		if i <= 10 then
			local row = (i - 1) % 2
			local col = (i - 1) // 2
			local x = -0.84 + col * 0.42
			local z = if row == 0 then 0.3 else -0.3
			attach(input, "Slot" .. i, Vector3.new(x, trayFloor + 0.37 - 0.08, z)) -- a mini rock centre sits 0.12 above this
		else
			attach(input, "Slot" .. i, Vector3.new(-0.84 + (i - 11) * 0.336, trayFloor + 0.37 - 0.08 + 0.25, 0))
		end
	end
	m:SetAttribute("SlotCount", StationModels.SlotCount)

	-- rubble bin (the player's right, -X); the client spreads rubble over SpreadX x SpreadZ around it
	local output = helper(m, "OutputTray", Vector3.new(1.9, 0.1, 1.5), cf * CFrame.new(binAt), false)
	output:SetAttribute("SpreadX", 0.62)
	output:SetAttribute("SpreadZ", 0.45)
	attach(output, "OutputTray", Vector3.new(0, 0.3, 0))

	local dock = helper(m, "DockPad", Vector3.new(1.4, 0.2, 1.4), cf * CFrame.new(pt("Dock")), false)
	attach(dock, "Dock", Vector3.zero)
	local stand = helper(m, "Stand", Vector3.new(1, 0.2, 1), cf * CFrame.new(Vector3.new(0, 0.1, -WORK_SPOT)), false)
	attach(stand, "Stand", Vector3.new(0, 0.1, 0))
	local feed = helper(m, "Feed", Vector3.new(1, 1, 1), cf * CFrame.new(pt("MachineFeed")), false)
	attach(feed, "MachineFeed", Vector3.zero)

	-- nameplate over the table's front plaque, 3.4 x 0.74: the kit plaque (1.7 x 0.58) is too small for a name at a
	-- readable size (SignLayout's Nameplate minimum is 0.36 studs per em, which needs a 0.62+ stud tall plate and
	-- about 3 studs of width for a 12-letter name). It spans the front between the iron corner posts (inner edges at
	-- x = +-3.0), between the two straps (y 0.82 and 1.63), 0.05 in front of the posts' faces: nothing covers it.
	local np = pt("Nameplate")
	local name = mk(m, "Nameplate", Vector3.new(3.4, 0.74, 0.04), cf * CFrame.new(np.X, np.Y, np.Z - 0.03), LODGE_CHARCOAL, Enum.Material.SmoothPlastic, false)
	labelOn(name, Enum.NormalId.Front, "Name", "NEST " .. index, IDLE_INK, LODGE_CHARCOAL, "Nameplate")

	-- station sign: lodge timber board on posts behind the table (text faces the work side)
	stationSign(m, cf, index, tint)

	-- status light: the beacon lens (neon, blinks in the preview of the kit; here it just changes colour)
	local lens = beacon.Lens
	if lens then
		lens.Name = "Light"
		lens.Material = Enum.Material.Neon
		lens.Color = Color3.fromRGB(92, 98, 106)
		local pl = Instance.new("PointLight")
		pl.Range = 8
		pl.Brightness = 0.5
		pl.Color = lens.Color
		pl.Enabled = false
		pl.Parent = lens
	end

	m.PrimaryPart = top
	return m
end

-- Builds one table: from the kit meshes when they are loaded, else from Parts (identical contract).
function StationModels.build(index: number, cf: CFrame, parent: Instance): Model
	if StationModels.kitAvailable() then
		local ok, m = pcall(buildKit, index, cf, parent)
		if ok then
			return m
		end
		warn("[StationModels] kit table failed, using Parts: " .. tostring(m))
		local half = parent:FindFirstChild("CT_Rocks_Station_" .. index)
		if half then
			half:Destroy()
		end
	end
	return buildParts(index, cf, parent)
end

-- Dresses the nest ring (NestBase + NestStraw parts) in the look of nest level `level` (ProgressConfig.Nests).
-- Looks only; the tray size is enforced by the round core. REPLACE: real nest meshes per level.
function StationModels.setNestLevel(model: Model, level: number?)
	local nest = ProgressConfig.nest(level or 1)
	model:SetAttribute("NestLevel", ProgressConfig.clampLevel(level or 1, #ProgressConfig.Nests))
	local mat = (Enum.Material :: any)[nest.Material] or Enum.Material.SmoothPlastic
	local k = 0
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") then
			if d.Name == "NestBase" then
				d.Color = nest.Color
				d.Material = mat
			elseif d.Name == "NestStraw" then
				k += 1
				d.Color = nest.Color:Lerp(nest.Dark, (k % 4) / 4)
				d.Material = mat
				d.Reflectance = if nest.Id == "Gold" then 0.15 else 0
			end
		end
	end
end

-- Marks a table as used by `ownerName`. An unused table stays calm: no cover, no warning text, the same
-- table with a dim lamp, "TABLE n" on its plaque and a quiet grey sign (it can be used next hunt).
function StationModels.setOwner(model: Model, ownerId: number?, ownerName: string?)
	local active = ownerId ~= nil
	model:SetAttribute("Active", active)
	model:SetAttribute("OwnerId", ownerId or 0)
	-- the owner's nest level (EconomyService keeps the NestLevel player attribute); an unused nest is straw
	local owner = if ownerId then game:GetService("Players"):GetPlayerByUserId(ownerId) else nil
	local lvl = if owner then owner:GetAttribute("NestLevel") else nil
	StationModels.setNestLevel(model, if type(lvl) == "number" then lvl else 1)
	local index = (model:GetAttribute("StationIndex") or 1) :: number -- set as a number when the nest is built
	local tint = COLORS[index] or P.Orange
	local plate = model:FindFirstChild("Nameplate")
	local nameLabel = plate and plate:FindFirstChild("Name", true) :: TextLabel?
	if nameLabel then
		refit(nameLabel, if active then (ownerName or "Player") else "NEST " .. index)
		-- owner accent on the charcoal plate (all four accents are at least 5:1 there); idle text a calm light grey
		nameLabel.TextColor3 = if active then tint else IDLE_INK
	end
	local sign = model:FindFirstChild("Sign", true)
	local title = sign and sign:FindFirstChild("Title", true) :: TextLabel?
	if title then
		-- the sign always names the table; cream on sign wood reads in both states (the lamp shows "in use")
		refit(title, "NEST " .. index)
		title.TextColor3 = CREAM
	end
	local light = model:FindFirstChild("Light") :: Part?
	if light then
		-- a small, calm "in use" lamp (Master 7: fewer bright lamps): muted green, a faint short-range glow
		local c = if active then Color3.fromRGB(118, 168, 108) else Color3.fromRGB(92, 98, 106)
		light.Color = c
		light.Material = if active then Enum.Material.SmoothPlastic else light.Material
		local pl = light:FindFirstChildOfClass("PointLight")
		if pl then
			pl.Color = c
			pl.Brightness = 0.25
			pl.Range = 5
			pl.Enabled = active
		end
	end
end

-- Table frames for one arena: centre `c`, one per station index, facing the pile.
-- `floorY` lifts the tables onto the top of their concrete pads (ArenaBuilder passes the pad height), so the
-- feet stand on the slab instead of 0.3 studs inside it (placement audit).
function StationModels.buildAll(c: Vector3, parent: Instance, floorY: number?): { Model }
	local out = {}
	local lift = floorY or 0
	for i = 1, Config.Station.Count do
		local rel = RoundRocks.stationPosition(i)
		local pos = Vector3.new(c.X + rel.X, c.Y + lift, c.Z + rel.Z)
		local cf = CFrame.lookAt(pos, Vector3.new(c.X, c.Y + lift, c.Z))
		local m = StationModels.build(i, cf, parent)
		StationModels.setOwner(m, nil, nil)
		table.insert(out, m)
	end
	return out
end

return StationModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="262">
        <Properties>
          <string name="Name">StoreService</string>
          <string name="Source"><![CDATA[--!strict
-- Cosmetic Robux store (brief section 15: cosmetics only, never power). Owned cosmetics live in
-- the profile (Cosmetics.Owned); equipping only changes colours (tool skin, gallery alcove theme).
--
-- Purchases: the client names a cosmetic id, the server checks it is a visible catalogue entry
-- (ProductId > 0) the player does not own yet and opens the Roblox purchase prompt. Nothing is
-- granted by the prompt: the grant happens in MarketplaceService.ProcessReceipt, keyed by the
-- receipt's PurchaseId (stored in the profile, so a retried or replayed receipt never grants
-- twice) and the receipt is only answered PurchaseGranted after the profile is saved. With
-- every ProductId at 0 nothing here is reachable and the game works without the store.
-- NOT tested against real purchases (needs product ids from the owner and a Studio/live test).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Cosmetics = require(Shared.Cosmetics)
local Profiles = require(script.Parent.Profiles)
local Economy = require(script.Parent.EconomyService)
local Gallery = require(script.Parent.GalleryService)

local Store = {}

local RECEIPTS_KEPT = 300

local function toast(player: Player, text: string, kind: string?)
	Net.event("Toast"):FireClient(player, text, kind or "info")
end

-- Called by Roblox when a Developer Product purchase completes (possibly several times for the
-- same receipt, possibly after a rejoin). Pure of side effects when already granted.
-- Other services that sell developer products (tower revive, Robux eggs) register a route here. A route returns a
-- decision when the product is its own, or nil to pass. Only one ProcessReceipt callback can exist per server.
type Receipt = { PlayerId: number, PurchaseId: string, ProductId: number }
local routes: { (Receipt) -> Enum.ProductPurchaseDecision? } = {}
function Store.addReceiptRoute(fn: (Receipt) -> Enum.ProductPurchaseDecision?)
	table.insert(routes, fn)
end

function Store.processReceipt(info: Receipt): Enum.ProductPurchaseDecision
	if info.ProductId > 0 then
		for _, route in routes do
			local decision = route(info)
			if decision ~= nil then
				return decision
			end
		end
	end
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- granted when they rejoin
	end
	local data = Profiles.get(player)
	if not data or Profiles.isReleased(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- retried after the player is back with a live profile
	end
	local entry = Cosmetics.byProductId(info.ProductId)
	if not entry then
		warn("[Store] receipt for unknown product", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local key = tostring(info.PurchaseId)
	local state = data.Cosmetics
	local fresh = not state.Receipts[key]
	if fresh then
		state.Owned[entry.Id] = true
		Cosmetics.rememberReceipt(state, key, RECEIPTS_KEPT)
		Profiles.changed(player, true)
	end
	-- Granted only once it is saved; a failed save is answered "not yet" and retried by Roblox.
	if not Profiles.saveNow(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if fresh then
		toast(player, "Unlocked " .. entry.Name .. "! Equip it in the Store tab.", "ok")
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function handle(player: Player, action: any, arg: any)
	local data = Profiles.get(player)
	if not data or Profiles.isReleased(player) or type(action) ~= "string" then
		return
	end
	local state = data.Cosmetics
	if action == "Buy" then
		local entry = Cosmetics.get(arg)
		if not entry or not Cosmetics.visible(entry) then
			return
		end
		if Cosmetics.owned(state, entry.Id) then
			toast(player, "You already own " .. entry.Name .. ".", "info")
			return
		end
		pcall(function()
			MarketplaceService:PromptProductPurchase(player, entry.ProductId)
		end)
	elseif action == "Equip" then
		local entry = Cosmetics.get(arg)
		if not entry or not Cosmetics.visible(entry) or not Cosmetics.owned(state, entry.Id) then
			return
		end
		if state.Equipped[entry.Kind] == entry.Id then
			return
		end
		state.Equipped[entry.Kind] = entry.Id
		Profiles.changed(player, true)
		if entry.Kind == "ToolSkin" then
			Economy.attachTool(player)
		else
			Gallery.render(player)
		end
	elseif action == "Unequip" then
		local kind = if type(arg) == "string" then arg else ""
		if (kind ~= "ToolSkin" and kind ~= "GalleryTheme") or state.Equipped[kind] == nil then
			return
		end
		state.Equipped[kind] = nil
		Profiles.changed(player, true)
		if kind == "ToolSkin" then
			Economy.attachTool(player)
		else
			Gallery.render(player)
		end
	end
end

function Store.start()
	local last: { [Player]: number } = {}
	Players.PlayerRemoving:Connect(function(p)
		last[p] = nil
	end)
	Net.event("StoreAction").OnServerEvent:Connect(function(player, action, arg)
		local t = os.clock()
		if last[player] and t - last[player] < 0.4 then
			return
		end
		last[player] = t
		handle(player, action, arg)
	end)
	MarketplaceService.ProcessReceipt = function(info)
		local ok, result = pcall(Store.processReceipt, info)
		if ok then
			return result
		end
		warn("[Store] receipt failed", result)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
end

return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="263">
        <Properties>
          <string name="Name">Tickets</string>
          <string name="Source"><![CDATA[--!strict
-- Match tickets in MemoryStore (shared by the Lobby and Match servers of this experience).
-- Key = the reserved server's PrivateServerId, so the Match server finds its ticket from a value
-- only Roblox gives it, never from teleport data. Entries expire by themselves.
-- All calls are pcall-wrapped with a few bounded retries; a store outage means "no ticket"
-- (the Match server then refuses everyone safely) and never a made-up ticket.

local MemoryStoreService = game:GetService("MemoryStoreService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local MatchTicket = require(Shared.MatchTicket)

local Tickets = {}

local map: any = nil
local mapOk = pcall(function()
	map = MemoryStoreService:GetHashMap("CTR_Tickets_v1")
end)

local function ttl(): number
	return Config.Teleport.TicketSeconds + 600
end

-- Lobby: store a new ticket. Returns true when it is readable by the Match server.
function Tickets.put(ticket: MatchTicket.Ticket): (boolean, string?)
	if not mapOk or not map then
		return false, "MemoryStore unavailable"
	end
	local lastErr = "unknown"
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			map:SetAsync(ticket.Id, ticket, ttl())
		end)
		if ok then
			return true, nil
		end
		lastErr = tostring(err)
		task.wait(attempt)
	end
	return false, lastErr
end

-- Match: read the ticket for this reserved server. nil = none (or the store failed).
function Tickets.get(id: string): (MatchTicket.Ticket?, string?)
	if not mapOk or not map or id == "" then
		return nil, "MemoryStore unavailable"
	end
	local lastErr = "unknown"
	for attempt = 1, 5 do
		local ok, value = pcall(function()
			return map:GetAsync(id)
		end)
		if ok then
			if type(value) == "table" and type(value.Members) == "table" and type(value.Leader) == "number" then
				return value :: MatchTicket.Ticket, nil
			end
			-- not there (yet): the lobby writes the ticket just before the teleport, so retry a bit
			lastErr = "no ticket"
		else
			lastErr = tostring(value)
		end
		task.wait(attempt)
	end
	return nil, lastErr
end

-- Match: mark the ticket used up so a fresh server on the same reservation starts nothing new.
function Tickets.consume(id: string)
	if not mapOk or not map or id == "" then
		return
	end
	for attempt = 1, 3 do
		local ok = pcall(function()
			map:UpdateAsync(id, function(old: any): any
				if type(old) ~= "table" then
					return nil
				end
				old.Consumed = true
				return old
			end, ttl())
		end)
		if ok then
			return
		end
		task.wait(attempt)
	end
end

return Tickets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="264">
        <Properties>
          <string name="Name">TopStatues</string>
          <string name="Source"><![CDATA[--!strict
-- Statues of the top 3 players (idea 38, owner pick 2026-10-15). Lobby only. Each pedestal is a BasePart with
-- attribute TopStatue = 1, 2 or 3 (placed in Studio; with none in the map nothing is built). On it stands that rank's
-- real Roblox avatar from the STRONGEST PET board (LeaderboardService "Power"), frozen in place and scaled up
-- (1st biggest), with a "#1 Name / power" sign. Rebuilt when the board's top 3 changes. Nothing is invented: an empty
-- or unreadable board leaves the pedestal empty.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Leaderboards = require(script.Parent.LeaderboardService)
local StandRules = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").StandRules)

local TopStatues = {}

local BOARD = "Power"
local SCALE = { 1.7, 1.5, 1.35 }
local COLOR = { Color3.fromRGB(255, 205, 60), Color3.fromRGB(215, 225, 240), Color3.fromRGB(230, 150, 90) }

local shown: { [number]: number } = {} -- rank -> user id on the pedestal now

local function pedestals(): { [number]: BasePart }
	local out = {}
	for _, d in Workspace:GetDescendants() do
		if d:IsA("BasePart") then
			local r = d:GetAttribute("TopStatue")
			if type(r) == "number" and r >= 1 and r <= 3 and not out[r] then
				out[math.floor(r)] = d
			end
		end
	end
	return out
end

local function sign(model: Model, rank: number, name: string, text: string)
	local head = model:FindFirstChild("Head")
	if not (head and head:IsA("BasePart")) then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "StatueSign"
	bb.Size = UDim2.fromOffset(220, 56)
	bb.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y + 1.6, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	local function line(t: string, y: number, h: number, color: Color3)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, 0, h)
		l.Position = UDim2.fromOffset(0, y)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = t
		l.TextColor3 = color
		l.TextStrokeTransparency = 0
		l.TextStrokeColor3 = Color3.fromRGB(40, 30, 20)
		l.Parent = bb
	end
	line("#" .. rank .. " " .. name, 0, 30, COLOR[rank])
	line(text, 30, 24, Color3.new(1, 1, 1))
	bb.Parent = head
end

local function place(rank: number, pad: BasePart, row: Leaderboards.Row)
	local old = pad:FindFirstChild("TopStatueModel")
	if old then
		old:Destroy()
	end
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromUserId(row.UserId)
	end)
	if not (ok and model) then
		warn("[TopStatues] avatar failed for rank", rank, model)
		return
	end
	model.Name = "TopStatueModel"
	-- Studio 2026-10-15: anchoring every part before the model was in the world left the avatar without joints (the
	-- rig is built when it is parented), so PivotTo moved only the root and head and the limbs stayed behind 40 studs
	-- away. Now: only the root anchored, parented first so the joints build, then scaled, stood up, and frozen.
	local root = model:FindFirstChild("HumanoidRootPart")
	for _, d in model:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = d == root
			d.CanCollide = false
			d.CanTouch = false
		end
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end
	model:PivotTo(CFrame.new(pad.Position + Vector3.new(0, 10, 0)))
	model.Parent = pad
	task.wait(0.3)
	pcall(function()
		model:ScaleTo(SCALE[rank])
	end)
	-- stand it upright first (a fresh avatar can come in tilted)
	local p0 = model:GetPivot()
	model:PivotTo(CFrame.lookAt(p0.Position, p0.Position + StandRules.facing(p0)))
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	-- feet on the pedestal top, measured on the VISIBLE parts (an invisible part sat 2.6 studs under the feet)
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 0.99 then
			local c, s = d.CFrame, d.Size / 2
			local e = Vector3.new(
				math.abs(c.RightVector.X) * s.X + math.abs(c.UpVector.X) * s.Y + math.abs(c.LookVector.X) * s.Z,
				math.abs(c.RightVector.Y) * s.X + math.abs(c.UpVector.Y) * s.Y + math.abs(c.LookVector.Y) * s.Z,
				math.abs(c.RightVector.Z) * s.X + math.abs(c.UpVector.Z) * s.Y + math.abs(c.LookVector.Z) * s.Z
			)
			lo = lo:Min(c.Position - e)
			hi = hi:Max(c.Position + e)
		end
	end
	if lo.Y < math.huge then
		model:PivotTo(StandRules.onTop(pad.CFrame, pad.Size, model:GetPivot(), CFrame.new((lo + hi) / 2), hi - lo))
	end
	sign(model, rank, row.Name, row.Text)
end

local function refresh()
	local state = Leaderboards.get(BOARD)
	if state.Status ~= "ok" then
		return
	end
	local pads = pedestals()
	for rank = 1, 3 do
		local pad = pads[rank]
		local row = state.Rows[rank]
		if pad and row and shown[rank] ~= row.UserId then
			shown[rank] = row.UserId
			task.spawn(place, rank, pad, row)
		end
	end
end

function TopStatues.start()
	Leaderboards.onUpdated(function(board)
		if board == BOARD then
			refresh()
		end
	end)
	task.delay(5, refresh)
end

return TopStatues
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="265">
        <Properties>
          <string name="Name">Tower</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Pet Tower boot (its own Script so Main.server.luau stays untouched). See TowerService.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TowerConfig = require(Shared.TowerConfig)
local TowerService = require(script.Parent.TowerService)

TowerService.start()
-- StoreService owns MarketplaceService.ProcessReceipt; the revive product is routed here.
require(script.Parent.StoreService).addReceiptRoute(function(info)
	if info.ProductId > 0 and info.ProductId == TowerConfig.Revive.ProductId then
		return TowerService.processReceipt(info)
	end
	return nil
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="266">
        <Properties>
          <string name="Name">TowerAuraFx</string>
          <string name="Source"><![CDATA[--!strict
-- Pet Tower aura: glowing flame curtains that hug the temple (ParkBuilder buildTower). The temple's outline is found by
-- raycasting it from outside in a ring; each outline segment gets one vertical Beam whose height follows the temple's
-- roof line there. The flame texture scrolls upward (Beam.TextureSpeed), so the glow flows by itself on every client:
-- no script runs, nothing replicates per frame. Additive light (LightEmission 1), so see-through layers never flicker.

local TowerAuraFx = {}

local FLAME = "rbxassetid://127854632157422" -- tileable soft flame streaks (white, alpha), made for this aura
local COLOR = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(90, 255, 140)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 230, 200)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 140, 255)),
})

-- Builds the aura around `gate` (anchored Model with query-able parts) standing on ground height `groundY`.
function TowerAuraFx.build(gate: Model, groundY: number, steps: number?): Folder
	local n = steps or 30
	local box, ext = gate:GetBoundingBox()
	local centre = Vector3.new(box.Position.X, groundY, box.Position.Z)
	local far = math.max(ext.X, ext.Z) + 20
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { gate }

	local folder = Instance.new("Folder")
	folder.Name = "TowerAuraFx"
	local anchor = Instance.new("Part")
	anchor.Name = "AuraAnchor"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new()
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor:SetAttribute("CameraIgnore", true)
	anchor.Parent = folder

	-- outline: hit points at knee height, pushed out a little; roof height just inside each point
	local pts: { Vector3 } = {}
	local tops: { number } = {}
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local from = centre + dir * far + Vector3.new(0, 2.5, 0)
		local hit = workspace:Raycast(from, -dir * far, params)
		local p = if hit then hit.Position + dir * 1.4 else centre + dir * (math.max(ext.X, ext.Z) / 2 + 1.4) + Vector3.new(0, 2.5, 0)
		-- roof line: the highest point of the temple within a few studs inside this spot
		local top = groundY + 4
		for _, depth in { 2, 5, 9 } do
			local inner = p - dir * depth
			local down = workspace:Raycast(Vector3.new(inner.X, box.Position.Y + ext.Y, inner.Z), Vector3.new(0, -ext.Y * 2 - 10, 0), params)
			if down then
				top = math.max(top, down.Position.Y - depth * 0.6)
			end
		end
		table.insert(pts, Vector3.new(p.X, groundY + 0.2, p.Z))
		table.insert(tops, math.max(top + 5, groundY + 9))
	end

	for i = 1, n do
		local p0, p1 = pts[i], pts[i % n + 1]
		local mid = (p0 + p1) / 2
		local along = p1 - p0
		if along.Magnitude < 0.05 then
			continue
		end
		local h = (tops[i] + tops[i % n + 1]) / 2 - groundY
		local out = (mid - centre) * Vector3.new(1, 0, 1)
		local up = Vector3.yAxis
		-- attachment frame: a Beam spreads its width along the attachments' Y axis, so Y runs along the outline
		local frame = CFrame.fromMatrix(Vector3.zero, up, along.Unit)
		local a0 = Instance.new("Attachment")
		a0.Name = "AuraLow" .. i
		a0.CFrame = CFrame.new(mid) * frame
		a0.Parent = anchor
		local a1 = Instance.new("Attachment")
		a1.Name = "AuraHigh" .. i
		a1.CFrame = CFrame.new(mid + Vector3.new(0, h, 0)) * frame
		a1.Parent = anchor
		local b = Instance.new("Beam")
		b.Name = "AuraFlame" .. i
		b.Attachment0 = a0
		b.Attachment1 = a1
		b.FaceCamera = false
		b.Segments = 1
		b.Width0 = along.Magnitude * 1.25
		b.Width1 = along.Magnitude * 1.1
		b.Texture = FLAME
		b.TextureMode = Enum.TextureMode.Wrap
		b.TextureLength = 9
		b.TextureSpeed = 0.35 + (i % 3) * 0.06
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Brightness = 2.2
		b.Color = COLOR
		b.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.4),
			NumberSequenceKeypoint.new(0.4, 0.6),
			NumberSequenceKeypoint.new(1, 1),
		})
		b.ZOffset = 0
		b.Parent = anchor
		local _ = out
	end
	return folder
end

return TowerAuraFx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="267">
        <Properties>
          <string name="Name">TowerBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Pet Tower arenas: one fighting floor per run, far from the lobby and the egg arenas. Players stand on the
-- south side (-Z), pets line up in front of them, mobs come from the north side (+Z). Invisible walls keep
-- everyone on the floor; a plain invisible floor part does the colliding.
-- Look: when the owner's Blender kit is imported (ServerStorage "TowerRoomKit" + the TowerRoomKit module), each floor
-- is a square stone tower room built from it (walls, pillars, the glowing door arch on the mob side, banners,
-- braziers) and recoloured per theme. Without the kit, a tidy procedural stand-in (stone columns, low theme
-- dressing) is built instead.

local Workspace = game:GetService("Workspace")

local TowerRoomKit = require(script.Parent.TowerRoomKit)
local TowerPropSlots = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").TowerPropSlots)

local TowerBuilder = {}

local BASE = Vector3.new(4000, 300, 0) -- far from the lodge (origin) and the hunt arenas
local SPACING = 300
local RADIUS = 34
local ROOM = 48 -- half width of the kit room: 3 x 3 floor tiles of 32 studs
local TILE = 32
local free: { number } = {}
local used: { [number]: boolean } = {}
local folder: Folder? = nil

local COL = {
	Floor = Color3.fromRGB(196, 214, 150),
	Ring = Color3.fromRGB(246, 214, 120),
	Stone = Color3.fromRGB(176, 168, 190),
	Pillar = Color3.fromRGB(160, 132, 210),
	Cap = Color3.fromRGB(255, 196, 120),
	MobSide = Color3.fromRGB(255, 160, 150),
}

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

local function root(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "PetTower"
	f.Parent = Workspace
	folder = f
	return f
end

-- The kit room (owner's Blender TowerRoomKit). Pieces sit on y = 0 with their front on +Z, so each wall-side piece
-- is turned to face the room centre. Visual only (nothing collides); the fighting area in the middle stays clear.
local function kitRoom(m: Model, origin: CFrame): boolean
	for _, need in { "TR_Floor", "TR_Wall", "TR_Pillar", "TR_Arch" } do
		if not TowerRoomKit.has(need) then
			return false
		end
	end
	local room = Instance.new("Model")
	room.Name = "Room"
	local function put(name: string, label: string, cf: CFrame, scale: number?)
		if TowerRoomKit.has(name) then
			TowerRoomKit.place(room, name, label, cf, scale or 1)
		end
	end
	-- a spot (x, y, z) in arena space, turned so its front (+Z) looks at the room centre
	local function facing(x: number, y: number, z: number): CFrame
		local pos = origin * Vector3.new(x, y, z)
		local centre = origin * Vector3.new(0, y, 0)
		return CFrame.lookAt(pos, pos - (centre - pos))
	end
	for ix = -1, 1 do
		for iz = -1, 1 do
			put("TR_Floor", "Tile", origin * CFrame.new(ix * TILE, -TowerRoomKit.size("TR_Floor").Y, iz * TILE))
		end
	end
	-- a stone skirt under the walls: the gap between the floor tiles and the wall bases showed the sky
	do
		local skirt = Instance.new("Part")
		skirt.Name = "Stone"
		-- from 2 studs under the tiles up to just under their top face, so nothing shows between it and the wall bases
		local floorY = TowerRoomKit.size("TR_Floor").Y
		skirt.Size = Vector3.new(2 * ROOM + 40, floorY + 2, 2 * ROOM + 40)
		skirt.CFrame = origin * CFrame.new(0, -0.05 - (floorY + 2) / 2, 0)
		skirt.Color = Color3.fromRGB(120, 116, 110)
		skirt.Material = Enum.Material.SmoothPlastic
		skirt.Anchored = true
		skirt.CanCollide = false
		skirt.CanQuery = false
		skirt.CanTouch = false
		skirt.Parent = room
	end
	local depth = TowerRoomKit.size("TR_Wall").Z
	local edge = ROOM + depth / 2
	for k = -1, 1 do
		local along = k * TILE
		put("TR_Wall", "WallN", facing(along, 0, edge))
		put("TR_Wall", "WallS", facing(along, 0, -edge))
		put("TR_Wall", "WallE", facing(edge, 0, along))
		put("TR_Wall", "WallW", facing(-edge, 0, along))
	end
	-- corner posts: the wall ring left a sky gap where two walls meet behind the corner pillar
	do
		local corner = Instance.new("Model")
		corner.Name = "Corner"
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				local post = Instance.new("Part")
				post.Name = "Stone"
				post.Size = Vector3.new(depth + 1, 30, depth + 1)
				post.CFrame = origin * CFrame.new(sx * edge, 9, sz * edge) -- down past the skirt
				post.Color = Color3.fromRGB(236, 230, 243)
				post.Material = Enum.Material.SmoothPlastic
				post.Anchored = true
				post.CanCollide = false
				post.CanQuery = false
				post.CanTouch = false
				post.Parent = corner
			end
		end
		corner.Parent = room
	end
	for _, a in { -ROOM, -TILE / 2, TILE / 2, ROOM } do
		put("TR_Pillar", "Pillar", facing(a, 0, edge))
		put("TR_Pillar", "Pillar", facing(a, 0, -edge))
		if math.abs(a) < ROOM then
			put("TR_Pillar", "Pillar", facing(edge, 0, a))
			put("TR_Pillar", "Pillar", facing(-edge, 0, a))
		end
	end
	-- the mobs' door: the glowing arch in the middle of the north wall
	put("TR_Arch", "Door", facing(0, 0, ROOM - TowerRoomKit.size("TR_Arch").Z / 2))
	-- the owner's low-poly door frame and door (IMPORT_NOW5, ServerStorage.LowPolyLib) in that arch, sized to its opening,
	-- flush with its front; static (the mobs walk out of the room's middle, not through the door)
	do
		local lib = game:GetService("ServerStorage"):FindFirstChild("LowPolyLib")
		local arch = TowerRoomKit.size("TR_Arch")
		local at = facing(0, 0, ROOM - arch.Z - 0.4)
		for _, name in { "TowerDoorFrame_LowPoly", "TowerDoor_LowPoly" } do
			local src = lib and lib:FindFirstChild(name)
			local mp = src and src:FindFirstChildWhichIsA("MeshPart", true)
			if mp then
				local p = mp:Clone()
				p.Name = name
				p.Size = mp.Size * (arch.X * 0.75 / 8.4) -- the frame (8.4 wide) fills three quarters of the arch width
				p.CFrame = at * CFrame.new(0, p.Size.Y / 2, 0) * CFrame.Angles(0, math.pi, 0)
				p.Anchored = true
				p.CanCollide = false
				p.CanQuery = false
				p.CanTouch = false
				p.Parent = room
			end
		end
	end
	-- flat floor marks only in the middle (nothing to trip the fight): the emblem, and a rug under the players
	put("TR_Emblem", "Emblem", origin * CFrame.new(0, -0.2, 0)) -- a raised pad: accent and rim both above the tiles
	put("TR_Rug", "Rug", origin * CFrame.new(0, 0, -32))
	-- the owner's 3D low-poly pieces (ServerStorage.LowPolyLib): base on `cf`, front toward the room, `k` x natural size
	local lowLib = game:GetService("ServerStorage"):FindFirstChild("LowPolyLib")
	local function lowPoly(name: string, label: string, cf: CFrame, k: number): BasePart?
		local src = lowLib and lowLib:FindFirstChild(name)
		local mp = src and src:FindFirstChildWhichIsA("MeshPart", true)
		if not mp then
			return nil
		end
		local p = mp:Clone()
		p.Name = label
		p.Size = mp.Size * k
		p.CFrame = cf * CFrame.new(0, p.Size.Y / 2, 0) * CFrame.Angles(0, math.pi, 0)
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Parent = room
		return p
	end
	-- dressing along the walls and in the corners: the 3D banner when imported (as tall as the kit banner), else the kit one
	local function banner(cf: CFrame)
		local src = lowLib and lowLib:FindFirstChild("TowerBanner_LowPoly")
		local mp = src and src:FindFirstChildWhichIsA("MeshPart", true)
		if not (mp and lowPoly("TowerBanner_LowPoly", "Banner", cf, TowerRoomKit.size("TR_Banner").Y / math.max(mp.Size.Y, 0.01))) then
			put("TR_Banner", "Banner", cf)
		end
	end
	for _, along in { -TILE, 0, TILE } do
		banner(facing(ROOM - 1, 7, along))
		banner(facing(-(ROOM - 1), 7, along))
	end
	for _, x in { -TILE, TILE } do
		banner(facing(x, 7, -(ROOM - 1)))
	end
	-- every wall's flat door panel is hidden (it read as a flat brown slab); the side walls get the 3D door instead
	for _, w in room:GetChildren() do
		if w:IsA("Model") and string.sub(w.Name, 1, 4) == "Wall" then
			local acc = w:FindFirstChild("Accent")
			if acc and acc:IsA("BasePart") then
				acc.Transparency = 1
			end
		end
	end
	-- side walls: the 3D door (same size as the one in the mobs' arch) where the panel was
	do
		local doorK = TowerRoomKit.size("TR_Arch").X * 0.75 / 8.4
		for _, along in { -TILE, 0, TILE } do
			for _, sx in { -1, 1 } do
				if lowPoly("TowerDoor_LowPoly", "SideDoor", facing(sx * (ROOM - 0.2), 0, along), doorK) then
					for _, w in room:GetChildren() do
						if (w.Name == "WallE" or w.Name == "WallW") and w:IsA("Model") then
							local pv = w:GetPivot().Position
							local here = origin * Vector3.new(sx * edge, 0, along)
							if (Vector3.new(pv.X, 0, pv.Z) - Vector3.new(here.X, 0, here.Z)).Magnitude < 2 then
								local acc = w:FindFirstChild("Accent")
								if acc and acc:IsA("BasePart") then
									acc.Transparency = 1 -- the door replaces the flat panel
								end
							end
						end
					end
				end
			end
		end
	end
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			put("TR_Brazier", "Brazier", facing(sx * (ROOM - 7), 0, sz * (ROOM - 7)), 1.6) -- in scale with the 19-stud arches
			put("TR_Crystals", "Crystals", facing(sx * (ROOM - 8), 0, sz * (ROOM - 14))) -- clear of the wall faces
		end
		put("TR_Chest", "Chest", facing(sx * (ROOM - 27), 0, ROOM - 5), 1.8) -- beside the back-wall doors, not in front
	end
	room.Parent = m
	return true
end

local function build(origin: CFrame, slot: number): Model
	local m = Instance.new("Model")
	m.Name = "TowerFloor" .. slot
	-- Floor: a fat disc with a gold ring, plus a red disc on the mobs' side so the sides read at a glance. (The pale-blue
	-- pets' disc read as a puddle in Studio; the pets, the players and the kit's rug mark that side instead.)
	part(m, "Floor", Vector3.new(4, RADIUS * 2, RADIUS * 2), origin * CFrame.new(0, -2, 0) * CFrame.Angles(0, 0, math.rad(90)), COL.Floor, Enum.PartType.Cylinder)
	part(m, "Ring", Vector3.new(4.2, RADIUS * 2 + 3, RADIUS * 2 + 3), origin * CFrame.new(0, -2.3, 0) * CFrame.Angles(0, 0, math.rad(90)), COL.Ring, Enum.PartType.Cylinder)
	-- a low slab with a darker rim under it, so it reads as a raised pad, not a decal
	local mobs = part(m, "MobSide", Vector3.new(0.5, 22, 22), origin * CFrame.new(0, 0.3, 12) * CFrame.Angles(0, 0, math.rad(90)), COL.MobSide, Enum.PartType.Cylinder)
	mobs.CanCollide = false
	local rim = part(m, "MobSideRim", Vector3.new(0.36, 23.4, 23.4), origin * CFrame.new(0, 0.2, 12) * CFrame.Angles(0, 0, math.rad(90)), COL.MobSide:Lerp(Color3.new(0, 0, 0), 0.3), Enum.PartType.Cylinder)
	rim.CanCollide = false
	-- Invisible walls keep everyone on the fighting floor (both looks).
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		local wall = part(m, "Wall", Vector3.new(22, 30, 1), origin * CFrame.Angles(0, a, 0) * CFrame.new(0, 13, RADIUS - 0.5), COL.Stone)
		wall.Transparency = 1
	end
	if kitRoom(m, origin) then
		m:SetAttribute("Kit", true)
		for _, name in { "Floor", "Ring" } do
			local p = m:FindFirstChild(name) :: BasePart?
			if p then
				p.Transparency = 1 -- still the collider; the kit tiles are the floor you see
			end
		end
	else
		-- Stand-in: stone columns (base, shaft, capital) around the edge so the floor reads as a room in a tower.
		for i = 0, 9 do
			local a = i / 10 * math.pi * 2
			local base = origin * CFrame.new(math.sin(a) * (RADIUS + 1), 0, math.cos(a) * (RADIUS + 1)) * CFrame.Angles(0, a, 0)
			part(m, "Plinth", Vector3.new(5, 1.4, 5), base * CFrame.new(0, 0.7, 0), COL.Stone)
			part(m, "Pillar", Vector3.new(3.4, 14, 3.4), base * CFrame.new(0, 8.4, 0), COL.Pillar)
			part(m, "Cap", Vector3.new(5, 1.4, 5), base * CFrame.new(0, 16.1, 0), COL.Cap)
		end
		-- Mob gate on the north side.
		part(m, "GateL", Vector3.new(3, 12, 3), origin * CFrame.new(-6, 6, RADIUS - 3), COL.Stone)
		part(m, "GateR", Vector3.new(3, 12, 3), origin * CFrame.new(6, 6, RADIUS - 3), COL.Stone)
		part(m, "GateTop", Vector3.new(15, 3, 3), origin * CFrame.new(0, 13.5, RADIUS - 3), COL.Cap)
	end
	local ceiling = part(m, "Ceiling", Vector3.new(RADIUS * 2.4, 1, RADIUS * 2.4), origin * CFrame.new(0, 34, 0), COL.Stone)
	ceiling.Transparency = 1
	m.PrimaryPart = m:FindFirstChild("Floor") :: Part
	m.Parent = root()
	return m
end

-- Owner's low-poly tower props (IMPORT_NOW4 tower_props, imported into ServerStorage.TowerProps_LowPoly): one mesh per
-- prop, a texture per floor theme. A ring of them stands along the east and west walls of the kit room, between the
-- pillars (never in the fight area or in front of the players' rug). No kit, no props.
local THEME_PROPS: { [string]: { { any } } } = { -- { prop, height }
	Jungle = { { "CliffPine", 13 }, { "Kit_Bush_A", 3.5 }, { "Kit_Tree_A", 11 }, { "FlowerBush", 3 }, { "Mushroom", 3 } },
	Lava = { { "Rock", 4 }, { "Crystals", 6 }, { "Kit_Rock_A", 3 }, { "Rock", 3 }, { "Crystals", 5 } },
	Ice = { { "CliffPine", 11 }, { "Crystals", 6 }, { "Rock", 3.5 }, { "CliffPine", 10 }, { "Kit_Rock_A", 3 } },
	Space = { { "Crystals", 7 }, { "Kit_Rock_A", 3 }, { "Rock", 4 }, { "Crystals", 5 }, { "Kit_Rock_A", 2.5 } },
}
local PROP_TEX: { [string]: { [string]: string } } = {
	CliffPine = { Ice = "rbxassetid://126381169994876", Jungle = "rbxassetid://137769791848746", Lava = "rbxassetid://101208525968066", Space = "rbxassetid://131077040710394" },
	Crystals = { Ice = "rbxassetid://91283769250531", Jungle = "rbxassetid://79062133730502", Lava = "rbxassetid://120350004870548", Space = "rbxassetid://113669184909190" },
	FlowerBush = { Ice = "rbxassetid://137827687647265", Jungle = "rbxassetid://134566110332735", Lava = "rbxassetid://99132004962560", Space = "rbxassetid://106504275926136" },
	Kit_Bush_A = { Ice = "rbxassetid://74887658151228", Jungle = "rbxassetid://139221721045406", Lava = "rbxassetid://130776082044736", Space = "rbxassetid://107131682610477" },
	Kit_Rock_A = { Ice = "rbxassetid://140028050702795", Jungle = "rbxassetid://140028050702795", Lava = "rbxassetid://140028050702795", Space = "rbxassetid://140028050702795" },
	Kit_Tree_A = { Ice = "rbxassetid://109578682907200", Jungle = "rbxassetid://133296195798037", Lava = "rbxassetid://86519725745959", Space = "rbxassetid://115540876428923" },
	Mushroom = { Ice = "rbxassetid://87164838386234", Jungle = "rbxassetid://87164838386234", Lava = "rbxassetid://87164838386234", Space = "rbxassetid://87164838386234" },
	PineTree = { Ice = "rbxassetid://123544408092828", Jungle = "rbxassetid://95774379961243", Lava = "rbxassetid://118183059207119", Space = "rbxassetid://103934000274426" },
	Rock = { Ice = "rbxassetid://119012433215485", Jungle = "rbxassetid://121235479982147", Lava = "rbxassetid://84492359657719", Space = "rbxassetid://116922990283062" },
}
local function themeProps(arena: Model, themeId: string, origin: CFrame, glow: Color3)
	local old = arena:FindFirstChild("ThemeProps")
	if old then
		old:Destroy()
	end
	local lib = game:GetService("ServerStorage"):FindFirstChild("TowerProps_LowPoly")
	local set = THEME_PROPS[themeId]
	if not (lib and set) then
		return
	end
	local m = Instance.new("Model")
	m.Name = "ThemeProps"
	local k = 0
	for _, sx in { -1, 1 } do
		-- one prop in each wall span between the side doors (doors at 0 and +-TILE, about 6 studs either side)
		for _, along in TowerPropSlots.Alongs do
			k += 1
			local pick = set[(k - 1) % #set + 1]
			local src = lib:FindFirstChild(pick[1] .. "_LowPoly")
			local mp = src and src:FindFirstChildWhichIsA("MeshPart", true)
			if mp then
				local p = mp:Clone()
				p.Name = pick[1]
				-- the mesh only: helper bits imported with it (particles, attachments, decals) showed as stray red dots
				for _, c in p:GetChildren() do
					if not c:IsA("SurfaceAppearance") then
						c:Destroy()
					end
				end
				-- trees keep their height (capping their width squashed the cliff pine into a low blob); the inset below keeps
				-- them off the wall
				local tree = string.find(pick[1], "Pine") ~= nil or string.find(pick[1], "Tree") ~= nil
				p.Size = mp.Size * TowerPropSlots.scale(mp.Size.X, mp.Size.Y, mp.Size.Z, pick[2], tree)
				local tex = PROP_TEX[pick[1]]
				if pick[1] == "Crystals" then
					-- crystals take the theme colour (their texture showed cyan ice in every room)
					for _, c in p:GetChildren() do
						if c:IsA("SurfaceAppearance") then
							c:Destroy()
						end
					end
					p.TextureID = ""
					p.Color = glow
					p.Material = Enum.Material.Glass
				elseif themeId == "Space" and (pick[1] == "Rock" or pick[1] == "Kit_Rock_A") then
					-- navy rocks vanished into the dark space floor: flat light lilac
					for _, c in p:GetChildren() do
						if c:IsA("SurfaceAppearance") then
							c:Destroy()
						end
					end
					p.TextureID = ""
					p.Color = Color3.fromRGB(178, 158, 228)
					p.Material = Enum.Material.SmoothPlastic
				elseif tex and tex[themeId] then
					p.TextureID = tex[themeId]
				end
				-- inset by the prop's own footprint so it never pokes through the wall
				local half = TowerPropSlots.half(p.Size.X, p.Size.Z)
				local px, pz = TowerPropSlots.position(sx, along, half)
				p.CFrame = origin * CFrame.new(px, p.Size.Y / 2, pz) * CFrame.Angles(0, k * 1.3, 0) * CFrame.Angles(0, math.pi, 0)
				p.Anchored = true
				p.CanCollide = true -- solid, so the camera stops at the trees instead of filling the screen with leaves
				p.CanQuery = false
				p.CanTouch = false
				p.Parent = m
			end
		end
	end
	-- jungle floors: the owner's mossy floor tiles and vine walls (ServerStorage.WorldKit_LowPoly) over the kit room
	local kit = game:GetService("ServerStorage"):FindFirstChild("WorldKit_LowPoly")
	local floorSrc = kit and kit:FindFirstChild("Tower_JungleFloor")
	local wallSrc = kit and kit:FindFirstChild("Tower_JungleWall")
	if themeId == "Jungle" and floorSrc and wallSrc and floorSrc:IsA("BasePart") and wallSrc:IsA("BasePart") then
		local function lay(src: BasePart, size: Vector3, cf: CFrame, solid: boolean?)
			local p = src:Clone()
			p.Size = size
			p.CFrame = cf
			p.Anchored = true
			p.CanCollide = solid == true -- walls solid so the camera stops at them
			p.CanQuery = false
			p.CanTouch = false
			p.Parent = m
		end
		local fk = TILE / floorSrc.Size.X
		local fs = floorSrc.Size * fk
		for ix = -1, 1 do
			for iz = -1, 1 do
				lay(floorSrc, fs, origin * CFrame.new(ix * TILE, 0.15 - fs.Y / 2, iz * TILE))
			end
		end
		local wk = TILE / wallSrc.Size.X
		local ws = wallSrc.Size * wk
		local centre = origin.Position
		for k2 = -1, 1 do
			for _, at in { Vector3.new(k2 * TILE, 0, ROOM), Vector3.new(k2 * TILE, 0, -ROOM), Vector3.new(ROOM, 0, k2 * TILE), Vector3.new(-ROOM, 0, k2 * TILE) } do
				local inward = -Vector3.new(math.sign(at.X) * (if math.abs(at.X) == ROOM then 1 else 0), 0, math.sign(at.Z) * (if math.abs(at.Z) == ROOM then 1 else 0))
				local pos = origin * (at - inward * (ws.Z / 2)) + Vector3.new(0, ws.Y / 2, 0)
				-- the mesh's front (-Z before the import flip) faces the room centre
				lay(wallSrc, ws, CFrame.lookAt(pos, Vector3.new(centre.X, pos.Y, centre.Z)), true)
				-- the jungle wall mesh has a flat door painted on it: a 3D door stands in front of each one (the north
				-- middle slot is behind the mobs' arch door already)
				local doorLib = game:GetService("ServerStorage"):FindFirstChild("LowPolyLib")
				local dsrc = doorLib and doorLib:FindFirstChild("TowerDoor_LowPoly")
				local dmp = dsrc and dsrc:FindFirstChildWhichIsA("MeshPart", true)
				-- front and back walls only (the side walls have their SideDoor already)
				if dmp and math.abs(at.Z) == ROOM and not (k2 == 0 and at.Z == ROOM) then
					local door = dmp:Clone()
					door.Name = "JungleWallDoor"
					door.Size = dmp.Size * (TowerRoomKit.size("TR_Arch").X * 0.75 / 8.4)
					-- on the room side of the wall (its inner face is at the room edge), not behind it
					local base = origin * (at + inward * (door.Size.Z / 2 + 0.1))
					door.CFrame = CFrame.lookAt(base, base - Vector3.new(inward.X, 0, inward.Z))
						* CFrame.new(0, door.Size.Y / 2, 0) * CFrame.Angles(0, math.pi, 0)
					door.Anchored = true
					door.CanCollide = false
					door.CanQuery = false
					door.CanTouch = false
					door.Parent = m
				end
			end
		end
	end
	m.Parent = arena
end

-- Lava floors: a warm glow accent so the room does not read dark. A few static lava pools in the corners and thin
-- cracks along the walls, all flat bright colour (SmoothPlastic, no Neon bloom, no lights) and away from the middle
-- where the pets and mobs fight. Any other theme just removes them.
local function lavaGlow(arena: Model, themeId: string, origin: CFrame, glow: Color3)
	local old = arena:FindFirstChild("LavaGlow")
	if old then
		old:Destroy()
	end
	if themeId ~= "Lava" then
		return
	end
	local m = Instance.new("Model")
	m.Name = "LavaGlow"
	local bright = glow:Lerp(Color3.fromRGB(255, 200, 90), 0.45)
	local edge = ROOM - 9
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local at = origin * CFrame.new(sx * edge, 0, sz * edge)
			local rim = part(m, "LavaRim", Vector3.new(0.3, 9, 9), at * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(70, 40, 30), Enum.PartType.Cylinder)
			rim.Material = Enum.Material.Basalt
			local pool = part(m, "LavaPool", Vector3.new(0.34, 7, 7), at * CFrame.new(0, 0.22, 0) * CFrame.Angles(0, 0, math.rad(90)), bright, Enum.PartType.Cylinder)
			pool.Material = Enum.Material.SmoothPlastic
		end
	end
	for i = 0, 7 do
		local side = i % 4
		local along = (if i < 4 then -0.45 else 0.45) * TILE
		local x, z, yaw = 0, 0, 0
		if side == 0 then
			x, z, yaw = along, edge + 2, 0
		elseif side == 1 then
			x, z, yaw = along, -edge - 2, 0
		elseif side == 2 then
			x, z, yaw = edge + 2, along, math.pi / 2
		else
			x, z, yaw = -edge - 2, along, math.pi / 2
		end
		local crack = part(m, "LavaCrack", Vector3.new(7, 0.12, 0.8), origin * CFrame.new(x, 0.18, z) * CFrame.Angles(0, yaw + (i - 3.5) * 0.12, 0), bright)
		crack.Material = Enum.Material.SmoothPlastic
	end
	for _, d in m:GetChildren() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		end
	end
	m.Parent = arena
end

-- Recolours the floor and swaps its decorations for a theme (TowerConfig.Themes entry).
function TowerBuilder.theme(arena: Model, theme: any, origin: CFrame)
	if arena:GetAttribute("Theme") == theme.Id then
		return
	end
	arena:SetAttribute("Theme", theme.Id)
	for _, d in arena:GetChildren() do
		if d:IsA("BasePart") then
			if d.Name == "Floor" then
				d.Color = theme.Floor
			elseif d.Name == "Ring" or d.Name == "GateTop" then
				d.Color = theme.Ring
			elseif d.Name == "Pillar" or d.Name == "Plinth" or d.Name == "GateL" or d.Name == "GateR" then
				d.Color = theme.Pillar
			elseif d.Name == "Cap" then
				d.Color = theme.Cap
			end
		end
	end
	-- the mobs' half: salmon, pale blue on the ice floors and lilac in space (salmon read wrong there)
	local mobCol = if theme.Id == "Ice" then Color3.fromRGB(150, 200, 240) elseif theme.Id == "Space" then Color3.fromRGB(176, 150, 230) else COL.MobSide
	for _, n in { "MobSide", "MobSideRim" } do
		local d = arena:FindFirstChild(n)
		if d and d:IsA("BasePart") then
			d.Color = if n == "MobSideRim" then mobCol:Lerp(Color3.new(0, 0, 0), 0.3) else mobCol
		end
	end
	local room = arena:FindFirstChild("Room")
	if room then
		-- kit room: the accents, glow and a hint of the stone take the theme's colours; no extra props
		local accent = if theme.Id == "Ice" then theme.Ring else theme.Cap
		for _, d in room:GetDescendants() do
			if d:IsA("BasePart") then
				local base = d:GetAttribute("BaseColor")
				if typeof(base) ~= "Color3" then
					base = d.Color
					d:SetAttribute("BaseColor", base)
				end
				local pad = d.Parent ~= nil and (d.Parent.Name == "Rug" or d.Parent.Name == "Emblem")
				if pad and d.Name == "Trim" then
					-- the pads' gold border, half way to the floor (a thick bright yellow line in the dark space room)
					d.Color = (base :: Color3):Lerp(theme.Floor, 0.5)
				elseif pad and (d.Name == "Accent" or d.Name == "AccentDark") then
					-- the players' rug and the middle emblem: the theme floor, a shade darker, inside the gold trim (the
					-- bright accent slab was the brightest thing in the room)
					d.Color = theme.Floor:Lerp(Color3.new(0, 0, 0), if d.Name == "AccentDark" then 0.3 else 0.15)
				elseif d.Name == "Banner" and d:IsA("MeshPart") then
					-- the 3D banner's texture was green in every theme: flat theme accent instead
					for _, c in d:GetChildren() do
						if c:IsA("SurfaceAppearance") then
							c:Destroy()
						end
					end
					d.TextureID = ""
					d.Color = accent
				elseif d.Name == "Accent" then
					d.Color = accent
				elseif d.Name == "AccentDark" then
					d.Color = accent:Lerp(Color3.new(0, 0, 0), 0.3)
				elseif d.Name == "Glow" then
					-- flat colour, not Neon: the big doorway glow bloomed over the whole screen
					d.Color = theme.Glow
					d.Material = Enum.Material.SmoothPlastic
				elseif d.Name == "Stone" or d.Name == "StoneDark" then
					-- the room takes the theme's own colours (the pale lilac kit stone read the same in every theme):
					-- floor tiles the theme floor, walls / pillars / arches the theme pillar colour, the dark half darker
					local holder = d.Parent
					local tile = holder ~= nil and (holder.Name == "Tile" or holder.Name == "Emblem" or holder.Name == "Rug")
					local want: Color3 = if tile then theme.Floor else theme.Pillar
					local c = (base :: Color3):Lerp(want, 0.8)
					d.Color = if d.Name == "StoneDark" then c:Lerp(Color3.new(0, 0, 0), 0.18) else c
				end
			end
		end
		themeProps(arena, theme.Id, origin, theme.Glow)
		lavaGlow(arena, theme.Id, origin, theme.Glow)
		return
	end
	local old = arena:FindFirstChild("Decor")
	if old then
		old:Destroy()
	end
	local decor = Instance.new("Model")
	decor.Name = "Decor"
	for i = 0, 9 do
		local a = (i + 0.5) / 10 * math.pi * 2
		local pos = origin * CFrame.new(math.sin(a) * (RADIUS - 3), 0, math.cos(a) * (RADIUS - 3))
		if theme.Id == "Jungle" then
			-- low leafy patches at the foot of the wall (tall green balls read as blobs)
			local moss = part(decor, "Moss", Vector3.new(0.4, 5, 5), pos * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)), theme.Cap, Enum.PartType.Cylinder)
			moss.CanCollide = false
			local leaf = part(decor, "Leaf", Vector3.new(2.6, 0.5, 1.2), pos * CFrame.new(0.6, 0.45, 0.4) * CFrame.Angles(0, a, math.rad(18)), theme.Glow)
			leaf.CanCollide = false
		elseif theme.Id == "Lava" then
			local crack = part(decor, "LavaCrack", Vector3.new(6, 0.12, 1.2), pos * CFrame.new(0, 0.05, 0) * CFrame.Angles(0, a, 0), theme.Glow)
			crack.Material = Enum.Material.Neon
			crack.CanCollide = false
		elseif theme.Id == "Ice" then
			local spike = part(decor, "IceSpike", Vector3.new(1.6, 5, 1.6), pos * CFrame.new(0, 2.5, 0) * CFrame.Angles(0, a, math.rad(8)), theme.Glow)
			spike.Material = Enum.Material.Ice
			spike.Transparency = 0.25
			spike.CanCollide = false
		else
			local star = part(decor, "Star", Vector3.new(1.2, 1.2, 1.2), pos * CFrame.new(0, 9 + (i % 3) * 3, 0), theme.Glow, Enum.PartType.Ball)
			star.Material = Enum.Material.Neon
			star.CanCollide = false
		end
	end
	decor.Parent = arena
end

-- A free arena slot: (slot, arena model, origin CFrame at floor height, facing the mobs).
function TowerBuilder.claim(): (number, Model, CFrame)
	local slot: number = table.remove(free) or 0
	if slot == 0 then
		slot = 1
		while used[slot] do
			slot += 1
		end
	end
	used[slot] = true
	local origin = CFrame.new(BASE + Vector3.new((slot - 1) * SPACING, 0, 0))
	return slot, build(origin, slot), origin
end

function TowerBuilder.free(slot: number, arena: Model)
	arena:Destroy()
	used[slot] = nil
	table.insert(free, slot)
end

-- Where member `i` (1-4) stands: on the team's side, well behind the pet line (pets at z -14, mobs at +12),
-- on the players' rug and inside the invisible walls, facing the mobs.
local STAND_Z = -29
function TowerBuilder.standCFrame(origin: CFrame, i: number): CFrame
	local x = (i - 2.5) * 5
	local pos = origin * Vector3.new(x, 3.5, STAND_Z)
	return CFrame.lookAt(pos, pos + origin.LookVector * -1)
end

return TowerBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="268">
        <Properties>
          <string name="Name">TowerRoomKit</string>
          <string name="Source"><![CDATA[--!strict
-- GENERATED by lobby_blender/tower_kit.py (Blender). ModuleScript: ServerScriptService.Server.TowerRoomKit
-- (next to ArenaKit). PS99-style tower room pieces: floor tile, wall, pillar, door arch, torch, banner, crystals, pedestal, rug, chest, brazier, stairs.
-- Needs the imported roblox/TowerRoomKit.fbx model in ServerStorage named "TowerRoomKit". Without it, has() is false and
-- ArenaKit builds its old ball-and-block props.
-- Each kit: natural size in studs (x width, y height, z depth) and its parts:
--   { mesh name, role (part name in game), offset from the base centre, size, Roblox material, colour }

local ServerStorage = game:GetService("ServerStorage")

type PartRow = { any }
type KitDef = { size: { number }, parts: { PartRow } }

local KITS: { [string]: KitDef } = {
	TR_Floor = { size = {32,1.225,32}, parts = {
		{"TR_Floor__StoneDark","StoneDark",{0,0.613,-0},{32,1.225,32},"SmoothPlastic","#A99CC6"},
		{"TR_Floor__Stone","Stone",{0,1.1,-0},{31.6,0.25,31.6},"SmoothPlastic","#ECE6F3"},
	} },
	TR_Emblem = { size = {12.38,0.9,12.38}, parts = {
		{"TR_Emblem__Accent","Accent",{0,0.3,-0},{11,0.6,11},"SmoothPlastic","#7B5CE0"},
		{"TR_Emblem__Trim","Trim",{0,0.45,-0},{12.38,0.9,12.38},"SmoothPlastic","#F2C14E"},
	} },
	TR_Wall = { size = {32.6,24,4.949}, parts = {
		{"TR_Wall__Stone","Stone",{0,12,-0.475},{32,24,3},"SmoothPlastic","#ECE6F3"},
		{"TR_Wall__StoneDark","StoneDark",{0,12,-0.475},{32.4,24,3.8},"SmoothPlastic","#A99CC6"},
		{"TR_Wall__Trim","Trim",{0,12.225,-0.025},{31.4,20.55,4.2},"SmoothPlastic","#F2C14E"},
		{"TR_Wall__Accent","Accent",{0,11.75,1.175},{24.6,15.3,0.4},"SmoothPlastic","#7B5CE0"},
		{"TR_Wall__Glow","Glow",{0,12.5,1.925},{0.977,2.2,1.099},"Neon","#8FE6FF"},
	} },
	TR_Pillar = { size = {5.2,24,5.2}, parts = {
		{"TR_Pillar__StoneDark","StoneDark",{0,12,-0},{5.2,24,5.2},"SmoothPlastic","#A99CC6"},
		{"TR_Pillar__Stone","Stone",{0,11.7,-0},{3.5,20.2,3.5},"SmoothPlastic","#ECE6F3"},
		{"TR_Pillar__Trim","Trim",{0,11.7,-0},{3.9,17.9,3.9},"SmoothPlastic","#F2C14E"},
	} },
	TR_Arch = { size = {16.6,19,5.146}, parts = {
		{"TR_Arch__Stone","Stone",{0,9.3,-0.273},{16,18.6,4.2},"SmoothPlastic","#ECE6F3"},
		{"TR_Arch__StoneDark","StoneDark",{0,9.253,-0.273},{16.6,18.506,4.4},"SmoothPlastic","#A99CC6"},
		{"TR_Arch__Trim","Trim",{0,17.5,-0.273},{2.6,3,4.6},"SmoothPlastic","#F2C14E"},
		{"TR_Arch__Glow","Glow",{0,9,0.775},{9.6,18,3.596},"Neon","#8FE6FF"},
	} },
	TR_Torch = { size = {2.264,4,2.264}, parts = {
		{"TR_Torch__Metal","Metal",{0,1,-0.6},{1.2,2,1},"Metal","#5C5870"},
		{"TR_Torch__Trim","Trim",{0,2.2,-0},{2.264,0.6,2.264},"SmoothPlastic","#F2C14E"},
		{"TR_Torch__Glow","Glow",{0,3.2,-0},{0.824,1.6,0.895},"Neon","#8FE6FF"},
	} },
	TR_Banner = { size = {6.826,10.35,1.441}, parts = {
		{"TR_Banner__Trim","Trim",{0,7.475,-0.416},{6.826,5.75,0.608},"SmoothPlastic","#F2C14E"},
		{"TR_Banner__Accent","Accent",{0,5.3,-0.423},{4.8,9,0.24},"SmoothPlastic","#7B5CE0"},
		{"TR_Banner__Glow","Glow",{0.205,5,0.217},{0.966,0.606,1.006},"Neon","#8FE6FF"},
	} },
	TR_Crystals = { size = {4.206,4.8,3.623}, parts = {
		{"TR_Crystals__StoneDark","StoneDark",{0,0.486,-0},{4.206,1.831,3.623},"SmoothPlastic","#A99CC6"},
		{"TR_Crystals__Glow","Glow",{-0.042,2.596,0.375},{3.871,4.408,2.608},"Neon","#8FE6FF"},
	} },
	TR_Pedestal = { size = {12,2.3,12}, parts = {
		{"TR_Pedestal__StoneDark","StoneDark",{0,0.5,-0},{12,1,12},"SmoothPlastic","#A99CC6"},
		{"TR_Pedestal__Stone","Stone",{0,1.5,-0},{9.6,1,9.6},"SmoothPlastic","#ECE6F3"},
		{"TR_Pedestal__Trim","Trim",{0,2,-0},{10.184,0.3,10.184},"SmoothPlastic","#F2C14E"},
		{"TR_Pedestal__Accent","Accent",{0,2.15,-0},{8.4,0.3,8.4},"SmoothPlastic","#7B5CE0"},
		{"TR_Pedestal__Glow","Glow",{0,1.05,-0},{11.5,0.2,11.5},"Neon","#8FE6FF"},
	} },
	TR_Rug = { size = {12,0.56,18}, parts = {
		{"TR_Rug__Trim","Trim",{0,0.2,-0},{12,0.4,18},"SmoothPlastic","#F2C14E"},
		{"TR_Rug__Accent","Accent",{0,0.25,-0},{11,0.5,17},"SmoothPlastic","#7B5CE0"},
		{"TR_Rug__AccentDark","AccentDark",{0,0.28,-0},{7,0.56,13},"SmoothPlastic","#5A3FB8"},
	} },
	TR_Chest = { size = {4,3.487,2.987}, parts = {
		{"TR_Chest__Wood","Wood",{0,1.65,-0.006},{4,3.3,2.6},"Wood","#9C6438"},
		{"TR_Chest__Trim","Trim",{0,1.744,-0},{3.2,3.487,2.987},"SmoothPlastic","#F2C14E"},
	} },
	TR_Brazier = { size = {3.644,5.796,3.644}, parts = {
		{"TR_Brazier__StoneDark","StoneDark",{0,0.25,-0},{3.2,0.5,3.2},"SmoothPlastic","#A99CC6"},
		{"TR_Brazier__Metal","Metal",{0,2.1,-0},{1.141,3.2,1.2},"Metal","#5C5870"},
		{"TR_Brazier__Trim","Trim",{0,4,-0},{3.644,1,3.644},"SmoothPlastic","#F2C14E"},
		{"TR_Brazier__Glow","Glow",{-0.2,5,-0.255},{2.04,1.591,1.76},"Neon","#8FE6FF"},
	} },
	TR_Stairs = { size = {18.6,5.25,8.6}, parts = {
		{"TR_Stairs__Stone","Stone",{0,1.5,1},{16,3,6},"SmoothPlastic","#ECE6F3"},
		{"TR_Stairs__StoneDark","StoneDark",{0,2.5,-0},{18.4,5,8.4},"SmoothPlastic","#A99CC6"},
		{"TR_Stairs__Trim","Trim",{0,5.1,-0},{18.6,0.3,8.6},"SmoothPlastic","#F2C14E"},
	} },
}

-- Import 3D brings each mesh in turned 180 degrees about its own centre; FLIP turns it back
-- (set to CFrame.identity if a piece ever shows its back).
local FLIP = CFrame.Angles(0, math.pi, 0)

local TowerRoomKit = {}

local sources: { [string]: MeshPart }? = nil
local function src(): { [string]: MeshPart }
	if sources then
		return sources
	end
	local found: { [string]: MeshPart } = {}
	local root = ServerStorage:FindFirstChild("TowerRoomKit")
	if root then
		for _, d in root:GetDescendants() do
			if d:IsA("MeshPart") then
				local base = string.gsub(d.Name, "%.%d+$", "")
				found[base] = found[base] or d
			end
		end
	end
	sources = found
	return found
end

function TowerRoomKit.has(name: string): boolean
	local k = KITS[name]
	if not k then
		return false
	end
	local s = src()
	for _, row in k.parts do
		if not s[row[1]] then
			return false
		end
	end
	return true
end

-- natural size in studs
function TowerRoomKit.size(name: string): Vector3
	local s = KITS[name].size
	return Vector3.new(s[1], s[2], s[3])
end

-- cf = base centre on the floor (its -Z is the front), scale = number (uniform) or Vector3 (per axis).
-- Pieces are visual only unless `solidRoles` names roles that should collide (e.g. { Trunk = true }).
function TowerRoomKit.place(parent: Instance, name: string, modelName: string, cf: CFrame, scale: number | Vector3,
	solidRoles: { [string]: boolean }?): Model?
	if not TowerRoomKit.has(name) then
		return nil
	end
	local sv: Vector3 = if typeof(scale) == "Vector3" then scale else Vector3.new(scale, scale, scale)
	local s = src()
	local m = Instance.new("Model")
	m.Name = modelName
	for _, row in KITS[name].parts do
		local p = s[row[1]]:Clone()
		local off, size = row[3], row[4]
		p.Name = row[2]
		p.TextureID = ""
		p.Size = Vector3.new(size[1] * sv.X, size[2] * sv.Y, size[3] * sv.Z)
		p.CFrame = cf * CFrame.new(off[1] * sv.X, off[2] * sv.Y, off[3] * sv.Z) * FLIP
		local ok, mat = pcall(function()
			return (Enum.Material :: any)[row[5]]
		end)
		p.Material = if ok and mat then mat else Enum.Material.SmoothPlastic
		p.Color = Color3.fromHex(row[6])
		p.Anchored = true
		local solid = solidRoles ~= nil and solidRoles[row[2]] == true
		p.CanCollide = solid
		p.CanQuery = solid
		p.CanTouch = false
		p.CastShadow = p.Size.Magnitude > 4
		p.Parent = m
	end
	m.Parent = parent
	return m
end

return TowerRoomKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="269">
        <Properties>
          <string name="Name">TowerService</string>
          <string name="Source"><![CDATA[--!strict
-- Pet Tower server (design: project file plans/pet-tower.md). The one authority for tower runs: who is in, which
-- pets fight, every hit, faint, floor and coin. Clients send intents only ("Open", "Start", "Special", "Next",
-- "Leave", "SetTeam"); the fight itself is shared/TowerRules stepped here.
--
-- Kept in its own files so the egg race code is untouched. Own remotes (ReplicatedStorage.TowerNet) so Net.luau
-- does not change. Solo, endless floors, pet XP levels, free revive, tower-only pet drops (carter's picks).
-- Hooks into main: Profiles defaults (TowerBest, TowerXP, TowerReviveCredits, TowerReceipts), InTower = busy,
-- QuestService "TowerFloors", tower-only species in Config.Minerals, the lobby TowerPortal, StoreService receipt route.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TowerConfig = require(Shared.TowerConfig)
local TowerRules = require(Shared.TowerRules)
local MapNames = require(Shared.MapNames)
local PetStats = require(Shared.PetStats)
local Profiles = require(script.Parent.Profiles)
local TowerBuilder = require(script.Parent.TowerBuilder)
local Config = require(Shared.Config)
local PetRules = require(Shared.PetRules)
local GeodeGen = require(Shared.GeodeGen)
local EggPerks = require(Shared.EggPerks)
local QuestService = require(script.Parent.QuestService)
local Workspace = game:GetService("Workspace")

local TowerService = {}

type Run = {
	Key: string,
	Slot: number,
	Members: { Player },
	Rules: TowerRules.Run,
	Arena: Model,
	Origin: CFrame,
	Coins: { [number]: number },
	Idle: number, -- seconds waiting on NEXT/LEAVE after a floor ends
	PromptUntil: number?, -- os.clock() until which a revive purchase prompt is open (the idle clock waits)
	SendIn: number,
	Pending: { TowerRules.Event },
	Specs: { [string]: any }, -- pet unit id -> look data for the client model
	PetIds: { [string]: any }, -- pet unit id -> saved pet Id (for XP)
	Revives: number,
	PaidRevives: number,
	Xp: number, -- XP each team pet earned this climb
	LostPaid: boolean,
	HoldLeft: number?, -- seconds before this floor's fight starts (TowerRules.introHold: the theme title shows first)
}

local runs: { [string]: Run } = {}
local runOf: { [Player]: Run } = {}
local lastAction: { [Player]: number } = {}
local returnCF: { [Player]: CFrame } = {}
local serial = 0
local action: RemoteEvent
local event: RemoteEvent

local ACTION_GAP = 0.15 -- seconds between accepted intents per player
local IDLE_LIMIT = 45 -- seconds on a floor-end card before the run closes by itself
local SEND_EVERY = 0.2 -- hit batches per second cap

local function inventory(player: Player): { any }
	local data = Profiles.get(player)
	local inv = data and data.InventoryGeodes
	return if type(inv) == "table" then inv else {}
end

local function petById(player: Player, id: string): any?
	for _, g in inventory(player) do
		if g.Id == id then
			return g
		end
	end
	return nil
end

local function xpOf(player: Player, petId: any): number
	local data = Profiles.get(player)
	local book = data and data.TowerXP
	local x = if type(book) == "table" then book[tostring(petId)] else nil
	return if type(x) == "number" and x == x then math.max(x, 0) else 0
end

local function score(g: any, xp: number?): number
	local s = PetStats.roll(g, xp)
	return s.Power * 3 + s.Health * 0.5 + s.Speed * 0.2
end

-- ONE team (carter 2026-10-15): the saved EquippedPets both follow the player and fight (tower, Pet Battle); no
-- team yet = their strongest pets.
local function teamOf(player: Player): { any }
	local out = {}
	local data = Profiles.get(player)
	local chosen: { string } = if data and type(data.EquippedPets) == "table" then data.EquippedPets else {}
	for _, id in chosen do
		local g = petById(player, id)
		if g and #out < TowerConfig.TeamSize then
			table.insert(out, g)
		end
	end
	if #out == 0 then
		local all = table.clone(inventory(player))
		table.sort(all, function(a, b)
			return score(a, xpOf(player, a.Id)) > score(b, xpOf(player, b.Id))
		end)
		for i = 1, math.min(TowerConfig.TeamSize, #all) do
			table.insert(out, all[i])
		end
	end
	return out
end

-- Sets the one shared team (ids already checked as owned), or the strongest pets for nil (PetRules.best, the same
-- pick as MY PETS' EQUIP BEST).
local function setShared(player: Player, ids: { string }?)
	local data = Profiles.get(player)
	if not data or Profiles.isReleased(player) then
		return
	end
	local list = ids
	if list == nil or #list == 0 then
		list = PetRules.best(data.InventoryGeodes, Config.Pets.Slots, if type(data.TowerXP) == "table" then data.TowerXP else nil)
	end
	local kept = {}
	for _, id in list :: { string } do
		if #kept < Config.Pets.Slots then
			table.insert(kept, id)
		end
	end
	data.EquippedPets = kept
	Profiles.changed(player)
end

local function best(player: Player): number
	local data = Profiles.get(player)
	local b = data and data.TowerBest
	return if type(b) == "number" and b == b then math.clamp(math.floor(b), 0, 1e6) else 0
end

-- Every XP gain (tower, Pet Battle, training) passes here: +10% per full Pet Book page (EggPerks.xpMult). `raw` =
-- an exact amount (dev /xp, /maxpet), no bonus.
local function addXp(player: Player, petId: any, amount: number, raw: boolean?)
	local data = Profiles.get(player)
	if not data or amount <= 0 or not petById(player, tostring(petId)) then
		return -- a pet sold mid-climb earns nothing (no XP rows for pets that are gone)
	end
	if not raw then
		amount = math.floor(amount * EggPerks.xpMult(data.DiscoveryIndex) + 0.5)
	end
	if type(data.TowerXP) ~= "table" then
		data.TowerXP = {}
	end
	local key = tostring(petId)
	if raw or type(data.EquippedPets) ~= "table" then
		data.TowerXP[key] = xpOf(player, petId) + amount
		return
	end
	-- a team pet at MAX passes the XP it can't use to its teammates (PetRules.spillXp)
	local gains = PetRules.spillXp(key, amount, data.EquippedPets, function(id: string): number
		local g = petById(player, id)
		return if g then PetStats.xpForLevel(PetStats.cap(g)) - xpOf(player, id) else 0
	end)
	for id, gain in gains do
		data.TowerXP[id] = xpOf(player, id) + gain
	end
end

local function petView(g: any, xp: number?)
	local s = PetStats.roll(g, xp)
	local sp = PetStats.special(s.Special)
	return {
		Id = g.Id,
		Name = PetRules.label(g), -- the Pet Book name (variant, nickname), not just the species
		Spec = { Mineral = g.Mineral, Rarity = g.Rarity, Modifier = g.Modifier, Formation = g.Formation, Mass = g.Mass, Seed = g.Seed, Evolve = g.Evolve },
		Rarity = g.Rarity,
		Power = s.Power,
		Health = s.Health,
		Speed = s.Speed,
		Grade = s.Grade,
		Level = s.Level,
		Element = s.Element,
		Basic = s.Basic,
		Move = s.Move,
		Special = if sp then sp.Name else s.Special,
	}
end

local function roster(player: Player)
	local pets = {}
	for _, g in inventory(player) do
		table.insert(pets, petView(g, xpOf(player, g.Id)))
	end
	local chosen = {}
	for _, g in teamOf(player) do
		table.insert(chosen, g.Id)
	end
	event:FireClient(player, {
		Kind = "Roster",
		Pets = pets,
		Team = chosen,
		Best = best(player),
		Checkpoint = TowerRules.checkpoint(best(player)),
	})
end

-- Open / SetTeam / EquipBest each resend the whole roster (stats for every pet): at most one send per
-- ROSTER_GAP per player, a burst collapses into one delayed send.
local ROSTER_GAP = 1
local rosterAt: { [Player]: number } = {}
local rosterQueued: { [Player]: boolean } = {}
local function rosterSoon(player: Player)
	local left = (rosterAt[player] or -math.huge) + ROSTER_GAP - os.clock()
	if left <= 0 then
		rosterAt[player] = os.clock()
		roster(player)
	elseif not rosterQueued[player] then
		rosterQueued[player] = true
		task.delay(left, function()
			rosterQueued[player] = nil
			if player.Parent then
				rosterAt[player] = os.clock()
				roster(player)
			end
		end)
	end
end

local function unitsView(r: TowerRules.Run, specs: { [string]: any })
	local out = {}
	for _, list in { r.Pets, r.Mobs } do
		for _, u in list do
			table.insert(out, {
				Id = u.Id,
				Owner = u.Owner,
				Kind = u.Kind,
				Name = u.Name,
				Max = u.Max,
				Hp = u.Hp,
				Element = u.Element,
				Boss = u.Boss,
				Spec = specs[u.Id],
			})
		end
	end
	return out
end

local function broadcast(run: Run, msg: any)
	for _, p in run.Members do
		event:FireClient(p, msg)
	end
end

local function sendFloor(run: Run)
	local theme = TowerRules.theme(run.Rules.Floor)
	TowerBuilder.theme(run.Arena, theme, run.Origin)
	local hold = TowerRules.introHold(run.Rules.Floor, run.Rules.Wave)
	run.HoldLeft = if hold > 0 then hold else nil
	broadcast(run, {
		Hold = hold,
		Theme = theme.Name,
		Kind = "Floor",
		Floor = run.Rules.Floor,
		Wave = run.Rules.Wave,
		Waves = #run.Rules.Waves,
		Boss = TowerRules.isBoss(run.Rules.Floor),
		Units = unitsView(run.Rules, run.Specs),
		Origin = run.Origin,
	})
end

local function moveTo(player: Player, cf: CFrame)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if char and root then
		char:PivotTo(cf)
	end
end

-- The lobby spot to put a player back on. Someone who walked in through the tower portal would land inside it
-- (and their camera inside its glow), so near the portal they come out at the exit instead: the lobby's
-- `TowerExit` part (stair landing in front of the gate; its front faces the way out) when the map has one, else a
-- few studs out along the portal's front (-LookVector side). Height comes from the ground under that spot, so the
-- player never lands inside rock. Anyone who entered elsewhere (the TOWER button) goes back where they were.
local function ground(pos: Vector3, ignore: Instance?): Vector3?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local skip: { Instance } = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(skip, p.Character)
		end
	end
	if ignore then
		table.insert(skip, ignore) -- the TowerExit marker itself is not ground
	end
	params.FilterDescendantsInstances = skip
	local hit = Workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), params)
	return if hit then hit.Position else nil
end

local function lobbySpot(back: CFrame): CFrame
	local portal: BasePart? = nil
	local exit: BasePart? = nil
	for _, d in Workspace:GetDescendants() do
		if d:IsA("BasePart") then
			if d:GetAttribute("TowerPortal") == true then
				local flat = Vector3.new(back.Position.X - d.Position.X, 0, back.Position.Z - d.Position.Z)
				if flat.Magnitude <= math.max(d.Size.X, d.Size.Z) * 0.5 + 20 then
					portal = d
				end
			elseif d.Name == MapNames.TowerExit or d:GetAttribute("TowerExit") == true then
				exit = d
			end
		end
	end
	if not portal then
		return back
	end
	local pos: Vector3, out: Vector3
	if exit then
		pos = exit.Position
		out = Vector3.new(exit.CFrame.LookVector.X, 0, exit.CFrame.LookVector.Z)
	else
		local p = portal :: BasePart
		out = Vector3.new(-p.CFrame.LookVector.X, 0, -p.CFrame.LookVector.Z)
		if out.Magnitude < 0.1 then
			out = Vector3.new(-back.LookVector.X, 0, -back.LookVector.Z)
		end
		pos = p.Position + out.Unit * (math.min(p.Size.X, p.Size.Z) * 0.5 + 12)
	end
	out = if out.Magnitude > 0.1 then out.Unit else Vector3.zAxis
	local g = ground(pos, exit)
	local at = if g then Vector3.new(pos.X, g.Y + 3.5, pos.Z) else Vector3.new(pos.X, back.Position.Y, pos.Z)
	return CFrame.lookAt(at, at + out)
end

local function closeRun(run: Run, why: string)
	if runs[run.Key] ~= run then
		return
	end
	runs[run.Key] = nil
	for _, p in run.Members do
		if runOf[p] == run then
			runOf[p] = nil
			p:SetAttribute("InTower", nil)
			event:FireClient(p, { Kind = "Closed", Why = why })
			local back = returnCF[p]
			returnCF[p] = nil
			if back and p.Parent then
				moveTo(p, lobbySpot(back))
			end
		end
	end
	TowerBuilder.free(run.Slot, run.Arena)
end

-- A tower-only pet from a boss floor. Granted only when the core game lists the species (Config.Minerals),
-- so the drop stays off until those pets exist in the collection.
-- Pity (TowerConfig.Pity): profile TowerPity counts boss clears without a drop; it raises the next boss's chance and
-- resets on a drop. A tower pet the player never had is favoured (TowerRules.dropSpecies with the discovery index).
local function rollDrop(player: Player, floor: number): string?
	if not TowerRules.isBoss(floor) then
		return nil
	end
	local data = Profiles.get(player)
	if not data then
		return nil
	end
	if #data.InventoryGeodes >= Profiles.petCapacity(data) then
		-- Pet Book full: no drop (the pity counter is kept as it is), and the player is told why
		pcall(function()
			require(Shared.Net).event("Toast"):FireClient(player, "Pet Book full! A boss pet could not drop. Sell pets to make room.", "warn")
		end)
		return nil
	end
	local misses = tonumber(data.TowerPity) or 0
	if math.random() >= TowerRules.dropChance(floor, misses) then
		data.TowerPity = TowerRules.pityAfter(misses, false)
		return nil
	end
	local species = TowerRules.dropSpecies(floor, math.random(), data.DiscoveryIndex)
	if species == nil or type(Config.Minerals) ~= "table" or Config.Minerals[species] == nil then
		data.TowerPity = TowerRules.pityAfter(misses, false)
		return nil
	end
	local rng = Random.new()
	local rarity = GeodeGen.pickWeighted(rng, Config.Rarities, TowerConfig.Drop.RarityWeights)
	local modifier = GeodeGen.pickWeighted(rng, Config.Modifiers, Config.ModifierWeights)
	local formation = GeodeGen.pickWeighted(rng, Config.Formations, Config.FormationWeights)
	-- priced like a hunt pet of the player's best unlocked zone (never the last zone's prices from floor 5)
	local tier = TowerRules.dropTier(Config.TierOrder, data.UnlockedTiers)
	local mass = GeodeGen.rollMass(rng)
	local id = "T" .. player.UserId .. "_" .. os.time() .. "_" .. rng:NextInteger(1, 1e6)
	local specimen = {
		Id = id,
		MatchKey = "tower",
		Tier = tier,
		Mineral = species,
		Rarity = rarity,
		Formation = formation,
		Modifier = modifier,
		Mass = mass,
		Seed = rng:NextInteger(1, 2 ^ 30),
		Value = if Config.Tiers[tier] then GeodeGen.value(tier, rarity, modifier, mass) else 0,
		ConfigVersion = Config.Version,
		Found = os.time(),
		Favorite = false,
		Solo = true,
	}
	if Profiles.grantSpecimen(player, "tower:" .. id, specimen, "Tower") then
		data.TowerPity = TowerRules.pityAfter(misses, true)
		return species
	end
	data.TowerPity = TowerRules.pityAfter(misses, false)
	return nil
end

local function grant(run: Run, floor: number, cleared: boolean): (number, string?)
	local coins = if cleared then TowerRules.reward(floor) else 0
	local xp = TowerRules.xp(floor, cleared)
	local drop: string? = nil
	run.Xp += xp
	for _, p in run.Members do
		local data = Profiles.get(p)
		if data and runOf[p] == run and not Profiles.isReleased(p) then
			data.Cash = (tonumber(data.Cash) or 0) + coins
			if cleared and floor > best(p) then
				data.TowerBest = floor
			end
			for unitId, petId in run.PetIds do
				if string.sub(unitId, 1, #tostring(p.UserId) + 1) == p.UserId .. ":" then
					addXp(p, petId, xp)
				end
			end
			if cleared then
				drop = rollDrop(p, floor)
				QuestService.bump(p, "TowerFloors", 1)
			end
			run.Coins[p.UserId] = (run.Coins[p.UserId] or 0) + coins
			Profiles.changed(p)
		end
	end
	return coins, drop
end

local function endFloor(run: Run)
	local r = run.Rules
	local cleared = r.State == "Cleared"
	-- A loss pays its XP once per floor (a revive and second loss on the same floor pays nothing more).
	local coins, drop = 0, nil
	if cleared or not run.LostPaid then
		coins, drop = grant(run, r.Floor, cleared)
	end
	if not cleared then
		run.LostPaid = true
	end
	run.Idle = 0
	for _, p in run.Members do
		event:FireClient(p, {
			Kind = "FloorEnd",
			Result = r.State,
			Floor = r.Floor,
			Coins = coins,
			RunCoins = run.Coins[p.UserId] or 0,
			Best = best(p),
			Xp = run.Xp,
			Drop = if drop then (TowerConfig.PetNames[drop] or drop) else nil,
			Revives = math.max(TowerConfig.Revive.Free - run.Revives, 0),
			Paid = if TowerConfig.Revive.ProductId > 0 then math.max(TowerConfig.Revive.MaxPaid - run.PaidRevives, 0) else 0,
		})
	end
end

local function hpView(r: TowerRules.Run)
	local hp = {}
	for _, list in { r.Pets, r.Mobs } do
		for _, u in list do
			hp[u.Id] = { u.Hp, u.Shield }
		end
	end
	return hp
end

local function flush(run: Run, list: { TowerRules.Event })
	if #list == 0 then
		return
	end
	broadcast(run, { Kind = "Events", List = list, Hp = hpView(run.Rules), Meters = run.Rules.Meters, Wave = run.Rules.Wave })
end

local function startRun(leader: Player)
	if runOf[leader] or leader:GetAttribute("MatchKey") ~= nil or leader:GetAttribute("InBattle") ~= nil or not Profiles.isLoaded(leader) then
		return
	end
	-- Solo (carter): one player and their pets.
	local members = { leader }
	local list: { TowerRules.TeamPet } = {}
	local specs = {}
	local petIds = {}
	local start = math.huge
	for _, p in members do
		for _, g in teamOf(p) do
			local id = p.UserId .. ":" .. tostring(g.Id)
			local xp = xpOf(p, g.Id)
			table.insert(list, { Owner = p.UserId, Id = id, Name = PetRules.label(g), Xp = xp, Pet = g })
			specs[id] = petView(g).Spec
			petIds[id] = g.Id
		end
		start = math.min(start, TowerRules.checkpoint(best(p)))
	end
	if #list == 0 then
		event:FireClient(leader, { Kind = "Notice", Text = "Hatch a pet first! Pets fight in the tower." })
		return
	end
	local slot, arena, origin = TowerBuilder.claim()
	serial += 1
	local run: Run = {
		Key = "tower" .. serial,
		Slot = slot,
		Members = members,
		Rules = TowerRules.newRun(list, start),
		Arena = arena,
		Origin = origin,
		Coins = {},
		Idle = 0,
		SendIn = 0,
		Pending = {},
		Specs = specs,
		PetIds = petIds,
		Revives = 0,
		PaidRevives = 0,
		Xp = 0,
		LostPaid = false,
	}
	runs[run.Key] = run
	for i, p in members do
		runOf[p] = run
		p:SetAttribute("InTower", true)
		local char = p.Character
		if char then
			returnCF[p] = char:GetPivot()
		end
		moveTo(p, TowerBuilder.standCFrame(origin, i))
	end
	sendFloor(run)
end

local function leave(player: Player, stay: boolean?)
	local run = runOf[player]
	if not run then
		return
	end
	if stay then
		returnCF[player] = nil -- a hunt took them; don't pull them back to the lobby
	end
	if #run.Members <= 1 then
		closeRun(run, "Left")
		return
	end
	-- One member leaves: their pets leave the fight, the rest keep climbing.
	local idx = table.find(run.Members, player)
	if idx then
		table.remove(run.Members, idx)
	end
	for _, u in run.Rules.Pets do
		if u.Owner == player.UserId then
			u.Hp = 0
		end
	end
	run.Rules.Meters[player.UserId] = nil
	runOf[player] = nil
	player:SetAttribute("InTower", nil)
	event:FireClient(player, { Kind = "Closed", Why = "Left" })
	local back = returnCF[player]
	returnCF[player] = nil
	if back then
		moveTo(player, lobbySpot(back))
	end
	if run.Rules.State == "Fighting" then
		local ev = {}
		local alive = false
		for _, u in run.Rules.Pets do
			alive = alive or u.Hp > 0
		end
		if not alive then
			run.Rules.State = "Lost"
			table.insert(ev, { Kind = "Lost" })
			flush(run, ev)
			endFloor(run)
		end
	end
end

-- BuyRevive may re-open the Roblox purchase prompt at most once per PROMPT_GAP seconds (weak keys: leavers drop out).
local PROMPT_GAP = 3
local PROMPT_HOLD = 120 -- at most this long the idle clock waits on an open revive prompt
-- Each start builds a whole arena (TowerBuilder.claim) and a leave destroys it, so arena builds are spaced per
-- player: at most one per START_GAP seconds. A Start inside the gap is never dropped; it waits for the gap (one
-- waiting Start per player; a Leave calls it off), so Start/Leave spam cannot rebuild arenas several times a second.
local START_GAP = 3
local lastStart: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any
local pendingStart: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any
local startToken = 0

local function requestStart(player: Player)
	if runOf[player] or pendingStart[player] then
		return -- already climbing, or a start is already on its way
	end
	local function go()
		lastStart[player] = os.clock()
		startRun(player)
	end
	local wait = (lastStart[player] or -math.huge) + START_GAP - os.clock()
	if wait <= 0 then
		go()
		return
	end
	startToken += 1
	local my = startToken
	pendingStart[player] = my
	task.delay(wait, function()
		if pendingStart[player] ~= my then
			return
		end
		pendingStart[player] = nil
		if player.Parent and not runOf[player] then
			go()
		end
	end)
end
local lastPrompt: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any

local function onAction(player: Player, msg: any)
	if type(msg) ~= "table" or type(msg.Op) ~= "string" then
		return
	end
	local now = os.clock()
	local op = msg.Op
	-- Only the team edits (each one scans the inventory) are rate-dropped. Every other op is guarded by state
	-- instead (Start: one arena build per START_GAP, deferred, never dropped; Next/Revive: floor state; Special:
	-- the meter; BuyRevive: PROMPT_GAP; Open: rosterSoon), so a burst of team edits can never swallow a Start.
	if op == "SetTeam" or op == "EquipBest" then
		if now - (lastAction[player] or 0) < ACTION_GAP then
			return
		end
		lastAction[player] = now
	end
	local run = runOf[player]
	if op == "Open" then
		rosterSoon(player)
	elseif op == "SetTeam" then
		if run or type(msg.Pets) ~= "table" or #msg.Pets > TowerConfig.TeamSize * 2 then
			return -- oversized lists are refused before any inventory scan
		end
		local ids, seen = {}, {}
		for i = 1, #msg.Pets do
			local id = msg.Pets[i]
			if #ids >= TowerConfig.TeamSize then
				break
			end
			if type(id) == "string" and not seen[id] and petById(player, id) then
				seen[id] = true
				table.insert(ids, id)
			end
		end
		setShared(player, ids)
		rosterSoon(player)
	elseif op == "EquipBest" then
		-- No saved picks = the strongest pets (teamOf).
		if not run then
			setShared(player, nil)
			rosterSoon(player)
		end
	elseif op == "Start" then
		requestStart(player)
	elseif op == "Special" then
		if run then
			local wave = run.Rules.Wave
			local ok, ev = TowerRules.useSpecial(run.Rules, player.UserId, math.random())
			if ok then
				for _, e in ev do
					table.insert(run.Pending, e)
				end
				flush(run, run.Pending)
				run.Pending = {}
				if run.Rules.State == "Fighting" and run.Rules.Wave ~= wave then
					sendFloor(run)
				end
				if run.Rules.State ~= "Fighting" then
					endFloor(run)
				end
			end
		end
	elseif op == "Next" then
		-- Any member may continue once the floor is cleared; a lost run can only be left.
		if run and run.Rules.State == "Cleared" then
			run.LostPaid = false
			TowerRules.startFloor(run.Rules, run.Rules.Floor + 1)
			sendFloor(run)
		end
	elseif op == "Revive" then
		-- Free revive(s) per climb (TowerConfig.Revive.Free). Paid revives are "BuyRevive" below (Robux product).
		if run and run.Rules.State == "Lost" and run.Revives < TowerConfig.Revive.Free and TowerRules.revive(run.Rules) then
			run.Revives += 1
			run.Idle = 0
			sendFloor(run)
		end
	elseif op == "BuyRevive" then
		-- Uses a revive the player already paid for, else opens the Roblox purchase prompt. Nothing is granted
		-- by the prompt; TowerService.processReceipt adds the credit.
		if run and run.Rules.State == "Lost" and TowerConfig.Revive.ProductId > 0 and run.PaidRevives < TowerConfig.Revive.MaxPaid then
			if not TowerService.useCredit(player) and now - (lastPrompt[player] or 0) >= PROMPT_GAP then
				lastPrompt[player] = now
				-- the idle clock waits while the Roblox purchase prompt is open (capped, so a lost prompt cannot hold
				-- an arena forever); the receipt or the prompt closing ends the wait
				run.Idle = 0
				run.PromptUntil = now + PROMPT_HOLD
				pcall(MarketplaceService.PromptProductPurchase, MarketplaceService, player, TowerConfig.Revive.ProductId)
			end
		end
	elseif op == "Leave" then
		pendingStart[player] = nil -- a Start still waiting for its gap is called off
		leave(player)
	end
end

local function credits(data: any): number
	local c = data and data.TowerReviveCredits
	return if type(c) == "number" and c == c then math.max(math.floor(c), 0) else 0
end

-- Spends one paid revive credit on the player's lost floor. False when there is nothing to spend or revive.
function TowerService.useCredit(player: Player): boolean
	local run = runOf[player]
	local data = Profiles.get(player)
	if not run or not data or credits(data) <= 0 then
		return false
	end
	if run.Rules.State ~= "Lost" or run.PaidRevives >= TowerConfig.Revive.MaxPaid then
		return false
	end
	if not TowerRules.revive(run.Rules) then
		return false
	end
	data.TowerReviveCredits = credits(data) - 1
	run.PaidRevives += 1
	run.Idle = 0
	Profiles.changed(player)
	sendFloor(run)
	return true
end

-- Revive Developer Product receipt. StoreService owns MarketplaceService.ProcessReceipt and must hand receipts
-- for TowerConfig.Revive.ProductId here. A receipt adds one saved credit (once per PurchaseId), answered
-- PurchaseGranted only after the save; the credit is spent at once when the player is on a lost floor, else kept.
function TowerService.processReceipt(info: { PlayerId: number, PurchaseId: string, ProductId: number }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local data = player and Profiles.get(player)
	if not player or not data or Profiles.isReleased(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if type(data.TowerReceipts) ~= "table" then
		data.TowerReceipts = {}
	end
	local key = tostring(info.PurchaseId)
	if not table.find(data.TowerReceipts, key) then
		table.insert(data.TowerReceipts, key)
		while #data.TowerReceipts > 50 do
			table.remove(data.TowerReceipts, 1)
		end
		data.TowerReviveCredits = credits(data) + 1
		Profiles.changed(player, true)
	end
	if not Profiles.saveNow(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	TowerService.useCredit(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Studio-only dev shortcut (DevCommands.server, "/boss N"): jumps the caller's tower run to boss floor N (rounded up
-- to the next boss floor; no N = the next boss floor above the current one). Refused outside Studio.
function TowerService.devJump(player: Player, floor: number?): (boolean, string)
	if not RunService:IsStudio() then
		return false, "studio only"
	end
	local run = runOf[player]
	if not run then
		return false, "enter the tower first"
	end
	local every = TowerConfig.BossEvery
	local want = if floor then math.max(math.floor(floor), 1) else run.Rules.Floor + 1
	local boss = math.ceil(want / every) * every
	run.Idle = 0
	run.LostPaid = false
	TowerRules.startFloor(run.Rules, boss)
	sendFloor(run)
	return true, "boss floor " .. boss
end

-- Shared with Pet Battle / training (PvpService): the same team, XP book and pet card data as the tower.
function TowerService.team(player: Player): { any }
	return teamOf(player)
end
function TowerService.setTeam(player: Player, ids: { string }?)
	setShared(player, ids)
end
TowerService.xpOf = xpOf
TowerService.addXp = addXp
TowerService.petView = petView
TowerService.petById = petById
function TowerService.inTower(player: Player): boolean
	return runOf[player] ~= nil
end

function TowerService.start()
	local folder = Instance.new("Folder")
	folder.Name = "TowerNet"
	action = Instance.new("RemoteEvent")
	action.Name = "TowerAction"
	action.Parent = folder
	event = Instance.new("RemoteEvent")
	event.Name = "TowerEvent"
	event.Parent = folder
	folder.Parent = ReplicatedStorage

	action.OnServerEvent:Connect(onAction)
	-- The lobby's TowerPortal (MapHooks tags it with the TowerPortal attribute): walking in opens the team picker.
	local touchedAt: { [Player]: number } = {}
	local function hookPortal(d: Instance)
		if d:IsA("BasePart") and d:GetAttribute("TowerPortal") == true and not d:GetAttribute("TowerHooked") then
			d:SetAttribute("TowerHooked", true)
			d.Touched:Connect(function(hit)
				local char = hit.Parent
				local p = char and Players:GetPlayerFromCharacter(char)
				if not p or runOf[p] or p:GetAttribute("MatchKey") ~= nil then
					return
				end
				local now = os.clock()
				if now - (touchedAt[p] or 0) < 4 then
					return
				end
				touchedAt[p] = now
				roster(p)
			end)
		end
	end
	for _, d in Workspace:GetDescendants() do
		hookPortal(d)
	end
	Workspace.DescendantAdded:Connect(hookPortal)
	-- The attribute can be set after the part is added (MapHooks runs once the map is in place).
	task.delay(10, function()
		for _, d in Workspace:GetDescendants() do
			hookPortal(d)
		end
	end)
	-- A closed or failed revive prompt brings the "fainted" card back (paid ones revive via the receipt).
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
		local p = Players:GetPlayerByUserId(userId)
		local run = p and runOf[p]
		if run and productId == TowerConfig.Revive.ProductId then
			run.PromptUntil = nil
			run.Idle = 0 -- a fresh idle window from the moment the prompt closed
			if not purchased and run.Rules.State == "Lost" then
				endFloor(run)
			end
		end
	end)
	local function watch(p: Player)
		-- A hunt that starts for a climber takes them out of the tower; a respawn puts them back on the floor.
		p:GetAttributeChangedSignal("MatchKey"):Connect(function()
			if p:GetAttribute("MatchKey") ~= nil and runOf[p] then
				leave(p, true)
			end
		end)
		p.CharacterAdded:Connect(function()
			local run = runOf[p]
			if run then
				task.defer(function()
					local i = table.find(run.Members, p)
					if i and runOf[p] == run then
						moveTo(p, TowerBuilder.standCFrame(run.Origin, i))
					end
				end)
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, p in Players:GetPlayers() do
		watch(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		leave(p)

		lastAction[p] = nil
		touchedAt[p] = nil
		rosterAt[p] = nil
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < TowerConfig.Tick then
			return
		end
		local step = math.min(acc, 0.5)
		acc = 0
		for _, run in runs do
			local r = run.Rules
			local hold = run.HoldLeft
			if r.State == "Fighting" and hold then
				-- the theme title is on screen: the pets wait for it (no hit lands under the pill)
				run.HoldLeft = if hold - step > 0 then hold - step else nil
			elseif r.State == "Fighting" then
				local before = r.Wave
				for _, e in TowerRules.step(r, step) do
					table.insert(run.Pending, e)
				end
				run.SendIn -= step
				-- Hit batches go out at most every SEND_EVERY; wave and floor changes go out at once.
				local changed = r.Wave ~= before or r.State ~= "Fighting"
				if #run.Pending > 0 and (run.SendIn <= 0 or changed) then
					flush(run, run.Pending)
					run.Pending = {}
					run.SendIn = SEND_EVERY
				end
				if r.Wave ~= before and r.State == "Fighting" then
					sendFloor(run)
				end
				if r.State ~= "Fighting" then
					endFloor(run)
				end
			elseif not (run.PromptUntil and os.clock() < run.PromptUntil) then
				run.Idle += step
				if run.Idle >= IDLE_LIMIT then
					closeRun(run, "Idle")
				end
			end
		end
	end)
end

return TowerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="270">
        <Properties>
          <string name="Name">TreeBoardService</string>
          <string name="Source"><![CDATA[--!strict
-- Leaderboard tree (owner pick 2026-10-14; rules in shared/TreeBoard). The top players by best pet POWER (Boards
-- "Power", read by LeaderboardService from its OrderedDataStore) stand on the branches of a giant tree in the lobby
-- centre, each shown by their strongest pet as a live model (PetDisplay animates server-built pets) with a glowing
-- "#1 Name / POWER 1,234" sign.
--
-- The tree: a "LeaderboardTree" model in the lobby map; else one in ServerStorage is cloned onto the part
-- "LeaderboardTreeSpot"; else, with only the spot, a simple chunky stand-in tree is built there (REPLACE with the
-- Blender tree). Branch points: Attachments (or parts) named Branch1..N anywhere in the tree, Branch1 = the top spot.
-- A part "BattlePad" in the tree (or a round pad made in front of it) gets the attribute PvpPad, so PvpService opens
-- the BATTLE card when someone steps on it. An Attachment (or part) "DragonPerch" in the tree is where the Void Dragon
-- statue stands (server/VoidStatue.perch; optional attribute Height = the dragon's height in studs).
--
-- Cards: each player's best pet look + power is saved (TreeBoard.card) in the DataStore TreeBoard.Config.Store when
-- it changes, at most once per CardWriteSeconds, so other servers can draw offline players' pets. Everything that
-- touches a DataStore is pcall'd: a failure draws the branch with its sign and no pet, never an error.

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TreeBoard = require(Shared.TreeBoard)
local GeodeModel = require(Shared.GeodeModel)
local PetModel = require(Shared.PetModel)
local Profiles = require(script.Parent.Profiles)
local Leaderboards = require(script.Parent.LeaderboardService)
local VoidStatue = require(script.Parent.VoidStatue)

local TreeBoardService = {}

local C = TreeBoard.Config
local SUFFIX = if RunService:IsStudio() then "_Studio" else ""

local tree: Instance? = nil
local branches: { CFrame } = {}
local display: Folder? = nil
local store: any = nil
local cards: { [number]: { Card: TreeBoard.Card?, At: number } } = {} -- userId -> card (nil = none) + read time
local written: { [number]: TreeBoard.Card } = {}
local lastWrite: { [number]: number } = {}
local lastDraw = -math.huge
local drawQueued = false
local loadCard = function(userId: number): any
	return store and store:GetAsync(tostring(userId))
end
local saveCard = function(userId: number, card: TreeBoard.Card)
	if store then
		store:SetAsync(tostring(userId), card)
	end
end

-- Tests only: replace the card store reads / writes.
function TreeBoardService.setStore(load: (number) -> any, save: (number, TreeBoard.Card) -> ())
	loadCard, saveCard = load, save
	table.clear(cards)
	table.clear(written)
	table.clear(lastWrite)
end

-- Tree ---------------------------------------------------------------------------------------------------------------

local function branchCFrames(t: Instance): { CFrame }
	local list: { { N: number, CF: CFrame } } = {}
	for _, d in t:GetDescendants() do
		local n = tonumber(string.match(d.Name, "^Branch(%d+)$"))
		if n then
			if d:IsA("Attachment") then
				table.insert(list, { N = n, CF = d.WorldCFrame })
			elseif d:IsA("BasePart") then
				table.insert(list, { N = n, CF = d.CFrame * CFrame.new(0, d.Size.Y / 2, 0) })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.N < b.N
	end)
	local out = {}
	for _, e in list do
		table.insert(out, e.CF)
	end
	return out
end

-- A chunky stand-in tree (REPLACE with the Blender LeaderboardTree): trunk, leaf blobs and Branch1..N attachments in
-- a rising spiral, the top one above the crown.
local function standInTree(spot: BasePart): Model
	local m = Instance.new("Model")
	m.Name = C.Model
	local base = spot.CFrame * CFrame.new(0, spot.Size.Y / 2, 0)
	local function part(name: string, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Shape = shape or Enum.PartType.Block
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = true
		p.Parent = m
		return p
	end
	local trunk = part("Trunk", Vector3.new(40, 9, 9), base * CFrame.new(0, 20, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(120, 82, 52), Enum.PartType.Cylinder)
	m.PrimaryPart = trunk
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		part("Leaves", Vector3.new(16, 16, 16), base * CFrame.new(math.cos(a) * 9, 40 + (i % 2) * 4, math.sin(a) * 9), Color3.fromRGB(92, 176, 82), Enum.PartType.Ball)
	end
	part("Leaves", Vector3.new(20, 20, 20), base * CFrame.new(0, 48, 0), Color3.fromRGB(104, 190, 90), Enum.PartType.Ball)
	for k = 1, C.Branches do
		local at = Instance.new("Attachment")
		at.Name = "Branch" .. k
		at.Parent = trunk -- parent first: WorldCFrame on a loose Attachment is kept as a local offset
		if k == 1 then
			at.WorldCFrame = base * CFrame.new(0, 38, -23) -- out in front, under the crown (the Void Dragon stands on top)
		else
			local a = (k - 2) / (C.Branches - 1) * math.pi * 2
			local h = 46 - (k - 2) * 3.6
			at.WorldCFrame = base * CFrame.new(math.cos(a) * 21, h, math.sin(a) * 21) * CFrame.Angles(0, -a + math.pi / 2, 0)
		end
		local limb = part("Limb", Vector3.new(1.6, 1.6, 1.6), at.WorldCFrame * CFrame.new(0, -0.8, 0), Color3.fromRGB(110, 76, 48))
		limb.Size = Vector3.new(4, 1.4, 4)
	end
	local perch = Instance.new("Attachment")
	perch.Name = "DragonPerch"
	perch.Parent = trunk
	perch.WorldCFrame = base * CFrame.new(0, 57.5, 0)
	return m
end

-- Where the Void Dragon stands on the tree, and its height (attribute Height), or nil when the tree has no perch.
local function perchOf(t: Instance): (CFrame?, number?)
	local p = t:FindFirstChild("DragonPerch", true)
	local h = p and p:GetAttribute("Height")
	local height = if type(h) == "number" then h else nil
	if p and p:IsA("Attachment") then
		return p.WorldCFrame, height
	elseif p and p:IsA("BasePart") then
		p.Transparency = 1
		p.CanCollide = false
		return p.CFrame * CFrame.new(0, p.Size.Y / 2, 0), height
	end
	return nil, nil
end

local function findTree(roots: { Instance }): Instance?
	for _, r in roots do
		local t = r:FindFirstChild(C.Model, true)
		if t then
			return t
		end
	end
	local spot: BasePart? = nil
	for _, r in roots do
		local s = r:FindFirstChild(C.Spot, true)
		if s and s:IsA("BasePart") then
			spot = s
			break
		end
	end
	if not spot then
		return nil
	end
	local stored = ServerStorage:FindFirstChild(C.Model, true)
	local t: Model
	if stored and stored:IsA("Model") then
		t = stored:Clone()
		local _, size = t:GetBoundingBox()
		t:PivotTo(spot.CFrame * CFrame.new(0, spot.Size.Y / 2 + size.Y / 2, 0))
	else
		t = standInTree(spot)
	end
	t.Parent = spot.Parent
	return t
end

local function ensurePad(t: Instance)
	local pad = t:FindFirstChild(C.Pad, true)
	if not (pad and pad:IsA("BasePart")) then
		local cf: CFrame, size: Vector3
		if t:IsA("Model") then
			cf, size = t:GetBoundingBox()
		elseif t:IsA("BasePart") then
			cf, size = t.CFrame, t.Size
		else
			return
		end
		local p = Instance.new("Part")
		p.Name = C.Pad
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.6, 10, 10)
		p.Color = Color3.fromRGB(230, 70, 60)
		p.Material = Enum.Material.Neon
		p.Anchored = true
		p.CanCollide = false
		local bottom = cf.Position - Vector3.new(0, size.Y / 2, 0)
		local front = cf.LookVector * (math.max(size.X, size.Z) / 2 + 8)
		p.CFrame = CFrame.new(bottom + front + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(160, 44)
		gui.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
		gui.MaxDistance = 80
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromScale(1, 1)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = "BATTLE"
		l.TextColor3 = Color3.fromRGB(255, 236, 200)
		l.TextStrokeTransparency = 0
		l.Parent = gui
		gui.Parent = p
		p.Parent = t
		pad = p
	end
	(pad :: BasePart):SetAttribute("PvpPad", true)
end

-- Cards ---------------------------------------------------------------------------------------------------------------

-- Saves the player's best-pet card when it changed (and not more often than CardWriteSeconds). Returns true if saved.
function TreeBoardService.noteChange(player: Player): boolean
	local data = Profiles.get(player)
	if not data then
		return false
	end
	local pet, power = TreeBoard.bestPet(data)
	local card = TreeBoard.card(pet, power)
	local uid = player.UserId
	if card then
		cards[uid] = { Card = card, At = os.clock() } -- live players draw from their own profile
	end
	if not TreeBoard.cardChanged(written[uid], card) then
		return false
	end
	local now = os.clock()
	if lastWrite[uid] and now - lastWrite[uid] < C.CardWriteSeconds then
		return false
	end
	lastWrite[uid] = now
	local ok: boolean, err: any = pcall(function()
		saveCard(uid, card :: TreeBoard.Card)
	end)
	if ok then
		written[uid] = card :: TreeBoard.Card
	else
		warn("[TreeBoard] card not saved:", err)
	end
	return ok
end

local function cardFor(uid: number): TreeBoard.Card?
	local c = cards[uid]
	if c and (os.clock() - c.At < C.CardCacheSeconds or Players:GetPlayerByUserId(uid)) then
		return c.Card
	end
	local ok, raw = pcall(loadCard, uid)
	local card = if ok and type(raw) == "table" then TreeBoard.card(raw, raw.Power) else nil
	if ok then
		cards[uid] = { Card = card, At = os.clock() }
	elseif c then
		return c.Card -- keep the last good one
	end
	return card
end

-- Drawing ----------------------------------------------------------------------------------------------------------------

local function sign(parent: Instance, rank: number, name: string, power: number)
	local top, bottom = TreeBoard.signLines(rank, name, power)
	local gui = Instance.new("BillboardGui")
	gui.Name = "TreeSign"
	-- Sized in studs (scale), so far signs shrink and do not pile into one block of text.
	gui.Size = if rank == 1 then UDim2.fromScale(11, 3.2) else UDim2.fromScale(8, 2.5)
	gui.StudsOffsetWorldSpace = Vector3.new(0, TreeBoard.petHeight(rank) + 1.5, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	local col = TreeBoard.signColor(rank)
	local function line(text: string, y: number, h: number)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0, y)
		l.Size = UDim2.fromScale(1, h)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = text
		l.TextColor3 = col
		l.TextStrokeTransparency = 0
		l.TextStrokeColor3 = Color3.fromRGB(30, 24, 18)
		l.Parent = gui
	end
	line(top, 0, 0.56)
	line(bottom, 0.56, 0.44)
	gui.Parent = parent
end

-- Redraws the tree from the "Power" board rows. Returns the plan drawn (tests).
function TreeBoardService.draw(): { any }
	local t = tree
	local f = display
	if not t or not f then
		return {}
	end
	local state = Leaderboards.get("Power")
	local plan = TreeBoard.plan(state.Rows, #branches)
	if #plan > 0 then
		lastDraw = os.clock() -- an empty board (still loading) does not hold back the first real draw
	end
	local fresh = Instance.new("Folder")
	fresh.Name = "TreePets"
	for _, e in plan do
		local at = branches[e.Branch]
		local holder = Instance.new("Part")
		holder.Name = "Branch" .. e.Branch .. "Spot"
		holder.Size = Vector3.new(1, 1, 1)
		holder.Transparency = 1
		holder.Anchored = true
		holder.CanCollide, holder.CanQuery, holder.CanTouch = false, false, false
		holder.CFrame = at
		holder:SetAttribute("UserId", e.UserId)
		holder:SetAttribute("Rank", e.Rank)
		holder.Parent = fresh
		sign(holder, e.Rank, e.Name, e.Power)
		local card = cardFor(e.UserId)
		if card then
			local ok, m = pcall(function()
				local model = GeodeModel.build(card :: any, { Lod = true, NoLight = true })
				PetModel.fitHeight(model, TreeBoard.petHeight(e.Rank))
				return model
			end)
			if ok and m then
				for _, d in m:GetDescendants() do
					if d:IsA("BasePart") then
						d.Anchored = true
						d.CanCollide, d.CanQuery, d.CanTouch = false, false, false
					end
				end
				local _, size = m:GetBoundingBox()
				m:PivotTo(at * CFrame.new(0, size.Y / 2, 0))
				m.Name = "TreePet"
				local glow = Instance.new("PointLight")
				glow.Color = TreeBoard.signColor(e.Rank)
				glow.Range = if e.Rank == 1 then 16 else 10
				glow.Brightness = if e.Rank == 1 then 2 else 1.2
				glow.Parent = holder
				CollectionService:AddTag(m, "PetSpin") -- turns slowly on the spot (PetDisplay; cosmetic)
				m.Parent = holder
			end
		end
	end
	local old = f:FindFirstChild("TreePets")
	fresh.Parent = f
	if old then
		old:Destroy()
	end
	return plan
end

local function queueDraw()
	if drawQueued then
		return
	end
	drawQueued = true
	task.delay(math.max(0, C.RefreshSeconds - (os.clock() - lastDraw)), function()
		drawQueued = false
		pcall(TreeBoardService.draw)
	end)
end

-- Test hooks: the tree and its branch points.
function TreeBoardService.tree(): (Instance?, { CFrame })
	return tree, branches
end

-- `roots`: the lobby map(s) (never the arenas). No tree and no spot: nothing is built (one warn).
function TreeBoardService.start(roots: { Instance })
	if not C.Enabled then
		return -- no tree in the lobby by design (TreeBoard.Config.Enabled), so no warning either
	end
	pcall(function()
		store = DataStoreService:GetDataStore(C.Store .. SUFFIX)
	end)
	tree = findTree(roots)
	local t = tree
	if not t then
		warn("[TreeBoard] no LeaderboardTree or LeaderboardTreeSpot in the lobby; the leaderboard tree is skipped")
		return
	end
	branches = branchCFrames(t)
	ensurePad(t)
	local perch, perchHeight = perchOf(t)
	if perch then
		local ok, err = pcall(VoidStatue.perch, roots[1], perch, perchHeight)
		if not ok then
			warn("[TreeBoard] Void Dragon perch failed: " .. tostring(err))
		end
	end
	local f = Instance.new("Folder")
	f.Name = "TreeBoardDisplay"
	f.Parent = t
	display = f
	Profiles.onChanged(function(player)
		task.defer(TreeBoardService.noteChange, player)
	end)
	Profiles.onLoaded(function(player)
		task.defer(TreeBoardService.noteChange, player)
	end)
	Leaderboards.onUpdated(function(board: string)
		if board == "Power" then
			queueDraw()
		end
	end)
	task.defer(function()
		pcall(TreeBoardService.draw)
	end)
end

return TreeBoardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="271">
        <Properties>
          <string name="Name">VoidStatue</string>
          <string name="Source"><![CDATA[--!strict
-- The dream pet on show: a giant Void Dragon statue in the lobby with "1 in 1000" on its plinth, so every new player
-- sees the rarest pet in the first minute. Built once at boot from the same procedural pet model the game draws
-- everywhere (shared/PetModel), so it matches the real pet. REPLACE: a hand-made statue mesh from the Blender helper.
--
-- Where: a Part named MapNames.VoidStatueSpot anywhere in the lobby map (the statue faces the Part's LookVector);
-- without one it stands a little in front of the lobby spawn, facing the spawn. When the leaderboard tree has a
-- DragonPerch (server/TreeBoardService), the statue is rebuilt there with no plinth: VoidStatue.perch.

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local MapNames = require(Shared.MapNames)
local PetModel = require(Shared.PetModel)
local Retention = require(Shared.Retention)

local VoidStatue = {}

VoidStatue.Species = "CosmicDragon" -- Config.Minerals: "Void Dragon", the Space zone's 1 in 1000 chase pet
VoidStatue.Height = 16 -- studs, the dragon alone
VoidStatue.Fallback = CFrame.new(-20, 0, -30) -- from the lobby spawn when the map has no spot
VoidStatue.SignGap = 3 -- studs between the top of the dragon (its bounding box, plus the hover) and the sign's bottom
VoidStatue.Hover = 0.8 -- the client's breathing hover lifts the dragon up to this much (client/VoidStatueFx)

local function part(parent: Instance, name: string, shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function sign(face: BasePart, top: string, bottom: string)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "StatueSign"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = face
	type Line = { Name: string, Text: string, Y: number, H: number, Color: Color3 }
	local lines: { Line } = {
		{ Name = "Title", Text = top, Y = 0, H = 0.42, Color = Color3.fromRGB(240, 140, 255) },
		{ Name = "Odds", Text = bottom, Y = 0.4, H = 0.34, Color = Color3.fromRGB(255, 214, 64) },
		{ Name = "Source", Text = Retention.DreamSource, Y = 0.74, H = 0.24, Color = Color3.fromRGB(255, 255, 255) },
	}
	for _, line in lines do
		local l = Instance.new("TextLabel")
		l.Name = line.Name
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0.04, line.Y)
		l.Size = UDim2.fromScale(0.92, line.H)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = line.Text
		l.TextColor3 = line.Color
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 4
		stroke.Color = Color3.fromRGB(30, 20, 60)
		stroke.Parent = l
		l.Parent = gui
	end
end

local function findSpot(root: Instance?): BasePart?
	for _, where in { root, Workspace } do
		if where then
			local p = where:FindFirstChild(MapNames.VoidStatueSpot, true)
			if p and p:IsA("BasePart") then
				return p
			end
		end
	end
	return nil
end

-- Big floating "VOID DRAGON / 1 in 1000" sign over the dragon's head, readable from the spawn (the client pulses it).
-- `at` = the statue's facing, `headY` = the world height of the top of the dragon: the sign's bottom edge sits
-- SignGap studs over it (Studio 2026-10-14: a fixed offset clipped into the head of a Height 30 dragon).
local function floatingSign(model: Model, at: CFrame, headY: number, height: number)
	local w, h = math.max(14, height * 0.9), math.max(6, height * 0.4)
	local centre = CFrame.new(at.Position.X, headY + VoidStatue.SignGap + h / 2, at.Position.Z) * at.Rotation
	local anchor = part(model, "SignAnchor", Enum.PartType.Block, Vector3.new(0.2, 0.2, 0.2), centre, Color3.new(1, 1, 1))
	anchor.Transparency = 1
	anchor.CanCollide = false
	anchor.CanQuery = false
	local bb = Instance.new("BillboardGui")
	bb.Name = "StatueSign"
	bb.Size = UDim2.fromScale(w, h)
	bb.LightInfluence = 0
	bb.MaxDistance = 600
	bb.Parent = anchor
	type Line = { Name: string, Text: string, Y: number, H: number, Color: Color3 }
	local lines: { Line } = {
		{ Name = "Title", Text = "VOID DRAGON", Y = 0, H = 0.42, Color = Color3.fromRGB(240, 140, 255) },
		{ Name = "Odds", Text = "1 in 1000", Y = 0.4, H = 0.34, Color = Color3.fromRGB(255, 214, 64) },
		{ Name = "Source", Text = Retention.DreamSource, Y = 0.74, H = 0.24, Color = Color3.fromRGB(255, 255, 255) },
	}
	for _, line in lines do
		local l = Instance.new("TextLabel")
		l.Name = line.Name
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0, line.Y)
		l.Size = UDim2.fromScale(1, line.H)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = line.Text
		l.TextColor3 = line.Color
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 4
		stroke.Color = Color3.fromRGB(30, 20, 60)
		stroke.Parent = l
		l.Parent = bb
	end
end

-- Builds the statue (once). `root` = the lobby root, `spawn` = the lobby spawn CFrame. Returns the statue model.
-- The spot Part may carry attributes: Height (number, the dragon's height in studs, default VoidStatue.Height) and
-- Plinth (boolean, default true; false = no code plinth, the dragon stands on the spot's top). The client animates
-- it (client/VoidStatueFx: breathing hover, orbiting sparkles, pulsing "1 in 1000").
function VoidStatue.build(root: Instance, spawn: CFrame?, perch: CFrame?, perchHeight: number?): Model?
	local old = root:FindFirstChild("VoidDragonStatue")
	if old then
		return old :: Model
	end
	local spot = if perch then nil else findSpot(root)
	local at: CFrame
	local height = VoidStatue.Height
	local withPlinth = true
	if perch then
		-- on the leaderboard tree's top: no plinth, facing the perch's front
		local p = perch.Position
		local look = Vector3.new(perch.LookVector.X, 0, perch.LookVector.Z)
		at = CFrame.lookAt(p, p + (if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, 1)))
		if perchHeight and perchHeight > 2 and perchHeight < 200 then
			height = perchHeight
		end
		withPlinth = false
	elseif spot then
		local p = spot.Position + Vector3.new(0, spot.Size.Y / 2, 0) -- on top of the spot
		local look = Vector3.new(spot.CFrame.LookVector.X, 0, spot.CFrame.LookVector.Z)
		at = CFrame.lookAt(p, p + (if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, 1)))
		local h = spot:GetAttribute("Height")
		if type(h) == "number" and h > 2 and h < 200 then
			height = h
		end
		withPlinth = spot:GetAttribute("Plinth") ~= false
		spot.Transparency = 1
		spot.CanCollide = false
	else
		local s = spawn or CFrame.new()
		local p = (s * VoidStatue.Fallback).Position - Vector3.new(0, 3.5, 0) -- the lobby Spawn sits 3.5 above the pad
		local face = Vector3.new(s.Position.X, p.Y, s.Position.Z)
		at = CFrame.lookAt(p, if (face - p).Magnitude > 0.1 then face else p + Vector3.new(0, 0, 1))
	end
	local k = height / VoidStatue.Height -- the plinth grows with the dragon
	local model = Instance.new("Model")
	model.Name = "VoidDragonStatue"
	local top = 0
	local glowAt: BasePart
	if withPlinth then
		-- plinth: chunky low-poly stone in two steps, a gold rim and the sign on the front
		local stone, stoneDark = Color3.fromRGB(88, 78, 140), Color3.fromRGB(60, 52, 104)
		part(model, "Base", Enum.PartType.Block, Vector3.new(16, 1.6, 16) * k, at * CFrame.new(0, 0.8 * k, 0), stoneDark, Enum.Material.Slate)
		local plinth = part(model, "Plinth", Enum.PartType.Block, Vector3.new(12, 4, 12) * k, at * CFrame.new(0, 3.6 * k, 0), stone, Enum.Material.Slate)
		part(model, "Rim", Enum.PartType.Block, Vector3.new(12.6, 0.6, 12.6) * k, at * CFrame.new(0, 5.9 * k, 0), Color3.fromRGB(255, 204, 64), Enum.Material.Foil)
		local face = part(model, "SignFace", Enum.PartType.Block, Vector3.new(10, 3, 0.2) * k, at * CFrame.new(0, 3.6 * k, -6.1 * k), Color3.fromRGB(40, 30, 80))
		face.CanCollide = false
		sign(face, "VOID DRAGON", "1 in 1000")
		plinth:SetAttribute("Hint", Retention.DreamHint)
		model.PrimaryPart = plinth
		glowAt = plinth
		top = 6.2 * k
	else
		local base = part(model, "Base", Enum.PartType.Block, Vector3.new(1, 0.2, 1), at, Color3.new(1, 1, 1))
		base.Transparency = 1
		base.CanCollide = false
		base.CanQuery = false
		model.PrimaryPart = base
		glowAt = base
	end
	local headY = at.Position.Y + top + height -- the dragon's top; measured from its parts below when it builds
	local ok, dragon = pcall(PetModel.build, { Mineral = VoidStatue.Species, Rarity = "Legendary", Modifier = "Natural", Formation = "Spire", Seed = 1000, Mass = 2 }, { NoLight = false })
	if ok and dragon then
		local d = dragon :: Model
		PetModel.fitHeight(d, height, height * 1.4)
		d.Name = "Dragon"
		d:PivotTo(at * CFrame.new(0, top, 0))
		d:SetAttribute("Home", d:GetPivot()) -- the client's breathing hover moves it around this
		d.Parent = model
		local bcf, bsize = d:GetBoundingBox()
		headY = bcf.Position.Y + bsize.Y / 2 + VoidStatue.Hover
	else
		warn("[VoidStatue] dragon model failed: " .. tostring(dragon))
	end
	floatingSign(model, at, headY, height)
	-- a purple light beam straight up from over the dragon, seen from anywhere in the lobby (neon, soft, always day)
	local beamH = 160
	for i, b in { { W = 2.2, T = 0.45 }, { W = 5, T = 0.8 } } do
		local beam = part(model, "Beam" .. i, Enum.PartType.Cylinder, Vector3.new(beamH, b.W, b.W), CFrame.new(at.Position.X, headY + beamH / 2, at.Position.Z) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(118, 72, 255), Enum.Material.Neon) -- deep void violet (190,110,255 read as pink in the lobby shots)
		beam.Transparency = b.T
		beam.CanCollide = false
		beam.CanQuery = false
		beam.CanTouch = false
		beam.CastShadow = false
	end
	-- a soft purple glow so it reads from across the lobby (always day: a soft light, not a night effect)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(140, 100, 255)
	light.Range = math.min(60, 22 * k)
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = glowAt
	model:SetAttribute("Height", height)
	model:SetAttribute("Top", top)
	model.Parent = root
	return model
end

-- Moves the statue onto the leaderboard tree: the old one (anywhere under `root` or the Workspace) is replaced by a
-- plinth-less dragon standing at `cf` (client/VoidStatueFx picks the new one up). Returns the new statue.
function VoidStatue.perch(root: Instance, cf: CFrame, height: number?): Model?
	for _, where in { root, Workspace } do
		local old = where:FindFirstChild("VoidDragonStatue", true)
		if old then
			old:Destroy()
		end
	end
	local spot = findSpot(root)
	if spot then
		spot.Transparency = 1
		spot.CanCollide = false
	end
	return VoidStatue.build(root, nil, cf, height)
end

return VoidStatue
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="272">
        <Properties>
          <string name="Name">WinnerBoard</string>
          <string name="Source"><![CDATA[--!strict
-- LAST WINNERS board in the lobby: the last few hunt winners in THIS server with the pet each one found. Memory
-- only (no DataStore, nothing saved, empty after a server restart); MatchService calls WinnerBoard.record when a
-- hunt's pet is awarded (never the practice round). Display only: it changes nothing about who wins.
--
-- Where it shows (no new props): when the map has a part named WinnersBoard (optional hook, anywhere in Workspace)
-- the rows are drawn on its front face. Otherwise a flat, see-through screen floats just above the WHAT'S NEW board
-- (MapNames.WhatsNewBoard in the hand-built lobby, or the fallback park's CT_Park_WhatsNew), facing the same way as
-- that board's text. Without either, nothing is drawn (the list is still kept).
-- With the owner's NoticeBoard mesh imported (ReplicatedStorage.WorldKit_LowPoly), that board stands beside the WHAT'S
-- NEW board instead of the floating screen and the rows go on its panel face (noticeBoard below).
-- Single-place mode only: in Teleport mode the hunts run in another server, so the lobby board stays empty.

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local MapNames = require(Shared.MapNames)
local SignLayout = require(Shared.SignLayout)
local KitPlace = require(script.Parent.KitPlace)
local WorldKit = require(Shared.WorldKit)

local WinnerBoard = {}

local KEEP = 4
local HOOK = "WinnersBoard"
local FLOAT_W_MIN, FLOAT_W_MAX = 12, 16 -- the floating screen: as wide as the WHAT'S NEW board, within these
local FLOAT_ASPECT = 0.6 -- height / width
-- Layout on the face (fractions of its height): the title band, then KEEP rows. Text sizes are explicit and fitted
-- (shared/SignLayout, like every world sign): the old TextScaled rows were about half a stud tall on a 12-stud screen.
local TITLE_Y, TITLE_H = 0.03, 0.2
local ROWS_Y, ROW_H = 0.25, 0.18

type Row = { Name: string, Pet: string, Rarity: string }
local rows: { Row } = {}
local labels: { TextLabel } = {}
local face = { W = 0, H = 0, PPS = 40 }

local function clean(s: any, max: number): string
	local t = tostring(s or "?")
	t = string.gsub(t, "[%c<>]", "")
	if #t > max then
		t = string.sub(t, 1, max - 1) .. "\u{2026}"
	end
	return t
end

local function redraw()
	-- one text size for every row: the largest that lets the longest row fit the row box (SignLayout Placard)
	local em = math.huge
	local texts: { string } = {}
	for i = 1, #labels do
		local r = rows[i]
		local plain = if r then r.Name .. "  " .. r.Pet elseif i == 1 then "No winners yet: be the first!" else ""
		texts[i] = plain
		if plain ~= "" and face.W > 0 then
			em = math.min(em, SignLayout.fit(plain, face.W * 0.9, face.H * ROW_H, "Row").Em)
		end
	end
	local size = if em < math.huge then math.clamp(math.floor(em * face.PPS), 8, 100) else 24
	for i, l in labels do
		local r = rows[i]
		if r then
			local col: Color3 = (Config.RarityTextColors :: any)[r.Rarity] or Color3.new(1, 1, 1)
			l.Text = string.format('%s  <font color="#%s">%s</font>', r.Name, col:ToHex(), r.Pet)
		else
			l.Text = texts[i]
		end
		l.TextSize = size
		local st = l:FindFirstChildOfClass("UIStroke")
		if st then
			st.Thickness = SignLayout.outlinePx(size)
		end
	end
end

-- A hunt's pet was awarded: newest first, at most KEEP rows.
function WinnerBoard.record(winnerName: string, petName: string, rarity: string?)
	table.insert(rows, 1, { Name = clean(winnerName, 18), Pet = clean(petName, 22), Rarity = tostring(rarity or "Common") })
	while #rows > KEEP do
		table.remove(rows)
	end
	redraw()
end

-- The rows on a SurfaceGui (face of `part`): sky-blue panel, gold title, white rows with a black outline.
local function draw(part: BasePart, faceId: Enum.NormalId, see: boolean)
	local W, H = KitPlace.faceSize(part, faceId)
	local title = SignLayout.fit("LAST WINNERS", W * 0.92, H * TITLE_H, "Heading")
	face.W, face.H = W, H
	face.PPS = math.clamp(title.TextSize / title.Em, 8, 60) -- the title at its preset TextSize; rows share the density
	local gui = Instance.new("SurfaceGui")
	gui.Name = "WinnersGui"
	gui.Face = faceId
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = face.PPS
	gui.LightInfluence = 0
	gui.Parent = part
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(46, 118, 206) -- sky blue like the lodge boards (the old near-black read as a slab)
	bg.BackgroundTransparency = if see then 0.15 else 0
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.06, 0)
	corner.Parent = bg
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 196, 36)
	stroke.Thickness = 4
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = bg
	local t = Instance.new("TextLabel")
	t.Name = "Title"
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromScale(0.04, TITLE_Y)
	t.Size = UDim2.fromScale(0.92, TITLE_H)
	t.Font = Enum.Font.LuckiestGuy
	t.TextScaled = false
	t.TextSize = math.min(100, math.floor(title.Em * face.PPS))
	t.TextColor3 = Color3.fromRGB(255, 196, 36)
	t.Text = "LAST WINNERS"
	t.Parent = bg
	local ts = Instance.new("UIStroke")
	ts.Color = SignLayout.Outline.Stroke
	ts.Thickness = SignLayout.outlinePx(t.TextSize)
	ts.LineJoinMode = Enum.LineJoinMode.Round
	ts.Parent = t
	table.clear(labels)
	for i = 1, KEEP do
		local l = Instance.new("TextLabel")
		l.Name = "Row" .. i
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0.05, ROWS_Y + (i - 1) * ROW_H)
		l.Size = UDim2.fromScale(0.9, ROW_H)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = false
		l.RichText = true
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextColor3 = Color3.fromRGB(255, 255, 255)
		l.Parent = bg
		local s = Instance.new("UIStroke")
		s.Color = SignLayout.Outline.Stroke
		s.LineJoinMode = Enum.LineJoinMode.Round
		s.Parent = l
		table.insert(labels, l)
	end
	redraw()
end

local function asPart(inst: Instance?): BasePart?
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst
	end
	if inst:IsA("Model") and inst.PrimaryPart then
		return inst.PrimaryPart
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

-- The part whose SurfaceGui shows the WHAT'S NEW text (its face tells which way the board looks).
local function newsFace(anchor: Instance): (BasePart?, Enum.NormalId)
	for _, d in anchor:GetDescendants() do
		if d:IsA("SurfaceGui") and d.Parent and d.Parent:IsA("BasePart") and d:FindFirstChildWhichIsA("TextLabel", true) then
			return d.Parent :: BasePart, d.Face
		end
	end
	if anchor:IsA("SurfaceGui") then
		local p = anchor.Parent
		if p and p:IsA("BasePart") then
			return p, anchor.Face
		end
	end
	return asPart(anchor), Enum.NormalId.Front
end

local FACE_DIR: { [Enum.NormalId]: Vector3 } = {
	[Enum.NormalId.Front] = Vector3.new(0, 0, -1),
	[Enum.NormalId.Back] = Vector3.new(0, 0, 1),
	[Enum.NormalId.Left] = Vector3.new(-1, 0, 0),
	[Enum.NormalId.Right] = Vector3.new(1, 0, 0),
}

-- The owner's NoticeBoard mesh (Shared.WorldKit, ReplicatedStorage.WorldKit_LowPoly), when imported: it stands on
-- the ground beside the WHAT'S NEW board (to its right as you face the news text, SIDE_GAP studs clear of it), facing
-- the same way, at its own size in studs. The rows go on an invisible panel part laid on the board's panel face.
-- ASSUMPTION (not checked in Studio): the panel is PANEL_W x PANEL_H studs and centred on the mesh's front (-Z) face,
-- i.e. its centre is the bounding-box centre moved PANEL_OFFSET (x right, y up, studs) and it sits PANEL_DEPTH studs
-- behind the box's front plane (0 = flush with the frontmost point). Adjust these constants if the text misses.
local PANEL_W, PANEL_H = 7.4, 3.3
local PANEL_OFFSET = Vector2.new(0, 0)
local PANEL_DEPTH = 0
local SIDE_GAP = 2
local function noticeBoard(box: Instance, facePart: BasePart, face: Enum.NormalId, out: Vector3, lobbyRoot: Instance?): BasePart?
	local mesh = if WorldKit.has("NoticeBoard") then WorldKit.clone("NoticeBoard", "CT_WinnersNoticeBoard") else nil
	if not mesh then
		return nil
	end
	-- the news board's footprint: its centre, floor (bottom of the whole board) and half width along its face
	local centre, size = facePart.CFrame, facePart.Size
	if box:IsA("Model") then
		centre, size = box:GetBoundingBox()
	elseif box.Parent and box.Parent:IsA("Model") and box.Parent ~= Workspace then
		centre, size = (box.Parent :: Model):GetBoundingBox()
	end
	local floorY = centre.Position.Y - size.Y / 2
	local right = out:Cross(Vector3.yAxis) -- the viewer's right when facing the news text (looking along -out)
	local halfNews = 0.5 * math.max(KitPlace.faceSize(facePart, face), 0)
	if box:IsA("Model") or (box.Parent and box.Parent:IsA("Model") and box.Parent ~= Workspace) then
		-- the bounding box is axis-aligned to the model pivot: its extent along `right`
		local r = centre:VectorToObjectSpace(right)
		halfNews = math.max(halfNews, 0.5 * (math.abs(r.X) * size.X + math.abs(r.Z) * size.Z))
	end
	local at = Vector3.new(facePart.Position.X, floorY, facePart.Position.Z) + right * (halfNews + SIDE_GAP + mesh.Size.X / 2)
	WorldKit.onFloor(mesh, CFrame.lookAt(at, at + out)) -- front (-Z) looks the same way as the news text
	mesh.CanCollide = false -- like the floating screen it replaces
	if mesh:IsA("MeshPart") and mesh.TextureID == "" then
		mesh.Color = Color3.fromRGB(176, 124, 78) -- untextured import: warm wood, never a black slab
	end
	mesh.CastShadow = true
	mesh:SetAttribute("CameraIgnore", true)
	mesh.Parent = lobbyRoot or Workspace
	local panel = Instance.new("Part")
	panel.Name = "CT_WinnersPanel"
	panel.Size = Vector3.new(PANEL_W, PANEL_H, 0.05)
	panel.CFrame = mesh.CFrame * CFrame.new(PANEL_OFFSET.X, PANEL_OFFSET.Y, -mesh.Size.Z / 2 + PANEL_DEPTH - 0.04)
	panel.Transparency = 1
	panel.Anchored = true
	panel.CanCollide = false
	panel.CanQuery = false
	panel.CanTouch = false
	panel.CastShadow = false
	panel:SetAttribute("CameraIgnore", true)
	panel.Parent = mesh
	return panel
end

function WinnerBoard.start(lobbyRoot: Instance?)
	task.spawn(function()
		task.wait(3) -- the lobby (procedural park or the owner's map hooks) is built first
		local hook = Workspace:FindFirstChild(HOOK, true)
		local hookPart = asPart(hook)
		if hookPart then
			draw(hookPart, Enum.NormalId.Front, false)
			return
		end
		local anchor: Instance? = Workspace:FindFirstChild(MapNames.WhatsNewBoard, true)
		if not anchor then
			anchor = Workspace:FindFirstChild("CT_Park_WhatsNew", true)
		end
		if not anchor and lobbyRoot then
			anchor = lobbyRoot:FindFirstChild("CT_Park_WhatsNew", true)
		end
		if not anchor then
			warn("[WinnerBoard] no WinnersBoard part and no WHAT'S NEW board: the winners board is not drawn")
			return
		end
		local facePart, face = newsFace(anchor :: Instance)
		if not facePart then
			return
		end
		-- top of the whole board (posts and heading sign included)
		local top = facePart.Position.Y + facePart.Size.Y / 2
		local box = anchor :: Instance
		if box:IsA("Model") then
			local cf, size = box:GetBoundingBox()
			top = cf.Position.Y + size.Y / 2
		elseif box.Parent and box.Parent:IsA("Model") and box.Parent ~= Workspace then
			local cf, size = (box.Parent :: Model):GetBoundingBox()
			top = math.max(top, cf.Position.Y + size.Y / 2)
		end
		local dirLocal = FACE_DIR[face] or Vector3.new(0, 0, -1)
		local out = facePart.CFrame:VectorToWorldSpace(dirLocal)
		out = Vector3.new(out.X, 0, out.Z)
		out = if out.Magnitude > 0.1 then out.Unit else Vector3.new(0, 0, -1)
		local panel = noticeBoard(box, facePart, face, out, lobbyRoot)
		if panel then
			draw(panel, Enum.NormalId.Front, false)
			return
		end
		local floatW = math.clamp(KitPlace.faceSize(facePart, face), FLOAT_W_MIN, FLOAT_W_MAX)
		local floatH = floatW * FLOAT_ASPECT
		local centre = Vector3.new(facePart.Position.X, top + 1 + floatH / 2, facePart.Position.Z)
		local screen = Instance.new("Part")
		screen.Name = "CT_WinnersScreen"
		screen.Size = Vector3.new(floatW, floatH, 0.05)
		-- Front (-Z) of the screen looks the same way as the news text
		screen.CFrame = CFrame.lookAt(centre, centre + out)
		screen.Transparency = 1
		screen.Anchored = true
		screen.CanCollide = false
		screen.CanQuery = false
		screen.CanTouch = false
		screen.CastShadow = false
		screen:SetAttribute("CameraIgnore", true)
		screen.Parent = lobbyRoot or Workspace
		draw(screen, Enum.NormalId.Front, true)
	end)
end

-- Test / preview hook: the rows as plain text.
function WinnerBoard.rows(): { Row }
	return table.clone(rows)
end

return WinnerBoard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="273">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the shared lobby and the private quarry arenas from Parts (procedural stand-ins for the
-- modular kit in docs/refs). Names use the CT_Rocks_ prefix so imported meshes can replace them
-- later. Front is -Z, up is +Y, pivots on the floor.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local KitModels = require(Shared.KitModels)
local MeshService = require(script.Parent.MeshService)
local ArenaBuilder = require(script.Parent.ArenaBuilder)

local P = Config.Palette
local World = {}

local DARK = Color3.fromRGB(52, 58, 64)

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Shape = shape or Enum.PartType.Block
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function deco(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function label(p: BasePart, face: Enum.NormalId, text: string, color: Color3?, bg: Color3?, font: Enum.Font?): TextLabel
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 40
	g.LightInfluence = 0
	g.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = bg or P.Slate
	t.BackgroundTransparency = if bg then 0 else 1
	t.TextColor3 = color or P.Yellow
	t.Font = font or Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.Parent = g
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.06, 0)
	pad.PaddingRight = UDim.new(0.06, 0)
	pad.PaddingTop = UDim.new(0.12, 0)
	pad.PaddingBottom = UDim.new(0.12, 0)
	pad.Parent = t
	return t
end

local function prompt(p: BasePart, action: string, object: string, panel: string, dist: number?)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = dist or 10
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.R -- E is the crack key on keyboards
	pp:SetAttribute("Panel", panel)
	pp.Parent = p
	return pp
end

-- Kit pieces -------------------------------------------------------------------------------

-- Rubble selling hopper. The prompt is handled on the server (EconomyService).
local function hopper(parent: Instance, cf: CFrame): Model
	local m = model(parent, "CT_Rocks_SellHopper")
	local body = part(m, "Body", Vector3.new(8, 3.5, 5), cf * CFrame.new(0, 1.75, 0), DARK, Enum.Material.Metal)
	part(m, "LipL", Vector3.new(0.6, 1.2, 5.6), cf * CFrame.new(-4, 4, 0) * CFrame.Angles(0, 0, math.rad(-20)), P.Orange, Enum.Material.Metal)
	part(m, "LipR", Vector3.new(0.6, 1.2, 5.6), cf * CFrame.new(4, 4, 0) * CFrame.Angles(0, 0, math.rad(20)), P.Orange, Enum.Material.Metal)
	for i = 1, 5 do
		deco(part(m, "Gravel", Vector3.new(1.2, 1, 1.2), cf * CFrame.new(-2.8 + i * 1.0, 3.7, (i % 2) * 0.8 - 0.4) * CFrame.Angles(i, i * 2, 0), P.Rock, Enum.Material.Slate))
	end
	-- grate bars across the mouth and a hazard band on the front
	for i = -3, 3 do
		deco(part(m, "Grate", Vector3.new(0.18, 0.18, 4.6), cf * CFrame.new(i * 1.05, 3.55, 0), Color3.fromRGB(30, 32, 36), Enum.Material.Metal))
	end
	for i = 0, 5 do
		local band = deco(part(m, "Hazard", Vector3.new(1.2, 0.5, 0.1), cf * CFrame.new(-3.3 + i * 1.32, 0.45, -2.56) * CFrame.Angles(0, 0, math.rad(30)), if i % 2 == 0 then P.Yellow else Color3.fromRGB(28, 28, 30), Enum.Material.SmoothPlastic))
		band.Name = "Hazard"
	end
	local sign = deco(part(m, "Sign", Vector3.new(6, 1.6, 0.2), cf * CFrame.new(0, 1.9, -2.6), P.Slate, Enum.Material.SmoothPlastic))
	label(sign, Enum.NormalId.Front, "SELL CANDY", P.Yellow)
	local pp = prompt(body, "Sell Candy", "Candy Stand", "", 12)
	pp.UIOffset = Vector2.new(0, 30)
	pp.Name = "SellPrompt"
	pp:SetAttribute("Sell", true)
	m:SetAttribute("Hopper", true)
	return m
end
World.hopper = hopper

-- Tool models (also used welded to characters). `scale` sizes the whole tool (EconomyService
-- fits it to the avatar). The grip part sits at the origin. Hammers extend along +Y (head at
-- HeadY); the jackhammer's handlebar lies along X at the origin with the two rubber grips at
-- x = +-GripX, and the body, chuck and silver bit hang along -Y down to the contact point at
-- TipY. These numbers are stored as attributes (already scaled) for ToolAnim, and they match
-- the CT_Rocks_* meshes from tools/gen_meshes.py, which are used instead when uploaded.
World.ToolDims = {
	Hammer = { Length = 3.93, HeadY = 3.35 },
	SteelHammer = { Length = 4.0, HeadY = 3.35 },
	Jackhammer = { Length = 3.05, TipY = -2.92, GripX = 0.7 },
}

-- Kit hand tools (Tool_*.fbx via MeshService): the origin is the grip, handle up +Y, striking faces
-- along X (jackhammer: handlebar along X, body and bit hang down -Y). `Length` is the fit length used by
-- EconomyService.attachTool: it is chosen so the head (or bit tip) ends up as far from the fist as it
-- was with the Part tools, which keeps ToolAnim's reach and the contact with the plate unchanged.
local KIT_TOOL = { Hammer = "Tool_StarterHammer", SteelHammer = "Tool_SteelHammer", Jackhammer = "Tool_Jackhammer" }
local KIT_DIMS = {
	Hammer = { Length = 3.93 * 2.85 / 3.35, HeadY = 2.85 },
	SteelHammer = { Length = 4.0 * 2.85 / 3.35, HeadY = 2.85 },
	Jackhammer = { Length = 3.05 * 3.95 / 2.92, TipY = -3.95, GripX = 1.4 },
}

-- Dimensions (Length for the avatar fit, HeadY / TipY / GripX for ToolAnim) of the tool that
-- World.toolModel builds right now: the kit version when its template is loaded, else the Part one.
function World.toolDims(toolId: string): { [string]: number }
	local kit = KIT_TOOL[toolId]
	if kit and KitModels.template(kit) then
		return KIT_DIMS[toolId]
	end
	return World.ToolDims[toolId] or World.ToolDims.Hammer
end

function World.toolModel(toolId: string, scale: number?): Model
	local sc = scale or 1
	local m = Instance.new("Model")
	m.Name = "CT_Rocks_Tool_" .. toolId
	local function tp(name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, shape: Enum.PartType?)
		local p = part(m, name, size * sc, cf.Rotation + cf.Position * sc, color, mat, shape)
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.Anchored = false
		p.CastShadow = false
		return p
	end
	-- a cylinder along Y (Roblox cylinders run along X)
	local function rod(name, len: number, dia: number, at: Vector3, color, mat)
		return tp(name, Vector3.new(len, dia, dia), CFrame.new(at) * CFrame.Angles(0, 0, math.pi / 2), color, mat, Enum.PartType.Cylinder)
	end
	-- a cylinder segment from a to b
	local function hose(name, a: Vector3, b: Vector3, dia: number, color)
		local mid = (a + b) / 2
		local len = (b - a).Magnitude
		return tp(name, Vector3.new(len + dia * 0.6, dia, dia), CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0), color, Enum.Material.Rubber, Enum.PartType.Cylinder)
	end
	local grip
	local kitTool = if KIT_TOOL[toolId] then KitModels.template(KIT_TOOL[toolId]) else nil
	local assets = game:GetService("ReplicatedStorage"):FindFirstChild("Assets")
	local meshT = assets and assets:FindFirstChild("CT_Rocks_" .. toolId)
	local STEEL = Color3.fromRGB(196, 200, 206)
	local RUBBER = Color3.fromRGB(28, 30, 34)
	if kitTool then
		-- Blender kit model: a tiny invisible Grip part at the origin, every coloured piece welded to it
		-- below (same Weld loop as the Part version, so attachment and animation work unchanged).
		grip = tp("Grip", Vector3.new(0.45, 0.45, 0.45), CFrame.new(0, 0, 0), DARK, Enum.Material.SmoothPlastic)
		grip.Transparency = 1
		for _, src in kitTool:GetChildren() do
			if src:IsA("MeshPart") then
				local mp = src:Clone()
				for _, ch in mp:GetChildren() do
					ch:Destroy()
				end
				mp.Size = src.Size * sc
				mp.CFrame = CFrame.new(src.Position * sc) * src.CFrame.Rotation
				mp.Anchored = false
				mp.CanCollide = false
				mp.CanQuery = false
				mp.CanTouch = false
				mp.Massless = true
				mp.CastShadow = false
				mp.Parent = m
			end
		end
	elseif meshT and meshT:IsA("MeshPart") then
		-- Uploaded mesh (pivot = file origin = grip). A tiny invisible Grip part sits at the origin
		-- so Motor6D / Weld attachment works exactly as for the Part version.
		grip = tp("Grip", Vector3.new(0.45, 0.45, 0.45), CFrame.new(0, 0, 0), DARK, Enum.Material.SmoothPlastic)
		grip.Transparency = 1
		local mp = meshT:Clone()
		mp.Name = "Mesh"
		mp.Color = Color3.new(1, 1, 1) -- vertex colours carry the materials
		mp.Anchored = false
		mp.CanCollide = false
		mp.CanQuery = false
		mp.CanTouch = false
		mp.Massless = true
		mp.CastShadow = false
		local po = mp.PivotOffset
		mp.Size = mp.Size * sc
		mp.PivotOffset = po.Rotation + po.Position * sc
		mp.CFrame = CFrame.identity * mp.PivotOffset:Inverse() -- origin of the file at the grip
		mp.Parent = m
	elseif toolId == "Jackhammer" then
		-- handlebar with two rubber grips, a short neck into the orange body, air inlet and a
		-- hanging hose at the back, dark chuck, long silver bit with a chisel point
		grip = tp("Grip", Vector3.new(1.7, 0.16, 0.16), CFrame.new(0, 0, 0), DARK, Enum.Material.Metal, Enum.PartType.Cylinder)
		for sx = -1, 1, 2 do
			tp("GripRubber", Vector3.new(0.34, 0.26, 0.26), CFrame.new(sx * 0.7, 0, 0), RUBBER, Enum.Material.Rubber, Enum.PartType.Cylinder)
			tp("GripCap", Vector3.new(0.06, 0.3, 0.3), CFrame.new(sx * 0.88, 0, 0), DARK, Enum.Material.Metal, Enum.PartType.Cylinder)
		end
		tp("Neck", Vector3.new(0.34, 0.36, 0.3), CFrame.new(0, -0.2, 0), DARK, Enum.Material.Metal)
		tp("Body", Vector3.new(0.72, 1.05, 0.72), CFrame.new(0, -0.88, 0), P.Orange, Enum.Material.SmoothPlastic)
		tp("BodyCap", Vector3.new(0.78, 0.12, 0.78), CFrame.new(0, -0.38, 0), DARK, Enum.Material.Metal)
		tp("Stripe", Vector3.new(0.76, 0.1, 0.76), CFrame.new(0, -0.75, 0), DARK, Enum.Material.SmoothPlastic)
		tp("Exhaust", Vector3.new(0.14, 0.32, 0.26), CFrame.new(-0.41, -1.0, 0), DARK, Enum.Material.Metal)
		tp("Inlet", Vector3.new(0.18, 0.18, 0.2), CFrame.new(0, -0.62, 0.43), DARK, Enum.Material.Metal)
		local pts = { Vector3.new(0, -0.62, 0.52), Vector3.new(0, -0.78, 0.76), Vector3.new(0.04, -1.12, 0.92), Vector3.new(0.1, -1.55, 0.95), Vector3.new(0.16, -1.95, 0.8), Vector3.new(0.2, -2.25, 0.55) }
		for i = 1, #pts - 1 do
			hose("Hose", pts[i], pts[i + 1], 0.13, RUBBER)
		end
		rod("Collar", 0.24, 0.38, Vector3.new(0, -1.5, 0), Color3.fromRGB(70, 74, 80), Enum.Material.Metal)
		rod("Shaft", 1.05, 0.13, Vector3.new(0, -2.12, 0), STEEL, Enum.Material.Metal)
		-- flat chisel blade at the contact point (bottom at TipY)
		tp("Bit", Vector3.new(0.17, 0.3, 0.06), CFrame.new(0, -2.77, 0), STEEL, Enum.Material.Metal)
	else
		local steel = toolId == "SteelHammer"
		grip = tp("Grip", Vector3.new(0.45, 1.1, 0.45), CFrame.new(0, 0, 0), RUBBER, Enum.Material.Rubber)
		tp("Handle", Vector3.new(0.36, 2.6, 0.36), CFrame.new(0, 1.8, 0), P.Orange, Enum.Material.SmoothPlastic)
		local headColor = if steel then Color3.fromRGB(64, 68, 74) else Color3.fromRGB(150, 154, 160)
		local hs = if steel then Vector3.new(2.5, 1.3, 1.3) else Vector3.new(2.2, 1.15, 1.15)
		tp("Head", hs, CFrame.new(0, 3.35, 0), headColor, Enum.Material.Metal)
		-- striking faces and a collar make the hammer shape obvious from any side
		tp("FaceL", Vector3.new(0.25, hs.Y * 1.08, hs.Z * 1.08), CFrame.new(-hs.X / 2, 3.35, 0), Color3.fromRGB(205, 208, 214), Enum.Material.Metal)
		tp("FaceR", Vector3.new(0.25, hs.Y * 1.08, hs.Z * 1.08), CFrame.new(hs.X / 2, 3.35, 0), Color3.fromRGB(205, 208, 214), Enum.Material.Metal)
		tp("Collar", Vector3.new(0.55, 0.3, 0.55), CFrame.new(0, 2.65, 0), DARK, Enum.Material.Metal)
	end
	local dims = if kitTool then KIT_DIMS[toolId] else (World.ToolDims[toolId] or World.ToolDims.Hammer)
	m:SetAttribute("Scale", sc)
	for k, v in dims do
		m:SetAttribute(k, v * sc)
	end
	-- classic Welds with explicit offsets (deterministic; also what the offline preview solves)
	for _, p in m:GetChildren() do
		if p ~= grip and p:IsA("BasePart") then
			local w = Instance.new("Weld")
			w.C0 = grip.CFrame:ToObjectSpace(p.CFrame)
			w.C1 = CFrame.identity
			w.Part0 = grip
			w.Part1 = p
			w.Parent = p
		end
	end
	m.PrimaryPart = grip
	return m
end

-- Lobby -------------------------------------------------------------------------------------

export type Alcove = { Index: number, Root: Model, Plate: TextLabel, Slots: { CFrame } }

-- The public lobby lives in LobbyBuilder (V4 section D); same return fields as before:
-- Root, Spawn, Alcoves (Index, Root, Plate, Slots) and Stands.
function World.buildLobby(): { [string]: any }
	return require(script.Parent.LobbyBuilder).build(World.toolModel)
end

-- Arena ------------------------------------------------------------------------------------

-- Match place (Teleport mode): the one arena sits at the place origin instead of far from a lobby.
local arenaAtOrigin = false
function World.useOriginArena()
	arenaAtOrigin = true
end

function World.arenaCenter(slot: number): Vector3
	if arenaAtOrigin and slot == 1 then
		return Vector3.zero
	end
	return Vector3.new(1200 + (slot - 1) * 260, 0, 0)
end

-- The V4 quarry worksite lives in ArenaBuilder (kit pieces in ArenaKit). Returns Root, Center,
-- Spawns, Bays, Tables, PileFolder, MachineFolder (and Hopper).
function World.buildArena(slot: number): { [string]: any }
	-- the kit meshes load in parallel at boot; give stragglers a moment so the first arena uses them
	MeshService.waitReady(6)
	return ArenaBuilder.build(slot, World.arenaCenter(slot))
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="274">
        <Properties>
          <string name="Name">ZoneScenery</string>
          <string name="Source"><![CDATA[--!strict
-- Re-skins a built hunt arena for one zone (theme data: shared/ZoneThemes). ArenaBuilder.applyZone calls it when the
-- arena is built and MatchService (through ArenaBuilder.applyZone) at every round start, so a reused arena always
-- shows the zone being hunted. Three passes:
--   1. ground: floor, bench, perimeter band, worn routes, road and the mound halo take the zone's colours and materials
--      (the pale pile bed itself is never changed: the eggs must read against it, Pass 11);
--   2. boundary: hill domes, tree crowns, bushes and trunks are tinted from their built (meadow) colour, stored once
--      as the ZoneBase attribute so every swap starts from the same base; the flower beds inside the fence are only
--      kept in the Meadow;
--   3. landmarks: one folder (CT_Rocks_ZoneScenery) rebuilt per zone change: a ring of small props just outside the
--      octagon (ZoneThemes.ringSpots) plus a hero landmark on the lower bench across the east drop (Space also gets a
--      planet and moon in the sky). Everything is anchored, collision/query/touch off, CameraIgnore, no shadow on
--      small bits. Every spot lies outside the containment octagon, so the pile, tables, nests and routes stay clear.
-- All procedural parts; no asset ids. REPLACE: real meshes per landmark when uploaded.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ZoneThemes = require(Shared.ZoneThemes)
local Kit = require(script.Parent.ArenaKit)
local KitPlace = require(script.Parent.KitPlace)

-- Hero landmark size per set (studs); the owner's mesh ServerStorage.MeshyAssets.Zone_<Landmark> replaces the Part hero.
local HERO_SIZE: { [string]: Vector3 } = {
	Flowers = Vector3.new(20, 24, 20),
	BigTree = Vector3.new(30, 34, 30),
	IceRocks = Vector3.new(26, 26, 26),
	LavaRocks = Vector3.new(30, 22, 30),
	Crystals = Vector3.new(20, 28, 20),
}

type Theme = ZoneThemes.Theme

local ZoneScenery = {}

local FOLDER = "CT_Rocks_ZoneScenery"
local BED = Kit.C.Dirt -- the pile bed colour (ArenaBuilder buildGround)
local LEAF_NAMES = { Bush = true, Crown = true, CrownTop = true }

-- The meadow flower beds inside the fence, kept aside (not destroyed) while another zone is shown.
local meadowFlowers: { [Instance]: Instance } = setmetatable({}, { __mode = "k" }) :: any

local function mat(name: string): Enum.Material
	return (Enum.Material :: any)[name] or Enum.Material.SmoothPlastic
end

-- Ground ----------------------------------------------------------------------------------------

local function skinGround(root: Instance, t: Theme)
	local g = root:FindFirstChild("CT_Rocks_Ground")
	if not g then
		return
	end
	-- same mixes ArenaBuilder builds with, so the Meadow theme reproduces the built look exactly
	local band = t.Floor:Lerp(t.Band, 0.5)
	local worn = t.Floor:Lerp(t.Path, 0.55)
	local looks: { [string]: { Color: Color3, Material: Enum.Material } } = {
		CT_Rocks_Floor = { Color = t.Floor, Material = mat(t.FloorMaterial) },
		CT_Rocks_Bench = { Color = t.Bench, Material = mat(t.BenchMaterial) },
		CT_Rocks_GravelBand = { Color = band, Material = mat(t.BandMaterial) },
		CT_Rocks_GravelEdge = { Color = band:Lerp(t.Floor, 0.5), Material = mat(t.BandMaterial) },
		CT_Rocks_Route = { Color = worn, Material = mat(t.PathMaterial) },
		CT_Rocks_RouteEdge = { Color = t.Floor:Lerp(worn, 0.45), Material = mat(t.PathMaterial) },
		CT_Rocks_Road = { Color = t.Path, Material = mat(t.PathMaterial) },
	}
	for _, d in g:GetChildren() do
		local look = looks[d.Name]
		if look and d:IsA("BasePart") then
			d.Color = look.Color
			d.Material = look.Material
		end
	end
	-- mound pad: the bed stays pale; its lobes and the soft halo blend toward the zone floor
	local pad = g:FindFirstChild("CT_Rocks_MoundPad")
	if pad then
		for _, d in pad:GetChildren() do
			if d:IsA("BasePart") then
				if d.Name == "Lobe" then
					local mix = d:GetAttribute("FloorMix")
					d.Color = BED:Lerp(t.Floor, if type(mix) == "number" then mix else 0.25)
				elseif d.Name == "Halo" then
					d.Color = t.Floor:Lerp(BED, 0.35)
				end
			end
		end
	end
end

-- Boundary tint ---------------------------------------------------------------------------------

local function tint(p: BasePart, toward: Color3, mix: number, material: Enum.Material?)
	local base = p:GetAttribute("ZoneBase")
	if typeof(base) ~= "Color3" then
		base = p.Color
		p:SetAttribute("ZoneBase", base)
	end
	p.Color = (base :: Color3):Lerp(toward, mix)
	if material then
		p.Material = material
	end
end

local function skinBoundary(root: Instance, t: Theme)
	local edge = root:FindFirstChild("CT_Rocks_Boundary")
	if not edge then
		return
	end
	local hillMat, leafMat = mat(t.HillMaterial), mat(t.LeafMaterial)
	for _, d in edge:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Name == "Dome" then
				tint(d, t.Hill, t.HillMix, hillMat)
			elseif LEAF_NAMES[d.Name] then
				tint(d, t.Leaf, t.LeafMix, leafMat)
			elseif d.Name == "Trunk" then
				tint(d, t.Trunk, t.TrunkMix, nil)
			end
		end
	end
	-- the flower beds just inside the fence are meadow only
	local flowers = meadowFlowers[root] or edge:FindFirstChild("Flowers")
	if flowers then
		meadowFlowers[root] = flowers
		flowers.Parent = if t.KeepMeadowFlowers then edge else nil
	end
end

-- procedural boulder clusters (ArenaKit.boulders) take the zone's boulder colour; the Meadow puts the built one back
local function skinBoulders(root: Instance, t: Theme)
	for _, m in root:GetDescendants() do
		if m.Name == "CT_Rocks_Boulders" and not m:FindFirstAncestor(FOLDER) then
			for _, d in m:GetDescendants() do
				if d:IsA("BasePart") then
					tint(d, t.Boulder or Color3.new(1, 1, 1), if t.Boulder then 0.6 else 0, nil)
				end
			end
		end
	end
end

-- Landmark helpers --------------------------------------------------------------------------------

local function piece(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	return Kit.part(parent, name, size, cf, color, material, shape)
end

-- vertical cylinder standing on `base` (Roblox cylinders run along X)
local function column(parent: Instance, name: string, base: Vector3, height: number, dia: number, color: Color3, material: Enum.Material): Part
	return piece(parent, name, Vector3.new(height, dia, dia), CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, material, Enum.PartType.Cylinder)
end

local function ballAt(parent: Instance, name: string, pos: Vector3, dia: number, color: Color3, material: Enum.Material, squash: number?): Part
	return piece(parent, name, Vector3.new(dia, dia * (squash or 1), dia), CFrame.new(pos), color, material, Enum.PartType.Ball)
end

-- a chunky rock half sunk into the ground at `p`
local function rock(parent: Instance, name: string, p: Vector3, size: Vector3, color: Color3, material: Enum.Material, rng: Random): Part
	local cf = CFrame.new(p + Vector3.new(0, size.Y * 0.3, 0)) * CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, math.pi), rng:NextNumber(-0.35, 0.35))
	return piece(parent, name, size, cf, color, material)
end

-- a tilted shard / crystal rising from `p`
local function shard(parent: Instance, name: string, p: Vector3, w: number, h: number, color: Color3, material: Enum.Material, rng: Random, lean: number): Part
	local cf = CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0) * CFrame.Angles(rng:NextNumber(-lean, lean), 0, rng:NextNumber(-lean, lean))
	return piece(parent, name, Vector3.new(w, h, w), cf * CFrame.new(0, h * 0.4, 0) * CFrame.Angles(0, math.rad(45), 0), color, material)
end

local function glow(at: BasePart, color: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = at
end

-- Landmark sets (p = arena-world ground point) ------------------------------------------------------

-- Meadow: flower patches outside the fence, a bed of giant flowers on the lower meadow.
local function meadowRing(f: Instance, p: Vector3, _t: Theme, rng: Random)
	for _ = 1, 6 do
		Kit.flower(f, p + Vector3.new(rng:NextNumber(-3.5, 3.5), 0, rng:NextNumber(-3.5, 3.5)), rng)
	end
end
local PETALS = { Color3.fromRGB(255, 142, 170), Color3.fromRGB(255, 255, 255), Color3.fromRGB(176, 150, 255) }
local function meadowHero(f: Instance, p: Vector3, t: Theme, rng: Random)
	local m = Kit.model(f, "GiantFlowers")
	for i = 1, 3 do
		local base = p + Vector3.new((i - 2) * 9 + rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-3, 3))
		local h = rng:NextNumber(9, 14)
		column(m, "Stem", base, h, 0.9, Color3.fromRGB(70, 150, 70), Enum.Material.Grass)
		piece(m, "Leaf", Vector3.new(3.2, 0.3, 1.4), CFrame.new(base + Vector3.new(1.4, h * 0.35, 0)) * CFrame.Angles(0, 0, math.rad(25)), Color3.fromRGB(84, 168, 74), Enum.Material.Grass)
		local head = base + Vector3.new(0, h, 0)
		local petal = PETALS[i]
		for k = 1, 5 do
			local a = k / 5 * math.pi * 2
			ballAt(m, "Petal", head + Vector3.new(math.cos(a) * 1.9, 0, math.sin(a) * 1.9), 2.6, petal, Enum.Material.SmoothPlastic, 0.45)
		end
		ballAt(m, "Heart", head + Vector3.new(0, 0.3, 0), 2.2, t.Accent, Enum.Material.SmoothPlastic, 0.6)
	end
	for _ = 1, 14 do
		Kit.flower(f, p + Vector3.new(rng:NextNumber(-14, 14), 0, rng:NextNumber(-8, 8)), rng)
	end
end

-- Forest: small pines outside the fence, one huge old tree on the lower ground.
local function forestRing(f: Instance, p: Vector3, t: Theme, rng: Random)
	local m = Kit.model(f, "Pine")
	local s = rng:NextNumber(0.9, 1.3)
	column(m, "PineTrunk", p, 4 * s, 1.3 * s, t.Rock, Enum.Material.Wood)
	for k = 0, 2 do
		local dia = (7 - k * 2) * s
		ballAt(m, "Needles", p + Vector3.new(0, (4 + k * 2.6) * s, 0), dia, t.Accent:Lerp(Color3.new(0, 0, 0), k * 0.06), Enum.Material.LeafyGrass, 0.7)
	end
end
local function forestHero(f: Instance, p: Vector3, t: Theme, rng: Random)
	local m = Kit.model(f, "BigTree")
	local trunkH = 30
	column(m, "Trunk", p, trunkH, 6, t.Rock, Enum.Material.Wood)
	for k = 1, 5 do -- roots spreading out from the base
		local a = k / 5 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		piece(m, "Root", Vector3.new(2.2, 1.8, 8), CFrame.lookAt(p + dir * 4.5 + Vector3.new(0, 0.6, 0), p + dir * 9) * CFrame.Angles(math.rad(-10), 0, 0), t.Rock:Lerp(Color3.new(0, 0, 0), 0.1), Enum.Material.Wood)
	end
	for _, side in { -1, 1 } do -- two big limbs
		local from = p + Vector3.new(0, trunkH * 0.7, 0)
		local to = from + Vector3.new(side * 9, 7, rng:NextNumber(-3, 3))
		Kit.bar(m, "Limb", from, to, 2.2, t.Rock, Enum.Material.Wood)
	end
	local crown = p + Vector3.new(0, trunkH + 4, 0)
	ballAt(m, "Canopy", crown, 24, t.Accent, Enum.Material.LeafyGrass, 0.75)
	for k = 1, 6 do
		local a = k / 6 * math.pi * 2
		ballAt(m, "Canopy", crown + Vector3.new(math.cos(a) * 10, rng:NextNumber(-4, 3), math.sin(a) * 10), rng:NextNumber(13, 17), t.Accent:Lerp(t.Leaf, rng:NextNumber(0, 0.5)), Enum.Material.LeafyGrass, 0.8)
	end
	-- a ring of red-cap mushrooms round the foot
	for k = 1, 6 do
		local a = k / 6 * math.pi * 2 + 0.3
		local at = p + Vector3.new(math.cos(a) * 8.5, 0, math.sin(a) * 8.5)
		column(m, "MushStem", at, 1.2, 0.5, Color3.fromRGB(240, 232, 214), Enum.Material.SmoothPlastic)
		ballAt(m, "MushCap", at + Vector3.new(0, 1.3, 0), 1.6, Color3.fromRGB(220, 70, 60), Enum.Material.SmoothPlastic, 0.55)
	end
end

-- Snow: ice rocks with snow caps outside the fence, an ice spire on a snow mound on the lower ground.
local function snowRing(f: Instance, p: Vector3, t: Theme, rng: Random)
	local m = Kit.model(f, "IceRocks")
	for _ = 1, 3 do
		local at = p + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		local s = Vector3.new(rng:NextNumber(2.5, 4.5), rng:NextNumber(2, 4), rng:NextNumber(2.5, 4.5))
		local r = rock(m, "IceRock", at, s, t.Rock:Lerp(t.Accent, rng:NextNumber(0, 0.4)), mat(t.RockMaterial), rng)
		piece(m, "SnowCap", Vector3.new(s.X * 0.9, 0.5, s.Z * 0.9), r.CFrame * CFrame.new(0, s.Y / 2, 0), t.Floor, Enum.Material.Snow)
	end
end
local function snowHero(f: Instance, p: Vector3, t: Theme, rng: Random)
	local m = Kit.model(f, "IceSpire")
	local mound = ballAt(m, "SnowMound", p + Vector3.new(0, -1, 0), 22, t.Floor, Enum.Material.Snow, 0.35)
	for k = 1, 7 do
		local a = k / 7 * math.pi * 2
		local r = if k == 1 then 0 else rng:NextNumber(3, 6)
		local h = if k == 1 then 26 else rng:NextNumber(9, 17)
		shard(m, "IceShard", p + Vector3.new(math.cos(a) * r, 1.5, math.sin(a) * r), if k == 1 then 4.5 else rng:NextNumber(2.2, 3.4), h, t.Rock:Lerp(t.Accent, rng:NextNumber(0, 0.5)), Enum.Material.Ice, rng, if k == 1 then 0.05 else 0.35)
	end
	for _ = 1, 4 do
		rock(m, "IceRock", p + Vector3.new(rng:NextNumber(-12, 12), 0, rng:NextNumber(-10, 10)), Vector3.new(rng:NextNumber(3, 5), rng:NextNumber(2, 4), rng:NextNumber(3, 5)), t.Rock, mat(t.RockMaterial), rng)
	end
	if t.Light then
		glow(mound, t.Light, 22, 0.8)
	end
end

-- Volcano: basalt rocks split by glowing lava cracks outside the fence, a small smoking cone on the lower ground.
local function lavaRing(f: Instance, p: Vector3, t: Theme, rng: Random)
	local m = Kit.model(f, "LavaRocks")
	for _ = 1, 3 do
		local at = p + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		local s = Vector3.new(rng:NextNumber(2.5, 4.5), rng:NextNumber(2, 3.6), rng:NextNumber(2.5, 4.5))
		local r = rock(m, "LavaRock", at, s, t.Rock, mat(t.RockMaterial), rng)
		-- two crossing cracks on the top face, a hair proud of it
		piece(m, "LavaCrack", Vector3.new(s.X * 0.8, 0.12, 0.28), r.CFrame * CFrame.new(0, s.Y / 2 + 0.03, 0) * CFrame.Angles(0, rng:NextNumber(-0.5, 0.5), 0), t.Accent, Enum.Material.Neon)
		piece(m, "LavaCrack", Vector3.new(0.24, 0.12, s.Z * 0.6), r.CFrame * CFrame.new(rng:NextNumber(-0.5, 0.5), s.Y / 2 + 0.03, 0), t.Accent, Enum.Material.Neon)
	end
	-- a crack across the ground beside the rocks
	piece(m, "LavaCrack", Vector3.new(0.35, 0.08, rng:NextNumber(4, 7)), CFrame.new(p + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), t.Accent, Enum.Material.Neon)
end
local function lavaHero(f: Instance, p: Vector3, t: Theme, rng: Random)
	local m = Kit.model(f, "Volcano")
	local tiers = { 30, 25, 20, 15, 11 }
	local y = 0
	for k, dia in tiers do
		local h = 3.6
		column(m, "Cone", p + Vector3.new(0, y, 0), h, dia, t.Rock:Lerp(t.Hill, (k - 1) * 0.08), mat(t.RockMaterial))
		y += h
	end
	local pool = column(m, "LavaPool", p + Vector3.new(0, y - 0.3, 0), 0.4, 8, t.Accent, Enum.Material.Neon)
	-- three lava streams down the steps
	for k = 1, 3 do
		local a = k / 3 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local top = p + dir * 4.5 + Vector3.new(0, y, 0)
		local foot = p + dir * 15.5 + Vector3.new(0, 0.2, 0)
		Kit.bar(m, "LavaFlow", top, foot, 0.9, t.Accent, Enum.Material.Neon)
	end
	-- glowing cracks across the ground round the cone
	for k = 1, 8 do
		local a = k / 8 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local r = rng:NextNumber(17, 22)
		local at = p + Vector3.new(math.cos(a) * r, 0.05, math.sin(a) * r)
		piece(m, "LavaCrack", Vector3.new(0.4, 0.08, rng:NextNumber(4, 8)), CFrame.new(at) * CFrame.Angles(0, -a + rng:NextNumber(-0.6, 0.6), 0), t.Accent, Enum.Material.Neon)
	end
	if t.Light then
		glow(pool, t.Light, 30, 2)
	end
end

-- Space: crystal clusters outside the fence, a giant crystal cluster on the lower ground, a ringed planet and a moon.
local function crystalRing(f: Instance, p: Vector3, t: Theme, rng: Random)
	local m = Kit.model(f, "Crystals")
	rock(m, "CrystalBase", p, Vector3.new(3.6, 1.4, 3.6), t.Hill, mat(t.HillMaterial), rng)
	for k = 1, 3 do
		local neon = k == 1
		shard(m, "Crystal", p + Vector3.new(rng:NextNumber(-1.5, 1.5), 0.4, rng:NextNumber(-1.5, 1.5)), rng:NextNumber(1.0, 1.6), rng:NextNumber(4, 8), if neon then t.Accent else t.Rock, if neon then Enum.Material.Neon else mat(t.RockMaterial), rng, 0.4)
	end
end
local function crystalHero(f: Instance, p: Vector3, t: Theme, rng: Random)
	local m = Kit.model(f, "CrystalCluster")
	local base = rock(m, "CrystalBase", p, Vector3.new(14, 3, 12), t.Hill, mat(t.HillMaterial), rng)
	for k = 1, 8 do
		local a = k / 8 * math.pi * 2
		local r = if k == 1 then 0 else rng:NextNumber(2.5, 5)
		local h = if k == 1 then 24 else rng:NextNumber(8, 16)
		local neon = k % 3 == 0
		shard(m, "Crystal", p + Vector3.new(math.cos(a) * r, 1, math.sin(a) * r), if k == 1 then 4 else rng:NextNumber(1.8, 3), h, if neon then t.Accent else t.Rock, if neon then Enum.Material.Neon else mat(t.RockMaterial), rng, if k == 1 then 0.05 else 0.4)
	end
	if t.Light then
		glow(base, t.Light, 26, 1.2)
	end
end
local function spaceSky(f: Instance, c: Vector3, t: Theme)
	local m = Kit.model(f, "Planet")
	local at = c + ZoneThemes.PlanetSpot
	ballAt(m, "Planet", at, 28, Color3.fromRGB(120, 92, 200), Enum.Material.SmoothPlastic)
	ballAt(m, "PlanetBand", at, 28.4, Color3.fromRGB(170, 140, 240), Enum.Material.SmoothPlastic, 0.18)
	local ring = piece(m, "PlanetRing", Vector3.new(0.5, 50, 50), CFrame.new(at) * CFrame.Angles(math.rad(18), 0, math.rad(90 + 14)), t.Accent:Lerp(Color3.new(1, 1, 1), 0.4), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	ring.Transparency = 0.35
	local moon = c + ZoneThemes.MoonSpot
	ballAt(m, "Moon", moon, 9, Color3.fromRGB(214, 214, 226), Enum.Material.Slate)
	ballAt(m, "Crater", moon + Vector3.new(-3.6, 1.2, 1.8), 2.4, Color3.fromRGB(176, 176, 190), Enum.Material.Slate, 0.5)
	ballAt(m, "Crater", moon + Vector3.new(-3.2, -1.8, -2.2), 1.8, Color3.fromRGB(176, 176, 190), Enum.Material.Slate, 0.5)
end

type Builder = (Instance, Vector3, Theme, Random) -> ()
local SETS: { [string]: { Ring: Builder, Hero: Builder } } = {
	Flowers = { Ring = meadowRing, Hero = meadowHero },
	BigTree = { Ring = forestRing, Hero = forestHero },
	IceRocks = { Ring = snowRing, Hero = snowHero },
	LavaRocks = { Ring = lavaRing, Hero = lavaHero },
	Crystals = { Ring = crystalRing, Hero = crystalHero },
}

local function seedOf(id: string): number
	local n = 0
	for i = 1, #id do
		n = (n * 31 + string.byte(id, i)) % 100000
	end
	return 4000 + n
end

local function buildLandmarks(root: Instance, c: Vector3, t: Theme)
	local old = root:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end
	local set = SETS[t.Landmark]
	if not set then
		return
	end
	local f = Kit.folder(root, FOLDER)
	local rng = Random.new(seedOf(t.Id))
	for _, spot in ZoneThemes.ringSpots() do
		set.Ring(f, c + spot, t, rng)
	end
	local heroAt = c + ZoneThemes.HeroSpot
	local size = HERO_SIZE[t.Landmark] or Vector3.new(24, 24, 24)
	local hero = KitPlace.meshy("Zone_" .. t.Landmark, CFrame.new(heroAt + Vector3.new(0, size.Y / 2, 0)) * CFrame.Angles(0, math.rad(-90), 0), size)
	if hero then
		hero.Name = "HeroMesh"
		local box, ext = hero:GetBoundingBox()
		hero:PivotTo(hero:GetPivot() + Vector3.new(0, heroAt.Y + ext.Y / 2 - box.Position.Y - 0.5, 0)) -- sit just into the ground
		hero.Parent = f
	else
		set.Hero(f, heroAt, t, rng)
	end
	if t.Landmark == "Crystals" then
		spaceSky(f, c, t)
	end
	-- decor only: no collision, queries or touch, ignored by the camera; only the big pieces cast shadows
	-- (and never the sky props, which would shade the arena)
	for _, d in f:GetDescendants() do
		if d:IsA("BasePart") then
			Kit.deco(d)
			d:SetAttribute("CameraIgnore", true)
			d.CastShadow = d.Size.Magnitude > 12 and d.Position.Y < c.Y + 50
		end
	end
end

-- Applies zone `t` to the arena under `root` (centre `c`). Cheap when the zone is already shown.
function ZoneScenery.apply(root: Instance, c: Vector3, t: Theme)
	if root:GetAttribute("Zone") == t.Id and root:FindFirstChild(FOLDER) then
		return
	end
	skinGround(root, t)
	skinBoundary(root, t)
	skinBoulders(root, t)
	buildLandmarks(root, c, t)
	root:SetAttribute("Zone", t.Id)
end

return ZoneScenery
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="275">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="276">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">60</float>
      <float name="CameraMinZoomDistance">8</float>
      <float name="CharacterJumpPower">42</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="277">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="278">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="279">
          <Properties>
            <string name="Name">Anim</string>
            <string name="Source"><![CDATA[--!strict
-- Tiny shared animation scheduler for the cosmetic rock, basket and station motion (V3 loop).
-- One Heartbeat connection serves every running animation and disconnects itself when none are
-- left, so idle rounds cost nothing. With reduced motion every animation jumps to its end state at
-- once (callers always end in the correct state; animation never decides anything).

local RunService = game:GetService("RunService")

local State = require(script.Parent.State)

local Anim = {}

type Item = { T0: number, Dur: number, Fn: (number) -> (), Done: (() -> ())?, Dead: boolean }

local items: { Item } = {}
local conn: RBXScriptConnection? = nil

local function reduced(): boolean
	local s = State.Profile and State.Profile.Settings
	return s ~= nil and s.ReducedMotion == true
end

local function step()
	local now = os.clock()
	local i = 1
	while i <= #items do
		local it = items[i]
		if it.Dead then
			table.remove(items, i)
		else
			local k = if it.Dur <= 0 then 1 else math.min(1, (now - it.T0) / it.Dur)
			local ok: boolean, err: any = pcall(it.Fn, k)
			if not ok then
				warn("[Anim] " .. tostring(err))
				it.Dead = true
			end
			if k >= 1 or it.Dead then
				it.Dead = true
				table.remove(items, i)
				if it.Done then
					local ok2: boolean, err2: any = pcall(it.Done :: () -> ())
					if not ok2 then
						warn("[Anim] done: " .. tostring(err2))
					end
				end
			else
				i += 1
			end
		end
	end
	if #items == 0 and conn then
		conn:Disconnect()
		conn = nil
	end
end

-- Runs fn(k) every frame for `duration` seconds (k 0..1, ends with exactly 1), then done().
-- Returns a handle: handle.Dead = true stops it (done is not called).
function Anim.run(duration: number, fn: (number) -> (), done: (() -> ())?): Item
	local it: Item = { T0 = os.clock(), Dur = duration, Fn = fn, Done = done, Dead = false }
	if reduced() or duration <= 0 then
		pcall(fn, 1)
		if done then
			pcall(done)
		end
		it.Dead = true
		return it
	end
	pcall(fn, 0)
	table.insert(items, it)
	if not conn then
		conn = RunService.Heartbeat:Connect(step)
	end
	return it
end

-- Scales a model to `factor` times the size it had when this was first called (repeat calls are
-- absolute, not cumulative). Cosmetic: errors are swallowed.
function Anim.scale(model: Model, factor: number)
	pcall(function()
		local cur = (model:GetAttribute("CTScale") or 1) :: number
		local f = math.max(0.02, factor)
		model:ScaleTo(model:GetScale() * (f / cur))
		model:SetAttribute("CTScale", f)
	end)
end

function Anim.cancelAll()
	for _, it in items do
		it.Dead = true
	end
	table.clear(items)
	if conn then
		conn:Disconnect()
		conn = nil
	end
end

function Anim.count(): number
	return #items
end

function Anim.easeOut(k: number): number
	return 1 - (1 - k) * (1 - k)
end

function Anim.easeInOut(k: number): number
	return if k < 0.5 then 2 * k * k else 1 - 2 * (1 - k) * (1 - k)
end

-- Point on a parabola from a to b with `lift` studs of extra height at the middle.
function Anim.arc(a: Vector3, b: Vector3, lift: number, k: number): Vector3
	return a:Lerp(b, k) + Vector3.new(0, lift * 4 * k * (1 - k), 0)
end

return Anim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="280">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!strict
-- Client audio: buses, one ambience per area, world sounds with distance attenuation, caps.
--
-- Buses (SoundGroups under SoundService.CTR_Audio):
--   SFX       <- Settings.Sfx     all one-shots and machine loops
--   Ambience  <- Settings.Music * 0.6   one looping bed, lobby or arena (crossfaded), plus the soft hum near a
--                                      working press (positioned, heard within 40 studs)
--   Music     <- Settings.Music   reserved (no music files yet)
-- Every sound id comes from shared/SoundIds (0 = not uploaded): a 0 id plays nothing, silently.
--
-- Rules that keep it from spamming:
--   * per-sound cooldown (COOLDOWN), so fast swings, machines and button mashing stay readable;
--   * at most MAX_WORLD live positioned sounds and MAX_FLAT live flat (UI / own strike) sounds;
--   * positioned sounds farther than MAX_DIST are never created; closer ones roll off
--     (LinearSquare, full volume inside MIN_DIST, silent at MAX_DIST);
--   * at most MAX_LOOPS machine loops at once (nearest win), each stops itself when its owner
--     stops calling Audio.machineActive for IDLE seconds.
-- Docs: docs/AUDIO.md.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local SoundIds = require(Shared.SoundIds)
local PetSoundIds = require(Shared.PetSoundIds)
local SoundConfig = require(Shared.SoundConfig) -- hand-set ids (egg crunch / pop); 0 = silent
local EggConfig = require(Shared.EggConfig)
local SoundCues = require(Shared.SoundCues) -- moment -> key map, reveal cues, stand-ins while a made sound is 0
local State = require(script.Parent.State)

local Audio = {}

export type Opts = { Pos: Vector3?, Volume: number?, Pitch: number?, Key: string? }

local MIN_DIST = 14
local MAX_DIST = 95
local MAX_WORLD = 8
local MAX_FLAT = 6
local MAX_LOOPS = 4 -- three machines plus the own jackhammer
local IDLE = 0.35
local AMBIENCE_VOLUME = 0.45
local LOAD_WAIT = 10 -- seconds a one-shot may take to load before its slot is given up

-- seconds between two plays of the same sound name (per Key when one is given)
local COOLDOWN: { [string]: number } = {
	HammerHit = 0.06, StoneCrack = 0.09, GravelSpill = 0.2,
	JackhammerStart = 1.0, JackhammerStop = 0.5,
	PressDescend = 0.8, PressImpact = 0.8, PressRetract = 0.8,
	GeodeReveal = 1.0, RarityAccent = 1.0, Sale = 0.25, Pickup = 0.12, Deposit = 0.15, MaterialFound = 0.8, Purchase = 0.2,
	Button = 0.05, CountdownTick = 0.3, MatchWin = 1.0,
	EggCrunch = 0.05, EggPop = 0.15, HatchChoir = 2.0,
	CoinPickup = 0.08, SpeedBoots = 1.0, TowerHit = 0.07, TowerSpecial = 0.3, EggChirp = 0.5,
	HatchSparkle = 1.0, HatchDrum = 1.0, PetFound = 1.0, EggGrab = 0.12, EggDrop = 0.15, BattleMatched = 1.0,
	PetCrit = 0.1, PetKO = 0.25, BattleWin = 1.0, BattleLose = 1.0, TrainTap = 0.05, LevelUp = 2.0, Evolve = 1.0,
	FloorClear = 1.0, DailyClaim = 1.0, GiftOpen = 0.8, QuestDone = 0.4, LuckyMeter = 1.0, Denied = 0.35,
}

-- sounds with numbered variants (HammerHit1..3 etc.)
local VARIANTS: { [string]: number } = { HammerHit = 3, StoneCrack = 3, GravelSpill = 2 }

local BASE_VOLUME: { [string]: number } = {
	HammerHit = 0.75, StoneCrack = 0.7, GravelSpill = 0.55, Button = 0.5, CountdownTick = 0.6,
	Sale = 0.7, Purchase = 0.7, Pickup = 0.65, Deposit = 0.75, MaterialFound = 0.8, GeodeReveal = 0.85, RarityAccent = 0.7, MatchWin = 0.8,
	JackhammerStart = 0.6, JackhammerStop = 0.5, PressDescend = 0.6, PressImpact = 0.8, PressRetract = 0.5,
	EggCrunch = 0.7, EggPop = 0.85, HatchChoir = 0.8,
	CoinPickup = 0.6, SpeedBoots = 0.75, TowerHit = 0.6, TowerSpecial = 0.8, EggChirp = 0.7,
	HatchSparkle = 0.8, HatchDrum = 0.85, PetFound = 0.75, EggGrab = 0.6, EggDrop = 0.7, BattleMatched = 0.75,
	PetCrit = 0.7, PetKO = 0.65, BattleWin = 0.8, BattleLose = 0.6, TrainTap = 0.45, LevelUp = 0.75, Evolve = 0.85,
	FloorClear = 0.75, DailyClaim = 0.75, GiftOpen = 0.75, QuestDone = 0.7, LuckyMeter = 0.8, Denied = 0.55,
	JackhammerLoop = 0.5, ConveyorHum = 0.3, CrusherLoop = 0.45, MachineHum = 0.32,
}

-- machine kinds for machineActive: start one-shot, loop, stop one-shot (any may be absent). Idle = seconds without
-- a call before the loop winds down (default IDLE); Ambient = the loop plays on the Ambience bus (music/ambient
-- volume) with a short reach, for the gentle hum near a running machine.
type MachineKind = { Start: string?, Loop: string, Stop: string?, Idle: number?, Ambient: boolean? }
local MACHINES: { [string]: MachineKind } = {
	Jackhammer = { Start = "JackhammerStart", Loop = "JackhammerLoop", Stop = "JackhammerStop" },
	Conveyor = { Loop = "ConveyorHum" },
	Crusher = { Loop = "CrusherLoop" },
	-- the hydraulic press only makes one-shots (descend / impact / retract); while those keep coming a soft
	-- motor hum runs under them (started from Audio.play, below) and fades 4.5 s after the last stroke
	Hum = { Loop = "MachineHum", Idle = 4.5, Ambient = true },
}
local HUM_MIN, HUM_MAX = 6, 40 -- the hum is only heard near the machine
local HUM_FROM = { PressDescend = true, PressImpact = true, PressRetract = true }

local AREA_AMBIENCE = { lobby = "LobbyMusic", arena = "RaceMusic" } -- Find The Pet: chill-pop lobby, hype race (PetSoundIds)

local rng = Random.new()
local last: { [string]: number } = {}
local live = { World = 0, Flat = 0 }
local groups: { Master: SoundGroup?, SFX: SoundGroup?, Ambience: SoundGroup?, Music: SoundGroup? } = {}
local ambience: { Sound: Sound?, Area: string? } = {}
local windBed: Sound? = nil -- the hunt wind loop (arena only)
local parkedLobby: Sound? = nil -- lobby ambience kept paused during a hunt so it resumes where it left off
-- Round-end rush (0..1): over the last RUSH_LEAD seconds before the overtime glow (EggConfig.Overtime) the race music
-- gets a little louder and faster, and stays there until the pet is found. Cosmetic: read from the server's clock.
local RUSH_LEAD = 30
local RUSH_VOLUME = 0.3 -- up to +30 % on the Ambience bus
local RUSH_SPEED = 0.08 -- up to +8 % playback speed
local rush = 0
local duck = 1 -- music/ambience duck multiplier during the hatch reveal
local duckToken = 0
local started = false
-- quick streaks of these climb in pitch (up to 8 steps of 6 %), a pause of 0.6 s resets them (only played sounds count)
local CLIMB: { [string]: boolean } = { CoinPickup = true, TrainTap = true }
local streak: { [string]: { N: number, At: number } } = {}
local menuOpen = false -- a menu panel is open: one-shot sounds a bit quieter
local MENU_QUIET = 0.75

type Loop = { Sound: Sound, Part: Attachment?, Pos: Vector3?, LastSeen: number, Kind: string }
local loops: { [string]: Loop } = {}
local loopCount = 0
local loopConn: RBXScriptConnection? = nil

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function idOf(name: string): number
	local v = SoundIds[name]
	if v == nil then
		v = SoundConfig.Ids[name]
	end
	if v == nil or v == 0 then
		v = PetSoundIds[name] -- Find The Pet picks (music, hatch, made sounds)
	end
	return if type(v) == "number" then v else 0
end

local function listenerPos(): Vector3?
	local cam = Workspace.CurrentCamera
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return if cam then cam.CFrame.Position else nil
end

local function applyVolumes()
	local s = settings()
	local music = if type(s.Music) == "number" then math.clamp(s.Music, 0, 1) else 0.6
	local sfx = if type(s.Sfx) == "number" then math.clamp(s.Sfx, 0, 1) else 0.8
	if groups.SFX then
		(groups.SFX :: SoundGroup).Volume = sfx
	end
	if groups.Music then
		(groups.Music :: SoundGroup).Volume = music * duck
	end
	if groups.Ambience then
		(groups.Ambience :: SoundGroup).Volume = music * 0.6 * (1 + RUSH_VOLUME * rush) * duck
	end
end

local function makeGroup(name: string, parent: Instance): SoundGroup
	local g = Instance.new("SoundGroup")
	g.Name = name
	g.Parent = parent
	return g
end

local function resolve(name: string): string
	local n = VARIANTS[name]
	if n then
		return name .. rng:NextInteger(1, n)
	end
	return name
end

-- Plays `name` once. opts: Pos (Vector3: positioned, rolls off with distance), Volume (x),
-- Pitch (x), Key (cooldown key, default the name). Returns whether a sound started.
function Audio.play(name: string, opts: Opts?): boolean
	local o: Opts = opts or {}
	if HUM_FROM[name] and o.Pos then
		-- a working press: keep its soft hum running (one per machine position)
		local p = o.Pos :: Vector3
		Audio.machineActive(string.format("hum:%d:%d", math.floor(p.X + 0.5), math.floor(p.Z + 0.5)), "Hum", p)
	end
	local id = idOf(resolve(name))
	local fallback = SoundCues.Fallback[name]
	if id == 0 and fallback then
		id = idOf(resolve(fallback)) -- the old sound stands in until the made one is uploaded
	end
	if id == 0 or not started then
		return false
	end
	local now = os.clock()
	local key = o.Key or name
	local cd = COOLDOWN[name] or 0.04 -- default 40 ms: identical sounds in one frame never stack
	if cd > 0 and now - (last[key] or -1) < cd then
		return false
	end
	local climb = 0
	if CLIMB[name] then
		local st: { N: number, At: number } = streak[name] or { N = 0, At = -1 }
		st.N = if now - st.At < 0.6 then math.min(st.N + 1, 8) else 0
		st.At = now
		streak[name] = st
		climb = st.N
	end
	local pos = o.Pos
	local bucket = if pos then "World" else "Flat"
	if live[bucket] >= (if pos then MAX_WORLD else MAX_FLAT) then
		return false
	end
	local holder: Instance = Workspace.CurrentCamera or Workspace
	local att: Attachment? = nil
	if pos then
		local lp = listenerPos()
		if lp and (lp - pos).Magnitude > MAX_DIST then
			return false
		end
		local a = Instance.new("Attachment")
		a.WorldPosition = pos
		a.Parent = Workspace.Terrain
		att, holder = a, a
	end
	last[key] = now
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Volume = (BASE_VOLUME[name] or 0.7) * (o.Volume or 1) * (if menuOpen then MENU_QUIET else 1)
	s.PlaybackSpeed = (o.Pitch or 1) * (0.96 + rng:NextNumber() * 0.08) * (1 + 0.06 * climb)
	s.SoundGroup = groups.SFX
	if pos then
		s.RollOffMode = Enum.RollOffMode.LinearSquare
		s.RollOffMinDistance = MIN_DIST
		s.RollOffMaxDistance = MAX_DIST
	end
	s.Parent = holder
	live[bucket] += 1
	local done = false
	local function finish()
		if done then
			return
		end
		done = true
		live[bucket] -= 1
		s:Destroy()
		if att then
			att:Destroy()
		end
	end
	s.Ended:Once(finish)
	s:Play()
	-- safety: never leak a slot. TimeLength is 0 until the asset has loaded, so a sound that loads late (the 4 s hatch
	-- build-up) arms the timer only once its real length is known; one that never loads gives up after LOAD_WAIT.
	local function arm()
		task.delay(math.max(s.TimeLength / math.max(s.PlaybackSpeed, 0.1), 1.5) + 1.5, finish)
	end
	if s.IsLoaded then
		arm()
	else
		local armed = false
		local function armOnce()
			if not armed then
				armed = true
				arm()
			end
		end
		s.Loaded:Once(armOnce)
		task.delay(LOAD_WAIT, armOnce)
	end
	return true
end

-- Machine sounds ---------------------------------------------------------------------------

local function stopLoop(key: string, withStop: boolean)
	local l = loops[key]
	if not l then
		return
	end
	loops[key] = nil
	loopCount -= 1
	l.Sound:Stop()
	l.Sound:Destroy()
	if l.Part then
		l.Part:Destroy()
	end
	local m = MACHINES[l.Kind]
	if withStop and m and m.Stop then
		Audio.play(m.Stop, { Pos = l.Pos, Key = key .. ":stop" })
	end
end

local function loopWatch()
	local now = os.clock()
	for key, l in loops do
		local m = MACHINES[l.Kind]
		if now - l.LastSeen > ((m and m.Idle) or IDLE) then
			stopLoop(key, true)
		end
	end
	if loopCount <= 0 and loopConn then
		loopConn:Disconnect()
		loopConn = nil
	end
end

-- Call while a machine (or the held jackhammer) is working; stop calling and it winds down
-- after IDLE seconds. `key` identifies the machine; `pos` is its world position (nil = own,
-- flat). Repeated calls are cheap. The nearest MAX_LOOPS machines are audible.
function Audio.machineActive(key: string, kind: string, pos: Vector3?)
	local m = MACHINES[kind]
	if not m or not started then
		return
	end
	local l = loops[key]
	if l then
		l.LastSeen = os.clock()
		return
	end
	local id = idOf(m.Loop)
	if id == 0 then
		return
	end
	local lp = listenerPos()
	local dist = if pos and lp then (lp - pos).Magnitude else 0
	if dist > MAX_DIST then
		return
	end
	if loopCount >= MAX_LOOPS then
		-- replace the farthest loop only if this one is nearer
		local farKey, farDist = nil, -1
		for k, other in loops do
			local d = if other.Pos and lp then (lp - other.Pos).Magnitude else 0
			if d > farDist then
				farKey, farDist = k, d
			end
		end
		if not farKey or farDist <= dist then
			return
		end
		stopLoop(farKey, false)
	end
	local att: Attachment? = nil
	local holder: Instance = Workspace.CurrentCamera or Workspace
	if pos then
		local a = Instance.new("Attachment")
		a.WorldPosition = pos
		a.Parent = Workspace.Terrain
		att, holder = a, a
	end
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Looped = true
	s.Volume = BASE_VOLUME[m.Loop] or 0.4
	s.SoundGroup = if m.Ambient then groups.Ambience else groups.SFX
	if pos then
		s.RollOffMode = Enum.RollOffMode.LinearSquare
		s.RollOffMinDistance = if m.Ambient then HUM_MIN else MIN_DIST
		s.RollOffMaxDistance = if m.Ambient then HUM_MAX else MAX_DIST
	end
	s.Parent = holder
	s:Play()
	loops[key] = { Sound = s, Part = att, Pos = pos, LastSeen = os.clock(), Kind = kind }
	loopCount += 1
	if m.Start then
		Audio.play(m.Start, { Pos = pos, Key = key .. ":start" })
	end
	if not loopConn then
		local acc = 0
		loopConn = RunService.Heartbeat:Connect(function(dt)
			acc += dt
			if acc >= 0.1 then
				acc = 0
				loopWatch()
			end
		end)
	end
end

function Audio.machineStop(key: string)
	stopLoop(key, true)
end

-- Event helpers (one call each from the hook points) ---------------------------------------

-- Own strike contact. Jackhammer-type tools (hold) run the machine loop instead of a hit per swing.
function Audio.strike(isHold: boolean, pos: Vector3?)
	if isHold then
		Audio.machineActive("self:jack", "Jackhammer", nil)
		Audio.play("HammerHit", { Volume = 0.35, Pitch = 0.85, Key = "self:hit" })
	else
		Audio.play("HammerHit", { Key = "self:hit" })
	end
	if pos then
		Audio.play("StoneCrack", { Pos = pos, Volume = 0.4, Key = "self:chip" })
	end
	Audio.play("EggCrunch", { Key = "self:crunch" }) -- SoundConfig id; silent while it is 0
end

-- Another player's strike, positioned.
function Audio.strikeAt(pos: Vector3)
	Audio.play("HammerHit", { Pos = pos, Volume = 0.3, Key = "other:hit" })
	Audio.play("EggCrunch", { Pos = pos, Volume = 0.3, Key = "other:crunch" })
end

function Audio.rockCracked(pos: Vector3?)
	Audio.play("StoneCrack", { Pos = pos })
	Audio.play("EggPop", { Pos = pos }) -- an egg breaks open (SoundConfig id; silent while it is 0)
	if rng:NextNumber() < 0.5 then
		Audio.play("GravelSpill", { Pos = pos, Volume = 0.8 })
	end
end

-- Rare+ hatch: the choir build-up at the start of the slow-motion reveal (SoundConfig.Ids.HatchChoir; silent while 0).
-- Pets never roar (owner rule).
-- Dips music and ambience for a few seconds so the reveal sounds stand out.
function Audio.duck(seconds: number)
	duckToken += 1
	local mine = duckToken
	duck = 0.35
	applyVolumes()
	task.delay(seconds, function()
		if duckToken ~= mine then
			return
		end
		for i = 1, 6 do
			if duckToken ~= mine then
				return
			end
			duck = 0.35 + 0.65 * (i / 6)
			applyVolumes()
			task.wait(0.1)
		end
	end)
end

function Audio.hatchChoir()
	Audio.duck(4)
	Audio.play("HatchChoir")
end

-- A rock taken off the shared pile into the basket (own pickup, flat).
function Audio.pickup()
	Audio.play("EggGrab", { Key = "self:pick" }) -- stand-in Pickup until EggGrab is uploaded
end

-- Rocks set down at the player's crushing table (own deposit, flat).
function Audio.deposit()
	Audio.play("EggDrop", { Key = "self:deposit" }) -- stand-in Deposit until EggDrop is uploaded
end

-- A first-time material for this player.
function Audio.materialFound()
	Audio.play("MaterialFound")
end

function Audio.button()
	Audio.play("ButtonClickSoft")
end

local lastCount = -1
function Audio.countdown(n: number)
	if n ~= lastCount then
		lastCount = n
		Audio.play("CountdownTick", { Pitch = if n <= 1 then 1.35 else 1 })
	end
end

function Audio.resetCountdown()
	lastCount = -1
end

-- Hatch reveal: the cues per rarity live in shared/SoundCues (sting pitch / loudness climb with rarity; Epic+ add the
-- sparkle swell, Legendary and the Void Dragon add the drum hit). Pets never roar (owner rule).
function Audio.reveal(rarity: string?, isVoid: boolean?)
	Audio.duck(if isVoid or rarity == "Legendary" then 4 else 3)
	for _, c in SoundCues.reveal(rarity, isVoid) do
		local function go()
			Audio.play(c.Key, { Pitch = c.Pitch, Volume = c.Volume, Key = c.Tag })
		end
		if c.Delay > 0 then
			task.delay(c.Delay, go)
		else
			go()
		end
	end
end

-- Ambience --------------------------------------------------------------------------------

function Audio.setArea(area: string)
	if not started or ambience.Area == area then
		return
	end
	ambience.Area = area
	-- hunt wind bed: a soft 12 s wind loop under the race music while in the arena
	if area == "arena" then
		local wid = idOf("HuntWindBed")
		if wid ~= 0 and not windBed then
			local w = Instance.new("Sound")
			w.Name = "HuntWindBed"
			w.SoundId = "rbxassetid://" .. wid
			w.Looped = true
			w.Volume = 0.25
			w.SoundGroup = groups.Ambience
			w.Parent = SoundService
			w:Play()
			windBed = w
		end
	elseif windBed then
		windBed:Destroy()
		windBed = nil
	end
	-- leaving the arena: machine hums stop at once (no hum carried into the lobby)
	for key, l in loops do
		local m = MACHINES[l.Kind]
		if m and m.Ambient then
			stopLoop(key, false)
		end
	end
	local old = ambience.Sound
	ambience.Sound = nil
	if old then
		local o = old :: Sound
		local keep = o.Name == "Ambience_lobby"
		if keep then
			parkedLobby = o
		end
		task.spawn(function()
			for i = 1, 12 do
				if ambience.Sound == o then
					return -- back in the lobby before the fade ended: the parked sound is playing again
				end
				o.Volume = AMBIENCE_VOLUME * (1 - i / 12)
				task.wait(0.1)
			end
			if ambience.Sound == o then
				return
			end
			if keep then
				o:Pause()
			else
				o:Destroy()
			end
		end)
	end
	local id = idOf(AREA_AMBIENCE[area] or "")
	if id == 0 then
		return
	end
	local s: Sound
	if area == "lobby" and parkedLobby and parkedLobby.Parent then
		s = parkedLobby :: Sound
		parkedLobby = nil
		s.Volume = 0
		s:Resume()
	else
		s = Instance.new("Sound")
		s.Name = "Ambience_" .. area
		s.SoundId = "rbxassetid://" .. id
		s.Looped = true
		s.Volume = 0
		s.SoundGroup = groups.Ambience
		s.Parent = SoundService
		s:Play()
	end
	ambience.Sound = s
	task.spawn(function()
		for i = 1, 12 do
			if s.Parent == nil then
				return
			end
			s.Volume = AMBIENCE_VOLUME * (i / 12)
			task.wait(0.1)
		end
	end)
end

local function rushGoal(): number
	local m = State.Match
	local ot = EggConfig.Overtime
	if not m or m.Tutorial or not ot.Enabled or m.Phase ~= "Searching" or type(m.SearchStart) ~= "number" then
		return 0
	end
	local elapsed = Workspace:GetServerTimeNow() - m.SearchStart
	return math.clamp((elapsed - (ot.RoundSeconds - RUSH_LEAD)) / RUSH_LEAD, 0, 1)
end

local function rushStep()
	local goal = rushGoal()
	if math.abs(goal - rush) < 0.005 then
		return
	end
	rush = if goal > rush then math.min(goal, rush + 0.05) else math.max(goal, rush - 0.1)
	applyVolumes()
	local s = ambience.Sound
	if s and ambience.Area == "arena" then
		s.PlaybackSpeed = 1 + RUSH_SPEED * rush
	end
end

local function currentArea(): string
	return if State.Match or Players.LocalPlayer:GetAttribute("MatchKey") then "arena" else "lobby"
end

-- A menu panel opened or closed (Main.client forwards UI.ModalChanged; UI requires Audio, so not required here).
function Audio.setMenuOpen(open: boolean)
	menuOpen = open
end

function Audio.init()
	if started then
		return
	end
	started = true
	local master = Instance.new("SoundGroup")
	master.Name = "CTR_Audio"
	master.Parent = SoundService
	groups.Master = master
	groups.SFX = makeGroup("SFX", master)
	groups.Ambience = makeGroup("Ambience", master)
	groups.Music = makeGroup("Music", master)
	applyVolumes()
	Audio.setArea(currentArea())
	task.spawn(function()
		while true do
			task.wait(0.25)
			rushStep()
		end
	end)
	State.Changed.Event:Connect(function(what)
		if what == "Profile" then
			applyVolumes()
		elseif what == "Match" then
			Audio.setArea(currentArea())
			local m = State.Match
			if not m or m.Phase ~= "Countdown" then
				Audio.resetCountdown()
			end
		end
	end)
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="281">
          <Properties>
            <string name="Name">CameraFx</string>
            <string name="Source"><![CDATA[--!strict
-- Small camera feel on top of Roblox's own camera (client only, cosmetic):
--   * CameraFx.shake(strength, seconds): the ONE shared shake helper. Used only for big moments (the pet is found,
--     a hatch pops at the stand right next to you). A small rotation that decays to nothing; never while Reduce
--     Motion is on, never during a cinematic (Scriptable camera).
--   * Lobby smooth follow: in the third-person lobby the camera trails the avatar by a fraction of a second (a soft
--     spring on position, at most MAX_LAG studs behind). Not in first person (the eye must stay in the head).
--   * CameraFx.punch(degrees, seconds): a field of view kick for fight moments (FightFx), added on top of the boots.
--   * Speed boots: while the own avatar wears the boots sparkles (EggFx "EggBootsSparkles") and runs, the field of
--     view widens by a few degrees, easing back when the boots end or the player stops.
--
-- How it stays out of the way of PlayerModule (CameraMode never writes Camera.CFrame): the offset is added AFTER the
-- default camera and CameraGuard have run (RenderPriority.Camera + 3) and taken off again BEFORE the default camera
-- runs next frame (RenderPriority.Camera - 1), so the camera scripts always see their own last CFrame and nothing
-- drifts. Field of view only changes while the boost runs and returns exactly to Config.Camera.Fov.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local State = require(script.Parent.State)

local CameraFx = {}

local MAX_LAG = 1.6 -- studs the lobby camera may trail the avatar
local LAG_RATE = 14 -- spring speed (higher = tighter)
local BOOTS_FOV = 8 -- extra degrees with speed boots
local FOV_RATE = 4 -- per second, towards the goal
local RUNNING = 10 -- studs/s horizontal before the boots widen the view

local player = Players.LocalPlayer
local started = false
local applied: CFrame? = nil -- the offset added this frame (taken off before the next default camera step)
local appliedOn: CFrame? = nil -- the CFrame after the offset (only undone if nothing else wrote since)
local lagPos: Vector3? = nil
local fovExtra = 0
local fovOwned = false
type Punch = { Start: number, Dur: number, Deg: number }
local punches: { Punch } = {}

type Shake = { Start: number, Dur: number, Amp: number, Seed: number }
local shakes: { Shake } = {}

local function reduced(): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings.ReducedMotion == true
end

local function cinematic(cam: Camera): boolean
	return cam.CameraType == Enum.CameraType.Scriptable or cam:GetAttribute("CT_Cinematic") == true
end

-- Shake the camera a little for `seconds` (strength 0..1; 1 = about 1.2 degrees). Several shakes add up to a cap.
function CameraFx.shake(strength: number, seconds: number?)
	if reduced() or #shakes >= 4 then
		return
	end
	table.insert(shakes, { Start = os.clock(), Dur = math.clamp(seconds or 0.35, 0.05, 1.5), Amp = math.clamp(strength, 0, 1), Seed = math.random() * 100 })
end

-- Field of view kick for a fight moment (FightFx): jumps `degrees` wider at once and eases back over `seconds`.
-- Never with Reduce Motion or during a cinematic; at most 3 at once.
function CameraFx.punch(degrees: number, seconds: number?)
	if reduced() or #punches >= 3 then
		return
	end
	table.insert(punches, { Start = os.clock(), Dur = math.clamp(seconds or 0.5, 0.1, 1.5), Deg = math.clamp(degrees, 0, 20) })
end

local function punchNow(now: number): number
	local sum = 0
	for i = #punches, 1, -1 do
		local p = punches[i]
		local k = (now - p.Start) / p.Dur
		if k >= 1 then
			table.remove(punches, i)
		else
			sum += p.Deg * (1 - k) * (1 - k)
		end
	end
	return math.min(sum, 20)
end

local function shakeOffset(now: number): CFrame?
	if #shakes == 0 then
		return nil
	end
	local rx, ry, rz = 0, 0, 0
	for i = #shakes, 1, -1 do
		local s = shakes[i]
		local k = (now - s.Start) / s.Dur
		if k >= 1 then
			table.remove(shakes, i)
		else
			local a = math.rad(1.2) * s.Amp * (1 - k) * (1 - k)
			local t = now * 31 + s.Seed
			rx += math.noise(t, 0.5) * a * 2
			ry += math.noise(t, 7.5) * a * 2
			rz += math.noise(t, 13.5) * a
		end
	end
	return CFrame.Angles(rx, ry, rz)
end

local function undo()
	local cam = Workspace.CurrentCamera
	local off, on = applied, appliedOn
	applied, appliedOn = nil, nil
	if cam and off and on and cam.CFrame == on then
		cam.CFrame = on * off:Inverse()
	end
end

local function apply(dt: number)
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	if cinematic(cam) then
		lagPos = nil
		table.clear(shakes)
		table.clear(punches)
		return
	end
	local now = os.clock()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local thirdPerson = player.CameraMode ~= Enum.CameraMode.LockFirstPerson
	-- lobby trail: a spring towards the avatar; the camera is moved by (trail - avatar), clamped
	local move = Vector3.zero
	if thirdPerson and State.Match == nil and root and root:IsA("BasePart") and not reduced() then
		local target = root.Position
		local lp = lagPos
		if not lp or (lp - target).Magnitude > 12 then
			lp = target -- spawn / teleport: no long slide
		end
		local k = 1 - math.exp(-LAG_RATE * dt)
		lp = (lp :: Vector3):Lerp(target, k)
		lagPos = lp
		local d = (lp :: Vector3) - target
		if d.Magnitude > MAX_LAG then
			d = d.Unit * MAX_LAG
		end
		move = d
	else
		lagPos = nil
	end
	-- speed boots: wider view while running with the boots sparkles on
	local goal = 0
	if root and root:IsA("BasePart") and root:FindFirstChild("EggBootsSparkles") and not reduced() then
		local v = root.AssemblyLinearVelocity
		if Vector2.new(v.X, v.Z).Magnitude > RUNNING then
			goal = BOOTS_FOV
		end
	end
	local kick = punchNow(now)
	if goal ~= fovExtra or fovOwned or kick > 0 then
		local step = FOV_RATE * BOOTS_FOV * dt
		fovExtra = if goal > fovExtra then math.min(goal, fovExtra + step) else math.max(goal, fovExtra - step)
		cam.FieldOfView = Config.Camera.Fov + fovExtra + kick
		fovOwned = fovExtra > 0 or kick > 0
	end
	local rot = shakeOffset(now)
	if move.Magnitude < 1e-3 and not rot then
		return
	end
	local off = CFrame.new(cam.CFrame.Rotation:PointToObjectSpace(move)) * (rot or CFrame.identity)
	local on = cam.CFrame * off
	cam.CFrame = on
	applied, appliedOn = off, on
end

function CameraFx.start()
	if started then
		return
	end
	started = true
	RunService:BindToRenderStep("CTR_CameraFxUndo", Enum.RenderPriority.Camera.Value - 1, undo)
	RunService:BindToRenderStep("CTR_CameraFx", Enum.RenderPriority.Camera.Value + 3, apply)
end

return CameraFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="282">
          <Properties>
            <string name="Name">CameraGuard</string>
            <string name="Source"><![CDATA[--!strict
-- Camera guard (Master Prompt 4, sections 28 and 51): keeps the player's camera out of opaque world geometry.
--
-- Cause of the "wood-filled screen" in the workshop: Roblox's own camera script (Poppercam) only pulls the
-- camera in for parts that are CanCollide = true. The Blender kit models are placed as anchored,
-- NON-colliding MeshParts (KitModels.clone: "Parts stay anchored and non-colliding"), and the Kit.deco
-- parts are non-colliding and non-queryable, so the default camera happily flew through roofs, beams and
-- shelves. Making all of that collidable would trap avatars, so the camera is handled separately here
-- and no collision is changed.
--
-- Active whenever the view is third person: the whole lobby (owner decision 2026-10-10: the lobby is third person,
-- hunts are first person) and hunts when Config.Camera.FirstPerson = false. In first person (Player.CameraMode =
-- LockFirstPerson, set only by CameraMode) this guard does nothing. Zoom limits belong to CameraMode
-- (Config.Camera.Lobby).
--
-- The lobby is the outdoor pet park: its edge is an invisible boundary (CanQuery = false) in front of the jungle
-- wall and the cliffs, so no ray can see it. While the head is inside the park box (Config.Lodge: the boundary and a
-- sky ceiling well above the longest lobby zoom) the distance to the box face behind the camera counts as one more
-- hit (CameraSolve.boxExit), so the camera never swings out through the jungle wall. Outdoors there is no roof: the
-- ceiling never shortens a normal zoom. Hunt arenas are far outside the box (boxExit gives nothing there).
--
-- Every frame, after the default camera has run, five thin rays go from the head to the camera position the
-- default script chose. The nearest real occluder pulls the camera in (at once, never inside it) and it eases
-- back out at 9 studs per second (CameraSolve). Not occluders:
--   * the avatars, small parts (largest side under 3 studs: props, grit, foliage bits), see-through parts
--     (Transparency >= 0.5) and the client's own pile / guide folders
--   * anything marked for the camera: attribute `CameraIgnore = true` on the part or on ANY ancestor
--     (Model / Folder), or the CollectionService tag "CameraIgnore". Builders set this on decorative-only
--     trim, canopy fringe, hanging signs and foliage that should never push the camera.
-- Parts with CanQuery = false are never hit by rays, which is how Kit.deco parts are skipped already.
-- Floors, walls and boundaries stay occluders (they are big, opaque and queryable). Also sets sensible
-- zoom limits so the camera cannot sit inside the avatar or drift across the map.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local CameraSolve = require(Shared.CameraSolve)
local Config = require(Shared.Config)

local CameraGuard = {}

local player = Players.LocalPlayer

CameraGuard.IgnoreAttribute = "CameraIgnore"
CameraGuard.IgnoreTag = "CameraIgnore"

local SMALL = 3 -- studs: parts smaller than this on every side never block the camera
local PROBE = 0.45 -- studs: offset of the four side rays from the centre ray
local MAX_STEPS = 6 -- ignorable parts skipped per ray
local GROUND_CLEAR = 1.2 -- studs: lowest the camera may sit above the avatar's feet while standing on something

local ignoreCache: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local cap: number? = nil
local started = false
local lastCharacter: Model? = nil

local function marked(inst: Instance): boolean
	local c = ignoreCache[inst]
	if c ~= nil then
		return c
	end
	local value = false
	local cur: Instance? = inst
	while cur and cur ~= Workspace do
		if cur:GetAttribute(CameraGuard.IgnoreAttribute) == true or CollectionService:HasTag(cur, CameraGuard.IgnoreTag) then
			value = true
			break
		end
		cur = cur.Parent
	end
	ignoreCache[inst] = value
	return value
end

-- True when a hit part should not push the camera.
function CameraGuard.ignorable(part: BasePart): boolean
	if part.Transparency >= 0.5 then
		return true
	end
	local s = part.Size
	if part.ClassName ~= "Terrain" and math.max(s.X, s.Y, s.Z) < SMALL then
		return true
	end
	return marked(part)
end

-- Reused every frame (no per-frame tables or RaycastParams).
local EXCLUDE_FOLDERS = { "CT_Rocks_LocalPile", "CT_Rocks_Grit", "CT_Rocks_Guide", "CT_Rocks_Selection" }
local excludeBuf: { Instance } = {}
local skipBuf: { Instance } = {}
local hitsBuf: { number? } = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function baseExclude(): { Instance }
	local list = excludeBuf
	table.clear(list)
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	for _, name in EXCLUDE_FOLDERS do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(list, f)
		end
	end
	local cam = Workspace.CurrentCamera
	if cam then
		table.insert(list, cam)
	end
	return list
end

-- Distance from `origin` along `dir` to the first real occluder within `maxDist`, or nil.
local function firstHit(origin: Vector3, dir: Vector3, maxDist: number, exclude: { Instance }): number?
	local params = rayParams
	local skip = skipBuf
	table.clear(skip)
	table.move(exclude, 1, #exclude, 1, skip)
	for _ = 1, MAX_STEPS do
		params.FilterDescendantsInstances = skip
		local hit = Workspace:Raycast(origin, dir * maxDist, params)
		if not hit then
			return nil
		end
		local inst = hit.Instance
		if not CameraGuard.ignorable(inst) then
			return (hit.Position - origin).Magnitude
		end
		table.insert(skip, inst)
	end
	return nil
end

local function step(dt: number)
	local cam = Workspace.CurrentCamera
	local char = player.Character
	if player.CameraMode == Enum.CameraMode.LockFirstPerson then
		cap = nil -- first person: the camera is in the head, CameraMode owns it
		return
	end
	if not cam or not char or cam.CameraType == Enum.CameraType.Scriptable then
		cap = nil
		return
	end
	if char ~= lastCharacter then
		lastCharacter = char
		cap = nil
	end
	local head = (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")) :: BasePart?
	if not head then
		return
	end
	local origin = head.Position + Vector3.new(0, 0.4, 0)
	local camCf = cam.CFrame
	local vec = camCf.Position - origin
	local wanted = vec.Magnitude
	if wanted < CameraSolve.MinDistance then
		cap = nil
		return
	end
	local dir = vec / wanted
	local right = dir:Cross(Vector3.yAxis)
	if right.Magnitude < 0.01 then
		right = Vector3.xAxis
	end
	right = right.Unit
	local up = right:Cross(dir).Unit
	local exclude = baseExclude()
	local hits = hitsBuf
	table.clear(hits)
	local r, u = right * PROBE, up * PROBE
	table.insert(hits, firstHit(origin, dir, wanted, exclude))
	table.insert(hits, firstHit(origin + r, dir, wanted, exclude))
	table.insert(hits, firstHit(origin - r, dir, wanted, exclude))
	table.insert(hits, firstHit(origin + u, dir, wanted, exclude))
	table.insert(hits, firstHit(origin - u, dir, wanted, exclude))
	local L = Config.Lodge
	if Workspace:FindFirstChild("CT_Rocks_Lobby") then
		table.insert(hits, CameraSolve.boxExit(origin, dir, Vector3.new(L.MinX, L.FloorY, L.MinZ), Vector3.new(L.MaxX, L.CeilingY, L.MaxZ)))
	end
	local allowed = CameraSolve.allowed(wanted, hits)
	local nextCap = CameraSolve.smooth(cap, allowed, dt)
	cap = nextCap
	local final = math.min(wanted, nextCap)
	local pos = if wanted - final > 0.01 then origin + dir * final else camCf.Position
	-- ground floor: looking up from a low angle, the camera could dip under the ground (the view filled with
	-- grass). Keep it a little above the avatar's feet; it still looks up, just from above the ground.
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char:FindFirstChildOfClass("Humanoid")
	if root and hum and hum.FloorMaterial ~= Enum.Material.Air then
		local floorY = root.Position.Y - root.Size.Y * 0.5 - hum.HipHeight + GROUND_CLEAR
		if pos.Y < floorY then
			pos = Vector3.new(pos.X, floorY, pos.Z)
		end
	end
	if pos ~= camCf.Position then
		cam.CFrame = CFrame.new(pos) * camCf.Rotation
	end
end

function CameraGuard.start()
	if started then
		return
	end
	started = true
	-- runs every frame but steps aside in first person (see step); CameraMode sets the zoom limits
	RunService:BindToRenderStep("CTR_CameraGuard", Enum.RenderPriority.Camera.Value + 1, step)
end

return CameraGuard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="283">
          <Properties>
            <string name="Name">CameraMode</string>
            <string name="Source"><![CDATA[--!strict
-- The one owner of camera mode, cursor and local avatar visibility (docs/m6/FIRST_PERSON.md,
-- docs/m11/CAMERA_SPAWN_FIX.md).
--
-- Hunt = first person; lobby = third person (owner decision 2026-10-10). In a hunt (State.Match from Init until
-- Left, or the Match place of Teleport mode) the view is Roblox's own supported first person:
-- Player.CameraMode = LockFirstPerson, so PlayerModule keeps doing the looking (mouse, touch drag, right stick).
-- In the lobby it is the normal Classic camera (free mouse, right-drag to turn, zoom Config.Camera.Lobby;
-- CameraGuard keeps it inside the lodge room). The switch happens once per transition (State.Changed "Match"
-- and CameraMode.restore). This module never runs a camera-follow loop. It writes Camera.CFrame only once per arrival in a
-- hunt (the first-person view starts looking at the pile, not wherever the lobby camera pointed: owner video, the view
-- began facing the back of the nest board), never per frame.
--
-- Desktop, first-person hunt: holding a free-cursor key (Config.Camera.FreeCursorKeys, Left / Right Alt) frees
-- the mouse so HUD buttons can be clicked; releasing it locks the view again.
--
-- Modal stack: UI.block(key, on) is the stack (every panel, the reveal and the results card hold a key).
-- The cursor is freed while ANY key is held and first person returns when the LAST one is released. A menu
-- swapped for another (close then open in the same frame) never gives a frame of mouse look: the change is
-- applied on the next deferred step from the state at that moment. The free cursor uses a Modal GuiButton,
-- the supported way to unlock the mouse under LockFirstPerson: the engine only honours it while the button is
-- Visible, inside the viewport and in an enabled ScreenGui, so it sits transparent at the top-left pixel of the
-- screen (it was off-screen at -10,-10 before, which is the likely reason the mouse stayed locked in Studio).
--
-- Lifecycle: fresh join, CharacterAdded (a new humanoid; the old one is never kept), CurrentCamera
-- replaced, and deliberate cinematics (CameraMode.cinematic) all re-apply the defaults once. A Scriptable
-- camera left behind is put back to Custom on those events (and on match transitions via
-- CameraMode.restore) unless the camera carries the attribute CT_Cinematic. No head bob here; the small lobby
-- camera trail, the speed-boots FOV and the shared big-moment shake live in CameraFx (they add an offset after the
-- default camera and take it off before its next step). Local-only visibility: LocalTransparencyModifier on the head, hats, torso and the own basket,
-- so other players still see the full avatar.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local CameraModeRules = require(Shared.CameraModeRules)
local State = require(script.Parent.State)
local UI = require(script.Parent.ui.UI)

local CameraMode = {}

CameraMode.Changed = Instance.new("BindableEvent") -- (cursorFree: boolean)

local player = Players.LocalPlayer

local started = false
local cinematicKeys: { [string]: true } = {}
local decision: CameraModeRules.Decision = CameraModeRules.decide({ FirstPerson = Config.Camera.FirstPerson, Blocked = false, Cinematic = false })
local dirty = false
local unblockedAt = -math.huge
local modalButton: TextButton? = nil
local camera: Camera? = nil
local cameraConns: { RBXScriptConnection } = {}
local charConns: { RBXScriptConnection } = {}
local hideParts: { BasePart } = {}
local hiddenRoots: { [Instance]: RBXScriptConnection } = {}
local backBound = false
local peekHeld = false -- a free-cursor key is held (desktop, first-person hunt)
local appliedFirstPerson: boolean? = nil -- the view the player properties were last set for
local aimPending = false -- first person just began (or the avatar was moved across the map): face the pile once
local lastRootPos: Vector3? = nil -- avatar root last frame (a jump of TELEPORT_STUDS = a server move to a spot)
local cinematicShown = false -- the own avatar was shown for a hunt cinematic and must be hidden again afterwards
local TELEPORT_STUDS = 15
-- Back to the lobby (bug 246): the third-person camera is put behind the avatar at a normal zoom and a gentle
-- downward pitch, never left at the first-person distance or the hunt's last look direction (which tilted to
-- the sky). It is placed again if the server moves the avatar within BEHIND_SECONDS.
local BEHIND_ZOOM = 13 -- studs from the head
local BEHIND_PITCH = math.rad(18) -- looking down at the avatar
local BEHIND_SECONDS = 4
local behindPending = false
local behindUntil = 0

-- In a hunt: an arena round from Init until Left (State.Match), or the Match place of Teleport mode.
function CameraMode.inHunt(): boolean
	return State.Match ~= nil or State.Teleport == true
end

local function firstPersonOn(): boolean
	return CameraModeRules.firstPerson(Config.Camera.FirstPerson == true, CameraMode.inHunt())
end

-- True while the player looks through their own eyes (the camera mode is first person and no cinematic holds it).
function CameraMode.firstPerson(): boolean
	return firstPersonOn() and next(cinematicKeys) == nil
end

-- True while the cursor is FREED: a menu, a cinematic or a held free-cursor key (first-person hunt). In the
-- third-person lobby the mouse is always usable; this stays false there unless a menu is open.
function CameraMode.cursorFree(): boolean
	return decision.CursorFree
end

-- Seconds since the last blocking panel closed (large when none did).
function CameraMode.sinceUnblocked(): number
	return os.clock() - math.max(unblockedAt, UI.unblockedAt())
end

-- May a gameplay input that arrives now act? False while a panel is open and for a moment after the last
-- one closed, so the key or tap that closed a menu cannot also pick up a rock or swing the tool.
function CameraMode.mayAct(): boolean
	return CameraModeRules.mayAct(UI.blocked() or decision.CursorFree, os.clock(), math.max(unblockedAt, UI.unblockedAt()), Config.Camera.GraceAfterModal)
end

-- Local-only hiding ---------------------------------------------------------------------------------

local function isHidden(part: BasePart, char: Model): boolean
	-- the upper arms sit beside the eye and loom over the view; forearms, hands and the held tool stay
	if part.Name == "LeftUpperArm" or part.Name == "RightUpperArm" then
		return part.Parent == char
	end
	if part.Name == "Head" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Torso" then
		return part.Parent == char
	end
	return part:FindFirstAncestorOfClass("Accessory") ~= nil
end

local function bindCharacter(char: Model?)
	for _, c in charConns do
		c:Disconnect()
	end
	table.clear(charConns)
	table.clear(hideParts)
	if not char then
		return
	end
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") and isHidden(d, char) then
			table.insert(hideParts, d)
		end
	end
	-- accessories and clothing can arrive after the spawn: keep the list current without per-frame searching
	table.insert(charConns, char.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") and isHidden(d, char) then
			table.insert(hideParts, d)
		end
	end))
	table.insert(charConns, char.DescendantRemoving:Connect(function(d)
		if d:IsA("BasePart") then
			local i = table.find(hideParts, d)
			if i then
				table.remove(hideParts, i)
			end
		end
	end))
end

local function setLocal(inst: Instance, value: number)
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") and d.LocalTransparencyModifier ~= value then
			d.LocalTransparencyModifier = value
		end
	end
end

-- A model that must not block the first-person view (the own carry basket). Its parts are hidden locally
-- while the view is first person and shown again otherwise; parts added later are covered too.
function CameraMode.hideLocally(root: Instance)
	if hiddenRoots[root] then
		return
	end
	hiddenRoots[root] = root.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") and CameraMode.firstPerson() then
			d.LocalTransparencyModifier = 1
		end
	end)
	if CameraMode.firstPerson() then
		setLocal(root, 1)
	end
end

function CameraMode.showLocally(root: Instance)
	local conn = hiddenRoots[root]
	if not conn then
		return
	end
	conn:Disconnect()
	hiddenRoots[root] = nil
	if root.Parent then
		setLocal(root, 0)
	end
end

local FADE_ARMS: { [string]: boolean } = { LeftLowerArm = true, RightLowerArm = true, LeftHand = true, RightHand = true }
-- The own held tool and forearms are hidden locally in first person.
local function fadeTool(char: Model, camPos: Vector3)
	-- the own held tool is never drawn from the avatar's hand in first person: it ghosts large at the lower right.
	-- A small copy rests at the edge (CarryGlimpse) and the work stroke has its own copy (StationView).
	local tool = char:FindFirstChild("CT_Rocks_HeldTool")
	if tool then
		for _, d in tool:GetDescendants() do
			if d:IsA("BasePart") and d.LocalTransparencyModifier ~= 1 then
				d.LocalTransparencyModifier = 1
			end
		end
	end
	for name in FADE_ARMS do
		local a = char:FindFirstChild(name)
		if a and a:IsA("BasePart") and a.LocalTransparencyModifier ~= 1 then
			-- the own forearms and hands are never drawn in first person (a skin-coloured block over the work view);
			-- the held tool stays visible and is carried by the stroke animation
			a.LocalTransparencyModifier = 1
		end
	end
end

-- A hunt cinematic (the countdown swoop, the reveal) looks at the avatar from outside, but first person had hidden the
-- whole body locally while its held tool came back with every re-attach: owner video, a pink hammer floating alone over
-- the nest. While a hunt cinematic holds the camera the own avatar is shown whole (tool in its hand), fading out only
-- as the camera reaches the eyes (the swoop ends there).
local function cinematicBody(char: Model, camPos: Vector3)
	local head = char:FindFirstChild("Head")
	local d = if head and head:IsA("BasePart") then (camPos - head.Position).Magnitude else math.huge
	local v = math.clamp((5 - d) / 2.5, 0, 1)
	setLocal(char, v)
	cinematicShown = true
end

-- First person starts facing the pile (the spawn spots face it; RoundIntro's swoop ends the same way): the arena
-- centre when the round names it, else the avatar's own facing. Slightly down, like the swoop's last frame.
local function aimAtPile(cam: Camera, char: Model)
	local head = char:FindFirstChild("Head")
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not (head and head:IsA("BasePart") and rootPart and rootPart:IsA("BasePart")) then
		return
	end
	local eye = cam.CFrame.Position
	local m = State.Match
	local centre: Vector3? = if m and typeof(m.Center) == "Vector3" then m.Center else nil
	local flatDir = if centre then Vector3.new(centre.X - eye.X, 0, centre.Z - eye.Z) else Vector3.zero
	if flatDir.Magnitude < 1 then
		local look = rootPart.CFrame.LookVector
		flatDir = Vector3.new(look.X, 0, look.Z)
	end
	if flatDir.Magnitude < 1e-3 then
		return
	end
	cam.CFrame = CFrame.lookAt(eye, eye + flatDir.Unit * 10 - Vector3.new(0, 2.5, 0))
end

-- Third person behind the avatar at BEHIND_ZOOM. The zoom is pinned for a moment (min = max) so PlayerModule takes
-- it instead of keeping the first-person distance, then the lobby range comes back.
local zoomToken = 0
local function placeBehind(cam: Camera, rootPart: BasePart)
	if cam.CameraType ~= Enum.CameraType.Custom then
		return
	end
	local look = rootPart.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = if flatLook.Magnitude > 1e-3 then flatLook.Unit else Vector3.new(0, 0, -1)
	local focus = rootPart.Position + Vector3.new(0, 2, 0)
	local eye = focus - flatLook * (BEHIND_ZOOM * math.cos(BEHIND_PITCH)) + Vector3.new(0, BEHIND_ZOOM * math.sin(BEHIND_PITCH), 0)
	cam.CFrame = CFrame.lookAt(eye, focus)
	local L = Config.Camera.Lobby
	local zoom = math.clamp(BEHIND_ZOOM, L.MinZoom, L.MaxZoom)
	zoomToken += 1
	local token = zoomToken
	player.CameraMaxZoomDistance = math.max(zoom, player.CameraMinZoomDistance)
	player.CameraMinZoomDistance = zoom
	player.CameraMaxZoomDistance = zoom
	task.delay(0.3, function()
		if token == zoomToken and not firstPersonOn() then
			player.CameraMaxZoomDistance = L.MaxZoom -- raise the maximum first so it never sits below the minimum
			player.CameraMinZoomDistance = L.MinZoom
		end
	end)
end

local function step()
	local cam = camera
	local char = player.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	local moved = false
	if rootPart and rootPart:IsA("BasePart") then
		local pos = rootPart.Position
		if lastRootPos and (pos - lastRootPos).Magnitude > TELEPORT_STUDS then
			aimPending = true -- placed on a hunt spot (or back on it after a fall)
			moved = true
		end
		lastRootPos = pos
	end
	if not CameraMode.firstPerson() and cam and rootPart and rootPart:IsA("BasePart") and next(cinematicKeys) == nil then
		if moved and os.clock() < behindUntil then
			behindPending = true -- the server moved the avatar to the lobby after the hunt ended
		end
		if behindPending and cam:GetAttribute("CT_Cinematic") ~= true then
			behindPending = false
			placeBehind(cam, rootPart)
		end
	end
	if CameraMode.inHunt() and next(cinematicKeys) ~= nil then
		if cam and char then
			cinematicBody(char, cam.CFrame.Position)
		end
		aimPending = false -- the cinematic hands over looking at the pile itself
		return
	end
	if not CameraMode.firstPerson() then
		return
	end
	if cinematicShown and char then
		-- back to first person: PlayerModule only writes its transparency on change, so hide the body here once
		cinematicShown = false
		setLocal(char, 1)
	end
	if aimPending and cam and char and CameraMode.inHunt() then
		aimPending = false
		aimAtPile(cam, char)
	end
	-- runs after PlayerModule's own transparency pass (it also touches these parts)
	for _, p in hideParts do
		if p.LocalTransparencyModifier ~= 1 then
			p.LocalTransparencyModifier = 1
		end
	end
	if cam and char then
		fadeTool(char, cam.CFrame.Position)
	end
end

-- Applying the decision -----------------------------------------------------------------------------

local function ensureModalButton()
	if modalButton and modalButton.Parent then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "CT_CameraMode"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = -10
	gui.IgnoreGuiInset = true
	gui.Parent = player:WaitForChild("PlayerGui")
	local b = Instance.new("TextButton")
	b.Name = "FreeCursor"
	b.Text = ""
	b.Modal = true
	b.BackgroundTransparency = 1
	b.BorderSizePixel = 0
	-- inside the viewport (top-left pixel, under the Roblox menu button), fully transparent: an off-screen Modal
	-- button is not honoured by the engine, so the mouse stayed locked
	b.Size = UDim2.fromOffset(1, 1)
	b.Position = UDim2.fromOffset(0, 0)
	b.AutoButtonColor = false
	b.Selectable = false
	b.Active = false
	b.Visible = false
	b.Parent = gui
	modalButton = b
end

local function bindBack(on: boolean)
	if on == backBound then
		return
	end
	backBound = on
	if on then
		-- gamepad B (and Escape on a keyboard) closes the open panel; the press is sunk so nothing else reacts to it
		ContextActionService:BindActionAtPriority("CTR_ModalBack", function(_, state)
			if state == Enum.UserInputState.Begin and UI.topOpen() ~= nil then
				UI.closeTop() -- a confirmation dialog first, then the menu under it
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB, Enum.KeyCode.Escape)
	else
		ContextActionService:UnbindAction("CTR_ModalBack")
	end
end

-- Suspending look and move while a blocking panel owns the screen ---------------------------------------
-- Cause of the world turning behind a menu (owner recording 2026-10-09, NOT reproduced offline: the mock has no
-- PlayerModule): freeing the cursor only unlocks the mouse. PlayerModule keeps reading look input (mouse delta
-- while the engine reports LockCenter, right-drag, right stick, touch drag) and move input (WASD, left stick), so
-- the view could still turn and the avatar still walk behind the panel. One place now switches all of it off and
-- back on, from the same decision that frees the cursor: the supported Controls:Disable() / Enable() for move and
-- jump, CameraInput.setInputEnabled(false) for look when that module exposes it, and a sunk action for the move
-- keys and both sticks as a belt (look input that bypasses CameraInput is still eaten). No per-frame camera writes.
local controlsObj: any = nil
local cameraInputObj: any = nil
local inputResolved = false
local inputSuspended = false
local moveSuspended = false
local SINK_KEYS = {
	Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Space,
	Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right,
	Enum.KeyCode.Thumbstick1, Enum.KeyCode.Thumbstick2,
}

local function resolveInput()
	if inputResolved then
		return
	end
	local scripts = player:FindFirstChild("PlayerScripts")
	local pm = scripts and scripts:FindFirstChild("PlayerModule")
	if not (pm and pm:IsA("ModuleScript")) then
		return -- not there yet (or the offline preview): try again on the next change
	end
	inputResolved = true
	local ok, mod = pcall(require, pm)
	if ok and type(mod) == "table" then
		local okc, c = pcall(function()
			return mod:GetControls()
		end)
		if okc then
			controlsObj = c
		end
	end
	local cm = pm:FindFirstChild("CameraModule")
	local ci = cm and cm:FindFirstChild("CameraInput")
	if ci and ci:IsA("ModuleScript") then
		local ok2, m = pcall(require, ci)
		if ok2 and type(m) == "table" and type(m.setInputEnabled) == "function" then
			cameraInputObj = m
		end
	end
end

-- `move`: walking/jumping is suspended too (a menu or cinematic holds the screen). The desktop free-cursor peek
-- (Alt held in a hunt) only suspends the look input: the player keeps walking while the mouse is free (audit 15).
local function suspendInput(on: boolean, move: boolean)
	local moveOn = on and move
	if on == inputSuspended and moveOn == moveSuspended then
		return
	end
	local lookChanged = on ~= inputSuspended
	local moveChanged = moveOn ~= moveSuspended
	inputSuspended = on
	moveSuspended = moveOn
	resolveInput()
	if controlsObj and moveChanged then
		pcall(function()
			if moveOn then
				controlsObj:Disable()
			else
				controlsObj:Enable()
			end
		end)
	end
	if cameraInputObj and lookChanged then
		pcall(function()
			cameraInputObj.setInputEnabled(not on)
		end)
	end
	if moveChanged then
		if moveOn then
			ContextActionService:BindActionAtPriority("CTR_ModalSink", function()
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value, table.unpack(SINK_KEYS))
		else
			ContextActionService:UnbindAction("CTR_ModalSink")
		end
	end
end
CameraMode.suspendedInput = function(): boolean
	return inputSuspended
end

-- The own body comes back once when first person ends (PlayerModule's transparency pass only writes on change,
-- so a 1 left by the first-person hiding would otherwise stay).
local function showOwnBody()
	local char = player.Character
	cinematicShown = false
	if char then
		setLocal(char, 0)
	end
end

local function applyDefaults()
	local fp = firstPersonOn()
	if fp then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
		player.CameraMinZoomDistance = 0.5 -- lower the minimum first so it never exceeds the maximum
		player.CameraMaxZoomDistance = 0.5
	else
		local L = Config.Camera.Lobby
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMaxZoomDistance = L.MaxZoom -- raise the maximum first so it never sits below the minimum
		player.CameraMinZoomDistance = L.MinZoom
	end
	if appliedFirstPerson ~= fp then
		local was = appliedFirstPerson
		appliedFirstPerson = fp
		aimPending = fp -- a hunt began: its first-person view starts facing the pile
		if not fp then
			if was == true then
				showOwnBody()
				behindPending = true -- back from a hunt: camera behind the avatar at a normal zoom (bug 246)
				behindUntil = os.clock() + BEHIND_SECONDS
			end
			-- third person: the ordinary free mouse (right-drag turns the view)
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end
end

local function apply()
	dirty = false
	local was = decision
	if appliedFirstPerson ~= firstPersonOn() then
		applyDefaults() -- a hunt began or ended since the last apply
	end
	decision = CameraModeRules.decide({ FirstPerson = firstPersonOn(), Blocked = UI.blocked(), Cinematic = next(cinematicKeys) ~= nil, Peek = peekHeld })
	if was.CursorFree and not decision.CursorFree then
		unblockedAt = os.clock()
	end
	ensureModalButton()
	if modalButton then
		modalButton.Visible = decision.CursorFree
	end
	suspendInput(decision.CursorFree, UI.blocked() or next(cinematicKeys) ~= nil)
	if firstPersonOn() then
		if decision.CursorFree then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		elseif was.CursorFree then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
		-- the reticle is the pointer while the view is locked; the arrow shows whenever the mouse is free
		UserInputService.MouseIconEnabled = decision.CursorFree
	else
		UserInputService.MouseIconEnabled = true -- third person: always the normal cursor
	end
	bindBack(UI.topOpen() ~= nil)
	if was.CursorFree ~= decision.CursorFree then
		CameraMode.Changed:Fire(decision.CursorFree)
	end
	local hide = if CameraMode.firstPerson() then 1 else 0
	for root in hiddenRoots do
		setLocal(root, hide)
	end
end

local function markDirty()
	if dirty then
		return
	end
	dirty = true
	task.defer(function()
		if dirty then
			apply()
		end
	end)
end

-- Put the camera back to normal play: Custom type on the current humanoid, the default field of view.
-- Called on spawn, camera replacement, lobby return, rematch and result transitions. A deliberate
-- cinematic (key held or CT_Cinematic attribute) is left alone.
function CameraMode.restore()
	applyDefaults()
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	if next(cinematicKeys) == nil and cam:GetAttribute("CT_Cinematic") ~= true then
		if cam.CameraType == Enum.CameraType.Scriptable or cam.CameraType == Enum.CameraType.Fixed then
			cam.CameraType = Enum.CameraType.Custom
		end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and cam.CameraSubject ~= hum then
			cam.CameraSubject = hum
		end
		if firstPersonOn() and cam.CameraType == Enum.CameraType.Custom and math.abs(cam.FieldOfView - Config.Camera.Fov) > 0.01 then
			cam.FieldOfView = Config.Camera.Fov
		end
	end
	markDirty()
end

-- A deliberate presentation camera: while any key is held the cursor is free and first person is suspended.
-- Releasing the last key restores first person (the default camera script takes over again, so a stale
-- arena position can never come back).
function CameraMode.cinematic(key: string, on: boolean)
	local had = next(cinematicKeys) ~= nil
	if on then
		cinematicKeys[key] = true
	else
		cinematicKeys[key] = nil
	end
	if had and next(cinematicKeys) == nil then
		CameraMode.restore()
	end
	markDirty()
end

local function bindCamera(cam: Camera?)
	for _, c in cameraConns do
		c:Disconnect()
	end
	table.clear(cameraConns)
	camera = cam
	if not cam then
		return
	end
	CameraMode.restore()
	-- something left it Scriptable without a cinematic: take it back once, on the change
	table.insert(cameraConns, cam:GetPropertyChangedSignal("CameraType"):Connect(function()
		if cam.CameraType == Enum.CameraType.Scriptable and next(cinematicKeys) == nil and cam:GetAttribute("CT_Cinematic") ~= true then
			task.defer(CameraMode.restore)
		end
	end))
end

function CameraMode.start()
	if started then
		return
	end
	started = true
	applyDefaults()
	bindCharacter(player.Character)
	player.CharacterAdded:Connect(function(char)
		bindCharacter(char)
		CameraMode.restore() -- a new humanoid: the camera subject and defaults come back
		if not firstPersonOn() then
			behindPending = true -- a lobby (re)spawn starts with the camera behind the new avatar
		end
	end)
	player.CharacterRemoving:Connect(function()
		bindCharacter(nil)
	end)
	bindCamera(Workspace.CurrentCamera)
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		bindCamera(Workspace.CurrentCamera)
	end)
	UI.BlockChanged.Event:Connect(markDirty)
	-- lobby <-> hunt: switch the view once per transition (Init sets State.Match, Left clears it)
	State.Changed.Event:Connect(function(what)
		if what == "Match" and appliedFirstPerson ~= firstPersonOn() then
			CameraMode.restore()
		end
	end)
	-- desktop free-cursor keys (first-person hunt only): held = mouse free for the HUD, released = view locked again
	local function isPeekKey(code: Enum.KeyCode): boolean
		return table.find(Config.Camera.FreeCursorKeys, code.Name) ~= nil
	end
	UserInputService.InputBegan:Connect(function(input)
		if isPeekKey(input.KeyCode) and not peekHeld then
			peekHeld = true
			markDirty()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isPeekKey(input.KeyCode) and peekHeld then
			peekHeld = false
			markDirty()
		end
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		if peekHeld then
			peekHeld = false -- switching windows: the key-up never arrives
			markDirty()
		end
	end)
	RunService:BindToRenderStep("CTR_CameraMode", Enum.RenderPriority.Camera.Value + 2, step)
	apply()
end

return CameraMode
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="284">
          <Properties>
            <string name="Name">CarryGlimpse</string>
            <string name="Source"><![CDATA[--!strict
-- First-person carried load (docs/m6/FIRST_PERSON.md section 6). The avatar's own crate is hidden from the
-- own view (CameraMode.hideLocally), so a small readable glimpse of the load rides at the lower edge of the
-- view instead: a basket lip with the real rocks (the exact silhouettes in the server's basket list) peeking
-- over it, never near the centre, the horizon, the target rock or the table plate.
--
--   * one bounded local model (a lip, two end posts, at most Config.Camera.Glimpse.Max stone minis),
--     rebuilt only when the accepted basket list changes, moved with the camera in one render step
--   * a pickup cue when the count goes UP after the server accepted it: a short dip of the lip and a quiet
--     stone sound (no predicted feedback exists, so a refused pickup has nothing to undo)
--   * shown only in first person, during a hunt, with a non-empty basket and no panel open; gone with the
--     round (clear) and on any view change; other players see the normal crate on the avatar
-- Purely visual and local: anchored, non-colliding, non-queryable parts, no physics, nothing to collect.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local GeodeModel = require(Shared.GeodeModel)
local State = require(script.Parent.State)
local CarryView = require(script.Parent.CarryView)
local CameraMode = require(script.Parent.CameraMode)
local Audio = require(script.Parent.Audio)
local UI = require(script.Parent.ui.UI)

local CarryGlimpse = {}

local player = Players.LocalPlayer
local WOOD = Color3.fromRGB(150, 112, 74)
local WOOD_DARK = Color3.fromRGB(112, 82, 54)
local METAL = Color3.fromRGB(150, 140, 128) -- warm light grey: the dark rim read as a black strip under the hotbar

local model: Model? = nil
local shownIds: { number } = {}
local seed = 1
local bump = 0 -- 0..1 dip amount of the pickup cue
local bumpTween: Tween? = nil
local bumpValue: NumberValue? = nil
local clock = 0

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

-- Local frame: x right, y up, z toward the viewer's back (the model is placed in front of the camera).
local function build(ids: { number })
	if model then
		model:Destroy()
		model = nil
	end
	if #ids == 0 then
		return
	end
	local m = Instance.new("Model")
	m.Name = "CT_Rocks_Glimpse"
	local anchor = part(m, "Anchor", Vector3.new(0.1, 0.1, 0.1), CFrame.new(), METAL, Enum.Material.SmoothPlastic)
	anchor.Transparency = 1
	m.PrimaryPart = anchor -- the pivot is the local origin, not the bounding box centre
	-- the lip: a front board, a darker back board and a yellow band like the station trim
	part(m, "LipFront", Vector3.new(1.9, 0.5, 0.14), CFrame.new(0, 0, 0.5), WOOD_DARK, Enum.Material.WoodPlanks)
	part(m, "Band", Vector3.new(1.94, 0.1, 0.16), CFrame.new(0, 0.1, 0.5), Config.Palette.Yellow, Enum.Material.SmoothPlastic)
	part(m, "Rim", Vector3.new(1.98, 0.07, 0.2), CFrame.new(0, 0.27, 0.5), METAL, Enum.Material.Metal)
	part(m, "Floor", Vector3.new(1.8, 0.1, 0.9), CFrame.new(0, -0.22, 0.1), WOOD, Enum.Material.WoodPlanks)
	for _, sx in { -0.93, 0.93 } do
		part(m, "End", Vector3.new(0.12, 0.5, 0.9), CFrame.new(sx, 0, 0.1), WOOD, Enum.Material.WoodPlanks)
	end
	local slots = {
		Vector3.new(-0.62, 0.42, 0.2), Vector3.new(0, 0.44, 0.2), Vector3.new(0.62, 0.42, 0.2),
		Vector3.new(-0.3, 0.62, -0.1), Vector3.new(0.3, 0.62, -0.1),
	}
	for i, id in ids do
		if i > math.min(Config.Camera.Glimpse.Max, #slots) then
			break
		end
		local variant, tint, yaw = GeodeModel.rockLook(id, seed)
		local mini = GeodeModel.rockShell(variant, 0.6, "g" .. i, { Tint = tint, Mini = true })
		mini:PivotTo(CFrame.new(slots[i]) * CFrame.Angles(0, math.rad(yaw), 0))
		mini.Parent = m
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanQuery = false
			d.CanCollide = false
			d.CastShadow = false
		end
	end
	m.Parent = Workspace
	model = m
end

local function sameList(a: { number }, b: { number }): boolean
	if #a ~= #b then
		return false
	end
	for i, v in a do
		if b[i] ~= v then
			return false
		end
	end
	return true
end

local function wanted(): boolean
	local m = State.Match
	return CameraMode.firstPerson() and m ~= nil and (m.Phase == "Searching" or m.Phase == "Countdown") and not UI.blocked()
end

local function cue()
	if UI.Reduced then
		return
	end
	if bumpTween then
		bumpTween:Cancel()
	end
	local nv = bumpValue
	if not nv then
		local made = Instance.new("NumberValue")
		made:GetPropertyChangedSignal("Value"):Connect(function()
			bump = made.Value
		end)
		bumpValue = made
		nv = made
	end
	local value = nv :: NumberValue
	value.Value = 1
	local tw = TweenService:Create(value, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = 0 })
	bumpTween = tw
	tw:Play()
end

local function refresh()
	local ids = CarryView.shown(player.UserId)
	if sameList(ids, shownIds) and (model ~= nil) == (#ids > 0) then
		return
	end
	local grew = #ids > #shownIds
	shownIds = ids
	build(ids)
	if grew and wanted() then
		cue()
		Audio.pickup()
	end
end

local function place()
	local cam = Workspace.CurrentCamera
	local m = model
	if not m or not cam then
		return
	end
	if not wanted() then
		if m.Parent then
			m.Parent = nil
		end
		return
	end
	if m.Parent ~= Workspace then
		m.Parent = Workspace
	end
	local off = Config.Camera.Glimpse.Offset
	-- facing the same way as the camera, tipped toward the viewer a little so the load reads from above
	m:PivotTo(cam.CFrame * CFrame.new(off.X, off.Y + bump * 0.16, off.Z) * CFrame.Angles(math.rad(-14), 0, math.rad(4)))
end

-- No resting first-person tool: the avatar's own held tool is hidden locally (CameraMode) and a small copy parked at the
-- lower-right edge read as a mallet floating in the air with no hand on it (Studio sweep 189). Between strokes the
-- first-person view shows no tool; StationView's stroke copy swings in for each hit. Other players see the normal tool.

function CarryGlimpse.start()
	RunService:BindToRenderStep("CTR_CarryGlimpse", Enum.RenderPriority.Camera.Value + 3, function(dt)
		clock += dt
		if clock >= 0.1 then
			clock = 0
			refresh()
		end
		place()
	end)
	State.Changed.Event:Connect(function(what)
		if what == "Match" then
			local m = State.Match
			if m == nil then
				CarryGlimpse.clear()
			end
		end
	end)
end

function CarryGlimpse.setSeed(s: number)
	seed = s
end

function CarryGlimpse.clear()
	shownIds = {}
	if model then
		model:Destroy()
		model = nil
	end
	bump = 0
end

return CarryGlimpse
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="285">
          <Properties>
            <string name="Name">CarryView</string>
            <string name="Source"><![CDATA[--!strict
-- Carry basket (V3 loop): a small crate that follows each hunter's avatar and shows 1 to 5 neutral
-- rock miniatures (the exact rocks they hold, from the server's Basket lists, public to everyone).
-- Also the pickup arc (the exact pile rock flies into the basket), the scoop motion, and stowing
-- the hand tool while its owner is collecting (tool only shows at the own table with an empty basket).
--
-- The crate is a Model of anchored, non-colliding parts that follows the torso every frame
-- (RunService.Heartbeat), so it works on R15 (UpperTorso), R6 (Torso) and any other rig (falls back
-- to HumanoidRootPart with a larger offset), never touches a joint and cannot push the avatar.
-- Purely cosmetic: the server owns the baskets.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local GeodeModel = require(Shared.GeodeModel)
local KitModels = require(Shared.KitModels)
local Anim = require(script.Parent.Anim)
local ToolAnim = require(script.Parent.ToolAnim)
local CameraMode = require(script.Parent.CameraMode)
local State = require(script.Parent.State)

local CarryView = {}

local WOOD = Color3.fromRGB(150, 112, 74)
local WOOD_DARK = Color3.fromRGB(112, 82, 54)
local SLOTS = {
	Vector3.new(-0.55, 0.38, -0.26), Vector3.new(0, 0.38, -0.26), Vector3.new(0.55, 0.38, -0.26),
	Vector3.new(-0.27, 0.66, 0.26), Vector3.new(0.27, 0.66, 0.26),
}

-- Same five spots inside the kit basket (Basket_Empty at BASKET_SCALE): two rows resting on the load.
local BASKET_SCALE = 0.8
local SLOTS_KIT = {
	Vector3.new(-0.46, 1.04, -0.2), Vector3.new(0, 1.04, -0.2), Vector3.new(0.46, 1.04, -0.2),
	Vector3.new(-0.23, 1.36, 0.2), Vector3.new(0.23, 1.36, 0.2),
}

-- Phase / Bump drive the walk bounce and the landing plop; Rels are the minis' rest spots inside the crate.
type Basket = { Model: Model, Ids: { number }, Minis: { Model }, Rels: { CFrame }, Kit: boolean?, Phase: number, Bump: number }

local baskets: { [number]: Basket } = {}
local lists: { [number]: { number } } = {} -- uid -> basket ids from the last snapshot
local flying: { [number]: boolean } = {} -- rock ids in the air (not yet shown in the basket)
local tablePos: { [number]: Vector3 } = {} -- uid -> own table position
local caps: { [number]: number } = {} -- uid -> basket capacity from the last snapshot
local seed = 1
local active = false
local toolClock = 0
local started = false

local function part(parent: Instance, name: string, size: Vector3, offset: Vector3, color: Color3, mat: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = CFrame.new(offset)
	p.Color = color
	p.Material = mat or Enum.Material.WoodPlanks
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local METAL = Color3.fromRGB(52, 58, 64)

local function buildCrate(): (Model, boolean)
	local kit = KitModels.clone("Basket_Empty", BASKET_SCALE)
	if kit then
		kit.Name = "CT_Rocks_Basket"
		kit:PivotTo(CFrame.new())
		return kit, true
	end
	local m = Instance.new("Model")
	m.Name = "CT_Rocks_Basket"
	local floor = part(m, "Floor", Vector3.new(1.9, 0.16, 1.3), Vector3.zero, WOOD)
	part(m, "Front", Vector3.new(1.9, 0.62, 0.12), Vector3.new(0, 0.36, -0.59), WOOD_DARK)
	part(m, "Back", Vector3.new(1.9, 0.62, 0.12), Vector3.new(0, 0.36, 0.59), WOOD_DARK)
	part(m, "Left", Vector3.new(0.12, 0.62, 1.3), Vector3.new(-0.89, 0.36, 0), WOOD)
	part(m, "Right", Vector3.new(0.12, 0.62, 1.3), Vector3.new(0.89, 0.36, 0), WOOD)
	-- dark metal corner straps and rim, a yellow band like the station trim
	for _, sx in { -0.9, 0.9 } do
		for _, sz in { -0.6, 0.6 } do
			part(m, "Strap", Vector3.new(0.2, 0.66, 0.2), Vector3.new(sx, 0.36, sz), METAL, Enum.Material.Metal)
		end
	end
	part(m, "RimFront", Vector3.new(1.96, 0.08, 0.16), Vector3.new(0, 0.7, -0.59), METAL, Enum.Material.Metal)
	part(m, "RimBack", Vector3.new(1.96, 0.08, 0.16), Vector3.new(0, 0.7, 0.59), METAL, Enum.Material.Metal)
	part(m, "Band", Vector3.new(1.94, 0.1, 0.14), Vector3.new(0, 0.3, -0.62), Config.Palette.Yellow, Enum.Material.SmoothPlastic)
	-- arch handle (two posts and a bar) so it reads as a carry basket
	for _, sx in { -0.82, 0.82 } do
		part(m, "HandlePost", Vector3.new(0.1, 0.55, 0.1), Vector3.new(sx, 0.95, 0), METAL, Enum.Material.Metal)
	end
	part(m, "HandleBar", Vector3.new(1.74, 0.1, 0.1), Vector3.new(0, 1.22, 0), METAL, Enum.Material.Metal)
	m.PrimaryPart = floor
	m:PivotTo(CFrame.new())
	return m, false
end

-- The part the crate rides on, and its offset, for any rig.
local function anchorOf(char: Model): (BasePart?, CFrame)
	local t = char:FindFirstChild("UpperTorso")
	if t and t:IsA("BasePart") then
		return t, CFrame.new(0, -0.55, -1.05)
	end
	t = char:FindFirstChild("Torso")
	if t and t:IsA("BasePart") then
		return t, CFrame.new(0, -0.65, -1.05)
	end
	t = char:FindFirstChild("HumanoidRootPart")
	if t and t:IsA("BasePart") then
		return t, CFrame.new(0, -0.9, -1.45)
	end
	return nil, CFrame.new()
end

local function charOf(uid: number): Model?
	local p = Players:GetPlayerByUserId(uid)
	return p and p.Character
end

local function reducedMotion(): boolean
	local st = State.Profile and State.Profile.Settings
	return st ~= nil and st.ReducedMotion == true
end

-- Rides the crate on the torso. While its carrier walks the crate bounces in step and the eggs inside
-- jiggle; a landing egg gives one short plop (Bump). Reduced Motion keeps it still.
local function follow(uid: number, b: Basket, dt: number?)
	local char = charOf(uid)
	if not char then
		return
	end
	local a, off = anchorOf(char)
	if not a then
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	local amp = 0
	if root and root:IsA("BasePart") and dt and not reducedMotion() then
		local v = root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		amp = math.clamp((speed - 1) / 14, 0, 1)
		b.Phase = (b.Phase + dt * (6 + speed * 0.45)) % (math.pi * 2)
	end
	local bk = math.clamp((os.clock() - b.Bump) / 0.28, 0, 1)
	local plop = if bk < 1 and not reducedMotion() then math.sin(bk * math.pi) * (1 - bk) else 0
	local bob = math.abs(math.sin(b.Phase)) * 0.12 * amp - plop * 0.12
	local roll = math.sin(b.Phase) * 0.06 * amp
	local cf = a.CFrame * off * CFrame.new(0, bob, 0) * CFrame.Angles(plop * 0.08, 0, roll)
	b.Model:PivotTo(cf)
	if amp > 0 or plop > 0 or b.Phase ~= 0 then
		for i, m in b.Minis do
			local rel = b.Rels[i]
			if rel and m.Parent then
				local j = math.sin(b.Phase * 2 + i * 1.7)
				m:PivotTo(cf * rel * CFrame.new(0, (j * 0.035) * amp + plop * 0.06, 0) * CFrame.Angles(j * 0.12 * amp, 0, j * 0.1 * amp))
			end
		end
	end
end

local function rebuildMinis(b: Basket, ids: { number })
	for _, m in b.Minis do
		m:Destroy()
	end
	table.clear(b.Minis)
	table.clear(b.Rels)
	b.Ids = ids
	local base = b.Model:GetPivot()
	local slots = if b.Kit then SLOTS_KIT else SLOTS
	for i, id in ids do
		if i > #slots then
			break
		end
		local variant, tint, yaw = GeodeModel.rockLook(id, seed)
		local mini = GeodeModel.rockShell(variant, 0.62, "m" .. i, { Tint = tint, Mini = true })
		local rel = CFrame.new(slots[i]) * CFrame.Angles(0, math.rad(yaw), 0)
		mini:PivotTo(base * rel)
		mini.Parent = b.Model
		table.insert(b.Minis, mini)
		table.insert(b.Rels, rel)
	end
end

local function shownIds(uid: number): { number }
	local out = {}
	for _, id in (lists[uid] or ({} :: { number })) do
		if not flying[id] then
			table.insert(out, id)
		end
	end
	return out
end

local function sameList(a: { number }, b: { number }): boolean
	if #a ~= #b then
		return false
	end
	for i, v in a do
		if b[i] ~= v then
			return false
		end
	end
	return true
end

-- A soft gold outline while the basket is full ("go to your nest").
local function updateFullGlow(uid: number, b: Basket)
	local full = #b.Ids >= (caps[uid] or Config.Carry.Capacity)
	local glow = b.Model:FindFirstChild("FullGlow")
	if full and not glow then
		local h = Instance.new("Highlight")
		h.Name = "FullGlow"
		h.FillTransparency = 1
		h.OutlineColor = Color3.fromRGB(255, 212, 80)
		h.OutlineTransparency = 0.25
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.Adornee = b.Model
		h.Parent = b.Model
	elseif glow and not full then
		glow:Destroy()
	end
end

local function refresh(uid: number)
	local want = shownIds(uid)
	local b = baskets[uid]
	if not active or lists[uid] == nil or charOf(uid) == nil then
		if b then
			CameraMode.showLocally(b.Model)
			b.Model:Destroy()
			baskets[uid] = nil
		end
		return
	end
	if not b then
		local model, isKit = buildCrate()
		model.Parent = game:GetService("Workspace")
		local fresh: Basket = { Model = model, Ids = {}, Minis = {}, Rels = {}, Kit = isKit, Phase = 0, Bump = 0 }
		b = fresh
		baskets[uid] = fresh
		if uid == Players.LocalPlayer.UserId then
			-- first person: the own crate would sit in the view; others still see it (CarryGlimpse shows a small lip)
			CameraMode.hideLocally(model)
		end
		follow(uid, fresh)
		rebuildMinis(fresh, want)
	elseif not sameList(b.Ids, want) then
		follow(uid, b)
		rebuildMinis(b, want)
	end
	updateFullGlow(uid, b)
end

-- Hand tool: only shown at the own table with an empty basket (never fights the carry pose).
local function setToolShown(char: Model, shown: boolean)
	local tool = char:FindFirstChild("CT_Rocks_HeldTool")
	if not tool then
		return
	end
	for _, d in tool:GetDescendants() do
		if d:IsA("BasePart") then
			if shown then
				local orig = d:GetAttribute("CTOrigT")
				if orig ~= nil then
					d.Transparency = orig :: number
					d:SetAttribute("CTOrigT", nil)
				end
			elseif d:GetAttribute("CTOrigT") == nil then
				d:SetAttribute("CTOrigT", d.Transparency)
				d.Transparency = 1
			end
		end
	end
end

local function updateTools()
	local stowOn = active
	local seen: { [Model]: boolean } = {}
	for uid, ids in lists do
		local char = charOf(uid)
		if char then
			seen[char] = true
			local show = true
			if stowOn then
				local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local tp = tablePos[uid]
				local near = false
				if root and tp then
					local d = Vector3.new(root.Position.X - tp.X, 0, root.Position.Z - tp.Z).Magnitude
					near = d <= Config.Station.DepositRange + 3
				end
				show = #ids == 0 and near
			end
			setToolShown(char, show)
			-- coherent carry pose for avatars seen from outside (the own first-person view is unchanged)
			local mine = uid == Players.LocalPlayer.UserId
			local want = stowOn and #ids > 0 and not (mine and CameraMode.firstPerson())
			local settings = State.Profile and State.Profile.Settings
			ToolAnim.carry(char, want, settings ~= nil and settings.ReducedMotion == true)
		end
	end
end

function CarryView.start()
	if started then
		return
	end
	started = true
	RunService.Heartbeat:Connect(function(dt: number)
		for uid, b in baskets do
			follow(uid, b, dt)
		end
		toolClock += dt
		if toolClock >= 0.25 then
			toolClock = 0
			if active then
				updateTools()
				-- avatars can load after the snapshot: add baskets that were waiting for one
				for uid in lists do
					if not baskets[uid] then
						refresh(uid)
					end
				end
			end
		end
	end)
end

-- A round began (Init): remember the seed and the tables, show crates for the stations.
function CarryView.init(payload: any)
	CarryView.clear()
	seed = payload.Seed or 1
	active = true
	for _, t in payload.Tables or {} do
		if t.Owner and t.Owner ~= 0 and t.Position then
			tablePos[t.Owner] = t.Position
		end
	end
	CarryView.setStations(payload.Stations or {})
end

function CarryView.setStations(stations: { any })
	local present: { [number]: boolean } = {}
	for _, st in stations do
		present[st.UserId] = true
		lists[st.UserId] = st.Basket or {}
		caps[st.UserId] = st.CarryCap
		refresh(st.UserId)
	end
	for uid in table.clone(lists) do
		if not present[uid] then
			lists[uid] = nil
			refresh(uid)
		end
	end
end

-- Where a flying rock should land: the crate, else the avatar's chest.
function CarryView.basketPoint(uid: number): Vector3?
	if uid == Players.LocalPlayer.UserId and CameraMode.firstPerson() then
		-- first person: rocks fly to the lower edge of the view, where the small basket lip is drawn
		local cam = game:GetService("Workspace").CurrentCamera
		if cam then
			return (cam.CFrame * CFrame.new(Config.Camera.Glimpse.Offset)).Position
		end
	end
	local b = baskets[uid]
	if b then
		return b.Model:GetPivot().Position + Vector3.new(0, 0.5, 0)
	end
	local char = charOf(uid)
	local a = if char then anchorOf(char) else nil
	return if a then (a :: BasePart).Position else nil
end

-- True when an avatar exists for the user (flights need somewhere to go).
function CarryView.hasAvatar(uid: number): boolean
	return charOf(uid) ~= nil
end

-- The exact rock `model` (just removed from the pile) arcs into the carrier's crate and shrinks.
function CarryView.fly(uid: number, model: Model, id: number)
	flying[id] = true
	local start = model:GetPivot()
	local startPos = start.Position
	local spin = CFrame.Angles(0, 0, 0)
	local rot0 = start - startPos
	Anim.run(0.5, function(k)
		if not model.Parent then
			return
		end
		local goal = CarryView.basketPoint(uid) or startPos
		local e = Anim.easeInOut(k)
		local pos = Anim.arc(startPos, goal, 2.6, e)
		spin = CFrame.Angles(k * 2.4, k * 3.1, 0)
		model:PivotTo(CFrame.new(pos) * spin * rot0)
		-- squash before the lift: the egg presses down for the first moments, then springs up and shrinks
		local squash = if k < 0.14 then 1 - 0.14 * (k / 0.14) else 1
		Anim.scale(model, (1 - 0.7 * e) * squash)
	end, function()
		model:Destroy()
		flying[id] = nil
		local b = baskets[uid]
		if b then
			b.Bump = os.clock() -- plop: the crate dips as the egg lands
		end
		refresh(uid)
	end)
end

-- Short reach / scoop motion on the picker's right arm (the tool is stowed, so nothing fights).
function CarryView.scoop(uid: number)
	local char = charOf(uid)
	if char then
		ToolAnim.scoop(char)
	end
end

-- The rocks shown in a hunter's basket (accepted by the server, not still in the air), for the first-person lip.
function CarryView.shown(uid: number): { number }
	return shownIds(uid)
end

function CarryView.count(uid: number): number
	return #(lists[uid] or {})
end

function CarryView.clear()
	for _, b in baskets do
		CameraMode.showLocally(b.Model)
		b.Model:Destroy()
	end
	table.clear(baskets)
	-- give every tool back before forgetting the players
	active = false
	updateTools()
	table.clear(lists)
	table.clear(caps)
	table.clear(flying)
	table.clear(tablePos)
end

return CarryView
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="286">
          <Properties>
            <string name="Name">DevFly</string>
            <string name="Source"><![CDATA[--!strict
-- Dev fly (owner tool): F toggles flying for players the server marked IsDev (DevPets.server: Studio or the place
-- owner). WASD moves along the camera, Space up, Ctrl down. The character is client-owned, so the moves replicate.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local SPEED = 60
local flying = false
local conn: RBXScriptConnection? = nil

local function root(): (BasePart?, Humanoid?)
	local char = player.Character
	local r = char and char:FindFirstChild("HumanoidRootPart")
	local h = char and char:FindFirstChildOfClass("Humanoid")
	return (if r and r:IsA("BasePart") then r else nil), h
end

local function stop()
	flying = false
	if conn then
		conn:Disconnect()
		conn = nil
	end
	local r, h = root()
	if r then
		r.Anchored = false
		r.AssemblyLinearVelocity = Vector3.zero
	end
	if h then
		h.PlatformStand = false
	end
end

local function start()
	local r, h = root()
	if not (r and h) then
		return
	end
	flying = true
	h.PlatformStand = true
	conn = RunService.RenderStepped:Connect(function(dt)
		local rp, hp = root()
		if not (rp and hp) or hp.Health <= 0 then
			stop()
			return
		end
		local cam = Workspace.CurrentCamera
		local look = cam.CFrame.LookVector
		local right = cam.CFrame.RightVector
		local move = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += look end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= look end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += right end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= right end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.yAxis end
		if move.Magnitude > 0 then
			move = move.Unit * SPEED * dt
		end
		local pos = rp.Position + move
		rp.AssemblyLinearVelocity = Vector3.zero
		rp.CFrame = CFrame.lookAt(pos, pos + Vector3.new(look.X, 0, look.Z))
	end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or input.KeyCode ~= Enum.KeyCode.F or player:GetAttribute("IsDev") ~= true then
		return
	end
	if flying then
		stop()
	else
		start()
	end
end)

player.CharacterAdded:Connect(stop)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="287">
          <Properties>
            <string name="Name">DevPetFx</string>
            <string name="Source"><![CDATA[--!strict
-- Studio-only pet effects showcase (owner / screenshot tool; returns at once outside Studio, nothing is sent anywhere).
-- Chat commands:
--   /petfx    a row of nine pets, one per aura tier (Common, Uncommon, Rare, Epic, Legendary, a chase pet, the Void
--             Dragon) plus a Golden and a Rainbow pet. The camera frames the whole row for the auras, then moves in
--             on the Void Dragon for each effect: happy bounce, hit, crit, level up, KO.
--   /fightfx  two pets face each other and play every big fight moment (FightFx): hit, type advantage, crit,
--             special, level up, KO with the winner showcase.
-- The camera is held for the whole show (like the hatch show) and given back at the end. Each step holds about two
-- seconds and is printed to Output as "[DevPetFx] step N: name" and set on Workspace attribute DevFxStep, so a
-- screenshot helper knows what is on screen. The pets live in Workspace.DevPetFx (a Model with a PrimaryPart at the
-- middle of the row), removed when the show ends.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

if not RunService:IsStudio() then
	return
end

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PetModel = require(Shared.PetModel)
local PetFxRules = require(Shared.PetFxRules)
local PetFx = require(script.Parent:WaitForChild("PetFx"))
local FightFx = require(script.Parent:WaitForChild("FightFx"))
local CameraMode = require(script.Parent:WaitForChild("CameraMode"))

local player = Players.LocalPlayer
local STEP = 2.2 -- seconds each step holds for screenshots

local function chasePet(): string
	for id, sp in Config.Minerals :: { [string]: any } do
		if sp.Chase == true and id ~= "CosmicDragon" then
			return id
		end
	end
	return "Raptor"
end

local ROW = {
	{ Rarity = "Common", Mineral = "Raptor" },
	{ Rarity = "Uncommon", Mineral = "Raptor" },
	{ Rarity = "Rare", Mineral = "Raptor" },
	{ Rarity = "Epic", Mineral = "Raptor" },
	{ Rarity = "Legendary", Mineral = "Raptor" },
	{ Rarity = "Legendary", Mineral = chasePet() },
	{ Rarity = "Legendary", Mineral = "CosmicDragon" },
	{ Rarity = "Rare", Mineral = "Raptor", Modifier = "Golden" },
	{ Rarity = "Epic", Mineral = "Raptor", Modifier = "Rainbow" },
}

type Pet = { Model: Model, Fx: any, Ground: Vector3, Spec: { [string]: any } }
local busy = false

local function step(n: number, name: string)
	print(string.format("[DevPetFx] step %d: %s", n, name))
	Workspace:SetAttribute("DevFxStep", name)
end

-- Builds the show: a Model in Workspace with an anchor PrimaryPart, pets placed along `places`, PetFx attached and
-- updated every frame. Returns the pets, the model and a cleanup function.
local function build(specs: { { [string]: any } }, places: { CFrame }): ({ Pet }, Model, () -> ())
	local model = Instance.new("Model")
	model.Name = "DevPetFx"
	local anchor = Instance.new("Part")
	anchor.Name = "Anchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	local mid = Vector3.zero
	for _, cf in places do
		mid += cf.Position
	end
	anchor.CFrame = CFrame.new(mid / #places)
	anchor.Parent = model
	model.PrimaryPart = anchor
	model.Parent = Workspace
	local pets: { Pet } = {}
	for i, spec in specs do
		local ok, m = pcall(PetModel.build, spec, { Scale = 1, Lod = true, NoLight = true })
		if ok and m then
			m:PivotTo(places[i])
			m.Parent = model
			local okF, fx = pcall(PetFx.attach, m, spec, 1, model)
			table.insert(pets, { Model = m, Fx = if okF then fx else nil, Ground = places[i].Position, Spec = spec })
		end
	end
	local conn = RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local cam = Workspace.CurrentCamera
		local camPos = if cam then cam.CFrame.Position else Vector3.zero
		for _, p in pets do
			if p.Fx then
				PetFx.update(p.Fx, p.Ground, 0, 0, false, t, camPos, 0, math.floor(t / 3) % 2 == 0)
			end
		end
	end)
	return pets, model, function()
		conn:Disconnect()
		for _, p in pets do
			if p.Fx then
				PetFx.destroy(p.Fx)
			end
		end
		model:Destroy()
	end
end

local function centre(p: Pet): Vector3
	local h = p.Model:GetAttribute("Height")
	return p.Ground + Vector3.new(0, (if type(h) == "number" then h else 2) * 0.5, 0)
end

-- Holds the camera for the show; returns a function that moves it and one that gives it back.
local function holdCamera(): ((Vector3, Vector3, number?) -> (), () -> ())
	local cam = Workspace.CurrentCamera
	local from, fov = cam.CFrame, cam.FieldOfView
	CameraMode.cinematic("DevPetFx", true)
	cam:SetAttribute("CT_Cinematic", true)
	cam.CameraType = Enum.CameraType.Scriptable
	local function aim(eye: Vector3, focus: Vector3, f: number?)
		TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			CFrame = CFrame.lookAt(eye, focus), FieldOfView = f or 60,
		}):Play()
		task.wait(0.65)
	end
	local function release()
		cam.CFrame = from
		cam.FieldOfView = fov
		cam:SetAttribute("CT_Cinematic", nil)
		cam.CameraType = Enum.CameraType.Custom
		CameraMode.cinematic("DevPetFx", false)
		Workspace:SetAttribute("DevFxStep", nil)
	end
	return aim, release
end

-- The row stands on the ground in front of the player, facing them.
local function frontOf(root: BasePart, dist: number): (CFrame, Vector3)
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	look = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
	local ray = Workspace:Raycast(root.Position + look * dist + Vector3.new(0, 10, 0), Vector3.new(0, -40, 0))
	local groundY = if ray then ray.Position.Y else root.Position.Y - 3
	local c = Vector3.new(root.Position.X, groundY, root.Position.Z) + look * dist
	return CFrame.lookAt(c, c - look), look
end

local function petShow(root: BasePart)
	local base, look = frontOf(root, 16)
	local places: { CFrame } = {}
	for i = 1, #ROW do
		places[i] = base * CFrame.new((i - (#ROW + 1) / 2) * 5, 0, 0)
	end
	local pets, _, cleanup = build(ROW, places)
	local aim, release = holdCamera()
	local ok, err = pcall(function()
		local mid = base.Position + Vector3.new(0, 1.5, 0)
		aim(mid - look * 24 + Vector3.new(0, 7, 0), mid, 70)
		step(1, "auras: all tiers")
		task.wait(STEP + 1)
		local star = pets[7] or pets[#pets] -- the Void Dragon
		local c = centre(star)
		aim(c - look * 11 + Vector3.new(2, 3, 0), c, 60)
		step(2, "aura close-up: Void Dragon")
		task.wait(STEP)
		step(3, "happy bounce")
		PetFx.happy(star.Model)
		task.wait(0.25)
		task.wait(STEP)
		step(4, "hit")
		PetFx.hit(star.Model, { Element = "Fire", Damage = 12 })
		task.wait(STEP)
		step(5, "crit")
		PetFx.hit(star.Model, { Element = "Storm", Crit = true, Damage = 30 })
		task.wait(STEP)
		step(6, "level up")
		PetFx.levelUp(star.Model, 8)
		task.wait(STEP)
		step(7, "KO poof")
		PetFx.ko(star.Model)
		task.wait(STEP)
	end)
	release()
	cleanup()
	if not ok then
		warn("[DevPetFx] " .. tostring(err))
	end
end

local function fightShow(root: BasePart)
	local base, look = frontOf(root, 14)
	local side = base.RightVector
	local aPos = base.Position - side * 4
	local bPos = base.Position + side * 4
	local specs = {
		{ Rarity = "Legendary", Mineral = "CosmicDragon" },
		{ Rarity = "Epic", Mineral = "Raptor" },
	}
	local pets, _, cleanup = build(specs, { CFrame.lookAt(aPos, bPos), CFrame.lookAt(bPos, aPos) })
	local aim, release = holdCamera()
	local ok, err = pcall(function()
		local a, b = pets[1], pets[2]
		assert(a and b, "pets did not build")
		local mid = base.Position + Vector3.new(0, 1.5, 0)
		aim(mid - look * 15 + Vector3.new(0, 4, 0), mid, 62)
		local winColor = PetFxRules.look(a.Spec.Rarity, a.Spec.Mineral, a.Spec.Modifier).Color
		step(1, "fight: hit")
		FightFx.play("hit", { Target = b.Model, Attacker = a.Model, Element = "Cosmic", Damage = 9, Mine = true })
		task.wait(STEP)
		step(2, "fight: type advantage")
		FightFx.play("advantage", { Target = a.Model, Attacker = b.Model, Element = "Fire", Damage = 18, Mine = true })
		task.wait(STEP)
		step(3, "fight: crit")
		FightFx.play("crit", { Target = b.Model, Attacker = a.Model, Element = "Storm", Damage = 31, Mine = true })
		task.wait(STEP)
		step(4, "fight: special")
		FightFx.play("special", { Target = b.Model, Attacker = a.Model, Element = "Cosmic", Damage = 45, Mine = true })
		task.wait(STEP + FightFx.SPECIAL_CHARGE)
		step(5, "fight: level up")
		FightFx.play("levelup", { Target = a.Model, Color = winColor, Level = 9, Mine = true })
		task.wait(STEP)
		step(6, "fight: KO + winner")
		FightFx.play("ko", { Target = b.Model, Attacker = a.Model, Element = "Cosmic", Mine = true, Winner = a.Model, WinnerColor = winColor })
		task.wait(STEP * 2)
	end)
	release()
	cleanup()
	if not ok then
		warn("[DevPetFx] " .. tostring(err))
	end
end

local function run(show: (BasePart) -> ())
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if busy or not root or not root:IsA("BasePart") then
		return
	end
	busy = true
	show(root)
	busy = false
end

local function onText(text: string)
	local cmd = string.lower((string.gsub(text, "%s", "")))
	if cmd == "/petfx" then
		task.spawn(run, petShow)
	elseif cmd == "/fightfx" then
		task.spawn(run, fightShow)
	end
end

TextChatService.SendingMessage:Connect(function(msg: TextChatMessage)
	onText(msg.Text)
end)
player.Chatted:Connect(onText)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="288">
          <Properties>
            <string name="Name">DevPetsClient</string>
            <string name="Source"><![CDATA[--!strict
-- Dev pet spawner button (owner / Studio only; the server decides via the IsDev attribute and re-checks every request).
-- Drawn in the pet style (ui/PetStyle, Theme.Pet): a red DEV tile on the HUD menu column, a white patterned sheet
-- with the title floating over its edge, rarity pills and white pet rows.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
if player:GetAttribute("DevPets") ~= true then
	player:GetAttributeChangedSignal("DevPets"):Wait()
end

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local uiFolder = script.Parent:WaitForChild("ui")
local UI = require(uiFolder:WaitForChild("UI"))
local PetStyle = require(uiFolder:WaitForChild("PetStyle"))
local Theme = require(uiFolder:WaitForChild("Theme"))
local remote = ReplicatedStorage:WaitForChild("DevSpawnPet") :: RemoteFunction

local K = PetStyle.K
local TC = Theme.Color
local RARITY_COLOR = {
	Common = Color3.fromRGB(170, 170, 170), Uncommon = Color3.fromRGB(90, 200, 90), Rare = Color3.fromRGB(70, 140, 255),
	Epic = Color3.fromRGB(170, 80, 230), Legendary = Color3.fromRGB(255, 180, 40),
}
local PANEL_W, PANEL_H = 560, 520

local gui = Instance.new("ScreenGui")
gui.Name = "DevPets"
gui.ResetOnSpawn = false
gui.DisplayOrder = 50
-- Sibling: children draw over their parent. (Instance.new defaults to Global, where the panel's ZIndex 2 hid all of
-- its ZIndex-1 contents behind its own background: the menu opened blank.)
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

-- The DEV button is a small tile at the bottom of the HUD's right menu column (so it never covers the left column or
-- the thumbstick); it falls back to the right edge when the HUD is not there. Hidden in hunts and the tower.
local hudGui = player:WaitForChild("PlayerGui"):WaitForChild("CrackTheRocks", 10)
local menu = if hudGui then hudGui:WaitForChild("Menu", 10) else nil
-- same size as the menu tiles (Hud TILE) so it sits on their two-column grid; the red pet-style button
local open = UI.button(menu or gui, "DEV", "red", nil, { Name = "DevTile", LayoutOrder = 99, Size = UDim2.fromOffset(60, 60), TextSize = 20 })
if not menu then
	open.AnchorPoint = Vector2.new(1, 0.5)
	open.Position = UDim2.new(1, -8, 0.62, 0)
end
local function refreshOpen()
	open.Visible = player:GetAttribute("MatchKey") == nil and (player:GetAttribute("InTower") == nil and player:GetAttribute("InBattle") == nil)
end
player:GetAttributeChangedSignal("MatchKey"):Connect(refreshOpen)
player:GetAttributeChangedSignal("InTower"):Connect(refreshOpen)
player:GetAttributeChangedSignal("InBattle"):Connect(refreshOpen)
refreshOpen()

-- dark backdrop: dims the HUD behind the menu and takes its taps (tap outside the menu closes it)
local backdrop = Instance.new("TextButton")
backdrop.Name = "Backdrop"
backdrop.AutoButtonColor = false
backdrop.Text = ""
backdrop.Size = UDim2.fromScale(1, 1)
backdrop.BackgroundColor3 = TC.Shade
backdrop.BackgroundTransparency = 0.45
backdrop.Visible = false
backdrop.Parent = gui
gui.IgnoreGuiInset = true

-- the sheet: a white patterned card with a drop copy under it (PetStyle.shadowed), the title floating over its top edge
local panel, face = PetStyle.shadowed(gui, 16, 5, nil, {
	Name = "Panel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.9, 0, 0.8, 0), Visible = false,
})
panel.Active = true
local cap = Instance.new("UISizeConstraint")
cap.MaxSize = Vector2.new(PANEL_W, PANEL_H)
cap.Parent = panel
PetStyle.edge(face, K.PanelEdge, 3)
PetStyle.pattern(face, K.PanelPattern, 0.3, 46, PANEL_W, PANEL_H, 160)

PetStyle.title(face, "Spawn a pet (dev)", 26, { Position = UDim2.fromOffset(16, -12), Size = UDim2.new(1, -80, 0, 40), ZIndex = 6 })

local close = PetStyle.closeX(face, 40, function() end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, -10) })

-- rarity picker: the rarity the NEXT spawned pet gets (it is not a list filter: every pet is always listed)
local rarity = "Legendary"
local pickLabel = UI.text(face, "", { Name = "Pick", TextSize = 14, TextColor3 = TC.Muted, Position = UDim2.fromOffset(16, 34), Size = UDim2.new(1, -32, 0, 20), ZIndex = 3 })
local row = UI.frame(face, { Name = "Rarities", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 58), Size = UDim2.new(1, -24, 0, 36), ZIndex = 3 })
local rl = Instance.new("UIListLayout")
rl.FillDirection = Enum.FillDirection.Horizontal
rl.Padding = UDim.new(0, 6)
rl.Parent = row
local rarityButtons: { [string]: TextButton } = {}
-- recolours a pill (its gradient, edge and words): selected = the rarity's glossy colour, others = flat navy
local function paintPill(b: TextButton, top: Color3, bottom: Color3, edgeColor: Color3, textColor: Color3)
	local g = b:FindFirstChildOfClass("UIGradient")
	if g then
		g.Color = ColorSequence.new(top, bottom)
	end
	local s = b:FindFirstChildOfClass("UIStroke")
	if s then
		s.Color = edgeColor
	end
	local l = b:FindFirstChild("Label")
	if l and l:IsA("TextLabel") then
		l.TextColor3 = textColor
		local o = l:FindFirstChild("Outline")
		if o and o:IsA("UIStroke") then
			o.Color = edgeColor
		end
	end
end
local function paintRarity()
	for r, b in rarityButtons do
		local on = r == rarity
		local col = RARITY_COLOR[r] or K.White
		if on then
			paintPill(b, col:Lerp(K.White, 0.4), col, col:Lerp(K.Ink, 0.55), K.White)
		else
			paintPill(b, K.TabBar:Lerp(K.White, 0.1), K.TabBar, K.TabBarEdge, K.TabText)
		end
		local l = b:FindFirstChild("Label")
		if l and l:IsA("TextLabel") then
			l.Text = if on then "\u{2713} " .. r else r
		end
	end
	pickLabel.Text = "New pet rarity: " .. rarity .. "   (tap a pet to spawn it)"
end
for _, r in Config.Rarities do
	local col = RARITY_COLOR[r] or K.White
	local b = PetStyle.pill(row, r, col:Lerp(K.White, 0.4), col, col:Lerp(K.Ink, 0.55), { Name = "Rarity_" .. r, Size = UDim2.new(1 / #Config.Rarities, -6, 1, 0) }, 14)
	rarityButtons[r] = b
	b.Activated:Connect(function()
		rarity = r
		paintRarity()
	end)
end
paintRarity()

local status = UI.text(face, "Tap a rarity, then a pet.", { Name = "Status", TextSize = 15, TextColor3 = TC.Muted, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -8), Size = UDim2.new(1, -32, 0, 24), ZIndex = 3 })

-- search box: type part of a name to find a pet fast (a pale inset with the sheet's edge colour)
local search = Instance.new("TextBox")
search.Name = "Search"
search.Position = UDim2.fromOffset(12, 102)
search.Size = UDim2.new(1, -24, 0, 34)
search.BackgroundColor3 = K.PanelPattern
search.BorderSizePixel = 0
search.TextColor3 = K.Ink
search.PlaceholderText = "Search pets..."
search.PlaceholderColor3 = TC.Faint
search.Font = UI.Bold
search.TextSize = 16
search.Text = ""
search.ClearTextOnFocus = false
search.TextXAlignment = Enum.TextXAlignment.Left
search.ZIndex = 3
search.Parent = face
PetStyle.round(search, 10)
PetStyle.edge(search, TC.InsetEdge, 2)
local spad = Instance.new("UIPadding")
spad.PaddingLeft = UDim.new(0, 10)
spad.Parent = search

-- the list sits in its own pale inset with padding, so rows never butt against the pills or the footer
local inset = UI.frame(face, { Name = "ListInset", BackgroundColor3 = K.PanelPattern, Position = UDim2.fromOffset(12, 144), Size = UDim2.new(1, -24, 1, -184), ClipsDescendants = true, ZIndex = 3 })
PetStyle.round(inset, 12)
PetStyle.edge(inset, TC.InsetEdge, 2)
local list = Instance.new("ScrollingFrame")
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.Position = UDim2.fromOffset(0, 6)
list.Size = UDim2.new(1, 0, 1, -12)
list.ScrollBarThickness = 6
list.ScrollBarImageColor3 = K.TitleEdge
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.CanvasSize = UDim2.new()
list.ZIndex = 4
list.Parent = inset
local lpad = Instance.new("UIPadding")
lpad.PaddingLeft = UDim.new(0, 6)
lpad.PaddingRight = UDim.new(0, 12)
lpad.PaddingTop = UDim.new(0, 2)
lpad.PaddingBottom = UDim.new(0, 6)
lpad.Parent = list
local grid = Instance.new("UIGridLayout")
-- two wide columns: long names ("Astral Kitsune") get the same text size as short ones
grid.CellSize = UDim2.new(0.5, -4, 0, 46)
grid.CellPadding = UDim2.fromOffset(6, 6)
grid.SortOrder = Enum.SortOrder.Name
grid.Parent = list

local busy = false
-- only pets that have a real (Meshy) model in ReplicatedStorage.PetModels (attribute Mesh = true)
local petModels = ReplicatedStorage:WaitForChild("PetModels", 10)
local function hasModel(id: string): boolean
	local m = petModels and petModels:FindFirstChild("Pet_" .. id)
	return m ~= nil and m:GetAttribute("Mesh") == true
end
for id, sp in Config.Minerals :: any do
	if not hasModel(id) then
		continue
	end
	-- one row: a colour swatch of the pet (body colour, accent ring), its name, and its body type underneath
	local b = Instance.new("TextButton")
	b.Name = tostring(sp.Name or id)
	b.BackgroundColor3 = K.White
	b.BorderSizePixel = 0
	b.Text = ""
	b.AutoButtonColor = false
	b.ZIndex = 4
	b.Parent = list
	PetStyle.round(b, 10)
	PetStyle.edge(b, K.PanelEdge, 2)
	UI.squashScale(b)
	b.MouseButton1Down:Connect(function()
		UI.squash(b, true)
	end)
	b.MouseButton1Up:Connect(function()
		UI.squash(b, false)
	end)
	b.MouseLeave:Connect(function()
		UI.squash(b, false)
	end)
	local sw = PetStyle.dot(b, (sp.Crystal :: Color3?) or K.White, 30, { Name = "Swatch", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0) })
	local rim = sw:FindFirstChildOfClass("UIStroke")
	if rim then
		rim.Color = (sp.Rim :: Color3?) or K.Ink
		rim.Thickness = 3
	end
	local nm = UI.text(b, tostring(sp.Name or id), { Name = "Name", TextSize = 16, Font = UI.Bold, TextColor3 = K.Ink, Position = UDim2.fromOffset(44, 3), Size = UDim2.new(1, -48, 0, 22), ZIndex = 5 })
	nm.TextTruncate = Enum.TextTruncate.AtEnd
	nm.TextWrapped = false
	local kd = UI.text(b, tostring(sp.Kind or "?") .. " \u{00B7} " .. tostring(sp.BoostKind or "") .. (if sp.Chase then " \u{00B7} chase" else ""), {
		Name = "Kind", TextSize = 14, TextColor3 = TC.Muted, Position = UDim2.fromOffset(44, 25), Size = UDim2.new(1, -48, 0, 17), ZIndex = 5,
	})
	kd.TextTruncate = Enum.TextTruncate.AtEnd
	kd.TextWrapped = false
	local key = string.lower(tostring(sp.Name or id) .. " " .. tostring(id))
	search:GetPropertyChangedSignal("Text"):Connect(function()
		local q = string.lower(search.Text)
		b.Visible = q == "" or string.find(key, q, 1, true) ~= nil
	end)
	b.Activated:Connect(function()
		if busy then return end
		busy = true
		status.Text = "Spawning..."
		local ok, a, msg = pcall(function()
			return remote:InvokeServer(id, rarity)
		end)
		status.Text = if ok and a then "Got: " .. tostring(msg) else "Failed: " .. tostring(if ok then msg else a)
		busy = false
	end)
end

local function show(on: boolean)
	panel.Visible = on
	backdrop.Visible = on
end
open.Activated:Connect(function()
	show(not panel.Visible)
end)
close.Activated:Connect(function()
	show(false)
end)
backdrop.Activated:Connect(function()
	show(false)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="289">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
-- Small client-only screen and world effects, all pooled, all <= 1 s per piece, no camera shake:
--   cashFly      few little coins fly from a sale spot to the HUD cash row
--   revealBurst  tinted bloom + bounded sparks from the cavity (target reveal)
--   shimmer      soft sparkles around the geode in the reveal
--   confetti     gentle 2 s confetti for the winner (spawned over 2 s, each piece lives <= 1 s)
--   glint        machine-recovery sparkle at a world position (hook point for the machine code)
-- Reduced motion shows nothing moving; Low effects halves the counts.
-- Nothing here is replicated or authoritative; it only decorates what the server already decided.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)

local Effects = {}

local MAX_PIECES = 40
local LIFE_MAX = 1.0

local gui: ScreenGui? = nil
local probe: Frame? = nil
local cashTarget: GuiObject? = nil
local free: { Frame } = {}
local used = 0
local inUse: { [Frame]: boolean } = {}
local session = 0 -- bumped by clear(), stops running spawners

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function reduced(): boolean
	return settings().ReducedMotion == true
end

local function lowFx(): boolean
	return settings().LowEffects == true
end

local function layer(): (ScreenGui, Frame)
	if gui and probe and gui.Parent then
		return gui :: ScreenGui, probe :: Frame
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "CrackTheRocksFx"
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = false
	sg.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.DisplayOrder = 30
	sg.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local p = Instance.new("Frame")
	p.Name = "Probe"
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	p.Size = UDim2.fromScale(1, 1)
	p.Active = false
	p.Parent = sg
	gui, probe = sg, p
	free = {}
	used = 0
	inUse = {}
	return sg, p
end

-- Per-frame use counter and live tweens: a delayed release only frees the use it was scheduled for, and a recycled
-- frame never keeps animating its old use.
local uses: { [Frame]: number } = {}
local tweens: { [Frame]: { Tween } } = {}

local function track(f: Frame, tw: Tween)
	local list = tweens[f]
	if not list then
		list = {}
		tweens[f] = list
	end
	table.insert(list, tw)
	tw:Play()
end

-- A pooled rounded piece (coin, spark or confetti strip).
local function piece(parent: Instance): Frame?
	if used >= MAX_PIECES then
		return nil
	end
	used += 1
	local fr: Frame
	local pooled = table.remove(free)
	if pooled then
		fr = pooled
		-- the reveal bloom rounds its piece into a circle; pooled pieces start square-cornered again
		local uc = fr:FindFirstChildOfClass("UICorner")
		if uc then
			uc.CornerRadius = UDim.new(0, 8)
		end
	else
		fr = Instance.new("Frame")
		fr.BorderSizePixel = 0
		fr.Active = false
		fr.AnchorPoint = Vector2.new(0.5, 0.5)
		local c = Instance.new("UICorner")
		c.Parent = fr
	end
	fr.BackgroundTransparency = 0
	fr.Rotation = 0
	fr.Parent = parent
	inUse[fr] = true
	uses[fr] = (uses[fr] or 0) + 1
	return fr
end

local function release(f: Frame)
	if not inUse[f] then
		return -- already released (clear() ran before this piece's timer)
	end
	inUse[f] = nil
	used = math.max(0, used - 1)
	local list = tweens[f]
	if list then
		for _, tw in list do
			tw:Cancel()
		end
		tweens[f] = nil
	end
	-- a reveal star rides on the piece; it must not come back with the pooled frame
	local star = f:FindFirstChild("Star")
	if star then
		star:Destroy()
	end
	f.Parent = nil
	if #free < MAX_PIECES then
		table.insert(free, f)
	else
		f:Destroy()
	end
end

local function fly(f: Frame, goal: { [string]: any }, life: number, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	track(f, TweenService:Create(f, TweenInfo.new(math.min(life, LIFE_MAX), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal))
	local use = uses[f]
	task.delay(math.min(life, LIFE_MAX) + 0.03, function()
		if uses[f] == use then
			release(f)
		end
	end)
end

-- HUD wiring ------------------------------------------------------------------------------

-- Hud passes its cash row so coins know where to fly.
function Effects.setCashTarget(obj: GuiObject?)
	cashTarget = obj
end

local function localPoint(abs: Vector2): Vector2
	local _, p = layer()
	return abs - p.AbsolutePosition
end

-- Cash ------------------------------------------------------------------------------------

-- Small coins fly from the world position `from` (a sale hopper) to the cash row.
function Effects.cashFly(from: Vector3?, amount: number)
	if reduced() or not cashTarget or not (cashTarget :: GuiObject).Parent then
		return
	end
	local _, p = layer()
	local cam = Workspace.CurrentCamera
	local start: Vector2
	if from and cam then
		local v, onScreen = cam:WorldToScreenPoint(from + Vector3.new(0, 3, 0))
		if not onScreen then
			start = p.AbsoluteSize * Vector2.new(0.5, 0.6)
		else
			start = localPoint(Vector2.new(v.X, v.Y))
		end
	else
		start = p.AbsoluteSize * Vector2.new(0.5, 0.6)
	end
	local t = cashTarget :: GuiObject
	local goalPos = localPoint(t.AbsolutePosition + t.AbsoluteSize * 0.5)
	local n = math.clamp(math.floor(math.log(math.max(amount, 1), 10)) + 1, 2, 6)
	if lowFx() then
		n = math.max(2, n // 2)
	end
	local s = session
	for i = 1, n do
		task.delay((i - 1) * 0.06, function()
			if s ~= session then
				return
			end
			local f = piece(p)
			if not f then
				return
			end
			f.Size = UDim2.fromOffset(14, 14)
			f.BackgroundColor3 = Color3.fromRGB(255, 205, 60)
			local jitter = Vector2.new((math.random() - 0.5) * 36, (math.random() - 0.5) * 24)
			f.Position = UDim2.fromOffset(start.X + jitter.X, start.Y + jitter.Y)
			fly(f, { Position = UDim2.fromOffset(goalPos.X, goalPos.Y), BackgroundTransparency = 0.7, Size = UDim2.fromOffset(8, 8) }, 0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end)
	end
end

-- Reveal ----------------------------------------------------------------------------------

local SPARK = Color3.fromRGB(255, 252, 235)
local HATCH_STAR = "rbxassetid://94200996021844" -- owner's hatch sparkle (IMPORT_NOW5 HatchSparkle_tex)

-- Soft sparkles around a screen rectangle (the geode viewport) over about 0.6 s.
function Effects.shimmer(topLeft: Vector2, size: Vector2)
	if reduced() then
		return
	end
	local _, p = layer()
	local n = if lowFx() then 6 else 12
	local s = session
	local origin = localPoint(topLeft)
	for _ = 1, n do
		task.delay(math.random() * 0.5, function()
			if s ~= session then
				return
			end
			local f = piece(p)
			if not f then
				return
			end
			local d = 6 + math.random() * 6
			f.Size = UDim2.fromOffset(d, d)
			f.BackgroundColor3 = SPARK
			f.Rotation = 45
			f.Position = UDim2.fromOffset(origin.X + size.X * (0.2 + 0.6 * math.random()), origin.Y + size.Y * (0.15 + 0.7 * math.random()))
			f.BackgroundTransparency = 1
			track(f, TweenService:Create(f, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, true), { BackgroundTransparency = 0.1, Size = UDim2.fromOffset(d * 1.5, d * 1.5) }))
			local use = uses[f]
			task.delay(0.55, function()
				if uses[f] == use then
					release(f)
				end
			end)
		end)
	end
end

-- Colour burst for the target reveal: a soft tinted bloom plus a bounded ring of sparks flying out
-- of the cavity, all in the specimen's real crystal colour. `intensity` 0..1 (from the rarity
-- config, see RevealView) scales the count and strength. Never a white flash: the bloom peaks at
-- about 0.75 transparency. Reduced motion shows nothing; Low effects halves the sparks.
function Effects.revealBurst(topLeft: Vector2, size: Vector2, tint: Color3, intensity: number)
	if reduced() then
		return
	end
	local ok = pcall(function()
		local _, p = layer()
		local k = math.clamp(intensity, 0, 1)
		local centre = localPoint(topLeft) + size * Vector2.new(0.5, 0.5)
		local reach = math.min(size.X, size.Y) * (0.28 + 0.14 * k)
		local bloom = piece(p)
		if bloom then
			local uc = bloom:FindFirstChildOfClass("UICorner")
			if uc then
				uc.CornerRadius = UDim.new(0.5, 0)
			end
			bloom.BackgroundColor3 = tint
			bloom.Position = UDim2.fromOffset(centre.X, centre.Y)
			bloom.Size = UDim2.fromOffset(reach * 0.5, reach * 0.5)
			bloom.BackgroundTransparency = 0.86 - 0.11 * k
			fly(bloom, { Size = UDim2.fromOffset(reach * 2.4, reach * 2.4), BackgroundTransparency = 1 }, 0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
		local n = math.floor(6 + 12 * k)
		if lowFx() then
			n = math.max(3, n // 2)
		end
		for i = 1, n do
			local f = piece(p)
			if not f then
				break
			end
			local a = (i / n) * math.pi * 2 + math.random() * 0.4
			local d = 5 + 4 * k + math.random() * 4
			local r = reach * (0.7 + 0.6 * math.random())
			f.Size = UDim2.fromOffset(d * 1.8, d * 1.8)
			f.Rotation = math.random(-20, 20)
			f.BackgroundColor3 = tint:Lerp(SPARK, 0.35)
			f.Position = UDim2.fromOffset(centre.X, centre.Y)
			-- the owner's chunky 4-point star (IMPORT_NOW5 HatchSparkle_tex) instead of a plain diamond; it rides on the
			-- pooled piece and leaves with it
			f.BackgroundTransparency = 1
			local star = Instance.new("ImageLabel")
			star.Name = "Star"
			star.BackgroundTransparency = 1
			star.Size = UDim2.fromScale(1, 1)
			star.Image = HATCH_STAR
			star.ImageColor3 = Color3.new(1, 1, 1):Lerp(tint, 0.25)
			star.Parent = f
			local life = 0.55 + 0.25 * math.random()
			track(f, TweenService:Create(star, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { ImageTransparency = 1 }))
			fly(f, {
				Position = UDim2.fromOffset(centre.X + math.cos(a) * r, centre.Y + math.sin(a) * r * 0.8),
				Size = UDim2.fromOffset(d * 0.3, d * 0.3),
				BackgroundTransparency = 1,
			}, life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end
	end)
	return ok
end

local CONFETTI = {
	Color3.fromRGB(255, 205, 60), Color3.fromRGB(120, 210, 255), Color3.fromRGB(160, 255, 150),
	Color3.fromRGB(255, 150, 190), Color3.fromRGB(210, 170, 255),
}

-- Gentle confetti for about 2 s: a few strips drift down from the upper screen. Each piece
-- lives <= 1 s and fades out, so nothing blocks the view or strobes.
function Effects.confetti()
	if reduced() then
		return
	end
	local _, p = layer()
	local total = if lowFx() then 12 else 26
	local s = session
	for i = 1, total do
		task.delay((i - 1) * (2 / total), function()
			if s ~= session then
				return
			end
			local f = piece(p)
			if not f then
				return
			end
			local w = p.AbsoluteSize.X
			f.Size = UDim2.fromOffset(6, 10)
			f.BackgroundColor3 = CONFETTI[math.random(1, #CONFETTI)]
			f.Rotation = math.random(0, 180)
			f.BackgroundTransparency = 0.15
			local x = w * (0.1 + 0.8 * math.random())
			local y = p.AbsoluteSize.Y * (0.08 + 0.12 * math.random())
			f.Position = UDim2.fromOffset(x, y)
			fly(f, {
				Position = UDim2.fromOffset(x + (math.random() - 0.5) * 70, y + 90 + math.random() * 50),
				Rotation = f.Rotation + (math.random() - 0.5) * 240,
				BackgroundTransparency = 1,
			}, 0.95, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		end)
	end
end

-- World -----------------------------------------------------------------------------------

local glintPool: { Attachment } = {}
local glintNext = 1
local GLINT_SLOTS = 4

-- Machine recovery glint at a world position (hook point: call from the machine's recovery code).
function Effects.glint(pos: Vector3)
	if reduced() then
		return
	end
	if #glintPool < GLINT_SLOTS then
		local a = Instance.new("Attachment")
		a.Name = "CTR_Glint"
		a.Parent = Workspace.Terrain
		local e = Instance.new("ParticleEmitter")
		e.Rate = 0
		e.Lifetime = NumberRange.new(0.5, 0.9)
		e.Speed = NumberRange.new(2, 5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		e.Color = ColorSequence.new(Color3.fromRGB(255, 244, 190))
		e.LightEmission = 0.6
		e.Parent = a
		table.insert(glintPool, a)
	end
	local a = glintPool[glintNext]
	glintNext = glintNext % GLINT_SLOTS + 1
	if not a or not a.Parent then
		return
	end
	local e = a:FindFirstChildOfClass("ParticleEmitter")
	if e then
		a.WorldPosition = pos
		e:Emit(if lowFx() then 3 else 7)
	end
end

-- Stops pending spawns and removes what is on screen (reveal closed, match left).
function Effects.clear()
	session += 1
	if probe then
		for _, c in (probe :: Frame):GetChildren() do
			if c:IsA("Frame") then
				release(c)
			end
		end
	end
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="290">
          <Properties>
            <string name="Name">EggFx</string>
            <string name="Source"><![CDATA[--!strict
-- Client side of the egg events (src/server/EggEvents.luau, tuning in src/shared/EggConfig.luau). Cosmetic only:
--   ("Wobble", { Round, Ids })                  a small patch of pile eggs rocks on their bases for a moment
--   ("Overtime", { Round, Id })                 time is up: the pet egg glows gold (Highlight) so the race ends
--   ("Chirp", { Round, Pos })                  a nearby pile egg chirps (sometimes the pet egg): a 3D sound (EggConfig.Chirp.SoundId,
--                                               silent while it is 0) and a small floating note at Pos
--   ("Boots", { Round, UserId, Until, Seconds }) sparkles on that player's avatar; for the local player also a
--                                               small boot badge with a countdown (own ScreenGui, lower left)
-- The server decides every pick and the speed itself; nothing here changes gameplay.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local EggConfig = require(Shared.EggConfig)
local State = require(script.Parent.State)
local PileView = require(script.Parent.PileView)
local UI = require(script.Parent.ui.UI)
local Audio = require(script.Parent.Audio)
local HitFx = require(script.Parent.HitFx)

local EggFx = {}

local player = Players.LocalPlayer
local wobbling: { [Model]: boolean } = {}

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

-- Rocks the egg on its base: a few damped side-to-side tilts, then back to exactly where it was. Stops at once
-- if anything else moves the model meanwhile (a pile settle), so the pile view always wins.
local function wobble(model: Model)
	if wobbling[model] then
		return
	end
	wobbling[model] = true
	local cfg = EggConfig.Wobble
	local base = model:GetPivot()
	local half = model:GetExtentsSize().Y * 0.5
	local deg = cfg.Degrees * (if settings().ReducedMotion == true then 0.5 else 1)
	local last = base
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	local function stop(restore: boolean)
		if conn then
			conn:Disconnect()
			conn = nil
		end
		if restore and model.Parent then
			model:PivotTo(base)
		end
		wobbling[model] = nil
	end
	conn = RunService.Heartbeat:Connect(function()
		if not model.Parent then
			stop(false)
			return
		end
		if (model:GetPivot().Position - last.Position).Magnitude > 0.01 then
			stop(false) -- moved by the pile view: leave it where it was put
			return
		end
		local k = (os.clock() - t0) / cfg.Seconds
		if k >= 1 then
			stop(true)
			return
		end
		local a = math.rad(deg) * math.sin(k * cfg.Shakes * 2 * math.pi) * (1 - k)
		local cf = base * CFrame.new(0, -half, 0) * CFrame.Angles(a * 0.4, 0, a) * CFrame.new(0, half, 0)
		last = cf
		model:PivotTo(cf)
	end)
end

-- Boots: sparkles on an avatar ---------------------------------------------------------------

local function sparkle(uid: number, seconds: number)
	if settings().LowEffects == true and uid ~= player.UserId then
		return
	end
	local p = Players:GetPlayerByUserId(uid)
	local root = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local old = root:FindFirstChild("EggBootsSparkles")
	if old then
		old:Destroy()
	end
	local s = Instance.new("Sparkles")
	s.Name = "EggBootsSparkles"
	s.SparkleColor = UI.Colors.Gold
	s.Parent = root
	task.delay(seconds, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

-- Boots: a dust trail at the feet while that avatar runs on the ground (one loop per player, ends itself).
local trailUntil: { [number]: number } = {}

local function dustTrail(uid: number, seconds: number)
	if settings().LowEffects == true and uid ~= player.UserId then
		return
	end
	local had = trailUntil[uid] ~= nil
	trailUntil[uid] = os.clock() + seconds
	if had then
		return
	end
	local conn: RBXScriptConnection? = nil
	local nextPuff = 0
	conn = RunService.Heartbeat:Connect(function()
		local p = Players:GetPlayerByUserId(uid)
		local char = p and p.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if os.clock() > (trailUntil[uid] or 0) or not root or not hum or State.Match == nil then
			trailUntil[uid] = nil
			if conn then
				conn:Disconnect()
			end
			return
		end
		local v = root.AssemblyLinearVelocity
		local now = os.clock()
		if now >= nextPuff and hum.FloorMaterial ~= Enum.Material.Air and Vector3.new(v.X, 0, v.Z).Magnitude > 6 then
			nextPuff = now + 0.12
			local foot = root.Position - Vector3.new(0, root.Size.Y * 0.5 + hum.HipHeight - 0.2, 0)
			HitFx.trail(foot - Vector3.new(v.X, 0, v.Z).Unit * 0.6)
		end
	end)
end

-- Boots: the local badge ---------------------------------------------------------------------

local gui: ScreenGui? = nil
local timerLabel: TextLabel? = nil
local bootsUntil = 0
local ticking = false

local function badge(): (ScreenGui, TextLabel)
	if gui and timerLabel and gui.Parent then
		return gui :: ScreenGui, timerLabel :: TextLabel
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "EggFxBoots"
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = false
	sg.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.DisplayOrder = 12
	sg.Enabled = false
	sg.Parent = player:WaitForChild("PlayerGui")
	-- lower left, above the bottom edge: below the HUD's left tiles and left of the tool dock in every layout
	local box = UI.frame(sg, {
		Name = "Badge",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, UI.T.Edge, 1, -80),
		Size = UDim2.fromOffset(112, 36),
		BackgroundColor3 = UI.Colors.Hud,
		BackgroundTransparency = 0.15,
	})
	UI.corner(box, UI.T.Radius)
	UI.stroke(box, UI.Colors.Gold, 2)
	-- REPLACE: real boot icon image; a drawn stand-in (shaft + foot) until then
	local icon = UI.frame(box, { Name = "Boot", Position = UDim2.fromOffset(8, 4), Size = UDim2.fromOffset(28, 28), BackgroundTransparency = 1 })
	local shaft = UI.frame(icon, { Position = UDim2.fromOffset(6, 0), Size = UDim2.fromOffset(11, 20), BackgroundColor3 = UI.Colors.Gold })
	UI.corner(shaft, 3)
	local foot = UI.frame(icon, { Position = UDim2.fromOffset(6, 16), Size = UDim2.fromOffset(20, 10), BackgroundColor3 = UI.Colors.Gold })
	UI.corner(foot, 4)
	local label = UI.text(box, "FAST 8s", {
		Name = "Timer",
		Font = UI.Head,
		TextSize = UI.T.Small,
		Position = UDim2.fromOffset(38, 0),
		Size = UDim2.new(1, -44, 1, 0),
	})
	gui, timerLabel = sg, label
	return sg, label
end

local function showBadge(untilT: number)
	bootsUntil = untilT
	local sg, label = badge()
	sg.Enabled = true
	if ticking then
		return
	end
	ticking = true
	task.spawn(function()
		while true do
			local left = bootsUntil - Workspace:GetServerTimeNow()
			if left <= 0 or State.Match == nil then
				break
			end
			label.Text = string.format("FAST %ds", math.ceil(left))
			task.wait(0.2)
		end
		sg.Enabled = false
		ticking = false
	end)
end

-- Chirp: a sound and a small note at a point near (never on) the pet egg ---------------------------

local function chirp(pos: Vector3)
	local cfg = EggConfig.Chirp
	local anchor = Instance.new("Part")
	anchor.Name = "EggChirp"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0))
	anchor.Parent = Workspace
	if cfg.SoundId ~= 0 then
		local snd = Instance.new("Sound")
		snd.SoundId = "rbxassetid://" .. tostring(cfg.SoundId)
		snd.Volume = cfg.Volume
		snd.RollOffMaxDistance = cfg.RollOff
		snd.RollOffMode = Enum.RollOffMode.InverseTapered
		snd.Parent = anchor
		snd:Play()
	else
		-- the shared sound list (PetSoundIds.EggChirp via Audio): silent while that id is 0 too
		Audio.play("EggChirp", { Pos = pos + Vector3.new(0, 1.5, 0) })
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(34, 34)
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.MaxDistance = cfg.RollOff * 2
	bb.Parent = anchor
	local note = UI.text(bb, "\u{266A}", { Font = UI.Head, TextSize = 28, TextColor3 = UI.Colors.Gold, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	note.TextWrapped = false
	local reduced = settings().ReducedMotion == true
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.Heartbeat:Connect(function()
		local k = (os.clock() - t0) / 1.2
		if k >= 1 or not anchor.Parent then
			if conn then
				conn:Disconnect()
			end
			anchor:Destroy()
			return
		end
		bb.StudsOffset = Vector3.new(if reduced then 0 else math.sin(k * 8) * 0.3, k * 2, 0)
		note.TextTransparency = k * k
	end)
end

-- The overtime glow on one pile egg (Highlight + breathing pulse). Returns true when it was added now.
local function glow(id: number): boolean
	local model = PileView.eggModel(id)
	if not model or model:FindFirstChild("OvertimeGlow") then
		return false
	end
	local h = Instance.new("Highlight")
	h.Name = "OvertimeGlow"
	h.FillColor = EggConfig.Overtime.GlowColor
	-- white rim: the low-poly nest bed is gold too, so a gold-on-gold glow got lost (QA 2026-10-13)
	h.OutlineColor = Color3.new(1, 1, 1)
	h.OutlineTransparency = 0
	h.FillTransparency = 0.15
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = model
	if not UI.Reduced then
		-- slow breathing pulse (client visual only), ends with the glow
		task.spawn(function()
			local t0 = os.clock()
			while h.Parent do
				h.FillTransparency = 0.3 + 0.2 * math.sin((os.clock() - t0) * math.pi) -- ~2 s per breath
				task.wait()
			end
		end)
	end
	return true
end

-- The glowing egg of this round. The pile swaps an egg's model when it becomes exposed (filler -> full egg) or moves,
-- which dropped the Highlight (Studio 2026-10-15: the clock reached 0:00 and no gold egg could be found), so the
-- glow is put back on whatever model the egg has now, until the egg leaves the pile or the round changes.
local glowRound: any, glowId: number? = nil, nil
task.spawn(function()
	while true do
		task.wait(0.25)
		if glowId ~= nil then
			if glowRound ~= PileView.roundId() then
				glowRound, glowId = nil, nil
				PileView.setPriority(nil)
			else
				glow(glowId)
			end
		end
	end
end)

function EggFx.start()
	Net.event("EggEvent").OnClientEvent:Connect(function(kind: any, data: any)
		if type(data) ~= "table" then
			return
		end
		if kind == "Wobble" then
			if type(data.Ids) ~= "table" or data.Round ~= PileView.roundId() then
				return
			end
			for i, id in data.Ids do
				if i > EggConfig.Wobble.PatchMax then
					break
				end
				local model = if type(id) == "number" then PileView.eggModel(id) else nil
				if model then
					wobble(model)
				end
			end
		elseif kind == "Overtime" then
			if type(data.Id) ~= "number" or data.Round ~= PileView.roundId() then
				return
			end
			glowRound, glowId = data.Round, data.Id
			PileView.setPriority(data.Id) -- the pickup action takes it first once it is in reach
			if glow(data.Id) then
				local model = PileView.eggModel(data.Id)
				if model then
					wobble(model)
				end
			end
		elseif kind == "Chirp" then
			if typeof(data.Pos) ~= "Vector3" or data.Round ~= PileView.roundId() then
				return
			end
			chirp(data.Pos)
		elseif kind == "Boots" then
			if type(data.UserId) ~= "number" or type(data.Until) ~= "number" then
				return
			end
			local seconds = math.max(0, data.Until - Workspace:GetServerTimeNow())
			sparkle(data.UserId, seconds)
			dustTrail(data.UserId, seconds)
			if data.UserId == player.UserId then
				showBadge(data.Until)
				Audio.play("SpeedBoots") -- PetSoundIds.SpeedBoots (0 = silent)
			end
		end
	end)
end

return EggFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="291">
          <Properties>
            <string name="Name">FightCam</string>
            <string name="Source"><![CDATA[--!strict
-- Pet Battle camera director (carter 2026-10-14: "when they are fighting the camera should pan and do cool
-- animations"). Client only, cosmetic; the fight itself is the server's. While the local player fights:
--   * intro   a wide high orbit round the whole arena that sweeps in behind the player's team (the count-in)
--   * base    a high three-quarter view behind the player's team that slowly pans side to side and breathes in/out
--   * cut     crits and type SUPER hits cut to a side-on close-up of the pet that was hit, then ease back
--   * charge  the player's SPECIAL: over the shoulder of the caster, looking at the rival team
--   * ko      a slow orbit round the pet that fainted (FightFx runs the slow motion), then a low hero shot of the winner
--   * hero    a low push-in on one pet that holds (the winner, or the rival that beat you) until the fight closes
-- Every shot is a target camera the real camera eases towards each frame, so cuts never snap. Reduce Motion keeps one
-- still high view (no orbit, no cuts). FightCam.stop() hands the camera back to the player.
-- FightCamRules (shared) holds the shot maths, tested offline.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules = require(Shared.FightCamRules)
local UI = require(script.Parent.ui.UI)
local CameraMode = require(script.Parent.CameraMode)
local PopupGate = require(script.Parent.PopupGate)

local FightCam = {}

type Shot = { Kind: string, Started: number, Until: number, Fn: (t: number) -> CFrame, Ease: number, Focus: (() -> Vector3)?, Of: string? }

local active = false
local stage: Rules.Stage? = nil
local shot: Shot? = nil
local startedAt = 0
local lastCut = -math.huge
local conn: RBXScriptConnection? = nil
local baseFov: number? = nil -- the player's lens before the fight, given back by stop()
local heroLens = false -- the lens is narrowed (or easing back) for the hero shot
local baseFrom = 0 -- when the base orbit's clock starts (after the intro, so the intro lands on base(0))
local nudgeAt: (() -> Vector3?)? = nil -- the pet the last hit landed on (the base view leans in on it)
local nudgeStart = -math.huge
local backUntil = 0 -- the wide shot comes back quickly until this time after a close-up
local NUDGE_IN, NUDGE_OUT = 0.15, 0.75
local hidden: { [Instance]: boolean } = {} -- the player's own avatar parts made see-through for the fight
local BIND = "CT_FightCam"
local CINEMATIC = "FightCam" -- CameraMode.cinematic key held for the whole fight
local dimmed: { [Instance]: { [string]: number } } = {} -- lobby bloom / exposure turned down for the fight
local BIND_HIDE = "CT_FightHideSelf"

-- The island top washes out under the lobby's bloom (Studio check 2026-10-14): while the player fights, the world's
-- own bloom and exposure are turned down (FightFx's own CT_ effects are left alone), and given back at the end.
local Lighting = game:GetService("Lighting")
local FIGHT_BLOOM, FIGHT_EXPOSURE = 0.35, -0.35
local function dimLights(on: boolean)
	if on then
		if next(dimmed) ~= nil then
			return
		end
		dimmed[Lighting] = { ExposureCompensation = Lighting.ExposureCompensation }
		Lighting.ExposureCompensation += FIGHT_EXPOSURE
		for _, e in Lighting:GetChildren() do
			if e:IsA("BloomEffect") and string.sub(e.Name, 1, 3) ~= "CT_" then
				dimmed[e] = { Intensity = e.Intensity }
				e.Intensity *= FIGHT_BLOOM
			end
		end
	else
		for inst, props in dimmed do
			if inst.Parent or inst == Lighting then
				for k, v in props do
					(inst :: any)[k] = v
				end
			end
		end
		table.clear(dimmed)
	end
end

local function reduced(): boolean
	return UI.Reduced == true
end

local function centreOf(m: Model?): Vector3?
	if not m or not m.Parent then
		return nil
	end
	local ok, cf, size = pcall(m.GetBoundingBox, m)
	if not ok then
		return nil
	end
	return (cf :: CFrame).Position + Vector3.new(0, -(size :: Vector3).Y * 0.1, 0)
end

local function sizeOf(m: Model): number
	local ok, _, size = pcall(m.GetBoundingBox, m)
	return if ok then math.max((size :: Vector3).Magnitude, 2) else 3
end

local function base(t: number): CFrame
	local s = stage :: Rules.Stage
	return Rules.base(s, t)
end

-- Keeps the view clear of anything solid between the fight and the camera (island trees, rocks, statues, walls),
-- decor without collision included. The fight's own pets, avatars and see-through parts never block. A blocked shot is
-- first lifted (same distance, so the framing holds), and only pulled in if lifting does not clear it; either way it is
-- re-aimed at what it was looking at (Studio 2026-10-15: a pulled-in shot kept its old angle, so the player's pet sat
-- cropped in a corner and the rival drifted off screen).
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local LIFTS = { 0, 4, 8, 12 }
local blockedBy = "" -- what last blocked the shot (the Studio check log)

-- First solid hit between `from` and `to` (nil = clear); see-through parts are added to `skip` and looked past.
local function blocker(from: Vector3, to: Vector3, skip: { Instance }): RaycastResult?
	for _ = 1, 6 do
		rayParams.FilterDescendantsInstances = skip
		local hit = Workspace:Raycast(from, to - from, rayParams)
		if not hit or hit.Instance.Transparency <= 0.5 then
			return hit
		end
		table.insert(skip, hit.Instance)
	end
	return nil
end

local function unblocked(want: CFrame, focus: Vector3?): CFrame
	local s = stage
	if not s then
		return want
	end
	local look = focus or s.Centre -- close shots check from the pet they frame
	local skip: { Instance } = {}
	local drawn = Workspace:FindFirstChild("TowerView") -- the fight's own pets and effects (TowerView)
	if drawn then
		table.insert(skip, drawn)
	end
	for _, p in game:GetService("Players"):GetPlayers() do
		if p.Character then
			table.insert(skip, p.Character)
		end
	end
	-- the point the shot frames: on its view line, level with `look`
	local fwd = want.LookVector
	local aim = want.Position + fwd * math.max((look - want.Position):Dot(fwd), 4)
	local out = want
	blockedBy = ""
	pcall(function()
		for i, lift in LIFTS do
			local pos = want.Position + Vector3.yAxis * lift
			local hit = blocker(look, pos, skip)
			if hit and i == 1 then
				blockedBy = hit.Instance:GetFullName()
			end
			if not hit then
				out = if i == 1 then want else CFrame.lookAt(pos, aim)
				return
			end
			if i == #LIFTS then
				local dir = want.Position - look
				local keep = math.max((hit.Position - look).Magnitude - 1.5, 4)
				out = CFrame.lookAt(look + dir.Unit * math.min(keep, dir.Magnitude), aim)
			end
		end
	end)
	return out
end

-- The player's own avatar stands on its mark behind its pets, between the camera and the fight: it is hidden for the
-- player (LocalTransparencyModifier, re-applied every frame because the default camera scripts reset it), others
-- still see it. Studio test 2026-10-14: the avatar filled the foreground.
local function hideSelf(on: boolean)
	local char = game:GetService("Players").LocalPlayer.Character
	if on and char then
		for _, d in char:GetDescendants() do
			if d:IsA("BasePart") or d:IsA("Decal") then -- Decal covers Texture and the face; accessory handles are BaseParts
				d.LocalTransparencyModifier = 1
				hidden[d] = true
			end
		end
	end
	if not on then
		for d in hidden do
			if d.Parent then
				(d :: any).LocalTransparencyModifier = 0
			end
		end
		table.clear(hidden)
	end
end

local function nudgeK(now: number): number
	local u = now - nudgeStart
	if u < 0 or u > NUDGE_OUT then
		return 0
	elseif u < NUDGE_IN then
		return u / NUDGE_IN
	end
	return 1 - (u - NUDGE_IN) / (NUDGE_OUT - NUDGE_IN)
end

-- Studio check log: with Workspace attribute FightCamLog = true, every 0.2 s of a fight prints one line
-- "FCLOG {json}" with the shot, the real camera (position, look, lens, screen size), whether anything else moved the
-- camera since FightCam last set it, and every drawn pet (Workspace.TowerView, client side: centre, size, screen point).
-- The first line of a fight ("Shot":"start") carries what the base view was fitted to.
local HttpService = game:GetService("HttpService")
local logAt = 0
local lastSet: CFrame? = nil
local moved = 0 -- frames since the last log line where the camera was not where FightCam left it
local function r2(n: number): number
	return math.floor(n * 100 + 0.5) / 100
end
local function v3(v: Vector3): { number }
	return { r2(v.X), r2(v.Y), r2(v.Z) }
end
local function logLine(cam: Camera, kind: string, extra: { [string]: any }?)
	local pets = {}
	local drawn = Workspace:FindFirstChild("TowerView")
	if drawn then
		for _, m in drawn:GetChildren() do
			if m:IsA("Model") then
				local ok, cf, size = pcall(m.GetBoundingBox, m)
				if ok then
					local c, sz = (cf :: CFrame).Position, size :: Vector3
					local sp, on = cam:WorldToViewportPoint(c)
					local top = cam:WorldToViewportPoint(c + Vector3.new(0, sz.Y / 2, 0))
					local foot = cam:WorldToViewportPoint(c - Vector3.new(0, sz.Y / 2, 0))
					table.insert(pets, { N = m.Name, C = v3(c), S = v3(sz), X = r2(sp.X), Y = r2(sp.Y), Top = r2(top.Y), Foot = r2(foot.Y), On = on })
				end
			end
		end
	end
	local s = stage
	local line = {
		T = r2(os.clock() - startedAt), Shot = kind, Type = cam.CameraType.Name, Cam = v3(cam.CFrame.Position),
		Look = v3(cam.CFrame.LookVector), Up = v3(cam.CFrame.UpVector), Fov = r2(cam.FieldOfView), Vp = { cam.ViewportSize.X, cam.ViewportSize.Y },
		Moved = moved, Blocked = blockedBy, R = s and r2(s.R), H = s and r2(s.H), Pets = pets,
	}
	for k, v in (extra or {}) :: { [string]: any } do
		line[k] = v
	end
	moved = 0
	pcall(function()
		print("FCLOG " .. HttpService:JSONEncode(line))
	end)
end

local function step(dt: number)
	local cam = Workspace.CurrentCamera
	if not active or not stage or not cam then
		return
	end
	local now = os.clock()
	if lastSet and (cam.CFrame.Position - lastSet.Position).Magnitude > 0.01 then
		moved += 1 -- something other than FightCam moved the camera since the last frame
	end
	local want: CFrame
	local ease = 4
	local sh = shot
	if sh and now < sh.Until then
		want = sh.Fn(now - sh.Started)
		ease = sh.Ease
	else
		if sh then
			backUntil = now + 0.5 -- a close-up just ended: swing back to the wide shot quickly (both teams in shot)
		end
		shot = nil
		if now < backUntil then
			ease = 12
		end
		if reduced() then
			want = Rules.still(stage)
		else
			want = base(math.max(now - baseFrom, 0))
			local k = nudgeK(now)
			local at = if k > 0 and nudgeAt then nudgeAt() else nil
			if at then
				want = Rules.nudge(want, stage, at, k)
				ease = 7
			end
		end
	end
	want = unblocked(want, if sh and sh.Focus and now < sh.Until then sh.Focus() else nil)
	if cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CameraType = Enum.CameraType.Scriptable
	end
	cam.CFrame = cam.CFrame:Lerp(want, Rules.alpha(ease, dt))
	lastSet = cam.CFrame
	if Workspace:GetAttribute("FightCamLog") == true and now - logAt >= 0.2 then
		logAt = now
		local live = sh ~= nil and now < sh.Until
		logLine(cam, if live and sh then sh.Kind else "base", if live and sh and sh.Of then { Of = sh.Of } else nil)
	end
	hideSelf(true)
	-- the fight runs on a narrower lens (pets read big) and the hero shot narrows it more; FightFx's short lens
	-- kicks on hits still show (the lens eases back slowly)
	local lens = if sh and sh.Kind == "hero" and now < sh.Until then Rules.HERO_FOV else Rules.FIGHT_FOV
	heroLens = true
	cam.FieldOfView += (lens - cam.FieldOfView) * Rules.alpha(3, dt)
end

-- What the base view has to fit (FightCamRules.View): this screen's shape, how tall the drawn pets are (TowerView
-- draws them, client side, under Workspace.TowerView) and how many stand in each line.
local function viewOf(cam: Camera, units: { any }?): Rules.View
	local size = cam.ViewportSize
	local tall = 0
	local drawn = Workspace:FindFirstChild("TowerView")
	if drawn then
		for _, m in drawn:GetChildren() do
			if m:IsA("Model") then
				local ok, _, s = pcall(m.GetBoundingBox, m)
				if ok then
					tall = math.max(tall, (s :: Vector3).Y)
				end
			end
		end
	end
	local pets, foes = 0, 0
	for _, u in (units or {}) :: { any } do
		if u.Owner == 0 then
			foes += 1
		else
			pets += 1
		end
	end
	return {
		Aspect = if size.Y > 0 then size.X / size.Y else nil,
		Height = if tall > 0 then tall else nil,
		Pets = if pets > 0 then pets else nil,
		Foes = if foes > 0 then foes else nil,
	}
end

-- Starts directing for a fight seen from `origin` (the player's own view origin) with PvpConfig layout `layout`.
-- `intro` = the count-in is still running: open with the wide orbit. `units`: the fight's units (Start message), so
-- the base view fits every pet on this screen.
function FightCam.start(origin: CFrame, layout: any, intro: boolean?, introTime: number?, units: { any }?)
	FightCam.stop()
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local view = viewOf(cam, units)
	stage = Rules.stage(origin, layout, view)
	lastSet = nil
	moved = 0
	baseFov = cam.FieldOfView
	-- FightCam owns the camera for the whole fight. Without this CameraMode takes a Scriptable camera back to Custom
	-- the moment it changes (its guard against a stuck camera), so the default camera, centred on the player's
	-- avatar behind its own pets, and FightCam fought over it every frame (Studio camera log 2026-10-15: both teams
	-- fully in shot in 3% of frames).
	CameraMode.cinematic(CINEMATIC, true)
	UI.holdNotices(true) -- toasts wait until the fight ends
	PopupGate.hold("Fight", true) -- and every other non-fight popup (the one gate)
	dimLights(true)
	active = true
	startedAt = os.clock()
	baseFrom = startedAt
	lastCut = -math.huge
	backUntil = 0
	nudgeAt = nil
	cam.CameraType = Enum.CameraType.Scriptable
	if Workspace:GetAttribute("FightCamLog") == true then
		local s = stage :: Rules.Stage
		logLine(cam, "start", {
			Origin = v3(origin.Position), OriginLook = v3(origin.LookVector), Layout = layout, View = view,
			Centre = v3(s.Centre), Back = v3(s.Back), Focus = v3(Rules.focus(s)),
		})
	end
	if intro and not reduced() then
		local s = stage :: Rules.Stage
		local len = math.max(introTime or 3, 1.5)
		baseFrom = startedAt + len
		local from = Rules.introAt(s, 0)
		cam.CFrame = from
		shot = { Kind = "intro", Started = os.clock(), Until = os.clock() + len, Ease = 10, Fn = function(t: number): CFrame
			return Rules.intro(s, math.clamp(t / len, 0, 1), base(t))
		end }
	else
		cam.CFrame = if reduced() then Rules.still(stage :: Rules.Stage) else base(0)
	end
	RunService:BindToRenderStep(BIND, Enum.RenderPriority.Camera.Value + 2, step)
	-- the avatar stays hidden after every other render step (the default camera's transparency pass included) and
	-- after physics, so nothing that runs later in the frame can show it again
	RunService:BindToRenderStep(BIND_HIDE, Enum.RenderPriority.Last.Value, function()
		hideSelf(true)
	end)
	conn = RunService.Heartbeat:Connect(function()
		if active then
			hideSelf(true)
		end
	end)
end

-- A short cut to a pet (crit / SUPER hit): a side-on close-up, then back to the base view.
function FightCam.cut(kind: string, target: Model?, attacker: Model?)
	if not active or reduced() or not stage then
		return
	end
	local now = os.clock()
	local cur = shot
	if cur and (cur.Kind == "ko" or cur.Kind == "hero" or cur.Kind == "intro") and now < cur.Until then
		return -- the big shots are never cut away from
	end
	local gap = if kind == "special" or kind == "charge" then 0.8 else Rules.CUT_GAP
	if now - lastCut < gap then
		return
	end
	local at = centreOf(target)
	if not at then
		return
	end
	lastCut = now
	local from = centreOf(attacker)
	local s = stage :: Rules.Stage
	local size = sizeOf(target :: Model)
	local len = if kind == "special" then 1.4 elseif kind == "charge" then 1.1 else 0.9
	shot = { Kind = kind, Of = (target :: Model).Name, Started = now, Until = now + len, Ease = 9, Fn = function(t: number): CFrame
		local a = centreOf(target) or at
		if kind == "charge" then
			return Rules.shoulder(s, a, from or a)
		end
		return Rules.closeUp(s, a, from, size, t)
	end, Focus = function(): Vector3
		return centreOf(target) or at
	end }
end

-- K.O.: orbit the pet that fainted, then the winner's hero shot (holds `hold` seconds, or until stop()).
function FightCam.ko(fainted: Model?, winner: Model?, hold: number?)
	if not active or not stage then
		return
	end
	local s = stage :: Rules.Stage
	local now = os.clock()
	local at = centreOf(fainted)
	if reduced() then
		return
	end
	local orbit = if at then 1.5 else 0
	if at then
		local size = sizeOf(fainted :: Model)
		shot = { Kind = "ko", Of = (fainted :: Model).Name, Started = now, Until = now + orbit, Ease = 7, Fn = function(t: number): CFrame
			return Rules.orbit(s, at :: Vector3, size, t)
		end, Focus = function(): Vector3
			return at :: Vector3
		end }
	end
	if winner then
		task.delay(orbit, function()
			if active then
				FightCam.hero(winner, hold)
			end
		end)
	end
end

-- A low push-in on `model` that holds `hold` seconds (default: until stop()).
function FightCam.hero(model: Model, hold: number?)
	if not active or not stage then
		return
	end
	local s = stage :: Rules.Stage
	local now = os.clock()
	local size = sizeOf(model)
	local last = centreOf(model) or s.Centre
	shot = { Kind = "hero", Of = model.Name, Started = now, Until = now + (hold or 1e6), Ease = if reduced() then 20 else 3.5, Fn = function(t: number): CFrame
		last = centreOf(model) or last
		return Rules.hero(s, last, size, if reduced() then 1 else t)
	end, Focus = function(): Vector3
		return last
	end }
end

-- Every hit: the base view leans towards the pet that was hit and pushes in a little, then eases back. (Crits and
-- SUPER hits also cut to a close-up: FightCam.cut.)
function FightCam.nudge(target: Model?)
	if not active or reduced() or not target then
		return
	end
	local last = centreOf(target)
	if not last then
		return
	end
	nudgeAt = function(): Vector3?
		last = centreOf(target) or last
		return last
	end
	nudgeStart = os.clock()
end

function FightCam.active(): boolean
	return active
end

-- Hands the camera back to the player.
function FightCam.stop()
	if conn then
		conn:Disconnect()
		conn = nil
	end
	pcall(function()
		RunService:UnbindFromRenderStep(BIND)
	end)
	pcall(function()
		RunService:UnbindFromRenderStep(BIND_HIDE)
	end)
	local was = active
	active = false
	if was then
		CameraMode.cinematic(CINEMATIC, false)
		UI.holdNotices(false)
		PopupGate.hold("Fight", false)
	end
	shot = nil
	stage = nil
	local cam = Workspace.CurrentCamera
	if was and cam then
		cam.CameraType = Enum.CameraType.Custom
		if baseFov and heroLens then
			cam.FieldOfView = baseFov
		end
	end
	if was then
		dimLights(false)
	end
	baseFov = nil
	heroLens = false
	nudgeAt = nil
	hideSelf(false)
end

return FightCam
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="292">
          <Properties>
            <string name="Name">FightFx</string>
            <string name="Source"><![CDATA[--!strict
-- Big pet fight moments (client only, cosmetic; the server decides every hit, crit and KO). Built from the egg hatch
-- show's techniques (client HatchShow): field of view slam, decaying shake, white-then-colour screen flash, colour
-- correction pop, bloom spike, ground shockwave rings, blast spheres, hand-animated debris, light beams, slow motion.
--
--   FightFx.play(kind, opts)   kind: "hit" | "advantage" | "crit" | "special" | "ko" | "levelup" (FightFxRules)
--     opts.Target    the pet that is hit (Model) or a spot (Vector3); levelup: the pet levelling up
--     opts.Attacker  the attacking pet (special: the beam starts here, the charge glows here)
--     opts.Element   the attack element (Fire, Ice, Nature, Storm, Earth, Cosmic): colours sparks, rings, debris
--     opts.Color     overrides the colour (e.g. the winner's rarity colour)
--     opts.Damage    shows the number
--     opts.Mine      the local player's pet is in this moment: only then the screen effects play (camera, flash,
--                    colour, banner, slow motion). Everyone else nearby sees the world effects.
--     opts.Winner    ko: the winning pet gets the showcase (sky beam, confetti stars, happy bounce, WINNER! banner,
--                    and for the winner's owner a short camera push-in when opts.Cinematic is true)
--     opts.WinnerMine ko: false when the winner belongs to the rival (no WINNER! banner for the loser)
--     opts.Level     levelup: the new level
--     opts.OnImpact  special: called at the moment the beam lands (FightFx.SPECIAL_CHARGE seconds after play)
--   FightFx.speed()  1, or below 1 during slow motion: battle code scales its own pet movement by it.
--
-- Phone-cheap: every world piece is a few anchored parts with one tween each, debris comes from one pool of
-- FightFxRules.MAX_CHUNKS parts and one RenderStepped that stops when nothing flies, particles go through PetFx's
-- pool and budget, screen effects are gated (FightFxRules.takeScreen) and nothing plays far from the camera.
-- Reduce Motion: no camera moves, shake or slow motion, softer flash. Low Effects: half the debris, rings and stars.
-- No pet mouth opening or roar (owner rule); pets are only squashed (PetFx) and never re-rigged.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules = require(Shared.FightFxRules)
local PetFxRules = require(Shared.PetFxRules)
local PetFx = require(script.Parent.PetFx)
local CameraFx = require(script.Parent.CameraFx)
local CameraMode = require(script.Parent.CameraMode)
local State = require(script.Parent.State)
local UI = require(script.Parent.ui.UI)

local FightFx = {}

FightFx.SPECIAL_CHARGE = 0.7 -- s from play("special") to the impact
local WORLD_RANGE = 140 -- studs from the camera; further away nothing is built
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 205, 70)
local DUST = Color3.fromRGB(236, 228, 210)

local player = Players.LocalPlayer
local speed = 1
local gate = Rules.newGate()

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function reduced(): boolean
	return UI.Reduced or settings().ReducedMotion == true
end

local function lowFx(): boolean
	return settings().LowEffects == true
end

function FightFx.speed(): number
	return speed
end

-- A tween whose length follows the slow motion at the moment it starts.
-- (Capped at one extra second, so a piece started in slow motion does not hang around long after it.)
local function stretched(t: number): number
	return math.min(t / math.max(speed, 0.05), t + 1)
end

local function tw(obj: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(obj, TweenInfo.new(stretched(t), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- Waits `t` seconds of fight time (longer in slow motion).
local function wait_(t: number)
	local left = t
	while left > 0 do
		left -= RunService.Heartbeat:Wait() * speed
	end
end

local fxFolder: Folder? = nil
local function folder(): Folder
	if fxFolder and fxFolder.Parent then
		return fxFolder
	end
	local f = Instance.new("Folder")
	f.Name = "CT_FightFx"
	f.Parent = Workspace
	fxFolder = f
	return f
end

local function neon(shape: Enum.PartType, color: Color3, size: Vector3, cf: CFrame, alpha: number, mat: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = shape
	p.Material = mat or Enum.Material.Neon
	p.Color = color
	p.Size = size
	p.CFrame = cf
	p.Transparency = alpha
	p.Parent = folder()
	return p
end

-- Destroys a part after `t` seconds of fight time.
local function later(p: Instance, t: number)
	task.delay(stretched(t) + 0.1, function()
		p:Destroy()
	end)
end

local FLAT = CFrame.Angles(0, 0, math.rad(90))

local function centreOf(target: Model | Vector3): Vector3
	if typeof(target) == "Vector3" then
		return target
	end
	local m = target :: Model
	local h = m:GetAttribute("Height")
	return m:GetPivot().Position + Vector3.new(0, (if type(h) == "number" then h else 2) * 0.5, 0)
end

local function feetOf(target: Model | Vector3): Vector3
	if typeof(target) == "Vector3" then
		return target - Vector3.new(0, 1, 0)
	end
	return (target :: Model):GetPivot().Position
end

local function near(at: Vector3): boolean
	local cam = Workspace.CurrentCamera
	return cam == nil or (cam.CFrame.Position - at).Magnitude < WORLD_RANGE
end

-- Ground shockwave: a ring of glowing chips that races outwards and fades (a ring, never a filled glowing plate).
local RING_BITS = 14
local function shockwave(feet: Vector3, color: Color3, size: number, t: number, y: number?)
	local h = feet.Y + (y or 0.2)
	local r0 = 0.8
	local r1 = size / 2
	local bit = math.clamp(size / RING_BITS * 0.9, 0.5, 2.6)
	for i = 1, RING_BITS do
		local a = (i - 1) / RING_BITS * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local function place(r: number): CFrame
			local pos = Vector3.new(feet.X, h, feet.Z) + dir * r
			return CFrame.lookAt(pos, pos + dir)
		end
		local p = neon(Enum.PartType.Block, color, Vector3.new(bit * 0.5, 0.18, 0.25), place(r0), 0.05)
		tw(p, t, { CFrame = place(r1), Size = Vector3.new(bit, 0.08, 0.5), Transparency = 1 }, Enum.EasingStyle.Quart)
		later(p, t)
	end
end

-- A glowing sphere that swells and fades, plus a soft outer shell (kept small enough never to swallow the camera).
local function blast(at: Vector3, color: Color3, size: number)
	local a = neon(Enum.PartType.Ball, color, Vector3.one * 1.5, CFrame.new(at), 0.15)
	tw(a, 0.4, { Size = Vector3.one * size, Transparency = 1 }, Enum.EasingStyle.Quart)
	later(a, 0.4)
	local b = neon(Enum.PartType.Ball, WHITE, Vector3.one, CFrame.new(at), 0.4, Enum.Material.ForceField)
	tw(b, 0.6, { Size = Vector3.one * size * 1.2, Transparency = 1 }, Enum.EasingStyle.Quart)
	later(b, 0.7)
end

-- A light beam from a to b: fat and bright, then thin and gone.
local function beam(a: Vector3, b: Vector3, color: Color3, width: number, t: number)
	local len = (b - a).Magnitude
	if len < 0.1 then
		return
	end
	local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0) -- cylinder axis along the beam
	local outer = neon(Enum.PartType.Cylinder, color, Vector3.new(len, width, width), cf, 0.25)
	local core = neon(Enum.PartType.Cylinder, WHITE, Vector3.new(len, width * 0.35, width * 0.35), cf, 0.05)
	tw(outer, t, { Size = Vector3.new(len, width * 0.15, width * 0.15), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tw(core, t * 0.8, { Size = Vector3.new(len, 0.05, 0.05), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	later(outer, t)
	later(core, t)
end

-- A pillar of light rising from the feet into the sky; it lingers `hold` seconds, then fades. See-through enough that
-- the pet standing in it stays visible (the fight camera's hero shot frames the winner inside it).
local function pillar(feet: Vector3, color: Color3, hold: number)
	local h = 60
	local outer = neon(Enum.PartType.Cylinder, color, Vector3.new(2, 4, 4), CFrame.new(feet + Vector3.new(0, 1, 0)) * FLAT, 0.7)
	local core = neon(Enum.PartType.Cylinder, WHITE, Vector3.new(2, 1.2, 1.2), CFrame.new(feet + Vector3.new(0, 1, 0)) * FLAT, 0.55)
	tw(outer, 0.35, { Size = Vector3.new(h, 3.2, 3.2), CFrame = CFrame.new(feet + Vector3.new(0, h / 2, 0)) * FLAT })
	tw(core, 0.35, { Size = Vector3.new(h, 0.9, 0.9), CFrame = CFrame.new(feet + Vector3.new(0, h / 2, 0)) * FLAT })
	task.delay(hold, function()
		if outer.Parent then
			tw(outer, 0.8, { Transparency = 1, Size = Vector3.new(h, 0.6, 0.6) })
			tw(core, 0.8, { Transparency = 1, Size = Vector3.new(h, 0.1, 0.1) })
		end
	end)
	later(outer, hold + 1)
	later(core, hold + 1)
end

-- ---------------------------------------------------------------------------------------------------------------
-- Debris: pooled wedge chunks, hand-animated (FightFxRules.chunkStep) so slow motion slows them too.
type Chunk = { Part: Part, Pos: Vector3, Vel: Vector3, Rot: CFrame, Spin: Vector3, Alive: boolean, Ground: number, Rest: number }
local chunkPool: { Chunk } = {}
local chunkConn: RBXScriptConnection? = nil

local function chunkFrame(dt: number)
	local d = dt * speed
	local now = os.clock()
	local any = false
	for _, c in chunkPool do
		if c.Alive then
			any = true
			if c.Rest > 0 then
				if now > c.Rest then
					c.Alive = false
					c.Part.Transparency = 1
				else
					c.Part.Transparency = math.clamp(1 - (c.Rest - now) / 0.4, 0, 1)
				end
			else
				local settled
				c.Pos, c.Vel, settled = Rules.chunkStep(c.Pos, c.Vel, d, c.Ground)
				if settled then
					c.Rest = now + 1.2 -- lie a moment, then fade over the last 0.4 s
				else
					c.Rot *= CFrame.Angles(c.Spin.X * d, c.Spin.Y * d, c.Spin.Z * d)
				end
				c.Part.CFrame = CFrame.new(c.Pos) * c.Rot
			end
		end
	end
	if not any and chunkConn then
		chunkConn:Disconnect()
		chunkConn = nil
	end
end

local function debris(at: Vector3, color: Color3, n: number, ground: number, power: number)
	local made = 0
	for i = 1, Rules.MAX_CHUNKS do
		if made >= n then
			break
		end
		local c = chunkPool[i]
		if not c then
			local p = neon(Enum.PartType.Wedge, color, Vector3.one, CFrame.new(at), 1, Enum.Material.SmoothPlastic)
			c = { Part = p, Pos = at, Vel = Vector3.zero, Rot = CFrame.identity, Spin = Vector3.zero, Alive = false, Ground = 0, Rest = 0 }
			chunkPool[i] = c
		end
		if not c.Alive then
			made += 1
			local a = math.random() * math.pi * 2
			local s = 0.35 + math.random() * 0.45
			c.Part.Size = Vector3.new(s, s * (0.6 + math.random() * 0.6), s)
			c.Part.Color = if made % 3 == 0 then DUST else color
			c.Part.Transparency = 0
			c.Pos = at
			c.Vel = Vector3.new(math.cos(a) * (6 + math.random() * 10), 12 + math.random() * 14, math.sin(a) * (6 + math.random() * 10)) * power
			c.Rot = CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
			c.Spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 16
			c.Ground = ground + c.Part.Size.Y * 0.4
			c.Rest = 0
			c.Alive = true
		end
	end
	if made > 0 and not chunkConn then
		chunkConn = RunService.RenderStepped:Connect(chunkFrame)
	end
end

-- ---------------------------------------------------------------------------------------------------------------
-- Screen effects (only the local player's own moments): flash frame, colour correction, bloom, banner.
local flashGui: ScreenGui? = nil
local flashFrame: Frame? = nil
local cc: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil

local function screen(): (Frame, ColorCorrectionEffect, BloomEffect)
	if not (flashGui and flashGui.Parent) then
		local g = Instance.new("ScreenGui")
		g.Name = "CT_FightFlash"
		g.IgnoreGuiInset = true
		g.ResetOnSpawn = false
		g.DisplayOrder = 40
		local f = Instance.new("Frame")
		f.Size = UDim2.fromScale(1, 1)
		f.BorderSizePixel = 0
		f.BackgroundColor3 = WHITE
		f.BackgroundTransparency = 1
		f.Parent = g
		g.Parent = player:WaitForChild("PlayerGui")
		flashGui, flashFrame = g, f
	end
	if not (cc and cc.Parent) then
		local e = Instance.new("ColorCorrectionEffect")
		e.Name = "CT_FightColor"
		e.Parent = Lighting
		cc = e
	end
	if not (bloom and bloom.Parent) then
		local b = Instance.new("BloomEffect")
		b.Name = "CT_FightBloom"
		b.Intensity = 0
		b.Size = 24
		b.Threshold = 1.4
		b.Parent = Lighting
		bloom = b
	end
	return flashFrame :: Frame, cc :: ColorCorrectionEffect, bloom :: BloomEffect
end

-- The egg show's colour pop: white for a frame, then the moment's colour, fading out; colour grade and bloom spike.
local function screenPop(m: Rules.Moment, color: Color3)
	local f, e, b = screen()
	if m.Flash > 0 then
		-- never a full white frame (a K.O. in Studio washed the whole scene out): the colour, half towards white
		f.BackgroundColor3 = color:Lerp(WHITE, 0.5)
		f.BackgroundTransparency = 1 - math.min(m.Flash, Rules.MAX_FLASH)
		task.delay(0.05, function()
			f.BackgroundColor3 = color
			f.BackgroundTransparency = 1 - math.min(m.Flash, Rules.MAX_FLASH) * 0.8
			TweenService:Create(f, TweenInfo.new(0.55), { BackgroundTransparency = 1 }):Play()
		end)
	end
	if m.Tint > 0 then
		e.Brightness = 0.12 * m.Tint
		e.Contrast = 0.3 * m.Tint
		e.Saturation = 0.45 * m.Tint
		e.TintColor = color:Lerp(WHITE, 1 - 0.55 * m.Tint)
		TweenService:Create(e, TweenInfo.new(0.7), { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = WHITE }):Play()
	end
	if m.Bloom > 0 then
		b.Intensity = math.min(m.Bloom, Rules.MAX_BLOOM)
		TweenService:Create(b, TweenInfo.new(0.5), { Intensity = 0 }):Play()
	end
	if m.Fov > 0 then
		CameraFx.punch(m.Fov, 0.55 + m.Rank * 0.05)
	end
	if m.Shake > 0 then
		CameraFx.shake(m.Shake, 0.25 + m.Shake * 0.45)
	end
end

-- A big word that slams onto the screen and slides away (K.O.!, SPECIAL!, LEVEL UP!, WINNER!).
local function banner(text: string, color: Color3, hold: number?)
	local g = Instance.new("ScreenGui")
	g.Name = "CT_FightBanner"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 41
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.3)
	holder.Size = UDim2.new(0.9, 0, 0, 90)
	holder.Parent = g
	local scale = Instance.new("UIScale")
	scale.Scale = if reduced() then 1 else 2.2
	scale.Parent = holder
	local label = UI.text(holder, text, {
		Font = UI.Head, TextSize = 64, Outline = "Strong", TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 1, 0),
	})
	g.Parent = player:WaitForChild("PlayerGui")
	if not reduced() then
		TweenService:Create(scale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	local stay = hold or 1.1
	task.delay(stay, function()
		TweenService:Create(holder, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.fromScale(0.5, 0.2) }):Play()
		TweenService:Create(label, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		end
	end)
	task.delay(stay + 0.5, function()
		g:Destroy()
	end)
end

-- Slow motion for `real` seconds of real time at time scale k (newest call wins).
local slowToken = 0
local function slowmo(k: number, real: number)
	slowToken += 1
	local my = slowToken
	speed = k
	PetFx.setTimeScale(k)
	local e = cc
	if e and e.Parent then
		e.Saturation = -0.35
	end
	task.delay(real, function()
		if slowToken == my then
			speed = 1
			PetFx.setTimeScale(1)
			if e and e.Parent then
				TweenService:Create(e, TweenInfo.new(0.3), { Saturation = 0 }):Play()
			end
		end
	end)
end

-- ---------------------------------------------------------------------------------------------------------------
-- Winner showcase camera (the winner's owner only, opts.Cinematic): a short push-in and slow orbit, then back.
local function showcaseCamera(winner: Model)
	local cam = Workspace.CurrentCamera
	if not cam or reduced() or cam:GetAttribute("CT_Cinematic") == true then
		return
	end
	local from = cam.CFrame
	local fov = cam.FieldOfView
	local focus = centreOf(winner)
	local flat = Vector3.new(from.Position.X - focus.X, 0, from.Position.Z - focus.Z)
	if flat.Magnitude < 1 then
		flat = Vector3.new(0, 0, 1)
	end
	local off = flat.Unit * 11 + Vector3.new(0, 3.5, 0)
	local ok = pcall(function()
		CameraMode.cinematic("FightWin", true)
		cam:SetAttribute("CT_Cinematic", true)
		cam.CameraType = Enum.CameraType.Scriptable
		TweenService:Create(cam, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
			CFrame = CFrame.lookAt(focus + off, focus), FieldOfView = 55,
		}):Play()
		task.wait(0.72)
		local t0 = os.clock()
		while os.clock() - t0 < 2 do
			local a = (os.clock() - t0) * 0.35
			cam.CFrame = CFrame.lookAt(focus + CFrame.Angles(0, a, 0) * off, focus)
			RunService.RenderStepped:Wait()
		end
		local back = TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = from, FieldOfView = fov })
		back:Play()
		back.Completed:Wait()
	end)
	cam:SetAttribute("CT_Cinematic", nil)
	cam.CameraType = Enum.CameraType.Custom
	CameraMode.cinematic("FightWin", false)
	if not ok then
		CameraMode.restore()
	end
end

-- ---------------------------------------------------------------------------------------------------------------
export type Opts = {
	Target: (Model | Vector3)?,
	Attacker: Model?,
	Element: string?,
	Color: Color3?,
	Damage: number?,
	Quiet: boolean?, -- no CRIT! / number pops on the target (Pet Battle: TowerView already pops them)
	Mine: boolean?,
	Winner: Model?,
	WinnerColor: Color3?,
	Cinematic: boolean?,
	WinnerMine: boolean?, -- ko: false = the winner is the rival's (the loser never gets the WINNER! banner)
	Level: number?,
	OnImpact: (() -> ())?,
}

local function colorOf(o: Opts): Color3
	if o.Color then
		return o.Color
	end
	local c = (PetFxRules.ELEMENT_COLORS :: any)[tostring(o.Element)]
	return c or GOLD
end

local function impact(kind: string, m: Rules.Moment, o: Opts, at: Vector3, feet: Vector3, color: Color3)
	local mine = o.Mine == true
	local useScreen = mine and Rules.takeScreen(gate, m.Rank, os.clock(), m.SlowTime + 0.3)
	if useScreen then
		screenPop(m, color)
		if m.Slow < 1 then
			slowmo(m.Slow, m.SlowTime)
		end
		if m.Banner and kind ~= "levelup" then
			banner(m.Banner, if kind == "ko" then Color3.fromRGB(255, 110, 100) else color, if kind == "ko" then 1.3 else 0.9)
		end
	end
	if m.Chunks > 0 or m.Rings > 0 then
		blast(at, color, 3 + m.Rank * 0.9)
	end
	for i = 1, m.Rings do
		shockwave(feet, if i == 1 then WHITE elseif i % 2 == 0 then color else color:Lerp(WHITE, 0.4), 8 + i * 6 + m.Rank, 0.5 + i * 0.2, 0.1 + i * 0.06)
	end
	if m.Chunks > 0 then
		debris(at, color, m.Chunks, feet.Y, 0.7 + m.Rank * 0.08)
	end
	if m.Stars > 0 then
		PetFx.stars(at, m.Stars, WHITE, color, 10 + m.Rank * 3, 0.5 + m.Rank * 0.05)
	end
	if m.Pop then
		PetFx.pop(at + Vector3.new(0, 2, 0), m.Pop, color, true)
	end
end

local function playNow(kind: string, o: Opts)
	local m = Rules.moment(kind, lowFx(), reduced())
	local target: Model | Vector3 = o.Target or (o.Attacker :: any) or Vector3.zero
	local at = centreOf(target)
	if not near(at) then
		return
	end
	local feet = feetOf(target)
	local color = colorOf(o)
	local mine = o.Mine == true

	if kind == "hit" then
		PetFx.hit(target, { Element = o.Element, Damage = o.Damage, Quiet = o.Quiet })
		if mine and Rules.takeScreen(gate, m.Rank, os.clock()) then
			CameraFx.shake(m.Shake, 0.2)
		end
		return
	elseif kind == "advantage" or kind == "crit" then
		PetFx.hit(target, { Element = o.Element, Crit = kind == "crit", Damage = o.Damage, Quiet = o.Quiet })
		impact(kind, m, o, at, feet, color)
		return
	elseif kind == "levelup" then
		if typeof(target) == "Instance" then
			PetFx.levelUp(target :: Model, o.Level or 1)
			PetFx.happy(target :: Model)
		end
		pillar(feet, color, 1.2)
		impact(kind, m, o, at, feet, color) -- the words come from PetFx.levelUp over the pet (no second banner)
		return
	elseif kind == "special" then
		-- charge: the attacker glows, sparks rush in, a ring tightens at its feet, the world dims a little
		local src = if o.Attacker then centreOf(o.Attacker) else at + Vector3.new(0, 0, 6)
		local srcFeet = if o.Attacker then feetOf(o.Attacker) else feet
		local orb = neon(Enum.PartType.Ball, color, Vector3.one * 0.6, CFrame.new(src), 0.1)
		tw(orb, FightFx.SPECIAL_CHARGE, { Size = Vector3.one * 3.2, Transparency = 0.35 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local ring = neon(Enum.PartType.Cylinder, color, Vector3.new(0.12, 9, 9), CFrame.new(srcFeet + Vector3.new(0, 0.12, 0)) * FLAT, 0.3)
		tw(ring, FightFx.SPECIAL_CHARGE, { Size = Vector3.new(0.12, 2, 2), Transparency = 0.05 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		if o.Attacker then
			PetFx.squash(o.Attacker)
		end
		if mine and not reduced() then
			local _, e = screen()
			TweenService:Create(e, TweenInfo.new(FightFx.SPECIAL_CHARGE), { Brightness = -0.15, Contrast = 0.15 }):Play()
			CameraFx.shake(0.25, FightFx.SPECIAL_CHARGE)
		end
		for i = 1, 3 do
			task.delay((i - 1) * FightFx.SPECIAL_CHARGE / 3, function()
				PetFx.stars(src + Vector3.new(math.random() * 4 - 2, math.random() * 3, math.random() * 4 - 2), 6, WHITE, color, 3, 0.35)
			end)
		end
		wait_(FightFx.SPECIAL_CHARGE)
		orb:Destroy()
		ring:Destroy()
		-- release: a fat beam to the target and a big impact
		beam(src, at, color, 2.4, 0.45)
		if o.OnImpact then
			task.spawn(o.OnImpact)
		end
		PetFx.hit(target, { Element = o.Element, Crit = true, Damage = o.Damage, Quiet = o.Quiet })
		impact(kind, m, o, at, feet, color)
		return
	elseif kind == "ko" then
		PetFx.ko(target, mine) -- the owner sees the big K.O.! banner instead of the small pop
		impact(kind, m, o, at, feet, color)
		local w = o.Winner
		if w then
			wait_(m.SlowTime * m.Slow + 0.2) -- right after the slow motion
			local wc = o.WinnerColor or GOLD
			local wf = feetOf(w)
			pillar(wf, wc, 1.2) -- short: the hero shot that follows wants the winner itself
			shockwave(wf, wc, 22, 0.9)
			PetFx.happy(w)
			PetFx.stars(centreOf(w) + Vector3.new(0, 1, 0), 40, WHITE, wc, 14, 0.7)
			task.delay(0.35, function()
				PetFx.stars(centreOf(w) + Vector3.new(0, 2, 0), 30, Color3.fromRGB(255, 120, 200), Color3.fromRGB(120, 200, 255), 16, 0.6)
				if w.Parent then
					PetFx.happy(w)
				end
			end)
			if mine and o.WinnerMine ~= false then
				banner("WINNER!", GOLD, 1.6)
				if o.Cinematic then
					showcaseCamera(w)
				end
			end
		end
		return
	end
end

-- Plays one fight moment (see the top of this file). Returns at once; the moment runs on its own.
function FightFx.play(kind: string, opts: Opts?)
	local o: Opts = opts or {}
	task.spawn(function()
		local ok, err = pcall(function()
			playNow(kind, o)
		end)
		if not ok then
			warn("[FightFx] " .. tostring(err))
			speed = 1
			PetFx.setTimeScale(1)
		end
	end)
end

return FightFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="293">
          <Properties>
            <string name="Name">GuideArrow</string>
            <string name="Source"><![CDATA[--!strict
-- Route hint (Master Prompt 4, sections 04 and 29). Replaces the giant "ROCK PILE" billboard and the large
-- yellow floor arrow with the smallest thing that still helps:
--   * a small ground chevron a few studs ahead of the avatar, only for a few seconds after the destination
--     changes (basket full -> your table, empty hands -> the pile while still learning), never when the avatar
--     is already close, and fading out; while the destination is far away (lost player) it stays on
--   * a compact chip on the screen edge that points at the destination while it is off screen, kept inside
--     the safe rectangle the HUD hands us (clear of the objective, the left column, the action and jump)
-- Direction always comes from the real target position and the camera, never from a compass constant.
-- Cosmetic only; nothing here sends or decides anything.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local UI = require(script.Parent.ui.UI)

local GuideArrow = {}

local player = Players.LocalPlayer
local C = UI.Colors

local NEAR = 14 -- studs: closer than this the hint is not needed
local CHEVRON_SECONDS = 6 -- the ground chevron shows this long after the destination changes
local CHEVRON_AHEAD = 4.2
local CHEVRON_ALPHA = 0.35
local FAR = 40 -- studs: further than this the chevron stays on (bug 244: lost players need a steady pointer)
local CHIP_W = 124 -- screen-edge chip size (logical px)
local CHIP_H = 40

local target: Vector3? = nil
local label = ""
local floorY = 0
local shownAt = 0
local folder: Folder? = nil
local chevron: Model? = nil
local offsets: { [Instance]: CFrame } = {} -- bar -> its frame relative to the chevron's tip
local conn: RBXScriptConnection? = nil
local edge: Frame? = nil
local edgeIcon: Frame? = nil
local edgeText: TextLabel? = nil
local boundsFn: (() -> (number, number, number, number))? = nil -- screen px (left, top, right, bottom)

local function bar(parent: Instance, name: string, cf: CFrame): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = Vector3.new(0.4, 0.08, 1.7)
	p.CFrame = cf
	p.Color = C.Amber
	p.Material = Enum.Material.SmoothPlastic
	p.Transparency = 1
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

local function build()
	if folder and folder.Parent then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "CT_Rocks_Guide"
	f.Parent = Workspace
	folder = f
	-- a chevron "V" pointing along -Z: two short bars angled 40 degrees back from the tip
	local m = Instance.new("Model")
	m.Name = "Chevron"
	local right = bar(m, "BarR", CFrame.new(0.55, 0, 0.65) * CFrame.Angles(0, math.rad(40), 0))
	local left = bar(m, "BarL", CFrame.new(-0.55, 0, 0.65) * CFrame.Angles(0, math.rad(-40), 0))
	offsets[right], offsets[left] = right.CFrame, left.CFrame
	m.Parent = f
	chevron = m
	-- edge chip: small and dark with an amber arrow, never the brightest thing on screen
	-- (bug #222: big enough to read on a phone; CHIP_W x CHIP_H)
	local e = UI.frame(UI.screen(), { Name = "GuideEdge", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(CHIP_W, CHIP_H), BackgroundColor3 = C.Slate, BackgroundTransparency = 0.12, Visible = false, ZIndex = 4 })
	UI.corner(e, CHIP_H // 2)
	UI.stroke(e, C.SlateLine, 1.5)
	edgeIcon = UI.icon(e, "arrow", 26, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(22, CHIP_H // 2), Color = C.Amber, Bg = C.Slate })
	local et = UI.text(e, "", { Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -46, 1, 0), Font = UI.Head, TextSize = UI.T.Head, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Center })
	et.TextWrapped = false
	UI.fit(et, UI.T.Head, UI.T.Body)
	edgeText = et
	edge = e
end

local curAlpha = 1 -- eased chevron transparency (fades out when the nest is reached)
local lastTick = os.clock()

local function tick()
	local nowT = os.clock()
	local dtT = math.min(nowT - lastTick, 0.1)
	lastTick = nowT
	local t = target
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not t or not root or not chevron then
		return
	end
	local blocked = UI.blocked() or UI.modalOpen() ~= nil or (player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true) -- no route hint over a menu or in the tower
	local flat = Vector3.new(t.X - root.Position.X, 0, t.Z - root.Position.Z)
	local near = flat.Magnitude < NEAR
	local cam = Workspace.CurrentCamera
	if edge and cam then
		local gui = UI.screen()
		local vp = cam:WorldToViewportPoint(t + Vector3.new(0, 3, 0))
		local origin, size = gui.AbsolutePosition, gui.AbsoluteSize
		local px, py = vp.X - origin.X, vp.Y - origin.Y
		local l, tp, r, b = 60, 60, size.X - 60, size.Y - 60
		if boundsFn then
			l, tp, r, b = boundsFn()
			l, r, tp, b = l + CHIP_W / 2, r - CHIP_W / 2, tp + CHIP_H / 2, b - CHIP_H / 2 -- the chip's own half size stays inside the rectangle
		end
		-- the chip is for a destination that is OFF screen: one the player can already see (even in a strip the HUD
		-- covers) needs no chip, which used to float mid-screen at the edge of the free rectangle (bug #222)
		local on = vp.Z > 0 and px > 0 and px < size.X and py > 0 and py < size.Y
		edge.Visible = not on and not blocked and not near
		if edge.Visible then
			local cx, cy = (l + r) / 2, (tp + b) / 2
			local dx, dy = px - cx, py - cy
			if vp.Z < 0 then
				dx, dy = -dx, -dy
			end
			if math.abs(dx) < 1 and math.abs(dy) < 1 then
				dy = 1
			end
			local k = math.min(((r - l) / 2) / math.max(math.abs(dx), 1), ((b - tp) / 2) / math.max(math.abs(dy), 1))
			edge.Position = UDim2.fromScale((cx + dx * k) / math.max(size.X, 1), (cy + dy * k) / math.max(size.Y, 1)) -- scale, not offset: the HUD gui has its own UIScale
			if edgeIcon then
				edgeIcon.Rotation = math.deg(math.atan2(dx, -dy))
			end
			if edgeText and edgeText.Text ~= label then
				edgeText.Text = label
			end
		end
	end
	-- ground chevron: a few seconds after the destination changes, never when close or while a panel is open
	local age = os.clock() - shownAt
	local alpha = 1
	local far = flat.Magnitude > FAR
	if not blocked and not near and (far or age < CHEVRON_SECONDS) and flat.Magnitude > 0.1 then
		local fade = if far then 1 else math.clamp((CHEVRON_SECONDS - age) / 1.2, 0, 1) -- last 1.2 s fade out
		alpha = 1 - (1 - CHEVRON_ALPHA) * fade
		local dir = flat.Unit
		local at = Vector3.new(root.Position.X, floorY + 0.12, root.Position.Z) + dir * (CHEVRON_AHEAD + math.sin(os.clock() * 4) * 0.25)
		-- each bar is placed from the same frame (no Model:PivotTo), so the V can never come apart
		local base = CFrame.lookAt(at, at + dir)
		for _, d in (chevron :: Model):GetChildren() do
			local off = offsets[d]
			if off and d:IsA("BasePart") then -- (only the two bars have offsets)
				d.CFrame = base * off
			end
		end
	end
	curAlpha += (alpha - curAlpha) * math.min(1, dtT * 7) -- soft fade, not a snap
	if math.abs(alpha - curAlpha) < 0.01 then
		curAlpha = alpha
	end
	for _, d in (chevron :: Model):GetChildren() do
		if d:IsA("BasePart") then
			d.Transparency = curAlpha
		end
	end
end

-- The HUD tells us the rectangle (screen px inside the HUD gui) the edge chip may use.
function GuideArrow.setBounds(fn: (() -> (number, number, number, number))?)
	boundsFn = fn
end

-- Points at `pos` (world) with `name` as the short chip text; nil clears it. Calling it again with the same
-- destination keeps the current chevron timer; a new destination restarts it.
function GuideArrow.set(pos: Vector3?, name: string?, floor: number?)
	if not pos then
		GuideArrow.clear()
		return
	end
	build()
	if label ~= (name or "") or not target then
		shownAt = os.clock()
	end
	target = pos
	label = name or ""
	floorY = floor or pos.Y
	if not conn then
		conn = RunService.Heartbeat:Connect(tick)
	end
end

function GuideArrow.clear()
	target = nil
	label = ""
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if edge then
		edge:Destroy()
		edge, edgeIcon, edgeText = nil, nil, nil
	end
	if folder then
		folder:Destroy()
		folder = nil
	end
	chevron = nil
	table.clear(offsets)
	curAlpha = 1
end

function GuideArrow.label(): string
	return label
end

return GuideArrow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="294">
          <Properties>
            <string name="Name">HangoutAnim</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby hangout animation (owner ask 2026-10-14: "animate what you can on all of them, glowing aura etc").
-- Client only and cosmetic: the server's parts are never moved for gameplay. Every hangout piece is found by name
-- (Hangout.animKind) when it appears and gets its look:
--   GoldenRock  bobs, turns slowly, gold aura light pulses, gold sparkles; shakes on every hit
--   MysteryEgg  bobs and wobbles, purple aura pulses through colours, sparkles
--   WhackRock   pops up out of its hole with a little bounce
--   RainCoin    a glint of sparkles
--   HiddenEgg   a soft twinkle and a faint glow (a hint, not a sign post)
--   Lookout     a warm gold glow that breathes, sparkles
--   Campfire    the light flickers and warm embers float up
--   TopPlot     the top plot's gold glow breathes; Crown sparkles
--   Beam        the sky beam shimmers (width pulse)
--   Stump                          a soft pulsing "play here" glow ring light
-- Only pieces within Hangout.Anim.Near studs of the camera move or sparkle (half that with Low Effects); one
-- RenderStepped loop drives them all. Code-made pieces (rock, egg, whack rock, beam) are moved locally from the
-- CFrame they had when they appeared (the server never moves them after); map props only get lights and sparkles.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Hangout = require(Shared.Hangout)
local Net = require(Shared.Net)
local State = require(script.Parent.State)

local HangoutAnim = {}

local SPARK = "rbxasset://textures/particles/sparkles_main.dds"

type Item = {
	Kind: string,
	Inst: Instance,
	Part: BasePart?,
	Base: CFrame?,
	Light: PointLight?,
	Emitters: { ParticleEmitter },
	Seed: number,
	Near: boolean,
	Born: number,
	Shake: number,
	BaseSize: Vector3?,
}

local items: { Item } = {}
local byInst: { [Instance]: Item } = {}

local function lowEffects(): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings.LowEffects == true
end

local function partOf(inst: Instance): BasePart?
	if inst:IsA("BasePart") then
		return inst
	end
	if inst:IsA("Model") and inst.PrimaryPart then
		return inst.PrimaryPart
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

local function light(part: BasePart, color: Color3, range: number): PointLight
	local l = Instance.new("PointLight")
	l.Name = "HangoutAura"
	l.Color = color
	l.Range = range
	l.Brightness = 1
	l.Shadows = false
	l.Parent = part
	return l
end

local function sparkles(part: BasePart, color: Color3, rate: number, size: number, up: number?): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = "HangoutSparkle"
	e.Texture = SPARK
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.8
	e.Rate = rate
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(0.5, 2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, up or 1, 0)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Enabled = false
	e.Parent = part
	return e
end

local GOLD = Color3.fromRGB(255, 206, 64)
local PURPLE = Color3.fromRGB(190, 120, 255)
local WARM = Color3.fromRGB(255, 160, 80)
local SOFT = Color3.fromRGB(255, 240, 200)

local function add(inst: Instance, kind: string)
	if byInst[inst] then
		return
	end
	local host: Instance? = if kind == "Campfire" or kind == "TopPlot" then inst.Parent else inst
	local part = if kind == "Campfire" then (if host and host:IsA("BasePart") then host else nil) elseif kind == "TopPlot" then nil else partOf(inst)
	local it: Item = {
		Kind = kind,
		Inst = inst,
		Part = part,
		Base = nil,
		Light = nil,
		Emitters = {},
		Seed = math.random(),
		Near = false,
		Born = os.clock(),
		Shake = 0,
		BaseSize = nil,
	}
	local p = part
	if kind == "GoldenRock" and p then
		it.Base = p.CFrame
		it.Light = p:FindFirstChildOfClass("PointLight") or light(p, GOLD, 20)
		table.insert(it.Emitters, sparkles(p, GOLD, 14, 0.6, 2))
	elseif kind == "MysteryEgg" and p then
		it.Base = p.CFrame
		it.Light = p:FindFirstChildOfClass("PointLight") or light(p, PURPLE, 14)
		table.insert(it.Emitters, sparkles(p, PURPLE, 10, 0.5, 1.5))
	elseif kind == "WhackRock" and p then
		it.Base = p.CFrame
		p.CFrame = p.CFrame * CFrame.new(0, -1.4, 0)
	elseif kind == "RainCoin" and p then
		table.insert(it.Emitters, sparkles(p, GOLD, 2, 0.35, 0))
	elseif kind == "HiddenEgg" and p then
		it.Light = light(p, SOFT, 6)
		table.insert(it.Emitters, sparkles(p, SOFT, 1.2, 0.35, 0.5))
	elseif kind == "Lookout" and p then
		it.Light = light(p, GOLD, 12)
		table.insert(it.Emitters, sparkles(p, GOLD, 4, 0.45, 1.5))
	elseif kind == "Campfire" and p then
		it.Light = (inst :: any) :: PointLight
		table.insert(it.Emitters, sparkles(p, WARM, 5, 0.3, 4))
	elseif kind == "Crown" and p then
		table.insert(it.Emitters, sparkles(p, GOLD, 6, 0.5, 1))
	elseif kind == "Beam" and p then
		it.BaseSize = p.Size
	elseif kind == "Stump" and p then
		it.Light = light(p, GOLD, 10)
	elseif kind ~= "TopPlot" then
		return
	end
	byInst[inst] = it
	table.insert(items, it)
end

local function consider(d: Instance)
	local kind = Hangout.animKind(d.Name)
	if kind then
		task.defer(add, d, kind) -- let its children (prompt, light) arrive first
	end
end

local function cull()
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local low = lowEffects()
	local inHunt = State.Match ~= nil
	local i = 1
	while i <= #items do
		local it = items[i]
		if not it.Inst.Parent then
			byInst[it.Inst] = nil
			table.remove(items, i)
			continue
		end
		local at: Vector3? = if it.Part then it.Part.Position
			elseif it.Inst:IsA("Highlight") and it.Inst.Adornee and it.Inst.Adornee:IsA("Model") then (it.Inst.Adornee :: Model):GetPivot().Position
			else nil
		it.Near = not inHunt and at ~= nil and Hangout.animNear((at - camPos).Magnitude, low)
		for _, e in it.Emitters do
			e.Enabled = it.Near and not low
		end
		i += 1
	end
end

local function step()
	local t = os.clock()
	for _, it in items do
		if not it.Near then
			continue
		end
		local p = it.Part
		local k = it.Kind
		if k == "GoldenRock" and p and it.Base then
			local shake = if it.Shake > t then (math.random() - 0.5) * 0.5 else 0
			p.CFrame = it.Base * CFrame.new(shake, math.sin(t * 2 + it.Seed * 6) * 0.4, 0) * CFrame.Angles(0, t * 0.4, 0)
			if it.Light then
				it.Light.Brightness = 1.2 + 1.6 * Hangout.pulse(t, 0.8, it.Seed)
			end
		elseif k == "MysteryEgg" and p and it.Base then
			p.CFrame = it.Base * CFrame.new(0, math.sin(t * 2.4) * 0.6 + 0.3, 0) * CFrame.Angles(0, t * 0.8, math.sin(t * 5) * 0.12)
			if it.Light then
				it.Light.Brightness = 1 + 2 * Hangout.pulse(t, 1, it.Seed)
				it.Light.Color = Color3.fromHSV((0.75 + 0.1 * math.sin(t)) % 1, 0.55, 1)
			end
		elseif k == "WhackRock" and p and it.Base then
			local a = math.clamp((t - it.Born) / 0.15, 0, 1)
			local bounce = if a < 1 then -1.4 * (1 - a) else math.max(0, math.sin((t - it.Born - 0.15) * 18) * 0.15 * math.exp(-(t - it.Born) * 6))
			p.CFrame = it.Base * CFrame.new(0, bounce, 0)
		elseif (k == "HiddenEgg" or k == "Lookout" or k == "Stump") and it.Light then
			local top = if k == "HiddenEgg" then 0.6 elseif k == "Lookout" then 2 else 1.2
			it.Light.Brightness = top * (0.35 + 0.65 * Hangout.pulse(t, 0.5, it.Seed))
		elseif k == "Campfire" and it.Light then
			it.Light.Brightness = 1.3 + 0.5 * math.noise(t * 3, it.Seed * 10) + 0.2 * Hangout.pulse(t, 2.3, it.Seed)
		elseif k == "TopPlot" and it.Inst:IsA("Highlight") then
			local h = it.Inst :: Highlight
			local b = Hangout.pulse(t, 0.6, 0)
			h.FillTransparency = 0.88 - 0.14 * b
			h.OutlineTransparency = 0.4 - 0.35 * b
		elseif k == "Beam" and p and it.BaseSize then
			local w = 1 + 0.12 * math.sin(t * 8)
			p.Size = Vector3.new(it.BaseSize.X, it.BaseSize.Y * w, it.BaseSize.Z * w)
		end
	end
end

function HangoutAnim.start()
	for _, d in Workspace:GetDescendants() do
		consider(d)
	end
	Workspace.DescendantAdded:Connect(consider)
	Net.event("HangoutEvent").OnClientEvent:Connect(function(kind: any, data: any)
		if kind == "RockHit" and type(data) == "table" then
			for _, it in items do
				if it.Kind == "GoldenRock" then
					it.Shake = os.clock() + 0.15
				end
			end
		end
	end)
	task.spawn(function()
		while true do
			cull()
			task.wait(Hangout.Anim.CullEvery)
		end
	end)
	RunService.RenderStepped:Connect(step)
end

-- Tests / previews: run one distance check now and report what is animated.
function HangoutAnim.debug(): { [string]: number }
	cull()
	local out = {}
	for _, it in items do
		if it.Near then
			out[it.Kind] = (out[it.Kind] or 0) + 1
		end
	end
	return out
end

return HangoutAnim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="295">
          <Properties>
            <string name="Name">HangoutView</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby hangout, client side (shared/Hangout). Draws only; the server decides everything.
--   * sky beam over the egg shrine when an Epic / Legendary hatches in this server (RareHatch "Local")
--   * whack-a-rock: a small score card while you play
--   * lobby events: the status card names the running event
--   * emote button: Roblox's own emotes, read from the avatar's Animate script (no asset ids in the game)

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Hangout = require(Shared.Hangout)
local SafeZones = require(Shared.SafeZones)
local Net = require(Shared.Net)
local State = require(script.Parent.State)
local UI = require(script.Parent.ui.UI)
local Theme = require(script.Parent.ui.Theme)
local PetStyle = require(script.Parent.ui.PetStyle)
local PET = Theme.Pet

local HangoutView = {}

local player = Players.LocalPlayer
local fx: Folder? = nil

local function fxFolder(): Folder
	local f = fx
	if f and f.Parent then
		return f
	end
	local made = Instance.new("Folder")
	made.Name = "CT_HangoutFx"
	made.Parent = Workspace
	fx = made
	return made
end

local function lowEffects(): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings.LowEffects == true
end

local function deco(p: BasePart)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
end

-- Sky beam -------------------------------------------------------------------------------------------------------------

local function hatchStand(): BasePart?
	for _, d in Workspace:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("HatchStand") == true then
			return d
		end
	end
	return nil
end

function HangoutView.beam(rarity: string)
	if not Hangout.beamFor(rarity) then
		return
	end
	local stand = hatchStand()
	if not stand then
		return
	end
	local B = Hangout.Beam
	local w = (B.Width :: any)[rarity] or 5
	local h = if lowEffects() then B.Height / 2 else B.Height
	local beam = Instance.new("Part")
	beam.Name = "SkyBeam"
	beam.Shape = Enum.PartType.Cylinder
	beam.Material = Enum.Material.Neon
	beam.Color = (B.Color :: any)[rarity] or Color3.new(1, 1, 1)
	beam.Size = Vector3.new(h, w, w)
	beam.CFrame = CFrame.new(stand.Position + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	beam.Transparency = 1
	deco(beam)
	local light = Instance.new("PointLight")
	light.Color = beam.Color
	light.Range = 40
	light.Brightness = 3
	light.Parent = beam
	beam.Parent = fxFolder()
	TweenService:Create(beam, TweenInfo.new(0.6), { Transparency = 0.25 }):Play()
	task.delay(B.Seconds, function()
		TweenService:Create(beam, TweenInfo.new(1.2), { Transparency = 1 }):Play()
		task.wait(1.3)
		beam:Destroy()
	end)
end

-- Screen bits: status card, emotes -----------------------------------------------------------------------------------

local card: TextLabel? = nil
local cardBox: Frame? = nil -- the card's light pet-style box (shown and popped with the words)
local emoteBtn: TextButton? = nil
local emoteRow: Frame? = nil
local cardText = { Whack = nil :: string?, Event = nil :: string? }

-- A quick "pop" (scale up and settle) on a screen element (owner ask: animate everything).
local function pop(g: GuiObject, from: number)
	local found = g:FindFirstChildOfClass("UIScale")
	local s: UIScale = if found then found else Instance.new("UIScale")
	s.Parent = g
	s.Scale = from
	TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function refreshCard()
	local c = card
	if not c then
		return
	end
	local line = cardText.Whack or cardText.Event
	local box: GuiObject = if cardBox then cardBox else c
	local was = box.Visible
	box.Visible = line ~= nil and State.Match == nil
	-- a new message pops; a ticking count only pops when the first word changes
	if box.Visible and (not was or string.match(c.Text, "^%S+") ~= string.match(line or "", "^%S+")) then
		pop(box, 1.18)
	end
	c.Text = line or ""
end

local function playEmote(key: string)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animate = char and char:FindFirstChild("Animate")
	local folder = animate and animate:FindFirstChild(key)
	local anim = folder and folder:FindFirstChildWhichIsA("Animation")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not (anim and animator and hum) then
		return
	end
	local track = (animator :: Animator):LoadAnimation(anim :: Animation)
	track.Priority = Enum.AnimationPriority.Action
	track:Play()
	-- walking away stops the emote
	local conn: RBXScriptConnection? = nil
	conn = (hum :: Humanoid).Running:Connect(function(speed: number)
		if speed > 1 then
			track:Stop(0.2)
			if conn then
				conn:Disconnect()
			end
		end
	end)
	track.Stopped:Connect(function()
		if conn then
			conn:Disconnect()
		end
	end)
end

local function buildGui()
	local sg = Instance.new("ScreenGui")
	sg.Name = "CT_Hangout"
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = false
	sg.DisplayOrder = 6
	sg.Parent = player:WaitForChild("PlayerGui")


	-- pet style: a light rounded HUD card (the clip's "NEXT UP" bar) with the words in the deep title blue
	local box = UI.frame(sg, { Name = "HangoutCard", BackgroundColor3 = PET.QuestBody })
	-- a bit below the middle (the top middle belongs to the objective / gift notes)
	box.AnchorPoint = Vector2.new(0.5, 1)
	box.Position = UDim2.new(0.5, 0, 0.62, -58)
	box.Size = UDim2.fromOffset(300, 40)
	box.Visible = false
	PetStyle.round(box, 999)
	PetStyle.edge(box, PET.QuestEdge, 2.5)
	local c = UI.text(box, "", { Name = "Text", TextSize = UI.T.Head, Font = UI.Head, TextColor3 = PET.TitleEdge, Outline = false, Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0) })
	c.TextXAlignment = Enum.TextXAlignment.Center
	card = c
	cardBox = box

	local row = Instance.new("Frame")
	row.Name = "EmoteRow"
	row.BackgroundTransparency = 1
	-- a 2-wide grid right above the Emote button (left of the jump button, clear of the joystick)
	row.AnchorPoint = Vector2.new(1, 1)
	row.Position = UDim2.new(1, -184, 1, -96) -- placeEmote() moves it with the button
	row.Size = UDim2.fromOffset(2 * 82, math.ceil(#Hangout.Emotes / 2) * 50)
	row.Visible = false
	local list = Instance.new("UIGridLayout")
	list.CellSize = UDim2.fromOffset(76, 44)
	list.CellPadding = UDim2.fromOffset(6, 6)
	list.HorizontalAlignment = Enum.HorizontalAlignment.Right
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = row
	for i, e in Hangout.Emotes do
		local b = UI.button(row, e.Name, "gray", function()
			row.Visible = false
			playEmote(e.Key)
		end, { TextSize = UI.T.Small })
		b.Size = UDim2.fromOffset(76, 44)
		b.LayoutOrder = i
	end
	row.Parent = sg
	emoteRow = row

	local eb = UI.button(sg, "Emote", "gray", function()
		row.Visible = not row.Visible
		if row.Visible then
			pop(row, 0.6)
		end
	end, { TextSize = UI.T.Small })
	eb.Name = "EmoteButton"
	eb.AnchorPoint = Vector2.new(1, 1)
	eb.Position = UDim2.new(1, -184, 1, -40)
	eb.Size = UDim2.fromOffset(62, 48)
	emoteBtn = eb

	-- Structural spot (shared/SafeZones): on touch the button stays out of the jump-button zone (bottom right) and
	-- out of the bottom-centre band where a ProximityPrompt card (egg "Hatch!") appears. This gui has no UIScale, so
	-- the geometry runs in logical px (screen px / UI.Scale) and the result is converted back; PC keeps its old spot.
	local function placeEmote()
		local px = sg.AbsoluteSize
		if px.X < 2 or px.Y < 2 then
			return
		end
		local k = math.max(UI.Scale, 0.1)
		local touch = UserInputService.TouchEnabled
		local r = SafeZones.bottomButton(px.X / k, px.Y / k, 62 / k, 48 / k, touch, k)
		local rightPx = px.X - (r.x + r.w) * k
		local bottomPx = px.Y - (r.y + r.h) * k
		eb.Position = UDim2.new(1, -rightPx, 1, -bottomPx)
		row.Position = UDim2.new(1, -rightPx, 1, -(bottomPx + 48 + 8))
	end
	placeEmote()
	sg:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeEmote)
	UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(placeEmote)
end

local function refreshVisibility()
	-- hunts, the pet tower and pet battles have their own buttons where EMOTE sits (it covered SPECIAL)
	local inHunt = State.Match ~= nil or player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true
	-- a menu on screen (UI.modal) hides the floating EMOTE button and its grid; closing the menu brings them back
	local menuOpen = UI.modalOpen() ~= nil
	if emoteBtn then
		emoteBtn.Visible = not inHunt and not menuOpen
	end
	if (inHunt or menuOpen) and emoteRow then
		emoteRow.Visible = false
	end
	refreshCard()
end

-- Events from the server -------------------------------------------------------------------------------------------------

local function onEvent(kind: string, data: any)
	if kind == "Whack" and type(data) == "table" then
		local left = math.max(0, math.ceil((data.Ends or 0) - Workspace:GetServerTimeNow()))
		cardText.Whack = "EGG POP: " .. tostring(data.Hits) .. " taps, " .. left .. "s"
		refreshCard()
	elseif kind == "WhackDone" then
		cardText.Whack = nil
		refreshCard()
	elseif kind == "Event" and type(data) == "table" then
		cardText.Event = if data.State == "Start" and type(data.Name) == "string" then data.Name .. " is on!" else nil
		refreshCard()
	elseif kind == "RockHit" and type(data) == "table" then
		cardText.Event = "GOLDEN EGG: " .. tostring(data.Left) .. " taps left"
		refreshCard()
	end
end

function HangoutView.start()
	buildGui()
	Net.event("HangoutEvent").OnClientEvent:Connect(onEvent)
	Net.event("RareHatch").OnClientEvent:Connect(function(kind: any, p: any)
		if kind == "Local" and type(p) == "table" then
			HangoutView.beam(p.Rarity)
		end
	end)
	State.Changed.Event:Connect(function(what: string)
		if what == "Match" then
			refreshVisibility()
		end
	end)
	player:GetAttributeChangedSignal("InTower"):Connect(refreshVisibility)
	player:GetAttributeChangedSignal("InBattle"):Connect(refreshVisibility)
	UI.ModalChanged.Event:Connect(refreshVisibility) -- the shared "a menu is open" signal: EMOTE hides under a menu
	refreshVisibility()
end

return HangoutView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="296">
          <Properties>
            <string name="Name">HatchCard</string>
            <string name="Source"><![CDATA[--!strict
-- The pet card above a hatch at the public hatch stand (client only, cosmetic; the server rolled the pet before the
-- HatchShow event arrived). A small BillboardGui card shows its back ("?") first, then flips over (the card narrows to
-- nothing and widens again) to show who hatched what: the rarity line and the pet's name land together (a name typing
-- in after the rarity read as "COMMON ... BUNNY") and the rarity stars (1 Common .. 5 Legendary) fill in one by one. Reduce Motion: the open card at once, full name, all stars lit.
-- Everything lives under the BillboardGui, so destroying the adornee (the show folder) cleans it all up.

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local UI = require(script.Parent.ui.UI)

local HatchCard = {}

local FLIP_AT, FLIP = 0.15, 0.32 -- seconds after the pop; the whole flip (half narrows, half widens)
local STAR_STEP = 0.16 -- seconds per star
local DIM = Color3.fromRGB(70, 66, 84)

local function stars(rarity: string): number
	for i, r in Config.Rarities do
		if r == rarity then
			return i
		end
	end
	return 1
end

-- Builds the card over `adornee`. `head` is the small line ("Kc hatched a RARE"), `name` the pet name that types in.
function HatchCard.show(adornee: BasePart, head: string, name: string, rarity: string, color: Color3): BillboardGui
	local reduced = UI.Reduced
	local bb = Instance.new("BillboardGui")
	bb.Name = "HatchTag"
	bb.Adornee = adornee
	bb.Size = UDim2.fromOffset(260, 92)
	bb.StudsOffsetWorldSpace = Vector3.new(0, adornee.Size.Y * 0.5 + 2.8, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.ResetOnSpawn = false
	-- the card face (only its background narrows during the flip; the text sits beside it so it never squashes)
	local card = UI.frame(bb, {
		Name = "Card", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(34, 30, 46), BackgroundTransparency = 0.15,
	})
	UI.corner(card, 12)
	local edge = UI.stroke(card, color, 3)
	local back = UI.text(card, "?", {
		Name = "Back", Font = UI.Head, TextSize = 40, TextColor3 = color, Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local front = UI.frame(bb, { Name = "Front", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false })
	UI.text(front, head, {
		Name = "Head", Font = UI.Bold, TextSize = UI.T.Body, TextColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(8, 4),
		Size = UDim2.new(1, -16, 0, 20), TextXAlignment = Enum.TextXAlignment.Center,
	})
	UI.text(front, name, {
		Name = "Name", Font = UI.Head, TextSize = 24, TextColor3 = color, Position = UDim2.fromOffset(8, 24),
		Size = UDim2.new(1, -16, 0, 34), TextXAlignment = Enum.TextXAlignment.Center,
	})
	local row = UI.frame(front, {
		Name = "Stars", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 62),
		Size = UDim2.fromOffset(5 * 22, 20), BackgroundTransparency = 1,
	})
	local lit = stars(rarity)
	local slots: { Frame } = {}
	for i = 1, 5 do
		slots[i] = UI.frame(row, { Name = "Slot" .. i, Position = UDim2.fromOffset((i - 1) * 22, 0), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1 })
		UI.icon(slots[i], "star", 20, { Color = DIM, Flat = true })
	end
	bb.Parent = adornee

	local function light(i: number)
		local s = slots[i]
		if s and s.Parent then
			local star = UI.icon(s, "star", 20, { Name = "Lit" })
			UI.pop(star, 0.3)
		end
	end
	local function open()
		back.Visible = false
		front.Visible = true
	end
	if reduced then
		open()
		for i = 1, lit do
			light(i)
		end
		return bb
	end

	task.delay(FLIP_AT, function()
		if not bb.Parent then
			return
		end
		local half = TweenInfo.new(FLIP / 2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local shut = TweenService:Create(card, half, { Size = UDim2.fromScale(0, 1) })
		back.Visible = false -- the "?" would squash with the card; the bare card turns edge-on
		shut:Play()
		shut.Completed:Wait()
		if not bb.Parent then
			return
		end
		edge.Color = color:Lerp(Color3.new(1, 1, 1), 0.35)
		TweenService:Create(card, TweenInfo.new(FLIP / 2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromScale(1, 1) }):Play()
		task.wait(FLIP / 2)
		if not bb.Parent then
			return
		end
		open()
		-- rarity line and name show together, then the stars light one by one
		for i = 1, lit do
			light(i)
			task.wait(STAR_STEP)
			if not bb.Parent then
				return
			end
		end
	end)
	return bb
end

return HatchCard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="297">
          <Properties>
            <string name="Name">HatchFocus</string>
            <string name="Source"><![CDATA[--!strict
-- Hatch close-up (client only, cosmetic). When the pet egg is found, the finder's camera glides from first person to
-- a close look at their own nest (CameraModeRules.nestShot) so the egg opening on the plate is the thing on screen,
-- then hands over to the full-screen reveal card (RevealView). A CameraMode cinematic: released by HatchFocus.stop
-- (Main, right before the reveal opens), by the results, or after MAX seconds whatever happens.
-- Reduce Motion: a cut instead of the glide.
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local CameraModeRules = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("CameraModeRules"))
local CameraMode = require(script.Parent.CameraMode)
local UI = require(script.Parent.ui.UI)

local HatchFocus = {}

local CINE = "HatchFocus"
local GLIDE = 0.7 -- seconds
local MAX = 10 -- seconds: never holds the camera longer than this
local token = 0
local tween: Tween? = nil

function HatchFocus.stop()
	token += 1
	if tween then
		tween:Cancel()
		tween = nil
	end
	CameraMode.cinematic(CINE, false)
end

-- Starts the close-up on nest plate position `plate` (nil: nothing to look at, nothing happens).
function HatchFocus.start(plate: Vector3?)
	local cam = Workspace.CurrentCamera
	if not plate or not cam then
		return
	end
	HatchFocus.stop()
	token += 1
	local mine = token
	CameraMode.cinematic(CINE, true)
	cam.CameraType = Enum.CameraType.Scriptable
	local shot = CameraModeRules.nestShot(plate, cam.CFrame.Position)
	if UI.Reduced then
		cam.CFrame = shot
	else
		local t = TweenService:Create(cam, TweenInfo.new(GLIDE, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = shot })
		tween = t
		t:Play()
	end
	task.delay(MAX, function()
		if token == mine then
			HatchFocus.stop()
		end
	end)
end

return HatchFocus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="298">
          <Properties>
            <string name="Name">HatchFx</string>
            <string name="Source"><![CDATA[--!strict
-- World juice around a hatch (client only, cosmetic; the server already decided and saved everything before the
-- events that drive this arrive, and nothing here is sent anywhere):
--   onReveal(data)   the match Reveal event (only the hunt's members get it). Rare+ (PetFlair.shouldAnnounce): a
--                    rainbow ring blasts out across the arena from the winner's nest, and firework bursts pop above
--                    the pile, timed to the pet popping out of the egg on the nest. Once per round.
--   goldSky(sec)     Legendary: a warm gold wash over the whole view, driven by the RareHatch "Local" broadcast that
--                    already goes to every player in the server. A ColorCorrectionEffect on the local camera; the
--                    Lighting service is not touched.
-- Reduce Motion: no ring or fireworks (the gold wash stays, it does not move). Low Effects: fewer pieces.
-- Every part lives in one folder, is driven by one RenderStepped connection and is destroyed when it ends.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PetFlair = require(Shared.PetFlair)
local State = require(script.Parent.State)
local StationView = require(script.Parent.StationView)

local HatchFx = {}

local pileCenter: Vector3? = nil
local lastRound: any = nil
local rng = Random.new()

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function reduced(): boolean
	return settings().ReducedMotion == true
end

local function lowFx(): boolean
	return settings().LowEffects == true
end

local function fxPart(parent: Instance, shape: Enum.PartType, size: Vector3, color: Color3): Part
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Parent = parent
	return p
end

local function folder(name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = Workspace
	return f
end

-- Run step(t) every frame for `life` seconds, then destroy the folder. step returns nothing.
local function drive(f: Folder, life: number, step: (number) -> ())
	local t = 0
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function(dt)
		t += dt
		if t >= life or not f.Parent then
			if conn then
				conn:Disconnect()
			end
			f:Destroy()
			return
		end
		step(t)
	end)
end

-- The pile centre of the current round (Main passes the Pile payload's Center).
function HatchFx.setPile(center: any)
	pileCenter = if typeof(center) == "Vector3" then center else nil
end

-- A flat rainbow ring of neon segments that grows from `pos` across the arena and fades.
function HatchFx.ring(pos: Vector3)
	if reduced() then
		return
	end
	local n = if lowFx() then 14 else 26
	local f = folder("CTR_HatchRing")
	local segs: { Part } = {}
	for i = 1, n do
		segs[i] = fxPart(f, Enum.PartType.Block, Vector3.new(1, 0.35, 0.5), Color3.fromHSV(i / n, 0.75, 1))
	end
	local life, maxR = 1.3, 60
	local y = pos.Y + 0.6
	drive(f, life, function(t)
		local k = t / life
		local r = 1.5 + (maxR - 1.5) * (1 - (1 - k) ^ 3)
		local len = 2 * math.pi * r / n * 0.9
		local spin = t * 0.8
		for i, p in segs do
			local a = i / n * math.pi * 2 + spin
			p.Size = Vector3.new(len, 0.35 + 0.6 * (1 - k), 0.5 + 0.8 * (1 - k))
			p.CFrame = CFrame.new(pos.X + math.cos(a) * r, y + 0.4 * (1 - k), pos.Z + math.sin(a) * r) * CFrame.Angles(0, -a + math.pi / 2, 0)
			p.Color = Color3.fromHSV((i / n + t * 0.6) % 1, 0.75, 1)
			p.Transparency = 0.1 + 0.9 * k * k
		end
	end)
end

-- A few firework bursts in the sky above `pos`.
function HatchFx.fireworks(pos: Vector3, tint: Color3?)
	if reduced() then
		return
	end
	local bursts = if lowFx() then 2 else 4
	local per = if lowFx() then 8 else 14
	local colors = { tint or Color3.fromRGB(255, 210, 80), Color3.fromRGB(255, 210, 80), Color3.fromRGB(255, 120, 170), Color3.fromRGB(120, 220, 255) }
	for b = 1, bursts do
		task.delay((b - 1) * 0.35, function()
			local f = folder("CTR_Firework")
			local at = pos + Vector3.new(rng:NextNumber(-10, 10), rng:NextNumber(20, 28), rng:NextNumber(-10, 10))
			local color = colors[(b - 1) % #colors + 1]
			local flash = fxPart(f, Enum.PartType.Ball, Vector3.one * 2.5, Color3.new(1, 1, 1))
			flash.CFrame = CFrame.new(at)
			local light = Instance.new("PointLight")
			light.Color = color
			light.Range = 24
			light.Brightness = 3
			light.Shadows = false
			light.Parent = flash
			local sparks: { Part } = {}
			local vel: { Vector3 } = {}
			for i = 1, per do
				local d = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.6, 1), rng:NextNumber(-1, 1))
				d = if d.Magnitude > 1e-3 then d.Unit else Vector3.yAxis
				sparks[i] = fxPart(f, Enum.PartType.Ball, Vector3.one * 0.7, if i % 4 == 0 then Color3.new(1, 1, 1) else color)
				vel[i] = d * rng:NextNumber(14, 20)
			end
			local life = 1.4
			drive(f, life, function(t)
				local k = t / life
				flash.Transparency = math.min(1, t / 0.25)
				light.Brightness = 3 * (1 - k)
				for i, p in sparks do
					local v = vel[i]
					local drag = (1 - math.exp(-2.2 * t)) / 2.2 -- slowing outward travel
					p.CFrame = CFrame.new(at + v * drag + Vector3.new(0, -4 * t * t, 0))
					p.Transparency = k * k
				end
			end)
		end)
	end
end

-- The match Reveal event: Rare+ ring from the winner's nest and fireworks above the pile, once per round.
function HatchFx.onReveal(data: any)
	if type(data) ~= "table" or type(data.Specimen) ~= "table" then
		return
	end
	local rarity = data.Specimen.Rarity
	if not PetFlair.shouldAnnounce(rarity) then
		return
	end
	local key = data.Round or data
	if key == lastRound then
		return -- a rejoin replays the Reveal payload; the blast plays once
	end
	lastRound = key
	local nest = if type(data.Winner) == "number" then StationView.platePosition(data.Winner) else nil
	local pile = pileCenter
	-- when the egg on the nest finishes opening (the pop), never later than 3 s
	local at = math.clamp(StationView.fxRemaining() - 0.2, 0, 3)
	task.delay(at, function()
		if nest then
			HatchFx.ring(nest)
		end
		local above = pile or nest
		if above then
			task.delay(0.25, function()
				HatchFx.fireworks(above, nil)
			end)
		end
	end)
end

local sky: ColorCorrectionEffect? = nil
local skyToken = 0

-- Legendary: the world washes warm gold for `seconds` (fades in and out).
function HatchFx.goldSky(seconds: number?)
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local hold = math.clamp(seconds or 3, 1, 6)
	skyToken += 1
	local token = skyToken
	local cc = sky
	if not cc or not cc.Parent then
		local n = Instance.new("ColorCorrectionEffect")
		n.Name = "CTR_GoldSky"
		n.TintColor = Color3.new(1, 1, 1)
		n.Parent = cam
		cc = n
		sky = n
	end
	local e = cc :: ColorCorrectionEffect
	TweenService:Create(e, TweenInfo.new(0.5, Enum.EasingStyle.Sine), { TintColor = Color3.fromRGB(255, 222, 150), Brightness = 0.06, Saturation = 0.2 }):Play()
	task.delay(hold, function()
		if token ~= skyToken then
			return
		end
		local tw = TweenService:Create(e, TweenInfo.new(0.8, Enum.EasingStyle.Sine), { TintColor = Color3.new(1, 1, 1), Brightness = 0, Saturation = 0 })
		tw:Play()
		tw.Completed:Connect(function()
			if token == skyToken then
				e:Destroy()
				if sky == e then
					sky = nil
				end
			end
		end)
	end)
end

return HatchFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="299">
          <Properties>
            <string name="Name">HatchShow</string>
            <string name="Source"><![CDATA[-- The big hatch show (client only, cosmetic; the server already picked and saved the pet before this plays).
-- Port of the Studio demo egg v2 (DemoEggClient_DEV, runner-proven; reference copy in the project files at
-- reference/demo_egg/). Three tiers: RARE (quick), EPIC (god rays), LEGENDARY (slow-mo burst, rainbow, lobby beam).
-- Changes from the demo: any egg part and pet record (HatchShow.play), the game's own pet model when the place has
-- no hand-made one, plain wedge shell chunks when EggKitMeshes is missing, the egg does not regrow (the starter egg
-- is removed after its show), and the camera is held through CameraMode. No pet mouth animation (owner rule).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GeodeGen = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GeodeGen"))
local PetModel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PetModel"))
local CameraMode = require(script.Parent.CameraMode)
local PetStyle = require(script.Parent.ui.PetStyle)

local HatchShow = {}

local player = Players.LocalPlayer
-- set per show by HatchShow.play (the demo had one fixed egg)
local egg: BasePart = nil :: any
local ring: BasePart = nil :: any
local spec: { [string]: any } = {}
local okIds, SoundIds = pcall(function() return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SoundIds")) end)
if not okIds or type(SoundIds) ~= "table" then SoundIds = {} end
-- Find The Pet made sounds (HatchSparkle, HatchDrum; 0 until uploaded = silent)
local okPet, PetSoundIds = pcall(function() return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PetSoundIds")) end)
if not okPet or type(PetSoundIds) ~= "table" then PetSoundIds = {} end

local TIERS = {
	RARE = { colors = { Color3.fromRGB(70, 160, 255), Color3.fromRGB(80, 240, 255) }, cracks = 2, slow = false, beam = 60, chunks = 14, coins = 10, silhouette = 0.6, rainbow = false },
	EPIC = { colors = { Color3.fromRGB(190, 90, 255), Color3.fromRGB(255, 90, 220) }, cracks = 3, slow = false, beam = 90, chunks = 20, coins = 18, silhouette = 0.9, rainbow = false },
	LEGENDARY = { colors = { Color3.fromRGB(255, 196, 40), Color3.fromRGB(255, 120, 30) }, cracks = 3, slow = true, beam = 400, chunks = 28, coins = 32, silhouette = 1.4, rainbow = true },
}
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)), ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 170, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 240, 60)), ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 230, 110)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(70, 160, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)),
})
local CONFETTI = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 210, 60), Color3.fromRGB(90, 220, 120), Color3.fromRGB(80, 170, 255), Color3.fromRGB(200, 110, 255), Color3.fromRGB(255, 255, 255) }

local eggHome = CFrame.new()
local eggSize = Vector3.one
local base = CFrame.new() -- pedestal top, under the egg
local playing = false

local speed = 1 -- 1 = normal, < 1 = slow motion (drives our own animations, waits and particle TimeScale)
local emitters = {}

local function wait_(t: number)
	local left = t
	while left > 0 do
		left -= RunService.RenderStepped:Wait() * speed
	end
end

local function tw(obj, t, props, style, dir)
	local tween = TweenService:Create(obj, TweenInfo.new(t / math.max(speed, 0.05), style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

local function sound(name: string, vol: number?, pitch: number?, parent: Instance?)
	local id = SoundIds[name]
	if not id or id == 0 then id = PetSoundIds[name] end
	if not id or id == 0 or id == "" then return end
	local s = Instance.new("Sound")
	s.SoundId = if type(id) == "number" then "rbxassetid://" .. id else tostring(id)
	s.Volume = vol or 0.8
	s.PlaybackSpeed = (pitch or 1) * math.max(speed, 0.5)
	s.RollOffMaxDistance = 260
	s.Parent = parent or egg
	s:Play()
	s.Ended:Once(function() s:Destroy() end)
	task.delay(8, function() if s.Parent then s:Destroy() end end)
end

local function fx(parent: Instance, props: { [string]: any }): ParticleEmitter
	local p = Instance.new("ParticleEmitter")
	p.Texture = SPARK
	p.LightEmission = 1
	p.Enabled = false
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	table.insert(emitters, p)
	return p
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = workspace
	return p
end

local function shockwave(color: Color3, size: number, t: number, y: number?)
	local w = part({ Shape = Enum.PartType.Cylinder, Color = color, Size = Vector3.new(0.3, 2, 2), Transparency = 0.05 })
	w.CFrame = CFrame.new(base.Position + Vector3.new(0, (y or 0.3), 0)) * CFrame.Angles(0, 0, math.rad(90))
	tw(w, t, { Size = Vector3.new(0.12, size, size), Transparency = 1 }, Enum.EasingStyle.Quart)
	task.delay(t / math.max(speed, 0.05) + 0.2, function() w:Destroy() end)
end

-- the big banner that slides in (presser only): a white pet-style sheet with the tier's colour round its edge,
-- the rarity on a glossy ribbon over its top and the name in the outlined title words (ui/PetStyle)
local function bigBanner(name: string, rarity: string, tier)
	local gui = Instance.new("ScreenGui")
	gui.Name = "DemoEggBanner"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 60
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local holder = Instance.new("Frame")
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.fromScale(-0.6, 0.06)
	holder.Size = UDim2.fromScale(0.62, 0.24)
	holder.BackgroundTransparency = 1
	holder.Parent = gui
	local K = PetStyle.K
	local tint = if tier.rainbow then RAINBOW else ColorSequence.new(tier.colors[1], tier.colors[2])
	-- drop copy under the sheet (a sibling: children draw above their parent)
	local drop = Instance.new("Frame")
	drop.Name = "Drop"
	drop.Size = UDim2.fromScale(1, 0.62)
	drop.Position = UDim2.new(0, 0, 0.38, 5)
	drop.BackgroundColor3 = K.TitleShadow
	drop.BackgroundTransparency = 0.5
	drop.BorderSizePixel = 0
	drop.ZIndex = 1
	drop.Parent = holder
	PetStyle.round(drop, 18)
	local strip = Instance.new("Frame")
	strip.Name = "Sheet"
	strip.Size = UDim2.fromScale(1, 0.62)
	strip.Position = UDim2.fromScale(0, 0.38)
	strip.BackgroundColor3 = K.Panel
	strip.BorderSizePixel = 0
	strip.ZIndex = 2
	strip.Parent = holder
	PetStyle.round(strip, 18)
	PetStyle.pattern(strip, K.PanelPattern, 0.3, 40, 700, 120, 80)
	local stroke = PetStyle.edge(strip, tier.colors[1], 4)
	local sg = Instance.new("UIGradient", stroke)
	sg.Color = tint
	-- the rarity ribbon: a glossy pill in the tier's colours (rainbow for LEGENDARY), tilted a touch
	local ribbon = Instance.new("Frame")
	ribbon.Name = "Ribbon"
	ribbon.AnchorPoint = Vector2.new(0.5, 0)
	ribbon.Position = UDim2.fromScale(0.5, 0.02)
	ribbon.Size = UDim2.fromScale(0.62, 0.42)
	ribbon.BackgroundColor3 = tier.colors[1]
	ribbon.BorderSizePixel = 0
	ribbon.Rotation = -2
	ribbon.ZIndex = 3
	ribbon.Parent = holder
	PetStyle.round(ribbon, 999)
	PetStyle.edge(ribbon, K.Ink, 2.5)
	local g = Instance.new("UIGradient", ribbon)
	g.Color = tint
	local r = PetStyle.words(ribbon, "\u{2605} " .. rarity .. " \u{2605}", 40, {
		Name = "Rarity", Size = UDim2.new(1, -16, 1, -6), Position = UDim2.fromOffset(8, 2), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4, OutlineThick = 3,
	})
	r.TextWrapped = false
	PetStyle.title(strip, "You hatched " .. name .. "!", 54, {
		Name = "Hatched", Position = UDim2.fromScale(0.04, 0.08), Size = UDim2.fromScale(0.92, 0.84), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4,
	})
	gui.Parent = player:WaitForChild("PlayerGui")
	TweenService:Create(holder, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.06) }):Play()
	task.spawn(function()
		local t0 = os.clock()
		while gui.Parent do
			local a = (os.clock() - t0) * 140 % 360
			g.Rotation = a
			sg.Rotation = -a
			task.wait()
		end
	end)
	return gui, holder
end

local function play(petName: string, rarity: string, presserId: number?)
	if playing then return end
	playing = true
	speed = 1
	table.clear(emitters)
	local tier = TIERS[rarity] or TIERS.EPIC
	local c1, c2 = tier.colors[1], tier.colors[2]
	local mine = presserId == nil or presserId == player.UserId
	local cam = workspace.CurrentCamera
	local trash = {}
	local function keep(x)
		table.insert(trash, x)
		return x
	end

	------------------------------------------------------------ camera + HUD (presser only)
	local oldFov = cam.FieldOfView
	local from = cam.CFrame
	local flat = Vector3.new(from.Position.X - base.Position.X, 0, from.Position.Z - base.Position.Z)
	if flat.Magnitude < 1 then flat = Vector3.new(0, 0, 1) end
	local focus = base.Position + Vector3.new(0, 5, 0)
	local camPos = focus + flat.Unit * 14 + Vector3.new(0, 2, 0)
	local camGoal = CFrame.lookAt(camPos, focus)
	local shake = 0
	local orbit = 0 -- slow camera orbit around the egg (radians/s)
	local orbitAng = 0
	local camConn
	local hidden = {}
	if mine then
		cam:SetAttribute("CT_Cinematic", true)
		cam.CameraType = Enum.CameraType.Scriptable
		for _, gg in player.PlayerGui:GetDescendants() do
			if (gg:IsA("ScreenGui") or gg:IsA("BillboardGui")) and gg.Enabled and gg.Name ~= "DemoEggBanner" then
				gg.Enabled = false
				table.insert(hidden, gg)
			end
		end
		for _, gg in workspace:GetDescendants() do -- world tags like YOUR GALLERY would float over the show
			if gg:IsA("BillboardGui") and gg.Enabled then
				gg.Enabled = false
				table.insert(hidden, gg)
			end
		end
		-- keep the world tags off (the game re-enables its marker) and hide our own avatar + pets from our camera
		local ghosts = {}
		local function ghost(m: Instance?)
			if not m then return end
			for _, d in m:GetDescendants() do
				if d:IsA("BasePart") or d:IsA("Decal") then table.insert(ghosts, d) end
			end
		end
		ghost(player.Character)
		local petsFolder = workspace:FindFirstChild("CTR_Pets")
		if petsFolder then
			for _, m in petsFolder:GetChildren() do
				if tostring(m.Name):find(tostring(player.UserId), 1, true) then ghost(m) end
			end
		end
		local scanAt = 0
		local holdConn = RunService.RenderStepped:Connect(function()
			if os.clock() > scanAt then -- tags that appear mid-show (e.g. the gallery marker) get hidden too
				scanAt = os.clock() + 0.25
				for _, root in { workspace, player.PlayerGui } do
					for _, gg in root:GetDescendants() do
						if gg:IsA("BillboardGui") and gg.Enabled and not table.find(hidden, gg) then
							gg.Enabled = false
							table.insert(hidden, gg)
						end
					end
				end
			end
			for _, gg in hidden do
				if gg.Parent and gg.Enabled then gg.Enabled = false end
			end
			for _, d in ghosts do
				if d.Parent then (d :: any).LocalTransparencyModifier = 1 end
			end
		end)
		table.insert(trash, holdConn)
		table.insert(trash, function()
			for _, d in ghosts do
				if d.Parent then (d :: any).LocalTransparencyModifier = 0 end
			end
		end)
		tw(cam, 1.0, { CFrame = camGoal, FieldOfView = 58 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		task.delay(1.05, function()
			camConn = RunService.RenderStepped:Connect(function(dt)
				orbitAng += orbit * dt * speed
				local off = CFrame.Angles(0, orbitAng, 0) * (camPos - focus)
				local goal = CFrame.lookAt(focus + off, focus)
				if shake > 0 then
					goal *= CFrame.new((math.random() - 0.5) * shake, (math.random() - 0.5) * shake, (math.random() - 0.5) * shake * 0.5)
				end
				cam.CFrame = goal
			end)
		end)
	end

	------------------------------------------------------------ anticipation: lights down, spotlight, heartbeat
	local cc, bloom, dof
	if mine then
		cc = keep(Instance.new("ColorCorrectionEffect"))
		cc.Parent = Lighting
		tw(cc, 1.2, { Brightness = -0.28, Contrast = 0.25, Saturation = 0.1, TintColor = Color3.fromRGB(190, 195, 235) })
		bloom = keep(Instance.new("BloomEffect"))
		bloom.Intensity = 0
		bloom.Size = 26
		bloom.Threshold = 1.4
		bloom.Parent = Lighting
		tw(bloom, 2, { Intensity = 0.6 })
		dof = keep(Instance.new("DepthOfFieldEffect"))
		dof.FocusDistance = 15
		dof.InFocusRadius = 14
		dof.FarIntensity = 0
		dof.NearIntensity = 0
		dof.Parent = Lighting
		tw(dof, 1.5, { FarIntensity = 0.15 })
	end
	local spotHolder = keep(part({ Transparency = 1, Size = Vector3.new(1, 1, 1) }))
	spotHolder.CFrame = CFrame.lookAt(base.Position + Vector3.new(0, 26, 0), base.Position)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Front
	spot.Angle = 28
	spot.Range = 40
	spot.Brightness = 0
	spot.Color = Color3.fromRGB(255, 250, 235)
	spot.Shadows = true
	spot.Parent = spotHolder
	tw(spot, 0.6, { Brightness = 4.5 })
	local cone = keep(part({ Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(255, 250, 225), Transparency = 1, Material = Enum.Material.ForceField }))
	cone.Size = Vector3.new(26, 9, 9)
	cone.CFrame = CFrame.new(base.Position + Vector3.new(0, 13, 0)) * CFrame.Angles(0, 0, math.rad(90))
	tw(cone, 0.8, { Transparency = 0.6 })

	local light = keep(Instance.new("PointLight"))
	light.Color = c1
	light.Range = 6
	light.Brightness = 0
	light.Shadows = false
	light.Parent = egg
	local hl = keep(Instance.new("Highlight"))
	hl.FillColor = c1
	hl.OutlineColor = c2
	hl.FillTransparency = 1
	hl.OutlineTransparency = 0.7
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Adornee = egg
	hl.Parent = egg

	-- the egg's motion is driven every frame from these
	local lift, spin, spinVel, wob, hop, scalePulse = 0, 0, 0, 0, 0, 1
	local eggConn = RunService.RenderStepped:Connect(function(dt)
		dt *= speed
		spin += spinVel * dt
		local t = os.clock()
		local rot = CFrame.Angles(math.sin(t * 23) * wob * 0.6, spin, math.sin(t * 29) * wob)
		local jitter = Vector3.new((math.random() - 0.5) * wob * 0.6, math.abs(math.sin(t * 37)) * hop, (math.random() - 0.5) * wob * 0.6)
		egg.Size = eggSize * scalePulse
		egg.CFrame = (base + Vector3.new(0, lift, 0) + jitter) * rot * CFrame.new(0, egg.Size.Y / 2, 0)
	end)

	-- heartbeat: accelerating thumps, egg pulses and glows
	local beats = if tier.slow then 6 elseif rarity == "EPIC" then 4 else 2
	for i = 1, beats do
		sound("CountdownTick", 0.7, 0.75 + i * 0.05)
		scalePulse = 1.09
		hl.FillTransparency = 0.55
		light.Brightness = 1 + i * 0.6
		light.Range = 8 + i * 2
		tw(hl, 0.35, { FillTransparency = 0.9 })
		task.spawn(function()
			for k = 1, 8 do
				scalePulse = 1 + 0.09 * (1 - k / 8)
				RunService.RenderStepped:Wait()
			end
			scalePulse = 1
		end)
		wait_(math.max(0.62 - i * 0.07, 0.3))
	end

	------------------------------------------------------------ float up + spin faster and faster
	sound("PressDescend", 0.5, 1.4)
	local floatT = 0
	local spinUp = RunService.RenderStepped:Connect(function(dt)
		floatT += dt * speed
		lift = math.min(floatT / 1.2, 1) * 3.2
		spinVel = math.min(floatT * 9, 26)
		wob = math.rad(4 + floatT * 5)
	end)
	keep(Instance.new("Folder")) -- placeholder so trash is never empty
	local swirl = {}
	for i = 1, 4 do
		local a = keep(part({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.45, 0.45, 0.45), Color = i % 2 == 0 and c2 or c1 }))
		local p = fx(a, {
			Rate = 60, Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(0, 0.3),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
			Color = if tier.rainbow and i % 2 == 0 then RAINBOW else ColorSequence.new(i % 2 == 0 and c2 or c1),
		})
		p.Enabled = true
		local trailA0 = Instance.new("Attachment", a)
		trailA0.Position = Vector3.new(0, 0.25, 0)
		local trailA1 = Instance.new("Attachment", a)
		trailA1.Position = Vector3.new(0, -0.25, 0)
		local tr = Instance.new("Trail")
		tr.Attachment0 = trailA0
		tr.Attachment1 = trailA1
		tr.Lifetime = 0.35
		tr.LightEmission = 1
		tr.FaceCamera = true
		tr.Color = if tier.rainbow then RAINBOW else ColorSequence.new(c1, c2)
		tr.Transparency = NumberSequence.new(0, 1)
		tr.Parent = a
		table.insert(swirl, { a = a, off = i * math.pi / 2 })
	end
	local swirlT = 0
	local swirlConn = RunService.RenderStepped:Connect(function(dt)
		swirlT += dt * speed
		for i, s in swirl do
			local ang = swirlT * (5 + swirlT * 1.5) + s.off
			local rad = math.max(5 - swirlT * 0.9, 1.2)
			s.a.CFrame = CFrame.new(base.Position + Vector3.new(math.cos(ang) * rad, 2 + lift + math.sin(swirlT * 3 + i) * 1.5, math.sin(ang) * rad))
		end
	end)
	wait_(if rarity == "RARE" then 0.7 else 1.3)

	------------------------------------------------------------ cracks in stages
	local cracks = {}
	local function addCracks(n: number, len: number)
		local rx, ry = eggSize.X / 2, eggSize.Y / 2
		for _ = 1, n do
			local a = math.random() * math.pi * 2
			local h = (math.random() - 0.3) * 0.85
			local l = Vector3.new(math.cos(a) * rx * math.sqrt(1 - h * h), h * ry, math.sin(a) * rx * math.sqrt(1 - h * h))
			local cp = keep(part({ Color = c1, Size = Vector3.new(0.14, 0.05, 0.16), Transparency = 0 }))
			table.insert(cracks, { p = cp, l = l, tilt = math.rad((math.random() - 0.5) * 80) })
			tw(cp, 0.18, { Size = Vector3.new(0.2, len * (0.7 + math.random() * 0.6), 0.2) }, Enum.EasingStyle.Back)
		end
	end
	local crackConn = RunService.RenderStepped:Connect(function()
		for _, c in cracks do
			c.p.CFrame = egg.CFrame * CFrame.lookAt(c.l, c.l * 2) * CFrame.Angles(0, 0, c.tilt)
		end
	end)
	local leak = fx(egg, {
		Rate = 0, Lifetime = NumberRange.new(0.4, 0.8), Speed = NumberRange.new(6, 12), SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new(0.35, 0), Color = ColorSequence.new(Color3.new(1, 1, 1), c1),
	})
	leak.Enabled = true
	for stage = 1, tier.cracks do
		sound("StoneCrack" .. math.clamp(stage, 1, 3), 1, 1 + stage * 0.08)
		addCracks(3 + stage, 0.9 + stage * 0.45)
		leak.Rate = 25 * stage
		hl.FillTransparency = 0.75 - stage * 0.15
		tw(light, 0.3, { Brightness = 2 + stage * 1.5, Range = 12 + stage * 4 })
		shockwave(stage % 2 == 0 and c2 or c1, 14 + stage * 6, 0.8)
		shake = 0.12 * stage
		task.delay(0.18, function() shake = 0.04 * stage end)
		if mine and cc then
			cc.TintColor = c1:Lerp(Color3.new(1, 1, 1), 0.55)
			tw(cc, 0.35, { TintColor = Color3.fromRGB(190, 195, 235) })
		end
		wait_(if tier.slow then 0.85 else 0.65)
	end

	------------------------------------------------------------ charge: god-ray beam, inward rush
	local beamH = tier.beam
	local beam = keep(part({ Shape = Enum.PartType.Cylinder, Color = c1, Transparency = 0.25, Material = Enum.Material.ForceField }))
	beam.Size = Vector3.new(0.1, 1.5, 1.5)
	beam.CFrame = CFrame.new(base.Position) * CFrame.Angles(0, 0, math.rad(90))
	local beamCore = keep(part({ Shape = Enum.PartType.Cylinder, Color = Color3.new(1, 1, 1), Transparency = 0 }))
	beamCore.Size = Vector3.new(0.1, 0.6, 0.6)
	beamCore.CFrame = beam.CFrame
	local beamW = if tier.slow then 5 else 3
	tw(beam, 0.9, { Size = Vector3.new(beamH, beamW, beamW), CFrame = CFrame.new(base.Position + Vector3.new(0, beamH / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, Enum.EasingStyle.Quart)
	tw(beamCore, 0.9, { Size = Vector3.new(beamH, beamW * 0.4, beamW * 0.4), CFrame = CFrame.new(base.Position + Vector3.new(0, beamH / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)) }, Enum.EasingStyle.Quart)
	-- rotating god rays
	local rays = {}
	for i = 1, (if tier.slow then 8 else 5) do
		local r = keep(part({ Color = if tier.rainbow then CONFETTI[(i % 5) + 1] else (i % 2 == 0 and c2 or c1), Transparency = 1, Size = Vector3.new(0.4, 40, 0.4) }))
		table.insert(rays, { p = r, a = i / 8 * math.pi * 2 })
		tw(r, 0.6, { Transparency = 0.45 })
	end
	local rayT = 0
	local rayConn = RunService.RenderStepped:Connect(function(dt)
		rayT += dt * speed
		for _, r in rays do
			local a = r.a + rayT * 1.6
			r.p.CFrame = CFrame.new(base.Position + Vector3.new(0, 3 + lift, 0)) * CFrame.Angles(0, a, math.rad(62)) * CFrame.new(0, 20, 0)
		end
	end)
	local suck = keep(part({ Shape = Enum.PartType.Ball, Size = Vector3.new(16, 16, 16), Transparency = 1 }))
	suck.CFrame = CFrame.new(base.Position + Vector3.new(0, 3 + lift, 0))
	local inward = fx(suck, {
		Rate = 160, Lifetime = NumberRange.new(0.35), Speed = NumberRange.new(-26), Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface, ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward,
		Size = NumberSequence.new(0.4, 0.05), Color = if tier.rainbow then RAINBOW else ColorSequence.new(Color3.new(1, 1, 1), c1),
	})
	inward.Enabled = true
	sound("JackhammerStart", 0.35, 1.6)
	if mine then
		orbit = if tier.slow then 0.5 else 0.25
		tw(cam, 1.2, { FieldOfView = 54 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	for i = 1, (if rarity == "RARE" then 6 else 12) do
		shake = 0.05 + i * 0.03
		wob = math.rad(10 + i * 2)
		hop = i * 0.03
		wait_(0.1)
	end

	------------------------------------------------------------ slow motion (Legendary)
	if tier.slow then
		speed = 0.22
		for _, e in emitters do if e.Parent then e.TimeScale = 0.25 end end
		sound("CountdownTick", 1, 0.5)
		if mine and cc then tw(cc, 0.3, { Saturation = -0.4 }) end
		wait_(0.18) -- ~0.8 s of real time
	end

	------------------------------------------------------------ BURST
	inward.Enabled = false
	leak.Enabled = false
	crackConn:Disconnect()
	for _, c in cracks do c.p.Transparency = 1 end
	egg.Transparency = 1
	hl.Enabled = false
	ring.Transparency = 1
	tw(spot, 0.4, { Brightness = 0 })
	tw(cone, 0.4, { Transparency = 1 })
	sound("PressImpact", 1, 0.8)
	sound("GeodeReveal", 1, 1)
	-- stop orbiting and swing back to face the pet's landing spot
	orbit = 0
	task.spawn(function()
		local a0 = orbitAng
		for k = 1, 30 do
			orbitAng = a0 * (1 - k / 30)
			task.wait()
		end
		orbitAng = 0
	end)
	if mine then
		cam.FieldOfView = 82 -- the slam
		tw(cam, 0.9, { FieldOfView = 62 }, Enum.EasingStyle.Back)
		task.spawn(function() -- shake curve: hard hit, decaying
			for i = 1, 40 do
				shake = 1.4 * math.exp(-i * 0.12)
				task.wait()
			end
			shake = 0
		end)
		local flashGui = keep(Instance.new("ScreenGui"))
		flashGui.IgnoreGuiInset = true
		flashGui.DisplayOrder = 50
		local flash = Instance.new("Frame", flashGui)
		flash.Size = UDim2.fromScale(1, 1)
		flash.BorderSizePixel = 0
		flash.BackgroundColor3 = Color3.new(1, 1, 1)
		flashGui.Parent = player.PlayerGui
		task.spawn(function() -- chromatic-style colour pop: white, rarity colour, gone
			flash.BackgroundTransparency = 0.3
			task.wait(0.06)
			flash.BackgroundColor3 = c1
			flash.BackgroundTransparency = 0.35
			TweenService:Create(flash, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
		end)
		if cc then
			cc.Brightness = 0.15
			cc.TintColor = c1:Lerp(Color3.new(1, 1, 1), 0.3)
			cc.Saturation = 0.5
			tw(cc, 0.7, { Brightness = -0.12, Contrast = 0.22, TintColor = Color3.new(1, 1, 1), Saturation = 0.2 })
		end
		if bloom then
			bloom.Intensity = 1.4
			tw(bloom, 0.5, { Intensity = 0 })
		end
	end
	light.Brightness = 8
	light.Range = 30
	tw(light, 1.2, { Brightness = 0.5, Range = 10 })
	if tier.slow then
		-- the lobby-wide beam stays up, thin, so everyone in the lobby sees a Legendary was hatched
		tw(beam, 0.5, { Transparency = 0.55, Size = Vector3.new(beamH, 2.2, 2.2) })
		tw(beamCore, 0.5, { Transparency = 0.6, Size = Vector3.new(beamH, 0.5, 0.5) })
		task.delay(5, function()
			if beam.Parent then
				tw(beam, 1.5, { Transparency = 1 })
				tw(beamCore, 1.5, { Transparency = 1 })
			end
		end)
	else
		tw(beam, 0.6, { Transparency = 1 })
		tw(beamCore, 0.4, { Transparency = 1 })
	end
	for _, r in rays do tw(r.p, 0.8, { Transparency = 1 }) end

	-- exploding sphere + rings
	-- the blast stays smaller than the camera distance so it never swallows the screen
	local blast = keep(part({ Shape = Enum.PartType.Ball, Color = c1, Size = Vector3.new(2, 2, 2), Transparency = 0.15 }))
	blast.CFrame = CFrame.new(base.Position + Vector3.new(0, 3 + lift, 0))
	tw(blast, 0.45, { Size = Vector3.new(16, 16, 16), Transparency = 1 }, Enum.EasingStyle.Quart)
	local blast2 = keep(part({ Shape = Enum.PartType.Ball, Color = Color3.new(1, 1, 1), Size = Vector3.new(1, 1, 1), Transparency = 0.2, Material = Enum.Material.ForceField }))
	blast2.CFrame = blast.CFrame
	tw(blast2, 0.8, { Size = Vector3.new(22, 22, 22), Transparency = 1 }, Enum.EasingStyle.Quart)
	shockwave(Color3.new(1, 1, 1), 46, 0.9, 0.2)
	shockwave(c1, 64, 1.2, 0.35)
	shockwave(c2, 84, 1.5, 0.5)
	if tier.slow then shockwave(Color3.fromRGB(255, 90, 220), 110, 1.9, 0.65) end

	local boom = keep(Instance.new("Attachment"))
	boom.Parent = workspace.Terrain
	boom.WorldPosition = base.Position + Vector3.new(0, 3.5 + lift, 0)
	local stars = fx(boom, {
		Lifetime = NumberRange.new(0.8, 1.7), Speed = NumberRange.new(28, 50), SpreadAngle = Vector2.new(180, 180),
		Drag = 3, Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) }),
		Color = if tier.rainbow then RAINBOW else ColorSequence.new(c1, c2), RotSpeed = NumberRange.new(-200, 200),
	})
	stars:Emit(if tier.slow then 140 else 80)
	for _, col in CONFETTI do
		local conf = fx(boom, {
			Texture = "rbxasset://textures/particles/fire_main.dds", LightEmission = 0.2,
			Lifetime = NumberRange.new(2.2, 3.4), Speed = NumberRange.new(30, 52), SpreadAngle = Vector2.new(70, 70),
			EmissionDirection = Enum.NormalId.Top, Acceleration = Vector3.new(0, -28, 0), Drag = 1.2,
			Size = NumberSequence.new(0.45), Color = ColorSequence.new(col), Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-400, 400), Squash = NumberSequence.new(-1.2),
		})
		conf:Emit(if tier.slow then 40 else 24)
	end
	if tier.slow then
		for _, e in emitters do if e.Parent then e.TimeScale = 0.25 end end
	end

	-- shell chunks + coin fountain: hand-animated so slow motion works on them too
	local flyers = {}
	for i = 1, tier.chunks do
		local kit = ReplicatedStorage:FindFirstChild("EggKitMeshes")
		local srcPart = kit and kit:FindFirstChild(if i % 3 == 0 then "Shard" else "Shell_Out")
		local s
		if srcPart and srcPart:IsA("BasePart") then
			s = keep(srcPart:Clone())
		else
			s = keep(Instance.new("WedgePart"))
			s.Size = Vector3.new(0.5, 1.2, 1.2)
		end
		s.Size = s.Size * ((math.random() * 0.7 + 1.0) / s.Size.Magnitude * 1.8)
		s.Color = (i % 4 == 0) and c1 or Color3.fromRGB(250, 246, 236)
		s.Material = Enum.Material.SmoothPlastic
		s.Anchored = true
		s.CanCollide = false
		s.CanQuery = false
		s.Parent = workspace
		local a = math.random() * math.pi * 2
		table.insert(flyers, {
			p = s, pos = base.Position + Vector3.new(0, 3 + lift, 0),
			vel = Vector3.new(math.cos(a) * (12 + math.random() * 18), 18 + math.random() * 20, math.sin(a) * (12 + math.random() * 18)),
			rot = CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6),
			spinv = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 14, bounces = 0,
		})
	end
	for i = 1, tier.coins do
		local cpart = keep(part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.18, 0.9, 0.9), Color = Color3.fromRGB(255, 205, 50), Material = Enum.Material.Neon }))
		local a = math.random() * math.pi * 2
		table.insert(flyers, {
			p = cpart, pos = base.Position + Vector3.new(0, 3 + lift, 0), coin = true,
			vel = Vector3.new(math.cos(a) * (4 + math.random() * 9), 30 + math.random() * 22, math.sin(a) * (4 + math.random() * 9)),
			rot = CFrame.Angles(0, a, 0), spinv = Vector3.new(0, 0, 12), bounces = 0,
		})
	end
	local groundY = base.Position.Y - 1.4
	local flyConn = RunService.RenderStepped:Connect(function(dt)
		dt *= speed
		for _, f in flyers do
			if f.p.Parent then
				f.vel += Vector3.new(0, -62 * dt, 0)
				f.pos += f.vel * dt
				if f.pos.Y < groundY + 0.3 and f.vel.Y < 0 then
					f.pos = Vector3.new(f.pos.X, groundY + 0.3, f.pos.Z)
					f.bounces += 1
					f.vel = Vector3.new(f.vel.X * 0.55, -f.vel.Y * 0.38, f.vel.Z * 0.55)
					if f.coin and f.bounces == 1 and math.random() < 0.3 then sound("Pickup", 0.25, 1 + math.random() * 0.4, f.p) end
				end
				f.rot *= CFrame.Angles(f.spinv.X * dt, f.spinv.Y * dt, f.spinv.Z * dt)
				f.p.CFrame = CFrame.new(f.pos) * f.rot
			end
		end
	end)
	task.delay(4.5, function()
		for _, f in flyers do if f.p.Parent then tw(f.p, 0.5, { Transparency = 1 }) end end
	end)

	if tier.slow then
		wait_(0.35) -- savour the blast in slow motion
		speed = 1
		for _, e in emitters do if e.Parent then e.TimeScale = 1 end end
		if mine and cc then tw(cc, 0.4, { Saturation = 0.15 }) end
	end
	swirlConn:Disconnect()
	for _, s in swirl do s.a:Destroy() end
	eggConn:Disconnect()
	spinUp:Disconnect()

	------------------------------------------------------------ reveal: silhouette, flash to colour, squash landing
	-- the place's hand-made pet model when it has one (ReplicatedStorage.PetModels), else the game's own pet model
	local models = ReplicatedStorage:FindFirstChild("PetModels")
	local srcPet = models and models:FindFirstChild(petName)
	local pet = srcPet and srcPet:Clone()
	if not pet then
		local okPet, built = pcall(PetModel.build, spec, { NoLight = true })
		if okPet and built then
			pet = built
			pet.WorldPivot = (pet:GetBoundingBox()) -- pivot at the centre, like the PetModels clones the show expects
		end
	end
	if pet then
		for _, d in pet:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
			elseif d:IsA("Script") or d:IsA("LocalScript") then
				d:Destroy()
			end
		end
		local _, sz = pet:GetBoundingBox()
		local target = 7 / math.max(sz.X, sz.Y, sz.Z)
		local baseScale = pet:GetScale() * target
		pet:ScaleTo(baseScale)
		pet.Parent = workspace
		keep(pet)
		local restY = (sz.Y * target) / 2 + 0.4
		local faceCam = Vector3.new(camPos.X, base.Position.Y, camPos.Z)
		local look = CFrame.lookAt(base.Position, faceCam)
		local sil = Instance.new("Highlight")
		sil.FillColor = Color3.new(0, 0, 0)
		sil.FillTransparency = 0
		sil.OutlineColor = c1
		sil.OutlineTransparency = 0
		sil.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		sil.Parent = pet
		-- silhouette hovers and turns, mystery moment
		local hoverY = restY + 3.5
		local st0 = os.clock()
		local silDur = tier.silhouette
		while os.clock() - st0 < silDur do
			local t = os.clock() - st0
			pet:ScaleTo(baseScale * math.min(1, 0.2 + t / silDur * 1.2))
			pet:PivotTo(CFrame.new(base.Position + Vector3.new(0, hoverY + math.sin(t * 6) * 0.3, 0)) * (look - look.Position) * CFrame.Angles(0, t * 9, 0))
			task.wait()
		end
		-- flash to full colour
		sound("RarityAccent", 1, 1)
		if tier.beam >= 90 then sound("HatchSparkle", 0.8, 1) end -- EPIC and LEGENDARY: sparkle swell (pets never roar)
		if tier.slow then sound("HatchDrum", 0.85, 1); sound("MatchWin", 0.9, 1) end -- LEGENDARY: drum hit + jingle
		sil.FillColor = Color3.new(1, 1, 1)
		sil.FillTransparency = 0
		TweenService:Create(sil, TweenInfo.new(0.45), { FillTransparency = 1 }):Play()
		task.delay(0.5, function()
			sil.DepthMode = Enum.HighlightDepthMode.Occluded
			sil.OutlineColor = Color3.fromRGB(35, 20, 50) -- dark rim so the pet pops off the bright ground
		end)
		local disc = keep(part({ Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(40, 30, 70), Material = Enum.Material.SmoothPlastic, Transparency = 1, Size = Vector3.new(0.1, 7, 7) }))
		disc.CFrame = CFrame.new(base.Position + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, 0, math.rad(90))
		tw(disc, 0.4, { Transparency = 0.25 })
		local conf2 = fx(boom, {
			Texture = "rbxasset://textures/particles/fire_main.dds", LightEmission = 0.3,
			Lifetime = NumberRange.new(1.4, 2.2), Speed = NumberRange.new(18, 30), SpreadAngle = Vector2.new(80, 80),
			EmissionDirection = Enum.NormalId.Top, Acceleration = Vector3.new(0, -24, 0), Drag = 1,
			Size = NumberSequence.new(0.4), Color = if tier.rainbow then RAINBOW else ColorSequence.new(c1, c2),
			Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-300, 300), Squash = NumberSequence.new(-1.2),
		})
		conf2:Emit(if tier.slow then 90 elseif rarity == "EPIC" then 60 else 30)
		local pop = fx(boom, {
			Lifetime = NumberRange.new(0.5, 1), Speed = NumberRange.new(12, 22), SpreadAngle = Vector2.new(180, 180), Drag = 4,
			Size = NumberSequence.new(1, 0), Color = if tier.rainbow then RAINBOW else ColorSequence.new(Color3.new(1, 1, 1), c1),
		})
		boom.WorldPosition = base.Position + Vector3.new(0, hoverY, 0)
		pop:Emit(60)
		if mine and cc then
			cc.Brightness = 0.1
			tw(cc, 0.5, { Brightness = -0.1 })
		end
		-- drop + squash-and-stretch landing (uniform scale pulses + a dip)
		local d0 = os.clock()
		local landed = false
		local auraA = keep(Instance.new("Attachment"))
		auraA.Parent = workspace.Terrain
		auraA.WorldPosition = base.Position + Vector3.new(0, 0.6, 0)
		local aura = fx(auraA, {
			Rate = if tier.slow then 50 else 30, Lifetime = NumberRange.new(0.9, 1.5), Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(25, 25), EmissionDirection = Enum.NormalId.Top,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) }),
			Color = if tier.rainbow then RAINBOW else ColorSequence.new(c1, c2), Shape = Enum.ParticleEmitterShape.Cylinder,
		})
		aura.Enabled = true
		local auraRing = keep(part({ Shape = Enum.PartType.Cylinder, Color = c1, Transparency = 0.4, Size = Vector3.new(0.15, 9, 9) }))
		auraRing.CFrame = CFrame.new(base.Position + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))
		local petLight = Instance.new("PointLight")
		petLight.Color = c1
		petLight.Range = 14
		petLight.Brightness = 1.2
		local pp = pet.PrimaryPart or pet:FindFirstChildWhichIsA("BasePart", true)
		if pp then petLight.Parent = pp end
		local popConn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - d0
			local h, s
			if t < 0.32 then -- falling, stretched
				local x = t / 0.32
				h = hoverY - (hoverY - restY) * x * x
				s = 1.08
			elseif t < 0.5 then -- squash on impact
				local x = (t - 0.32) / 0.18
				h = restY - 0.5 * math.sin(x * math.pi)
				s = 1 - 0.14 * math.sin(x * math.pi)
				if not landed then
					landed = true
					shockwave(c1, 18, 0.6, 0.2)
					sound("HammerHit2", 0.6, 0.8)
				end
			elseif t < 0.85 then -- bounce up, stretched
				local x = (t - 0.5) / 0.35
				h = restY + 1.8 * math.sin(x * math.pi)
				s = 1 + 0.08 * math.sin(x * math.pi)
			else -- settle with a happy idle bob
				h = restY + 0.18 * math.sin((t - 0.85) * 3)
				s = 1 + 0.03 * math.sin((t - 0.85) * 14) * math.exp(-(t - 0.85) * 3)
			end
			pet:ScaleTo(baseScale * s)
			local turn = math.max(0, 1 - t / 1.2)
			pet:PivotTo(CFrame.new(base.Position + Vector3.new(0, h, 0)) * (look - look.Position) * CFrame.Angles(0, turn * turn * math.pi * 2, 0))
			auraRing.CFrame = CFrame.new(base.Position + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, t * 0.8, 0) * CFrame.Angles(0, 0, math.rad(90))
		end)
		local bannerGui
		if mine then
			bannerGui = keep((bigBanner(GeodeGen.displayName(spec :: any), rarity, tier)))
		end
		wait_(if tier.slow then 4.2 elseif rarity == "EPIC" then 3.4 else 2.4)
		-- fade out the pet with a sparkle puff
		aura.Enabled = false
		popConn:Disconnect()
		if bannerGui then
			local holder = bannerGui:FindFirstChildOfClass("Frame")
			if holder then
				TweenService:Create(holder, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Position = UDim2.fromScale(1.6, 0.06) }):Play()
			end
		end
		local endPivot = pet:GetPivot()
		local s0 = os.clock()
		while os.clock() - s0 < 0.45 do
			local x = (os.clock() - s0) / 0.45
			pet:ScaleTo(baseScale * math.max(0.02, 1 - x * x))
			pet:PivotTo(endPivot * CFrame.Angles(0, x * 6, 0) + Vector3.new(0, x * 3, 0))
			task.wait()
		end
		boom.WorldPosition = endPivot.Position + Vector3.new(0, 3, 0)
		stars:Emit(30)
		pet:Destroy()
		tw(auraRing, 0.5, { Transparency = 1 })
	else
		wait_(4)
	end

	------------------------------------------------------------ restore
	flyConn:Disconnect()
	rayConn:Disconnect()
	tw(spot, 0.2, { Brightness = 0 })
	if mine then
		orbit = 0
		if cc then tw(cc, 0.9, { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = Color3.new(1, 1, 1) }) end
		if bloom then tw(bloom, 0.9, { Intensity = 0 }) end
		if dof then tw(dof, 0.9, { FarIntensity = 0 }) end
		if camConn then camConn:Disconnect() end
		tw(cam, 1.0, { CFrame = from, FieldOfView = oldFov }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		wait_(1.05)
		cam.CameraType = Enum.CameraType.Custom
		cam:SetAttribute("CT_Cinematic", nil)
		for _, x in trash do
			if typeof(x) == "RBXScriptConnection" then x:Disconnect() elseif type(x) == "function" then x() end
		end
		for _, gg in hidden do
			if gg.Parent then gg.Enabled = true end
		end
	end
	CameraMode.cinematic("HatchShow", false)
	wait_(0.2)
	for _, x in trash do
		if typeof(x) == "Instance" and x.Parent then x:Destroy() end
	end
	speed = 1
	playing = false
end

function HatchShow.playing(): boolean
	return playing
end

-- Plays the show on `eggPart` (standing on a pedestal: its bottom is where the pet lands) for pet record `petSpec`
-- (GeodeGen.public). `ringPart` hides during the burst. `onDone` runs after the camera is back. One show at a time.
function HatchShow.play(eggPart: BasePart, petSpec: { [string]: any }, ringPart: BasePart?, onDone: (() -> ())?)
	if playing then
		return
	end
	egg = eggPart
	ring = ringPart or eggPart
	spec = petSpec
	eggHome = egg.CFrame
	eggSize = egg.Size
	base = eggHome * CFrame.new(0, -eggSize.Y / 2, 0)
	local rarity = string.upper(tostring(petSpec.Rarity or "Rare"))
	if not TIERS[rarity] then
		rarity = if rarity == "COMMON" or rarity == "UNCOMMON" then "RARE" else "EPIC"
	end
	CameraMode.cinematic("HatchShow", true)
	task.spawn(function()
		local ok, err = pcall(play, "Pet_" .. tostring(petSpec.Mineral), rarity, player.UserId)
		if not ok then
			warn("[HatchShow] " .. tostring(err))
			playing = false
			speed = 1
			local cam = workspace.CurrentCamera
			cam.CameraType = Enum.CameraType.Custom
			cam:SetAttribute("CT_Cinematic", nil)
			CameraMode.cinematic("HatchShow", false)
			for _, gg in player.PlayerGui:GetChildren() do
				if gg:IsA("ScreenGui") then
					gg.Enabled = true
				end
			end
		end
		if onDone then
			task.spawn(onDone)
		end
	end)
end

return HatchShow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="300">
          <Properties>
            <string name="Name">HatchStandView</string>
            <string name="Source"><![CDATA[--!strict
-- Public hatch stand (owner pick, 2026-10-11): every egg bought in the EGG SHOP is cracked at the stand by the shop for
-- everyone to watch. The server rolls the pet first, then sends HatchShow { Buyer, BuyerId, Egg, Count, Pet } to every
-- client, one show at a time (RobuxService queue). Here: an egg appears over the stand's "HatchPoint", wobbles, pops
-- and the pet rises with a name tag ("<Buyer> hatched a RARE Golden Raptor!"). Cosmetic only; nothing is decided here.
-- The stand is a part with attribute HatchStand = true (built by the park helper); without it nothing is drawn.
-- While a show runs, a local spotlight shines down on the stand and a glowing ring pulses on the ground around it
-- (where the crowd gathers); both fade away with the show. Players right next to it get a small camera shake at the pop.
-- Polish: the egg floats up and spins faster before it cracks; the pet card flips over, its name types in and the
-- rarity stars fill one by one (HatchCard); players nearby get a gentle zoom (field of view) during the reveal, given
-- back exactly afterwards and dropped the moment anything else moves the field of view. Eggs still waiting in the
-- queue (optional show.Waiting count) sit beside the stand rocking gently. Reduce Motion: none of the motion.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local GeodeModel = require(Shared.GeodeModel)
local PetModel = require(Shared.PetModel)
local GeodeGen = require(Shared.GeodeGen)
local PetStatView = require(Shared.PetStatView)
local State = require(script.Parent.State)
local UI = require(script.Parent.ui.UI)
local CameraFx = require(script.Parent.CameraFx)
local HatchCard = require(script.Parent.HatchCard)

local HatchStandView = {}

local WOBBLE, POP, SHOW = 1.6, 0.35, 3.6 -- seconds (the server waits RobuxConfig.Show.Seconds between shows)

local standPart: BasePart? = nil
local FLOAT, SPINS = 1.6, 2.5 -- studs the egg rises and turns it makes before it cracks
local ZOOM, ZOOM_NEAR = 6, 40 -- degrees of field of view taken off; studs from the stand to get the zoom
local zoomToken = 0

local function standPoint(): CFrame?
	local found = standPart
	if not (found and found.Parent and found:GetAttribute("HatchStand") == true) then
		found = nil
		for _, d in Workspace:GetDescendants() do
			if d:IsA("BasePart") and d:GetAttribute("HatchStand") == true then
				found = d
				break
			end
		end
		standPart = found
	end
	local d = found
	if not d then
		return nil
	end
	local a = d:FindFirstChild("HatchPoint")
	if a and a:IsA("Attachment") then
		return CFrame.new(a.WorldPosition)
	end
	return CFrame.new(d.Position + Vector3.new(0, d.Size.Y * 0.5, 0))
end

local RING_SEGMENTS = 18

local function glowPart(parent: Instance, size: Vector3, cf: CFrame, color: Color3): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p:SetAttribute("CameraIgnore", true)
	p.Parent = parent
	return p
end

-- Spotlight from above plus a ring of glowing bars on the ground around the stand. Returns the ring parts (for the
-- pulse) and the light.
local function stage(folder: Instance, at: CFrame, color: Color3): ({ BasePart }, SpotLight?)
	local stand = standPart
	local floorY = if stand then stand.Position.Y - stand.Size.Y * 0.5 + 0.06 else at.Position.Y
	local r = if stand then math.max(stand.Size.X, stand.Size.Z) * 0.5 + 4 else 7
	local c = Vector3.new(at.Position.X, floorY, at.Position.Z)
	local ring: { BasePart } = {}
	local seg = 2 * math.pi * r / RING_SEGMENTS * 0.7
	for i = 1, RING_SEGMENTS do
		local a = (i / RING_SEGMENTS) * 2 * math.pi
		local pos = c + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		local p = glowPart(folder, Vector3.new(seg, 0.12, 0.5), CFrame.lookAt(pos, c), color) -- long side along the circle
		p.Transparency = 1
		table.insert(ring, p)
	end
	local holder = Instance.new("Part")
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Transparency = 1
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.CFrame = CFrame.new(at.Position + Vector3.new(0, 16, 0))
	holder.Parent = folder
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Angle = 45
	light.Range = 24
	light.Brightness = 0
	light.Color = color:Lerp(Color3.new(1, 1, 1), 0.5)
	light.Shadows = false
	light.Parent = holder
	return ring, light
end

-- A gentle zoom for players near the stand: the field of view eases in by ZOOM degrees over `seconds`, then back.
-- Only starts from the normal field of view (no speed boots, no cinematic) and stops at once, without touching the
-- camera again, if anything else writes the field of view meanwhile.
local function zoom(at: Vector3, seconds: number)
	local cam = Workspace.CurrentCamera
	local root = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if UI.Reduced or not cam or not (root and root:IsA("BasePart")) or (root.Position - at).Magnitude > ZOOM_NEAR then
		return
	end
	local base = Config.Camera.Fov
	if cam.CameraType == Enum.CameraType.Scriptable or math.abs(cam.FieldOfView - base) > 0.01 then
		return
	end
	local _, onScreen = cam:WorldToViewportPoint(at)
	if not onScreen then
		return
	end
	zoomToken += 1
	local token = zoomToken
	local name = "CTR_HatchZoom"
	local t0 = os.clock()
	local last = cam.FieldOfView
	pcall(RunService.UnbindFromRenderStep, RunService, name)
	RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 4, function()
		local t = os.clock() - t0
		-- Someone else moving the field of view owns it from then on; any other interruption (a cutscene taking the
		-- camera, a camera swap, a newer zoom) still gives our zoom back (audit 30: it used to stay zoomed in).
		local taken = math.abs(cam.FieldOfView - last) > 0.01
		local stop = taken or token ~= zoomToken or cam ~= Workspace.CurrentCamera or cam.CameraType == Enum.CameraType.Scriptable
		if stop or t >= seconds then
			if token == zoomToken then
				RunService:UnbindFromRenderStep(name)
			end
			if not taken then
				cam.FieldOfView = base
			end
			return
		end
		local back = math.clamp((seconds - t) / 0.7, 0, 1) -- the last 0.7 s ease back out
		local k = math.min(math.clamp(t / (seconds * 0.6), 0, 1), back)
		last = base - ZOOM * (0.5 - 0.5 * math.cos(k * math.pi))
		cam.FieldOfView = last
	end)
end

-- Eggs still waiting their turn sit in a short row beside the stand and rock gently (all alike, bought eggs only).
local function waiting(folder: Instance, at: CFrame, count: number, lowFx: boolean): { Model }
	local n = math.min(count, if lowFx then 2 else 4)
	local stand = standPart
	local floorY = if stand then stand.Position.Y - stand.Size.Y * 0.5 else at.Position.Y
	local off = if stand then math.max(stand.Size.X, stand.Size.Z) * 0.5 + 2 else 5
	local eggs: { Model } = {}
	for i = 1, n do
		local ok, egg = pcall(GeodeModel.rockShell, i, 1.8, "WaitingEgg", {})
		if ok and egg then
			local cf = CFrame.new(at.Position.X + off, floorY + 0.9, at.Position.Z + (i - (n + 1) / 2) * 2.2)
			egg:SetAttribute("Home", cf)
			egg:PivotTo(cf)
			egg.Parent = folder
			table.insert(eggs, egg)
		end
	end
	return eggs
end

local function play(show: any)
	if type(show) ~= "table" or type(show.Pet) ~= "table" or State.Match then
		return -- in a hunt the stand is far away: skip the show
	end
	local at = standPoint()
	if not at then
		return
	end
	local base = (at :: CFrame) * CFrame.new(0, 2.2, 0)
	local folder = Instance.new("Folder")
	folder.Name = "HatchShow"
	folder.Parent = Workspace
	local rarity0 = tostring(show.Pet.Rarity or "Common")
	local lowFx = State.Profile and State.Profile.Settings and State.Profile.Settings.LowEffects == true
	local ring, light = stage(folder, at, (Config.RarityColors :: any)[rarity0] or Color3.fromRGB(255, 214, 120))
	local queued: { Model } = if type(show.Waiting) == "number" and show.Waiting > 0 then waiting(folder, at, show.Waiting, lowFx == true) else {}
	local stageT0 = os.clock()
	local total = WOBBLE + SHOW
	local stageConn: RBXScriptConnection? = nil
	stageConn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - stageT0
		if not folder.Parent or t > total + 3 then
			-- the show ended (or failed part-way): never leave the stage behind
			if stageConn then
				stageConn:Disconnect()
			end
			folder:Destroy()
			return
		end
		local fadeIn = math.min(1, t / 0.4)
		local fadeOut = math.clamp((total - t) / 0.5, 0, 1)
		local k = math.min(fadeIn, fadeOut)
		local pulse = if UI.Reduced or lowFx then 0 else 0.15 * math.sin(t * 5)
		for i, p in ring do
			p.Transparency = 1 - k * (0.55 + pulse * (if i % 2 == 0 then 1 else -1))
		end
		if light then
			light.Brightness = 3 * k
		end
		if not UI.Reduced then
			for i, e in queued do
				local home = e:GetAttribute("Home")
				if typeof(home) == "CFrame" and e.Parent then
					e:PivotTo(home * CFrame.Angles(math.sin(t * 2.4 + i * 1.3) * math.rad(7), 0, 0))
				end
			end
		end
	end)
	local ok, egg = pcall(GeodeModel.rockShell, (tonumber(show.Pet.Seed) or 1) % 8 + 1, 4, "ShowEgg", {})
	if ok and egg then
		egg:PivotTo(base)
		egg.Parent = folder
		local t0 = os.clock()
		while os.clock() - t0 < WOBBLE do
			local t = os.clock() - t0
			local k = t / WOBBLE
			local amp = if UI.Reduced then 0 else math.rad(6 + 14 * k)
			-- floats up and spins faster and faster, then the wobble cracks it
			local rise = if UI.Reduced then 0 else FLOAT * (1 - (1 - k) ^ 2)
			local spin = if UI.Reduced then 0 else SPINS * 2 * math.pi * k * k
			egg:PivotTo(base * CFrame.new(0, rise, 0) * CFrame.Angles(0, spin, 0) * CFrame.Angles(0, 0, math.sin(t * 18) * amp))
			RunService.Heartbeat:Wait()
		end
		egg:Destroy()
	end
	local rarity = tostring(show.Pet.Rarity or "Common")
	local okP, pet = pcall(PetModel.build, show.Pet, { Scale = 1.5, NoLight = false })
	if okP and pet then
		local lp = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if lp and lp:IsA("BasePart") and (lp.Position - at.Position).Magnitude < 30 then
			CameraFx.shake(0.35, 0.3) -- the pop, felt up close only
		end
		local cy = pet:GetAttribute("CentreY")
		local lift = if type(cy) == "number" then cy * 1.5 else 1.8
		pet.Parent = folder
		local head = pet.PrimaryPart or pet:FindFirstChildWhichIsA("BasePart", true)
		local who = tostring(show.Buyer or "Someone")
		local line = who .. " hatched a " .. string.upper(rarity)
			.. (if (tonumber(show.Count) or 1) > 1 then " (" .. show.Count .. " pets)" else "")
		local power = if type(show.Pet) == "table" then PetStatView.power(show.Pet) else nil
		if power then
			line ..= " \u{b7} POWER " .. UI.num(power) -- the one "bigger = better" number (PetStatView)
		end
		if head then
			HatchCard.show(head, line, GeodeGen.displayName(show.Pet) .. "!", rarity, (Config.RarityTextColors :: any)[rarity] or Color3.new(1, 1, 1))
		end
		zoom(at.Position, SHOW)
		local t0 = os.clock()
		while os.clock() - t0 < SHOW and pet.Parent do
			local t = os.clock() - t0
			local rise = math.min(1, t / POP)
			pet:PivotTo(at * CFrame.new(0, lift * rise, 0) * CFrame.Angles(0, if UI.Reduced then 0 else t * 1.6, 0))
			RunService.Heartbeat:Wait()
		end
	end
	if stageConn then
		stageConn:Disconnect()
	end
	folder:Destroy()
end

function HatchStandView.start()
	Net.event("HatchShow").OnClientEvent:Connect(function(show)
		task.spawn(function()
			local ok: boolean, err: any = pcall(play, show)
			if not ok then
				warn("[HatchStandView]", err)
			end
		end)
	end)
end

return HatchStandView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="301">
          <Properties>
            <string name="Name">HiddenEggLocal</string>
            <string name="Source"><![CDATA[--!strict
-- Hides the hidden eggs this player already found (audit F25: a taken egg stayed visible with its "Hidden Egg · Take"
-- prompt). The server keeps the eggs for everyone and publishes the found ones on the player attribute
-- Hangout.Secrets.FoundAttr; this client hides those eggs, their lights, sparkles and Take prompts for this player
-- only. A tap hides the egg at once; if the server did not take it (out of range, too fast) it comes back.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Hangout = require(Shared.Hangout)

local HiddenEggLocal = {}

local player = Players.LocalPlayer
local prompts: { [ProximityPrompt]: string } = {} -- every hidden egg Take prompt -> its egg name
local hidden: { [string]: boolean } = {}
local watchers: { [Instance]: RBXScriptConnection } = {}

-- the egg's own piece: its Model when it has one, else the part the prompt sits on
local function eggRoot(pp: ProximityPrompt): Instance?
	local part = pp.Parent
	if not part then
		return nil
	end
	local model = part:FindFirstAncestorOfClass("Model")
	if model and Hangout.secretIndex(model.Name) then
		return model
	end
	return part
end

local function quiet(d: Instance, off: boolean)
	if d:IsA("BasePart") then
		d.LocalTransparencyModifier = if off then 1 else 0
	elseif d:IsA("ParticleEmitter") or d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("BillboardGui") then
		(d :: any).Enabled = not off
	end
end

local function apply(pp: ProximityPrompt, off: boolean)
	pp.Enabled = not off
	local root = eggRoot(pp)
	if not root then
		return
	end
	quiet(root, off)
	for _, d in root:GetDescendants() do
		if d ~= pp then
			quiet(d, off)
		end
	end
	local w = watchers[root]
	if off and not w then
		-- sparkles and lights added later (HangoutAnim, WorldFx) stay off too
		watchers[root] = root.DescendantAdded:Connect(function(d)
			task.defer(quiet, d, true)
		end)
	elseif not off and w then
		w:Disconnect()
		watchers[root] = nil
	end
end

local function refresh()
	hidden = Hangout.parseFound(player:GetAttribute(Hangout.Secrets.FoundAttr))
	for pp, name in prompts do
		if pp.Parent then
			apply(pp, hidden[name] == true)
		else
			prompts[pp] = nil
		end
	end
end

local function track(d: Instance)
	if not d:IsA("ProximityPrompt") or d:GetAttribute("Hangout") ~= "Secret" then
		return
	end
	local name = d:GetAttribute("Secret")
	if type(name) ~= "string" then
		return
	end
	prompts[d] = name
	if hidden[name] then
		apply(d, true)
	end
end

function HiddenEggLocal.start()
	player:GetAttributeChangedSignal(Hangout.Secrets.FoundAttr):Connect(refresh)
	for _, d in Workspace:GetDescendants() do
		track(d)
	end
	Workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			task.defer(track, d) -- the server sets the Hangout / Secret attributes right after making it
		end
	end)
	refresh()
	ProximityPromptService.PromptTriggered:Connect(function(pp: ProximityPrompt)
		local name = prompts[pp]
		if not name then
			return
		end
		apply(pp, true) -- gone at once: no second tap on a taken egg
		task.delay(2, function()
			if not hidden[name] and pp.Parent then
				apply(pp, false) -- the server did not take it: it comes back
			end
		end)
	end)
end

return HiddenEggLocal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="302">
          <Properties>
            <string name="Name">HitFx</string>
            <string name="Source"><![CDATA[--!strict
-- Contact feedback for manual cracking (presentation only; the server decides every hit).
--  * crack stages: stageOf(progress) gives 0..4; the same neutral dark crack lines for every rock, so
--    the picture says "how far along" and never what the rock is.
--  * contact(): a small dust puff and 2 to 4 chips at the point where the tool met the rock.
--  * dust(): the lighter, rate-limited puff for a jackhammer held on the rock.
--  * split(): a quick break into a few chunks that settle and fade.
--  * poof(): the empty egg's little cloud: a ring of soft puffs that rise and fade (after split()).
--  * feathers(): a few pale flecks that flutter down after poof() (the empty egg's feather dust).
--  * nest(): a straw puff and a few straw bits where an egg lands in the nest (tray or plate).
--  * glowCracks(): the pale crack edges glow softly (StationView pulses them between taps).
--  * trail(): a rate-limited foot puff (speed boots dust trail, EggFx).
--  * bump(): a short camera kick for the local player's own last tap (Humanoid.CameraOffset, back to rest).
-- Everything comes from fixed pools (no per-hit allocation), one Heartbeat connection that drops itself
-- when nothing is alive, and LowEffects / ReducedMotion settings shrink or skip it. clear() frees all.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)

local HitFx = {}

local MAX_PUFFS, MAX_CHIPS = 12, 18
local CLOUD = Color3.fromRGB(240, 238, 232)
local DUST = Color3.fromRGB(176, 168, 156)
local CHIP = Color3.fromRGB(122, 118, 112)
local CRACK = Color3.fromRGB(24, 25, 29)
local CRACK_EDGE = Color3.fromRGB(206, 202, 192)
local GLOW_DIM = Color3.fromRGB(150, 122, 78)
local GLOW_HOT = Color3.fromRGB(255, 224, 150)
local STRAW = Color3.fromRGB(222, 190, 112)
local FEATHER = Color3.fromRGB(250, 248, 240)
local MAX_FEATHERS = 8

-- progress thresholds for stage 1..4
local STAGES = { 0.001, 0.25, 0.55, 0.8 }

type Fx = { Part: Part, Alive: boolean, T0: number, Dur: number, From: Vector3, Vel: Vector3, Size: number, Spin: Vector3, Kind: number }

local folder: Folder? = nil
local puffs: { Fx } = {}
local chips: { Fx } = {}
local feathers: { Fx } = {}
local conn: RBXScriptConnection? = nil
local lastDust = 0
local bumpToken = 0

local function settings(): any
	return (State.Profile and State.Profile.Settings) or {}
end

local function reduced(): boolean
	return settings().ReducedMotion == true
end

local function low(): boolean
	return settings().LowEffects == true
end

function HitFx.stageOf(progress: number): number
	local s = 0
	for i, t in STAGES do
		if progress >= t then
			s = i
		end
	end
	return s
end

local function ensure(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "CT_Rocks_HitFx"
	f.Parent = Workspace
	folder = f
	table.clear(puffs)
	table.clear(chips)
	table.clear(feathers)
	return f
end

local function newPart(shape: Enum.PartType, color: Color3, mat: Enum.Material): Part
	local p = Instance.new("Part")
	p.Shape = shape
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = mat
	p.Color = color
	p.Transparency = 1
	p.Size = Vector3.one * 0.1
	p.Parent = ensure()
	return p
end

local function take(pool: { Fx }, max: number, kind: number): Fx?
	for _, fx in pool do
		if not fx.Alive then
			return fx
		end
	end
	if #pool >= max then
		return nil
	end
	local part = if kind == 1 then newPart(Enum.PartType.Ball, DUST, Enum.Material.SmoothPlastic) else newPart(Enum.PartType.Block, CHIP, Enum.Material.Slate)
	local fx: Fx = { Part = part, Alive = false, T0 = 0, Dur = 1, From = Vector3.zero, Vel = Vector3.zero, Size = 0.3, Spin = Vector3.zero, Kind = kind }
	table.insert(pool, fx)
	return fx
end

-- Chip colour: the shell of the egg being hit (the nearest model in the nest folder, its biggest part), so the
-- bits match the egg. Falls back to the fixed grey when no egg is near.
local lastEgg = CHIP -- the final split happens after the plate is cleared: reuse the colour of the taps before it
local function eggColor(pos: Vector3): Color3
	local nests = Workspace:FindFirstChild("CT_Rocks_StationFx")
	if not nests then
		return lastEgg
	end
	local best: Model? = nil
	local bestD = 4
	for _, m in nests:GetChildren() do
		if m:IsA("Model") and m:GetAttribute("PlateEgg") then
			local d = (m:GetPivot().Position - pos).Magnitude
			if d < bestD then
				best, bestD = m, d
			end
		end
	end
	if not best then
		return lastEgg
	end
	local big: BasePart? = nil
	local bigV = 0
	for _, d in best:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 0.5 then
			local v = d.Size.X * d.Size.Y * d.Size.Z
			if v > bigV then
				big, bigV = d, v
			end
		end
	end
	if big then
		lastEgg = big.Color
	end
	return lastEgg
end

-- Ballistic height with one small bounce on the surface the chip left (FLOOR below the contact point).
local CHIP_FLOOR = 0.4
local function chipY(y0: number, vy: number, t: number): number
	local g = 18
	local y = y0 + vy * t - 0.5 * g * t * t
	local floorY = y0 - CHIP_FLOOR
	if y >= floorY then
		return y
	end
	local tHit = (vy + math.sqrt(vy * vy + 2 * g * CHIP_FLOOR)) / g
	local vb = (g * tHit - vy) * 0.35 -- bounce speed: a third of the impact
	local t2 = t - tHit
	return math.max(floorY, floorY + vb * t2 - 0.5 * g * t2 * t2)
end

local function step()
	local now = os.clock()
	local any = false
	for _, pool in { puffs, chips, feathers } do
		for _, fx in pool do
			if fx.Alive then
				local k = (now - fx.T0) / fx.Dur
				if k >= 1 or not fx.Part.Parent then
					fx.Alive = false
					fx.Part.Transparency = 1
				else
					any = true
					local t = now - fx.T0
					if fx.Kind == 1 then
						local s = fx.Size * (0.5 + 1.1 * k)
						fx.Part.Size = Vector3.one * s
						fx.Part.Position = fx.From + fx.Vel * t
						fx.Part.Transparency = 0.45 + 0.55 * k
					elseif fx.Kind == 3 then
						-- feather: pops up a little, then drifts down slowly, swaying and rocking
						local sway = math.sin(t * 7 + fx.Spin.Y)
						local y = math.max(fx.From.Y - 0.6, fx.From.Y + fx.Vel.Y * t - 0.9 * t * t)
						local pos = Vector3.new(fx.From.X + fx.Vel.X * t, y, fx.From.Z + fx.Vel.Z * t) + Vector3.new(fx.Spin.X, 0, fx.Spin.Z) * (sway * 0.15)
						fx.Part.CFrame = CFrame.new(pos) * CFrame.Angles(0, fx.Spin.Y + t, sway * 0.6)
						fx.Part.Transparency = math.max(0.1, (k - 0.55) / 0.45)
					else
						-- ballistic chip, settles on its landing height and fades
						local pos = Vector3.new(fx.From.X + fx.Vel.X * t, chipY(fx.From.Y, fx.Vel.Y, t), fx.From.Z + fx.Vel.Z * t)
						fx.Part.CFrame = CFrame.new(pos) * CFrame.Angles(fx.Spin.X * t, fx.Spin.Y * t, fx.Spin.Z * t)
						fx.Part.Transparency = math.max(0, (k - 0.6) / 0.4)
					end
				end
			end
		end
	end
	if not any and conn then
		conn:Disconnect()
		conn = nil
	end
end

local function wake()
	if not conn then
		conn = RunService.Heartbeat:Connect(step)
	end
end

local rng = Random.new(7)

local function puff(pos: Vector3, size: number, lift: number, dur: number, color: Color3?, drift: Vector3?)
	local fx = take(puffs, MAX_PUFFS, 1)
	if not fx then
		return
	end
	fx.Alive, fx.T0, fx.Dur, fx.From, fx.Size = true, os.clock(), dur, pos, size
	fx.Part.Color = color or DUST
	fx.Vel = (drift or Vector3.zero) + Vector3.new(rng:NextNumber(-0.25, 0.25), lift, rng:NextNumber(-0.25, 0.25))
	fx.Part.Size = Vector3.one * size * 0.5
	fx.Part.Position = pos
	fx.Part.Transparency = 0.45
	wake()
end

-- One tool contact at `pos` (world), `strong` for the heavier hammer.
function HitFx.contact(pos: Vector3, strong: boolean?)
	if reduced() then
		puff(pos, 0.4, 0.2, 0.3)
		return
	end
	puff(pos, if strong then 1.1 else 0.9, 0.7, 0.5)
	local n = if low() then 2 else (if strong then 4 else 3)
	local col = eggColor(pos)
	for _ = 1, n do
		local fx = take(chips, MAX_CHIPS, 2)
		if not fx then
			break
		end
		local a = rng:NextNumber(0, math.pi * 2)
		local sp = rng:NextNumber(1.6, 3.2)
		fx.Alive, fx.T0, fx.Dur, fx.From = true, os.clock(), rng:NextNumber(0.35, 0.5), pos
		fx.Vel = Vector3.new(math.cos(a) * sp, rng:NextNumber(2.2, 3.6), math.sin(a) * sp)
		fx.Spin = Vector3.new(rng:NextNumber(-9, 9), rng:NextNumber(-9, 9), rng:NextNumber(-9, 9))
		fx.Part.Size = Vector3.new(0.14, 0.1, 0.12) * rng:NextNumber(0.8, 1.5)
		fx.Part.Color = col
		fx.Part.Transparency = 0
		fx.Part.Position = pos
	end
	wake()
end

-- Light contact dust for a jackhammer held on the rock: at most ~7 a second.
function HitFx.dust(pos: Vector3)
	local now = os.clock()
	if now - lastDust < 0.14 or reduced() then
		return
	end
	lastDust = now
	puff(pos, 0.5, 0.45, 0.4)
end

-- Quick break: a few chunks fly out a little, settle and fade; plus one bigger puff.
function HitFx.split(pos: Vector3)
	puff(pos, 1.5, 0.6, 0.6)
	local n = if reduced() then 0 elseif low() then 3 else 5
	local col = eggColor(pos)
	for _ = 1, n do
		local fx = take(chips, MAX_CHIPS, 2)
		if not fx then
			break
		end
		local a = rng:NextNumber(0, math.pi * 2)
		local sp = rng:NextNumber(1, 2.2)
		fx.Alive, fx.T0, fx.Dur, fx.From = true, os.clock(), 0.55, pos
		fx.Vel = Vector3.new(math.cos(a) * sp, rng:NextNumber(1.6, 2.6), math.sin(a) * sp)
		fx.Spin = Vector3.new(rng:NextNumber(-6, 6), rng:NextNumber(-6, 6), rng:NextNumber(-6, 6))
		fx.Part.Size = Vector3.new(0.26, 0.2, 0.24) * rng:NextNumber(0.8, 1.3)
		fx.Part.Color = col
		fx.Part.Transparency = 0
		fx.Part.Position = pos
	end
	wake()
end

-- The empty egg's little cloud: a soft pale ring that swells outward and drifts up, then fades.
function HitFx.poof(pos: Vector3)
	if reduced() then
		return
	end
	local n = if low() then 3 else 5
	local a0 = rng:NextNumber(0, math.pi * 2)
	for i = 1, n do
		local a = a0 + (i / n) * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		puff(pos + dir * 0.25 + Vector3.new(0, 0.15, 0), rng:NextNumber(0.8, 1.05), 0.9, 0.75, CLOUD, dir * 0.9)
	end
	HitFx.feathers(pos)
end

-- Feather dust: a few small pale flecks pop out of the cloud and flutter down (none with Reduced Motion).
function HitFx.feathers(pos: Vector3)
	if reduced() then
		return
	end
	for _ = 1, if low() then 2 else 4 do
		local fx = take(feathers, MAX_FEATHERS, 3)
		if not fx then
			break
		end
		local a = rng:NextNumber(0, math.pi * 2)
		local sp = rng:NextNumber(0.4, 0.9)
		fx.Alive, fx.T0, fx.Dur, fx.From = true, os.clock(), rng:NextNumber(1, 1.3), pos + Vector3.new(0, 0.3, 0)
		fx.Vel = Vector3.new(math.cos(a) * sp, rng:NextNumber(1, 1.5), math.sin(a) * sp)
		fx.Spin = Vector3.new(math.sin(a), rng:NextNumber(0, math.pi * 2), -math.cos(a)) -- sway axis (x, z) and phase (y)
		fx.Part.Size = Vector3.new(0.17, 0.02, 0.07) * rng:NextNumber(0.85, 1.2)
		fx.Part.Color = FEATHER
		fx.Part.Material = Enum.Material.SmoothPlastic
		fx.Part.Transparency = 0.1
		fx.Part.Position = fx.From
	end
	wake()
end

-- An egg lands in the nest (tray slot or plate): a small straw-coloured puff and a few straw bits.
-- `big` for the plate (the egg drops onto it); the tray gets a lighter one.
function HitFx.nest(pos: Vector3, big: boolean?)
	if reduced() then
		return
	end
	puff(pos, if big then 0.8 else 0.55, 0.35, 0.45, STRAW)
	local n = if low() then 0 elseif big then 4 else 2
	for _ = 1, n do
		local fx = take(chips, MAX_CHIPS, 2)
		if not fx then
			break
		end
		local a = rng:NextNumber(0, math.pi * 2)
		local sp = rng:NextNumber(0.8, 1.6)
		fx.Alive, fx.T0, fx.Dur, fx.From = true, os.clock(), rng:NextNumber(0.35, 0.45), pos
		fx.Vel = Vector3.new(math.cos(a) * sp, rng:NextNumber(1.6, 2.4), math.sin(a) * sp)
		fx.Spin = Vector3.new(rng:NextNumber(-8, 8), rng:NextNumber(-8, 8), rng:NextNumber(-8, 8))
		fx.Part.Size = Vector3.new(0.24, 0.04, 0.05) * rng:NextNumber(0.8, 1.3)
		fx.Part.Color = STRAW
		fx.Part.Transparency = 0
		fx.Part.Position = pos
	end
	wake()
end

-- Speed boots: a small dust puff at the feet (the caller paces it per avatar; the shared pool caps the total).
function HitFx.trail(pos: Vector3)
	if reduced() then
		return
	end
	puff(pos, if low() then 0.45 else 0.6, 0.35, 0.45)
end

-- A short camera kick (studs, mostly down) for the local player's own big moment. Off with Reduced Motion.
-- Uses the Humanoid's CameraOffset, which nothing else in the game sets, and always ends back at zero.
function HitFx.bump(strength: number)
	if reduced() then
		return
	end
	local char = game:GetService("Players").LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	bumpToken += 1
	local my = bumpToken
	local t0 = os.clock()
	local c: RBXScriptConnection? = nil
	c = RunService.RenderStepped:Connect(function()
		local k = (os.clock() - t0) / 0.22
		if my ~= bumpToken or k >= 1 or not hum.Parent then
			if c then
				c:Disconnect()
			end
			if my == bumpToken and hum.Parent then
				hum.CameraOffset = Vector3.zero
			end
			return
		end
		local a = math.sin(k * math.pi * 3) * (1 - k) * strength
		hum.CameraOffset = Vector3.new(a * 0.35, -math.abs(a), 0)
	end)
end

-- Crack lines on a plate rock -----------------------------------------------------------------------
-- Lines are listed per stage as { direction on the rock (unit, local), spin, length fraction }. Every
-- rock gets the same set, laid on a sphere of 0.5 * size around `centre`, so they read as damage only.
type Line = { Dir: Vector3, Spin: number, Len: number }
local LINES: { [number]: { Line } } = {
	[1] = { { Dir = Vector3.new(0.1, 0.8, -0.6), Spin = 20, Len = 0.45 } },
	[2] = { { Dir = Vector3.new(-0.5, 0.7, -0.5), Spin = -50, Len = 0.4 }, { Dir = Vector3.new(0.5, 0.45, -0.75), Spin = 80, Len = 0.35 } },
	[3] = { { Dir = Vector3.new(0.0, 0.3, -1), Spin = 5, Len = 0.6 }, { Dir = Vector3.new(0.8, 0.5, -0.3), Spin = 35, Len = 0.45 }, { Dir = Vector3.new(-0.8, 0.4, -0.4), Spin = -25, Len = 0.45 } },
	[4] = { { Dir = Vector3.new(0.3, 1, -0.2), Spin = 110, Len = 0.7 }, { Dir = Vector3.new(-0.25, 0.2, -1), Spin = 70, Len = 0.6 }, { Dir = Vector3.new(0.9, 0.1, -0.5), Spin = -70, Len = 0.55 } },
}

export type Cracks = { Parts: { Part }, Edges: { Part }, Stage: number, Glow: number }

function HitFx.newCracks(): Cracks
	return { Parts = {}, Edges = {}, Stage = 0, Glow = 0 }
end

-- Brings the lines up to the stage of `progress` (never fewer lines; they only widen). `frame` is the
-- rock's CFrame (the table frame, so "-Z" points at the player), `size` its diameter, `parent` where
-- the lines live (they die with the rock).
function HitFx.setCracks(c: Cracks, parent: Instance, frame: CFrame, centre: Vector3, size: number, progress: number): { Part }
	local made: { Part } = {}
	local stage = HitFx.stageOf(progress)
	if stage <= c.Stage then
		return made
	end
	-- crack lines are a darker shade of the egg's own colour (the fixed dark grey when no egg is found)
	local egg = eggColor(centre)
	local crackDark = if egg == CHIP then CRACK else egg:Lerp(Color3.new(0, 0, 0), 0.62)
	for s = c.Stage + 1, stage do
		for _, def in LINES[s] do
			local dir = def.Dir.Unit
			local world = frame:VectorToWorldSpace(dir)
			local at = centre + world * (size * 0.64)
			local len = size * def.Len * 0.6
			local w = size * (0.028 + 0.007 * s)
			-- lay it flat on the surface (its up is the surface normal), turned about the normal
			local up = world
			local ref = if math.abs(up.Y) > 0.95 then Vector3.xAxis else Vector3.yAxis
			local right = ref:Cross(up).Unit
			local cf = CFrame.fromMatrix(at, right, up) * CFrame.Angles(0, math.rad(def.Spin), 0)
			-- a dark ribbon with a thinner pale fracture edge on it: reads on dark and on pale rocks alike
			for layer = 1, 2 do
				local p = Instance.new("Part")
				p.Name = "Crack"
				p.Anchored = true
				p.CanCollide = false
				p.CanQuery = false
				p.CanTouch = false
				p.CastShadow = false
				p.Material = Enum.Material.SmoothPlastic
				p.Color = if layer == 1 then crackDark else CRACK_EDGE
				p.Size = if layer == 1 then Vector3.new(len, w, w) else Vector3.new(len * 0.85, w * 0.4, w * 0.4)
				p.CFrame = if layer == 1 then cf else cf * CFrame.new(0, w * 0.35, 0)
				p.Parent = parent
				table.insert(c.Parts, p)
				table.insert(made, p)
				if layer == 2 then
					table.insert(c.Edges, p)
				end
			end
		end
	end
	c.Stage = stage
	return made
end

function HitFx.clearCracks(c: Cracks)
	for _, p in c.Parts do
		p:Destroy()
	end
	table.clear(c.Parts)
	table.clear(c.Edges)
	c.Stage = 0
	c.Glow = 0
end

-- Soft glow on the pale crack edges: level 0 = the plain edge, up to 1 = a warm glow. Same for every egg.
function HitFx.glowCracks(c: Cracks, level: number)
	level = math.clamp(level, 0, 1)
	if level == c.Glow then
		return
	end
	c.Glow = level
	for _, p in c.Edges do
		if level <= 0 then
			p.Material = Enum.Material.SmoothPlastic
			p.Color = CRACK_EDGE
		else
			p.Material = Enum.Material.Neon
			p.Color = GLOW_DIM:Lerp(GLOW_HOT, level)
		end
	end
end

function HitFx.clear()
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if folder then
		folder:Destroy()
	end
	folder = nil
	table.clear(puffs)
	table.clear(chips)
	table.clear(feathers)
end

return HitFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="303">
          <Properties>
            <string name="Name">LobbyAmbience</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby ambience (Master Prompt 8 sections 3-5, 20): a little cheap, purely visual life in the public lobby.
--   * trees sway gently: the canopy parts (Leaf / LeafDark / Leaves) of models the server marked with the
--     attribute Sway rock a degree or two about their SwayPivot (LobbyBuilder / KitPlace.sway);
--   * a waterfall, when the lobby has one (CT_Rocks_Waterfall): its streaks slide down the sheet, the foam breathes;
--   * a few butterflies flutter over the plaza ferns, three birds circle high over the north cliffs;
--   * (plot pets no longer wander: they stand on fixed yard spots, GalleryService, owner 2026-10-14)
--   * fireflies drift along the park edges (Config.Lodge box, inset): a few invisible emitter boxes, soft warm dots;
--     on only while the camera is in the lobby, off with Reduce Motion or Low effects.
-- (The park: src/server/ParkBuilder.luau, layout numbers src/shared/ParkConfig.luau.)
-- Client only (nothing replicates, nothing is authoritative), anchored, non-colliding, CanQuery off,
-- CameraIgnore. One Heartbeat step at 30 Hz, and only while the camera is in the lobby (a hunt arena is far
-- away). Reduced Motion: nothing moves (trees and water at rest, no critters). Low effects: no
-- critters, only every other tree sways. Bounded: at most 40 trees, 6 butterflies, 3 birds,
-- the waterfall's own parts.


local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)
local MapNames = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("MapNames"))
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local LobbyAmbience = {}

local RATE = 1 / 30
local LOBBY_CENTRE = Vector3.new(0, 0, 0)
local NEAR = 320 -- camera within this of the lobby centre = in the lobby
local MAX_TREES = 40
local BUTTERFLIES = 6
local BIRDS = 3
local CANOPY = { Leaf = true, LeafDark = true, Leaves = true }
-- The owner keeps lobby props still (only the portal and water move): trees are collected for their drifting
-- leaves but no longer sway.
local TREE_SWAY = false

type Tree = { Parts: { BasePart }, Base: { CFrame }, Pivot: Vector3, Phase: number, Amp: number, Axis: Vector3 }
type Critter = { Parts: { BasePart }, Kind: string, Home: Vector3, Phase: number, Speed: number, Radius: number }

local trees: { Tree } = {}
local critters: { Critter } = {}
local streaks: { BasePart } = {}
local streakBase: { [BasePart]: CFrame } = {}
local foam: { BasePart } = {}
local folder: Folder? = nil
local acc = 0
local t0 = os.clock()
local atRest = true
local started = false
local parkLobby: Instance? = nil -- the procedural park being animated (collected again when it changes)
local parkDirty = false
local lastCollect = 0

-- the Pet Tower's glowing aura (ParkBuilder buildTower, Blender model TowerAura): looked up every 2 s until found;
-- its glow breathes (a shell with an AuraSpin attribute also turns about the temple's centre)
local towerAura: Model? = nil
local auraShells: { { Part: BasePart, Home: CFrame, Base: number, Dir: number } } = {}
local lastAuraLook = -10

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function decorative(p: BasePart)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p:SetAttribute("CameraIgnore", true)
end

local function mk(parent: Instance, name: string, size: Vector3, color: Color3): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	decorative(p)
	p.Parent = parent
	return p
end

-- Rest CFrame of every animated part, taken the first time it is seen (a streamed-in part arrives at rest; a part
-- already being swayed keeps its first base, so collecting again never drifts).
local baseOf: { [BasePart]: CFrame } = {}
local function baseFor(p: BasePart): CFrame
	local b = baseOf[p]
	if not b then
		b = p.CFrame
		baseOf[p] = b
	end
	return b
end

-- Collect what the server built. Runs again when the lobby changes (StreamingEnabled streams trees and the
-- waterfall in and out by distance), so late parts join and removed ones leave.
local function collect(lobby: Instance)
	table.clear(trees)
	table.clear(streaks)
	table.clear(streakBase)
	table.clear(foam)
	for p in baseOf do
		if not p.Parent then
			baseOf[p] = nil
		end
	end
	local seed = 0
	for _, d in lobby:GetDescendants() do
		if #trees < MAX_TREES and d:IsA("Model") and d:GetAttribute("Sway") == true then
			local pivot = d:GetAttribute("SwayPivot")
			local parts, base = {}, {}
			for _, p in d:GetDescendants() do
				if p:IsA("BasePart") and CANOPY[p.Name] then
					table.insert(parts, p)
					table.insert(base, baseFor(p))
				end
			end
			if #parts > 0 and typeof(pivot) == "Vector3" then
				seed += 1
				local a = seed * 2.399 -- golden angle: every tree leans a slightly different way
				table.insert(trees, {
					Parts = parts,
					Base = base,
					Pivot = pivot,
					Phase = seed * 1.37,
					Amp = math.rad(1.1 + (seed % 3) * 0.25),
					Axis = Vector3.new(math.cos(a), 0, math.sin(a)),
				})
			end
		end
	end
	local fall = lobby:FindFirstChild("CT_Rocks_Waterfall")
	if fall then
		for _, p in fall:GetChildren() do
			if p:IsA("BasePart") and p.Name == "FallStreak" then
				table.insert(streaks, p)
				streakBase[p] = baseFor(p)
			elseif p:IsA("BasePart") and p.Name == "Foam" then
				table.insert(foam, p)
			end
		end
	end
end

-- Butterflies over the planting beds, birds circling high over the north cliffs.
local function spawnCritters(lobby: Instance)
	local f = Instance.new("Folder")
	f.Name = "CT_Rocks_LobbyAmbience"
	f.Parent = Workspace
	folder = f
	-- butterflies flutter over the clearing's corner bushes and the plaza's back corners (ParkBuilder)
	local _ = lobby
	local homes: { Vector3 } = {
		Vector3.new(-32, 0.4, -32), Vector3.new(32, 0.4, 30), Vector3.new(-33, 0.4, 28), Vector3.new(30, 0.4, -32),
		Vector3.new(-34, 0.4, 126), Vector3.new(34, 0.4, 126),
	}
	local wingColours = { Color3.fromRGB(240, 226, 170), Color3.fromRGB(236, 236, 228), Color3.fromRGB(198, 214, 170) }
	for i = 1, BUTTERFLIES do
		local col = wingColours[(i - 1) % #wingColours + 1]
		local parts = {
			mk(f, "Wing", Vector3.new(0.32, 0.03, 0.26), col),
			mk(f, "Wing", Vector3.new(0.32, 0.03, 0.26), col),
			mk(f, "Body", Vector3.new(0.06, 0.06, 0.24), Color3.fromRGB(70, 64, 58)),
		}
		table.insert(critters, { Parts = parts, Kind = "Butterfly", Home = homes[(i - 1) % #homes + 1], Phase = i * 1.9, Speed = 0.5 + (i % 3) * 0.12, Radius = 1.6 + (i % 2) * 0.8 })
	end
	for i = 1, BIRDS do
		local col = Color3.fromRGB(62, 64, 70)
		local parts = {
			mk(f, "Wing", Vector3.new(1.1, 0.06, 0.4), col),
			mk(f, "Wing", Vector3.new(1.1, 0.06, 0.4), col),
			mk(f, "Body", Vector3.new(0.22, 0.2, 0.7), col),
		}
		table.insert(critters, { Parts = parts, Kind = "Bird", Home = Vector3.new(-40 + i * 20, 46 + i * 5, -70 + i * 40), Phase = i * 2.1, Speed = 0.14 + i * 0.02, Radius = 16 + i * 5 })
	end
end

local function hideCritters(hidden: boolean)
	for _, c in critters do
		for _, p in c.Parts do
			p.Transparency = if hidden then 1 else 0
		end
	end
end

local function rest()
	if atRest then
		return
	end
	atRest = true
	for _, tr in trees do
		for i, p in tr.Parts do
			if p.Parent then
				p.CFrame = tr.Base[i]
			end
		end
	end
	for p, cf in streakBase do
		if p.Parent then
			p.CFrame = cf
		end
	end
	hideCritters(true)
end

local moveParts: { BasePart } = {}
local moveCFs: { CFrame } = {}

-- Fireflies at the park edges ----------------------------------------------------------------------------------

local FIREFLY_INSET = 12 -- studs inside the park boundary
local fireflies: { ParticleEmitter } = {}
local firefliesOn = false

local function buildFireflies()
	if #fireflies > 0 then
		return
	end
	local L = Config.Lodge
	local f = Instance.new("Folder")
	f.Name = "CT_Rocks_Fireflies"
	f.Parent = Workspace
	local x0, x1 = L.MinX + FIREFLY_INSET, L.MaxX - FIREFLY_INSET
	local z0, z1 = L.MinZ + FIREFLY_INSET, L.MaxZ - FIREFLY_INSET
	local w, d = x1 - x0, z1 - z0
	-- two boxes per side, low over the ground (each box emits over its whole volume)
	local boxes = {
		{ Vector3.new(x0 + w * 0.25, 2.5, z0), Vector3.new(w * 0.4, 3, 6) },
		{ Vector3.new(x0 + w * 0.75, 2.5, z0), Vector3.new(w * 0.4, 3, 6) },
		{ Vector3.new(x0 + w * 0.25, 2.5, z1), Vector3.new(w * 0.4, 3, 6) },
		{ Vector3.new(x0 + w * 0.75, 2.5, z1), Vector3.new(w * 0.4, 3, 6) },
		{ Vector3.new(x0, 2.5, z0 + d * 0.25), Vector3.new(6, 3, d * 0.4) },
		{ Vector3.new(x0, 2.5, z0 + d * 0.75), Vector3.new(6, 3, d * 0.4) },
		{ Vector3.new(x1, 2.5, z0 + d * 0.25), Vector3.new(6, 3, d * 0.4) },
		{ Vector3.new(x1, 2.5, z0 + d * 0.75), Vector3.new(6, 3, d * 0.4) },
	}
	for i, b in boxes do
		local p = Instance.new("Part")
		p.Name = "FireflyBox"
		p.Size = b[2]
		p.CFrame = CFrame.new(b[1] + Vector3.new(0, Config.Lodge.FloorY, 0))
		p.Transparency = 1
		decorative(p)
		p.Parent = f
		local e = Instance.new("ParticleEmitter")
		e.Name = "Fireflies"
		e.Shape = Enum.ParticleEmitterShape.Box
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		e.Rate = 1.2
		e.Lifetime = NumberRange.new(4, 7)
		e.Speed = NumberRange.new(0.2, 0.7)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Acceleration = Vector3.new(0, 0.08, 0)
		e.RotSpeed = NumberRange.new(-20, 20)
		e.Size = NumberSequence.new(0.22)
		e.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.15, 0.2),
			NumberSequenceKeypoint.new(0.35, 0.7),
			NumberSequenceKeypoint.new(0.55, 0.15),
			NumberSequenceKeypoint.new(0.8, 0.6),
			NumberSequenceKeypoint.new(1, 1),
		})
		e.Color = ColorSequence.new(if i % 2 == 0 then Color3.fromRGB(255, 236, 140) else Color3.fromRGB(214, 255, 150))
		e.LightEmission = 1
		e.LightInfluence = 0
		e.Enabled = false
		e.Parent = p
		table.insert(fireflies, e)
	end
end

local function setFireflies(on: boolean)
	if on == firefliesOn then
		return
	end
	firefliesOn = on
	if on then
		buildFireflies()
	end
	for _, e in fireflies do
		e.Enabled = on
		if not on then
			e:Clear()
		end
	end
end

-- Drifting leaves near a few trees (tiny counts; off with Low effects / Reduced Motion) ---------------------------

local LEAF_TREES = 4
local leafEmitters: { ParticleEmitter } = {}

local function setLeaves(on: boolean)
	for i = #leafEmitters, 1, -1 do
		if not leafEmitters[i].Parent then
			table.remove(leafEmitters, i) -- streamed out
		end
	end
	if on and #leafEmitters < LEAF_TREES then
		for _, tr in trees do
			local part = tr.Parts[1]
			if part and part.Parent and not part:FindFirstChild("DriftLeaves") then
				local e = Instance.new("ParticleEmitter")
				e.Name = "DriftLeaves"
				e.Rate = 0.6
				e.Lifetime = NumberRange.new(6, 9)
				e.Speed = NumberRange.new(0.3, 0.8)
				e.SpreadAngle = Vector2.new(180, 180)
				e.Acceleration = Vector3.new(0.4, -0.7, 0.2)
				e.RotSpeed = NumberRange.new(-60, 60)
				e.Size = NumberSequence.new(0.35)
				e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0.2), NumberSequenceKeypoint.new(0.85, 0.3), NumberSequenceKeypoint.new(1, 1) })
				-- soft green to pale gold, unlit: lit by the warm lobby light they read as red specks (video 2026-10-13)
				e.Color = ColorSequence.new(Color3.fromRGB(168, 214, 110), Color3.fromRGB(236, 214, 120))
				e.LightInfluence = 0
				e.Parent = part
				table.insert(leafEmitters, e)
				if #leafEmitters >= LEAF_TREES then
					break
				end
			end
		end
	end
	for _, e in leafEmitters do
		e.Enabled = on
		if not on then
			e:Clear()
		end
	end
end

-- Own plot: a gold outline on its yard floor (local Highlight, only this player sees it) --------------------------

local plotLight: Highlight? = nil
local function updatePlotOutline()
	local idx = Players.LocalPlayer:GetAttribute("Alcove")
	local a = if type(idx) == "number" then Workspace:FindFirstChild(MapNames.plot(idx), true) else nil
	local floor = a and a:FindFirstChild(MapNames.PlotFloor, true)
	if not (floor and floor:IsA("BasePart")) then
		if plotLight then
			plotLight.Adornee = nil
		end
		return
	end
	if not plotLight then
		local h = Instance.new("Highlight")
		h.Name = "CT_Rocks_OwnPlotOutline"
		h.FillTransparency = 1
		h.OutlineColor = Color3.fromRGB(255, 205, 70)
		h.OutlineTransparency = 0.25
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.Parent = Workspace
		plotLight = h
	end
	if (plotLight :: Highlight).Adornee ~= floor then
		(plotLight :: Highlight).Adornee = floor
	end
end

local function step(dt: number)
	acc += dt
	if acc < RATE then
		return
	end
	acc = 0
	local cam = Workspace.CurrentCamera
	if not cam or (cam.CFrame.Position - LOBBY_CENTRE).Magnitude > NEAR then
		setFireflies(false)
		setLeaves(false)
		return -- in a hunt (the arenas are far from the lobby): nothing to update
	end
	local s = settings()
	setFireflies(s.ReducedMotion ~= true and s.LowEffects ~= true)
	setLeaves(s.ReducedMotion ~= true and s.LowEffects ~= true)
	-- Pet Tower aura: a slow breath of the glow (held steady with Reduced Motion)
	if not (towerAura and towerAura.Parent) and os.clock() - lastAuraLook >= 2 then
		lastAuraLook = os.clock()
		local found = parkLobby and parkLobby:FindFirstChild("TowerAura", true)
		towerAura = if found and found:IsA("Model") then found else nil
		table.clear(auraShells)
		if towerAura then
			for _, d in towerAura:GetDescendants() do
				if d:IsA("BasePart") then
					local base = d:GetAttribute("AuraBase")
					local spin = d:GetAttribute("AuraSpin")
					table.insert(auraShells, { Part = d, Home = d.CFrame, Base = if type(base) == "number" then base else d.Transparency, Dir = if type(spin) == "number" then spin else 0 })
				end
			end
		end
	end
	if towerAura and towerAura.Parent then
		local still = s.ReducedMotion == true
		local now = os.clock()
		local centre = towerAura:GetAttribute("AuraCentre")
		for _, sh in auraShells do
			-- (transparency is left alone: changing it every frame makes see-through layers flicker)
			if sh.Dir ~= 0 and not still and typeof(centre) == "Vector3" then
				local axis = Vector3.new(centre.X, sh.Home.Position.Y, centre.Z)
				local spin = CFrame.new(axis) * CFrame.Angles(0, now * 0.25 * sh.Dir, 0) * CFrame.new(-axis)
				sh.Part.CFrame = spin * sh.Home
			end
		end
	end
	if s.ReducedMotion == true then
		rest()
		return
	end
	local lobby = parkLobby
	if parkDirty and lobby and os.clock() - lastCollect >= 2 then
		parkDirty = false
		lastCollect = os.clock()
		collect(lobby)
	end
	local low = s.LowEffects == true
	if atRest then
		atRest = false
		hideCritters(low)
	end
	local t = os.clock() - t0
	table.clear(moveParts)
	table.clear(moveCFs)
	-- trees: a slow sway plus a faster flutter, about the pivot low on the trunk
	for k, tr in trees do
		if not TREE_SWAY then
			break
		end
		if low and k % 2 == 0 then
			continue
		end
		local a = math.sin(t * 0.9 + tr.Phase) * tr.Amp + math.sin(t * 2.3 + tr.Phase * 1.7) * tr.Amp * 0.3
		local rot = CFrame.new(tr.Pivot) * CFrame.fromAxisAngle(tr.Axis, a) * CFrame.new(-tr.Pivot)
		for i, p in tr.Parts do
			if p.Parent then -- streamed out since the last collect
				table.insert(moveParts, p)
				table.insert(moveCFs, rot * tr.Base[i])
			end
		end
	end
	-- waterfall streaks slide down the sheet and wrap; foam breathes
	for _, p in streaks do
		local base = streakBase[p]
		local top = (p:GetAttribute("Top") or 24) :: number
		local phase = (p:GetAttribute("Phase") or 0) :: number
		local y = top - ((t * 7 + phase * top) % top) -- the fall stands on the ground (y 0 at its foot)
		if p.Parent then
			table.insert(moveParts, p)
			table.insert(moveCFs, CFrame.new(base.Position.X, y - 0.4, base.Position.Z) * base.Rotation)
		end
	end
	for i, p in foam do
		p.Transparency = 0.18 + 0.12 * math.sin(t * 2.6 + i)
	end
	-- critters
	if not low then
		for _, c in critters do
			local u = t * c.Speed + c.Phase
			local pos, dir, flap
			if c.Kind == "Butterfly" then
				pos = c.Home + Vector3.new(math.sin(u * 1.3) * c.Radius, 1.4 + 0.5 * math.sin(u * 2.1) + 0.2 * math.sin(u * 7), math.cos(u * 0.9) * c.Radius * 0.7)
				dir = Vector3.new(math.cos(u * 1.3) * 1.3, 0, -math.sin(u * 0.9) * 0.63)
				flap = math.rad(55) * math.sin(t * 16 + c.Phase)
			else
				pos = c.Home + Vector3.new(math.cos(u) * c.Radius, math.sin(u * 0.5) * 1.2, math.sin(u) * c.Radius)
				dir = Vector3.new(-math.sin(u), 0, math.cos(u))
				flap = math.rad(22) * math.sin(t * 3 + c.Phase)
			end
			if dir.Magnitude < 1e-3 then
				dir = Vector3.zAxis
			end
			local body = CFrame.lookAt(pos, pos + dir.Unit)
			local half = c.Parts[1].Size.X / 2
			table.insert(moveParts, c.Parts[1])
			table.insert(moveCFs, body * CFrame.Angles(0, 0, flap) * CFrame.new(-half, 0, 0))
			table.insert(moveParts, c.Parts[2])
			table.insert(moveCFs, body * CFrame.Angles(0, 0, -flap) * CFrame.new(half, 0, 0))
			table.insert(moveParts, c.Parts[3])
			table.insert(moveCFs, body)
		end
	end
	if #moveParts > 0 then
		Workspace:BulkMoveTo(moveParts, moveCFs, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function LobbyAmbience.start()
	if started then
		return
	end
	started = true
	task.spawn(function()
		-- the procedural fallback park (CT_Rocks_Lobby) or the owner's hand-built lobby (shared/MapNames.Roots)
		local lobby: Instance? = nil
		local hand = false
		local tries = 0
		while true do -- every 0.5 s for a minute, then every 5 s (a streamed lobby can arrive late)
			tries += 1
			lobby = Workspace:FindFirstChild("CT_Rocks_Lobby")
			if lobby then
				break
			end
			local root = MapNames.findRoot(Workspace:GetChildren())
			if root then
				lobby, hand = root, true
				break
			end
			task.wait(if tries <= 120 then 0.5 else 5)
		end
		if not lobby then
			return
		end
		task.wait(0.5) -- the lobby builds in one go on the server; give replication a moment
		if not hand then
			-- sway, waterfall and critters belong to the procedural park; the owner's map is never moved
			collect(lobby)
			lastCollect = os.clock()
			parkLobby = lobby
			local function changed(d: Instance)
				if d:IsA("BasePart") or d:IsA("Model") then
					parkDirty = true
				end
			end
			lobby.DescendantAdded:Connect(changed)
			lobby.DescendantRemoving:Connect(changed)
			spawnCritters(lobby)
			hideCritters(true)
		end
		RunService.Heartbeat:Connect(step)
		task.spawn(function()
			while true do
				updatePlotOutline()
				task.wait(1)
			end
		end)
	end)
end

-- Test / preview hook: counts of what is animated.
function LobbyAmbience.stats(): { [string]: number }
	return { Trees = #trees, Streaks = #streaks, Foam = #foam, Critters = #critters, Folder = if folder then 1 else 0 }
end

return LobbyAmbience
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="304">
          <Properties>
            <string name="Name">LobbyFlyover</string>
            <string name="Source"><![CDATA[--!strict
-- First-join fly-over (client only, cosmetic): a brand-new player (profile onboarding not started yet) gets one
-- slow camera flight around the park before the camera settles behind their avatar. Once per session at most, never
-- during a hunt, never behind an open menu, skipped with Reduce Motion, and any tap / click / key ends it early.
-- A CameraMode cinematic: releasing it hands the camera back to Roblox's own lobby camera.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local MapNames = require(Shared.MapNames)
local State = require(script.Parent.State)
local CameraMode = require(script.Parent.CameraMode)
local UI = require(script.Parent.ui.UI)

local LobbyFlyover = {}

local CINE = "LobbyFlyover"
local SECONDS = 7
local player = Players.LocalPlayer
local done = false

local function smooth(k: number): number
	return k * k * (3 - 2 * k)
end

local function isNew(): boolean
	local p = State.Profile
	if not p or p.OnboardDone == true or type(p.Onboard) ~= "table" then
		return false
	end
	if p.StarterEgg == true then
		return true -- a brand-new player: the short tour (dragon -> arena -> shrine -> their egg) comes first
	end
	return p.Onboard.Started ~= true
end

local function fly()
	local cam = Workspace.CurrentCamera
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not cam or not head or not head:IsA("BasePart") then
		return
	end
	local L = Config.Lodge
	local centre = Vector3.new((L.MinX + L.MaxX) / 2, 0, (L.MinZ + L.MaxZ) / 2)
	local radius = math.min(L.MaxX - L.MinX, L.MaxZ - L.MinZ) * 0.42
	local skip = false
	local conn = UserInputService.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.Gamepad1 then
			skip = true
		end
	end)
	CameraMode.cinematic(CINE, true)
	cam.CameraType = Enum.CameraType.Scriptable
	local function endFrame(): CFrame
		local hp = (head :: BasePart).Position
		local back = -(head :: BasePart).CFrame.LookVector
		back = Vector3.new(back.X, 0, back.Z)
		back = if back.Magnitude > 0.1 then back.Unit else Vector3.zAxis
		return CFrame.lookAt(hp + back * 14 + Vector3.new(0, 5, 0), hp)
	end
	local a0 = math.atan2((head :: BasePart).Position.Z - centre.Z, (head :: BasePart).Position.X - centre.X) + math.pi
	local t0 = os.clock()
	while not skip do
		local k = (os.clock() - t0) / SECONDS
		if k >= 1 or State.Match ~= nil or not head.Parent or UI.blocked() then
			break
		end
		-- 0..0.7: orbit high around the park; 0.7..1: glide down behind the avatar
		local orbitK = math.min(1, k / 0.7)
		local a = a0 + smooth(orbitK) * math.rad(220)
		local orbit = CFrame.lookAt(centre + Vector3.new(math.cos(a) * radius, 48 - 10 * orbitK, math.sin(a) * radius), centre + Vector3.new(0, 4, 0))
		if k > 0.7 then
			orbit = orbit:Lerp(endFrame(), smooth((k - 0.7) / 0.3))
		end
		cam.CFrame = orbit
		RunService.RenderStepped:Wait()
	end
	conn:Disconnect()
	if cam.Parent and head.Parent then
		cam.CFrame = endFrame()
	end
	CameraMode.cinematic(CINE, false)
end

-- The join tour for a brand-new player (owner north star 2026-10-14: hook them on the dream pet at once):
-- the Void Dragon statue ("1 in 1000"), the arena / PLAY portal, the egg shrine, then their own starter egg,
-- TOUR_SECONDS in all, any tap skips. Stops whose piece is not in the map are left out.
local TOUR_SECONDS = 5.5
LobbyFlyover.ArenaNames = { "BattleArena", "Arena", "FightArena", "PvpArena" } -- first match in the lobby map
LobbyFlyover.ShrineNames = { "EggShrine", "Shrine", "EggShop" }

type Stop = { Focus: Vector3, Size: number, Name: string }

local function centreOf(inst: Instance): (Vector3, number)
	if inst:IsA("Model") then
		local cf, size = inst:GetBoundingBox()
		return cf.Position, math.max(size.X, size.Y, size.Z)
	elseif inst:IsA("BasePart") then
		return inst.Position, math.max(inst.Size.X, inst.Size.Y, inst.Size.Z)
	end
	return Vector3.zero, 0
end

local function findFirst(names: { string }): Instance?
	for _, n in names do
		local f = Workspace:FindFirstChild(n, true)
		if f and (f:IsA("Model") or f:IsA("BasePart")) then
			return f
		end
	end
	return nil
end

-- The tour's stops in order (exposed for the preview scene).
function LobbyFlyover.tourStops(): { Stop }
	local stops: { Stop } = {}
	local function add(inst: Instance?, name: string, maxSize: number)
		if inst then
			local c, size = centreOf(inst)
			table.insert(stops, { Focus = c, Size = math.clamp(size, 6, maxSize), Name = name })
		end
	end
	-- the dragon itself (on top of the leaderboard tree), not the statue's bounding box with its tall sky beam
	local statue = Workspace:FindFirstChild("VoidDragonStatue", true)
	add(statue and statue:FindFirstChild("Dragon") or statue, "Dragon", 50)
	local meadow = Workspace:FindFirstChild("LobbyMeadow")
	local arena = meadow and meadow:FindFirstChild("BattleArena") -- the dream lobby's centre Battle Arena first
	add(arena or findFirst(LobbyFlyover.ArenaNames) or Workspace:FindFirstChild(MapNames.queuePad(1), true), "Arena", 60)
	add(findFirst(LobbyFlyover.ShrineNames), "Shrine", 40)
	add(Workspace:FindFirstChild("StarterEgg_Local", true), "Egg", 12)
	return stops
end

local function tour(): boolean
	local cam = Workspace.CurrentCamera
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	local stops = LobbyFlyover.tourStops()
	if not cam or not head or not head:IsA("BasePart") or #stops < 2 then
		return false
	end
	local hp = head.Position
	-- each stop is seen from the spawn's side, a little above, framed by its size
	local shots: { CFrame } = {}
	for _, st in stops do
		local away = Vector3.new(hp.X - st.Focus.X, 0, hp.Z - st.Focus.Z)
		local dir = if away.Magnitude > 1 then away.Unit else Vector3.zAxis
		local dist = st.Size * 1.3 + 8
		table.insert(shots, CFrame.lookAt(st.Focus + dir * dist + Vector3.new(0, st.Size * 0.45 + 4, 0), st.Focus))
	end
	local back = -head.CFrame.LookVector
	back = Vector3.new(back.X, 0, back.Z)
	back = if back.Magnitude > 0.1 then back.Unit else Vector3.zAxis
	table.insert(shots, CFrame.lookAt(hp + back * 14 + Vector3.new(0, 5, 0), hp))
	local skip = false
	local conn = UserInputService.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.Gamepad1 then
			skip = true
		end
	end)
	CameraMode.cinematic(CINE, true)
	cam.CameraType = Enum.CameraType.Scriptable
	local legs = #shots - 1
	local t0 = os.clock()
	cam.CFrame = shots[1]
	while not skip do
		local k = (os.clock() - t0) / TOUR_SECONDS
		if k >= 1 or State.Match ~= nil or not head.Parent or UI.blocked() then
			break
		end
		-- each leg: hold on the stop for a moment, then glide to the next one
		local leg = math.min(legs, math.floor(k * legs) + 1)
		local lk = k * legs - (leg - 1)
		local glide = smooth(math.clamp((lk - 0.35) / 0.65, 0, 1))
		local slowPush = CFrame.new(0, 0, -lk * 2) -- a slow push-in while holding
		cam.CFrame = (shots[leg] * slowPush):Lerp(shots[leg + 1], glide)
		RunService.RenderStepped:Wait()
	end
	conn:Disconnect()
	if cam.Parent then
		cam.CFrame = shots[#shots]
	end
	CameraMode.cinematic(CINE, false)
	return true
end

function LobbyFlyover.start()
	task.spawn(function()
		-- wait for the profile (up to 20 s) and a character
		local t0 = os.clock()
		while not State.Profile and os.clock() - t0 < 20 do
			task.wait(0.25)
		end
		if done or not isNew() then
			return
		end
		local char = player.Character or player.CharacterAdded:Wait()
		char:WaitForChild("Head", 10)
		task.wait(1) -- let the lobby stream in around the spawn
		local w0 = os.clock()
		while UI.blocked() and os.clock() - w0 < 8 do
			task.wait(0.25)
		end
		local p = State.Profile
		local reduced = p and p.Settings and p.Settings.ReducedMotion == true
		if done or UI.blocked() or State.Match ~= nil or CameraMode.inHunt() or reduced or not isNew() then
			return
		end
		done = true
		local ok: boolean, err: any = pcall(function()
			-- a brand-new player gets the short tour; if the map has too few of its stops, the old park fly-over
			if not (p and p.StarterEgg == true and tour()) then
				fly()
			end
		end)
		if not ok then
			warn("[LobbyFlyover]", err)
			CameraMode.cinematic(CINE, false)
		end
	end)
end

return LobbyFlyover
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="305">
          <Properties>
            <string name="Name">LobbySpin</string>
            <string name="Source"><![CDATA[--!strict
-- Slow spin for lobby showpieces (the egg on the EGG SHOP roof, the tower portal swirl). Any anchored BasePart tagged "LobbySpin" turns
-- about its own up axis on this client (attribute SpinSpeed = radians per second, default 0.6). Visual only.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local TAG = "LobbySpin"
local home: { [BasePart]: CFrame } = {}

local function add(inst: Instance)
	if inst:IsA("BasePart") and not home[inst] then
		home[inst] = inst.CFrame
	end
end
local function remove(inst: Instance)
	if inst:IsA("BasePart") then
		home[inst] = nil
	end
end
for _, inst in CollectionService:GetTagged(TAG) do
	add(inst)
end
CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
CollectionService:GetInstanceRemovedSignal(TAG):Connect(remove)

local t0 = os.clock()
RunService.Heartbeat:Connect(function()
	local t = os.clock() - t0
	for part, cf in home do
		if part.Parent then
			local speed = part:GetAttribute("SpinSpeed")
			local s = if type(speed) == "number" then speed else 0.6
			local axis = part:GetAttribute("SpinAxis") -- "X" / "Y" (default) / "Z": the local axis to turn about
			local a = t * s
			part.CFrame = cf * (if axis == "X" then CFrame.Angles(a, 0, 0) elseif axis == "Z" then CFrame.Angles(0, 0, a) else CFrame.Angles(0, a, 0))
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="306">
          <Properties>
            <string name="Name">LodgeLight</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby light fill. The old Prospector Lodge needed an interior fill (its roof shaded the hall); the lobby is now the
-- outdoor dino-jungle pet park, lit by the project Lighting like the hunts, so there is nothing to blend: the module
-- keeps its API (start, inside, blend) for Main.client and the preview scenes and never touches Lighting.

local LodgeLight = {}

-- No roofed interior in the park.
function LodgeLight.inside(_p: Vector3): boolean
	return false
end

function LodgeLight.start() end

-- Test / preview hook: current blend 0..1 (always 0 outdoors).
function LodgeLight.blend(): number
	return 0
end

return LodgeLight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="307">
          <Properties>
            <string name="Name">MachineView</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side machine motion (cosmetic only; the server owns every claim and every payout).
-- The server builds static models (src/server/MachineModels.luau) and tells us each owner's
-- machine state plus a Start event for every rock it takes (PileView.Claimed, Duration = Config
-- seconds per rock). One Start = one visible cycle of exactly that length, so strokes match the
-- counters:
--   Auto Cracker: jaws close to contact at 50% of the cycle and open again; belt and rollers run.
--   Press: load 0-15%, platen down to contact at 50%, held to 60%, back up; the stone is flattened.
--   Crusher: rollers (counter-rotating) and belt run while cycles keep arriving; dust pools.
-- Idle (no queue), paused, bag full or round over: parts settle open, loops stop.
-- Moving parts never collide (CanCollide/CanQuery are off on the server), so nothing here can
-- push a character. Reserved-rock outlines live in PileView.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local State = require(script.Parent.State)
local Audio = require(script.Parent.Audio)
local Effects = require(script.Parent.Effects)

local MachineView = {}

local V3 = Vector3.new

-- Stone paths in the machine's pad-top frame (-Z toward the pile).
local PATHS = {
	AutoCracker = {
		Start = V3(0, 1.65, -4.4), Roller = V3(0, 2.0, 0.0), Mid = V3(0, 1.7, 2.2), Out = V3(0, 0.95, 4.8), BeltEnd = V3(0, 1.7, -0.7),
	},
	IndustrialCrusher = {
		Start = V3(0, 1.8, -4.5), Roller = V3(0, 3.3, -0.3), Mid = V3(0, 2.0, 1.8), Out = V3(0, 0.95, 4.8), BeltEnd = V3(0, 1.8, -2.3),
	},
	HydraulicPress = {
		Start = V3(0, 1.55, -3.5), Roller = V3(0, 1.65, 0.6), Mid = V3(0, 1.3, 3.0), Out = V3(0, 0.95, 4.35), BeltEnd = V3(0, 1.65, 0.6),
	},
}
local STATE_COLOR = {
	Running = Color3.fromRGB(70, 200, 100),
	Full = Color3.fromRGB(244, 198, 68),
	Paused = Color3.fromRGB(226, 76, 64),
}
local OFF = Color3.fromRGB(92, 98, 106)

type Piece = { Part: BasePart, Base: CFrame }
type Stone = { Part: Part, T0: number, Dur: number, Kind: string, Path: any, Landed: boolean }
type View = {
	Model: Model,
	OwnerId: number,
	Id: string,
	Frame: CFrame,
	Belts: { { Tile: Piece, Chevron: Piece?, Order: number, Count: number, Z0: number, Length: number } },
	Spins: { { Model: Model, Base: CFrame, Dir: number } },
	Jaws: { { Model: Model, Base: CFrame, Dir: number } },
	Plate: { Piece },
	Rod: Piece?,
	RodSize: Vector3,
	Path: any, -- stone path from the kit attachment points (nil: PATHS[Id])
	KitJaws: { { Piece: Piece, Delta: Vector3 } },
	KitPress: { { Piece: Piece, Travel: number } },
	KitRollers: { { Piece: Piece, Pivot: Vector3, Axis: Vector3, Dir: number } },
	KitFill: { BasePart },
	FillShown: boolean,
	Light: BasePart?,
	Beacon: BasePart?,
	Emitters: { ParticleEmitter },
	Speed: number,
	BeltOff: number,
	Angle: number,
	JawT: number,
	CycleAt: number, -- start (os.clock) of the current server rock cycle
	CycleDur: number, -- its length: Config seconds per rock (RoundRocks.machineSeconds), from the Start event
	LastStone: number, -- last cosmetic feed stone spawn (throttles very fast machines)
	Contact: boolean,
	PlateD: number, -- last plate drop applied (skips identical frames)
	Rested: boolean, -- belts/rollers/jaws already settled at speed 0
	Cues: { [string]: boolean }, -- press sounds already played this cycle
	Stones: { Stone },
	State: string,
	BuiltAt: number, -- os.clock() of build (a later streamed-in part rebuilds the view once it is at rest)
}

local views: { [Model]: View } = {}
local states: { [number]: { State: string, Id: string } } = {}
local stonePool: { Part } = {}
local fxFolder: Folder? = nil
local lastScan = 0
local active = false
-- StreamingEnabled: a machine model can arrive before all of its parts. Each model is watched; a view is built once
-- its parts stop arriving (SETTLE s) and rebuilt, while the machine is at rest, when more parts stream in later.
local SETTLE = 0.6
local addedAt: { [Model]: number } = {}
local watched: { [Model]: RBXScriptConnection } = {}
local function watch(model: Model)
	if watched[model] then
		return
	end
	-- already filled in when first seen (no streaming, or streamed in whole): build right away
	addedAt[model] = if #model:GetChildren() > 0 then os.clock() - SETTLE else os.clock()
	watched[model] = model.DescendantAdded:Connect(function()
		addedAt[model] = os.clock()
	end)
end
local function unwatch(model: Model)
	local c = watched[model]
	if c then
		c:Disconnect()
	end
	watched[model] = nil
	addedAt[model] = nil
end

local function settings(): any
	return State.Profile and State.Profile.Settings or {}
end

local function piece(p: BasePart): Piece
	return { Part = p, Base = p.CFrame }
end

local function build(model: Model): View?
	local frame = model:GetAttribute("Frame")
	local owner = model:GetAttribute("OwnerId")
	local id = model:GetAttribute("MachineId")
	if typeof(frame) ~= "CFrame" or type(owner) ~= "number" or type(id) ~= "string" then
		return nil
	end
	local v: View = {
		Model = model, OwnerId = owner, Id = id, Frame = frame,
		Belts = {}, Spins = {}, Jaws = {}, Plate = {}, Rod = nil, RodSize = Vector3.one,
		Path = nil, KitJaws = {}, KitPress = {}, KitRollers = {}, KitFill = {}, FillShown = false,
		Light = nil, Beacon = nil, Emitters = {}, Speed = 0, BeltOff = 0, Angle = 0, JawT = 0,
		CycleAt = 0, CycleDur = 0, LastStone = 0, Contact = false, PlateD = 0, Rested = false, Cues = {}, Stones = {}, State = "None",
		BuiltAt = os.clock(),
	}
	if model:GetAttribute("Kit") == true then
		local function pt(n: string): Vector3?
			local a = model:GetAttribute(n)
			return if typeof(a) == "Vector3" then a else nil
		end
		local s0, b0, r0, m0, o0 = pt("PathStart"), pt("PathBeltEnd"), pt("PathRoller"), pt("PathMid"), pt("PathOut")
		if s0 and b0 and r0 and m0 and o0 then
			v.Path = { Start = s0, BeltEnd = b0, Roller = r0, Mid = m0, Out = o0 }
		end
	end
	for _, d in model:GetDescendants() do
		local role = d:GetAttribute("Role")
		if d:IsA("Model") and role == "Spin" then
			table.insert(v.Spins, { Model = d, Base = d:GetPivot(), Dir = (d:GetAttribute("Dir") :: number?) or 1 })
		elseif d:IsA("Model") and role == "Jaw" then
			table.insert(v.Jaws, { Model = d, Base = d:GetPivot(), Dir = (d:GetAttribute("Dir") :: number?) or 1 })
		elseif d:IsA("BasePart") then
			if role == "KitJaw" then
				local delta = d:GetAttribute("Delta")
				table.insert(v.KitJaws, { Piece = piece(d), Delta = if typeof(delta) == "Vector3" then delta else Vector3.zero })
			elseif role == "KitPress" then
				table.insert(v.KitPress, { Piece = piece(d), Travel = (d:GetAttribute("Travel") :: number?) or 1.5 })
			elseif role == "KitRoller" then
				local pv, ax = d:GetAttribute("Pivot"), d:GetAttribute("Axis")
				if typeof(pv) == "Vector3" and typeof(ax) == "Vector3" then
					table.insert(v.KitRollers, { Piece = piece(d), Pivot = pv, Axis = ax, Dir = (d:GetAttribute("Dir") :: number?) or 1 })
				end
			elseif role == "KitFill" then
				table.insert(v.KitFill, d)
			elseif role == "Belt" then
				local chev = d:FindFirstChild("Chevron")
				table.insert(v.Belts, {
					Tile = piece(d),
					Chevron = if chev and chev:IsA("BasePart") then piece(chev) else nil,
					Order = (d:GetAttribute("Order") :: number?) or 1,
					Count = (d:GetAttribute("Count") :: number?) or 1,
					Z0 = (d:GetAttribute("Z0") :: number?) or 0,
					Length = (d:GetAttribute("Length") :: number?) or 1,
				})
			elseif role == "Plate" then
				table.insert(v.Plate, piece(d))
				for _, c in d:GetChildren() do
					if c:IsA("BasePart") then
						table.insert(v.Plate, piece(c))
					end
				end
			elseif role == "Piston" then
				v.Rod = piece(d)
				v.RodSize = d.Size
			elseif role == "Light" then
				v.Light = d
			elseif role == "Beacon" then
				v.Beacon = d
			end
		elseif d:IsA("Attachment") and role == "Dust" then
			for _, e in d:GetChildren() do
				if e:IsA("ParticleEmitter") then
					table.insert(v.Emitters, e)
				end
			end
		end
	end
	return v
end

local function scan()
	for model in watched do
		if model.Parent == nil then
			unwatch(model)
		end
	end
	for model, v in views do
		local now = os.clock()
		local atRest = (v.Rested or v.Id == "HydraulicPress") and #v.Stones == 0 and now > v.CycleAt + v.CycleDur + 0.5
		local late = (addedAt[model] or 0) > v.BuiltAt and now - (addedAt[model] or 0) >= SETTLE and atRest
		if model.Parent == nil or late then
			for _, s in v.Stones do
				s.Part.Parent = nil
				table.insert(stonePool, s.Part)
			end
			views[model] = nil -- a late one is built again below with all its parts
		end
	end
	for _, arena in Workspace:GetChildren() do
		if string.sub(arena.Name, 1, 15) == "CT_Rocks_Arena_" then
			local f = arena:FindFirstChild("CT_Rocks_Machines")
			if f then
				for _, model in f:GetChildren() do
					if model:IsA("Model") then
						watch(model)
					end
					if model:IsA("Model") and not views[model] and os.clock() - (addedAt[model] or 0) >= SETTLE then
						local v = build(model)
						if v then
							views[model] = v
						end
					end
				end
			end
		end
	end
end

local function viewOf(uid: number): View?
	for _, v in views do
		if v.OwnerId == uid then
			return v
		end
	end
	return nil
end

-- Feed stones (pooled, <= 1 s each) --------------------------------------------------------

local function newStone(): Part
	local p = table.remove(stonePool)
	if p then
		return p
	end
	local s = Instance.new("Part")
	s.Name = "FeedStone"
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.CastShadow = false
	s.Material = Enum.Material.Slate
	return s
end

local function spawnStone(v: View, delay: number, dur: number)
	if #v.Stones >= 6 then
		return
	end
	local path = v.Path or PATHS[v.Id]
	if not path then
		return
	end
	if not fxFolder then
		local f = Instance.new("Folder")
		f.Name = "CT_Rocks_MachineFx"
		f.Parent = Workspace
		fxFolder = f
	end
	local part = newStone()
	part.Color = Config.Palette.Rock:Lerp(Color3.fromRGB(88, 94, 102), math.random())
	part.Size = Vector3.new(0.8, 0.6, 0.8)
	part.Transparency = 1
	part.Parent = fxFolder
	table.insert(v.Stones, { Part = part, T0 = os.clock() + delay, Dur = dur, Kind = v.Id, Path = path, Landed = false })
end

local function lerp(a: Vector3, b: Vector3, t: number): Vector3
	return a:Lerp(b, math.clamp(t, 0, 1))
end

-- One cosmetic stone per server rock cycle. Its stages are fractions of the cycle (s.Dur), so it
-- reaches the platen / rollers exactly when the machine parts do.
local function updateStone(v: View, s: Stone, now: number): boolean
	local k = (now - s.T0) / s.Dur
	if k < 0 then
		return true
	end
	if k >= 1 then
		if not s.Landed and s.Kind ~= "HydraulicPress" then
			s.Landed = true
			if not settings().LowEffects then
				for _, em in v.Emitters do
					em:Emit(2)
				end
			end
		end
		return false
	end
	local P = s.Path
	local pos: Vector3
	local size = Vector3.new(0.8, 0.6, 0.8)
	local alpha = 0
	if s.Kind == "HydraulicPress" then
		if k < 0.2 then
			pos = lerp(P.Start, P.Roller, k / 0.2) -- load onto the bed
		elseif k < 0.5 then
			pos = P.Roller -- waits under the open platen
		elseif k < 0.6 then
			pos = P.Roller -- flattened under the platen
			size = Vector3.new(1.1, 0.2, 1.1)
		else
			local u = (k - 0.6) / 0.4
			pos = lerp(P.Roller, P.Out, u) -- unload to the recovery chute
			size = Vector3.new(0.7, 0.3, 0.7)
			alpha = math.clamp((u - 0.6) / 0.4, 0, 1)
		end
	elseif k < 0.55 then
		pos = lerp(P.Start, P.BeltEnd, k / 0.55)
		pos = pos:Lerp(P.Roller, math.clamp((k - 0.4) / 0.15, 0, 1) * 0.5)
	elseif k < 0.7 then
		local u = (k - 0.55) / 0.15
		pos = P.Roller
		size = Vector3.new(0.8, 0.6, 0.8) * (1 - 0.45 * u)
	else
		local u = (k - 0.7) / 0.3
		pos = if u < 0.5 then lerp(P.Roller, P.Mid, u * 2) else lerp(P.Mid, P.Out, (u - 0.5) * 2)
		size = Vector3.new(0.45, 0.35, 0.45)
		alpha = math.clamp((u - 0.7) / 0.3, 0, 1)
	end
	s.Part.Size = size
	s.Part.CFrame = v.Frame * CFrame.new(pos)
	s.Part.Transparency = alpha
	return true
end

-- Animation --------------------------------------------------------------------------------

-- All curves take the cycle phase p (0..1 of ONE server rock cycle) and return 0..1.
local function smooth(k: number): number
	k = math.clamp(k, 0, 1)
	return k * k * (3 - 2 * k)
end

-- Press platen: open and loading to 0.15, down to contact at 0.5, held to 0.6, back up by 1.
local function pressK(p: number): number
	if p < 0.15 then
		return 0
	elseif p < 0.5 then
		local k = (p - 0.15) / 0.35
		return k * k
	elseif p < 0.6 then
		return 1
	end
	return 1 - smooth((p - 0.6) / 0.4)
end

-- Auto Cracker jaws: close to contact at 0.5, open again by 1.
local function jawK(p: number): number
	if p < 0.5 then
		return smooth(p / 0.5)
	end
	return 1 - smooth((p - 0.5) / 0.5)
end

local PRESS_FALLBACK_DROP = 4.1 -- the Part stand-in press drops this far

local function setPlate(v: View, k: number)
	for _, kp in v.KitPress do
		-- kit press: platen and piston slide down their Travel together
		kp.Piece.Part.CFrame = CFrame.new(kp.Piece.Base.Position + Vector3.new(0, -k * kp.Travel, 0)) * kp.Piece.Base.Rotation
	end
	local d = k * PRESS_FALLBACK_DROP
	for _, pc in v.Plate do
		pc.Part.CFrame = CFrame.new(pc.Base.Position + Vector3.new(0, -d, 0)) * pc.Base.Rotation
	end
	local rod = v.Rod
	if rod then
		local len = v.RodSize.X + d
		rod.Part.Size = Vector3.new(len, v.RodSize.Y, v.RodSize.Z)
		rod.Part.CFrame = CFrame.new(rod.Base.Position + Vector3.new(0, -d / 2, 0)) * rod.Base.Rotation
	end
end

-- Moves one machine. Everything that has a stroke (press platen, cracker jaws, feed stones) follows the
-- server's rock cycle: one Start event = one cycle of CycleDur seconds (Config seconds per rock), so
-- the visible strokes match the counter. Continuous parts (rollers, belt, hum) run only while cycles
-- keep arriving and wind down on their own; with no queue, a pause, a full bag or the round over the
-- machine settles open and silent.
local function animate(v: View, dt: number, now: number)
	local info = states[v.OwnerId]
	local st = if info then info.State else "None"
	v.State = st
	local cycleEnd = v.CycleAt + v.CycleDur
	local inCycle = st == "Running" and v.CycleDur > 0 and now >= v.CycleAt and now < cycleEnd
	local working = st == "Running" and v.CycleDur > 0 and now < cycleEnd + 0.35
	local target = if working then 1 else 0
	v.Speed += (target - v.Speed) * math.min(1, dt * (if working then 8 else 3)) -- winds up fast, down gently
	if v.Speed < 0.01 and target == 0 then
		v.Speed = 0
	end
	local reduced = settings().ReducedMotion
	local sp = v.Speed * (if reduced then 0.5 else 1)
	local p = if inCycle then (now - v.CycleAt) / v.CycleDur else 0

	-- state light
	local color = STATE_COLOR[st] or OFF
	local light = v.Light
	if light then
		light.Color = color
		local pl = light:FindFirstChildOfClass("PointLight")
		if pl then
			pl.Color = color
			pl.Enabled = st ~= "None"
		end
	end

	-- kit rubble pieces (bin / hopper) show while the machine is working
	if working ~= v.FillShown then
		v.FillShown = working
		for _, f in v.KitFill do
			f.Transparency = if working then 0 else 1
		end
	end

	-- sound (Audio owns caps, cooldowns, distance and the Sfx volume; positioned at the machine)
	local mpos = v.Frame.Position
	if working and v.Speed > 0.3 then
		if v.Id == "AutoCracker" then
			Audio.machineActive("m:" .. v.OwnerId, "Conveyor", mpos)
		elseif v.Id == "IndustrialCrusher" then
			Audio.machineActive("m:" .. v.OwnerId, "Crusher", mpos)
		end
	end

	-- stroke parts: platen (press) and jaws (auto cracker) follow the cycle phase
	if v.Id == "HydraulicPress" then
		local k = if inCycle then pressK(p) else 0
		if k ~= v.PlateD then
			v.PlateD = k
			setPlate(v, k)
		end
		if inCycle then
			local cues = v.Cues
			if p >= 0.15 and not cues.Descend then
				cues.Descend = true
				Audio.play("PressDescend", { Pos = mpos, Key = "PressDescend:" .. v.OwnerId })
			end
			if p >= 0.5 and not cues.Impact then
				cues.Impact = true
				Audio.play("PressImpact", { Pos = mpos, Key = "PressImpact:" .. v.OwnerId })
				if not settings().LowEffects then
					for _, em in v.Emitters do
						em:Emit(6)
					end
				end
			end
			if p >= 0.6 and not cues.Retract then
				cues.Retract = true
				Audio.play("PressRetract", { Pos = mpos, Key = "PressRetract:" .. v.OwnerId })
			end
		else
			table.clear(v.Cues)
		end
		if v.Beacon then
			local lamp = inCycle and p < 0.15
			local blink = working and (math.floor(now * 2) % 2 == 0)
			local beacon = v.Beacon :: BasePart
			beacon.Color = if lamp then Color3.fromRGB(255, 190, 60) elseif blink then Color3.fromRGB(190, 110, 30) else OFF
		end
	else
		-- auto cracker jaws: closed on the rock at p = 0.5, open at the cycle edges and whenever idle
		local jk = if inCycle then jawK(p) * (if reduced then 0.6 else 1) else 0
		if jk ~= v.JawT or #v.KitJaws > 0 then
			v.JawT = jk
			for _, j in v.KitJaws do
				j.Piece.Part.CFrame = j.Piece.Base + j.Delta * jk
			end
		end
		if v.Id == "AutoCracker" then
			if inCycle and p >= 0.5 and not v.Contact then
				v.Contact = true
				Audio.play("PressImpact", { Pos = mpos, Key = "JawContact:" .. v.OwnerId, Volume = 0.5 })
				if not settings().LowEffects then
					for _, em in v.Emitters do
						em:Emit(3)
					end
				end
			elseif not inCycle or p < 0.5 then
				v.Contact = false
			end
		end
	end

	-- continuous parts (belt tiles, rollers, flywheel, part-built jaws) only move while working
	if v.Id ~= "HydraulicPress" and not (sp == 0 and v.Rested) then
		v.Rested = sp == 0
		local speed = (if v.Id == "AutoCracker" then 6.3 else 4.0) * sp
		v.BeltOff += dt * speed
		for _, b in v.Belts do
			local pitch = b.Length / b.Count
			local zi = b.Z0 + (b.Order - 0.5) * pitch
			local zn = b.Z0 + ((zi - b.Z0 + v.BeltOff) % b.Length)
			local dz = zn - zi
			b.Tile.Part.CFrame = b.Tile.Base * CFrame.new(0, 0, dz)
			local chev = b.Chevron
			if chev then
				chev.Part.CFrame = chev.Base * CFrame.new(0, 0, dz)
			end
		end
		v.Angle += dt * (if v.Id == "AutoCracker" then 5 else 3.2) * sp
		for _, s in v.Spins do
			s.Model:PivotTo(s.Base * CFrame.Angles(s.Dir * v.Angle, 0, 0))
		end
		for _, r in v.KitRollers do
			r.Piece.Part.CFrame = CFrame.new(r.Pivot) * CFrame.fromAxisAngle(r.Axis, r.Dir * v.Angle) * CFrame.new(-r.Pivot) * r.Piece.Base
		end
		-- part-built jaws swing with the cycle (crusher stand-in), kept small
		local amp = if reduced then 0.05 else 0.12
		for _, j in v.Jaws do
			j.Model:PivotTo(j.Base * CFrame.Angles(0, 0, j.Dir * amp * math.sin(p * math.pi * 2) * (if inCycle then 1 else 0)))
		end
		if v.Id == "IndustrialCrusher" then
			local on = sp > 0.3 and not settings().LowEffects
			for _, em in v.Emitters do
				em.Enabled = on
			end
		end
	end

	-- cosmetic feed stones
	local i = 1
	while i <= #v.Stones do
		local s = v.Stones[i]
		if updateStone(v, s, now) then
			i += 1
		else
			s.Part.Parent = nil
			if #stonePool < 24 then
				table.insert(stonePool, s.Part)
			else
				s.Part:Destroy()
			end
			table.remove(v.Stones, i)
		end
	end
end

-- API --------------------------------------------------------------------------------------

-- The server's machine list for this match: { {UserId, Bay, Id, State} }.
function MachineView.setStates(list: { any })
	table.clear(states)
	for _, e in list do
		states[e.UserId] = { State = e.State, Id = e.Id }
	end
	active = next(states) ~= nil or next(views) ~= nil
	scan()
end

-- The server started one rock on `uid`'s machine (`seconds` = Config seconds per rock). That is one
-- cycle: a cycle that arrives just before the previous one ends continues it seamlessly, a late one starts
-- at once, and a burst of events in one batch (catch-up after lag) never queues extra strokes.
function MachineView.batch(uid: number, count: number, seconds: number)
	local v = viewOf(uid)
	if not v then
		scan()
		v = viewOf(uid)
	end
	if not v or (states[uid] and states[uid].State ~= "Running") then
		return
	end
	local view = v :: View
	local now = os.clock()
	local dur = math.clamp(seconds, 0.05, 3)
	local prevEnd = view.CycleAt + view.CycleDur
	view.CycleAt = if prevEnd > now and prevEnd - now < 0.15 then prevEnd else now
	view.CycleDur = dur
	view.Contact = false
	table.clear(view.Cues)
	-- one cosmetic stone per cycle; machines faster than ~4 rocks/s show a stone every 0.2 s at most
	if view.Id == "HydraulicPress" then
		spawnStone(view, view.CycleAt - now, dur)
	elseif now - view.LastStone >= 0.2 then
		view.LastStone = now
		spawnStone(view, view.CycleAt - now, math.max(dur, 0.45))
	end
end

-- The geode came out of `uid`'s machine: a short glint at its recovery chute. Effects respects
-- Reduced motion and Low effects.
function MachineView.recovered(uid: number)
	local v = viewOf(uid)
	if not v then
		return
	end
	local path = v.Path or PATHS[v.Id]
	if path then
		Effects.glint((v.Frame * CFrame.new(path.Out)).Position)
	end
end

-- Round over / left: machines wind down.
function MachineView.stop()
	for uid in states do
		states[uid].State = "None"
	end
end

function MachineView.clear()
	for uid in states do
		Audio.machineStop("m:" .. uid)
	end
	table.clear(states)
	for model, v in views do
		for _, s in v.Stones do
			s.Part.Parent = nil
		end
		views[model] = nil
	end
	active = false
	for model in watched do
		unwatch(model)
	end
end

function MachineView.start()
	RunService.RenderStepped:Connect(function(dt)
		if not active and next(views) == nil then
			return
		end
		local now = os.clock()
		if now - lastScan > 0.5 then
			lastScan = now
			scan()
		end
		local cam = Workspace.CurrentCamera
		for _, v in views do
			-- far-away arenas (other parties) are not animated
			if not cam or (cam.CFrame.Position - v.Frame.Position).Magnitude < 160 then
				animate(v, math.min(dt, 0.1), now)
			end
		end
	end)
end

return MachineView
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="308">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client boot: UI, pile view, onboarding hints and markers, server event wiring.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local MapNames = require(Shared.MapNames)
local ParkConfig = require(Shared.ParkConfig)
local HintRules = require(Shared.HintRules)
local State = require(script.Parent.State)
local PileView = require(script.Parent.PileView)
local StationView = require(script.Parent.StationView)
local SurprisePop = require(script.Parent.SurprisePop)
local MachineView = require(script.Parent.MachineView)
local RevealView = require(script.Parent.RevealView)
local HatchFocus = require(script.Parent.HatchFocus)
local PromptArbiter = require(script.Parent.PromptArbiter)
local CameraGuard = require(script.Parent.CameraGuard)
local CameraMode = require(script.Parent.CameraMode)
local Reticle = require(script.Parent.Reticle)
local CarryGlimpse = require(script.Parent.CarryGlimpse)
local UI = require(script.Parent.ui.UI)
local Hud = require(script.Parent.ui.Hud)
local PartyPanel = require(script.Parent.ui.PartyPanel)
local ShopPanel = require(script.Parent.ui.ShopPanel)
local CollectionPanel = require(script.Parent.ui.CollectionPanel)
local MyPetsPanel = require(script.Parent.ui.MyPetsPanel)
local SettingsPanel = require(script.Parent.ui.SettingsPanel)
local Results = require(script.Parent.ui.ResultsPanel)
local Audio = require(script.Parent.Audio)
local Effects = require(script.Parent.Effects)
local LaunchPanel = require(script.Parent.ui.LaunchPanel)
local InspectPanel = require(script.Parent.ui.InspectPanel)
local RobuxShopPanel = require(script.Parent.ui.RobuxShopPanel)
local PetShop = require(script.Parent.ui.PetShop)
local Juice = require(script.Parent.ui.Juice)

local player = Players.LocalPlayer

Audio.init()
require(script.Parent.SoundCueView).start() -- moment sounds heard from server messages (shared/SoundCues)

local function confirmReturn()
	local m = State.Match
	if not m then
		return
	end
	if m.Phase == "Results" or m.Phase == "Reveal" then
		Net.event("MatchAction"):FireServer("Return")
		return
	end
	UI.confirm({
		Name = "ConfirmReturn",
		Title = "Leave this hunt?",
		Message = "You go back to the lobby and can't win this hunt. Candy you earned is kept.",
		Icon = "exit",
		Confirm = "LEAVE",
		Cancel = "STAY",
		Style = "red",
		OnConfirm = function()
			Net.event("MatchAction"):FireServer("Return")
		end,
	})
end

local panels = {
	Party = PartyPanel.open,
	Shop = ShopPanel.open,
	RobuxShop = function()
		PetShop.open() -- EGG SHOP hut prompt (Panel attribute): the new Pet Shop look (trial 2026-10-15)
	end,
	EggShrine = function() -- hatch stand "Buy Eggs" prompt: the Pet Shop's Eggs tab priced in coins
		PetShop.setPayCoins(true)
		PetShop.open("Eggs")
	end,
	Collection = CollectionPanel.open,
	PetIndex = function() -- PET INDEX shop in the lobby's shop square
		CollectionPanel.open("Index")
	end,
	MyPets = function() -- MY PETS (lobby HUD button and the MY PETS shop in the shop square): the team and collection
		MyPetsPanel.open()
	end,
	Settings = SettingsPanel.open,
	ConfirmReturn = confirmReturn,
	Results = Results.open,
}

local function openPanel(name: string)
	if name == "ConfirmReturn" then
		confirmReturn()
		return
	end
	if UI.modalOpen() == name then
		UI.closeModal()
		return
	end
	local fn = panels[name]
	if fn then
		fn()
	end
end

-- Onboarding ------------------------------------------------------------------------------
-- One concise hint at a time (Hud), plus a small marker over the station it points at.
-- Steps are tracked on the server (profile.Onboard) and never repeat once done or skipped.

local function onboarding()
	local prof = State.Profile
	if not prof or prof.OnboardDone or not prof.Onboard then
		return nil
	end
	return prof.Onboard
end

local GOAL_TEXT_PREFIX = "Nice! You have "

-- A hunt in progress (countdown, searching, securing): arena hints only. Lobby-only hints (gallery,
-- selling) wait until the player is back in the lobby or on the results screen, and arena hints
-- never show in the lobby.
local function inHunt(m: any): boolean
	return m ~= nil and (m.Phase == "Countdown" or m.Phase == "Searching" or m.Phase == "RewardPending")
end

local function ownStation(m: any): any?
	for _, st in (m and m.Stations) or {} do
		if st.UserId == player.UserId then
			return st
		end
	end
	return nil
end

-- The input the hint wording is for (shared/HintRules: touch players are never told to press a key, bug #221).
local function inputKind(): HintRules.Input
	return HintRules.inputKind(UserInputService:GetLastInputType().Name, UserInputService.TouchEnabled, UserInputService.KeyboardEnabled)
end

-- Arena guidance follows what the player is doing: pick up -> walk to the table -> deposit -> crush
-- -> keep going until the geode. Each part ends for good once the server has seen the step.
local function huntHint(ob: any, m: any): string?
	if m.Phase ~= "Searching" then
		return nil
	end
	local st = ownStation(m)
	if not st then
		return nil
	end
	local basket = #st.Basket
	local carryCap = st.CarryCap or Config.Carry.Capacity -- basket upgrades raise it (a 4/5 basket is not full)
	local queued = #st.Queue + (if st.Current then 1 else 0)
	local ctx = PileView.context()
	if not ob.Cracked then
		-- the hint follows the action button: DEPOSIT up at the nest always means "deposit" (eggs already waiting or not)
		if ctx.Id == "deposit" and basket > 0 then
			return "Tap DEPOSIT EGGS!"
		elseif queued > 0 then
			if ctx.Id == "crush" then
				return "Hold HATCH! to hatch your egg!"
			end
			return "Stand at your nest, hold HATCH!"
		elseif basket >= carryCap then
			return "Basket full! Follow the arrow to your nest."
		elseif basket > 0 then
			if ctx.Id == "deposit" then
				return "Tap DEPOSIT EGGS!"
			elseif ctx.Id == "pickup" then
				return "Nice! Grab more eggs (up to " .. carryCap .. ") or carry them to YOUR nest."
			end
			return "Follow the arrow to your nest!"
		end
		if ob.PickedUp then
			return nil -- the player has picked eggs up already: the controls tip has done its job (bug #221)
		end
		return HintRules.pickupTip(inputKind()) -- goal + action in one line (walkthrough 10-14 #9)
	end
	if not ob.Geode then
		return HintRules.candyTip(inputKind())
	end
	return nil
end

local function rawHintText(): string?
	local ob = onboarding()
	local prof = State.Profile
	local m = State.Match
	if not ob or not prof or prof.Settings.Hints == false then
		return nil
	end
	if inHunt(m) then
		return huntHint(ob, m)
	end
	-- results: the specimen is in the collection now
	if m and m.Phase == "Results" and State.Results and State.Results.Winner == player.UserId and State.Results.Kind ~= "Tutorial" and not ob.Displayed then
		return "Your new pet is in your Pet Book!"
	end
	if m and m.Phase ~= "Results" then
		return nil -- reveal: the picture is the hint
	end
	if prof.StarterEgg == true and not m then
		return nil -- the starter egg (its glow, tag and arrow) is the only lobby cue until it hatches (Studio 2026-10-15)
	end
	if ob.Geode and not ob.Displayed and #prof.Inventory > 0 then
		if m then
			return "Tap LOBBY, then put your pet in your pen!"
		end
		return "Tap PET BOOK! Then tap PLACE ON DISPLAY!"
	end
	-- selling candy comes after the pet steps: the pet loop first, coins second
	if not ob.Sold and prof.Rubble > 0 and not m then
		return "Sell candy at the candy stand for coins!"
	end
	if ob.Geode and ob.Displayed and not ob.Goal and not m then
		local h = Config.Handhelds.SteelHammer
		return GOAL_TEXT_PREFIX .. UI.money(prof.Cash) .. "! Buy upgrades! The " .. h.Name .. " costs " .. UI.money(h.Price) .. ": tap UPGRADES!"
	end
	return nil
end
-- Hint lifetime (shared/HintRules, bugs #216 / #221): a hint hides for good once its step is done, and retires for
-- the session after its timeout on screen (a menu over it pauses the clock).
local hintState = HintRules.new()
local hintClock = os.clock()
local function hintText(): string?
	local ob = onboarding()
	if ob and ob.PickedUp then
		HintRules.done(hintState, HintRules.PickupKey)
	end
	local text = rawHintText()
	local now = os.clock()
	local dt = now - hintClock
	hintClock = now
	if not text then
		return nil
	end
	local timeout: number? = nil
	if State.Match == nil then
		timeout = HintRules.Timeout.Lobby
	elseif HintRules.key(text) == HintRules.PickupKey then
		timeout = HintRules.Timeout.Pickup
	end
	local onScreen = not UI.blocked() and UI.modalOpen() == nil
	if not HintRules.visible(hintState, HintRules.key(text), timeout, onScreen, dt) then
		return nil
	end
	return text
end
Hud.hintText = hintText

-- small "here" marker over a world part
local marker: BillboardGui? = nil

-- The marker steps aside while a menu covers the screen and while the avatar is in the pet tower (the target is far
-- away there); it comes back as soon as the screen is clear. It also waits while the top objective card shows (START
-- YOUR FIRST HUNT): one guidance cue at a time, and the gold chip (AlwaysOnTop, fixed 176 px) over a far-off sell
-- stand or plot sign sat right behind that card, so only its lower half peeked out under it as a stray gold tab.
local function syncMarkerVisible()
	if marker then
		local want = not UI.blocked() and UI.modalOpen() == nil and player:GetAttribute("InTower") ~= true
			and player:GetAttribute("InBattle") ~= true and player:GetAttribute("MatchKey") == nil and not Hud.objectiveShown()
		if marker.Enabled ~= want then
			marker.Enabled = want
		end
	end
end
UI.ModalChanged.Event:Connect(syncMarkerVisible)
UI.BlockChanged.Event:Connect(syncMarkerVisible)
player:GetAttributeChangedSignal("InTower"):Connect(syncMarkerVisible)
player:GetAttributeChangedSignal("InBattle"):Connect(syncMarkerVisible)
player:GetAttributeChangedSignal("MatchKey"):Connect(syncMarkerVisible)

local function setMarker(target: BasePart?, text: string?)
	if not target then
		if marker then
			marker:Destroy()
			marker = nil
		end
		return
	end
	if marker and marker.Adornee == target then
		return
	end
	if marker then
		marker:Destroy()
	end
	local g = Instance.new("BillboardGui")
	g.Name = "CT_Rocks_Marker"
	g.Size = UDim2.fromOffset(176, 46) -- read from the path on a phone (bug #217: the 110 x 32 chip was unreadable)
	-- world up, not camera up: the chip stays over its target as the camera turns; just above a sign, higher over a floor
	g.StudsOffsetWorldSpace = Vector3.new(0, if target.Name == MapNames.PlotFloor then 14 else target.Size.Y / 2 + 2.5, 0)
	g.AlwaysOnTop = true
	g.MaxDistance = 600 -- never drawn from the far-off tower or hunt arenas (AlwaysOnTop showed it through their walls)
	g.Adornee = target
	g.Parent = player:WaitForChild("PlayerGui")
	local f = UI.frame(g, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = UI.Colors.Gold })
	UI.corner(f, 12)
	UI.stroke(f, UI.Colors.PanelEdge, 3)
	local mt = UI.text(f, text or "HERE", { Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Font = UI.Head, TextSize = UI.T.Head + 4, TextColor3 = UI.Colors.DarkText, TextXAlignment = Enum.TextXAlignment.Center })
	mt.TextWrapped = false
	UI.fit(mt, UI.T.Head + 4, UI.T.Body)
	if not UI.Reduced then
		-- pulse once, then stay still
		local s = Instance.new("UIScale")
		s.Parent = f
		s.Scale = 1.25
		TweenService:Create(s, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	marker = g
	syncMarkerVisible()
end

local HOPPER_RESCAN = 5 -- seconds
local hopperModels: { Model } = {}
local hopperScanAt = -math.huge
local function nearestHopper(): BasePart?
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	-- the hopper list is rescanned at most every 5 s (this runs every 0.5 s during the sell tutorial step)
	if os.clock() - hopperScanAt >= HOPPER_RESCAN then
		hopperScanAt = os.clock()
		table.clear(hopperModels)
		for _, d in Workspace:GetDescendants() do
			if d:IsA("Model") and d:GetAttribute("Hopper") then
				table.insert(hopperModels, d)
			end
		end
	end
	local best, bestD = nil, math.huge
	for _, d in hopperModels do
		if not d:IsDescendantOf(Workspace) then
			continue
		end
		local body = d:FindFirstChild("Body") :: BasePart?
		if body then
			local dist = (body.Position - root.Position).Magnitude
			if dist < bestD and dist < 200 then
				best, bestD = body, dist
			end
		end
	end
	return best
end

local alcoveAnchor: Part? = nil
local function myAlcove(): BasePart?
	-- the plot model (shared/MapNames: Plot<i>, hand-built or the procedural fallback) and its yard floor
	local idx = player:GetAttribute("Alcove")
	if type(idx) ~= "number" then
		return nil
	end
	local a = Workspace:FindFirstChild(MapNames.plot(idx), true)
	-- the plot's gate sign, so the chip sits on a post instead of floating over the empty yard
	if a then
		for _, n in MapNames.PlotSign do
			local sign = a:FindFirstChild(n, true)
			local sp = if sign and sign:IsA("BasePart") then sign elseif sign and sign:IsA("Model") then sign.PrimaryPart or sign:FindFirstChildWhichIsA("BasePart", true) else nil
			if sp then
				return sp
			end
		end
	end
	local f = a and a:FindFirstChild(MapNames.PlotFloor, true)
	if f and f:IsA("BasePart") then
		return f
	end
	-- StreamingEnabled: the plot model can be here before its floor streams in (far plot). Mark its pivot with a
	-- local anchor until then; this runs every 0.5 s, so the real floor takes over once it arrives.
	if a and a:IsA("Model") then
		local anchor = alcoveAnchor
		if not anchor or not anchor.Parent then
			local p = Instance.new("Part")
			p.Name = "CT_Rocks_PlotMarker"
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Transparency = 1
			p.Size = Vector3.new(1, 1, 1)
			p.Parent = Workspace
			alcoveAnchor = p
			anchor = p
		end
		local pa = anchor :: Part
		local pos = a:GetPivot().Position
		if (pa.Position - pos).Magnitude > 0.5 then
			pa.Position = pos
		end
		return pa
	end
	return nil
end

-- Yellow outline on the own crushing table while the tutorial asks the player to go there.
local tableLight: Highlight? = nil
local function setTableHighlight(model: Model?)
	if not model then
		if tableLight then
			tableLight.Enabled = false
			tableLight.Adornee = nil
		end
		return
	end
	if not tableLight then
		local f = Instance.new("Folder")
		f.Name = "CT_Rocks_TableHighlight"
		f.Parent = Workspace
		local h = Instance.new("Highlight")
		h.FillTransparency = 1
		h.OutlineColor = Config.Palette.Yellow
		h.OutlineTransparency = 0.1
		h.DepthMode = Enum.HighlightDepthMode.Occluded
		h.Parent = f
		tableLight = h
	end
	local h = tableLight :: Highlight
	h.Adornee = model
	h.Enabled = true
end

local function updateMarker()
	local ob = onboarding()
	local prof = State.Profile
	local m = State.Match
	if player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true then
		setMarker(nil)
		setTableHighlight(nil)
		return
	end
	if not ob or not prof then
		setMarker(nil)
		setTableHighlight(nil)
		return
	end
	if inHunt(m) then
		-- arena: the table the tutorial points at (no lobby markers while hunting)
		local st = ownStation(m)
		local want = st ~= nil and m.Phase == "Searching" and not ob.Deposited and #st.Basket > 0 and prof.Settings.Hints ~= false
		setMarker(nil)
		setTableHighlight(if want then StationView.ownModel() else nil)
		return
	end
	setTableHighlight(nil)
	if not ob.Sold and prof.Rubble > 0 then
		setMarker(nearestHopper(), "SELL HERE")
	elseif ob.Geode and not ob.Displayed and not m then
		setMarker(myAlcove(), ParkConfig.YourPlot)
	else
		setMarker(nil)
	end
end

-- Boot --------------------------------------------------------------------------------------

Hud.setPanelOpener(openPanel)
Hud.build()
PileView.start()
PromptArbiter.start()
CameraGuard.start() -- third-person camera guard (the lobby; steps aside in first person)
CameraMode.start() -- third-person lobby / first-person hunt, cursor, modal stack, local visibility (docs/m11/CAMERA_SPAWN_FIX.md)
Reticle.start()
CarryGlimpse.start()
MachineView.start()
require(script.Parent.EggFx).start() -- egg wobble hint + speed boots badge / sparkles (cosmetic)
PileView.Claimed.Event:Connect(function(uid, ids, seconds)
	MachineView.batch(uid, #ids, seconds or 1)
end)
-- A machine-cracked rock: if the round then reports it as the find, the machine glints (below).
local machineCracks: { [number]: number } = {}
PileView.Cracked.Event:Connect(function(id, _mine, viaMachine, uid)
	if viaMachine and type(uid) == "number" then
		machineCracks[id] = uid
	end
end)
PileView.Notice.Event:Connect(function(text, kind)
	Hud.toast(text, kind)
end)
PartyPanel.start()
require(script.Parent.ui.PlayButton).start() -- lobby PLAY button and hunt-queue card (PartyAction Queue / Unqueue)
require(script.Parent.SelfHide).start() -- own avatar hidden in every fight view (Pet Battle, tower climb)
require(script.Parent.StarterEggView).start() -- the free starter egg next to the spawn (RetentionAction "Starter")
require(script.Parent.RetentionView).start() -- FREE GIFT timer, away nest card, friend gifts, level-up pops
require(script.Parent.SpinView).start() -- SPIN card: free spin wheel every 4 hours (server rolls and pays)
require(script.Parent.VoidStatueFx).start() -- the Void Dragon statue breathes, sparkles orbit, "1 in 1000" pulses
require(script.Parent.ui.NewsPopup).start() -- WHAT'S NEW pop-up, once per new version (shared/WhatsNew)
ShopPanel.start()
RobuxShopPanel.start()
PetShop.start()
require(script.Parent.HatchStandView).start() -- bought eggs hatch at the public hatch stand (cosmetic)
CollectionPanel.start()
MyPetsPanel.start()
MyPetsPanel.onDisplayFull = CollectionPanel.openPlacing
CollectionPanel.onTeamFull = MyPetsPanel.openSwap
Results.start()
InspectPanel.start()
require(script.Parent.UpgradePreview).start() -- client-local preview pedestal at the Upgrades counter
require(script.Parent.LobbyAmbience).start() -- lobby life: tree sway, waterfall, butterflies, birds (client only)
require(script.Parent.LodgeLight).start() -- warm interior fill while the camera is inside the lodge (client only)
require(script.Parent.PetFollow).start() -- equipped pets follow their owners (client only, cosmetic)
require(script.Parent.PetLevelFx).start() -- level-up ring + "LEVEL UP" over a following pet (client only)
require(script.Parent.PetDisplay).start() -- PetMotion on server-built mesh pets (bones do not replicate)
require(script.Parent.PetSparkle).start() -- rare pet sparkles follow the Low Effects setting (client only)
require(script.Parent.NameTag).start() -- lobby name tags: title + best tower floor (server attributes)
require(script.Parent.RainbowPath).start() -- rainbow trail + sparkles while walking on a lobby path
require(script.Parent.ui.RareBanner).start() -- rare hatch fireworks + gold banner (RareHatch remote)
require(script.Parent.CameraFx).start() -- lobby camera trail, boots FOV, the one shared shake helper (cosmetic)
require(script.Parent.RoundIntro).start() -- hunt whoosh, big 3-2-1-GO and camera swoop over the pile (cosmetic)
require(script.Parent.LobbyFlyover).start() -- one park fly-over for a brand-new player (cosmetic)
require(script.Parent.PhotoMode).start() -- lobby photo mode: hide UI, free orbit camera (cosmetic)
require(script.Parent.WorldFx).start() -- pedestal glow, water ripples, secret egg sparkle, zone weather (cosmetic)
require(script.Parent.HangoutView).start() -- lobby hangout: sky beam, status card, emotes (cosmetic)
require(script.Parent.HangoutAnim).start() -- lobby hangout animation: auras, sparkles, bobbing, flicker (cosmetic)
require(script.Parent.HiddenEggLocal).start() -- hidden eggs this player found disappear for them (audit F25)
require(script.Parent.YourPlotTag).start() -- "YOUR PLOT" over the player's own plot, their screen only (audit 2 #3)
-- lobby HUD v2 (carter's painted buttons, live 2026-10-15): each button opens what its old HUD button did
do
	local PlayButton = require(script.Parent.ui.PlayButton)
	local TowerPanel = require(script.Parent.ui.TowerPanel)
	local PvpPanel = require(script.Parent.ui.PvpPanel)
	local QuestPanel = require(script.Parent.ui.QuestPanel)
	local SpinView = require(script.Parent.SpinView)
	require(script.Parent.ui.LobbyHudV2).start({
		open = {
			Play = PlayButton.tap,
			Train = TowerPanel.openPicker,
			Fight = PvpPanel.openBattle,
			MyPets = function()
				openPanel("MyPets")
			end,
			PetBook = function()
				openPanel("PetIndex")
			end,
			Daily = QuestPanel.open,
			Spin = SpinView.openPanel,
			Shop = function()
				openPanel("RobuxShop")
			end,
		},
		status = PlayButton.status,
		hideOld = Hud.setLobbyHidden,
		claimable = function(): boolean
			return Hud.dailyReady(State.Profile) > 0
		end,
	})
end

local pendingDisplay = false
local foundAt: number? = nil
local revealPending = false -- the Reveal event arrived but the hero sequence has not started yet
Results.OnOpenPet = function(id: string)
	CollectionPanel.openOn(id)
end
local pendingTrain = false
Results.OnTutorialAction = function(kind: string)
	if kind == "Display" then
		pendingDisplay = true
	elseif kind == "Train" then
		pendingTrain = true
	end
	Hud.hintDismissed = nil
	State.update("Profile")
end

-- the goal step is recorded when the shop opens or the goal hint's OK is tapped
UI.ModalChanged.Event:Connect(function(name)
	Audio.setMenuOpen(name ~= nil) -- sounds a bit quieter while a menu is open
	if name == "Shop" then
		local ob = onboarding()
		if ob and ob.Displayed and not ob.Goal then
			Net.event("TutorialAction"):FireServer("Goal")
		end
	end
end)
task.spawn(function()
	while true do
		task.wait(0.5)
		local d = Hud.hintDismissed
		if d and string.sub(d, 1, #GOAL_TEXT_PREFIX) == GOAL_TEXT_PREFIX then
			local ob = onboarding()
			if ob and not ob.Goal then
				Net.event("TutorialAction"):FireServer("Goal")
			end
		end
		updateMarker()
		syncMarkerVisible() -- the objective card comes and goes with the HUD refresh (cue timeout, party)
	end
end)

-- Slow device: after the profile loads, average the frame rate for 10 s; if it stays low, suggest LOW EFFECTS once with
-- a toast. The setting is saved on the server, so this never changes it for the player.
task.spawn(function()
	local RunService = game:GetService("RunService")
	while not State.Profile do
		task.wait(0.5)
	end
	task.wait(12) -- let the load and lobby streaming hitch pass
	local frames, t0 = 0, os.clock()
	local conn = RunService.Heartbeat:Connect(function()
		frames += 1
	end)
	task.wait(10)
	conn:Disconnect()
	local fps = frames / math.max(os.clock() - t0, 1)
	local prof = State.Profile
	if fps < 22 and prof and not prof.Settings.LowEffects then
		Hud.toast("Game feels slow? Turn on LOW EFFECTS in Settings!", "info")
	end
end)

-- World prompts with a Panel attribute open that panel locally.
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local panel = prompt:GetAttribute("Panel")
	if type(panel) == "string" and panel ~= "" then
		openPanel(panel)
	end
end)

local secretEggHidden = false
Net.event("ProfileState").OnClientEvent:Connect(function(view)
	if view.Inventory == nil then
		-- light update: inventory unchanged since the last full sync
		view.Inventory = if State.Profile then State.Profile.Inventory else {}
	end
	State.Profile = view
	UI.Reduced = view.Settings and view.Settings.ReducedMotion == true
	-- Camera sensitivity (mouse look): scales the mouse delta the camera reads; 0.5 = Roblox default speed
	local sens = view.Settings and tonumber(view.Settings.CameraSensitivity)
	if sens then
		pcall(function()
			UserInputService.MouseDeltaSensitivity = math.clamp(sens * 2, 0.1, 2)
		end)
	end
	State.update("Profile")
	-- the secret egg is found: its prompt no longer invites a "Take" for this player (the server refuses a second one)
	if view.SecretEggFound and not secretEggHidden then
		local name = require(Shared.MapNames).SecretEggPrompt
		for _, d in Workspace:GetDescendants() do
			if d:IsA("ProximityPrompt") and d.Name == name then
				d.Enabled = false
			end
		end
		secretEggHidden = true -- one scan (StreamingEnabled is off, so the egg is already here)
	end
end)

Net.event("PartyState").OnClientEvent:Connect(function(party, invites)
	local had = State.Party ~= nil
	State.Party = party
	State.Invites = invites or {}
	State.update("Party")
	if party and not had and not State.Match and UI.modalOpen() == nil then
		openPanel("Party")
	end
end)

Net.event("Toast").OnClientEvent:Connect(function(text, kind)
	Hud.toast(text, kind) -- one coalesced notification, drawn above any open menu
	-- ok = purchase / unlock, cash = daily gift / quest reward, rare = Lucky Meter etc., warn = refused (shared/SoundCues)
	local key = require(Shared.SoundCues).toast(text, kind)
	if key then
		Audio.play(key)
	end
end)

-- Cosmetic feedback from the server (sales).
Net.event("Fx").OnClientEvent:Connect(function(kind, data)
	if kind == "SecretEgg" then
		-- the hidden lobby egg: a big banner and confetti (a small toast undersold it)
		Juice.banner("YOU FOUND THE SECRET EGG!", nil, 3.2)
		Effects.confetti()
		Audio.play("ShopKaChing")
		return
	end
	if kind == "Sell" and typeof(data.Pos) == "Vector3" then
		Audio.play("ShellPop")
		-- the flying coins reach the cash counter after about 0.75 s (Effects.cashFly); PetSoundIds.CoinPickup, 0 = silent
		task.delay(0.75, Audio.play, "CoinPickup", { Volume = 0.8 })
		Audio.play("GravelSpill", { Pos = data.Pos, Volume = 0.7 })
		Effects.cashFly(data.Pos, tonumber(data.Total) or 1)
	end
	if kind == "Sell" and typeof(data.Pos) == "Vector3" and not (State.Profile and State.Profile.Settings.LowEffects) then
		-- a few gravel bits drop into the hopper grate
		for i = 1, 6 do
			local p = Instance.new("Part")
			p.Size = Vector3.one * 0.5
			p.Color = Config.Palette.Rock
			p.Material = Enum.Material.Slate
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CFrame = CFrame.new(data.Pos + Vector3.new((i - 3.5) * 0.6, 5, 0))
			p.Parent = Workspace
			TweenService:Create(p, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(data.Pos + Vector3.new((i - 3.5) * 0.3, 1.5, 0)), Transparency = 1 }):Play()
			task.delay(0.5, function()
				p:Destroy()
			end)
		end
	end
end)

Net.event("MatchEvent").OnClientEvent:Connect(function(kind, data)
	if kind == "Init" then
		CameraMode.restore()
		CarryGlimpse.setSeed(data.Seed or 1)
		UI.closeModal()
		Results.hide()
		State.Results = nil
		State.Match = {
			Key = data.Key,
			Round = data.Round,
			Tier = data.Tier,
			Tutorial = data.Tutorial,
			Rocks = data.Rocks,
			Remaining = data.Rocks - #(data.Removed or {}),
			Phase = data.Phase,
			EndsAt = data.EndsAt,
			Members = data.Members,
			MyCracked = 0,
			SearchStart = data.SearchStart,
			SearchEnd = data.SearchEnd,
			Machines = data.Machines or {},
			Stations = data.Stations,
			Counts = data.Counts,
			Tables = data.Tables,
			Center = data.Center, -- pile centre (RoundIntro camera swoop)
		}
		foundAt = nil
		PileView.init(data)
		require(script.Parent.HatchFx).setPile(data.Center) -- Rare+ fireworks go up above the pile
		MachineView.setStates(data.Machines or {})
		State.update("Match")
	elseif kind == "Phase" then
		local m = State.Match
		if not m or data.Round ~= m.Round then
			return
		end
		m.Phase = data.Phase
		m.EndsAt = data.EndsAt
		m.Members = data.Members
		-- the hunt clock is the server's: it starts at Searching and stops when the geode is found
		if data.SearchStart then
			m.SearchStart = data.SearchStart
		elseif data.Phase == "Searching" and not m.SearchStart then
			m.SearchStart = Workspace:GetServerTimeNow()
		end
		m.SearchEnd = data.SearchEnd
		State.update("Match")
	elseif kind == "Members" then
		if State.Match then
			State.Match.Members = data.Members
			State.update("Match")
		end
	elseif kind == "Machines" then
		local m = State.Match
		if m and data.Round == m.Round then
			m.Machines = data.List
			MachineView.setStates(data.List)
			State.update("Match")
		end
	elseif kind == "Surprise" then
		-- surprise eggs (shared/HuntFun): the prize is already paid; this only shows it over the own nest
		local m = State.Match
		if m and data.Round == m.Round then
			SurprisePop.show(data)
		end
	elseif kind == "MaterialFound" then
		-- a first-time material for this player, told after their own crush completed (Hud merges bursts)
		local m = State.Match
		if m and data.Round == m.Round and type(data.New) == "table" then
			Hud.materialNotice(data.New)
			Audio.materialFound()
		end
	elseif kind == "Rocks" then
		PileView.onRocks(data)
	elseif kind == "RockReply" then
		local m = State.Match
		if not m or data.Round ~= m.Round then
			return
		end
		PileView.onReply(data)
		if data.Action == "Deposit" and data.Ok then
			if (data.Moved or 0) > 0 then
				Audio.deposit()
			end
			if (data.Left or 0) > 0 then
				Hud.toast("Deposited " .. (data.Moved or 0) .. "! " .. data.Left .. " still in your basket!", "info")
			end
		elseif not data.Ok then
			local text = ({
				BasketFull = "Basket full! Take your eggs to your nest.",
				QueueFull = "Nest is full! Hatch some eggs first.",
				TooFar = "Walk closer!",
				Unreachable = "Too high! Find a lower egg.",
				NoSight = "Blocked! Move to see the egg.",
				Gone = "Too slow! Try another egg.",
				Automatic = "Your Auto Nest hatches for you! Bring it eggs.",
			})[data.Reason]
			if text then
				Hud.toast(text, "info")
			end
		end
	elseif kind == "Found" then
		local m = State.Match
		if m and data.Round == m.Round then
			m.Phase = "RewardPending"
			m.WinnerName = data.WinnerName
			foundAt = os.clock()
			Audio.play("PetFound") -- everyone hears the find; the winner's reveal adds its own stings later
			require(script.Parent.CameraFx).shake(if data.Winner == Players.LocalPlayer.UserId then 1 else 0.45, 0.45) -- big moment
			if data.Winner == Players.LocalPlayer.UserId then
				require(script.Parent.PetFollow).celebrate(Players.LocalPlayer) -- your pets dance for the win
				-- the camera leaves first person for a close look at your nest while the pet egg opens on it
				HatchFocus.start(StationView.platePosition(Players.LocalPlayer.UserId))
			end
			local winner = if type(data.Winner) == "number" then Players:GetPlayerByUserId(data.Winner) else nil
			if winner and winner.Character then
				require(script.Parent.PlayerCheer).play(winner.Character) -- the winner's avatar cheers
			end
			PileView.clearReserved()
			local viaMachine = machineCracks[data.RockId]
			if viaMachine then
				MachineView.recovered(viaMachine)
			end
			table.clear(machineCracks)
			MachineView.stop()
			PileView.stopAll()
			PileView.clearSelection()
			Hud.clearMessages() -- nothing from the search stays over the find and the reveal
			State.update("Match")
		end
	elseif kind == "Reveal" then
		State.Results = data
		if type(data.Winner) == "number" and type(data.Specimen) == "table" then
			StationView.showSpecimen(data.Winner, data.Specimen)
		end
		PileView.clearPile()
		require(script.Parent.HatchFx).onReveal(data) -- Rare+: rainbow ring from the nest, fireworks above the pile
		-- let the geode finish opening on the plate before the reveal screen takes over
		local wait = if foundAt and not UI.Reduced and os.clock() - foundAt < 6 then StationView.fxRemaining() + 1.8 else 0
		revealPending = wait > 0
		task.delay(wait, function()
			if State.Results == data then
				revealPending = false
				HatchFocus.stop() -- the nest close-up hands over to the full-screen reveal card
				Results.reveal(data)
			end
		end)
		State.update("Results")
	elseif kind == "Results" then
		HatchFocus.stop()
		CameraMode.restore() -- the reveal never leaves a presentation camera behind
		State.Results = data
		if State.Match then
			State.Match.Phase = "Results"
		end
		State.update("Match")
		-- The server's reveal timer (Config.Match.RevealSeconds) starts at the Reveal event, but the client
		-- first lets the geode finish opening on the plate, so the hero sequence can still be running here.
		-- Open the results card only once it reached its final frame (or was skipped), never over its
		-- middle. Bounded: after 12 s it opens regardless (a Rare+ hatch plays about 6 s, Config.Hatch).
		task.spawn(function()
			local waited = 0
			while (revealPending or RevealView.isPlaying()) and waited < 12 and State.Results == data do
				task.wait(0.1)
				waited += 0.1
			end
			-- the finished specimen stays on screen for a moment (a tap closes it sooner)
			local held = 0
			while RevealView.isOpen() and held < 1.5 and State.Results == data do
				task.wait(0.1)
				held += 0.1
			end
			if State.Results == data then
				Results.open()
			end
		end)
	elseif kind == "ResultsBag" then
		-- a hopper sale after the snapshot: only the bag figures change (hunt counters stay as the server froze them)
		local res = State.Results
		if res and type(data) == "table" and data.Round == res.Round and type(data.Bag) == "table" then
			for _, mem in res.Members do
				if mem.UserId == player.UserId then
					mem.BagCount, mem.BagCapacity, mem.BagValue = data.Bag.Count, data.Bag.Capacity, data.Bag.Value
				end
			end
			State.update("Results")
		end
	elseif kind == "Left" then
		HatchFocus.stop()
		CameraMode.restore() -- back in the lobby: the camera on the current humanoid, never an arena camera (third person once State.Match clears)
		CarryGlimpse.clear()
		revealPending = false
		Effects.clear()
		Results.hide()
		UI.closeModal()
		PileView.leave()
		MachineView.clear()
		foundAt = nil
		table.clear(machineCracks)
		State.Match = nil
		State.Results = nil
		State.update("Match")
		if pendingTrain then
			-- TRAIN PET on the practice results: the loop's next step opens as soon as the lobby is back
			pendingTrain = false
			task.delay(0.8, function()
				require(script.Parent.ui.PvpPanel).openTrain()
			end)
		end
		if pendingDisplay then
			pendingDisplay = false
			task.delay(0.6, function()
				-- open on the newest specimen with SHOW IN GALLERY ready
				local newest, t = nil, -1
				for _, g in (State.Profile and State.Profile.Inventory or {}) do
					if g.Found > t then
						newest, t = g.Id, g.Found
					end
				end
				CollectionPanel.openOn(newest)
			end)
		end
	end
end)

LaunchPanel.start() -- Teleport mode cards; idle in the default single-place mode

Net.event("ClientReady"):FireServer()
if player:GetAttribute("MatchKey") then
	Net.event("MatchAction"):FireServer("Sync")
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="309">
          <Properties>
            <string name="Name">NameTag</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby name tags (owner pick, client only, cosmetic). Over every player's head in the lobby: the display name, the
-- title (gold, e.g. "Pet Master") and the best pet tower floor. The server decides both and puts them on the Player
-- as attributes "Title" and "TowerBest" (server PetIndex); this only draws them. Hidden while that player is in a
-- hunt (attribute MatchKey set) or the pet tower (InTower) so the view stays clear; while our tag shows, Roblox's own name over that
-- character is hidden locally so the name is not drawn twice.
-- The tag is middle-sized (the big one covered the pet and props in front of the player, the small one read faint on a
-- phone: bug #219) and fades out only while the camera is really close to that head (FADE_FAR -> FADE_NEAR studs), so
-- a zoomed-in view of your own pet is never hidden behind your name while the default zoom shows it fully.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PetFlair = require(Shared.PetFlair)
local UI = require(script.Parent.ui.UI)

local NameTag = {}

local C = UI.Colors
local LINE = 18
local NAME_H = 23
local WIDTH = 180
local FADE_FAR = 10 -- studs from the camera: fully shown beyond this (Roblox's default zoom is 12.5: no fade)
local FADE_NEAR = 5 -- studs: fully hidden at or inside this

type Entry = { Gui: BillboardGui?, Conns: { RBXScriptConnection } }
local entries: { [Player]: Entry } = {}

local function clear(e: Entry)
	if e.Gui then
		e.Gui:Destroy()
		e.Gui = nil
	end
end

local function setDefaultName(char: Model?, hide: boolean)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = if hide then Enum.HumanoidDisplayDistanceType.None else Enum.HumanoidDisplayDistanceType.Viewer
	end
end

local function rebuild(player: Player, e: Entry)
	clear(e)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not char or not head or not head:IsA("BasePart") then
		return
	end
	if player:GetAttribute("MatchKey") ~= nil then
		setDefaultName(char, false)
		return -- lobby only
	end
	if player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true then
		setDefaultName(char, true)
		return -- in the pet tower no name floats over the fight (it sat behind LEAVE and the pets' bars)
	end
	local battle = PetFlair.battleLine(player:GetAttribute("TeamPower"), player:GetAttribute("Trophies"), player:GetAttribute("PvpStreak"))
	local lines = PetFlair.tagLines(player:GetAttribute("TowerBest"), player:GetAttribute("Title"), battle)
	local bb = Instance.new("BillboardGui")
	bb.Name = "LobbyNameTag"
	bb.Adornee = head
	bb.Size = UDim2.fromOffset(WIDTH, NAME_H + #lines * LINE)
	bb.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y * 0.5 + 1.4, 0)
	bb.MaxDistance = 60
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.ResetOnSpawn = false
	-- every line keeps the full dark outline (UI.text thins it on small text): pale words vanished on the snow
	-- VIP pass (server attribute VIP): the name in gold with a VIP badge
	local vip = player:GetAttribute("VIP") == true
	local nameLabel = UI.text(bb, if vip then "[VIP] " .. player.DisplayName else player.DisplayName, {
		Name = "PlayerName", Font = UI.Bold, TextSize = 16, Outline = "Strong", TextColor3 = if vip then C.Gold else Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, NAME_H),
	})
	UI.outline(nameLabel, "Strong")
	for i, line in lines do
		local isTitle = i == 1 and line == player:GetAttribute("Title")
		local isBattle = line == battle
		local lineLabel = UI.text(bb, line, {
			Name = if isTitle then "Title" elseif isBattle then "Battle" else "Floor", Font = UI.Bold, TextSize = 14, Outline = "Strong",
			TextColor3 = if isTitle then C.Gold elseif isBattle then Color3.fromRGB(255, 196, 120) else Color3.fromRGB(200, 236, 255),
			TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, NAME_H + (i - 1) * LINE), Size = UDim2.new(1, 0, 0, LINE),
		})
		UI.outline(lineLabel, "Strong")
	end
	bb.Parent = head
	e.Gui = bb
	setDefaultName(char, true)
end

local function track(player: Player)
	if entries[player] then
		return
	end
	local e: Entry = { Gui = nil, Conns = {} }
	entries[player] = e
	local function again()
		rebuild(player, e)
	end
	for _, attr in { "Title", "TowerBest", "MatchKey", "InTower", "InBattle", "TeamPower", "Trophies", "PvpStreak", "VIP" } do
		table.insert(e.Conns, player:GetAttributeChangedSignal(attr):Connect(again))
	end
	table.insert(e.Conns, player.CharacterAdded:Connect(function(char)
		char:WaitForChild("Head", 10)
		again()
	end))
	table.insert(e.Conns, player.CharacterRemoving:Connect(function()
		clear(e)
	end))
	again()
end

local function untrack(player: Player)
	local e = entries[player]
	if not e then
		return
	end
	for _, c in e.Conns do
		c:Disconnect()
	end
	clear(e)
	entries[player] = nil
end

-- info boards players walk up to read (audit F26); positions refreshed now and then (the winners board is built late)
local INFO_BOARDS = { "WhatsNewBoard", "CT_WinnersNoticeBoard" }
local INFO_NEAR = 18
local boardPos: { Vector3 } = {}
local boardsAt = -math.huge
local function nearInfoBoard(at: Vector3): boolean
	if os.clock() - boardsAt > 3 then
		boardsAt = os.clock()
		table.clear(boardPos)
		for _, name in INFO_BOARDS do
			local b = Workspace:FindFirstChild(name, true)
			if b and b:IsA("Model") then
				table.insert(boardPos, b:GetPivot().Position)
			elseif b and b:IsA("BasePart") then
				table.insert(boardPos, b.Position)
			end
		end
	end
	for _, q in boardPos do
		if (Vector3.new(q.X, at.Y, q.Z) - at).Magnitude < INFO_NEAR then
			return true
		end
	end
	return false
end

local started = false
function NameTag.start()
	if started then
		return
	end
	started = true
	-- fade each tag by its distance to the camera (a few times a second is enough; writes only on change)
	local clock = 0
	RunService.Heartbeat:Connect(function(dt)
		clock += dt
		if clock < 0.08 then
			return
		end
		clock = 0
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local camPos = cam.CFrame.Position
		for p, e in entries do
			local bb = e.Gui
			local head = bb and bb.Adornee
			if not bb or not head or not head:IsA("BasePart") then
				continue
			end
			local d = (head.Position - camPos).Magnitude
			local k = math.clamp((FADE_FAR - d) / (FADE_FAR - FADE_NEAR), 0, 1)
			if p == Players.LocalPlayer and nearInfoBoard(head.Position) then
				k = 1 -- audit F26: your own tag sat right over the board text on a walk-up; others still see it
			end
			local tr = math.floor(k * 10 + 0.5) / 10 -- tenths, so small camera moves write nothing
			bb.Enabled = tr < 1
			for _, l in bb:GetChildren() do
				if l:IsA("TextLabel") and l.TextTransparency ~= tr then
					l.TextTransparency = tr -- UI.outline keeps the outline in step
				end
			end
		end
	end)
	for _, p in Players:GetPlayers() do
		task.spawn(track, p)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(untrack)
end

return NameTag
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="310">
          <Properties>
            <string name="Name">PetDisplay</string>
            <string name="Source"><![CDATA[--!strict
-- Animates server-built mesh pets on the client (plots, domes, hatch stands, gallery shelves). Bone.Transform does
-- not replicate, so the server's copies stand still unless each client starts PetMotion on them. Server-built
-- template pets are tagged "PetDisplay" (PetModel.fromTemplate on the server; other builders may tag their own).
-- Followers are built on the client and started by PetFollow, so they are not tagged. Nothing happens when
-- PetModels / PetMotion are missing (PetMotionBridge). Display pets turn their heads toward the nearest player walking
-- by (within LOOK_RANGE studs; the "LookAt" model attribute PetMotion eases toward), five times a second.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Bridge = require(script.Parent.PetMotionBridge)

local PetDisplay = {}

local TAG = "PetDisplay"
local started: { [Instance]: boolean } = setmetatable({} :: any, { __mode = "k" })

local function try(inst: Instance)
	if started[inst] or not inst:IsA("Model") or not inst:IsDescendantOf(Workspace) then
		return
	end
	if Bridge.start(inst) then
		started[inst] = true
	end
end

-- Dome pets (tag "PetSpin", set by GalleryService) turn slowly on the spot. Local only; nearby ones only.
local SPIN_TAG = "PetSpin"
local SPIN_RATE = 0.35 -- radians per second
local SPIN_RANGE = 90
local spinning: { [Model]: CFrame } = setmetatable({} :: any, { __mode = "k" })

local function stepSpin(dt: number)
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	for m, base in spinning do
		if not m.Parent then
			spinning[m] = nil
			continue
		end
		local pos = base.Position
		if (pos - camPos).Magnitude < SPIN_RANGE then
			local base2 = base * CFrame.Angles(0, os.clock() * SPIN_RATE, 0)
			if not Bridge.setBase(m, base2) then -- PetMotion re-pivots mesh pets from its base every frame
				m:PivotTo(base2)
			end
		end
	end
end

local function trySpin(inst: Instance)
	if inst:IsA("Model") and inst:IsDescendantOf(Workspace) and not spinning[inst] then
		spinning[inst] = inst:GetPivot()
	end
end

-- Passer-by look: the nearest character head within LOOK_RANGE of each animated display pet near the camera.
local LOOK_RANGE = 20
local LOOK_EVERY = 0.2
local lookSet: { [Instance]: Vector3? } = setmetatable({} :: any, { __mode = "k" })
local lookClock = 0
local heads: { Vector3 } = {}

local function stepLook(dt: number)
	lookClock += dt
	if lookClock < LOOK_EVERY then
		return
	end
	lookClock = 0
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	table.clear(heads)
	for _, pl in Players:GetPlayers() do
		local head = pl.Character and pl.Character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			table.insert(heads, head.Position)
		end
	end
	for inst in started do
		if not inst:IsA("Model") or not inst.Parent then
			continue
		end
		local pos = inst:GetPivot().Position
		local want: Vector3? = nil
		if (pos - camPos).Magnitude < SPIN_RANGE and not spinning[inst] then
			local best = LOOK_RANGE * LOOK_RANGE
			for _, h in heads do
				local d = h - pos
				local d2 = d:Dot(d)
				if d2 < best then
					best = d2
					want = h
				end
			end
		end
		local had: Vector3? = lookSet[inst]
		if want ~= had and (want == nil or had == nil or ((want :: Vector3) - (had :: Vector3)).Magnitude > 0.25) then
			lookSet[inst] = want
			inst:SetAttribute("LookAt", want)
		end
	end
end

local running = false
function PetDisplay.start()
	if running then
		return
	end
	running = true
	for _, inst in CollectionService:GetTagged(SPIN_TAG) do
		trySpin(inst)
	end
	CollectionService:GetInstanceAddedSignal(SPIN_TAG):Connect(function(inst)
		task.defer(trySpin, inst)
	end)
	CollectionService:GetInstanceRemovedSignal(SPIN_TAG):Connect(function(inst)
		if inst:IsA("Model") then
			spinning[inst] = nil
		end
	end)
	game:GetService("RunService").Heartbeat:Connect(stepSpin)
	game:GetService("RunService").Heartbeat:Connect(stepLook)
	for _, inst in CollectionService:GetTagged(TAG) do
		try(inst)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(inst)
		task.defer(try, inst) -- after the model's parts have streamed in with it
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(inst)
		started[inst] = nil
	end)
end

return PetDisplay
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="311">
          <Properties>
            <string name="Name">PetFollow</string>
            <string name="Source"><![CDATA[--!strict
-- Equipped pets following their owners (client only, purely cosmetic). The server sets on each Player the attribute
-- "PetsShown" = JSON array of { Id, Mineral, Rarity, Modifier, Formation, Seed, Mass }. For every player this builds
-- the pets with PetModel (small scale, no lights) and, every frame, eases each one toward a slot behind / beside the
-- character with a little hop while it moves. Anchored parts moved with PivotTo; no physics, nothing sent anywhere.
-- A small name tag (type icon on a glow pill in the type colour, then the nickname or rarity word + pet name in the
-- rarity text colour) floats over each follower, which also stands on a soft neon disc in its type colour, visible within
-- 35 studs only so a full server never clutters the screen. In a hunt only the one pet helper follows (marked Helper
-- by the server, shared/HuntFun); none in the pet tower or a Pet Battle. A pet that comes within FADE_NEAR studs of the camera, or sits
-- between the camera and the local character's head, fades out locally (LocalTransparencyModifier) so it never
-- blocks the view. Rebuilt on attribute change; cleaned up when a player leaves or respawns. When the owner stops,
-- the pets turn to look at them. PetFx adds a ground shadow, the breathing rarity aura, Golden / Rainbow shimmer,
-- a per-element particle trait, dust thumps for heavy pets and the level-up ring (PetLevelFx via PetFollow.modelFor).
-- Small touches: pets hop when the owner jumps, bank into turns, spin on a level up (PetFollow.spin), get sleepy (head
-- droop + "Zzz") after the owner stands still SLEEP_AFTER seconds, float hearts when equipped and shrink away in a poof
-- when unequipped (PetMoodFx). Mesh pets also get "LookAt" (owner's head while stopped), "Sleepy" and "WalkRate"
-- (step speed, faster with speed boots) model attributes for PetMotion.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PetModel = require(Shared.PetModel)
local GeodeGen = require(Shared.GeodeGen)
local Config = require(Shared.Config)
local PetRules = require(Shared.PetRules)
local PetFlair = require(Shared.PetFlair)
local Rules = require(Shared.PetFxRules)
local UI = require(script.Parent.ui.UI)
local PetFx = require(script.Parent.PetFx)
local State = require(script.Parent.State)
local PetMoodFx = require(script.Parent.PetMoodFx)
local MotionBridge = require(script.Parent.PetMotionBridge)

local PetFollow = {}

-- Optional: the owner's ReplicatedStorage.PetMotion (walk / idle animation for the real pet meshes). API used:
-- start(model), setBase(model, cframe), model attribute "Moving". Missing module = the built-in hop below.
local Motion: any = nil
do
	local mod = game:GetService("ReplicatedStorage"):FindFirstChild("PetMotion")
	if mod and mod:IsA("ModuleScript") then
		local ok, res = pcall(require, mod)
		if ok and type(res) == "table" and type(res.start) == "function" and type(res.setBase) == "function" then
			Motion = res
		end
	end
end

local SCALE = 2.1 -- owner 2026-10-12: pets 3x the old size (PS99 style)
local TYPE_ICON = { Coins = "boostCoins", Speed = "boostSpeed", Luck = "boostLuck" }
-- slots in the character's local space (x right, z behind)
local SLOTS = { Vector3.new(7, 0, 8), Vector3.new(-7, 0, 8), Vector3.new(0, 0, 12.5) }
-- bug 243: every follower is normalised to one height (about an avatar's chest) whatever its species or SizeBoost,
-- and its footprint is capped so wide wings (Griffin) never reach the owner; mass varies it only a little
local FOLLOW_H = 4.6 -- studs
local FOLLOW_W = 7 -- studs: widest footprint a follower may have

local FADE_NEAR = 3.5 -- studs from the camera
local FADE_LINE = 1.5 -- studs from the camera -> head segment
local FAR_FX = 60 -- studs from the camera: beyond this a pet's effects and animation updates are skipped
local FAR_FX_BACK = 52 -- hysteresis: effects come back inside this distance
local SNAP_FAR = 40 -- studs: a pet left this far behind snaps to its slot with a poof
local SLEEP_AFTER = 30 -- s of the owner standing still before the pets get sleepy
local JUMP_TIME = 0.5 -- s of a follower's hop when the owner jumps
local SPIN_TIME = 0.6 -- s of the level-up spin
local FLYERS = { dragon = true, griffin = true, phoenix = true, pterodactyl = true, wyvern = true }

type Pet = { Id: any, Fx: PetFx.Fx?, Model: Model, Pos: Vector3, Look: Vector3, Phase: number, Height: number, Parts: { BasePart }, Tag: BillboardGui?, CentreY: number, Fade: number, Flying: boolean, Size: number, Far: boolean, Eyes: { BasePart }, EyeSizes: { Vector3 }, NextBlink: number, BlinkEnd: number, HopS: number,
	JumpT: number, BounceT: number, SpinT: number, Bank: number, Droop: number, Sleepy: boolean, EyesShut: boolean, Zzz: BillboardGui?, LookSet: Vector3?, Rate: number }

-- Happy bounce for one follower: the hop (step) and PetFx's squash and star sparkle. Reduce Motion: no hop.
local function startBounce(p: Pet)
	if not (UI.Reduced or (State.Profile and State.Profile.Settings and State.Profile.Settings.ReducedMotion == true)) then
		p.BounceT = os.clock()
	end
	pcall(PetFx.happy, p.Model)
end
-- Known: pet ids last shown (nil until the first list arrives, so joining never plays the equip hearts)
type Entry = { Pets: { Pet }, Raw: string?, Conns: { RBXScriptConnection }, Spread: number, Air: number, Known: { [string]: boolean }?, WasJump: boolean, Still: number }

local entries: { [Player]: Entry } = {}
local folder: Folder? = nil


-- Followers walk with the player all the time, so their effects stay quiet: the engine Sparkles (a dense star spray)
-- become a few small, slow glints, and the soft rarity aura ring is fainter. Rewards, hits and hatches keep the
-- strong bursts (owner review 2026-10-12: idle walking looked like a reward going off).
local function calmFx(m: Model)
	for _, d in m:GetDescendants() do
		if d:IsA("Sparkles") then
			local e = Instance.new("ParticleEmitter")
			e.Name = "CalmSparkle"
			e.Color = ColorSequence.new(d.SparkleColor)
			e.LightEmission = 0.6
			e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.18), NumberSequenceKeypoint.new(1, 0) })
			e.Transparency = NumberSequence.new(0.2, 1)
			e.Lifetime = NumberRange.new(0.6, 0.9)
			e.Rate = 1.5
			e.Speed = NumberRange.new(0.2, 0.5)
			e.SpreadAngle = Vector2.new(180, 180)
			e.Enabled = d.Enabled
			CollectionService:AddTag(e, "PetSparkle") -- Low Effects still turns it off (PetSparkle)
			e.Parent = d.Parent
			d:Destroy()
		elseif d:IsA("BasePart") and d.Name == "Aura" then
			d.Transparency = math.max(d.Transparency, 0.8)
		end
	end
end

-- Dust puffs at the feet of big pets while they walk (owner's low-poly puff, IMPORT_NOW5 DustPuff_tex). Only pets
-- about the player's height or taller get them; none with Low Effects.
local DUST_TEX = "rbxassetid://135782428554903"
local function dust(m: Model, on: boolean)
	local root = m.PrimaryPart
	if not root then
		return
	end
	local e = root:FindFirstChild("WalkDust", true) :: ParticleEmitter?
	if not e then
		if not on then
			return
		end
		local cf, size = m:GetBoundingBox()
		if size.Y < 5 then
			return
		end
		local a = Instance.new("Attachment")
		a.Name = "WalkDustAt"
		a.Parent = root
		a.WorldPosition = Vector3.new(cf.X, cf.Y - size.Y / 2 + 0.2, cf.Z)
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "WalkDust"
		pe.Texture = DUST_TEX
		pe.Rate = 6
		pe.Lifetime = NumberRange.new(0.4)
		pe.Speed = NumberRange.new(0.5, 1.2)
		pe.SpreadAngle = Vector2.new(60, 20)
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 3) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		pe.LightInfluence = 0.6
		pe.Parent = a
		e = pe
	end
	if e then
		-- (not tagged PetSparkle: that would switch it on while standing still) Low Effects: no dust
		local prof = State.Profile
		local low = prof ~= nil and prof.Settings ~= nil and prof.Settings.LowEffects == true
		e.Enabled = on and not low
	end
end

local function ensureFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "CTR_Pets"
	f.Parent = Workspace
	folder = f
	return f
end

local function clearPets(e: Entry)
	for _, p in e.Pets do
		p.Model:Destroy()
		if p.Fx then
			PetFx.destroy(p.Fx)
		end
	end
	table.clear(e.Pets)
	e.Spread = 1
end

-- rarity rank for slot order (rarest first)
local function rankOf(spec: any): number
	local r = if type(spec) == "table" then tostring(spec.Rarity) else ""
	return table.find(Config.Rarities :: any, r) or 0
end

-- Shortest-arc turn of a flat direction toward `want` (no snap when the target flips sideways or backwards).
local function turnToward(look: Vector3, want: Vector3, k: number): Vector3
	local a = math.atan2(look.X, look.Z)
	local d = (math.atan2(want.X, want.Z) - a + math.pi) % (2 * math.pi) - math.pi
	a += d * math.min(1, k)
	return Vector3.new(math.sin(a), 0, math.cos(a))
end

local function rebuild(player: Player, e: Entry)
	local raw = player:GetAttribute("PetsShown")
	e.Raw = if type(raw) == "string" then raw else nil
	local list: any = nil
	if type(raw) == "string" and raw ~= "" and raw ~= "[]" then
		local ok, res = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		list = if ok and type(res) == "table" then res else nil
	end
	-- equip / unequip touches: only for a real change, not the hunt / tower hiding every follower (server rule)
	local hidden = (player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true) or State.Teleport == true
	-- in a hunt only the pet helper follows (owner pick 2026-10-15, server Profiles.huntHelper marks it Helper); the
	-- lobby list may still be on its way when the hunt starts, so anything not marked Helper stays hidden there
	local inHunt = player:GetAttribute("MatchKey") ~= nil or (player == Players.LocalPlayer and State.Match ~= nil)
	if inHunt and list then
		local keep = {}
		for _, spec in list :: { any } do
			if type(spec) == "table" and spec.Helper == true and #keep < 1 then
				table.insert(keep, spec)
			end
		end
		list = if #keep > 0 then keep else nil
	end
	local newIds: { [string]: boolean } = {}
	for _, spec in (list or {}) :: { any } do
		if type(spec) == "table" and spec.Id ~= nil then
			newIds[tostring(spec.Id)] = true
		end
	end
	if hidden then
		-- no followers in the pet tower or a Pet Battle (the fighting pets are the show there)
		list = nil
	end
	local known = if hidden or inHunt then nil else e.Known -- entering or leaving a hunt is not an equip change
	if known then
		for i = #e.Pets, 1, -1 do
			local p = e.Pets[i]
			if p.Id ~= nil and not newIds[tostring(p.Id)] then
				table.remove(e.Pets, i)
				if p.Fx then
					PetFx.destroy(p.Fx)
				end
				dust(p.Model, false)
				PetMoodFx.shrinkAway(p.Model)
			end
		end
	end
	if not hidden and not inHunt and type(raw) == "string" then
		e.Known = newIds
	end
	clearPets(e)
	if not list then
		return
	end
	-- equipped pets sit in slots by rarity: the rarest first (stable for equal rarities)
	local ordered: { any } = {}
	for k, spec in list :: { any } do
		ordered[k] = { Spec = spec, K = k }
	end
	table.sort(ordered, function(a, b)
		local ra, rb = rankOf(a.Spec), rankOf(b.Spec)
		if ra ~= rb then
			return ra > rb
		end
		return a.K < b.K
	end)
	for i, o in ordered do
		local spec = o.Spec
		if i > #SLOTS then
			break
		end
		if type(spec) == "table" and type(spec.Mineral) == "string" then
			local s = SCALE * math.clamp(GeodeGen.visualScale(tonumber(spec.Mass) or 1), 0.85, 1.3)
			local okB, m = pcall(PetModel.build, spec, { Scale = s, Lod = true, NoLight = true })
			if okB and m then
				-- followers are fitted to one set height (bug 243), so big pets never fill the screen or clip their
				-- owner; the lobby displays and the Pet Book keep the full size
				local vary = math.clamp(GeodeGen.visualScale(tonumber(spec.Mass) or 1), 0.92, 1.1)
				local grow = PetFlair.evolveScale(spec.Evolve) -- evolved pets follow a bit bigger
				PetModel.fitHeight(m, FOLLOW_H * vary * grow, FOLLOW_W * vary * grow)
			end
			if okB and Motion and m:GetAttribute("Mesh") then
				pcall(Motion.start, m)
			end
			if okB and m then
				m.Name = "Pet_" .. player.UserId .. "_" .. i
				require(script.Parent.PetTrail).attach(m, spec.Modifier) -- Golden / Rainbow sparkle trail
				local head = m:FindFirstChild("Head")
				local tag: BillboardGui? = nil
				-- pet type colour (the tag pill); no glowing disc under the pet (owner: it read as a glowing plate)
				local kind = PetRules.kindOf(spec)
				local kindColor = PetRules.kindColor(kind)
				calmFx(m)
				if head and head:IsA("BasePart") then
					local bb = Instance.new("BillboardGui")
					bb.Name = "PetTag"
					bb.Adornee = head
					bb.Size = UDim2.fromOffset(170, 30)
					bb.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y * 0.5 + 0.9, 0)
					bb.MaxDistance = 35
					bb.AlwaysOnTop = false
					bb.LightInfluence = 0
					bb.ResetOnSpawn = false
					local rarity = tostring(spec.Rarity or "Common")
					-- the nickname (server-filtered) when the owner named the pet, else rarity + species
					local nick = if type(spec.Nickname) == "string" and spec.Nickname ~= "" then spec.Nickname else nil
					local row = Instance.new("Frame")
					row.Name = "Row"
					row.BackgroundTransparency = 1
					row.Size = UDim2.fromScale(1, 1)
					row.Parent = bb
					-- type icon on a small glow pill in the type colour
					local pill = Instance.new("Frame")
					pill.Name = "TypeGlow"
					pill.BackgroundColor3 = kindColor
					pill.BackgroundTransparency = 0.45
					pill.Position = UDim2.fromOffset(0, 3)
					pill.Size = UDim2.fromOffset(24, 24)
					pill.Parent = row
					UI.corner(pill, 12)
					UI.icon(pill, TYPE_ICON[kind] or "boostCoins", 20, { Position = UDim2.fromOffset(2, 2) })
					-- full dark outline so pale rarity colours still read on the snow
					UI.text(row, if nick then nick else string.upper(rarity) .. " " .. PetModel.name(spec.Mineral), {
						TextSize = 14, Font = UI.Head, Outline = "Strong", Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -28, 1, 0), TextXAlignment = Enum.TextXAlignment.Left,
						TextColor3 = (Config.RarityTextColors :: any)[rarity] or Color3.new(1, 1, 1),
					})
					bb.Parent = m
					tag = bb
				end
				local parts: { BasePart } = {}
				for _, d in m:GetDescendants() do
					if d:IsA("BasePart") then
						table.insert(parts, d)
					end
				end
				local cy = m:GetAttribute("CentreY")
				local okF, fx = pcall(PetFx.attach, m, spec, s, ensureFolder())
				local petFx: PetFx.Fx? = if okF then fx else nil
				if petFx then
					table.insert(parts, petFx.Shadow) -- fades with the pet near the camera
				end
				m.Parent = ensureFolder()
				-- blinking: the procedural pets' round eyes (and shines) squash shut now and then; mesh pets skip
				local eyes: { BasePart } = {}
				local eyeSizes: { Vector3 } = {}
				if m:GetAttribute("Mesh") ~= true then
					for _, d in m:GetDescendants() do
						if d:IsA("Part") and (d.Name == "Eye" or d.Name == "Shine") and d.Shape == Enum.PartType.Ball then
							table.insert(eyes, d)
							table.insert(eyeSizes, d.Size)
						end
					end
				end
				table.insert(e.Pets, { Id = spec.Id, Fx = petFx, Model = m, Pos = Vector3.zero, Look = Vector3.new(0, 0, -1), Phase = i * 1.3, Height = 0, Parts = parts, Tag = tag, CentreY = if type(cy) == "number" then cy else 1, Fade = 0,
					Flying = FLYERS[tostring(m:GetAttribute("Kind"))] == true, Size = s / SCALE, Far = false,
					Eyes = eyes, EyeSizes = eyeSizes, NextBlink = os.clock() + 1 + math.random() * 4, BlinkEnd = 0, HopS = 0,
					JumpT = 0, BounceT = 0, SpinT = 0, Bank = 0, Droop = 0, Sleepy = false, EyesShut = false, Zzz = nil, LookSet = nil, Rate = 1 })
				if known and spec.Id ~= nil and not known[tostring(spec.Id)] then
					PetMoodFx.hearts(m) -- just equipped
					startBounce(e.Pets[#e.Pets]) -- and a happy bounce
				end
			end
		end
	end
	-- spread the slots so big pets never overlap their neighbours (slot gap is ~7.6 studs)
	local maxR = 0
	for _, p in e.Pets do
		local r = p.Model:GetAttribute("Radius")
		maxR = math.max(maxR, if type(r) == "number" then r else p.Size * 1.3)
	end
	e.Spread = math.max(1, (2 * maxR + 0.5) / 7.6)
	-- snap into place on the next frame
	for _, p in e.Pets do
		p.Height = -1
	end
end

local function track(player: Player)
	if entries[player] then
		return
	end
	local e: Entry = { Pets = {}, Raw = nil, Conns = {}, Spread = 1, Air = 0, Known = nil, WasJump = false, Still = 0 }
	entries[player] = e
	table.insert(e.Conns, player:GetAttributeChangedSignal("PetsShown"):Connect(function()
		rebuild(player, e)
	end))
	for _, attr in { "MatchKey", "InTower", "InBattle" } do
		table.insert(e.Conns, player:GetAttributeChangedSignal(attr):Connect(function()
			rebuild(player, e)
		end))
	end
	if player == Players.LocalPlayer then
		local inHunt = State.Match ~= nil
		table.insert(e.Conns, State.Changed.Event:Connect(function(what)
			if what == "Match" and (State.Match ~= nil) ~= inHunt then
				inHunt = State.Match ~= nil
				rebuild(player, e)
			end
		end))
	end
	table.insert(e.Conns, player.CharacterRemoving:Connect(function()
		for _, p in e.Pets do
			p.Height = -1 -- teleport to the new character instead of gliding across the map
			p.Model.Parent = nil
			if p.Fx then
				PetFx.setShown(p.Fx, false, ensureFolder())
			end
		end
	end))
	rebuild(player, e)
end

local function untrack(player: Player)
	local e = entries[player]
	if not e then
		return
	end
	for _, c in e.Conns do
		c:Disconnect()
	end
	clearPets(e)
	entries[player] = nil
end

-- distance from point p to the segment a..b
local function segDist(p: Vector3, a: Vector3, b: Vector3): number
	local ab = b - a
	local len2 = ab:Dot(ab)
	local t = if len2 > 1e-6 then math.clamp((p - a):Dot(ab) / len2, 0, 1) else 0
	return (a + ab * t - p).Magnitude
end

-- fade a pet toward 1 when it is too close to the camera or blocks the view of the local head
local function fade(p: Pet, centre: Vector3, camPos: Vector3, headPos: Vector3?, dt: number)
	local goal = 0
	if (centre - camPos).Magnitude < FADE_NEAR or (headPos and segDist(centre, camPos, headPos) < FADE_LINE) then
		goal = 1
	end
	if p.Fade == goal then
		return
	end
	local f = p.Fade + (goal - p.Fade) * math.min(1, dt * 10)
	if math.abs(goal - f) < 0.02 then
		f = goal
	end
	p.Fade = f
	for _, part in p.Parts do
		part.LocalTransparencyModifier = f
	end
	if p.Tag then
		p.Tag.Enabled = f < 0.5
	end
end

-- Ground snap: each pet raycasts down at its own spot (throttled, staggered) so it stands on slopes, hills and
-- cliffs instead of floating or sinking at the owner's height. Characters and the pets folder are excluded.
local RAY_EVERY = 0.12
local RAY_UP, RAY_DOWN = 6, 30
local groundY: { [Pet]: number } = setmetatable({} :: any, { __mode = "k" })
local smoothY: { [Pet]: number } = setmetatable({} :: any, { __mode = "k" })
local nextRay: { [Pet]: number } = setmetatable({} :: any, { __mode = "k" })
local farPivot: { [Pet]: number } = setmetatable({} :: any, { __mode = "k" }) -- next low-rate move of a skipped pet
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
rayParams.RespectCanCollide = true -- only solid ground: no leaves, effects or invisible non-colliding helpers

local function petGround(p: Pet, goal: Vector3, ownerGround: number, now: number, dt: number): number
	local y = smoothY[p] or ownerGround
	if now >= (nextRay[p] or 0) then
		nextRay[p] = now + RAY_EVERY + math.random() * 0.04
		local ignore: { Instance } = { ensureFolder() }
		for _, pl in Players:GetPlayers() do
			if pl.Character then
				table.insert(ignore, pl.Character)
			end
		end
		rayParams.FilterDescendantsInstances = ignore
		local hit = Workspace:Raycast(Vector3.new(goal.X, ownerGround + RAY_UP, goal.Z), Vector3.new(0, -(RAY_UP + RAY_DOWN), 0), rayParams)
		local target = if hit then hit.Position.Y else ownerGround
		if groundY[p] == nil then
			y = target -- first sample: snap, don't glide
		end
		groundY[p] = target
	end
	local want = groundY[p] or y
	y = y + (want - y) * math.min(1, dt * 12)
	smoothY[p] = y
	return y
end

-- Simple avoidance (owner video: followers walked through props and in front of the player). A pet whose slot is
-- behind its owner goes round the owner's side instead of straight across the front, and a short sideways probe
-- slides it along solid props instead of through them. No pathfinding.
local AVOID_OWNER = 4.5 -- studs: the ring kept round the owner while a pet walks round
local probeParams = RaycastParams.new()
probeParams.FilterType = Enum.RaycastFilterType.Exclude
probeParams.IgnoreWater = true
probeParams.RespectCanCollide = true -- solid props only (no leaves, effects or invisible helpers)

local function roundOwner(p: Pet, goal: Vector3, ownerPos: Vector3, look: Vector3): Vector3
	local rel = Vector3.new(p.Pos.X - ownerPos.X, 0, p.Pos.Z - ownerPos.Z)
	local relGoal = Vector3.new(goal.X - ownerPos.X, 0, goal.Z - ownerPos.Z)
	if rel:Dot(look) < -1 or relGoal:Dot(look) > 0 then
		return goal -- already behind (or the slot is not behind): straight there
	end
	local right = look:Cross(Vector3.yAxis)
	local side = if rel:Dot(right) + relGoal:Dot(right) * 0.5 >= 0 then 1 else -1
	local ring = math.max(AVOID_OWNER, rel.Magnitude)
	local via = ownerPos + right * side * ring - look * 1.5
	return Vector3.new(via.X, goal.Y, via.Z)
end

local function slideOffProps(p: Pet, prev: Vector3, ignore: { Instance }): Vector3
	local move = Vector3.new(p.Pos.X - prev.X, 0, p.Pos.Z - prev.Z)
	local len = move.Magnitude
	if len < 1e-3 then
		return p.Pos
	end
	local r = p.Model:GetAttribute("Radius")
	local radius = math.clamp(if type(r) == "number" then r * 0.6 else p.Size, 0.6, 3)
	probeParams.FilterDescendantsInstances = ignore
	local from = prev + Vector3.new(0, 1.2, 0)
	local hit = Workspace:Raycast(from, move.Unit * (len + radius), probeParams)
	if not hit or hit.Normal.Y > 0.6 then
		return p.Pos -- free, or only a slope of the ground ahead
	end
	local n = Vector3.new(hit.Normal.X, 0, hit.Normal.Z)
	if n.Magnitude < 1e-3 then
		return p.Pos
	end
	n = n.Unit
	local into = move:Dot(n)
	if into < 0 then
		move -= n * into -- keep only the part along the prop's face
	end
	return Vector3.new(prev.X + move.X, p.Pos.Y, prev.Z + move.Z)
end

-- Solid props the probe ray cannot see (polish #146). The lobby's fences, signs and stall counters are decor that
-- does not answer raycasts (KitPlace decor policy: CanQuery off) with an invisible collision box beside it
-- (KitPlace.blocker: CanCollide on, CanQuery off), so the ray above never hit them and pets walked straight through.
-- Spatial queries skip CanQuery-off parts too, so the client keeps its own index: every anchored, colliding part
-- (blockers included) in a coarse XZ grid, kept up to date as parts come and go. A walking pet is pushed out of any
-- such box it overlaps between two probe heights above its ground (low steps and the floor never count), in short
-- sub-steps so a thin fence cannot be skipped over in one frame.
local CELL = 12 -- studs per grid cell
local MAX_SPAN = 200 -- studs: wider parts (ground slabs, terrain stand-ins) are not obstacles
local PROBE_LOW, PROBE_HIGH = 1.4, 2.6 -- studs above the pet's ground (steps up to 1.4 studs stay walkable)
local cells: { [number]: { [BasePart]: boolean } } = {} -- key: cellKey(gx, gz)
local cellsOf: { [BasePart]: { number } } = {}

-- one number per grid cell (Vector2 keys would compare by identity, not value)
local function cellKey(gx: number, gz: number): number
	return gx * 65536 + gz
end

local function unindex(part: BasePart)
	local keys = cellsOf[part]
	if not keys then
		return
	end
	for _, k in keys do
		local c = cells[k]
		if c then
			c[part] = nil
			if next(c) == nil then
				cells[k] = nil
			end
		end
	end
	cellsOf[part] = nil
end

local function index(part: BasePart)
	if cellsOf[part] or not part.Anchored or not part.CanCollide then
		return
	end
	if folder and part:IsDescendantOf(folder) then
		return
	end
	local model = part:FindFirstAncestorOfClass("Model")
	if model and model:FindFirstChildOfClass("Humanoid") then
		return -- characters and NPCs move; never obstacles
	end
	local cf, size = part.CFrame, part.Size
	-- world-axis extent of the (possibly rotated) box
	local ex = math.abs(cf.RightVector.X) * size.X + math.abs(cf.UpVector.X) * size.Y + math.abs(cf.LookVector.X) * size.Z
	local ez = math.abs(cf.RightVector.Z) * size.X + math.abs(cf.UpVector.Z) * size.Y + math.abs(cf.LookVector.Z) * size.Z
	if ex > MAX_SPAN or ez > MAX_SPAN or ex ~= ex or ez ~= ez then
		return
	end
	local p = cf.Position
	local keys: { number } = {}
	for gx = math.floor((p.X - ex / 2) / CELL), math.floor((p.X + ex / 2) / CELL) do
		for gz = math.floor((p.Z - ez / 2) / CELL), math.floor((p.Z + ez / 2) / CELL) do
			local k = cellKey(gx, gz)
			local c = cells[k]
			if not c then
				c = {}
				cells[k] = c
			end
			(c :: { [BasePart]: boolean })[part] = true
			table.insert(keys, k)
		end
	end
	cellsOf[part] = keys
end

local indexStarted = false
local function startIndex()
	if indexStarted then
		return
	end
	indexStarted = true
	for _, d in Workspace:GetDescendants() do
		if d:IsA("BasePart") then
			index(d)
		end
	end
	Workspace.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			index(d)
		end
	end)
	Workspace.DescendantRemoving:Connect(function(d)
		if d:IsA("BasePart") then
			unindex(d)
		end
	end)
end

-- Reused by pushOutOfBoxes (called per pet per sub-step): no per-call tables.
local PROBE_HEIGHTS = { PROBE_LOW, PROBE_HIGH }
local seenBuf: { [BasePart]: boolean } = {}

-- Pushes the XZ point `pos` (at ground height `gy`) out of every indexed box it overlaps within `radius`.
local function pushOutOfBoxes(pos: Vector3, gy: number, radius: number): Vector3
	local x, z = pos.X, pos.Z
	local seen = seenBuf
	for _ = 1, 2 do
		local moved = false
		table.clear(seen)
		for gx = math.floor((x - radius) / CELL), math.floor((x + radius) / CELL) do
			for gz = math.floor((z - radius) / CELL), math.floor((z + radius) / CELL) do
				local c = cells[cellKey(gx, gz)]
				if not c then
					continue
				end
				for part in c do
					if seen[part] then
						continue
					end
					seen[part] = true
					if not part.Parent or not part.CanCollide then
						continue
					end
					local cf, half = part.CFrame, part.Size / 2
					for _, hy in PROBE_HEIGHTS do
						local probe = Vector3.new(x, gy + hy, z)
						local l = cf:PointToObjectSpace(probe)
						local cl = Vector3.new(math.clamp(l.X, -half.X, half.X), math.clamp(l.Y, -half.Y, half.Y), math.clamp(l.Z, -half.Z, half.Z))
						local w = cf:PointToWorldSpace(cl)
						if math.abs(w.Y - probe.Y) > 0.05 then
							continue -- the box is wholly above or below this probe height here
						end
						local dx, dz = x - w.X, z - w.Z
						local d = math.sqrt(dx * dx + dz * dz)
						if d >= radius then
							continue
						end
						if d > 1e-3 then
							x += dx / d * (radius - d)
							z += dz / d * (radius - d)
						else
							-- centre inside the box: out through the nearest side face (box X or Z)
							local px, pz = half.X - math.abs(l.X), half.Z - math.abs(l.Z)
							local outL = if px <= pz then Vector3.new((if l.X >= 0 then 1 else -1) * (px + radius), 0, 0) else Vector3.new(0, 0, (if l.Z >= 0 then 1 else -1) * (pz + radius))
							local o = cf:VectorToWorldSpace(outL)
							x += o.X
							z += o.Z
						end
						moved = true
						break
					end
				end
			end
		end
		if not moved then
			break
		end
	end
	table.clear(seen) -- drop part references between calls
	return Vector3.new(x, pos.Y, z)
end

-- Moves a pet from `prev` to `p.Pos` in sub-steps no longer than half its radius, pushed out of solid boxes on the way.
local function walkOutOfBoxes(p: Pet, prev: Vector3, radius: number): Vector3
	local to = p.Pos
	local dx, dz = to.X - prev.X, to.Z - prev.Z
	local len = math.sqrt(dx * dx + dz * dz)
	local n = math.clamp(math.ceil(len / math.max(radius * 0.5, 0.3)), 1, 8)
	local at = prev
	for _ = 1, n do
		local target = Vector3.new(at.X + dx / n, to.Y, at.Z + dz / n)
		at = pushOutOfBoxes(target, prev.Y, radius)
	end
	return Vector3.new(at.X, to.Y, at.Z)
end

-- Personal space (polish #147): a pet never ends inside or on top of its owner; it stops on a ring round them.
local OWNER_GAP = 2.4 -- studs between the owner's centre and the pet's edge

local function petRadius(p: Pet): number
	local r = p.Model:GetAttribute("Radius")
	return math.clamp(if type(r) == "number" then r * 0.8 else p.Size, 0.6, 3.6)
end

local function keepOffOwner(pos: Vector3, ownerPos: Vector3, look: Vector3, radius: number): Vector3
	local dx, dz = pos.X - ownerPos.X, pos.Z - ownerPos.Z
	local d = math.sqrt(dx * dx + dz * dz)
	local keep = OWNER_GAP + radius
	if d >= keep then
		return pos
	end
	if d < 1e-3 then
		dx, dz, d = -look.X, -look.Z, 1 -- straight behind
	end
	return Vector3.new(ownerPos.X + dx / d * keep, pos.Y, ownerPos.Z + dz / d * keep)
end

local function step(dt: number)
	local t = os.clock()
	local alpha = 1 - math.exp(-dt * 7)
	local cam = Workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero
	local camLook = if cam then cam.CFrame.LookVector else Vector3.zAxis
	local myChar = Players.LocalPlayer and Players.LocalPlayer.Character
	local myHead = myChar and myChar:FindFirstChild("Head")
	local headPos: Vector3? = if myHead and myHead:IsA("BasePart") then myHead.Position else nil
	local probeIgnore: { Instance }? = nil -- built once per frame, only when a pet moves near the camera
	for player, e in entries do
		if #e.Pets == 0 then
			continue
		end
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not root:IsA("BasePart") or not hum then
			for _, p in e.Pets do
				p.Model.Parent = nil
				if p.Fx then
					PetFx.setShown(p.Fx, false, ensureFolder())
				end
			end
			continue
		end
		local rcf = root.CFrame
		local ground = rcf.Position.Y - root.Size.Y / 2 - hum.HipHeight
		local flatLook = Vector3.new(rcf.LookVector.X, 0, rcf.LookVector.Z)
		if flatLook.Magnitude < 0.01 then
			flatLook = Vector3.new(0, 0, -1)
		end
		flatLook = flatLook.Unit
		local yawCF = CFrame.lookAt(Vector3.zero, flatLook)
		-- the owner jumps: the pets stop where they are for a moment (at most 0.7 s, so they never fall behind)
		local st = hum:GetState()
		if st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall then
			e.Air += dt
		else
			e.Air = 0
		end
		local paused = e.Air > 0 and e.Air < 0.7
		-- the owner just jumped: every pet hops too, a beat apart
		local jumping = st == Enum.HumanoidStateType.Jumping
		if jumping and not e.WasJump then
			for i, p in e.Pets do
				if Motion and p.Model:GetAttribute("Mesh") and type(Motion.hop) == "function" then
					task.delay((i - 1) * 0.07, pcall, Motion.hop, p.Model)
				else
					p.JumpT = t + (i - 1) * 0.07
				end
			end
		end
		e.WasJump = jumping
		-- the owner stands still a long while: the pets get sleepy; any move wakes them
		local v = root.AssemblyLinearVelocity
		if e.Air == 0 and v.X * v.X + v.Z * v.Z < 0.25 then
			e.Still += dt
		else
			e.Still = 0
		end
		local sleepy = e.Still >= SLEEP_AFTER
		for i, p in e.Pets do
			local slot = (SLOTS[i] or SLOTS[1]) * Vector3.new(e.Spread, 1, e.Spread)
			local goal = Vector3.new(rcf.Position.X, ground, rcf.Position.Z) + yawCF:VectorToWorldSpace(slot)
			if p.Height >= 0 then
				local dx, dz = goal.X - p.Pos.X, goal.Z - p.Pos.Z
				if dx * dx + dz * dz > SNAP_FAR * SNAP_FAR then
					-- left far behind: catch up at once with a small poof
					p.Pos = goal
					groundY[p] = nil
					smoothY[p] = nil
					nextRay[p] = 0
					p.Look = flatLook
					pcall(function()
						require(script.Parent.HitFx).poof(goal)
					end)
				end
			end
			if p.Height < 0 then
				p.Pos = goal
				p.Height = 0
				groundY[p] = nil
				smoothY[p] = nil
				nextRay[p] = 0
				p.Look = flatLook
			end
			local prev = p.Pos
			-- ease in near the slot: critically damped, so it never overshoots; round the owner's side, not across the front
			if not paused then
				p.Pos = p.Pos:Lerp(roundOwner(p, goal, rcf.Position, flatLook), alpha)
				local near = p.Pos - camPos
				if near:Dot(near) < FAR_FX * FAR_FX then
					if not probeIgnore then
						local list: { Instance } = { ensureFolder() }
						for _, pl in Players:GetPlayers() do
							if pl.Character then
								table.insert(list, pl.Character)
							end
						end
						probeIgnore = list
					end
					p.Pos = slideOffProps(p, prev, probeIgnore :: { Instance })
					p.Pos = walkOutOfBoxes(p, prev, petRadius(p))
				end
				p.Pos = keepOffOwner(p.Pos, rcf.Position, flatLook, petRadius(p))
			end
			-- far from the camera or behind it: skip ground rays, hop, effects and animation (cheap check)
			local toCam = p.Pos - camPos
			local d2 = toCam:Dot(toCam)
			local farNow = if p.Far then d2 > FAR_FX_BACK * FAR_FX_BACK else d2 > FAR_FX * FAR_FX
			if farNow ~= p.Far then
				p.Far = farNow
				if p.Fx then
					PetFx.setFar(p.Fx, p.Model, farNow)
				end
			end
			if farNow or (cam and d2 > 225 and toCam:Dot(camLook) < 0) then
				if not farNow and p.Model.Parent == nil then
					p.Model.Parent = ensureFolder()
				end
				if p.Model:GetAttribute("Moving") then
					-- skipped pets stop their walk dust (it comes back on the next visible step)
					p.Model:SetAttribute("Moving", false)
					dust(p.Model, false)
				end
				if p.BlinkEnd > 0 then
					-- a blink cut short by the skip: open the eyes again
					for k, eye in p.Eyes do
						eye.Size = p.EyeSizes[k]
					end
					p.BlinkEnd = 0
				end
				if p.EyesShut then
					for k, eye in p.Eyes do
						eye.Size = p.EyeSizes[k]
					end
					p.EyesShut = false
				end
				-- skipped pets still follow a few times a second (no rays, hop or animation), so they never stand frozen
				if p.Model.Parent and t >= (farPivot[p] or 0) then
					farPivot[p] = t + 0.25
					local look = if p.Look.Magnitude > 0.01 then p.Look.Unit else flatLook
					local at = p.Pos + Vector3.new(0, if p.Flying then 1.1 else 0, 0)
					local cf = CFrame.lookAt(at, at + look)
					if not (Motion and p.Model:GetAttribute("Mesh") and pcall(Motion.setBase, p.Model, cf)) then
						p.Model:PivotTo(cf)
					end
				end
				continue
			end
			local gy = petGround(p, p.Pos, goal.Y, t, dt)
			p.Pos = Vector3.new(p.Pos.X, gy, p.Pos.Z)
			local move = p.Pos - prev
			local speed = Vector3.new(move.X, 0, move.Z).Magnitude / math.max(dt, 1e-3)
			local hop: number
			local bankGoal = 0
			local lift = 0
			if p.Flying then
				lift = 1.1 + math.sin(t * 2.6 + i * 1.7) * 0.25 -- flyers hover and bob higher than walkers
			end
			if speed > 0.6 then
				-- big pets hop slower, small ones quicker
				p.Phase += dt * math.clamp(speed, 4, 14) * 0.9 / math.clamp(p.Size, 0.8, 1.4)
				local sn = math.sin(p.Phase)
				hop = sn * sn * (if p.Flying then 0.3 else 0.55) -- zero slope at the ground: a soft landing
				local a0 = math.atan2(p.Look.X, p.Look.Z)
				p.Look = turnToward(p.Look, move, dt * 10)
				-- bank into the turn (lean toward its inside; flyers bank harder)
				local da = (math.atan2(p.Look.X, p.Look.Z) - a0 + math.pi) % (2 * math.pi) - math.pi
				bankGoal = math.clamp(da / math.max(dt, 1e-3) * 0.05, -0.28, 0.28) * (if p.Flying then 1.6 else 1)
			else
				hop = (math.sin(t * 2 + i) + 1) * (if p.Flying then 0.1 else 0.04) -- idle bob
				-- owner stopped: turn to look at them
				local toOwner = Vector3.new(rcf.Position.X - p.Pos.X, 0, rcf.Position.Z - p.Pos.Z)
				local want = if toOwner.Magnitude > 0.3 then toOwner.Unit else flatLook
				-- now and then glance at a neighbouring pet of the same owner for about a second
				local n = #e.Pets
				if n > 1 and (t * 0.12 + i * 0.37) % 1 < 0.14 then
					local other = e.Pets[i % n + 1]
					local d = Vector3.new(other.Pos.X - p.Pos.X, 0, other.Pos.Z - p.Pos.Z)
					if d.Magnitude > 0.3 and d.Magnitude < 16 then
						want = d.Unit
					end
				end
				p.Look = turnToward(p.Look, want, dt * 4)
			end
			-- smooth the hop so starting / stopping never snaps the pet's height
			p.HopS = if p.HopS == 0 and hop ~= 0 then hop else p.HopS + (hop - p.HopS) * math.min(1, dt * 14)
			hop = p.HopS
			p.Bank += (bankGoal - p.Bank) * math.min(1, dt * 8)
			-- the owner's jump: a quick hop (procedural pets; mesh pets hop in PetMotion)
			local jumpH = 0
			if p.JumpT > 0 then
				local k = (t - p.JumpT) / JUMP_TIME
				if k >= 1 then
					p.JumpT = 0
				elseif k > 0 then
					jumpH = math.sin(k * math.pi) * 0.9 * math.clamp(p.Size, 0.8, 1.3)
				end
			end
			-- level-up spin: one full turn with a small lift
			local spin = 0
			if p.SpinT > 0 then
				local k = (t - p.SpinT) / SPIN_TIME
				if k >= 1 then
					p.SpinT = 0
				else
					spin = (k * k * (3 - 2 * k)) * math.pi * 2
					jumpH += math.sin(k * math.pi) * 0.5
				end
			end
			-- happy bounce: two hops (PetFx squashes and stretches the body)
			if p.BounceT > 0 then
				local k = (t - p.BounceT) / Rules.BOUNCE_TIME
				if k >= 1 then
					p.BounceT = 0
				elseif k > 0 then
					local h = Rules.squash(k)
					jumpH += h * math.clamp(p.Size, 0.8, 1.3)
				end
			end
			-- sleepy: Zzz bubble, half-shut eyes and a small droop (mesh pets droop their head in PetMotion)
			if sleepy ~= p.Sleepy then
				p.Sleepy = sleepy
				p.Model:SetAttribute("Sleepy", sleepy)
				p.Zzz = PetMoodFx.setZzz(p.Model, sleepy)
			end
			if p.Zzz then
				PetMoodFx.updateZzz(p.Zzz, t, i * 0.33)
			end
			p.Droop += ((if sleepy then 0.08 else 0) - p.Droop) * math.min(1, dt * 2)
			-- blink
			if #p.Eyes > 0 and sleepy then
				if not p.EyesShut then
					for k, eye in p.Eyes do
						local sz = p.EyeSizes[k]
						eye.Size = Vector3.new(sz.X, sz.Y * 0.3, sz.Z)
					end
					p.EyesShut = true
					p.BlinkEnd = 0
				end
			elseif p.EyesShut then
				for k, eye in p.Eyes do
					eye.Size = p.EyeSizes[k]
				end
				p.EyesShut = false
				p.NextBlink = t + 0.4 -- a waking blink
			elseif #p.Eyes > 0 then
				if p.BlinkEnd > 0 and t >= p.BlinkEnd then
					for k, eye in p.Eyes do
						eye.Size = p.EyeSizes[k]
					end
					p.BlinkEnd = 0
					p.NextBlink = t + 2.5 + math.random() * 3.5
				elseif p.BlinkEnd == 0 and t >= p.NextBlink then
					for k, eye in p.Eyes do
						local sz = p.EyeSizes[k]
						eye.Size = Vector3.new(sz.X, sz.Y * 0.1, sz.Z)
					end
					p.BlinkEnd = t + 0.13
				end
			end
			local look = if p.Look.Magnitude > 0.01 then p.Look.Unit else flatLook
			local at = p.Pos + Vector3.new(0, hop + lift + jumpH, 0)
			local tilt = CFrame.Angles(0, spin, 0) * CFrame.Angles(-p.Droop, 0, p.Bank)
			if not p.Model.Parent then
				p.Model.Parent = ensureFolder()
			end
			if p.Fx then
				PetFx.setShown(p.Fx, true, ensureFolder())
				local mesh = Motion ~= nil and p.Model:GetAttribute("Mesh") == true
				PetFx.update(p.Fx, p.Pos, if mesh then 0 else hop, p.Phase, speed > 0.6 and not mesh, t, camPos, lift + jumpH, speed > 0.6)
			end
			if Motion and p.Model:GetAttribute("Mesh") then
				-- the owner's PetMotion animates walk / idle around this base
				local moving = speed > 0.6
				if p.Model:GetAttribute("Moving") ~= moving then
					p.Model:SetAttribute("Moving", moving)
					dust(p.Model, moving)
				end
				-- a sprinting owner (speed boots) makes the pet run (owner's "run" clip when PetClips has it); a
				-- "train" clip set by the Train card is left alone
				local cur = p.Model:GetAttribute("Anim")
				if cur == nil or cur == "run" then
					MotionBridge.setAnim(p.Model, if speed > 22 then "run" else nil)
				end
				-- step speed follows the owner's speed (speed boots: quicker steps), in 0.1 steps
				local rate = if moving then math.floor(math.clamp(speed / 16, 0.8, 1.8) * 10 + 0.5) / 10 else 1
				if rate ~= p.Rate then
					p.Rate = rate
					p.Model:SetAttribute("WalkRate", rate)
				end
				-- stopped: the head turns to the owner's face (eased and limited in PetMotion)
				local head = (char :: Model):FindFirstChild("Head")
				local want: Vector3? = if not moving and head and head:IsA("BasePart") then head.Position else nil
				if want ~= p.LookSet and (want == nil or p.LookSet == nil or (want - (p.LookSet :: Vector3)).Magnitude > 0.25) then
					p.LookSet = want
					p.Model:SetAttribute("LookAt", want)
				end
				local base = p.Pos + Vector3.new(0, lift + jumpH, 0)
				pcall(Motion.setBase, p.Model, CFrame.lookAt(base, base + look) * CFrame.Angles(0, 0, p.Bank))
			else
				p.Model:PivotTo(CFrame.lookAt(at, at + look) * tilt)
			end
			if cam then
				fade(p, at + Vector3.new(0, p.CentreY, 0), camPos, headPos, dt)
			end
		end
	end
end

-- The follower model of one of a player's pets (by pet Id), or nil when it is not following / not shown.
function PetFollow.modelFor(player: Player, id: any): Model?
	local e = entries[player]
	if not e then
		return nil
	end
	for _, p in e.Pets do
		if p.Id ~= nil and tostring(p.Id) == tostring(id) and p.Model.Parent then
			return p.Model
		end
	end
	return nil
end

-- A follower (by pet Id) spins once on the spot (level up). Reduce Motion: nothing.
function PetFollow.spin(player: Player, id: any)
	local e = entries[player]
	if not e or UI.Reduced or (State.Profile and State.Profile.Settings and State.Profile.Settings.ReducedMotion == true) then
		return
	end
	for _, p in e.Pets do
		if p.Id ~= nil and tostring(p.Id) == tostring(id) and p.Model.Parent then
			if Motion and p.Model:GetAttribute("Mesh") and type(Motion.spin) == "function" then
				pcall(Motion.spin, p.Model)
			else
				p.SpinT = os.clock()
			end
		end
	end
end

-- A follower (by pet Id) does a happy bounce: two hops with squash and stretch and a star sparkle (petting, a win, a
-- training goal). Reduce Motion: only the sparkle.
function PetFollow.bounce(player: Player, id: any)
	local e = entries[player]
	if not e then
		return
	end
	for _, p in e.Pets do
		if p.Id ~= nil and tostring(p.Id) == tostring(id) and p.Model.Parent then
			startBounce(p)
		end
	end
end

-- Every follower model shown right now, with its owner and pet id (tap-to-inspect, PetInspectTap).
function PetFollow.shown(): { { Player: Player, Id: string, Model: Model } }
	local out = {}
	for pl, e in entries do
		for _, p in e.Pets do
			if p.Id ~= nil and p.Model.Parent then
				table.insert(out, { Player = pl, Id = tostring(p.Id), Model = p.Model })
			end
		end
	end
	return out
end

-- Every shown follower of `player` does its victory dance (a beat apart).
function PetFollow.celebrate(player: Player)
	local e = entries[player]
	if not e then
		return
	end
	local Bridge = require(script.Parent.PetMotionBridge)
	for i, p in e.Pets do
		if p.Model.Parent then
			task.delay((i - 1) * 0.15, Bridge.celebrate, p.Model)
		end
	end
end

local started = false
function PetFollow.start()
	if started then
		return
	end
	started = true
	for _, pl in Players:GetPlayers() do
		track(pl)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(untrack)
	task.defer(startIndex) -- the obstacle index (one pass over the world, then kept up to date)
	RunService.RenderStepped:Connect(step)
end

return PetFollow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="312">
          <Properties>
            <string name="Name">PetFx</string>
            <string name="Source"><![CDATA[--!strict
-- Follower pet juice (client only, purely cosmetic; PetFollow calls this for every follower it builds):
--   shadow     a soft dark blob on the ground under each pet that shrinks and fades while the pet hops, flies
--              higher or jumps with its owner
--   aura       the rarity-colour ring under Uncommon+ pets breathes gently (mesh pets get one, the procedural
--              body already has its "Aura" ring)
--   shimmer    Golden / Rainbow pets give off small glints; Rainbow pets slowly cycle their colours
--   element    each pet element (TowerConfig species Element) has a tiny particle trait: Fire embers,
--              Ice snowflakes, Nature leaf motes, Storm sparks, Earth dust, Cosmic twinkles
--   thump      heavy pets (Mass band 2+) puff a dust ring when they land a hop
--   levelUp    ring of light, a star burst, a glow flash and "LEVEL UP" over a pet (PetLevelFx)
--   tiers      PetFxRules.look climbs Common -> Void Dragon: a bigger, brighter soft ground ring (never a glowing
--              plate), rising motes, little orbs circling the pet (Epic+), a soft glow light, a light pillar (chase pets and
--              the Void Dragon). Golden pets glow gold, Rainbow rings cycle their hue.
--   walk       sparkles drop behind Uncommon+ / Golden / Rainbow pets only while they walk
--   squash     happy bounce: two hops with stretch and squash (PetFollow.bounce, PetFx.squash); no bones touched
--   fights     hit(), ko(), pop() for the pet battle and training code: pooled spark bursts, a flash, CRIT! pops
-- Bursts come from a small pool of emitters (no per-hit instances), are skipped far from the camera, shrink with
-- Low Effects and share one particle budget for the whole client (PetFxRules).
-- Particle emitters are tagged "PetSparkle" so Low Effects turns them off (client PetSparkle). Reduce Motion stops the
-- colour cycling, aura breathing and dust rings. Every piece is a child of the pet model or cleaned up with Debris.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local TowerConfig = require(Shared.TowerConfig)
local Rules = require(Shared.PetFxRules)
local State = require(script.Parent.State)
local UI = require(script.Parent.ui.UI)

local PetFx = {}

local BIG_MASS = 4 -- kg: the heavier mass bands thump when they land
local THUMP_GAP = 0.3 -- s between thumps of one pet
local THUMP_RANGE = 60 -- studs from the camera
local MAX_DUST = 6 -- dust rings alive at once (whole client)
local SHIMMER_HZ = 10 -- rainbow colour updates per second

type Tint = { Part: BasePart, H: number, S: number, V: number }
export type Fx = {
	Shadow: BasePart,
	ShadowSize: number,
	Aura: BasePart?,
	AuraBase: number,
	AuraGround: boolean, -- our own ring: lies on the ground under the pet like the shadow (not in the hopping model)
	Rainbow: { Tint }?,
	NextTint: number,
	Big: boolean,
	Scale: number,
	Landings: number,
	NextThump: number,
	Look: Rules.Look,
	Orbs: { BasePart },
	Pillar: BasePart?,
	Step: ParticleEmitter?,
	Walking: boolean,
	Far: boolean,
	Shown: boolean,
}

local dustAlive = 0
local burstAt: (Vector3) -> any
local flash: (Vector3, number, Color3) -> ()

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function reduced(): boolean
	return UI.Reduced or settings().ReducedMotion == true
end

local function lowFx(): boolean
	return settings().LowEffects == true
end

local function plainPart(name: string): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

local function bodyOf(m: Model): BasePart?
	local b = m.PrimaryPart or m:FindFirstChild("Body", true)
	if b and b:IsA("BasePart") then
		return b
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "TypeGlow" and d.Name ~= "Aura" then
			return d
		end
	end
	return nil
end

local RunService = game:GetService("RunService")

local function seq(a: Color3, b: Color3): ColorSequence
	return ColorSequence.new(a, b)
end

-- The default ParticleEmitter texture (the engine's built-in sparkle) is used on purpose: no asset ids.
local function emitter(parent: BasePart, name: string, props: { [string]: any })
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.LightInfluence = 0
	e.LockedToPart = false
	for k, v in props do
		(e :: any)[k] = v
	end
	CollectionService:AddTag(e, "PetSparkle") -- Low Effects turns it off (client PetSparkle)
	e.Parent = parent
end

local function elementOf(mineral: any): string
	local sp: any = (TowerConfig.Species :: any)[mineral]
	return if sp and type(sp.Element) == "string" then sp.Element else TowerConfig.DefaultSpecies.Element
end

-- Tiny trait per element; rates are low so a full lobby stays well under a few hundred particles.
local function addElement(body: BasePart, element: string, s: number)
	local n = NumberSequence.new
	if element == "Fire" then
		emitter(body, "Embers", {
			Color = seq(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 70, 20)), LightEmission = 1,
			Size = n(0.22 * s, 0), Lifetime = NumberRange.new(0.7, 1.1), Rate = 4, Speed = NumberRange.new(0.6, 1.4),
			SpreadAngle = Vector2.new(25, 25), EmissionDirection = Enum.NormalId.Top, Acceleration = Vector3.new(0, 2.5, 0),
		})
	elseif element == "Ice" then
		emitter(body, "Snowflakes", {
			Color = seq(Color3.new(1, 1, 1), Color3.fromRGB(180, 225, 255)), LightEmission = 0.4,
			Size = n(0.18 * s), Lifetime = NumberRange.new(1.2, 1.8), Rate = 3, Speed = NumberRange.new(0.2, 0.5),
			SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, -1.2, 0), RotSpeed = NumberRange.new(-90, 90),
			Transparency = n(0.1, 0.8),
		})
	elseif element == "Nature" then
		emitter(body, "Leaves", {
			Color = seq(Color3.fromRGB(150, 230, 90), Color3.fromRGB(70, 170, 60)), LightEmission = 0.2,
			Size = n(0.16 * s), Lifetime = NumberRange.new(1.2, 1.6), Rate = 2, Speed = NumberRange.new(0.3, 0.6),
			SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, -0.8, 0), RotSpeed = NumberRange.new(-120, 120),
			Transparency = n(0.15, 0.9),
		})
	elseif element == "Storm" then
		emitter(body, "Sparks", {
			Color = seq(Color3.fromRGB(255, 245, 140), Color3.fromRGB(120, 200, 255)), LightEmission = 1,
			Size = n(0.2 * s, 0), Lifetime = NumberRange.new(0.15, 0.3), Rate = 3, Speed = NumberRange.new(2, 3.5),
			SpreadAngle = Vector2.new(180, 180),
		})
	elseif element == "Earth" then
		emitter(body, "Dust", {
			Color = seq(Color3.fromRGB(190, 160, 120), Color3.fromRGB(150, 120, 90)), LightEmission = 0,
			Size = n(0.25 * s, 0.45 * s), Lifetime = NumberRange.new(0.5, 0.8), Rate = 2, Speed = NumberRange.new(0.3, 0.6),
			SpreadAngle = Vector2.new(60, 60), EmissionDirection = Enum.NormalId.Bottom, Transparency = n(0.5, 1),
		})
	elseif element == "Cosmic" then
		emitter(body, "Twinkles", {
			Color = seq(Color3.fromRGB(230, 170, 255), Color3.fromRGB(140, 160, 255)), LightEmission = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.26 * s), NumberSequenceKeypoint.new(1, 0) }),
			Lifetime = NumberRange.new(0.8, 1.1), Rate = 3, Speed = NumberRange.new(0.1, 0.3), SpreadAngle = Vector2.new(180, 180),
		})
	end
end

local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- a Cylinder part lying flat (its axis pointing up)
local PILLAR_H = 7 -- studs per pet scale

local function groundRing(name: string, color: Color3, alpha: number, size: number): Part
	local ring = plainPart(name)
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.SmoothPlastic
	ring.Color = color
	ring.Transparency = alpha
	ring.Size = Vector3.new(0.05, size, size)
	return ring
end

local function sparkleSize(peak: number): NumberSequence
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, peak), NumberSequenceKeypoint.new(1, 0) })
end

-- Tier pieces that live on the pet body: rising motes and a soft glow light (both tagged, so Low Effects and far
-- pets turn them off).
local function addTier(body: BasePart, look: Rules.Look, s: number)
	if look.Motes > 0 then
		emitter(body, "AuraMotes", {
			Color = if look.Rainbow
				then ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 0.55, 1)),
					ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.45, 0.55, 1)),
					ColorSequenceKeypoint.new(1, Color3.fromHSV(0.8, 0.55, 1)),
				})
				else seq(look.Accent, look.Color),
			LightEmission = if look.Void then 0.6 else 1, Rate = look.Motes,
			Lifetime = NumberRange.new(1.2, 1.8), Speed = NumberRange.new(0.2, 0.5), SpreadAngle = Vector2.new(180, 180),
			Acceleration = Vector3.new(0, 1.6, 0), Size = sparkleSize((0.18 + 0.03 * look.Tier) * s),
			Transparency = NumberSequence.new(0.1, 0.6), RotSpeed = NumberRange.new(-80, 80),
		})
	end
	if look.Light > 0 then
		local l = Instance.new("PointLight")
		l.Name = "AuraLight"
		l.Color = look.Color
		l.Brightness = look.Light
		l.Range = 5 + 1.5 * look.Tier
		l.Shadows = false
		CollectionService:AddTag(l, "PetSparkle")
		l.Parent = body
	end
end

-- Walk sparkles: the emitter always exists, update() sets its Rate (0 while standing still).
local function addStep(body: BasePart, look: Rules.Look, s: number): ParticleEmitter?
	if look.Trail <= 0 then
		return nil
	end
	local e = Instance.new("ParticleEmitter")
	e.Name = "WalkSparkle"
	e.LightEmission = 1
	e.LockedToPart = false
	e.Rate = 0
	e.Color = if look.Rainbow
		then ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 0.6, 1)),
			ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.15, 0.6, 1)),
			ColorSequenceKeypoint.new(0.66, Color3.fromHSV(0.5, 0.6, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV(0.78, 0.6, 1)),
		})
		else seq(look.Accent, look.Color)
	e.Lifetime = NumberRange.new(0.5, 0.8)
	e.Speed = NumberRange.new(0.2, 0.6)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -0.6, 0)
	e.Size = sparkleSize(0.24 * s)
	e.RotSpeed = NumberRange.new(-120, 120)
	CollectionService:AddTag(e, "PetSparkle")
	e.Parent = body
	return e
end

-- Builds the extras for one follower. `shadowParent` is the followers folder: the shadow stays on the ground, so it is
-- not part of the hopping model.
function PetFx.attach(m: Model, spec: { [string]: any }, s: number, shadowParent: Instance): Fx
	-- the blob follows the pet's real footprint (mesh pets know their Radius), not just the base scale
	local radius = m:GetAttribute("Radius")
	local shadowSize = if type(radius) == "number" and radius > 0 then math.clamp(radius * 2.1, 1.2, 2.1 * s * 1.6) else 2.1 * s
	local shadow = plainPart("PetShadow")
	shadow.Shape = Enum.PartType.Cylinder
	shadow.Material = Enum.Material.SmoothPlastic
	shadow.Color = Color3.new(0, 0, 0)
	shadow.Transparency = 0.6
	shadow.Size = Vector3.new(0.04, shadowSize, shadowSize)
	shadow.Parent = shadowParent

	-- rarity aura (PetFxRules tiers): reuse the procedural ring, or add one under a mesh pet
	local look = Rules.look(spec.Rarity or "Common", spec.Mineral, spec.Modifier)
	local aura: BasePart? = nil
	local auraGround = false
	local found = m:FindFirstChild("Aura", true)
	if found and found:IsA("BasePart") then
		aura = found
		if spec.Modifier == "Golden" or look.Tier >= 5 then
			found.Color = look.Color
		end
	elseif look.Ring > 0 then
		local ring = groundRing("Aura", look.Color, look.Alpha, look.Ring * s)
		-- soft and flat on the ground, centred under the pet each frame (in the model it leaned and trailed with the hop)
		ring.CFrame = CFrame.new(m:GetPivot().Position) * FLAT
		ring.Parent = shadowParent
		aura = ring
		auraGround = true
	end
	local orbs: { BasePart } = {}
	for i = 1, look.Orbs do
		local o = plainPart("AuraOrb")
		o.Shape = Enum.PartType.Ball
		o.Material = Enum.Material.Neon
		o.Color = if look.Void and i % 2 == 0 then Color3.fromRGB(40, 20, 70) else (if i % 2 == 0 then look.Accent else look.Color)
		o.Transparency = 0.15
		o.Size = Vector3.one * (0.22 + 0.02 * look.Tier) * s
		o.Parent = shadowParent
		table.insert(orbs, o)
	end
	local pillar: BasePart? = nil
	if look.Pillar then
		local pl = plainPart("AuraPillar")
		pl.Shape = Enum.PartType.Cylinder
		pl.Material = Enum.Material.Neon
		pl.Color = look.Color
		pl.Transparency = 0.9
		pl.Size = Vector3.new(PILLAR_H * s, look.Ring * 0.45 * s, look.Ring * 0.45 * s)
		pl.Parent = shadowParent
		pillar = pl
	end

	local body = bodyOf(m)
	local rainbow: { Tint }? = nil
	local step: ParticleEmitter? = nil
	if body then
		addElement(body, elementOf(spec.Mineral), s)
		addTier(body, look, s)
		step = addStep(body, look, s)
		if spec.Modifier == "Golden" or spec.Modifier == "Rainbow" then
			emitter(body, "Shimmer", {
				Color = if spec.Modifier == "Golden"
					then seq(Color3.fromRGB(255, 240, 170), Color3.fromRGB(255, 196, 64))
					else ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 120)),
						ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 255, 160)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 140, 255)),
					}),
				LightEmission = 1, Rate = 3, Lifetime = NumberRange.new(0.35, 0.6), Speed = NumberRange.new(0, 0.2),
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, 0.32 * s), NumberSequenceKeypoint.new(1, 0) }),
				RotSpeed = NumberRange.new(-60, 60),
			})
		end
	end
	if spec.Modifier == "Rainbow" then
		-- the Rainbow paint is saturation ~0.55-0.7 at full value (PetModel); eyes and dark pieces never match
		local list: { Tint } = {}
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") and d.Name ~= "Aura" and d.Name ~= "TypeGlow" then
				local h, sat, v = d.Color:ToHSV()
				if sat > 0.45 and sat < 0.8 and v > 0.9 then
					table.insert(list, { Part = d, H = h, S = sat, V = v })
				end
			end
		end
		rainbow = if #list > 0 then list else nil
	end

	return {
		Shadow = shadow,
		ShadowSize = shadowSize,
		Aura = aura,
		AuraBase = if aura then aura.Transparency else 0,
		AuraGround = auraGround,
		Rainbow = rainbow,
		NextTint = 0,
		Big = (tonumber(spec.Mass) or 0) >= BIG_MASS,
		Scale = s,
		Landings = 0,
		NextThump = 0,
		Look = look,
		Orbs = orbs,
		Pillar = pillar,
		Step = step,
		Walking = false,
		Far = false,
		Shown = true,
	}
end

-- The ground pieces that live in the followers folder (not inside the pet model).
local function groundPieces(fx: Fx): { BasePart }
	local list: { BasePart } = { fx.Shadow }
	if fx.AuraGround and fx.Aura then
		table.insert(list, fx.Aura)
	end
	if fx.Pillar then
		table.insert(list, fx.Pillar)
	end
	for _, o in fx.Orbs do
		table.insert(list, o)
	end
	return list
end

function PetFx.destroy(fx: Fx)
	for _, p in groundPieces(fx) do
		p:Destroy()
	end
end

-- Shows or hides the ground pieces with the model (PetFollow parks a model with Parent = nil).
function PetFx.setShown(fx: Fx, shown: boolean, parent: Instance)
	local want: Instance? = if shown then parent else nil
	for _, p in groundPieces(fx) do
		if p.Parent ~= want then
			p.Parent = want
		end
	end
end

-- The orbs and pillar are pure show: hidden far away and with Low Effects.
local function showExtras(fx: Fx, on: boolean)
	fx.Shown = on
	for _, o in fx.Orbs do
		o.Transparency = if on then 0.15 else 1
	end
	if fx.Pillar then
		fx.Pillar.Transparency = if on then 0.9 else 1
	end
end

-- Pets far from the camera (PetFollow decides, with hysteresis) hide their particles, trails, lights and shadow.
-- Restoring honours Low Effects, so a far pet coming back never re-enables what the setting turned off.
function PetFx.setFar(fx: Fx, model: Model, far: boolean)
	local on = not far and not lowFx()
	for _, d in CollectionService:GetTagged("PetSparkle") do
		if d:IsDescendantOf(model) and (d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Light") or d:IsA("Sparkles") or d:IsA("Beam")) then
			(d :: any).Enabled = on
		end
	end
	fx.Shadow.Transparency = if far then 1 else 0.6
	fx.Far = far
	showExtras(fx, on)
end

local function thump(at: Vector3, s: number)
	if dustAlive >= MAX_DUST then
		return
	end
	dustAlive += 1
	local ring = plainPart("PetThump")
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.SmoothPlastic
	ring.Color = Color3.fromRGB(205, 185, 150)
	ring.Transparency = 0.45
	ring.Size = Vector3.new(0.05, 1.2 * s, 1.2 * s)
	ring.CFrame = CFrame.new(at + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = Workspace
	local tw = TweenService:Create(ring, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.05, 3.6 * s, 3.6 * s), Transparency = 1,
	})
	tw:Play()
	task.delay(0.4, function()
		dustAlive -= 1
	end)
	Debris:AddItem(ring, 0.4)
end

-- Per frame. groundPos = the pet's feet on the ground (no hop); hop = current hop height; phase = PetFollow's hop
-- phase (a landing happens each time it passes a multiple of pi); moving = hopping right now; camPos for range checks;
-- rise = extra height above the hop (a flyer's hover, a jump), so the shadow keeps shrinking and fading as it rises.
-- walking = the pet is moving along (any pet, mesh or not): turns the walk sparkles on.
function PetFx.update(fx: Fx, groundPos: Vector3, hop: number, phase: number, moving: boolean, t: number, camPos: Vector3, rise: number?, walking: boolean?)
	local k = math.clamp(hop / 0.55, 0, 1)
	local r = math.clamp((rise or 0) / 2.5, 0, 1)
	local size = fx.ShadowSize * (1 - 0.3 * k) * (1 - 0.4 * r)
	fx.Shadow.Size = Vector3.new(0.04, size, size)
	fx.Shadow.Transparency = math.min(0.95, 0.6 + 0.2 * k + 0.25 * r)
	fx.Shadow.CFrame = CFrame.new(groundPos + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, 0, math.rad(90))

	local still = reduced()
	if fx.Aura and fx.AuraGround then
		fx.Aura.CFrame = CFrame.new(groundPos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90))
	end
	if fx.Aura then
		fx.Aura.Transparency = if still then fx.AuraBase else math.clamp(fx.AuraBase + 0.15 * math.sin(t * 2.4), 0, 1)
	end
	local showy = not fx.Far and not lowFx()
	if showy ~= fx.Shown then
		showExtras(fx, showy)
	end
	if fx.Pillar then
		fx.Pillar.CFrame = CFrame.new(groundPos + Vector3.new(0, PILLAR_H * fx.Scale * 0.5, 0)) * FLAT
		if showy then
			fx.Pillar.Transparency = if still then 0.9 else 0.87 + 0.06 * math.sin(t * 1.7)
		end
	end
	local n = #fx.Orbs
	if n > 0 and showy then
		local rad = fx.Look.Ring * fx.Scale * 0.42
		local spinT = if still then 0 else t
		for i, o in fx.Orbs do
			local a = spinT * 1.4 + (i - 1) * (2 * math.pi / n)
			local bob = if still then 0.6 else 0.6 + 0.25 * math.sin(spinT * 2 + i)
			o.CFrame = CFrame.new(groundPos + Vector3.new(math.cos(a) * rad, bob * fx.Scale + (rise or 0) * 0.5, math.sin(a) * rad))
		end
	end
	local walk = walking == true and showy
	if fx.Step and walk ~= fx.Walking then
		fx.Walking = walk
		fx.Step.Rate = if walk then fx.Look.Trail else 0
	end
	local retint = not still and t >= fx.NextTint
	if retint then
		fx.NextTint = t + 1 / SHIMMER_HZ
	end
	if fx.Look.Rainbow and fx.Aura and retint then
		local h = (t * 0.12) % 1
		fx.Aura.Color = Color3.fromHSV(h, 0.6, 1)
	end
	if fx.Rainbow and retint then
		local shift = (t * 0.12) % 1
		for _, tint in fx.Rainbow do
			tint.Part.Color = Color3.fromHSV((tint.H + shift) % 1, tint.S, tint.V)
		end
	end

	local landings = math.floor(phase / math.pi)
	if landings ~= fx.Landings then
		fx.Landings = landings
		if fx.Big and moving and t >= fx.NextThump and not still and not lowFx() and (groundPos - camPos).Magnitude < THUMP_RANGE then
			fx.NextThump = t + THUMP_GAP
			thump(groundPos, fx.Scale)
		end
	end
end

-- Ring of light + "LEVEL UP" over a pet (PetLevelFx). Lives about 1.6 s, then Debris removes it.
function PetFx.levelUp(model: Model, level: number)
	local pivot = model:GetPivot()
	local feet = pivot.Position
	local h = model:GetAttribute("Height")
	local height = if type(h) == "number" then h else 2
	local gold = Color3.fromRGB(255, 214, 90)
	local still = reduced()
	local centre = feet + Vector3.new(0, height * 0.5, 0)
	local n = PetFx.spend(centre, Rules.LEVEL_COUNT)
	if n > 0 then
		local b = burstAt(centre)
		b.Star.Color = seq(Color3.fromRGB(255, 250, 210), gold)
		b.Star.Size = sparkleSize(0.55)
		b.Star.Speed = NumberRange.new(6, 11)
		b.Star:Emit(n)
		flash(centre, 2 + height * 0.6, gold)
	end

	for i = 1, 2 do
		local ring = plainPart("LevelRing")
		ring.Shape = Enum.PartType.Cylinder
		ring.Material = Enum.Material.Neon
		ring.Color = gold
		ring.Transparency = 0.2
		ring.Size = Vector3.new(0.06, 1.5, 1.5)
		ring.CFrame = CFrame.new(feet + Vector3.new(0, 0.08 + (i - 1) * 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90))
		ring.Parent = Workspace
		if still then
			ring.Size = Vector3.new(0.06, 4, 4)
			TweenService:Create(ring, TweenInfo.new(1), { Transparency = 1 }):Play()
		else
			local goal = ring.CFrame + Vector3.new(0, if i == 2 then height + 0.6 else 0, 0)
			TweenService:Create(ring, TweenInfo.new(0.7 + 0.2 * i, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = Vector3.new(0.06, 5.5 - i, 5.5 - i), Transparency = 1, CFrame = goal,
			}):Play()
		end
		Debris:AddItem(ring, 1.3)
	end

	local anchor = plainPart("LevelAnchor")
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(feet + Vector3.new(0, height + 0.8, 0))
	anchor.Parent = Workspace
	local bb = Instance.new("BillboardGui")
	bb.Name = "LevelUp"
	bb.Adornee = anchor
	bb.Size = UDim2.fromOffset(180, 56)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 80
	bb.Parent = anchor
	local title = UI.text(bb, "LEVEL UP!", {
		Font = UI.Head, TextSize = 24, Outline = "Strong", TextColor3 = gold,
		TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 32),
	})
	local sub = UI.text(bb, "Lv " .. tostring(level), {
		Font = UI.Bold, TextSize = 16, Outline = "Strong", TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 22),
	})
	if not still then
		TweenService:Create(anchor, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = anchor.CFrame + Vector3.new(0, 1.6, 0),
		}):Play()
	end
	local fadeInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.1)
	TweenService:Create(title, fadeInfo, { TextTransparency = 1 }):Play()
	TweenService:Create(sub, fadeInfo, { TextTransparency = 1 }):Play()
	for _, lbl in { title, sub } do
		local stroke = lbl:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, fadeInfo, { Transparency = 1 }):Play()
		end
	end
	Debris:AddItem(anchor, 1.7)
end

-- ---------------------------------------------------------------------------------------------------------------
-- One-shot bursts (fights, training, level up). A small pool of invisible anchored parts, each holding three
-- emitters that only ever Emit() (no Rate), a few pooled glow balls and pop-text anchors. Everything goes through
-- PetFx.spend, which skips far bursts, shrinks them with Low Effects and holds the whole-client particle budget.

local POOL_BURSTS, POOL_FLASH, POOL_POPS = 6, 4, 8
type Burst = { Part: Part, Spark: ParticleEmitter, Star: ParticleEmitter, Puff: ParticleEmitter }
type Flash = { Part: Part, Tween: Tween? }
type Pop = { Part: Part, Gui: BillboardGui, Label: TextLabel?, Tween: Tween? }

local fxFolder: Folder? = nil
local bursts: { Burst } = {}
local flashes: { Flash } = {}
local pops: { Pop } = {}
local nextBurst, nextFlash, nextPop = 0, 0, 0
local budget = Rules.newBudget()

local function folder(): Folder
	if fxFolder and fxFolder.Parent then
		return fxFolder
	end
	local f = Instance.new("Folder")
	f.Name = "CT_PetFx"
	f.Parent = Workspace
	fxFolder = f
	table.clear(bursts)
	table.clear(flashes)
	table.clear(pops)
	return f
end

local function burstEmitter(parent: BasePart, name: string): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Enabled = false
	e.Rate = 0
	e.LockedToPart = false
	e.SpreadAngle = Vector2.new(180, 180)
	e.Parent = parent
	return e
end

burstAt = function(pos: Vector3): Burst
	local f = folder()
	nextBurst = nextBurst % POOL_BURSTS + 1
	local b = bursts[nextBurst]
	if not b then
		local part = plainPart("PetBurst")
		part.Transparency = 1
		part.Size = Vector3.one * 0.5
		part.Parent = f
		local spark = burstEmitter(part, "Spark")
		spark.LightEmission = 1
		spark.Lifetime = NumberRange.new(0.25, 0.45)
		spark.Drag = 6
		spark.Size = NumberSequence.new(0.3, 0)
		local star = burstEmitter(part, "Star")
		star.LightEmission = 1
		star.Lifetime = NumberRange.new(0.6, 0.95)
		star.Drag = 4
		star.Acceleration = Vector3.new(0, -3, 0)
		star.RotSpeed = NumberRange.new(-200, 200)
		local puff = burstEmitter(part, "Puff")
		puff.LightEmission = 0
		puff.Color = seq(Color3.fromRGB(250, 250, 250), Color3.fromRGB(200, 196, 210))
		puff.Lifetime = NumberRange.new(0.6, 0.9)
		puff.Speed = NumberRange.new(3, 6)
		puff.Drag = 4
		puff.Acceleration = Vector3.new(0, 2, 0)
		puff.Size = NumberSequence.new(1, 2.2)
		puff.Transparency = NumberSequence.new(0.15, 1)
		b = { Part = part, Spark = spark, Star = star, Puff = puff }
		bursts[nextBurst] = b
	end
	b.Part.CFrame = CFrame.new(pos)
	return b
end

-- A neon ball that swells and fades (a hit or level-up flash). Reduce Motion keeps it small.
flash = function(pos: Vector3, size: number, color: Color3)
	local f = folder()
	nextFlash = nextFlash % POOL_FLASH + 1
	local fl = flashes[nextFlash]
	if not fl then
		local part = plainPart("PetFlash")
		part.Shape = Enum.PartType.Ball
		part.Material = Enum.Material.Neon
		part.Transparency = 1
		part.Parent = f
		fl = { Part = part, Tween = nil }
		flashes[nextFlash] = fl
	end
	if fl.Tween then
		fl.Tween:Cancel()
	end
	local grow = if reduced() then size * 0.6 else size
	fl.Part.Color = color
	fl.Part.Size = Vector3.one * grow * 0.3
	fl.Part.Transparency = 0.25
	fl.Part.CFrame = CFrame.new(pos)
	local tw = TweenService:Create(fl.Part, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * grow, Transparency = 1,
	})
	fl.Tween = tw
	tw:Play()
end

-- How many particles a burst of `count` at `pos` may use right now (0 = skip it): distance LOD, Low Effects and the
-- shared budget. Public so other pet effects can share the same budget.
function PetFx.spend(pos: Vector3, count: number): number
	local cam = Workspace.CurrentCamera
	local d = if cam then (cam.CFrame.Position - pos).Magnitude else 0
	return Rules.spend(budget, Rules.scaled(count, Rules.lod(d, lowFx())), os.clock())
end

-- A star spray (FightFx big moments). Shares the pool, LOD and budget.
function PetFx.stars(at: Vector3, count: number, a: Color3, b: Color3, speed: number?, size: number?)
	local n = PetFx.spend(at, count)
	if n > 0 then
		local bu = burstAt(at)
		bu.Star.Color = seq(a, b)
		bu.Star.Size = sparkleSize(size or 0.6)
		local sp = speed or 12
		bu.Star.Speed = NumberRange.new(sp * 0.5, sp)
		bu.Star:Emit(n)
	end
end

-- Slow motion for the burst pool (FightFx KO and special moments): 1 = normal speed.
function PetFx.setTimeScale(k: number)
	for _, b in bursts do
		b.Spark.TimeScale = k
		b.Star.TimeScale = k
		b.Puff.TimeScale = k
	end
end

-- Floating text over a spot ("CRIT!", "KO!", a damage number) that rises and fades. Pooled anchors.
function PetFx.pop(at: Vector3, text: string, color: Color3?, big: boolean?)
	local cam = Workspace.CurrentCamera
	if cam and (cam.CFrame.Position - at).Magnitude > Rules.FAR then
		return
	end
	local f = folder()
	nextPop = nextPop % POOL_POPS + 1
	local p = pops[nextPop]
	if not p then
		local anchor = plainPart("PetPop")
		anchor.Transparency = 1
		anchor.Size = Vector3.one * 0.2
		anchor.Parent = f
		local bb = Instance.new("BillboardGui")
		bb.Name = "Pop"
		bb.Adornee = anchor
		bb.Size = UDim2.fromOffset(160, 48)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.MaxDistance = Rules.FAR
		bb.Parent = anchor
		p = { Part = anchor, Gui = bb, Label = nil, Tween = nil }
		pops[nextPop] = p
	end
	if p.Tween then
		p.Tween:Cancel()
	end
	if p.Label then
		p.Label:Destroy()
	end
	local label = UI.text(p.Gui, text, {
		Font = UI.Head, TextSize = if big then 30 else 22, Outline = "Strong", TextColor3 = color or Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 40),
	})
	p.Label = label
	p.Gui.Size = UDim2.fromOffset(160, 48)
	p.Part.CFrame = CFrame.new(at)
	if not reduced() then
		local tw = TweenService:Create(p.Part, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = CFrame.new(at + Vector3.new(0, 2.2, 0)),
		})
		p.Tween = tw
		tw:Play()
	end
	local fade = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.6)
	TweenService:Create(label, fade, { TextTransparency = 1 }):Play()
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
	end
end

local function centreOf(target: Model | Vector3): Vector3
	if typeof(target) == "Vector3" then
		return target
	end
	local m = target :: Model
	local h = m:GetAttribute("Height")
	return m:GetPivot().Position + Vector3.new(0, (if type(h) == "number" then h else 2) * 0.5, 0)
end

export type HitOpts = { Element: string?, Crit: boolean?, Damage: number?, Quiet: boolean? } -- Quiet: no word pops (the caller shows them)

-- A fight or training hit landing on `target` (a pet model or a spot): element-coloured sparks and a flash; a crit
-- throws twice the sparks, a star spray and a "CRIT!" pop; Damage shows the number.
function PetFx.hit(target: Model | Vector3, opts: HitOpts?)
	local o: HitOpts = opts or {}
	local at = centreOf(target)
	local h = Rules.hit(o.Element, o.Crit)
	local n = PetFx.spend(at, h.Count)
	if n > 0 then
		local b = burstAt(at)
		b.Spark.Color = seq(Color3.new(1, 1, 1), h.Color)
		b.Spark.Size = NumberSequence.new(h.Size, 0)
		b.Spark.Speed = NumberRange.new(h.Speed * 0.6, h.Speed)
		b.Spark:Emit(n)
		if o.Crit then
			b.Star.Color = seq(Color3.fromRGB(255, 250, 200), Color3.fromRGB(255, 200, 60))
			b.Star.Size = sparkleSize(0.6)
			b.Star.Speed = NumberRange.new(5, 9)
			b.Star:Emit(math.max(1, n // 3))
		end
		flash(at, h.Flash, h.Color)
	end
	if o.Quiet then
		return
	end
	if h.Pop then
		PetFx.pop(at + Vector3.new(0, 1.2, 0), "CRIT!", Color3.fromRGB(255, 214, 90), true)
	elseif o.Damage then
		PetFx.pop(at + Vector3.new(0, 1, 0), tostring(math.floor(o.Damage + 0.5)), Color3.new(1, 1, 1), false)
	end
	if o.Crit and o.Damage then
		PetFx.pop(at + Vector3.new(0.8, 0.4, 0), tostring(math.floor(o.Damage + 0.5)), Color3.fromRGB(255, 240, 200), false)
	end
end

-- A pet knocked out: a soft cloud poof, a ring of dizzy stars and "KO!". The fight code hides or moves the pet.
function PetFx.ko(target: Model | Vector3, noPop: boolean?)
	local at = centreOf(target)
	local n = PetFx.spend(at, Rules.KO_COUNT)
	if n > 0 then
		local b = burstAt(at)
		b.Puff:Emit(math.max(1, n * 2 // 3))
		b.Star.Color = seq(Color3.fromRGB(255, 250, 200), Color3.fromRGB(255, 220, 90))
		b.Star.Size = sparkleSize(0.45)
		b.Star.Speed = NumberRange.new(3, 6)
		b.Star:Emit(math.max(1, n // 3))
		flash(at, 3, Color3.fromRGB(255, 255, 255))
	end
	if not noPop then
		PetFx.pop(at + Vector3.new(0, 1.4, 0), "KO!", Color3.fromRGB(255, 120, 110), true)
	end
end

-- ---------------------------------------------------------------------------------------------------------------
-- Squash and stretch (the happy bounce). Shape only: the hop itself comes from whoever places the pet (PetFollow
-- adds it for followers). Anchored rigid pets (procedural bodies, plain mesh parts) stretch on their own axes around
-- the model pivot; pets with bones (skinned meshes) or welded parts get a gentle uniform ScaleTo pulse instead, so
-- no rig, bone or weld is ever changed. Everything is put back exactly at the end. Reduce Motion: nothing.

type PartState = { Part: BasePart, Size: Vector3, Off: CFrame }
type Squash = { Model: Model, T0: number, Parts: { PartState }?, Scale: number }

local MAX_SQUASH = 6
local squashing: { [Model]: Squash } = {}
local squashConn: RBXScriptConnection? = nil

local function restore(sq: Squash)
	local m = sq.Model
	if sq.Parts then
		local pivot = m:GetPivot()
		for _, st in sq.Parts do
			if st.Part.Parent then
				st.Part.Size = st.Size
				st.Part.CFrame = pivot * st.Off
			end
		end
	else
		pcall(function()
			m:ScaleTo(sq.Scale)
		end)
	end
end

local function squashStep()
	local now = os.clock()
	for m, sq in squashing do
		local k = (now - sq.T0) / Rules.BOUNCE_TIME
		if k >= 1 or not m.Parent then
			restore(sq)
			squashing[m] = nil
			continue
		end
		local _, sx, sy = Rules.squash(k)
		if sq.Parts then
			local pivot = m:GetPivot()
			for _, st in sq.Parts do
				local o = st.Off
				st.Part.Size = Vector3.new(st.Size.X * sx, st.Size.Y * sy, st.Size.Z * sx)
				st.Part.CFrame = pivot * CFrame.new(o.X * sx, o.Y * sy, o.Z * sx) * o.Rotation
			end
		else
			pcall(function()
				m:ScaleTo(sq.Scale * (1 + (sy - 1) * 0.5))
			end)
		end
	end
	if next(squashing) == nil and squashConn then
		squashConn:Disconnect()
		squashConn = nil
	end
end

function PetFx.squash(model: Model)
	if reduced() or squashing[model] then
		if squashing[model] then
			squashing[model].T0 = os.clock() -- bounce again from the start
		end
		return
	end
	local count = 0
	for _ in squashing do
		count += 1
	end
	if count >= MAX_SQUASH then
		return
	end
	local rigid = true
	local parts: { PartState } = {}
	local pivot = model:GetPivot()
	for _, d in model:GetDescendants() do
		if d:IsA("Bone") or d:IsA("Motor6D") or d:IsA("Weld") or d:IsA("WeldConstraint") then
			rigid = false
			break
		elseif d:IsA("BasePart") then
			if not d.Anchored then
				rigid = false
				break
			end
			table.insert(parts, { Part = d, Size = d.Size, Off = pivot:ToObjectSpace(d.CFrame) })
		end
	end
	squashing[model] = { Model = model, T0 = os.clock(), Parts = if rigid then parts else nil, Scale = model:GetScale() }
	if not squashConn then
		squashConn = RunService.RenderStepped:Connect(squashStep)
	end
end

-- A happy pet: squash bounce plus a little star sparkle (petting, a win, a new friend). Followers also hop
-- (PetFollow.bounce calls this).
function PetFx.happy(model: Model)
	PetFx.squash(model)
	local at = centreOf(model)
	local n = PetFx.spend(at, 8)
	if n > 0 then
		local b = burstAt(at + Vector3.new(0, 0.6, 0))
		b.Star.Color = seq(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 230, 120))
		b.Star.Size = sparkleSize(0.35)
		b.Star.Speed = NumberRange.new(2, 4)
		b.Star:Emit(n)
	end
end

return PetFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="313">
          <Properties>
            <string name="Name">PetInspectTap</string>
            <string name="Source"><![CDATA[--!strict
-- Tap-to-inspect (carter 2026-10-14: players should look at someone else's pet and want a stronger one): a tap or
-- click on another player's following pet asks the server for its card (PvpAction op "Inspect"); the server answers
-- through the "Inspect" event and InspectPanel shows the pet with its battle power, level and the owner's trophies.
-- Follower parts are not queryable (no raycast hits), so the tap is matched on screen: the nearest pet whose
-- on-screen size covers the tap wins. Lobby only; nothing happens during a hunt, the tower or a battle.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local PetFollow = require(script.Parent.PetFollow)

local PetInspectTap = {}

local player = Players.LocalPlayer
local MIN_RADIUS = 36 -- px: a far pet still takes a finger-sized tap
local MAX_RANGE = 120 -- studs from the camera

local function busy(): boolean
	return player:GetAttribute("MatchKey") ~= nil or player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true
end

-- The other player's pet under screen point `at`, or nil.
function PetInspectTap.pick(at: Vector2): (Player?, string?)
	local cam = Workspace.CurrentCamera
	if not cam then
		return nil, nil
	end
	local best: { Player: Player, Id: string, Model: Model }? = nil
	local bestD = math.huge
	for _, s in PetFollow.shown() do
		if s.Player ~= player then
			local cf, size = s.Model:GetBoundingBox()
			if (cf.Position - cam.CFrame.Position).Magnitude <= MAX_RANGE then
				local c, onScreen = cam:WorldToViewportPoint(cf.Position)
				if onScreen and c.Z > 0 then
					local top = cam:WorldToViewportPoint(cf.Position + Vector3.new(0, math.max(size.Y, size.X) / 2, 0))
					local r = math.max(MIN_RADIUS, (Vector2.new(top.X, top.Y) - Vector2.new(c.X, c.Y)).Magnitude * 1.3)
					local d = (Vector2.new(c.X, c.Y) - at).Magnitude
					if d <= r and d < bestD then
						best, bestD = s, d
					end
				end
			end
		end
	end
	if best then
		return best.Player, best.Id
	end
	return nil, nil
end

function PetInspectTap.start()
	local net = ReplicatedStorage:WaitForChild("PvpNet")
	local action = net:WaitForChild("PvpAction") :: RemoteEvent
	local last = 0
	local function tapAt(pos: Vector2)
		if busy() or os.clock() - last < 0.6 then
			return
		end
		local owner, id = PetInspectTap.pick(pos)
		if owner and id then
			last = os.clock()
			action:FireServer({ Op = "Inspect", UserId = owner.UserId, Pet = id })
		end
	end
	UserInputService.TouchTap:Connect(function(touches, processed)
		if not processed and touches[1] then
			tapAt(touches[1])
		end
	end)
	-- a mouse click that did not drag the camera (TouchTap covers phones)
	local downAt: Vector2? = nil
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then
			downAt = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input, processed)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local from = downAt
		downAt = nil
		local at = Vector2.new(input.Position.X, input.Position.Y)
		if not processed and from and (at - from).Magnitude < 8 then
			tapAt(at)
		end
	end)
end

return PetInspectTap
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="314">
          <Properties>
            <string name="Name">PetLevelFx</string>
            <string name="Source"><![CDATA[--!strict
-- Pet level-up flourish (client only, cosmetic). Watches the local profile's pets (State.Profile.Inventory, level from
-- TowerXP via PetRules.level, the same number the Pet Book and tower show). When one of them goes up a level while it
-- is following the local player, PetFx draws a ring of light and "LEVEL UP!" over that follower and it spins once
-- (PetFollow.spin). The first profile only sets the baseline, so joining never plays it. Nothing is sent anywhere.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PetRules = require(Shared.PetRules)
local State = require(script.Parent.State)
local PetFollow = require(script.Parent.PetFollow)
local PetFx = require(script.Parent.PetFx)
local Audio = require(script.Parent.Audio)

local PetLevelFx = {}

local levels: { [string]: number } = {}
local primed = false

local function scan()
	local prof = State.Profile
	local inv = prof and prof.Inventory
	if type(inv) ~= "table" then
		return
	end
	local ups: { { Id: any, Level: number } } = {}
	for _, g in inv :: { any } do
		if type(g) == "table" and g.Id ~= nil then
			local key = tostring(g.Id)
			local lv = PetRules.level(g)
			local before = levels[key]
			if primed and before and lv > before then
				table.insert(ups, { Id = g.Id, Level = lv })
			end
			levels[key] = lv
		end
	end
	primed = true
	local me = Players.LocalPlayer
	if #ups > 0 then
		-- any pet levelled (hunt XP, tower, training): one level-up chime; Audio's 2 s cooldown merges it with the
		-- Pet Battle panel's own training level-up sound
		Audio.play("LevelUp")
	end
	for i, up in ups do
		if i > 3 then
			break
		end
		local model = me and PetFollow.modelFor(me, up.Id)
		if model then
			pcall(PetFx.levelUp, model, up.Level)
			PetFollow.spin(me, up.Id) -- and the pet spins once
		end
	end
end

local started = false
function PetLevelFx.start()
	if started then
		return
	end
	started = true
	scan()
	State.Changed.Event:Connect(function(what)
		if what == "Profile" then
			scan()
		end
	end)
end

return PetLevelFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="315">
          <Properties>
            <string name="Name">PetMoodFx</string>
            <string name="Source"><![CDATA[--!strict
-- Small mood touches on follower pets (client only, purely cosmetic; PetFollow calls these):
--   hearts     a few little hearts float up over a pet that was just equipped
--   zzz        a "Zzz" bubble that keeps floating up over a sleepy pet (owner standing still a long while)
--   shrinkAway an unequipped pet shrinks down and vanishes in a poof instead of blinking out
-- The hearts are drawn from rounded frames (no asset ids). Low Effects: one heart, no Zzz bubble. Reduce Motion: no
-- floating, the unequipped pet just goes. Every piece lives under the pet model or is cleaned up with Debris.

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local State = require(script.Parent.State)
local UI = require(script.Parent.ui.UI)
local Anim = require(script.Parent.Anim)
local ZZZ = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config")).PetZzz

local PetMoodFx = {}

local PINK = Color3.fromRGB(255, 105, 150)

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function reduced(): boolean
	return UI.Reduced or settings().ReducedMotion == true
end

local function lowFx(): boolean
	return settings().LowEffects == true
end

-- the part a billboard hangs on: the head when there is one, else the body / primary part
local function anchorOf(m: Model): BasePart?
	local h = m:FindFirstChild("Head", true)
	if h and h:IsA("BasePart") then
		return h
	end
	local b = m.PrimaryPart or m:FindFirstChild("Body", true)
	return if b and b:IsA("BasePart") then b else nil
end

local function topOf(m: Model, part: BasePart): number
	local h = m:GetAttribute("Height")
	local height = if type(h) == "number" then h else 2
	-- studs from the anchor part's centre up to a little above the pet's top
	return math.max(part.Size.Y * 0.5, height - (part.Position.Y - m:GetPivot().Position.Y)) + 0.6
end

-- A heart from a rotated square and two round lobes (centred in a size x size box).
local function heart(parent: Instance, size: number): { Frame }
	local half = size * 0.5
	local pieces: { Frame } = {}
	local sq = Instance.new("Frame")
	sq.BorderSizePixel = 0
	sq.BackgroundColor3 = PINK
	sq.AnchorPoint = Vector2.new(0.5, 0.5)
	sq.Size = UDim2.fromOffset(half, half)
	sq.Position = UDim2.new(0.5, 0, 0.5, size * 0.12)
	sq.Rotation = 45
	sq.Parent = parent
	table.insert(pieces, sq)
	for _, dx in { -1, 1 } do
		local lobe = Instance.new("Frame")
		lobe.BorderSizePixel = 0
		lobe.BackgroundColor3 = PINK
		lobe.AnchorPoint = Vector2.new(0.5, 0.5)
		lobe.Size = UDim2.fromOffset(half, half)
		lobe.Position = UDim2.new(0.5, dx * size * 0.18, 0.5, -size * 0.06)
		lobe.Parent = parent
		UI.corner(lobe, half)
		table.insert(pieces, lobe)
	end
	return pieces
end

-- Little hearts rise over a pet that was just equipped (about 1.3 s, a beat apart).
function PetMoodFx.hearts(m: Model)
	local part = anchorOf(m)
	if not part then
		return
	end
	local top = topOf(m, part)
	local n = if lowFx() then 1 else 3
	local still = reduced()
	for i = 1, n do
		task.delay((i - 1) * 0.18, function()
			if not part.Parent then
				return
			end
			local bb = Instance.new("BillboardGui")
			bb.Name = "PetHeart"
			bb.Adornee = part
			bb.Size = UDim2.fromOffset(28, 28)
			bb.LightInfluence = 0
			bb.MaxDistance = 60
			bb.ResetOnSpawn = false
			local dx = (i - (n + 1) / 2) * 0.7
			bb.StudsOffsetWorldSpace = Vector3.new(dx, top, 0)
			local pieces = heart(bb, if i == 2 then 22 else 18)
			bb.Parent = m
			local info = TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			if not still then
				TweenService:Create(bb, info, { StudsOffsetWorldSpace = Vector3.new(dx * 1.4, top + 2.2, 0) }):Play()
			end
			local fadeInfo = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.65)
			for _, p in pieces do
				TweenService:Create(p, fadeInfo, { BackgroundTransparency = 1 }):Play()
			end
			Debris:AddItem(bb, 1.2)
		end)
	end
end

-- Sleepy bubble: on = show / keep the floating "Zzz" over the pet, off = remove it. Call update() every frame with
-- the clock while it is on (the bubble rises and fades on a 2 s loop, no tweens).
function PetMoodFx.setZzz(m: Model, on: boolean): BillboardGui?
	local bb = m:FindFirstChild("PetZzz")
	if not on or lowFx() then
		if bb then
			bb:Destroy()
		end
		return nil
	end
	if bb and bb:IsA("BillboardGui") then
		return bb
	end
	local part = anchorOf(m)
	if not part then
		return nil
	end
	local g = Instance.new("BillboardGui")
	g.Name = "PetZzz"
	g.Adornee = part
	g.Size = UDim2.fromOffset(ZZZ.Width, ZZZ.Height) -- small and faint (Config.PetZzz)
	g.LightInfluence = 0
	g.MaxDistance = 45
	g.ResetOnSpawn = false
	g:SetAttribute("Top", topOf(m, part))
	UI.text(g, "Zzz", {
		Name = "Z", Font = UI.Bold, TextSize = ZZZ.TextSize, Outline = "Normal", TextColor3 = Color3.fromRGB(200, 225, 255),
		TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1),
	})
	g.Parent = m
	return g
end

function PetMoodFx.updateZzz(g: BillboardGui, t: number, phase: number)
	local top = g:GetAttribute("Top")
	local y = if type(top) == "number" then top else 2
	local k = if reduced() then 0.3 else ((t * 0.5 + phase) % 1)
	g.StudsOffsetWorldSpace = Vector3.new(0.5 + 0.4 * k, y + 1.4 * k, 0)
	local lbl = g:FindFirstChild("Z")
	if lbl and lbl:IsA("TextLabel") then
		local a = if k < 0.2 then 1 - k / 0.2 else (k - 0.2) / 0.8
		local fade = ZZZ.Faint + (1 - ZZZ.Faint) * a * a
		lbl.TextTransparency = fade
		local stroke = lbl:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = fade
		end
	end
end

-- An unequipped follower shrinks away (0.3 s) and leaves a little poof; the model is destroyed afterwards.
-- The caller has already taken it out of its follower list.
function PetMoodFx.shrinkAway(m: Model)
	if not m.Parent then
		m:Destroy()
		return
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BillboardGui") then
			d.Enabled = false
		end
	end
	local at = m:GetPivot().Position
	local okS, s0 = pcall(function()
		return m:GetScale()
	end)
	local base = if okS then s0 else 1
	Anim.run(0.3, function(k)
		if m.Parent then
			local e = 1 - (1 - k) * (1 - k)
			pcall(function()
				m:ScaleTo(base * math.max(0.05, 1 - 0.95 * e))
			end)
		end
	end, function()
		pcall(function()
			require(script.Parent.HitFx).poof(at + Vector3.new(0, 0.5, 0))
		end)
		m:Destroy()
	end)
end

return PetMoodFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="316">
          <Properties>
            <string name="Name">PetMotionBridge</string>
            <string name="Source"><![CDATA[--!strict
-- Optional bridge to the owner's ReplicatedStorage.PetMotion (client only; animates the real skinned pet meshes from
-- ReplicatedStorage.PetModels). API used: start(model), hatch(model), celebrate(model), play(model, clip) and the model attribute Anim. Every call is pcall'd and does nothing when the
-- module is missing or fails to load (offline preview, places without the meshes), or when the model is a
-- procedural stand-in (PetModel sets attribute Mesh = true only on template pets).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PetMotionBridge = {}

local motion: any = nil
local tried = false

local function get(): any
	if tried then
		return motion
	end
	tried = true
	local mod = ReplicatedStorage:FindFirstChild("PetMotion")
	if mod and mod:IsA("ModuleScript") then
		local ok, res = pcall(require, mod)
		if ok and type(res) == "table" then
			motion = res
		else
			warn("[PetMotionBridge] PetMotion did not load:", res)
		end
	end
	return motion
end

local function isMesh(model: Instance?): boolean
	return model ~= nil and model:IsA("Model") and model:GetAttribute("Mesh") == true
end
PetMotionBridge.isMesh = isMesh

-- Moves the base pose of a model PetMotion is animating (it re-pivots the model every frame from that base).
-- Returns false when PetMotion is not driving it, so the caller can PivotTo the model itself.
function PetMotionBridge.setBase(model: Model, cf: CFrame): boolean
	local m = get()
	if not m or type(m.setBase) ~= "function" or not isMesh(model) then
		return false
	end
	return (pcall(m.setBase, model, cf))
end

-- Idle / walk animation for a mesh pet shown somewhere (plots, domes, stands). Returns whether it started.
function PetMotionBridge.start(model: Model): boolean
	local m = get()
	if not m or type(m.start) ~= "function" or not isMesh(model) then
		return false
	end
	local ok, err = pcall(m.start, model)
	if not ok then
		warn("[PetMotionBridge] start failed:", err)
	end
	return ok
end

-- The hatch animation (the pet bursting out of its egg). Returns whether it played.
function PetMotionBridge.hatch(model: Model): boolean
	local m = get()
	if not m or type(m.hatch) ~= "function" or not isMesh(model) then
		return false
	end
	local ok, err = pcall(m.hatch, model)
	if not ok then
		warn("[PetMotionBridge] hatch failed:", err)
	end
	return ok
end

-- Victory dance (two spinning hops; no roar, owner rule) when the owner wins a hunt. Returns whether it played.
function PetMotionBridge.celebrate(model: Model): boolean
	local m = get()
	if not m or type(m.celebrate) ~= "function" or not isMesh(model) then
		return false
	end
	local ok, err = pcall(m.celebrate, model)
	if not ok then
		warn("[PetMotionBridge] celebrate failed:", err)
	end
	return ok
end

-- One-shot clip from the owner's PetClips ("attack", "hit", "win"), when this PetMotion has play(). Returns whether
-- it played; nothing happens without the clips.
function PetMotionBridge.play(model: Model?, clip: string): boolean
	local m = get()
	if not model or not m or type(m.play) ~= "function" or not isMesh(model) then
		return false
	end
	local ok, res = pcall(m.play, model, clip)
	return ok and res ~= false
end

-- Looping clip ("idle", "walk", "run", "train"; nil = PetMotion's built-in motion) through the model attribute Anim,
-- which PetMotion cross-fades to (0.2 s). Only mesh pets carry it.
function PetMotionBridge.setAnim(model: Model?, anim: string?)
	if model and isMesh(model) and model:GetAttribute("Anim") ~= anim then
		model:SetAttribute("Anim", anim)
	end
end

return PetMotionBridge
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="317">
          <Properties>
            <string name="Name">PetSparkle</string>
            <string name="Source"><![CDATA[--!strict
-- Rare pet sparkles follow the viewer's Low Effects setting (client only, cosmetic). PetModel tags every rarity
-- Sparkles, trait sparkles, Legendary beams and rarity PointLights "PetSparkle" (followers built here, gallery pets built on the server); this turns them all off locally
-- while Settings.LowEffects is on and back on when it is off. Nothing is sent anywhere.

local CollectionService = game:GetService("CollectionService")

local State = require(script.Parent.State)

local PetSparkle = {}

local TAG = "PetSparkle"

local function low(): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings.LowEffects == true
end

-- Tagged pet FX: rarity and Rainbow / Silver Cosmic sparkles, Legendary beams, rarity glow lights, the follower
-- particle traits from PetFx (element embers / snowflakes / ..., Golden / Rainbow shimmer) and the Golden / Rainbow
-- follower trails (PetTrail).
local function apply(inst: Instance, on: boolean)
	if inst:IsA("Sparkles") or inst:IsA("Beam") or inst:IsA("Light") or inst:IsA("ParticleEmitter") or inst:IsA("Trail") then
		(inst :: any).Enabled = on
	end
end

local started = false
function PetSparkle.start()
	if started then
		return
	end
	started = true
	local current = not low()
	for _, inst in CollectionService:GetTagged(TAG) do
		apply(inst, current)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(inst)
		apply(inst, not low())
	end)
	State.Changed.Event:Connect(function(what)
		if what ~= "Profile" then
			return
		end
		local on = not low()
		if on ~= current then
			current = on
			for _, inst in CollectionService:GetTagged(TAG) do
				apply(inst, on)
			end
		end
	end)
end

return PetSparkle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="318">
          <Properties>
            <string name="Name">PetTrail</string>
            <string name="Source"><![CDATA[--!strict
-- Golden and Rainbow follower pets leave a short sparkle trail as they move (client only, cosmetic). PetFollow calls
-- attach() on each follower it builds; the Trail lives inside the pet model, so it goes away with it. The trail is
-- tagged "PetSparkle", so the Low Effects setting turns it off and on with the other pet sparkles (PetSparkle).

local CollectionService = game:GetService("CollectionService")

local PetTrail = {}

local GOLD = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 244, 190)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 206, 70)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(230, 150, 30)),
})
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 0.6, 1)),
	ColorSequenceKeypoint.new(0.2, Color3.fromHSV(0.12, 0.6, 1)),
	ColorSequenceKeypoint.new(0.4, Color3.fromHSV(0.3, 0.6, 1)),
	ColorSequenceKeypoint.new(0.6, Color3.fromHSV(0.5, 0.6, 1)),
	ColorSequenceKeypoint.new(0.8, Color3.fromHSV(0.7, 0.6, 1)),
	ColorSequenceKeypoint.new(1, Color3.fromHSV(0.85, 0.6, 1)),
})

function PetTrail.attach(model: Model, modifier: any)
	local colors = if modifier == "Golden" then GOLD elseif modifier == "Rainbow" then RAINBOW else nil
	if not colors then
		return
	end
	local body = model:FindFirstChild("Body", true)
	local part: BasePart? = if body and body:IsA("BasePart") then body else (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true))
	if not part then
		return
	end
	local h = tonumber(model:GetAttribute("Height")) or 1.5
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailTop"
	a0.Position = Vector3.new(0, h * 0.18, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailBottom"
	a1.Position = Vector3.new(0, -h * 0.18, 0)
	a1.Parent = part
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Color = colors
	tr.Transparency = NumberSequence.new(0.6, 1) -- a soft hint of shine, never a streak over the view
	tr.WidthScale = NumberSequence.new(1, 0.1)
	tr.Lifetime = 0.25
	tr.MinLength = 0.15
	tr.LightEmission = 0.4
	tr.FaceCamera = true
	CollectionService:AddTag(tr, "PetSparkle") -- Low Effects turns it off (PetSparkle)
	tr.Parent = part
end

return PetTrail
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="319">
          <Properties>
            <string name="Name">PhotoMode</string>
            <string name="Source"><![CDATA[--!strict
-- Photo mode (client only, lobby only, desktop P key; the HUD camera button was removed 2026-10-12, owner) hides every screen UI (the
-- game's ScreenGuis and Roblox's core UI) and gives a free orbit camera around the own avatar for screenshots of
-- pets. Drag to turn (mouse or one finger), wheel / pinch to zoom. A small X (or Esc / P / gamepad B) leaves; a
-- hunt starting or the character respawning leaves too. Nothing is sent to the server.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)
local CameraMode = require(script.Parent.CameraMode)
local UI = require(script.Parent.ui.UI)

local PhotoMode = {}

local CINE = "PhotoMode"
local MIN_DIST, MAX_DIST = 4, 40
local player = Players.LocalPlayer

local active = false
local exitGui: ScreenGui? = nil
local hidden: { ScreenGui } = {}
local coreWas: boolean? = nil
local conns: { RBXScriptConnection } = {}
local yaw, pitch, dist = 0, math.rad(-12), 12
local dragging = false
local hiddenTags: { BillboardGui } = {} -- follower name tags live in the world, so they are hidden by hand

local function setTags(on: boolean)
	if on then
		for _, b in hiddenTags do
			if b.Parent then
				b.Enabled = true
			end
		end
		table.clear(hiddenTags)
		return
	end
	local f = Workspace:FindFirstChild("CTR_Pets")
	if not f then
		return
	end
	for _, d in f:GetDescendants() do
		if d:IsA("BillboardGui") and d.Name == "PetTag" and d.Enabled then
			d.Enabled = false
			table.insert(hiddenTags, d)
		end
	end
end

local function headOf(): BasePart?
	local char = player.Character
	local h = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
	return if h and h:IsA("BasePart") then h else nil
end

local function exit()
	if not active then
		return
	end
	active = false
	dragging = false
	for _, c in conns do
		c:Disconnect()
	end
	table.clear(conns)
	ContextActionService:UnbindAction("CTR_PhotoExit")
	RunService:UnbindFromRenderStep("CTR_PhotoMode")
	for _, g in hidden do
		if g.Parent then
			g.Enabled = true
		end
	end
	table.clear(hidden)
	setTags(true)
	if coreWas ~= false then
		pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
		end)
	end
	coreWas = nil
	if exitGui then
		exitGui.Enabled = false
	end
	UI.block(CINE, false)
	CameraMode.cinematic(CINE, false)
end

local function ensureExit(): ScreenGui
	if exitGui and exitGui.Parent then
		return exitGui :: ScreenGui
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "CT_PhotoMode"
	sg.ResetOnSpawn = false
	sg.DisplayOrder = 40
	sg.Enabled = false
	sg.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	sg.Parent = player:WaitForChild("PlayerGui")
	local x = UI.closeButton(sg, exit, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -UI.T.Edge, 0, UI.T.Edge) })
	x.BackgroundTransparency = 0.45
	exitGui = sg
	return sg
end

local function step()
	local cam = Workspace.CurrentCamera
	local head = headOf()
	if not cam or not head or State.Match ~= nil then
		task.defer(exit)
		return
	end
	local focus = head.Position + Vector3.new(0, 0.5, 0)
	local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	cam.CFrame = CFrame.new(focus) * rot * CFrame.new(0, 0, dist)
end

local function enter()
	if active or State.Match ~= nil or CameraMode.inHunt() or UI.blocked() then
		return
	end
	local cam = Workspace.CurrentCamera
	local head = headOf()
	if not cam or not head then
		return
	end
	active = true
	-- start from the current view
	local look = cam.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	pitch = math.clamp(math.asin(math.clamp(look.Y, -1, 1)), math.rad(-80), math.rad(60))
	dist = math.clamp((cam.CFrame.Position - head.Position).Magnitude, MIN_DIST, MAX_DIST)
	-- hide the screen UI (ours and Roblox's)
	local mine = ensureExit()
	for _, g in player:WaitForChild("PlayerGui"):GetChildren() do
		if g:IsA("ScreenGui") and g ~= mine and g.Enabled then
			g.Enabled = false
			table.insert(hidden, g)
		end
	end
	local okCore, was = pcall(function()
		return StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.All)
	end)
	coreWas = if okCore then was else nil
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
	end)
	mine.Enabled = true
	setTags(false)
	UI.block(CINE, true) -- touch controls off, gameplay input suspended (CameraMode)
	CameraMode.cinematic(CINE, true)
	cam.CameraType = Enum.CameraType.Scriptable
	table.insert(conns, UserInputService.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.Touch then
			dragging = true
		end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
	table.insert(conns, UserInputService.InputChanged:Connect(function(input: InputObject)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseWheel then
			dist = math.clamp(dist - input.Position.Z * 2, MIN_DIST, MAX_DIST)
		elseif dragging and (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) then
			local d: Vector3 = input.Delta
			yaw -= d.X * 0.008
			pitch = math.clamp(pitch - d.Y * 0.008, math.rad(-80), math.rad(60))
		elseif t == Enum.UserInputType.Gamepad1 and input.KeyCode == Enum.KeyCode.Thumbstick2 then
			local p: Vector3 = input.Position
			if p.Magnitude > 0.2 then
				yaw -= p.X * 0.05
				pitch = math.clamp(pitch + p.Y * 0.04, math.rad(-80), math.rad(60))
			end
		end
	end))
	local lastScale = 1
	table.insert(conns, UserInputService.TouchPinch:Connect(function(_, scale, _, state)
		if state == Enum.UserInputState.Begin then
			lastScale = 1
		end
		dist = math.clamp(dist * lastScale / math.max(scale, 0.05), MIN_DIST, MAX_DIST)
		lastScale = scale
	end))
	table.insert(conns, player.CharacterRemoving:Connect(function()
		task.defer(exit)
	end))
	ContextActionService:BindActionAtPriority("CTR_PhotoExit", function(_, state)
		if state == Enum.UserInputState.Begin then
			task.defer(exit)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.Escape, Enum.KeyCode.P, Enum.KeyCode.ButtonB)
	RunService:BindToRenderStep("CTR_PhotoMode", Enum.RenderPriority.Camera.Value + 5, step)
end

function PhotoMode.isActive(): boolean
	return active
end

function PhotoMode.start()
	State.Changed.Event:Connect(function(what)
		if what == "Match" and State.Match ~= nil then
			exit()
		end
	end)
	-- desktop: P enters
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and not active and input.KeyCode == Enum.KeyCode.P then
			enter()
		end
	end)
end

return PhotoMode
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="320">
          <Properties>
            <string name="Name">PileView</string>
            <string name="Source"><![CDATA[--!strict
-- Local pile and the hunt's contextual action (V3 loop, docs/V3_LOOP.md).
--
-- Pile: rebuilds the server's deterministic layout (Pile + the Init stacks, the same positions the
-- server uses for range checks) and draws ONE Model per collectible rock (twelve silhouettes from
-- GeodeModel.rockShell, picked from the opaque id and the round seed only, so nothing about a rock
-- says whether it hides the geode). Rocks inside the mound are single-part fillers; rocks on the
-- surface are full models. Nothing decorative lies around the base (the arena floor shows through).
-- Every part is anchored and never collides, so the mound cannot trap or launch anyone.
--
-- Targeting: exactly one restrained yellow outline on the pickable rock nearest the avatar
-- (facing preferred), the same id the PICK UP request sends and the server validates.
--
-- Action: one contextual button (Hud) and E / gamepad. `PileView.context()` decides what the button
-- means from the server snapshot (basket, tray, machine, bag), the avatar's position and the rocks in
-- reach, using the same ranges as the server, which still has the last word. Holding repeats at the
-- server cadence (pickup 0.45 s, crush at the tool's rate). The action is latched when the press
-- starts, so finishing a deposit never turns into a crush while the finger is still down.
-- Nothing is ever cracked at the pile.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Pile = require(Shared.Pile)
local EggFall = require(Shared.EggFall)
local GeodeModel = require(Shared.GeodeModel)
local Net = require(Shared.Net)
local State = require(script.Parent.State)
local Anim = require(script.Parent.Anim)
local ToolAnim = require(script.Parent.ToolAnim)
local CarryView = require(script.Parent.CarryView)
local StationView = require(script.Parent.StationView)
local GuideArrow = require(script.Parent.GuideArrow)
local UI = require(script.Parent.ui.UI)
local Audio = require(script.Parent.Audio)
local ActionRules = require(Shared.ActionRules)
local AimResolve = require(Shared.AimResolve)
local HuntFun = require(Shared.HuntFun)
local CameraMode = require(script.Parent.CameraMode)
local CameraGuard = require(script.Parent.CameraGuard)

local player = Players.LocalPlayer
local PileView = {}

local pile: Pile.Pile? = nil
local center = Vector3.zero
local round = 0
local seed = 1
local folder: Folder? = nil
local gritFolder: Folder? = nil
local rocks: { [number]: Model } = {}
local kind: { [number]: number } = {} -- 0 filler, 1 full, 2 full and pickable
local posCache: { [number]: Vector3 } = {}
local selected: number? = nil
local manual: number? = nil -- rock the player tapped (kept while valid and in reach)
local holding = 0
local heldAction: string? = nil
local lastSolid: { Id: string, Arrow: string?, Target: number?, At: number }? = nil -- last stable action (context jitter guard)
local heldCancelled = false -- the current press lost its meaning; ignored until released
local lastSent: { [string]: number } = {}
local highlight: Highlight
local active = false
local hoppers: { BasePart } = {}
local epoch = 0
local autoCache = { Epoch = -1, At = 0, Pos = Vector3.zero, Look = Vector3.zero, Result = nil :: number? }
local selClock = 0
local ctxCache: any = nil
local ctxAt = 0
local aimed = false -- first person: the reticle ray is on a tagged target (a rock, the own table, a sell hopper)
local mouseHolds: { [InputObject]: boolean } = {}

PileView.Selected = Instance.new("BindableEvent")
PileView.Struck = Instance.new("BindableEvent") -- (rockId) a pickup was sent
PileView.Cracked = Instance.new("BindableEvent") -- (rockId, byMe, removedByMachine, removerUserId)
PileView.Claimed = Instance.new("BindableEvent") -- (ownerUserId, rockIds, seconds) a machine started a rock
PileView.Notice = Instance.new("BindableEvent") -- (text, kind) a hint for the toast line

local function settings()
	return State.Profile and State.Profile.Settings or {}
end

local function notice(text: string, k: string?)
	PileView.Notice:Fire(text, k or "info")
end

local function root(): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function flat(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Pile drawing ---------------------------------------------------------------------------------

-- Where and how big an egg is drawn: the server position plus a small seeded offset (no lattice) and a seeded size.
-- Eggs lie on their side, long axis along the mound's ring (owner video: upright eggs clipped into each other, since a
-- layer is only 0.62 egg sizes tall and the columns are one egg size apart). Lying, an egg is 0.78 x its length tall,
-- about one layer, and its length runs between its ring neighbours. The server only ever sees its own position.
local function placement(id: number): (CFrame, number)
	local p = pile :: Pile.Pile
	local rock = p.Rocks[id]
	local s = p.RockSize
	local pos = (p:localPosition(id) :: Vector3)
	local r = Random.new(seed % 100000 * 131 + id * 17)
	local off = Vector3.new(r:NextNumber(-0.04, 0.04) * s, r:NextNumber(-0.04, 0.02) * s, r:NextNumber(-0.04, 0.04) * s)
	local size = s * math.min(rock.Scale, 1.05) * r:NextNumber(0.7, 0.8)
	local _, _, yaw = GeodeModel.rockLook(id, seed)
	local radial = Vector3.new(pos.X, 0, pos.Z)
	local heading = if radial.Magnitude > 0.2 * s then math.atan2(-radial.X, -radial.Z) else math.rad(yaw)
	-- long axis (the egg's local Y) tangent to the ring, a little seeded play so the rows never look machined
	local lay = CFrame.Angles(0, heading + math.rad(r:NextNumber(-14, 14)), 0) * CFrame.Angles(0, 0, math.rad(90 + r:NextNumber(-10, 10)))
	return CFrame.new(center + pos + off) * lay * CFrame.Angles(0, math.rad(yaw), 0), size
end

local function wantKind(id: number): number
	local p = pile :: Pile.Pile
	if not p:isExposed(id) then
		return 0
	end
	return if p:isPickable(id, Config.Carry.ReachLevels) then 2 else 1
end

local function dropModel(id: number)
	local m = rocks[id]
	if m then
		m:Destroy()
		rocks[id] = nil
	end
	kind[id] = nil
	posCache[id] = nil
	epoch += 1
end

local function buildModel(id: number, k: number, cf: CFrame, size: number): Model
	local variant, tint = GeodeModel.rockLook(id, seed)
	local m = GeodeModel.rockShell(variant, size, tostring(id), { Tint = tint, Low = k == 0, Interactive = k == 2 })
	m:PivotTo(cf)
	m.Parent = folder
	return m
end

-- Gravity (carter 2026-10-16): an egg that moves on the pile falls with EggFall: it speeds up, lands, bounces once.
-- Sideways moves (the gold overtime egg, a returned egg) hop over the mound first. A newer move of the same egg wins.
local falling: { [Model]: number } = {}
local function fall(model: Model, from: CFrame, goal: CFrame)
	local p = pile :: Pile.Pile
	local plan = EggFall.plan(from.Position, goal.Position, Config.Match.EggGravity, p.RockSize * 0.12, p.RockSize * 0.5, p.RockSize * 2.5)
	local token = (falling[model] or 0) + 1
	falling[model] = token
	local spin = from.Rotation
	local spinTo = goal.Rotation
	Anim.run(plan.Dur, function(k)
		if model.Parent and falling[model] == token then
			local t = k * plan.Dur
			model:PivotTo(CFrame.new(EggFall.at(plan, t)) * spin:Lerp(spinTo, EggFall.turn(plan, t)))
		end
	end, function()
		if falling[model] == token then
			falling[model] = nil
		end
	end)
end

local function renderColumn(ci: number, animate: boolean)
	local p = pile :: Pile.Pile
	for _, id in p.Columns[ci].Stack do
		local k = wantKind(id)
		local cf, size = placement(id)
		local m: Model? = rocks[id]
		if m and kind[id] ~= k then
			-- exposure changed: swap the filler for a full model (or back)
			dropModel(id)
			m = nil
		end
		if not m then
			rocks[id] = buildModel(id, k, cf, size)
			kind[id] = k
			posCache[id] = cf.Position
			epoch += 1
		elseif (m:GetPivot().Position - cf.Position).Magnitude > 0.05 then
			posCache[id] = cf.Position
			if animate and not settings().ReducedMotion then
				fall(m, m:GetPivot(), cf)
			else
				m:PivotTo(cf)
			end
		end
	end
end

local function refreshAround(ci: number)
	local p = pile :: Pile.Pile
	renderColumn(ci, true)
	for _, nb in p.Columns[ci].Neighbors do
		renderColumn(nb, true)
	end
end

local priorityId: number? = nil -- the gold overtime egg (PileView.setPriority)

local function clear()
	priorityId = nil
	if folder then
		folder:Destroy()
	end
	if gritFolder then
		gritFolder:Destroy()
	end
	folder, gritFolder = nil, nil
	table.clear(rocks)
	table.clear(kind)
	table.clear(posCache)
	table.clear(hoppers)
	epoch += 1
	pile = nil
	selected, manual = nil, nil
	highlight.Adornee = nil
	highlight.Enabled = false
	ctxCache = nil
	lastSolid = nil
	holding, heldAction, heldCancelled = 0, nil, false
	table.clear(lastSent)
end

-- Pickup dust: a couple of chips only (the rock itself flies to the basket).
local function puff(pos: Vector3)
	if settings().LowEffects then
		return
	end
	local rng = Random.new(math.floor(pos.X * 10 + pos.Z * 7))
	for _ = 1, 3 do
		local c = GeodeModel.grit(rng, 0.25)
		c.Parent = gritFolder or Workspace
		local goal = pos + Vector3.new(rng:NextNumber(-1, 1), -pos.Y + 0.1, rng:NextNumber(-1, 1))
		Anim.run(0.35, function(k)
			c.CFrame = CFrame.new(Anim.arc(pos, goal, 0.6, Anim.easeOut(k)))
			c.Transparency = k * k
		end, function()
			c:Destroy()
		end)
	end
end

-- Selection --------------------------------------------------------------------------------------

local function reachRange(): number
	local s = if pile then (pile :: Pile.Pile).RockSize else 2
	return Config.Carry.PickupRange + s * 0.5 - 0.8 -- a little inside the server's limit
end

-- The gold overtime egg (EggFx sets it with the glow): picked first whenever it is in reach (HuntFun.pickTarget).
function PileView.setPriority(id: number?)
	if priorityId ~= id then
		priorityId = id
		epoch += 1
	end
end

local function validTarget(id: number?): boolean
	return id ~= nil and pile ~= nil and (rocks[id] :: Model?) ~= nil and not (pile :: Pile.Pile).Removed[id] and (pile :: Pile.Pile):isPickable(id, Config.Carry.ReachLevels)
end

local function inReach(id: number): boolean
	local r = root()
	local pos = posCache[id]
	if not r or not pos then
		return false
	end
	return flat(pos, r.Position) <= reachRange()
end

-- Nearest pickable rock in reach, the one the avatar (and camera) faces preferred. Reused for
-- 0.15 s while the rock set is unchanged and the avatar has barely moved or turned.
local function autoTarget(): number?
	local r = root()
	if not r or not pile then
		return nil
	end
	local rp = r.Position
	local look = r.CFrame.LookVector
	local now = os.clock()
	local c = autoCache
	if c.Epoch == epoch and now - c.At < 0.15 and (rp - c.Pos).Magnitude < 0.5 and look:Dot(c.Look) > 0.99 then
		return c.Result
	end
	local cam = Workspace.CurrentCamera
	local camLook = if cam then Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z) else Vector3.zero
	if camLook.Magnitude > 0.01 then
		camLook = camLook.Unit
	end
	local cands: { HuntFun.TargetCand } = {}
	for id, k in kind do
		local pos = posCache[id]
		if k == 2 and pos then
			table.insert(cands, { Id = id, Pos = pos })
		end
	end
	local best = HuntFun.pickTarget(cands, rp, look, camLook, reachRange(), priorityId)
	c.Epoch, c.At, c.Pos, c.Look, c.Result = epoch, now, rp, look, best
	return best
end

-- First person: the camera-centre ray (docs/m6/FIRST_PERSON.md section 3) -------------------------------

-- Is the straight line from the eye to a tagged target free of real world geometry? The pile itself, the
-- avatars and decorative trim (CameraGuard.ignorable) never block; the target's own model is skipped.
local function sightClear(from: Vector3, to: Vector3, own: Instance?): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local skip: { Instance } = {}
	for _, plr in Players:GetPlayers() do
		if plr.Character then
			table.insert(skip, plr.Character)
		end
	end
	for _, name in { "CT_Rocks_LocalPile", "CT_Rocks_Grit", "CT_Rocks_Guide", "CT_Rocks_Selection" } do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(skip, f)
		end
	end
	if Workspace.CurrentCamera then
		table.insert(skip, Workspace.CurrentCamera)
	end
	if own then
		table.insert(skip, own)
	end
	local delta = to - from
	local dist = delta.Magnitude
	if dist < 0.5 then
		return true
	end
	for _ = 1, 6 do
		params.FilterDescendantsInstances = skip
		local hit = Workspace:Raycast(from, delta, params)
		if not hit then
			return true
		end
		if (hit.Position - from).Magnitude >= dist - 0.6 then
			return true
		end
		if not CameraGuard.ignorable(hit.Instance) then
			return false
		end
		table.insert(skip, hit.Instance)
	end
	return true
end

local function aimRay(): (Vector3?, Vector3?)
	local cam = Workspace.CurrentCamera
	if not cam then
		return nil, nil
	end
	return cam.CFrame.Position, cam.CFrame.LookVector
end

-- The pickable rock in reach the reticle is on (the one that is outlined and sent), or nil.
local function fpRockTarget(): number?
	local origin, dir = aimRay()
	if not origin or not dir or not pile then
		return nil
	end
	local radius = (pile :: Pile.Pile).RockSize * 0.5
	local cands: { AimResolve.Candidate } = {}
	for id, k in kind do
		if k == 2 and inReach(id) then
			local pos = posCache[id]
			if pos then
				table.insert(cands, { Key = id, Kind = "rock", Pos = pos, Radius = radius })
			end
		end
	end
	local pid = priorityId
	if pid and kind[pid] == 2 and inReach(pid) and posCache[pid] and sightClear(origin, posCache[pid] :: Vector3, nil) then
		return pid -- the gold overtime egg in reach: no need to aim at it exactly
	end
	for _ = 1, 3 do
		local c = AimResolve.pick(origin, dir, cands, Config.Camera.Reach, Config.Camera.Slack)
		if not c then
			return nil
		end
		if sightClear(origin, c.Pos, nil) then
			return c.Key :: number
		end
		table.remove(cands, table.find(cands, c) :: number)
	end
	return nil
end

-- Is the ray on a rock that exists but is out of reach (a "move closer" is worth saying)?
local function fpFarRock(): boolean
	local origin, dir = aimRay()
	if not origin or not dir or not pile then
		return false
	end
	local radius = (pile :: Pile.Pile).RockSize * 0.5
	local cands: { AimResolve.Candidate } = {}
	for id, k in kind do
		if k ~= 0 then
			local pos = posCache[id]
			if pos then
				table.insert(cands, { Key = id, Kind = "rock", Pos = pos, Radius = radius })
			end
		end
	end
	return AimResolve.pick(origin, dir, cands, Config.Camera.FarReach, Config.Camera.Slack) ~= nil
end

-- Is the ray on a tagged static target (own table surface, a sell hopper)?
local function fpAimAt(pos: Vector3, radius: number, reach: number, own: Instance?): boolean
	local origin, dir = aimRay()
	if not origin or not dir then
		return false
	end
	local c = AimResolve.pick(origin, dir, { { Key = "t", Kind = "target", Pos = pos, Radius = radius } }, reach, Config.Camera.Slack)
	return c ~= nil and sightClear(origin, pos, own)
end

function PileView.aimedAtSomething(): boolean
	return aimed
end

local function setSelected(id: number?)
	if selected == id then
		return
	end
	selected = id
	local m: Instance? = if id then rocks[id] else nil
	highlight.Adornee = m
	highlight.Enabled = m ~= nil
	PileView.Selected:Fire(id)
end

function PileView.clearSelection()
	manual = nil
	setSelected(nil)
end

-- The rock an action would take right now (outlined), or nil.
local function currentTarget(): number?
	if CameraMode.firstPerson() then
		manual = nil -- first person aims with the reticle; there is no tap-to-select
		return fpRockTarget()
	end
	if manual and validTarget(manual) and inReach(manual :: number) then
		return manual
	end
	manual = nil
	local a = autoTarget()
	return a
end

function PileView.selectedId(): number?
	return selected
end

-- Context --------------------------------------------------------------------------------------

local function myStation(): any?
	local m = State.Match
	for _, st in (m and m.Stations) or {} do
		if st.UserId == player.UserId then
			return st
		end
	end
	return nil
end

local function myTablePos(): Vector3?
	return StationView.tablePosition(player.UserId)
end

local function nearHopper(): boolean
	local r = root()
	if not r then
		return false
	end
	for _, b in hoppers do
		if b.Parent and flat(b.Position, r.Position) <= 10 then
			return true
		end
	end
	return false
end

local function toolId(st: any?): string
	return (st and st.Tool) or (State.Profile and State.Profile.EquippedHandheld) or "Hammer"
end

-- Taps per second on the nest: the tool's rate times the pet helper's bonus (server snapshot; HuntFun.Helper).
local function crushRate(st: any?): number
	local tool = Config.Handhelds[toolId(st)] or Config.Handhelds.Hammer
	local help = if st and type(st.Help) == "number" and st.Help >= 1 then st.Help else 1
	return tool.Rate * help
end

-- What the primary action means right now. Returns
--   { Id, Arrow = "table"|"pile"|nil, Target = rock id (pickup) }
-- Ids: wait securing none (no button) and pickup take deposit crush machine collect sell bagfull closer.
-- The decision itself is the pure ActionRules.decide (tested); this function only gathers its inputs from the
-- server snapshot and the avatar's position, and keeps the previous answer for a moment while the avatar
-- jitters across a boundary (large overlapping bounds of mound and table), but never past a round change.
local STICKY = { pickup = true, take = true, deposit = true, crush = true, machine = true, collect = true, bagfull = true }
local STICKY_SECONDS = 0.35

local function nearestPileRock(): number
	local r = root()
	if not r then
		return math.huge
	end
	local best = math.huge
	for id, k in kind do
		if k == 2 then
			local pos = posCache[id]
			if pos then
				best = math.min(best, flat(pos, r.Position))
			end
		end
	end
	return best
end

function PileView.context(force: boolean?): any
	local now = os.clock()
	if ctxCache and not force and now - ctxAt < 0.08 then
		return ctxCache
	end
	local m = State.Match
	local st = myStation()
	local out: any
	local ctx: ActionRules.Context
	if not m or m.Phase ~= "Searching" or not active or not st then
		ctx = ActionRules.decide({
			Phase = if m then m.Phase else nil, Active = active, HasStation = st ~= nil,
			Basket = 0, Capacity = Config.Carry.Capacity, Queue = 0, QueueCapacity = Config.Station.QueueCapacity, Current = false,
			Machine = false, MachineFull = false, Rubble = 0, RubbleFull = false, NearHopper = false,
			AtTable = false, NearTable = false, HasTarget = false, NearPile = false,
		})
		lastSolid = nil
		aimed = false
		out = { Id = ctx.Id, Arrow = ctx.Arrow }
	else
		local r = root()
		local prof = State.Profile
		local basket = #st.Basket
		local tp = myTablePos()
		local dTable = if r and tp then flat(tp, r.Position) else math.huge
		local wasAtTable = lastSolid ~= nil and (lastSolid.Id == "deposit" or lastSolid.Id == "crush" or lastSolid.Id == "machine" or lastSolid.Id == "collect" or lastSolid.Id == "bagfull")
		local atRange = Config.Station.CrushRange - (if wasAtTable then 0.1 else 0.8)
		local target = if r then currentTarget() else nil
		local atTable = dTable <= atRange
		local nearTable = dTable <= Config.Station.CrushRange + 8
		local nearPile = nearestPileRock() <= reachRange() + 9
		local hopper = nearHopper()
		aimed = target ~= nil
		if CameraMode.firstPerson() and r then
			-- One context from the reticle: a pile rock the ray is on wins over a distant table; the sell hopper and the
			-- "move closer" hints appear only when the ray is on them (never for scenery).
			local tableAimed = false
			if tp then
				-- aim at the egg on the plate (the ring used to open on the nest below it)
				local at = StationView.aimPoint(player.UserId) or (tp + Vector3.new(0, 2.6, 0))
				tableAimed = fpAimAt(at, 3.2, Config.Camera.FarReach, StationView.ownModel())
			end
			if target ~= nil and dTable > Config.Camera.WorkRadius then
				atTable = false
			end
			nearTable = tableAimed and dTable <= Config.Station.CrushRange + 8
			nearPile = target == nil and fpFarRock() and nearestPileRock() <= reachRange() + 9
			if hopper then
				local close = false
				local aimedHopper = false
				for _, b in hoppers do
					if b.Parent then
						if flat(b.Position, r.Position) <= 3.5 then
							close = true
						end
						if not aimedHopper and fpAimAt(b.Position, 3.2, 14, b.Parent) then
							aimedHopper = true
						end
					end
				end
				hopper = close or aimedHopper
			end
			aimed = target ~= nil or tableAimed or (hopper and (prof ~= nil and prof.Rubble > 0))
		end
		ctx = ActionRules.decide({
			Phase = m.Phase, Active = active, HasStation = true,
			Basket = basket, Capacity = st.CarryCap or Config.Carry.Capacity, -- per player (basket / nest upgrades)
			Queue = #st.Queue, QueueCapacity = st.QueueCap or Config.Station.QueueCapacity, Current = st.Current ~= nil,
			Machine = st.Machine ~= nil and st.State ~= "Paused", MachineFull = st.State == "Full",
			Rubble = if prof then prof.Rubble else 0, RubbleFull = prof ~= nil and prof.Rubble >= prof.Capacity,
			NearHopper = hopper,
			AtTable = atTable, NearTable = nearTable,
			HasTarget = target ~= nil, NearPile = nearPile,
		})
		out = { Id = ctx.Id, Arrow = ctx.Arrow, Target = if ctx.Id == "pickup" then target else nil }
		if (ctx.Id == "closer" or ctx.Id == "none") and lastSolid and STICKY[lastSolid.Id] and now - lastSolid.At < STICKY_SECONDS then
			-- brief jitter across a boundary: keep what the button said (a pickup keeps its still-valid target)
			if lastSolid.Id ~= "pickup" or (lastSolid.Target ~= nil and validTarget(lastSolid.Target)) then
				out = { Id = lastSolid.Id, Arrow = lastSolid.Arrow, Target = lastSolid.Target }
			end
		elseif STICKY[ctx.Id] then
			lastSolid = { Id = ctx.Id :: string, Arrow = ctx.Arrow, Target = out.Target :: number?, At = now }
		end
		out.Basket = basket
		out.Queued = #st.Queue + (if st.Current then 1 else 0)
		out.Auto = st.Machine ~= nil and st.State ~= "Paused"
		if out.Id == "crush" and out.Queued == 0 then
			-- no egg on the plate and none in the tray (a held "crush" across a boundary, or the last egg just
			-- cracked): CRACK! would do nothing, so the button says where the next eggs are instead
			local here = ctx.Id == "crush" -- only a held (sticky) CRACK can get here from away from the nest
			out = { Id = if here then "collect" else "none", Arrow = if here then "pile" else ctx.Arrow, Basket = out.Basket, Queued = 0, Auto = out.Auto }
			lastSolid = nil
		end
	end
	ctxCache = out
	ctxAt = now
	return out
end

-- Points the route hint where the context says (the Hud calls this a few times a second). Only one
-- target at a time, only when it helps: a table hint always (rocks are waiting to be deposited), a pile hint
-- for players still learning the loop (`tutorial`) or anyone who has wandered far from the pile (bug 244).
-- Nothing outside a live Searching phase.
local PILE_FAR = 40 -- studs from the pile centre: beyond this the pile hint shows for everyone
function PileView.updateGuide(ctx: any, show: boolean, tutorial: boolean?)
	if not show or not ctx or not ctx.Arrow or not pile then
		GuideArrow.clear()
		return
	end
	if ctx.Arrow == "table" then
		local tp = myTablePos()
		if tp then
			GuideArrow.set(tp, "NEST", center.Y)
			return
		end
	elseif ctx.Arrow == "pile" then
		local r = root()
		if not tutorial and not (r and flat(r.Position, center) > PILE_FAR) then
			GuideArrow.clear()
			return
		end
		GuideArrow.set(center, "PILE", center.Y)
		return
	end
	GuideArrow.clear()
end

-- The server refused something: drop a pickup target that is gone or unreachable so the outline and the
-- next press move on to another rock instead of retrying the same one.
function PileView.onReply(data: any)
	if data.Action == "Pickup" and not data.Ok then
		manual = nil
		if data.Reason == "Gone" or data.Reason == "Unreachable" or data.Reason == "BadRock" then
			epoch += 1
			ctxCache = nil
		end
	end
end

-- Doing it ---------------------------------------------------------------------------------------

local function due(key: string, gap: number): boolean
	local t = os.clock()
	if t - (lastSent[key] or 0) < gap then
		return false
	end
	lastSent[key] = t
	return true
end

-- A small buzz per crack sent (owner pick). Phones / gamepads that support it only; every call is pcall'd (a
-- device without a motor does nothing). Reduced Motion turns it off (there is no separate vibration setting).
local buzzToken = 0
local function crackBuzz()
	local prof = State.Profile
	if prof and prof.Settings and prof.Settings.ReducedMotion == true then
		return
	end
	local input = if UserInputService.TouchEnabled then Enum.UserInputType.Touch else UserInputService:GetLastInputType()
	if input ~= Enum.UserInputType.Touch and string.sub(input.Name, 1, 7) ~= "Gamepad" then
		return
	end
	buzzToken += 1
	local my = buzzToken
	local ok = pcall(function()
		local hs = game:GetService("HapticService")
		if not hs:IsVibrationSupported(input) or not hs:IsMotorSupported(input, Enum.VibrationMotor.Small) then
			error("unsupported")
		end
		hs:SetMotor(input, Enum.VibrationMotor.Small, 0.5)
	end)
	if ok then
		task.delay(0.07, function()
			if my == buzzToken then
				pcall(function()
					game:GetService("HapticService"):SetMotor(input, Enum.VibrationMotor.Small, 0)
				end)
			end
		end)
	end
end

-- The `due` key and gap an action id would use when pressed (mirrors the branches in perform).
local function dueKey(id: string): (string, number)
	if id == "pickup" then
		return "pickup", Config.Carry.PickupInterval + 0.03
	elseif id == "deposit" then
		return "deposit", Config.Station.DepositInterval + 0.12
	elseif id == "crush" then
		return "crush", 1 / crushRate(myStation()) + 0.03
	elseif id == "sell" then
		return "sell", 0.8
	end
	return "hint", 1.2
end

local function perform()
	if not active or UI.blocked() then
		return
	end
	local m = State.Match
	if not m or m.Phase ~= "Searching" then
		return
	end
	if heldCancelled then
		return
	end
	if not CameraMode.mayAct() then
		-- the input that closed a menu (or any press right after it) must not also act: a fresh press is needed
		heldCancelled = true
		return
	end
	-- A fresh press always reads a fresh context (tap responsiveness). While held (called every Heartbeat), the
	-- short-lived cache is enough until the held action can actually fire again; only then is it recomputed.
	local ctx = PileView.context(heldAction == nil)
	if heldAction then
		local key, gap = dueKey(ctx.Id)
		if os.clock() - (lastSent[key] or 0) < gap then
			if ctx.Id ~= heldAction then
				heldCancelled = true
			end
			return
		end
		ctx = PileView.context(true)
	end
	if not heldAction then
		heldAction = ctx.Id
	end
	if ctx.Id ~= heldAction then
		-- the meaning changed under the finger (basket filled, left range, reached the table): this press is
		-- over. Nothing repeats until the finger is lifted and pressed again.
		heldCancelled = true
		return
	end
	local id = ctx.Id
	local remote = Net.event("RockAction")
	if id == "pickup" then
		if due("pickup", Config.Carry.PickupInterval + 0.03) and ctx.Target then
			setSelected(ctx.Target)
			remote:FireServer("Pickup", round, ctx.Target)
			CarryView.scoop(player.UserId)
			PileView.Struck:Fire(ctx.Target)
		end
	elseif id == "deposit" then
		if due("deposit", Config.Station.DepositInterval + 0.12) then
			remote:FireServer("Deposit", round)
		end
	elseif id == "crush" then
		if due("crush", 1 / crushRate(myStation()) + 0.03) then
			remote:FireServer("Crush", round)
			StationView.localSwing()
			crackBuzz()
		end
	elseif id == "sell" then
		if due("sell", 0.8) then
			Net.event("ShopAction"):FireServer("SellAtHopper")
		end
	elseif due("hint", 1.2) then
		if id == "take" then
			notice("Basket full: take eggs to your nest", "info")
		elseif id == "collect" or id == "machine" then
			notice("Collect more eggs at the pile", "info")
		elseif id == "bagfull" then
			notice("Candy bag full: sell at a candy stand", "warn")
		elseif id == "closer" then
			notice("Move closer", "info")
		end
	end
end

function PileView.holdBegin()
	holding += 1
	if holding == 1 then
		heldAction = nil
		heldCancelled = false
		perform()
	end
end

function PileView.holdEnd()
	holding = math.max(0, holding - 1)
	if holding == 0 then
		heldAction = nil
		heldCancelled = false
	end
end

function PileView.isHolding(): boolean
	return holding > 0
end

function PileView.stopAll()
	holding = 0
	heldAction = nil
	heldCancelled = false
	ctxCache = nil
	local char = player.Character
	if char then
		ToolAnim.stop(char)
	end
end

function PileView.isActive(): boolean
	return active
end

-- Server events --------------------------------------------------------------------------------------

function PileView.init(payload: { [string]: any })
	clear()
	round = payload.Round
	seed = payload.Seed or 1
	center = payload.Center
	local tier = Config.Tiers[payload.Tier]
	pile = Pile.new(payload.Rocks, tier.RockSize, tier.Radius, payload.Seed)
	for _, id in payload.Removed or {} do
		(pile :: Pile.Pile):remove(id)
	end
	if payload.Stacks then
		(pile :: Pile.Pile):setStacks(payload.Stacks)
	end
	local f = Instance.new("Folder")
	f.Name = "CT_Rocks_LocalPile"
	f.Parent = Workspace
	folder = f
	local gf = Instance.new("Folder")
	gf.Name = "CT_Rocks_Grit"
	gf.Parent = Workspace
	gritFolder = gf -- pickup dust only: the grass blobs round the base read as dark green discs (Studio sweep 190)
	for ci in (pile :: Pile.Pile).Columns do
		renderColumn(ci, false)
	end
	-- bug 244: a tall soft light beam over the pile centre, seen from anywhere in the arena. It stands on the
	-- centre point above the top of the mound (never on or near any particular egg) and fades with the pile.
	do
		local top = center.Y
		for _, pos in posCache do
			top = math.max(top, pos.Y)
		end
		local base = top + 4
		local height = 140
		-- a thin soft light (a Beam that fades upward, always facing the camera), not a see-through slab
		local beam = Instance.new("Part")
		beam.Name = "PileBeam"
		beam.Size = Vector3.new(0.2, 0.2, 0.2)
		beam.CFrame = CFrame.new(center.X, base, center.Z)
		beam.Transparency = 1
		beam.Anchored = true
		beam.CanCollide = false
		beam.CanQuery = false
		beam.CanTouch = false
		beam.CastShadow = false
		local a0 = Instance.new("Attachment")
		a0.Parent = beam
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, height, 0)
		a1.Parent = beam
		local light = Instance.new("Beam")
		light.Attachment0 = a0
		light.Attachment1 = a1
		light.FaceCamera = true
		light.Width0 = 1.4
		light.Width1 = 0.6
		light.Color = ColorSequence.new(Color3.fromRGB(255, 226, 140))
		light.LightEmission = 0.8
		light.LightInfluence = 0
		light.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(0.6, 0.75), NumberSequenceKeypoint.new(1, 1) })
		light.Segments = 4
		light.Parent = beam
		beam.Parent = f
	end
	-- sell hoppers in this arena (cached; the HUD asks every 0.2 s)
	for _, arena in Workspace:GetChildren() do
		if string.sub(arena.Name, 1, 15) == "CT_Rocks_Arena_" then
			for _, d in arena:GetDescendants() do
				if d:IsA("Model") and d:GetAttribute("Hopper") then
					local body = d:FindFirstChild("Body")
					if body and body:IsA("BasePart") and flat(body.Position, center) < 120 then
						table.insert(hoppers, body)
					end
				end
			end
		end
	end
	active = true
	StationView.init(payload)
	CarryView.init(payload)
	-- delivery drop during the countdown (cosmetic only, no physics)
	if payload.Phase == "Countdown" and not settings().ReducedMotion then
		-- eggs drop in one after another, bottom of the pile first
		local order: { number } = {}
		for id in rocks do
			if kind[id] ~= 0 then
				table.insert(order, id)
			end
		end
		table.sort(order, function(a, b)
			local pa, pb = posCache[a], posCache[b]
			local ya, yb = if pa then pa.Y else 0, if pb then pb.Y else 0
			if ya ~= yb then
				return ya < yb
			end
			return a < b
		end)
		local total = math.min(#order, 140)
		for n = 1, total do
			local m = rocks[order[n]]
			if m then
				local goal = m:GetPivot()
				local lag = (n - 1) / math.max(total, 1) * 0.7
				local d = 0.7
				m:PivotTo(goal + Vector3.new(0, 9, 0))
				Anim.run(d + 0.7, function(t)
					if m.Parent then
						local k = math.clamp((t * (d + 0.7) - lag) / d, 0, 1)
						m:PivotTo(goal + Vector3.new(0, 9 * (1 - Anim.easeOut(k)), 0))
					end
				end)
			end
		end
	end
end

-- The drawn model of a pile egg (nil when it is not drawn or has left the pile). Used by EggFx (wobble hint).
function PileView.eggModel(id: number): Model?
	local m = rocks[id]
	return if m and m.Parent then m else nil
end

function PileView.roundId(): number
	return round
end

function PileView.reserve(_ids: { number }) end
function PileView.release(_ids: { number }) end
function PileView.clearReserved() end
function PileView.reservedCount(): number
	return 0
end

function PileView.remaining(): number
	return if pile then (pile :: Pile.Pile).Remaining else 0
end

function PileView.onRocks(payload: { [string]: any })
	if not pile or payload.Round ~= round then
		return
	end
	local p = pile :: Pile.Pile
	local touched: { [number]: boolean } = {}
	for _, e in payload.Ev or {} do
		if e.Kind == "Pick" then
			local ci = p:remove(e.Id)
			local m = rocks[e.Id]
			local at = posCache[e.Id]
			rocks[e.Id] = nil
			kind[e.Id] = nil
			posCache[e.Id] = nil
			epoch += 1
			if m then
				if at then
					puff(at)
				end
				local b = m.PrimaryPart
				if b then
					b.CanQuery = false
				end
				if e.UserId ~= player.UserId then
					CarryView.scoop(e.UserId)
				end
				if CarryView.hasAvatar(e.UserId) then
					CarryView.fly(e.UserId, m, e.Id)
				else
					m:Destroy()
				end
			end
			if ci then
				touched[ci] = true
			end
			if e.Id == selected then
				setSelected(nil)
			end
			if e.Id == manual then
				manual = nil
			end
		elseif e.Kind == "Return" then
			if p:restoreTo(e.Id, e.Col) then
				touched[e.Col] = true
				epoch += 1
			end
		elseif e.Kind == "Move" then
			-- overtime: the glowing pet egg is lifted onto a reachable edge column (RoundRocks.surface)
			local from = p:remove(e.Id)
			if from and p:restoreTo(e.Id, e.Col) then
				touched[from] = true
				touched[e.Col] = true
				posCache[e.Id] = nil
				epoch += 1
			end
		elseif e.Kind == "Start" and e.UserId and e.Duration then
			PileView.Claimed:Fire(e.UserId, { e.Id }, e.Duration) -- drives MachineView's cycle for one rock
		elseif e.Kind == "Done" or e.Kind == "Found" then
			local viaMachine = false
			for _, st in payload.Stations or {} do
				if st.UserId == e.UserId and st.Machine ~= nil and st.State ~= "Paused" then
					viaMachine = true
				end
			end
			if e.UserId == player.UserId and e.Kind == "Done" and State.Match then
				State.Match.MyCracked = (State.Match.MyCracked or 0) + 1
			end
			PileView.Cracked:Fire(e.Id, e.UserId == player.UserId, viaMachine, e.UserId)
		end
		StationView.onEvent(e, payload.Stations)
	end
	for ci in touched do
		refreshAround(ci)
	end
	for _, e in payload.Ev or {} do
		if e.Kind == "Return" and rocks[e.Id] then
			-- a returned egg drops back onto the pile from above and lands with gravity
			local m = rocks[e.Id]
			if not settings().ReducedMotion then
				local goal = m:GetPivot()
				fall(m, goal + Vector3.new(0, 3, 0), goal)
			end
		end
	end
	StationView.onStations(payload.Stations)
	CarryView.setStations(payload.Stations or {})
	if State.Match then
		State.Match.Remaining = p.Remaining
		State.Match.Counts = payload.Counts
		State.Match.Stations = payload.Stations
		State.update("Match")
	end
end

-- After the find: the rest of the pile crumbles away cosmetically (it pays nothing). The tables
-- keep their geode on show until the round is left.
function PileView.clearPile()
	active = false
	PileView.stopAll()
	setSelected(nil)
	GuideArrow.clear()
	local f = folder
	if not f then
		return
	end
	local reduced = settings().ReducedMotion
	local fade: { BasePart } = {}
	for _, d in f:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(fade, d)
		end
	end
	if reduced then
		f:Destroy()
		folder = nil
		return
	end
	local orig: { number } = {}
	for i, d in fade do
		orig[i] = d.Transparency
	end
	Anim.run(1.2, function(k)
		for i, d in fade do
			if d.Parent then
				d.Transparency = orig[i] + (1 - orig[i]) * k
			end
		end
	end, function()
		if folder == f then
			f:Destroy()
			folder = nil
		end
	end)
end

function PileView.leave()
	active = false
	PileView.stopAll()
	GuideArrow.clear()
	StationView.clear()
	CarryView.clear()
	clear()
end

-- Setup -------------------------------------------------------------------------------------

function PileView.start()
	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 1 -- outline only, so the rock stays readable
	highlight.OutlineColor = Color3.fromRGB(255, 214, 90)
	highlight.OutlineTransparency = 0.15
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	-- A Highlight with no Adornee outlines its parent; keep it in a plain Folder and only enable it
	-- while a rock is selected.
	highlight.Enabled = false
	local hlFolder = Instance.new("Folder")
	hlFolder.Name = "CT_Rocks_Selection"
	hlFolder.Parent = Workspace
	highlight.Parent = hlFolder
	CarryView.start()

	-- Tap / click selects a rock in the pile; drags (camera turns) do not.
	local downAt: { [InputObject]: { pos: Vector2, t: number } } = {}
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe or UI.blocked() then
			return
		end
		if CameraMode.firstPerson() and input.UserInputType == Enum.UserInputType.MouseButton1 then
			-- first person with the mouse locked to the view: a click is the action (the same path as E)
			mouseHolds[input] = true
			PileView.holdBegin()
		elseif CameraMode.firstPerson() and input.UserInputType == Enum.UserInputType.Touch then
			-- a touch is the look drag or the action button's own press, never a pickup by itself
			return
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			downAt[input] = { pos = Vector2.new(input.Position.X, input.Position.Y), t = os.clock() }
		elseif input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonR2 then
			PileView.holdBegin()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if mouseHolds[input] then
			mouseHolds[input] = nil
			PileView.holdEnd()
			return
		end
		if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonR2 then
			PileView.holdEnd()
			return
		end
		local d = downAt[input]
		downAt[input] = nil
		if not d or not active or not folder or UI.blocked() then
			return
		end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if (pos - d.pos).Magnitude > 12 or os.clock() - d.t > 0.35 then
			return
		end
		local cam = Workspace.CurrentCamera
		local ray = cam:ScreenPointToRay(pos.X, pos.Y) -- input.Position is in GUI space (below the top bar), not viewport space (audit 19)
		-- Tap the egg on your own nest plate: one crack, the same "Crush" intent as the CRACK button (the server
		-- checks range, plate and tool rate as for any other Crush).
		local plate = StationView.ownPlate()
		if plate then
			local pp = RaycastParams.new()
			pp.FilterType = Enum.RaycastFilterType.Include
			pp.FilterDescendantsInstances = { plate }
			local ph = Workspace:Raycast(ray.Origin, ray.Direction * 200, pp)
			if ph and StationView.isOwnPlatePart(ph.Instance) and PileView.context(true).Id == "crush" then
				PileView.holdBegin()
				PileView.holdEnd()
				return
			end
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { folder :: Folder }
		local hit = Workspace:Raycast(ray.Origin, ray.Direction * 200, params)
		local model = hit and hit.Instance:FindFirstAncestorOfClass("Model")
		local id = model and tonumber(model.Name)
		if id and validTarget(id) and inReach(id) then
			manual = id
			setSelected(id)
		elseif plate and due("miss", 0.25) then
			Audio.play("Button", { Volume = 0.25, Pitch = 0.8, Key = "self:miss" }) -- soft "nothing there" tick
		end
	end)
	-- focus loss / respawn stop holding
	UserInputService.WindowFocusReleased:Connect(function()
		table.clear(mouseHolds)
		PileView.stopAll()
	end)
	-- a panel opening ends any held action at once (the release may never arrive over a menu)
	UI.BlockChanged.Event:Connect(function(blocked)
		if blocked then
			table.clear(mouseHolds)
			PileView.stopAll()
		end
	end)
	player.CharacterAdded:Connect(PileView.stopAll)

	-- First person: the eye can walk into the mound (its eggs never collide, so nobody gets trapped). Eggs right at the
	-- camera fade out locally, so the view is never inside an egg shell while picking.
	local faded: { [number]: Model } = {}
	RunService:BindToRenderStep("CTR_PileFade", Enum.RenderPriority.Camera.Value + 4, function()
		local cam = Workspace.CurrentCamera
		local near = if pile and cam and CameraMode.firstPerson() then (pile :: Pile.Pile).RockSize * 0.95 else 0
		local eye = if cam then cam.CFrame.Position else Vector3.zero
		for id, m in faded do
			local pos = posCache[id]
			if rocks[id] ~= m or not pos or (pos - eye).Magnitude > near * 1.1 then
				faded[id] = nil
				if m.Parent then
					for _, d in m:GetDescendants() do
						if d:IsA("BasePart") then
							d.LocalTransparencyModifier = 0
						end
					end
				end
			end
		end
		if near <= 0 or (eye - center).Magnitude > 40 then
			return
		end
		for id, pos in posCache do
			local m = rocks[id]
			if m and not faded[id] and (pos - eye).Magnitude < near then
				faded[id] = m
				for _, d in m:GetDescendants() do
					if d:IsA("BasePart") then
						d.LocalTransparencyModifier = 1
					end
				end
			end
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		if active then
			selClock += dt
			if selClock >= 0.1 then
				selClock = 0
				local m = State.Match
				if m and m.Phase == "Searching" and not UI.blocked() then
					local ctx = PileView.context()
					-- outline only while the button would pick up that very rock
					setSelected(if ctx.Id == "pickup" then ctx.Target else nil)
				else
					setSelected(nil)
				end
			end
			if holding > 0 then
				perform()
			end
			StationView.vibrate()
		end
	end)
end

return PileView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="321">
          <Properties>
            <string name="Name">PlayerCheer</string>
            <string name="Source"><![CDATA[--!strict
-- Winner cheer (#48): a short procedural celebration on a player's avatar, no animation upload needed.
-- Client ModuleScript (StarterPlayerScripts.Client.PlayerCheer). PlayerCheer.play(character, seconds?)
-- Both arms swing up and wave, three little hops with a happy body wiggle and one spin. Face/mouth untouched.
-- Works on R15 (Right/LeftShoulder, Waist, Root) and R6 (Right/Left Shoulder, RootJoint) by driving
-- Motor6D.Transform each frame and clearing it at the end.
local RunService = game:GetService("RunService")

local PlayerCheer = {}

local function find(char: Model, names: { string }): Motor6D?
	for _, d in char:GetDescendants() do
		if d:IsA("Motor6D") then
			for _, n in names do
				if d.Name == n then
					return d
				end
			end
		end
	end
	return nil
end

function PlayerCheer.play(char: Model, seconds: number?)
	local dur = seconds or 2.4
	local hum = char:FindFirstChildOfClass("Humanoid")
	local r6 = hum ~= nil and hum.RigType == Enum.HumanoidRigType.R6
	local rs = find(char, { "RightShoulder", "Right Shoulder" })
	local ls = find(char, { "LeftShoulder", "Left Shoulder" })
	local root = find(char, { "Root", "RootJoint" })
	local waist = find(char, { "Waist" })
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, tr in animator:GetPlayingAnimationTracks() do
			tr:AdjustWeight(0.05, 0.15) -- let the cheer show over idle
		end
	end
	local t = 0
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function(dt)
		t += dt
		local k = math.clamp(t / dur, 0, 1)
		local fade = math.min(1, t / 0.15, (dur - t) / 0.25)
		if t >= dur then
			conn:Disconnect()
			for _, m in { rs, ls, root, waist } do
				if m then
					m.Transform = CFrame.new()
				end
			end
			if animator then
				for _, tr in animator:GetPlayingAnimationTracks() do
					tr:AdjustWeight(1, 0.2)
				end
			end
			return
		end
		fade = math.max(fade, 0)
		local wave = math.sin(t * 14) * 0.35
		local up = math.rad(160) * fade
		-- arms: raised overhead (R15 shoulders rotate about X, R6 about Z), waving
		if rs then
			rs.Transform = if r6 then CFrame.Angles(0, 0, up + wave) else CFrame.Angles(up + wave, 0, 0)
		end
		if ls then
			ls.Transform = if r6 then CFrame.Angles(0, 0, -(up - wave)) else CFrame.Angles(up - wave, 0, 0)
		end
		-- body: three hops in the first 70 %, one spin on the middle hop, small wiggle
		local hopK = math.clamp(k / 0.7, 0, 1)
		local hop = math.abs(math.sin(hopK * math.pi * 3)) * 0.9 * fade * (if k < 0.7 then 1 else 0)
		local spin = if hopK > 0.34 and hopK < 0.66 then (hopK - 0.34) / 0.32 * math.pi * 2 else 0
		local wig = math.sin(t * 9) * 0.08 * fade
		if root then
			local cf = CFrame.new(0, hop, 0) * CFrame.Angles(0, spin, wig)
			root.Transform = if r6 then CFrame.new(0, 0, hop) * CFrame.Angles(0, 0, spin) else cf
		end
		if waist then
			waist.Transform = CFrame.Angles(0, wig * 2, 0)
		end
	end)
end

return PlayerCheer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="322">
          <Properties>
            <string name="Name">PlayerDust</string>
            <string name="Source"><![CDATA[--!strict
-- Feet dust for avatars (client only, cosmetic, nothing is sent anywhere):
--   * running on the ground kicks up small puffs behind the feet (throttled per player)
--   * landing a jump (a real fall, not a step down) leaves a soft dust ring that swells and fades
-- The local player and nearby players only (a few at a time). The dust takes a pale tint of the ground it rises from;
-- water is left to WorldFx's ripples and splashes. One shared emitter (world-space particles, Emit only) and a small
-- pool of ring parts: nothing grows with player count. Low effects: off. Reduce Motion: fewer puffs, smaller ring.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)

local PlayerDust = {}

local NEAR = 50 -- studs from the camera
local MAX_PLAYERS = 6 -- avatars checked per tick (the local player first)
local TICK = 0.1
local PUFF_EVERY = 0.2 -- per player
local RUN_SPEED = 11 -- horizontal studs/s that counts as running (default walk speed is 16)
local LAND_SPEED = 28 -- downward studs/s before touching down that counts as a landing
local MAX_RINGS = 4
local PALE = Color3.fromRGB(236, 228, 214)

type Track = { Grounded: boolean, MinVy: number, NextPuff: number, Seen: number }
local tracks: { [Player]: Track } = {}

local fxFolder: Folder? = nil
local host: BasePart? = nil
local emitter: ParticleEmitter? = nil
local freeRings: { BasePart } = {}
local liveRings = 0

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function folder(): Folder
	local f = fxFolder
	if f and f.Parent then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = "CT_Rocks_PlayerDust"
	nf.Parent = Workspace
	fxFolder = nf
	host, emitter = nil, nil
	table.clear(freeRings)
	liveRings = 0
	return nf
end

local function deco(p: BasePart)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p:SetAttribute("CameraIgnore", true)
end

local function dustEmitter(): (BasePart, ParticleEmitter)
	local f = folder()
	local h, e = host, emitter
	if h and e and h.Parent == f then
		return h, e
	end
	local p = Instance.new("Part")
	p.Name = "DustHost"
	p.Size = Vector3.new(0.6, 0.2, 0.6)
	p.Transparency = 1
	deco(p)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Dust"
	pe.Enabled = false -- Emit() only
	pe.Shape = Enum.ParticleEmitterShape.Box
	pe.EmissionDirection = Enum.NormalId.Top
	pe.Lifetime = NumberRange.new(0.35, 0.6)
	pe.Speed = NumberRange.new(1.2, 2.6)
	pe.SpreadAngle = Vector2.new(55, 55)
	pe.Acceleration = Vector3.new(0, -1.5, 0)
	pe.Drag = 3
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0.9) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
	pe.RotSpeed = NumberRange.new(-60, 60)
	pe.Rotation = NumberRange.new(0, 360)
	pe.LightInfluence = 1
	pe.Parent = p
	p.Parent = f
	host, emitter = p, pe
	return p, pe
end

local function tint(c: Color3): Color3
	return c:Lerp(PALE, 0.55)
end

local function puff(pos: Vector3, colour: Color3, count: number, speed: NumberRange?)
	local h, e = dustEmitter()
	h.CFrame = CFrame.new(pos)
	e.Color = ColorSequence.new(tint(colour))
	e.Speed = speed or NumberRange.new(1.2, 2.6)
	e:Emit(count)
end

local function ring(pos: Vector3, colour: Color3, size: number)
	if liveRings >= MAX_RINGS then
		return
	end
	liveRings += 1
	local p = table.remove(freeRings)
	if not p then
		local np = Instance.new("Part")
		np.Name = "LandRing"
		np.Shape = Enum.PartType.Cylinder
		np.Material = Enum.Material.SmoothPlastic
		deco(np)
		p = np
	end
	local part = p :: BasePart
	part.Size = Vector3.new(0.05, 1.4, 1.4)
	part.CFrame = CFrame.new(pos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90))
	part.Color = tint(colour)
	part.Transparency = 0.35
	part.Parent = folder()
	local tw = TweenService:Create(part, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.05, size, size), Transparency = 1 })
	tw.Completed:Once(function()
		liveRings = math.max(0, liveRings - 1)
		if part.Parent and #freeRings < MAX_RINGS then
			part.Parent = nil
			table.insert(freeRings, part)
		else
			part:Destroy()
		end
	end)
	tw:Play()
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = false

local function stepPlayer(pl: Player, root: BasePart, hum: Humanoid, now: number, reduced: boolean)
	local old = tracks[pl]
	local tr: Track = if old and now - old.Seen <= 0.5 then old else { Grounded = true, MinVy = 0, NextPuff = 0, Seen = now }
	tracks[pl] = tr -- new, or out of range for a while: start fresh so an old fall never rings late
	tr.Seen = now
	local v = root.AssemblyLinearVelocity
	local reach = root.Size.Y * 0.5 + hum.HipHeight + 0.8
	local hit = Workspace:Raycast(root.Position, Vector3.new(0, -reach, 0), rayParams)
	local water = hit ~= nil and (hit.Material == Enum.Material.Water or string.find(string.lower(hit.Instance.Name), "water", 1, true) ~= nil)
	local grounded = hit ~= nil and hum:GetState() ~= Enum.HumanoidStateType.Swimming
	if not grounded then
		tr.Grounded = false
		tr.MinVy = math.min(tr.MinVy, v.Y)
		return
	end
	local h = hit :: RaycastResult
	local colour = if h.Instance:IsA("Terrain") then Workspace.Terrain:GetMaterialColor(h.Material) else h.Instance.Color
	if not tr.Grounded then
		-- just touched down: a ring for a real fall
		if tr.MinVy < -LAND_SPEED and not water then
			ring(h.Position, colour, if reduced then 5 else 7.5)
			puff(h.Position, colour, if reduced then 3 else 6, NumberRange.new(3, 5))
			tr.NextPuff = now + PUFF_EVERY
		end
		tr.Grounded = true
		tr.MinVy = 0
	end
	local flat = Vector3.new(v.X, 0, v.Z)
	if not water and flat.Magnitude > RUN_SPEED and now >= tr.NextPuff then
		tr.NextPuff = now + PUFF_EVERY * (if reduced then 2 else 1)
		puff(h.Position - flat.Unit * 0.6, colour, if reduced then 1 else 2)
	end
end

local function step()
	local s = settings()
	if s.LowEffects == true then
		return
	end
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local reduced = s.ReducedMotion == true
	local now = os.clock()
	local camPos = cam.CFrame.Position
	local list: { Player } = { Players.LocalPlayer }
	for _, pl in Players:GetPlayers() do
		if pl ~= Players.LocalPlayer and #list < MAX_PLAYERS then
			local r = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
			if r and r:IsA("BasePart") and (r.Position - camPos).Magnitude < NEAR then
				table.insert(list, pl)
			end
		end
	end
	local chars: { Instance } = { folder() }
	for _, pl in list do
		if pl.Character then
			table.insert(chars, pl.Character)
		end
	end
	rayParams.FilterDescendantsInstances = chars
	for _, pl in list do
		local char = pl.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if root and root:IsA("BasePart") and hum and hum.Health > 0 then
			stepPlayer(pl, root, hum, now, reduced)
		end
	end
end

local started = false
function PlayerDust.start()
	if started then
		return
	end
	started = true
	Players.PlayerRemoving:Connect(function(pl)
		tracks[pl] = nil
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= TICK then
			acc = 0
			step()
		end
	end)
end

return PlayerDust
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="323">
          <Properties>
            <string name="Name">PopupGate</string>
            <string name="Source"><![CDATA[--!strict
-- The one popup gate on the client (rule: shared/PopupRules). Fight views hold it (`PopupGate.hold("Fight", true)`
-- from FightCam's start to its stop); the player's InBattle / InTower / MatchKey attributes and State.Match count too.
-- Anything that pops a non-fight card or toast asks `PopupGate.free(kind)` or hands it to `PopupGate.later(kind, fn)`,
-- which runs it now when free, else in order once the fight is over (after PopupRules.Breath seconds).
-- `PopupGate.Changed` fires whenever the answer may have changed (a toast queue can flush on it).

local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PopupRules = require(Shared.PopupRules)
local State = require(script.Parent.State)

local PopupGate = {}

PopupGate.Changed = Instance.new("BindableEvent")

-- set by ui/UI (which needs this module, so not the other way round): a menu or a big card is on screen
PopupGate.onScreen = nil :: (() -> boolean)?

local holds: { [string]: boolean? } = {}
local waiting: { { Kind: string, Fn: () -> () } } = {}
local draining = false

local function busy(): PopupRules.Busy
	local p = Players.LocalPlayer
	return {
		MatchKey = p and p:GetAttribute("MatchKey"),
		InTower = p and p:GetAttribute("InTower"),
		InBattle = p and p:GetAttribute("InBattle"),
		Match = State.Match,
		Held = next(holds) ~= nil,
		Shown = PopupGate.onScreen ~= nil and PopupGate.onScreen() or nil,
	}
end

function PopupGate.free(kind: string): boolean
	return PopupRules.free(kind, busy())
end

function PopupGate.cardStays(shownFor: number): boolean
	return PopupRules.cardStays(shownFor, busy())
end

function PopupGate.fighting(): boolean
	return PopupRules.fighting(busy())
end

local function drain()
	if draining or #waiting == 0 then
		return
	end
	draining = true
	task.delay(PopupRules.Breath, function()
		draining = false
		local i = 1
		while i <= #waiting do
			local w = waiting[i]
			if PopupRules.free(w.Kind, busy()) then
				table.remove(waiting, i)
				task.spawn(w.Fn)
			else
				i += 1
			end
		end
		-- a card still waits for a menu or another card to close (no single signal for that): look again soon
		if #waiting > 0 and not PopupGate.fighting() then
			drain()
		end
	end)
end

local function changed()
	PopupGate.Changed:Fire(PopupGate.fighting())
	if #waiting > 0 and not PopupGate.fighting() then
		drain()
	end
end

-- Holds (on) or releases (off) every non-fight popup under `key` (e.g. "Fight").
function PopupGate.hold(key: string, on: boolean)
	if (holds[key] == true) == on then
		return
	end
	holds[key] = if on then true else nil
	changed()
end

-- Runs `fn` now if a `kind` popup may show, else once it may (in the order asked).
function PopupGate.later(kind: string, fn: () -> ())
	if PopupGate.free(kind) and #waiting == 0 then
		fn()
		return
	end
	table.insert(waiting, { Kind = kind, Fn = fn })
	drain()
end

do
	local p = Players.LocalPlayer
	if p then
		for _, a in { "MatchKey", "InTower", "InBattle" } do
			p:GetAttributeChangedSignal(a):Connect(changed)
		end
	end
	State.Changed.Event:Connect(function(what)
		if what == "Match" then
			changed()
		end
	end)
end

return PopupGate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="324">
          <Properties>
            <string name="Name">PortalFx</string>
            <string name="Source"><![CDATA[--!strict
-- Race portal moment (client only, cosmetic, nothing is sent anywhere): when an avatar steps onto a hunt portal pad
-- (attribute HuntPortal = true: ParkBuilder's QueuePad1..4 or a MapHooks pad), the pad flashes once and a burst of
-- sparkles is pulled in toward its middle. Purely a picture of the step; the server alone decides the queue join
-- (PartyService.onPortalTouch). The local player and nearby players only, a short cooldown per pad.
-- Low effects: flash only, no sparkles. Reduce Motion: a softer flash that does not grow, no sparkles.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)

local PortalFx = {}

local NEAR = 70 -- studs from the camera to the pad
local TICK = 0.12
local COOLDOWN = 0.8 -- per pad
local ABOVE = 5 -- studs above the pad surface that still count as "on" it
local SPARK = Color3.fromRGB(255, 244, 200)

local pads: { BasePart } = {}
local inside: { [BasePart]: { [Player]: boolean } } = {}
local lastFx: { [BasePart]: number } = {}
local fxFolder: Folder? = nil

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function folder(): Folder
	local f = fxFolder
	if f and f.Parent then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = "CT_Rocks_PortalFx"
	nf.Parent = Workspace
	fxFolder = nf
	return nf
end

local function deco(p: BasePart)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p:SetAttribute("CameraIgnore", true)
end

-- The pad's local axis that points most nearly up (a flat cylinder pad lies on its side: X is up).
local function upAxis(p: BasePart): (Vector3, number)
	local up = p.CFrame:VectorToObjectSpace(Vector3.yAxis)
	local ax, ay, az = math.abs(up.X), math.abs(up.Y), math.abs(up.Z)
	if ax >= ay and ax >= az then
		return Vector3.xAxis * math.sign(up.X), p.Size.X
	elseif ay >= az then
		return Vector3.yAxis * math.sign(up.Y), p.Size.Y
	end
	return Vector3.zAxis * math.sign(up.Z), p.Size.Z
end

local function isOn(p: BasePart, pos: Vector3): boolean
	local lp = p.CFrame:PointToObjectSpace(pos)
	local axis, thick = upAxis(p)
	local h = lp:Dot(axis) -- height above the pad's middle
	local flat = lp - axis * h
	local half = p.Size * 0.5
	local flatHalf = half - Vector3.new(math.abs(axis.X) * half.X, math.abs(axis.Y) * half.Y, math.abs(axis.Z) * half.Z)
	local radius = math.max(flatHalf.X, flatHalf.Y, flatHalf.Z)
	return h > -thick * 0.5 - 0.5 and h < thick * 0.5 + ABOVE and flat.Magnitude <= radius + 0.5
end

local function burst(p: BasePart)
	local s = settings()
	local low, reduced = s.LowEffects == true, s.ReducedMotion == true
	local _, thick = upAxis(p)
	local top = p.Position + Vector3.yAxis * (thick * 0.5 + 0.05)
	local d = math.max(p.Size.X, p.Size.Y, p.Size.Z)
	-- flash: a bright disc over the pad that swells a little and fades
	local disc = Instance.new("Part")
	disc.Name = "PortalFlash"
	disc.Shape = Enum.PartType.Cylinder
	disc.Material = Enum.Material.Neon
	disc.Color = p.Color:Lerp(Color3.new(1, 1, 1), 0.55)
	disc.Size = Vector3.new(0.12, d, d)
	disc.CFrame = CFrame.new(top) * CFrame.Angles(0, 0, math.rad(90))
	disc.Transparency = if reduced then 0.55 else 0.15
	deco(disc)
	disc.Parent = folder()
	local grow = if reduced then d else d * 1.3
	TweenService:Create(disc, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.12, grow, grow), Transparency = 1 }):Play()
	Debris:AddItem(disc, 0.5)
	if low or reduced then
		return
	end
	-- sparkles: born on a sphere around the pad and pulled in to its middle
	local life = 0.55
	local r = d * 0.6
	local host = Instance.new("Part")
	host.Name = "PortalPull"
	host.Shape = Enum.PartType.Ball
	host.Size = Vector3.one * r * 2
	host.Transparency = 1
	host.CFrame = CFrame.new(top + Vector3.yAxis * 1.5)
	deco(host)
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Shape = Enum.ParticleEmitterShape.Sphere
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	e.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	e.Lifetime = NumberRange.new(life)
	e.Speed = NumberRange.new(r / life * 0.9, r / life)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.6, 0.35), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.1), NumberSequenceKeypoint.new(1, 0.4) })
	e.Color = ColorSequence.new(SPARK, p.Color:Lerp(SPARK, 0.4))
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Parent = host
	host.Parent = folder()
	e:Emit(22)
	Debris:AddItem(host, life + 0.3)
end

local function addPad(d: Instance)
	if not d:IsA("BasePart") or d:GetAttribute("HuntPortal") ~= true or table.find(pads, d) then
		return
	end
	local parent = d.Parent
	if parent and parent:GetAttribute("HuntPortal") == true then
		return -- MapHooks' touch volume over a pad: the pad itself already counts
	end
	table.insert(pads, d)
	inside[d] = {}
end

local function step()
	local cam = Workspace.CurrentCamera
	if not cam or State.Match ~= nil then
		return
	end
	local camPos = cam.CFrame.Position
	local now = os.clock()
	for i = #pads, 1, -1 do
		local p = pads[i]
		if not p:IsDescendantOf(Workspace) then
			table.remove(pads, i)
			inside[p] = nil
			lastFx[p] = nil
		elseif (p.Position - camPos).Magnitude < NEAR then
			local on = inside[p]
			for _, pl in Players:GetPlayers() do
				local root = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
				local nowOn = root ~= nil and root:IsA("BasePart") and isOn(p, root.Position)
				if nowOn and not on[pl] and now - (lastFx[p] or 0) >= COOLDOWN then
					lastFx[p] = now
					burst(p)
				end
				on[pl] = nowOn
			end
		end
	end
end

-- The lobby's TowerPortal (attribute TowerPortal = true): a plain neon slab in the door is dressed as a portal swirl on
-- this client. ForceField material draws its own moving swirl (no image ids), the slab stays where it is (the server's
-- touch part is not moved), and soft sparkles drift in toward the middle. Low effects: the swirl only.
local dressed: { [BasePart]: boolean } = {}
local function dressTower(d: Instance)
	if not d:IsA("BasePart") or d:GetAttribute("TowerPortal") ~= true or dressed[d] then
		return
	end
	if d.Transparency >= 0.95 then
		return -- an invisible touch volume: the map's own doorway shows the look
	end
	dressed[d] = true
	local tint = d.Color
	d.Material = Enum.Material.ForceField
	d.Color = tint:Lerp(Color3.fromRGB(150, 110, 255), 0.35) -- a little violet in the cyan, like the hunt portals
	d.Transparency = 0
	d.CastShadow = false
	-- a solid pale core inside the shimmer (ForceField alone read as nearly clear from the path): a client-only copy of
	-- the slab, a bit smaller and thinner, so the swirl draws over it
	local ok, core = pcall(function(): BasePart
		return d:Clone()
	end)
	if ok and core then
		for _, c in core:GetChildren() do
			c:Destroy()
		end
		local sz = d.Size
		local thin = math.min(sz.X, sz.Y, sz.Z)
		core.Name = "CT_PortalCore"
		core.Size = Vector3.new(
			if sz.X == thin then sz.X * 0.5 else sz.X * 0.96,
			if sz.Y == thin then sz.Y * 0.5 else sz.Y * 0.96,
			if sz.Z == thin then sz.Z * 0.5 else sz.Z * 0.96
		)
		core.CFrame = d.CFrame
		core.Material = Enum.Material.SmoothPlastic -- Neon blew out to a flat white oval
		core.Color = Color3.fromRGB(96, 92, 210) -- deep blue-violet
		core.Transparency = 0.35
		core:SetAttribute("TowerPortal", nil)
		deco(core)
		core.Parent = folder()
		-- the swirl: two rings of short glowing dashes in the doorway's plane, turning opposite ways
		local thinAxis = if sz.X == thin then "X" elseif sz.Y == thin then "Y" else "Z"
		local plane = d.CFrame * (if thinAxis == "X" then CFrame.Angles(0, math.pi / 2, 0) elseif thinAxis == "Y" then CFrame.Angles(math.pi / 2, 0, 0) else CFrame.identity)
		local w = if thinAxis == "X" then sz.Z else sz.X
		local h = if thinAxis == "Y" then sz.Z else sz.Y
		local r = 0.4 * math.min(w, h)
		local dashes: { { Part: Part, R: number, A: number, Dir: number } } = {}
		for ring = 1, 2 do
			local n = if ring == 1 then 12 else 7
			local rr = if ring == 1 then r else r * 0.55
			for i = 1, n do
				local dash = Instance.new("Part")
				dash.Name = "CT_PortalDash"
				dash.Size = Vector3.new(rr * 0.32, math.max(0.18, r * 0.05), 0.15)
				dash.Material = Enum.Material.Neon
				dash.Color = if ring == 1 then Color3.fromRGB(190, 150, 255) else Color3.fromRGB(150, 220, 255)
				dash.Transparency = 0.15
				deco(dash)
				dash.Parent = folder()
				table.insert(dashes, { Part = dash, R = rr, A = (i - 1) / n * math.pi * 2, Dir = if ring == 1 then 1 else -1.6 })
			end
		end
		local conn: RBXScriptConnection? = nil
		conn = RunService.Heartbeat:Connect(function()
			if not d.Parent then
				for _, x in dashes do
					x.Part:Destroy()
				end
				core:Destroy()
				if conn then
					conn:Disconnect()
				end
				return
			end
			local t = os.clock() * 0.9
			for _, x in dashes do
				local a = x.A + t * x.Dir
				-- tangent dashes, each a little in front of the slab so the shimmer does not hide them
				x.Part.CFrame = plane * CFrame.new(math.cos(a) * x.R, math.sin(a) * x.R, -thin * 0.5 - 0.1) * CFrame.Angles(0, 0, a + math.pi / 2)
			end
		end)
	end
	if settings().LowEffects == true then
		return
	end
	local a = Instance.new("Attachment")
	a.Name = "CT_PortalSwirl"
	a.Parent = d
	local e = Instance.new("ParticleEmitter")
	e.Name = "CT_PortalSparkle"
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(tint:Lerp(Color3.new(1, 1, 1), 0.4))
	e.LightEmission = 0.8
	e.LightInfluence = 0
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.1), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(1, 1.6)
	e.Rate = 28
	e.Speed = NumberRange.new(1, 2.5)
	e.SpreadAngle = Vector2.new(180, 180)
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Drag = 1
	e.Parent = a
end

local started = false
function PortalFx.start()
	if started then
		return
	end
	started = true
	for _, d in Workspace:GetDescendants() do
		addPad(d)
		dressTower(d)
	end
	Workspace.DescendantAdded:Connect(function(d)
		if d.Name == "TowerPortal" or d:GetAttribute("TowerPortal") == true then
			task.defer(dressTower, d) -- MapHooks sets the attribute right after the part appears
		end
		if d:GetAttribute("HuntPortal") == true then
			addPad(d)
		elseif d:IsA("BasePart") and (string.sub(d.Name, 1, 8) == "QueuePad" or d.Name == "Pad") then
			task.defer(addPad, d) -- MapHooks sets the attribute right after the pad appears
		end
	end)
	Players.PlayerRemoving:Connect(function(pl)
		for _, on in inside do
			on[pl] = nil
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= TICK then
			acc = 0
			step()
		end
	end)
end

return PortalFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="325">
          <Properties>
            <string name="Name">PromptArbiter</string>
            <string name="Source"><![CDATA[--!strict
-- World prompt arbitration (Master Prompt 4, sections 27 and 51).
--
-- Cause of the overlapping "Inspect / Buy" panels in the lobby: every workshop stand carries its own
-- ProximityPrompt and Roblox draws EVERY enabled prompt in range with its default (large, world-anchored)
-- billboard, so neighbouring stands overlap each other and the tool chip. Nothing coordinated them.
--
-- Fix, entirely on the client (the server's prompts are untouched):
--   * every ProximityPrompt in the world is tracked (one connection set, entries dropped when removed)
--   * each prompt's Style is switched to Custom LOCALLY, so Roblox draws no billboard for it
--   * every 0.1 s ONE winner is chosen (PromptPick: nearest, camera-facing helps, hysteresis, a prompt behind
--     a big solid is penalised, never removed) and only that prompt stays Enabled (locally); the rest are
--     disabled locally, so they cannot be triggered either
--   * the winner is drawn as ONE compact pill in the lower middle of the screen, above the tool chip and the
--     tip, clear of the joystick, action and jump areas; tapping it triggers that same prompt
--   * nothing shows while a modal / reveal owns the screen or while a button is held; after the hunt only the
--     arena's sell bin is offered (the action button is gone by then);
--     in a hunt the hopper prompt is hidden (the action button already sells) and only the player's OWN
--     machine panel is offered
-- Keyboard / gamepad activation stays with Roblox (the prompt keeps its KeyboardKeyCode); the pill's chip names the
-- key, the controller button or TAP for the input in use.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PromptPick = require(Shared.PromptPick)
local State = require(script.Parent.State)
local PileView = require(script.Parent.PileView)
local Config = require(Shared.Config)
local CameraMode = require(script.Parent.CameraMode)
local UI = require(script.Parent.ui.UI)

local PromptArbiter = {}

local player = Players.LocalPlayer
local C = UI.Colors
local T = UI.T

local tracked: { [ProximityPrompt]: boolean } = {} -- prompt -> last Enabled value we wrote
local winner: ProximityPrompt? = nil
local started = false
local pill: TextButton? = nil
local actionLabel: TextLabel? = nil
local objectLabel: TextLabel? = nil
local keyChip: TextLabel? = nil
local clock = 0
local PILL_W, PILL_H = 270, 58
local occludedCache: { [ProximityPrompt]: { At: number, Value: boolean } } = {}
-- The server's own Enabled for each prompt (audit 29: the arbiter used to switch a server-disabled prompt, such as
-- a closed shop door, back on when it won). Taken when the prompt is first seen, then updated whenever Enabled
-- changes to a value the arbiter did not write. Limit: a server switch-off that lands while the arbiter already
-- holds the prompt off locally fires no change, so it is only seen once the server switches it on again.
local serverOn: { [ProximityPrompt]: boolean } = {}
local enabledConn: { [ProximityPrompt]: RBXScriptConnection } = {}

local function anchorOf(pp: ProximityPrompt): Vector3?
	local parent = pp.Parent
	if parent and parent:IsA("BasePart") then
		return parent.Position
	elseif parent and parent:IsA("Attachment") then
		return parent.WorldPosition
	end
	return nil
end

local function track(pp: ProximityPrompt)
	if tracked[pp] ~= nil then
		return
	end
	tracked[pp] = pp.Enabled
	serverOn[pp] = pp.Enabled
	enabledConn[pp] = pp:GetPropertyChangedSignal("Enabled"):Connect(function()
		if tracked[pp] ~= nil and pp.Enabled ~= tracked[pp] then
			serverOn[pp] = pp.Enabled
			tracked[pp] = pp.Enabled
		end
	end)
	pp.Style = Enum.ProximityPromptStyle.Custom -- local only: no default billboard for any prompt
end

local function untrack(pp: ProximityPrompt)
	tracked[pp] = nil
	serverOn[pp] = nil
	local conn = enabledConn[pp]
	if conn then
		conn:Disconnect()
		enabledConn[pp] = nil
	end
	occludedCache[pp] = nil
	if winner == pp then
		winner = nil
	end
end

-- Is this prompt offered in the current situation at all (before distance)?
local function offered(pp: ProximityPrompt, inMatch: boolean, phase: string?): boolean
	if serverOn[pp] == false then
		return false -- switched off by the server: never offered, never re-enabled here
	end
	if inMatch then
		if phase == "Results" then
			-- after the hunt the action button is gone, so the arena's own SELL RUBBLE bin takes the sale
			-- (the results card and the tutorial send the player there)
			return pp.Name == "SellPrompt" or pp:GetAttribute("Sell") == true
		elseif phase ~= "Searching" then
			return false
		end
		if pp.Name == "MachineToggle" then
			local model = if pp.Parent then pp.Parent.Parent else nil
			return model ~= nil and model:GetAttribute("OwnerId") == player.UserId
		end
		return false -- the hopper is the action button's job in a hunt; gallery and workshop prompts are lobby-only
	end
	-- switched off by the server (a LIKE post on an empty plot), or a LIKE post on your own plot
	if pp:GetAttribute("Off") == true then
		return false
	end
	if pp:GetAttribute("LikePlot") ~= nil and pp:GetAttribute("OwnerId") == player.UserId then
		return false
	end
	return true
end

-- A big opaque solid between the camera and the prompt (a roof or wall of another building) makes it a
-- poor choice. Soft: it only costs distance, so a lone prompt is never lost. Cached for 0.5 s.
local function occluded(pp: ProximityPrompt, anchor: Vector3): boolean
	local c = occludedCache[pp]
	local now = os.clock()
	if c and now - c.At < 0.5 then
		return c.Value
	end
	local cam = Workspace.CurrentCamera
	local value = false
	if cam then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local skip: { Instance } = {}
		if player.Character then
			table.insert(skip, player.Character)
		end
		local own = pp.Parent and pp.Parent:FindFirstAncestorOfClass("Model")
		if own then
			table.insert(skip, own)
		end
		params.FilterDescendantsInstances = skip
		local from = cam.CFrame.Position
		local hit = Workspace:Raycast(from, anchor - from, params)
		if hit and hit.Instance:IsA("BasePart") then
			local s = hit.Instance.Size
			value = hit.Instance.Transparency < 0.5 and math.max(s.X, s.Y, s.Z) >= 6 and (hit.Position - anchor).Magnitude > 1.5
		end
	end
	occludedCache[pp] = { At = now, Value = value }
	return value
end

-- The rubble seller (board "Rubble sale"): its prompt is drawn as a sell card with the real bag count.
local function isSell(pp: ProximityPrompt): boolean
	return pp.Name == "SellPrompt" or pp:GetAttribute("Sell") == true
end

local sellIcon: GuiObject? = nil
local sellButton: TextButton? = nil

local function trigger()
	local pp = winner
	if not pp or not pp.Parent then
		return
	end
	if isSell(pp) then
		local prof = State.Profile
		if not prof or prof.Rubble <= 0 then
			UI.notify("No candy to sell.", "info", { Tag = "norubble" })
			return
		end
	end
	pp:InputHoldBegin()
	task.delay(0.06, function()
		pp:InputHoldEnd()
	end)
end

local function ensurePill()
	if pill and pill.Parent then
		return
	end
	local b = Instance.new("TextButton")
	b.Name = "WorldPrompt"
	b.AutoButtonColor = false
	b.Text = ""
	b.AnchorPoint = Vector2.new(0.5, 1)
	-- the lower middle, above the hint lane: away from joystick, action and jump
	b.Position = UDim2.new(0.5, 0, 1, -(T.Edge + 54 + 54))
	b.Size = UDim2.fromOffset(PILL_W, PILL_H)
	-- the chunky HUD button look (lobby tiles, DAILY): HUD blue, thick navy outline, bottom lip and a gloss
	-- (it was a flat light-blue box)
	b.BackgroundColor3 = C.Hud
	b.BackgroundTransparency = 0
	b.BorderSizePixel = 0
	b.Visible = false
	b.ZIndex = 6
	b.Parent = UI.screen()
	UI.corner(b, 14)
	UI.stroke(b, C.PanelEdge, 3)
	UI.bevel(b)
	UI.gloss(b)
	local kc = UI.text(b, "R", { Font = UI.Head, TextSize = T.Small, TextColor3 = C.DarkText, Outline = false, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 9, 0.5, 0), Size = UDim2.fromOffset(30, 30), TextXAlignment = Enum.TextXAlignment.Center })
	kc.BackgroundTransparency = 0
	kc.BackgroundColor3 = C.Gold
	kc.ZIndex = 2
	UI.corner(kc, 8)
	UI.stroke(kc, C.GoldDeep, 2)
	keyChip = kc
	-- top line: WHAT it is (the pet's name, EGG SHOP), big; under it the action (Inspect, Coming soon), smaller but
	-- in gold and well readable (it was a tiny grey line, and a shop showed "COMING SOON" big over its own name)
	local title = UI.text(b, "", { Name = "Title", Font = UI.Head, TextSize = T.Head, ZIndex = 2, Position = UDim2.fromOffset(46, 5), Size = UDim2.new(1, -54, 0, 26) })
	title.TextWrapped = false
	actionLabel = title
	local sub = UI.text(b, "", { Name = "Sub", Font = UI.Bold, TextSize = T.Body, TextColor3 = C.Gold, Outline = "Normal", RichText = true, ZIndex = 2, Position = UDim2.fromOffset(46, 32), Size = UDim2.new(1, -54, 0, 20) })
	sub.TextWrapped = false
	objectLabel = sub
	local icon = UI.icon(b, "basket", 40, { Position = UDim2.fromOffset(8, 12), Visible = false })
	sellIcon = icon
	local sb = UI.button(b, "SELL", "gold", trigger, { Name = "Sell", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(84, 42), Visible = false, TextSize = T.Head + 2 })
	sellButton = sb
	b.Activated:Connect(trigger)
	UI.bouncy(b) -- the pill squashes on press and bounces back like every button
	pill = b
end

-- The input that activates a prompt, for the chip on the pill: the prompt's own key on keyboard and mouse, its
-- gamepad button on a controller, TAP on touch (tapping the pill triggers it). Shown for every input type, so no
-- lobby card is left without a way to use it.
local function keyFor(pp: ProximityPrompt): string
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "TAP"
	elseif string.sub(last.Name, 1, 7) == "Gamepad" then
		return (string.gsub(pp.GamepadKeyCode.Name, "^Button", ""))
	end
	return pp.KeyboardKeyCode.Name
end

local function choose(): ProximityPrompt?
	local m = State.Match
	local inMatch = m ~= nil
	local phase = if m then m.Phase else nil
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local cam = Workspace.CurrentCamera
	local suppressed = not CameraMode.mayAct() or root == nil or PileView.isHolding()
	local cands: { PromptPick.Candidate } = {}
	local look = if cam then cam.CFrame.LookVector else Vector3.new(0, 0, -1)
	local fpLook = CameraMode.firstPerson()
	for pp in tracked do
		if suppressed or not root or not pp.Parent or not offered(pp, inMatch, phase) then
			continue
		end
		local a = anchorOf(pp)
		if not a then
			continue
		end
		local d = (a - root.Position).Magnitude
		if d <= pp.MaxActivationDistance then
			local to = a - (if cam then cam.CFrame.Position else root.Position)
			-- first person: only what the reticle points at (a cone around the camera-centre ray) is offered, so no
			-- label follows the player around while exploring and a press never acts on something behind them
			if fpLook and (to.Magnitude < 0.01 or look:Dot(to.Unit) < Config.Camera.PromptCone) and d > 3 then
				continue
			end
			local facing = if to.Magnitude > 0.01 then math.clamp((look:Dot(to.Unit) - 0.3) / 0.7, 0, 1) else 0
			local penalty = 0
			if occluded(pp, a) then
				penalty = 6 -- behind a big solid: a worse choice, still reachable when it is the only one
				facing = 0
			end
			table.insert(cands, { Key = pp, Distance = d + penalty, Range = pp.MaxActivationDistance + penalty, Facing = facing })
		end
	end
	local won = PromptPick.pick(cands, winner)
	return won :: ProximityPrompt?
end

local function apply(won: ProximityPrompt?)
	winner = won
	for pp, was in tracked do
		local want = pp == won and serverOn[pp] ~= false
		if was ~= want then
			tracked[pp] = want
			pp.Enabled = want
		end
	end
	if won then
		ensurePill()
		local b = pill :: TextButton
		local al, ol = actionLabel :: TextLabel, objectLabel :: TextLabel
		local key = keyFor(won)
		local sell = isSell(won)
		;(sellIcon :: GuiObject).Visible = sell
		;(sellButton :: TextButton).Visible = sell
		if sell then
			-- sell card: basket, "Sell rubble", the bag the server reports, SELL (or why not)
			local prof = State.Profile
			local n = if prof then prof.Rubble else 0
			local cap = if prof then prof.Capacity else 0
			b.Size = UDim2.fromOffset(300, 64)
			;(keyChip :: TextLabel).Visible = false
			al.Text = "Sell candy"
			ol.Text = if n > 0 then "Candy: <font color=\"#FFFFFF\">" .. n .. "</font>/" .. cap .. " for coins" else "No candy to sell."
			al.Position = UDim2.fromOffset(56, 8)
			al.Size = UDim2.new(1, -150, 0, 24)
			ol.Position = UDim2.fromOffset(56, 34)
			ol.Size = UDim2.new(1, -150, 0, 20)
			UI.setEnabled(sellButton :: TextButton, n > 0)
		else
			b.Size = UDim2.fromOffset(PILL_W, PILL_H)
			-- the name of the thing (ObjectText) is the big line and the action the small one; a prompt without an
			-- ObjectText shows its action big. A hold prompt says so (every lobby prompt is a press today).
			local hold = if won.HoldDuration > 0 then "Hold: " else ""
			local object = won.ObjectText
			if object ~= "" then
				al.Text = object
				ol.Text = hold .. won.ActionText
			else
				al.Text = hold .. won.ActionText
				ol.Text = ""
			end
			local kc = keyChip :: TextLabel
			kc.Visible = true
			kc.Text = key
			kc.Size = UDim2.fromOffset(if #key > 1 then 44 else 32, 32)
			local kx = if #key > 1 then 60 else 48
			local one = ol.Text == ""
			al.Position = UDim2.fromOffset(kx, if one then 14 else 5)
			al.Size = UDim2.new(1, -(kx + 8), 0, if one then 30 else 26)
			ol.Position = UDim2.fromOffset(kx, 32)
			ol.Size = UDim2.new(1, -(kx + 8), 0, 20)
		end
		-- clear of the thumbstick and Roblox's bottom-edge controls: raised off the bottom edge in landscape (it sat
		-- low beside the joystick), and above the tutorial hint lane whenever a hint shows there; portrait phones
		-- keep it higher, clear of the thumbstick and jump button
		local gui = UI.screen()
		local px = gui.AbsoluteSize
		local lane = gui:FindFirstChild("HintLow", true)
		local hintUp = false
		if lane then
			for _, c in lane:GetChildren() do
				if c:IsA("GuiObject") and c.Visible then
					hintUp = true
					break
				end
			end
		end
		local lift = if hintUp or px.X <= px.Y then T.Edge + 54 + 60 else T.Edge + 34
		b.Position = UDim2.new(0.5, 0, 1, -lift)
		b.Visible = true
	elseif pill then
		pill.Visible = false
	end
end

function PromptArbiter.start()
	if started then
		return
	end
	started = true
	for _, d in Workspace:GetDescendants() do
		if d:IsA("ProximityPrompt") then
			track(d)
		end
	end
	Workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			track(d)
		end
	end)
	Workspace.DescendantRemoving:Connect(function(d)
		if d:IsA("ProximityPrompt") then
			untrack(d)
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		clock += dt
		if clock < 0.1 then
			return
		end
		clock = 0
		apply(choose())
	end)
	UI.BlockChanged.Event:Connect(function()
		apply(choose())
	end)
end

-- For checks: how many prompts are tracked, which one is shown, how many are enabled right now.
function PromptArbiter.stats(): { Tracked: number, Enabled: number, Winner: ProximityPrompt?, PillVisible: boolean }
	local enabled = 0
	local n = 0
	for pp in tracked do
		n += 1
		if pp.Enabled then
			enabled += 1
		end
	end
	return { Tracked = n, Enabled = enabled, Winner = winner, PillVisible = pill ~= nil and pill.Visible }
end

return PromptArbiter
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="326">
          <Properties>
            <string name="Name">Pvp</string>
            <string name="Source"><![CDATA[--!strict
-- Pet Battle + training client boot (its own LocalScript so Main.client.luau stays untouched). See ui/PvpPanel.
require(script.Parent.ui.PvpPanel).start()
require(script.Parent.PetInspectTap).start() -- tap another player's pet to inspect it
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="327">
          <Properties>
            <string name="Name">RainbowPath</string>
            <string name="Source"><![CDATA[--!strict
-- Rainbow path (idea 34, client only, cosmetic). Anyone walking on a lobby path leaves a rainbow trail and a few
-- sparkles at their feet. A path is any part inside a folder or model named "Paths" (the lobby build's path layer) or a
-- part with attribute RainbowPath = true. Drawn by each viewer for every player, so everyone sees everyone's trail.
-- Off in a hunt (MatchKey), the tower and Pet Battles, and with Low Effects.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)
local PathGrid = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").PathGrid)

local RainbowPath = {}

local TICK = 0.2
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 120)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 170, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 235, 80)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(110, 230, 120)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(90, 180, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 120, 255)),
})

type Fx = { Root: BasePart, Trail: Trail, Spark: ParticleEmitter, Parts: { Instance } }
local fx: { [Player]: Fx } = {}

local function low(): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings.LowEffects == true
end

-- The lobby's path parts have CanQuery = false, so a raycast never hits them: the paths are read once into a flat grid
-- (shared/PathGrid) and a player is "on a path" when their feet are over one (top 0.5 stud above to 7 studs below the
-- root part).
local paths = PathGrid.new(16)
local lastScan = -math.huge
local function onPath(root: BasePart): boolean
	if paths.Count == 0 and os.clock() - lastScan > 10 then
		lastScan = os.clock()
		paths = PathGrid.lobbyPaths(Workspace)
	end
	local p = root.Position
	return PathGrid.under(paths, p.X, p.Y, p.Z, 0.5, 0.5, 7) ~= nil
end

local function clear(player: Player)
	local f = fx[player]
	if f then
		for _, inst in f.Parts do
			inst:Destroy()
		end
		fx[player] = nil
	end
end

local function build(player: Player, root: BasePart): Fx
	local a0 = Instance.new("Attachment")
	a0.Name = "RainbowA0"
	a0.Position = Vector3.new(0, -2.2, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "RainbowA1"
	a1.Position = Vector3.new(0, -1.2, 0)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Name = "RainbowTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = RAINBOW
	trail.Lifetime = 0.7
	trail.MinLength = 0.2
	trail.LightEmission = 0.4
	trail.Transparency = NumberSequence.new(0.15, 1)
	trail.FaceCamera = true
	trail.Enabled = false
	trail.Parent = root
	local spark = Instance.new("ParticleEmitter")
	spark.Name = "RainbowSparkle"
	spark.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	spark.Color = RAINBOW
	spark.LightEmission = 1
	spark.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	spark.Lifetime = NumberRange.new(0.5, 0.9)
	spark.Rate = 10
	spark.Speed = NumberRange.new(1, 2.5)
	spark.SpreadAngle = Vector2.new(60, 60)
	spark.EmissionDirection = Enum.NormalId.Top
	spark.Enabled = false
	spark.Parent = a0
	local f: Fx = { Root = root, Trail = trail, Spark = spark, Parts = { a0, a1, trail } }
	fx[player] = f
	return f
end

local function update(player: Player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (char and root and root:IsA("BasePart") and hum) then
		clear(player)
		return
	end
	local away = player:GetAttribute("MatchKey") ~= nil or player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true
	local on = false
	if not away and not low() and hum.MoveDirection.Magnitude > 0.1 then
		on = onPath(root)
	end
	local cur: Fx? = fx[player]
	if cur and cur.Root ~= root then
		clear(player)
		cur = nil
	end
	if not cur and not on then
		return
	end
	local f: Fx = cur or build(player, root)
	f.Trail.Enabled = on
	f.Spark.Enabled = on
end

function RainbowPath.start()
	Players.PlayerRemoving:Connect(function(p)
		clear(p)
	end)
	task.spawn(function()
		while true do
			task.wait(TICK)
			for _, p in Players:GetPlayers() do
				local ok, err = pcall(function()
					update(p)
				end)
				if not ok then
					warn("[RainbowPath]", err)
				end
			end
		end
	end)
end

return RainbowPath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="328">
          <Properties>
            <string name="Name">RetentionView</string>
            <string name="Source"><![CDATA[--!strict
-- First five minutes and comeback hooks on screen (client only; the server decides and pays everything:
-- RetentionService). Shows what the server sends and sends intents only ("Ready", "Gift").
--   FREE GIFT card   in the HUD's left column under PLAY: "in 0:42" counts down to the next play-time gift (1, 3, 5
--                    and 10 minutes of play a day); when one is ready it turns green "OPEN!" and wiggles. Tap = open.
--   gift opened      coin burst + confetti + "+100 coins!" banner
--   away nest        "While you were away, 2 eggs hatched!" card with the coins (and the pet, after a long break)
--   friend / group   a cheer banner with the coins
--   level up         hunter level from the profile stats (Retention.level): "LEVEL 3!" banner + confetti
--   starter pet      after the starter egg show: "YOUR FIRST PET!" + confetti, then the NEXT GOAL card: your pet's
--                    power counting up next to the Void Dragon's, a bar, and HUNT (queues a race) / TRAIN / BATTLE (Pet Battle cards)

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Retention = require(Shared.Retention)
local GeodeGen = require(Shared.GeodeGen)
local PetStats = require(Shared.PetStats)
local State = require(script.Parent.State)
local PopupGate = require(script.Parent.PopupGate)
local UI = require(script.Parent.ui.UI)
local Theme = require(script.Parent.ui.Theme)
local PetStyle = require(script.Parent.ui.PetStyle)
local HudArt = require(script.Parent.ui.HudArt)
local Juice = require(script.Parent.ui.Juice)
local Effects = require(script.Parent.Effects)
local StarterEggView = require(script.Parent.StarterEggView)
local SpinView = require(script.Parent.SpinView)

local T = UI.T
local TC = Theme.Color
local RetentionView = {}

local WIDTH = 172 -- the HUD's left column width (PlayButton WIDTH)
local HEIGHT = 60 -- the same card as TOWER / BATTLE (58 squashed the OPEN! pill)
local player = Players.LocalPlayer

local giftBtn: TextButton? = nil
local subLabel: TextLabel? = nil
local readyAt = 0 -- os.clock when the next gift is ready (from the last profile view)
local nextIndex: number? = nil
local readyCount = 0
local styleNow = ""
local stopWiggle: (() -> ())? = nil
local lastLevel: number? = nil
local asked = 0
local lastCheer = 0 -- os.clock of the last reward cheer
local cheer: (string, number?) -> () -- defined below (the profile fallback calls it)

local function fmt(sec: number): string
	sec = math.max(0, math.ceil(sec))
	return string.format("%d:%02d", sec // 60, sec % 60)
end

local function setStyle(style: string)
	local b = giftBtn
	if not b or styleNow == style then
		return
	end
	styleNow = style
	UI.setStyle(b, style)
	if style == "green" and not stopWiggle then
		stopWiggle = UI.wiggle(b)
	elseif style ~= "green" and stopWiggle then
		(stopWiggle :: () -> ())()
		stopWiggle = nil
	end
end

local function refresh()
	local b, sub = giftBtn, subLabel
	if not b or not sub then
		return
	end
	local lobby = State.Match == nil and player:GetAttribute("MatchKey") == nil and (player:GetAttribute("InTower") ~= true and player:GetAttribute("InBattle") ~= true)
	local p = State.Profile
	-- shown in the lobby while a gift is left today (in a hunt the screen stays on the race)
	b.Visible = lobby and p ~= nil and nextIndex ~= nil and not SpinView.wanted()
	if not b.Visible then
		return
	end
	local left = readyAt - os.clock()
	if readyCount > 0 or left <= 0 then
		sub.Text = "OPEN!"
		setStyle("green")
	else
		sub.Text = "in " .. fmt(left)
		setStyle("blue")
	end
end

local function onProfile()
	local p = State.Profile
	local g = p and p.Gifts
	if type(g) == "table" then
		-- the gift we asked for was opened (the timer moved on) but its notice did not show: cheer from the profile
		local before = nextIndex
		local now = g.NextGift
		if os.clock() - asked < 4 and os.clock() - lastCheer > 4 and before ~= nil and (now == nil or now > before) then
			local p0 = State.Profile
			local paid = p0 and p0.Gifts and p0.Gifts.Coins and p0.Gifts.Coins[before]
			cheer("+" .. UI.num(tonumber(paid) or 0) .. " COINS!", tonumber(paid))
		end
		nextIndex = g.NextGift
		readyCount = tonumber(g.Ready) or 0
		readyAt = os.clock() + (tonumber(g.NextIn) or 0)
	end
	-- hunter level pop (the first profile only sets the baseline, so joining never plays it)
	if p and p.Stats then
		local lv = Retention.level(Retention.xp(p.Stats))
		if lastLevel and lv > lastLevel then
			task.delay(1.2, PopupGate.later, "Toast", function() -- never over a fight
				Juice.banner("LEVEL " .. lv .. "!", TC.Gold, 2)
				Effects.confetti()
			end)
		end
		lastLevel = lv
	end
	refresh()
end

local function openGift()
	local b = giftBtn
	if not b then
		return
	end
	if readyCount <= 0 and readyAt - os.clock() > 0 then
		-- a shake alone read as "nothing happened" (Studio check): say how long is left
		Juice.nope(b)
		local left = math.max(1, math.ceil(readyAt - os.clock()))
		Juice.floatText(b, string.format("Next gift in %d:%02d", left // 60, left % 60), TC.Gold)
		return
	end
	if os.clock() - asked < 1 then
		return
	end
	asked = os.clock()
	Net.event("RetentionAction"):FireServer("Gift")
end

-- A big "+50" over `src` that springs in, holds and floats up: about 1.6 s on screen (Juice.floatText is a quick one).
local function bigPop(src: GuiObject, text: string)
	local layer = UI.noticeLayer()
	local at = src.AbsolutePosition + src.AbsoluteSize / 2
	local l = UI.text(layer, text, {
		Name = "GiftPop", Font = UI.Head, TextSize = 52, TextColor3 = TC.Gold, Outline = "Strong",
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(at.X + src.AbsoluteSize.X * 0.35, at.Y), Size = UDim2.fromOffset(220, 64),
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 60,
	})
	l.TextWrapped = false
	UI.pop(l, 0.2)
	if not UI.Reduced then
		TweenService:Create(l, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = l.Position - UDim2.fromOffset(0, 70) }):Play()
	end
	task.delay(1.2, function()
		if not l.Parent then
			return
		end
		local fade = TweenInfo.new(0.4)
		TweenService:Create(l, fade, { TextTransparency = 1 }):Play()
		local o = l:FindFirstChild("Outline")
		if o and o:IsA("UIStroke") then
			TweenService:Create(o, fade, { Transparency = 1 }):Play()
		end
	end)
	Debris:AddItem(l, 1.8)
end

-- Big, obvious reward feedback (Studio proof 2026-10-14: the first version was too quick to see): a banner held
-- 2.5 s in the middle of the screen, confetti across the screen and from the button, flying coins, and a big
-- "+50" pop over the button that floats for over a second.
function cheer(text: string, coins: number?)
	lastCheer = os.clock()
	Juice.banner(text, TC.Gold, 2.5)
	Effects.confetti()
	local b = giftBtn
	local src: GuiObject? = if b and b.Visible then b else nil
	if src then
		Juice.confetti(src, 30)
		if coins and coins > 0 then
			Juice.coins(src, 10)
			bigPop(src, "+" .. UI.money(coins))
			Effects.cashFly(nil, coins)
		end
		Juice.rays(src, TC.Gold, 1.4)
	end
end

-- Runs `fn` now if the player is free, else once they are back in the lobby: the one popup gate (PopupGate, Card).
local function whenCalm(fn: (...any) -> (), ...: any)
	local args = table.pack(...)
	PopupGate.later("Card", function()
		fn(table.unpack(args, 1, args.n))
	end)
end

-- The away-nest card: a small dialog that says what hatched while the player was gone.
local function awayCard(data: { [string]: any })
	local layer = UI.dialogLayer()
	local old = layer:FindFirstChild("AwayNest")
	if old then
		old:Destroy()
	end
	local card = UI.card(layer, "panel", {
		Name = "AwayNest", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(340, 210), ZIndex = 30,
	})
	local eggs = tonumber(data.Eggs) or 1
	local title = if data.WelcomeBack then "WELCOME BACK!" else "YOU'RE BACK!"
	UI.text(card, title, { Name = "Title", Font = UI.Head, TextSize = T.Title, TextColor3 = TC.Gold, Position = UDim2.fromOffset(12, 10), Size = UDim2.new(1, -24, 0, 40), TextXAlignment = Enum.TextXAlignment.Center })
	local line = "While you were away, " .. eggs .. (if eggs == 1 then " egg" else " eggs") .. " hatched in your nest!"
	UI.text(card, line, { Name = "Line", Font = UI.Bold, TextSize = T.Body, Position = UDim2.fromOffset(16, 54), Size = UDim2.new(1, -32, 0, 48), TextXAlignment = Enum.TextXAlignment.Center })
	local got = "+" .. UI.num(tonumber(data.Coins) or 0) .. " coins"
	if type(data.Pet) == "table" then
		got ..= " and a " .. GeodeGen.displayName(data.Pet :: any) .. "!"
	end
	UI.text(card, got, { Name = "Got", Font = UI.Head, TextSize = T.Head, TextColor3 = TC.Gold, Position = UDim2.fromOffset(16, 104), Size = UDim2.new(1, -32, 0, 40), TextXAlignment = Enum.TextXAlignment.Center })
	UI.button(card, "YAY!", "gold", function()
		card:Destroy()
	end, { Name = "Ok", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(150, T.Touch) })
	UI.pop(card, 0.4)
	Effects.confetti()
end

-- NEXT GOAL card after the first hatch: what to chase (the 1 in 1000 Void Dragon) and the two real ways to get
-- stronger from here (the core loop: FIND -> TRAIN -> FIGHT). Only shows numbers (PetStats is the same rule the server uses); buttons send intents only.
function RetentionView.goalCard(pet: any)
	if type(pet) ~= "table" or type(pet.Mineral) ~= "string" then
		return
	end
	local layer = UI.dialogLayer()
	local old = layer:FindFirstChild("NextGoal")
	if old then
		old:Destroy()
	end
	local ok, stats = pcall(PetStats.roll, pet, 0)
	local power = if ok and stats then math.floor(stats.Power) else 0
	local dream = math.floor(Retention.dreamPower())
	local card = UI.card(layer, "panel", {
		Name = "NextGoal", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(360, 250), ZIndex = 30,
	})
	UI.text(card, "NEXT GOAL!", { Name = "Title", Font = UI.Head, TextSize = T.Title, TextColor3 = TC.Gold, Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 40), TextXAlignment = Enum.TextXAlignment.Center })
	local name = string.upper(GeodeGen.displayName(pet :: any))
	local mine = UI.text(card, "YOUR " .. name .. ": \u{26A1}0", { Name = "Mine", Font = UI.Bold, TextSize = T.Body, Position = UDim2.fromOffset(16, 52), Size = UDim2.new(1, -32, 0, 28), TextXAlignment = Enum.TextXAlignment.Center })
	UI.countUp(mine, 0, power, 1.2, function(n: number): string
		return "YOUR " .. name .. ": \u{26A1}" .. UI.num(math.floor(n))
	end)
	UI.text(card, "VOID DRAGON (1 in 1000): \u{26A1}" .. UI.num(dream), { Name = "Dream", Font = UI.Bold, TextSize = T.Body, TextColor3 = Theme.Pet.RibbonPink, Position = UDim2.fromOffset(16, 82), Size = UDim2.new(1, -32, 0, 28), TextXAlignment = Enum.TextXAlignment.Center })
	-- the progress track: the pale inset of the sheets with the quest bar's blue edge (UI.bar's colours)
	local track = UI.frame(card, { Name = "Track", BackgroundColor3 = TC.Inset, Position = UDim2.fromOffset(24, 116), Size = UDim2.new(1, -48, 0, 18) })
	UI.corner(track, 9)
	PetStyle.edge(track, Theme.Pet.QuestEdge, 1.5)
	local fill = UI.frame(track, { Name = "Fill", BackgroundColor3 = TC.Gold, Size = UDim2.fromScale(0, 1) })
	UI.corner(fill, 9)
	local frac = math.max(Retention.dreamProgress(power), 0.03)
	TweenService:Create(fill, TweenInfo.new(if UI.Reduced then 0 else 1.2, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(frac, 1) }):Play()
	UI.text(card, "Hunt eggs, train your pet and win battles to get stronger!", { Name = "How", Font = UI.Bold, TextSize = T.Small, Position = UDim2.fromOffset(16, 140), Size = UDim2.new(1, -32, 0, 40), TextXAlignment = Enum.TextXAlignment.Center })
	-- HUNT queues a race; TRAIN / BATTLE open Pet Battle's own cards (ui/PvpPanel, loaded on tap so boot order never matters)
	type Choice = { Name: string, Text: string, Style: string, Go: () -> () }
	local choices: { Choice } = {
		{ Name = "Hunt", Text = "HUNT", Style = "gold", Go = function()
			Net.event("PartyAction"):FireServer("Queue")
		end },
		{ Name = "Train", Text = "TRAIN", Style = "blue", Go = function()
			require(script.Parent.ui.PvpPanel).openTrain()
		end },
		{ Name = "Battle", Text = "BATTLE", Style = "red", Go = function()
			require(script.Parent.ui.PvpPanel).openBattle()
		end },
	}
	local bw, gap = 104, 8
	for i, c in choices do
		UI.button(card, c.Text, c.Style, function()
			card:Destroy()
			c.Go()
		end, { Name = c.Name, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, (i - 2) * (bw + gap), 1, -12), Size = UDim2.fromOffset(bw, T.Touch) })
	end
	UI.closeButton(card, function()
		card:Destroy()
	end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8) })
	UI.pop(card, 0.4)
	Juice.rays(card, TC.Gold, 1.4)
	-- never stays up: gone after PopupRules.CardLife, or at once when a hunt / climb / battle starts under it
	local shownAt = os.clock()
	task.spawn(function()
		while card.Parent do
			if not PopupGate.cardStays(os.clock() - shownAt) then
				card:Destroy()
				break
			end
			task.wait(0.25)
		end
	end)
end

local function onRetention(kind: string, data: any)
	if type(data) ~= "table" then
		return
	end
	if kind == "Gift" then
		if os.clock() - lastCheer < 2 then
			return -- the profile fallback already cheered for this gift
		end
		cheer("+" .. UI.num(tonumber(data.Coins) or 0) .. " COINS!", tonumber(data.Coins))
	elseif kind == "GiftReady" then
		readyCount = math.max(readyCount, 1)
		refresh()
		local b = giftBtn
		if b and b.Visible then
			UI.pop(b, 0.6)
		end
	elseif kind == "Away" then
		task.delay(2, whenCalm, awayCard, data) -- after the loading screen and the first look around; never over a fight
	elseif kind == "Friend" then
		cheer(string.upper(tostring(data.Name or "FRIEND")) .. " IS HERE! +" .. UI.num(tonumber(data.Coins) or 0) .. " COINS", tonumber(data.Coins))
	elseif kind == "Group" then
		cheer("GROUP GIFT! +" .. UI.num(tonumber(data.Coins) or 0) .. " COINS", tonumber(data.Coins))
	end
end

local function build()
	local screen = UI.screen()
	local left = screen:FindFirstChild("Left", true) -- the HUD's left column list (under PLAY); else a fixed spot
	local b = HudArt.bigButton(left or screen, {
		Name = "FreeGift", Style = "blue", Art = "IconDaily", Title = "GIFT", Sub = "in 1:00", Width = WIDTH, Height = HEIGHT, LayoutOrder = 55,
		OnClick = openGift,
	})
	if not left then
		b.Position = UDim2.fromOffset(T.Edge, T.Edge + 160)
	end
	b.Visible = false
	giftBtn = b
	subLabel = b:FindFirstChild("Sub", true) :: TextLabel?
	styleNow = "blue"
end

function RetentionView.start()
	build()
	State.Changed.Event:Connect(function(what)
		if what == "Profile" then
			onProfile()
		elseif what == "Match" then
			refresh()
		end
	end)
	player:GetAttributeChangedSignal("MatchKey"):Connect(refresh)
	player:GetAttributeChangedSignal("InTower"):Connect(refresh)
	player:GetAttributeChangedSignal("InBattle"):Connect(refresh)
	Net.event("Retention").OnClientEvent:Connect(onRetention)
	StarterEggView.Hatched.Event:Connect(function(pet)
		cheer("YOUR FIRST PET!")
		task.delay(2.6, whenCalm, RetentionView.goalCard, pet) -- never over a hunt, tower or Pet Battle
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			refresh()
		end
	end)
	onProfile()
	Net.event("RetentionAction"):FireServer("Ready") -- any waiting notice (away nest, friend gift) comes now
end

return RetentionView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="329">
          <Properties>
            <string name="Name">Reticle</string>
            <string name="Source"><![CDATA[--!strict
-- The centre reticle (docs/m6/FIRST_PERSON.md section 3): one small dot in the middle of the view.
--   neutral      a quiet dot (exploring; nothing to say)
--   eligible     the dot opens into a ring: the press does something now (the single action button / prompt
--                pill says what; this does not repeat the label)
--   unavailable  a dim red ring and ONE concise reason, only when the ray is on something that cannot be
--                used right now (basket full, rubble bag full). Never a "move closer" while exploring.
-- The state comes from the same resolver as the action (PileView.context in a hunt, the prompt chosen by
-- PromptArbiter in the lobby), so the reticle can never disagree with what a press does. Hidden while any
-- panel is open, during the reveal and results, and outside first person.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AimResolve = require(Shared.AimResolve)
local State = require(script.Parent.State)
local CameraMode = require(script.Parent.CameraMode)
local PileView = require(script.Parent.PileView)
local PromptArbiter = require(script.Parent.PromptArbiter)
local UI = require(script.Parent.ui.UI)

local Reticle = {}

local player = Players.LocalPlayer
local C = UI.Colors

local gui: ScreenGui? = nil
local dot: Frame? = nil
local ring: Frame? = nil
local ringStroke: UIStroke? = nil
local edge: Frame? = nil -- dark ring under the amber one, so it reads on pastel eggs and the yellow nest
local edgeStroke: UIStroke? = nil
local plate: Frame? = nil
local reasonLabel: TextLabel? = nil
local clock = 0
local shown = ""
Reticle.Current = { State = "hidden", Reason = nil :: string? }

local function circle(parent: Instance, name: string, px: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.Size = UDim2.fromOffset(px, px)
	f.BorderSizePixel = 0
	f.Parent = parent
	local r = Instance.new("UICorner")
	r.CornerRadius = UDim.new(0.5, 0)
	r.Parent = f
	return f
end

local function build()
	local g = Instance.new("ScreenGui")
	g.Name = "CT_Reticle"
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = true
	g.DisplayOrder = 3
	g.Enabled = false
	g.Parent = player:WaitForChild("PlayerGui")
	gui = g
	local d = circle(g, "Dot", 8)
	d.ZIndex = 3
	d.BackgroundColor3 = C.Text
	local ds = Instance.new("UIStroke")
	ds.Color = C.Outline
	ds.Thickness = 2
	ds.Transparency = 0
	ds.Parent = d
	dot = d
	-- the ring: a thick amber band with a dark edge on both sides (a thin yellow line vanished on pastel eggs)
	local e = circle(g, "RingEdge", 27)
	e.BackgroundTransparency = 1
	e.ZIndex = 1
	local es = Instance.new("UIStroke")
	es.Color = C.Outline
	es.Thickness = 8
	es.Transparency = 1
	es.Parent = e
	edge, edgeStroke = e, es
	local r = circle(g, "Ring", 30)
	r.BackgroundTransparency = 1
	r.ZIndex = 2
	local rs = Instance.new("UIStroke")
	rs.Color = C.Amber
	rs.Thickness = 3.5
	rs.Transparency = 1
	rs.Parent = r
	ring, ringStroke = r, rs
	local p = Instance.new("Frame")
	p.Name = "ReasonPlate"
	p.AnchorPoint = Vector2.new(0.5, 0)
	-- well under the crosshair (bugs #223, #224: right under the dot it covered the aim and stacked on the nest's
	-- name board when aiming at a nest)
	p.Position = UDim2.new(0.5, 0, 0.5, 72)
	p.Size = UDim2.fromOffset(300, 36)
	p.BackgroundColor3 = C.Panel
	p.BackgroundTransparency = 0.05
	p.BorderSizePixel = 0
	p.Visible = false
	p.Parent = g
	UI.corner(p, 8)
	UI.stroke(p, C.PanelEdge, 2)
	local rl = UI.text(p, "", { Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), Font = UI.Bold, TextSize = UI.T.Body, Outline = "Normal", TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.Text })
	rl.TextWrapped = false
	UI.fit(rl, UI.T.Body, UI.T.Small)
	reasonLabel = rl
	plate = p
end

local function set(stateName: string, reason: string?)
	local key = stateName .. "|" .. (reason or "")
	if key == shown then
		return
	end
	shown = key
	Reticle.Current = { State = stateName, Reason = reason }
	local g = gui
	if not g or not ring or not ringStroke or not edge or not edgeStroke or not dot or not plate or not reasonLabel then
		return
	end
	g.Enabled = stateName ~= "hidden"
	local info = TweenInfo.new(UI.Reduced and 0 or 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local size, strokeT, color = 30, 1, C.Amber
	if stateName == "eligible" then
		size, strokeT, color = 30, 0.05, C.Amber
	elseif stateName == "unavailable" then
		size, strokeT, color = 24, 0.3, C.Red
	end
	if stateName == "neutral" or stateName == "hidden" then
		size, strokeT = 22, 1
	end
	TweenService:Create(ring, info, { Size = UDim2.fromOffset(size, size) }):Play()
	TweenService:Create(ringStroke, info, { Transparency = strokeT, Color = color }):Play()
	-- the edge sits 1.5 px inside the amber band and 3 px outside it
	TweenService:Create(edge, info, { Size = UDim2.fromOffset(size - 3, size - 3) }):Play()
	TweenService:Create(edgeStroke, info, { Transparency = if strokeT >= 1 then 1 else math.max(strokeT, 0.15) }):Play()
	dot.BackgroundColor3 = if stateName == "eligible" then C.Amber elseif stateName == "unavailable" then C.Muted else C.Text
	plate.Visible = reason ~= nil
	reasonLabel.Text = reason or ""
end

-- What the reticle shows right now (pure of drawing; used by the loop and by checks).
function Reticle.evaluate(): (string, string?)
	if not CameraMode.firstPerson() or UI.blocked() or CameraMode.cursorFree() then -- third-person lobby, a menu, or the free-cursor key
		return "hidden", nil
	end
	local m = State.Match
	if m == nil then
		-- lobby: eligible exactly when a counter / kiosk prompt is offered (the pill names it)
		if PromptArbiter.stats().Winner ~= nil then
			return "eligible", nil
		end
		return "neutral", nil
	end
	if m.Phase ~= "Searching" and m.Phase ~= "Countdown" then
		return "hidden", nil
	end
	if m.Phase == "Countdown" then
		return "neutral", nil
	end
	local ctx = PileView.context()
	local r = AimResolve.reticle(ctx.Id, PileView.aimedAtSomething())
	return r.State, r.Reason
end

function Reticle.start()
	if gui then
		return
	end
	build()
	RunService.Heartbeat:Connect(function(dt)
		clock += dt
		if clock < 0.08 then
			return
		end
		clock = 0
		local s, reason = Reticle.evaluate()
		set(s, reason)
	end)
	CameraMode.Changed.Event:Connect(function()
		local s, reason = Reticle.evaluate()
		set(s, reason)
	end)
end

return Reticle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="330">
          <Properties>
            <string name="Name">RevealView</string>
            <string name="Source"><![CDATA[--!strict
-- Pet hatch reveal (2 to 6 s by rarity, see below), shown in a hero ViewportFrame over the arena:
--   0.0-0.4  the screen dims in, the closed egg (two shell halves around the pet) drops in
--   0.4-1.0  the egg wobbles harder and glowing zigzag cracks run up the seam
--   1.0-1.5  the shell halves fly apart and fade; the pet pops up out of it with a springy bounce
--   1.2-2.6  rarity-coloured rays turn behind the pet, a soft camera ease, name + rarity fade in
--            ("You hatched a Rare Fox!", the whole line at once so the rarity never shows before the name)
-- Owner pick: the whole sequence follows the rarity (Config.Hatch via PetFlair.hatchTiming): Common / Uncommon about
-- 2 s; Rare, Epic and Legendary about 6 s with the wobble, cracks and pop in slow motion, a pulsing rarity glow, a
-- choir build-up from the start and the species' roar at the pop (SoundConfig; silent while the ids are 0). Only the
-- local animation clock is warped (PetFlair.hatchWarp). Then it holds the final
-- frame (the same GeodeView framing the results card uses) until the results arrive or the player taps. A tap
-- after 0.5 s jumps to the final frame; a tap on the final frame closes it. Purely cosmetic: the server saved the
-- pet before the Reveal event was sent. Reduced motion shows the final frame at once.
-- Party hunts: players who did NOT win watch the winner's hatch in a small picture-in-picture box at the right
-- edge (no full-screen dim, controls stay usable); the winner, solo and practice hunts get the full screen.
-- Polish: the shell halves tumble down, bounce once and fade; the rarity line slams in (big -> squash -> settle)
-- with a short shake, stronger for higher rarities.

local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PetFlair = require(Shared.PetFlair)
local GeodeGen = require(Shared.GeodeGen)
local GeodeModel = require(Shared.GeodeModel)
local UI = require(script.Parent.ui.UI)
local GeodeView = require(script.Parent.ui.GeodeView)
local Audio = require(script.Parent.Audio)
local Effects = require(script.Parent.Effects)
local PetMotionBridge = require(script.Parent.PetMotionBridge)
local SpeciesPool = require(Shared.SpeciesPool)
local LuckEvents = require(Shared.LuckEvents)
local PetStatView = require(Shared.PetStatView)

local C = UI.Colors
local T = UI.T

local RevealView = {}

local ANIM_END = PetFlair.HatchAnim.End

-- 0..1 from the configured rarity multipliers (Common small, Legendary full); no invented odds
local function rarityStrength(rarity: string): number
	local m = (Config.RarityMult :: any)[rarity] or 1
	local top = 1
	for _, v in Config.RarityMult :: any do
		top = math.max(top, v)
	end
	return math.clamp(math.log(math.max(m, 1)) / math.log(math.max(top, 2)), 0, 1)
end
local SKIP_AFTER = 0.5
local HINT_AT = 2 -- seconds before the "Tap to continue" hint fades in
local SPIN_RATE = 0.5 -- radians per second the finished pet turns

-- backdrop tint per zone (tier ids: Gravel = Meadow, Quarry = Forest, Cavern = Snow, Volcanic = Volcano, Meteor = Space)
local ZONE_SHADE: { [string]: Color3 } = {
	Gravel = Color3.fromRGB(34, 62, 36),
	Quarry = Color3.fromRGB(22, 50, 34),
	Cavern = Color3.fromRGB(36, 56, 92),
	Volcanic = Color3.fromRGB(88, 36, 18),
	Meteor = Color3.fromRGB(56, 32, 92),
}

-- "1 in N" for this pet: its rarity chance times its species share, from the same public odds the Pet Book shows
local function oddsText(spec: any): string?
	local ok, text = pcall(function(): string?
		local wsum = 0
		for _, r in Config.Rarities do
			wsum += Config.RarityWeights[r]
		end
		local rp = {}
		for _, r in Config.Rarities do
			rp[r] = Config.RarityWeights[r] / wsum
		end
		local share = SpeciesPool.chance(spec.Tier, spec.Mineral, os.time(), rp)
		local p = (rp[spec.Rarity] or 0) * share
		-- the one odds-line rule (shared LuckEvents.oneIn): whole numbers, no line for a common result
		local n = LuckEvents.oneIn(p, spec.Rarity)
		return if n then "1 in " .. UI.num(n) .. " chance!" else nil
	end)
	return if ok then text else nil
end

local gui: Frame? = nil
local conn: RBXScriptConnection? = nil
local playing = false
local skippedBefore = false -- the player skipped a hatch this session: quiet hatches then open on the final frame

local function ease(k: number): number -- smooth in-out
	k = math.clamp(k, 0, 1)
	return k * k * (3 - 2 * k)
end

local function easeOutBack(k: number): number
	k = math.clamp(k, 0, 1)
	local c1, c3 = 1.3, 2.3
	return 1 + c3 * (k - 1) ^ 3 + c1 * (k - 1) ^ 2
end

local function span(t: number, a: number, b: number): number
	return math.clamp((t - a) / (b - a), 0, 1)
end

function RevealView.close()
	if conn then
		conn:Disconnect()
		conn = nil
	end
	Effects.clear()
	playing = false
	if gui then
		gui:Destroy()
		gui = nil
		UI.block("reveal", false) -- harmless when the compact box never blocked
	end
end

function RevealView.isOpen(): boolean
	return gui ~= nil
end

-- True while the sequence is still running (not yet on its final frame). The results card waits for
-- this to turn false, so the opening is never cut short by the server's Results event.
function RevealView.isPlaying(): boolean
	return gui ~= nil and playing
end

local function article(word: string): string
	return if string.find(string.lower(string.sub(word, 1, 1)), "[aeiou]") then "an" else "a"
end

-- res: the server's Reveal payload (Specimen, Kind, Winner...). headline: the discovery line.
-- iWon: the local player won it (confetti; versus fanfare when res.Kind is not Solo).
function RevealView.play(res: { [string]: any }, headline: string, iWon: boolean)
	RevealView.close()
	-- someone else's find in a party hunt: picture-in-picture instead of the full screen
	local compact = not iWon and res.Kind ~= "Tutorial" and res.Kind ~= "Solo"
	if not compact then
		UI.block("reveal", true)
	end
	local spec = res.Specimen
	local reduced = UI.Reduced
	local root = UI.overlay()
	local shade: Frame
	if compact then
		local side = math.floor(math.clamp(math.min(UI.Logical.X, UI.Logical.Y) * 0.42, 140, 210))
		shade = UI.frame(root, {
			Name = "Reveal", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.46, 0), Size = UDim2.fromOffset(side, side + 18),
			BackgroundColor3 = ZONE_SHADE[spec.Tier] or Color3.fromRGB(34, 26, 52), BackgroundTransparency = 1, Active = true, ZIndex = 5, ClipsDescendants = true,
		})
		UI.corner(shade, T.RadiusLg)
	else
		shade = UI.frame(root, { Name = "Reveal", Size = UDim2.fromScale(1, 1), BackgroundColor3 = ZONE_SHADE[spec.Tier] or Color3.fromRGB(34, 26, 52), BackgroundTransparency = 1, Active = true, ZIndex = 5 })
	end
	gui = shade
	local rarity: string = spec.Rarity or "Common"
	local tint: Color3 = (Config.RarityColors :: any)[rarity] or Color3.new(1, 1, 1)
	local strength = rarityStrength(rarity)
	if compact then
		UI.stroke(shade, tint, 2)
	end
	-- layout: full screen, or the small box (headline on top, the name under the pet, no facts / hint)
	local stageSize = if compact then UDim2.new(1, -8, 1, -48) else UDim2.new(1, 0, 1, -170)
	local stagePos = if compact then UDim2.new(0.5, 0, 0.5, -2) else UDim2.new(0.5, 0, 0.5, -16)
	-- real seconds -> animation time for this rarity (about 2 s, or about 6 s of slow motion for Rare+)
	local timing = PetFlair.hatchTiming(rarity)
	local END = timing.Total
	local function warp(rt: number): number
		return PetFlair.hatchWarp(timing, rt)
	end
	-- rarity rays: thin bars turning behind the pet, plus a soft disc
	local glow = UI.frame(shade, { Name = "Rays", AnchorPoint = Vector2.new(0.5, 0.5), Position = stagePos, Size = stageSize, BackgroundTransparency = 1, ClipsDescendants = true })
	local rays: { Frame } = {}
	local rayCount = 6 + math.floor(6 * strength)
	for i = 1, rayCount do
		local r = Instance.new("Frame")
		r.AnchorPoint = Vector2.new(0.5, 0.5)
		r.Position = UDim2.fromScale(0.5, 0.5)
		r.SizeConstraint = Enum.SizeConstraint.RelativeYY
		r.Size = UDim2.fromScale(0.07, 2.2)
		r.BackgroundColor3 = tint
		r.BackgroundTransparency = 1
		r.BorderSizePixel = 0
		r.Rotation = i / rayCount * 180
		r.Parent = glow
		rays[i] = r
	end
	local disc = Instance.new("Frame")
	disc.AnchorPoint = Vector2.new(0.5, 0.5)
	disc.Position = UDim2.fromScale(0.5, 0.5)
	disc.SizeConstraint = Enum.SizeConstraint.RelativeYY
	disc.Size = UDim2.fromScale(0.8, 0.8)
	disc.BackgroundColor3 = tint:Lerp(Color3.new(1, 1, 1), 0.3)
	disc.BackgroundTransparency = 1
	disc.BorderSizePixel = 0
	local dc = Instance.new("UICorner")
	dc.CornerRadius = UDim.new(0.5, 0)
	dc.Parent = disc
	disc.Parent = glow
	local head = UI.text(shade, headline, {
		Font = UI.Head, TextSize = if compact then T.Small else 30, TextColor3 = C.Yellow, AnchorPoint = Vector2.new(0.5, 0),
		Position = if compact then UDim2.new(0.5, 0, 0, 3) else UDim2.new(0.5, 0, 0, 10), Size = if compact then UDim2.new(1, -10, 0, 20) else UDim2.new(0.9, 0, 0, 42),
		TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 1,
	})
	local vp, model, cam = GeodeView.make(shade, spec, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = stagePos, Size = stageSize,
	})
	local petName = GeodeGen.displayName(spec)
	local title = if iWon then string.format("You hatched %s %s %s!", article(rarity), rarity, petName) else string.format("%s %s", rarity, petName)
	local labelsPos = if compact then UDim2.new(0.5, 0, 1, -3) else UDim2.new(0.5, 0, 1, -30)
	local labels = UI.frame(shade, { AnchorPoint = Vector2.new(0.5, 1), Position = labelsPos, Size = if compact then UDim2.new(1, -8, 0, 22) else UDim2.new(0.9, 0, 0, 100), BackgroundTransparency = 1 })
	UI.list(labels, Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Center)
	local name = UI.text(labels, title, { Font = UI.Head, TextSize = if compact then T.Small else 24, Size = UDim2.new(1, 0, 0, if compact then 20 else 30), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Config.RarityTextColors[rarity], LayoutOrder = 1, TextTransparency = 1 })
	-- the rarity slam: the line lands big, squashes past its size and settles (UIScale, so the fitted text keeps its fit)
	local slam = Instance.new("UIScale")
	slam.Parent = name
	-- the rarity colour gets a light-to-deep gradient across the line
	local nameGrad = Instance.new("UIGradient")
	local nameCol = Config.RarityTextColors[rarity] or tint
	nameGrad.Color = ColorSequence.new(nameCol:Lerp(Color3.new(1, 1, 1), 0.45), nameCol, nameCol:Lerp(tint, 0.6):Lerp(Color3.new(0, 0, 0), 0.15))
	nameGrad.Parent = name
	name.TextColor3 = Color3.new(1, 1, 1) -- the gradient multiplies the text colour: white keeps its colours true
	local pose = (Config.FormationNames :: any)[spec.Formation] or ""
	-- the new pet's POWER and "Lv 1/cap" (carter's one "bigger = better" number, PetStatView); old line without a Seed
	local power = PetStatView.power(spec)
	local lv, cap = PetStatView.levelOf(spec)
	local factsText = if power then rarity .. "  ·  POWER " .. UI.num(power) .. "  ·  " .. PetStatView.levelText(lv, cap) else rarity .. "  ·  " .. pose .. "  ·  " .. string.format("%.2f kg", spec.Mass or 0)
	local facts = UI.text(labels, factsText, {
		Font = UI.Bold, TextSize = T.Head, Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.Muted, LayoutOrder = 2, TextTransparency = 1,
	})
	facts.Visible = not compact
	-- odds ("1 in 250!")
	local extraText = oddsText(spec) or ""
	-- (no "you have N" count here: the profile sync can land before or after the reveal starts, so it could be off by one)
	local extra = UI.text(labels, extraText, {
		Font = UI.Bold, TextSize = T.Head, Size = UDim2.new(1, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.Yellow, LayoutOrder = 3, TextTransparency = 1,
	})
	extra.Visible = not compact and extraText ~= ""
	-- screen edges glow in the rarity colour (four gradient strips; fades in at the pop, not in the small box)
	local edges: { Frame } = {}
	if not compact then
		for i = 1, 4 do
			local e = Instance.new("Frame")
			e.Name = "EdgeGlow"
			e.BorderSizePixel = 0
			e.BackgroundColor3 = tint
			e.BackgroundTransparency = 1
			e.Active = false
			e.ZIndex = 6
			local horiz = i <= 2
			e.Size = if horiz then UDim2.new(1, 0, 0.16, 0) else UDim2.new(0.12, 0, 1, 0)
			e.AnchorPoint = Vector2.new(if i == 4 then 1 else 0, if i == 2 then 1 else 0)
			e.Position = UDim2.fromScale(if i == 4 then 1 else 0, if i == 2 then 1 else 0)
			local g = Instance.new("UIGradient")
			g.Transparency = NumberSequence.new(0, 1)
			g.Rotation = if i == 1 then 90 elseif i == 2 then 270 elseif i == 3 then 0 else 180
			g.Parent = e
			e.Parent = shade
			edges[i] = e
		end
	end
	-- Epic / Legendary: one short white flash as the pet pops (never with reduced motion)
	local flash: Frame? = nil
	if not compact and not reduced and (rarity == "Epic" or rarity == "Legendary") then
		flash = UI.frame(shade, { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, ZIndex = 7 })
	end
	-- gold / rainbow pets: the variant word pops on its own under the headline
	local variantWord = ({ Golden = "GOLD!", Rainbow = "RAINBOW!", SilverCosmic = "COSMIC!" } :: { [string]: string })[spec.Modifier]
	local vword: TextLabel? = nil
	local vscale = Instance.new("UIScale")
	if variantWord and not compact then
		vword = UI.text(shade, variantWord, {
			Font = UI.Head, TextSize = 40, TextColor3 = C.Yellow, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 52),
			Size = UDim2.new(0.8, 0, 0, 50), TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 1, ZIndex = 8,
		})
		vscale.Parent = vword
	end
	-- gold / rainbow pets get a quick shimmer sweep across the stage
	local special = spec.Modifier == "Golden" or spec.Modifier == "Rainbow" or spec.Modifier == "SilverCosmic"
	local sweepClip = UI.frame(shade, { Name = "Sweep", AnchorPoint = Vector2.new(0.5, 0.5), Position = stagePos, Size = stageSize, BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 6 })
	local sweep = Instance.new("Frame")
	sweep.AnchorPoint = Vector2.new(0.5, 0.5)
	sweep.Size = UDim2.fromScale(0.22, 1.6)
	sweep.Rotation = 20
	sweep.BackgroundColor3 = if spec.Modifier == "Rainbow" then Color3.fromRGB(255, 220, 255) else Color3.fromRGB(255, 244, 190)
	sweep.BackgroundTransparency = 1
	sweep.BorderSizePixel = 0
	sweep.Visible = special and not compact
	local sg = Instance.new("UIGradient")
	sg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
	sg.Parent = sweep
	sweep.Parent = sweepClip
	local live = 0 -- real seconds since the reveal started (keeps running while the final frame holds)
	local hint = UI.text(shade, "Tap to skip", { Font = UI.Bold, TextSize = T.Body, TextColor3 = C.Text, Outline = "Normal", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.fromOffset(240, 24), TextXAlignment = Enum.TextXAlignment.Center, Visible = false })

	-- the closed egg: two shell halves around the pet (pet starts tiny so nothing pokes through the shell)
	local world = vp:FindFirstChildOfClass("WorldModel") :: WorldModel
	local base = model:GetPivot()
	local halves = GeodeModel.frontHalves(spec, 1)
	local closed: { CFrame } = {}
	local cracks: { BasePart } = {}
	local shells: { BasePart } = {}
	for i, h in halves do
		h:PivotTo(base * h:GetPivot())
		closed[i] = h:GetPivot()
		h.Parent = world
		for _, d in h:GetDescendants() do
			if d:IsA("BasePart") then
				if d.Name == "Crack" then
					table.insert(cracks, d)
				else
					table.insert(shells, d)
				end
			end
		end
	end
	table.sort(cracks, function(a, b)
		return a.Position.Y < b.Position.Y
	end)
	local glints: { BasePart } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name == "Glint" then
			table.insert(glints, d)
		end
	end
	local fit = GeodeModel.shellFit(spec, 1)
	local eggY = if fit then fit.CentreY else 1.5
	local R = if fit then fit.Width / 2 else 1.25
	local endCam = cam.CFrame
	local dist = (endCam.Position - model:GetBoundingBox().Position).Magnitude
	local dimAmbient = Color3.fromRGB(96, 88, 110)
	local dimLight = Color3.fromRGB(190, 180, 170)
	local petScale = -1

	local fired: { [string]: boolean } = {}
	local function once(key: string, fn: () -> ())
		if not fired[key] then
			fired[key] = true
			fn()
		end
	end

	local function setPetScale(k: number)
		k = math.max(k, 0.05)
		if math.abs(k - petScale) > 1e-3 then
			petScale = k
			model:ScaleTo(k)
		end
	end

	-- the pet's place for animation time t: pops out, lands with a tiny bounce, then turns slowly
	local spinFrom: number? = nil -- live time when the slow turn began (so it starts at 0, not mid-turn)
	local function placePet(t: number)
		if t >= 1.5 and spinFrom == nil then
			spinFrom = live
		end
		local spin = if reduced or t < 1.5 then 0 else (live - (spinFrom or live)) * SPIN_RATE
		local turn = CFrame.Angles(0, spin, 0)
		if t < 1.0 then
			model:PivotTo(base * CFrame.new(0, eggY * 0.6 + (1 - easeOutBack(span(t, 0, 0.4))) * R * 1.2, 0))
		else
			local pk = span(t, 1.0, 1.55)
			local hop = math.sin(math.min(pk, 1) * math.pi) * R * 0.5
			local landed = math.max(t - 1.55, 0)
			local bounce = if reduced then 0 else R * 0.09 * math.abs(math.sin(landed * 13)) * math.exp(-landed * 5)
			model:PivotTo(base * CFrame.new(0, eggY * 0.6 * (1 - ease(pk)) + hop + bounce, 0) * turn)
		end
	end

	local function animate(t: number)
		shade.BackgroundTransparency = 1 - (if compact then 0.8 else 0.86) * ease(span(t, 0, 0.4))
		-- rays fade in and turn
		local rp = ease(span(t, 1.15, 1.7))
		for i, r in rays do
			r.Rotation = i / #rays * 180 + t * 18
			r.BackgroundTransparency = 1 - rp * (0.12 + 0.18 * strength)
		end
		disc.BackgroundTransparency = 1 - rp * (0.1 + 0.12 * strength)
		if timing.Glow then
			-- Rare+: a pulsing rarity glow builds behind the egg through the slow motion, peaking at the pop
			local g = ease(span(t, 0.3, 1.0)) * (1 - 0.5 * ease(span(t, 1.2, 1.8)))
			local pulse = 0.5 + 0.5 * math.sin(os.clock() * 7)
			disc.BackgroundTransparency = math.min(disc.BackgroundTransparency, 1 - g * (0.3 + 0.2 * pulse))
		end
		-- camera: a little wide, then the ease onto the pet
		local f = 1.45 - 0.1 * ease(span(t, 0, 1.0)) - 0.35 * ease(span(t, 1.5, 2.4))
		cam.CFrame = endCam * CFrame.new(0, -0.04 * dist * (f - 1), dist * (f - 1))
		-- egg: drop in, then wobble harder and harder until it cracks
		local drop = (1 - easeOutBack(span(t, 0, 0.4))) * R * 1.2
		local wob = if t < 1.0 then math.sin(t * (14 + 22 * span(t, 0.4, 1.0))) * (0.05 + 0.2 * span(t, 0.4, 1.0)) else 0
		local rock = CFrame.new(0, eggY, 0) * CFrame.Angles(0, 0, wob) * CFrame.new(0, -eggY, 0)
		-- shell halves: tumble out and down to the floor, bounce once, then fade
		local k = span(t, 1.0, 1.9)
		local out = 1 - (1 - k) ^ 2
		local floorY = -R * 0.6
		local y
		if k < 0.6 then
			local u = k / 0.6
			y = floorY * u * u + R * 1.8 * u * (1 - u)
		else
			local v = (k - 0.6) / 0.4
			y = floorY + R * 0.5 * v * (1 - v)
		end
		for i, h in halves do
			local side = (h:GetAttribute("Side") :: number?) or (if i == 1 then -1 else 1)
			local fly = CFrame.new(side * out * R * 2.4, y, -out * R * 0.5) * CFrame.Angles(0, 0, -side * out * math.rad(150))
			h:PivotTo(base * rock * CFrame.new(0, drop, 0) * base:Inverse() * closed[i] * fly)
		end
		local fade = span(t, 1.6, 1.95)
		for _, p in shells do
			p.Transparency = fade
		end
		-- cracks run up the seam
		local n = #cracks
		for i, c in cracks do
			local at = 0.45 + 0.5 * ((i - 1) / math.max(n - 1, 1))
			c.Transparency = math.max(1 - span(t, at, at + 0.06), fade)
		end
		-- pet pops out with a bounce
		if t < 1.0 then
			setPetScale(0.2)
		else
			setPetScale(0.2 + 0.8 * easeOutBack(span(t, 1.0, 1.55)))
		end
		placePet(t)
		-- lighting brightens as it hatches
		local l = ease(span(t, 0.95, 1.5))
		vp.Ambient = dimAmbient:Lerp(GeodeView.Ambient, l)
		vp.LightColor = dimLight:Lerp(GeodeView.LightColor, l):Lerp(tint, 0.15 * strength * l)
		if timing.Glow then
			vp.LightColor = vp.LightColor:Lerp(tint, 0.35 * ease(span(t, 0.3, 1.0)) * (1 - l * 0.6))
		end
		for i, g in glints do
			local on = span(t, 1.65 + i * 0.07, 1.85 + i * 0.07)
			local tw = 0.5 + 0.5 * math.sin(t * 9 + i * 1.7)
			g.Transparency = 1 - on * (0.45 + 0.5 * tw)
		end
		head.TextTransparency = 1 - span(t, 0.95, 1.3)
		local lab = 1 - span(t, 1.6, 2.0)
		local sk = span(t, 1.6, 1.82)
		name.TextTransparency = 1 - math.min(sk * 3, 1)
		-- the whole line lands at once with the slam, so the rarity and the pet's name always show together
		extra.TextTransparency = 1 - span(t, 1.8, 2.2)
		local eg = ease(span(t, 1.0, 1.5)) * (0.35 + 0.3 * strength)
		for _, e in edges do
			e.BackgroundTransparency = 1 - eg
		end
		if flash then
			local fp = span(t, 1.0, 1.3)
			flash.BackgroundTransparency = if fp <= 0 or fp >= 1 then 1 else 1 - 0.55 * (1 - fp)
		end
		if vword then
			local vp2 = span(t, 1.85, 2.15)
			vword.TextTransparency = 1 - math.min(vp2 * 3, 1)
			vscale.Scale = if vp2 <= 0 then 2 else 1 + 1.0 * (1 - easeOutBack(vp2))
		end
		if sweep.Visible then
			local sp = span(t, 1.95, 2.45)
			sweep.BackgroundTransparency = if sp <= 0 or sp >= 1 then 1 else 0.35
			sweep.Position = UDim2.fromScale(-0.2 + 1.4 * sp, 0.5)
		end
		slam.Scale = if sk <= 0 then 2.4 else 1 + 1.4 * (1 - easeOutBack(sk))
		facts.TextTransparency = lab
		-- the shake right after it lands (stronger for rarer pets; none in the small box)
		local shake = if compact then 0 else span(t, 1.82, 1.83) * (1 - span(t, 1.83, 2.1))
		if shake > 0 and not reduced then
			local amp = (3 + 7 * strength) * shake
			labels.Position = labelsPos + UDim2.fromOffset(math.sin(t * 173) * amp, math.cos(t * 131) * amp * 0.6)
		else
			labels.Position = labelsPos
		end
		hint.Visible = t >= SKIP_AFTER and not compact
		hint.TextTransparency = if t >= ANIM_END then 1 - span(live, HINT_AT, HINT_AT + 0.6) else 0
		if t >= 1.0 then
			once("sound", function()
				-- pets never roar (owner rule): sting + sparkle swell / drum hit by rarity (shared/SoundCues.reveal)
				Audio.reveal(rarity, spec.Mineral == "CosmicDragon")
				-- the real mesh pet (PetModels template) plays its hatch animation as it pops out (optional)
				PetMotionBridge.hatch(model)
			end)
		end
		if t >= 1.1 then
			once("burst", function()
				if not reduced then
					pcall(Effects.revealBurst, vp.AbsolutePosition, vp.AbsoluteSize, tint, (0.15 + 0.85 * strength) * (if compact then 0.4 else 1))
				end
			end)
		end
		if t >= 1.75 then
			once("shimmer", function()
				if not reduced then
					pcall(Effects.shimmer, vp.AbsolutePosition, vp.AbsoluteSize)
				end
			end)
		end
		if t >= 1.9 and iWon then
			once("win", function()
				Effects.confetti()
				if res.Kind ~= "Solo" then
					Audio.play("MatchWin")
				end
			end)
		end
		if t >= ANIM_END then
			hint.Text = "Tap to continue"
		end
	end

	local t = 0 -- real seconds; animate() takes the warped animation time
	if reduced then
		t = END
	elseif timing.SlowMo then
		Audio.hatchChoir()
	end
	local pre = if reduced then 0 else 0.3 -- a short beat of dim before the egg drops in
	if skippedBefore and not reduced and not timing.Glow and not compact then
		t = END -- this player skipped before: quiet hatches open on the final frame (Rare and up still play)
		pre = 0
	end
	playing = t < END
	animate(warp(t))
	if reduced then
		shade.BackgroundTransparency = 0.12
	end
	local btn = Instance.new("TextButton")
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Size = UDim2.fromScale(1, 1)
	btn.ZIndex = 10
	btn.Parent = shade
	btn.Activated:Connect(function()
		if t >= END then
			RevealView.close()
		elseif t >= SKIP_AFTER then
			t = END
			playing = false
			skippedBefore = true
			animate(warp(t))
		end
	end)
	if reduced then
		return
	end
	conn = RunService.RenderStepped:Connect(function(dt)
		if not shade.Parent then
			RevealView.close()
			return
		end
		live += dt
		if t >= END then
			placePet(ANIM_END) -- the finished pet keeps turning while the card holds
			hint.TextTransparency = 1 - span(live, HINT_AT, HINT_AT + 0.6)
			return
		end
		if pre > 0 then
			pre -= dt
			return
		end
		t = math.min(t + dt, END)
		if t >= END then
			playing = false
		end
		animate(warp(t))
	end)
end

return RevealView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="331">
          <Properties>
            <string name="Name">RoundIntro</string>
            <string name="Source"><![CDATA[--!strict
-- Round intro (client only, cosmetic; the server's Countdown phase still decides when the hunt starts):
--   * Whoosh: entering a hunt (State.Match appears) or going back to the lobby (it clears) covers the camera jump
--     with a short swirl that fades out. Reduce Motion: a plain quick fade, no swirl.
--   * Countdown: big 3 - 2 - 1 - GO! in the middle of the screen, read from the server's EndsAt (nothing local
--     decides the start). Own small ScreenGui (the HUD keeps its own "Starting in" line).
--   * Swoop: during the countdown the camera glides from high over the pile down into the player's eyes, ending
--     looking at the pile, so first person resumes from there. A CameraMode cinematic (released before the hunt
--     starts); skipped with Reduce Motion or when the countdown is already almost over.

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ContentProvider = game:GetService("ContentProvider")

local State = require(script.Parent.State)
local CameraMode = require(script.Parent.CameraMode)
local UI = require(script.Parent.ui.UI)
local ZoneThemes = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("ZoneThemes"))
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local IntroRules = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("IntroRules"))

local RoundIntro = {}

local CINE = "RoundSwoop"
local SWOOP_MAX = 2.6 -- seconds
-- Swoop framing (polish: the pile read small and far at round start). The path starts lower and nearer the pile and
-- a tighter lens frames the egg pile larger; the lens eases back to Config.Camera.Fov before first person resumes.
local SWOOP_HIGH = Vector3.new(0, 26, 0) -- start: above the pile, a little past its centre (was 42 up, 18 past)
local SWOOP_PAST = 8
local SWOOP_MID_OUT, SWOOP_MID_UP = 9, 14 -- the bend of the glide, on the player's side (was 14 out, 26 up)
local SWOOP_FOV = 56 -- degrees at the start of the glide (first person uses Config.Camera.Fov)
local LOAD_MAX = 4 -- seconds the entry cover waits for the arena's meshes before it lifts anyway
local GROUND_MIN = 1.2 -- with solid ground under the player the cover may lift this soon, meshes or not
local REST = UDim2.fromScale(0.5, 0.52) -- the countdown number's resting spot: screen middle, under the objective banner
local player = Players.LocalPlayer

local gui: ScreenGui? = nil
local numLabel: TextLabel? = nil
local numScale: UIScale? = nil
local cover: Frame? = nil
local shown = "" -- the text on screen ("3", "2", "1", "GO!" or "")
local lastRound: any = nil
local swoopRound: any = nil
local goRound: any = nil
local hadMatch = false
local swooping = false
local arenaReady = true -- false while the entry cover waits for the arena to load (no swoop over a half-loaded map)

local function reduced(): boolean
	local p = State.Profile
	return UI.Reduced or (p ~= nil and p.Settings ~= nil and p.Settings.ReducedMotion == true)
end

local function ensureGui(): ScreenGui
	if gui and gui.Parent then
		return gui :: ScreenGui
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = "CT_RoundIntro"
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = true
	sg.DisplayOrder = 15 -- over the HUD (5), under menus (20)
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.Parent = player:WaitForChild("PlayerGui")
	gui = sg
	-- the countdown number
	local holder = Instance.new("Frame")
	holder.Name = "Count"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = REST
	holder.ZIndex = 20 -- the countdown number shows over the entry cover
	holder.Size = UDim2.fromOffset(260, 150)
	holder.Parent = sg
	local sc = Instance.new("UIScale")
	sc.Parent = holder
	numScale = sc
	local t = UI.text(holder, "", {
		Name = "Text", Font = UI.Head, TextSize = 120, Outline = "Strong", TextColor3 = UI.Colors.Gold,
		Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Visible = false,
	})
	numLabel = t
	-- the whoosh cover
	local c = Instance.new("Frame")
	c.Name = "Whoosh"
	c.Size = UDim2.fromScale(1, 1)
	c.BackgroundColor3 = Color3.fromRGB(255, 248, 228)
	c.BackgroundTransparency = 1
	c.BorderSizePixel = 0
	c.Visible = false
	c.ZIndex = 10
	c.Parent = sg
	cover = c
	return sg
end

-- Countdown number -----------------------------------------------------------------------------------------

-- GO!: one ring bursts out from behind the word and fades. It stays small (a second, wider ring read on phones as
-- a big faint circle round the whole screen). The ring ends itself.
local function ringWave(holder: Frame)
	local sg = gui
	if not sg then
		return
	end
	local ring = Instance.new("Frame")
	ring.Name = "GoRing"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = holder.Position
	ring.Size = UDim2.fromOffset(80, 80)
	ring.BackgroundTransparency = 1
	ring.ZIndex = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = ring
	local stroke = Instance.new("UIStroke")
	stroke.Color = UI.Colors.Green
	stroke.Thickness = 8
	stroke.Parent = ring
	ring.Parent = sg
	local info = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(ring, info, { Size = UDim2.fromOffset(240, 240) }):Play()
	TweenService:Create(stroke, info, { Transparency = 1, Thickness = 2 }):Play()
	task.delay(0.47, function()
		ring:Destroy()
	end)
end

local function setNumber(text: string)
	if text == shown then
		return
	end
	shown = text
	ensureGui()
	local t, sc = numLabel, numScale
	if not t or not sc then
		return
	end
	if text == "" then
		t.Visible = false
		return
	end
	t.Text = text
	t.Visible = true
	t.TextTransparency = 0
	t.TextColor3 = if text == "GO!" then UI.Colors.Green else UI.Colors.Gold
	local stroke = t:FindFirstChild("Outline")
	if stroke and stroke:IsA("UIStroke") then
		stroke.Transparency = 0
	end
	local holder = t.Parent :: Frame
	if reduced() then
		sc.Scale = 1
		holder.Position = REST
	else
		-- a gentle pop (1.6 reached up into the objective banner on short phones)
		sc.Scale = 1.25
		TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		-- each number drops in from a little above and bounces to rest
		holder.Position = REST - UDim2.fromScale(0, 0.04)
		TweenService:Create(holder, TweenInfo.new(0.45, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { Position = REST }):Play()
		if text == "GO!" then
			ringWave(holder)
		end
	end
	if text == "GO!" then
		task.delay(0.55, function()
			if shown ~= "GO!" then
				return
			end
			TweenService:Create(t, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			if stroke and stroke:IsA("UIStroke") then
				TweenService:Create(stroke, TweenInfo.new(0.3), { Transparency = 1 }):Play()
			end
			task.delay(0.32, function()
				if shown == "GO!" then
					setNumber("")
				end
			end)
		end)
	end
end

-- Whoosh ---------------------------------------------------------------------------------------------------

-- The hunt arena's meshes near `centre` (the zone set the server clones in at round start). The first hunt on a
-- phone downloads them while the countdown runs: without waiting, the camera showed nests floating over sky.
local function arenaMeshes(centre: Vector3): { Instance }
	local list: { Instance } = {}
	for _, d in Workspace:GetDescendants() do
		if d:IsA("MeshPart") and (d.Position - centre).Magnitude < 140 then
			table.insert(list, d)
		end
	end
	return list
end

local whooshId = 0
-- Solid ground under the player's feet (the arena floor near them has streamed in).
local function groundUnderPlayer(): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char :: Instance }
	return Workspace:Raycast(root.Position, Vector3.new(0, -12, 0), params) ~= nil
end

-- `centre` (entering a hunt): the cover stays up until the arena there has loaded (at most LOAD_MAX, or GROUND_MIN
-- once the ground under the player is in), then fades. While it waits it is not blank: it takes the zone's ground
-- colour and says which map is loading (`tier` = the hunt's tier id).
local function whoosh(centre: Vector3?, tier: string?)
	ensureGui()
	local c = cover
	if not c then
		return
	end
	whooshId += 1
	local my = whooshId
	for _, ch in c:GetChildren() do
		ch:Destroy()
	end
	c.Visible = true
	c.BackgroundTransparency = 0
	local plain = reduced()
	local theme = if centre then ZoneThemes.get(tier) else nil
	c.BackgroundColor3 = Color3.fromRGB(255, 248, 228)
	if not plain then
		-- a soft turning colour swirl over the cover while it fades (no spiral arms: as they thinned out they read as
		-- white lines across the screen); entering a hunt it runs from the zone's ground colour to its sky
		local grad = Instance.new("UIGradient")
		grad.Color = if theme
			then ColorSequence.new(theme.Floor:Lerp(Color3.new(1, 1, 1), 0.25), Color3.fromRGB(150, 210, 255))
			else ColorSequence.new(Color3.fromRGB(255, 236, 170), Color3.fromRGB(150, 210, 255))
		grad.Parent = c
	elseif theme then
		c.BackgroundColor3 = theme.Floor:Lerp(Color3.new(1, 1, 1), 0.35)
	end
	local loadingLabel: TextLabel? = nil
	if theme then
		-- under the countdown number (which sits in the middle), so "3" and "2" never land on an empty screen
		loadingLabel = UI.text(c, "Loading " .. (if theme.Zone == "Space" then "Space" else "the " .. theme.Zone) .. "\u{2026}", {
			Name = "Loading", Font = UI.Head, TextSize = 30, Outline = "Strong", TextColor3 = UI.Colors.Text,
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.76), Size = UDim2.new(0.8, 0, 0, 40),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 11,
		})
		local ll = loadingLabel :: TextLabel
		ll.TextWrapped = false
		UI.fit(ll, 30, 18)
	end
	local dur = if plain then 0.35 else 0.7
	local t0 = os.clock()
	local loaded = true
	if centre then
		loaded = false
		arenaReady = false
		task.spawn(function()
			local parts = arenaMeshes(centre)
			pcall(function()
				ContentProvider:PreloadAsync(parts)
			end)
			if my == whooshId then
				loaded = true
				arenaReady = true
			end
		end)
		task.delay(LOAD_MAX, function()
			if my == whooshId and not loaded then
				loaded = true
				arenaReady = true
			end
		end)
	end
	local waitFrom = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.RenderStepped:Connect(function()
		if not loaded and os.clock() - waitFrom >= GROUND_MIN and groundUnderPlayer() then
			loaded = true -- the floor around the player is in: show the map now, the rest streams in behind
			arenaReady = true
		end
		if not loaded then
			t0 = os.clock() -- hold the cover (spinning) until the arena is there
			local grad = c:FindFirstChildOfClass("UIGradient")
			if grad then
				grad.Rotation = (os.clock() * 200) % 360
			end
			return
		end
		local k = (os.clock() - t0) / dur
		if my ~= whooshId or k >= 1 then
			if conn then
				conn:Disconnect()
			end
			if my == whooshId then
				c.Visible = false
				for _, ch in c:GetChildren() do
					ch:Destroy()
				end
			end
			return
		end
		local e = k * k
		c.BackgroundTransparency = e
		if loadingLabel then
			loadingLabel.TextTransparency = e
			local o = loadingLabel:FindFirstChildOfClass("UIStroke")
			if o then
				o.Transparency = e
			end
		end
		local grad = c:FindFirstChildOfClass("UIGradient")
		if grad then
			grad.Rotation = k * 540
		end
	end)
end

-- Swoop ----------------------------------------------------------------------------------------------------

local function smooth(k: number): number
	return k * k * (3 - 2 * k)
end

-- The player's eyes looking at the egg pile (a little down, so the eggs fill the view).
local function eyeOn(head: BasePart, centre: Vector3): CFrame
	local eye = head.Position + Vector3.new(0, 0.3, 0)
	local look = Vector3.new(centre.X, eye.Y - 2.5, centre.Z)
	if (look - eye).Magnitude < 1 then
		look = eye + Vector3.new(0, -0.5, -4)
	end
	return CFrame.lookAt(eye, look)
end

-- No swoop this round (Reduce Motion, a late join, the arena still loading): the camera still starts on the pile,
-- never on whatever the spawn pad faced (walkthrough 10-14: the hunt opened on an empty lawn).
local aimRound: any = nil
local function aimAtPile(round: any, centre: any)
	if aimRound == round or swoopRound == round or swooping or typeof(centre) ~= "Vector3" then
		return
	end
	local cam = Workspace.CurrentCamera
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not cam or not head or not head:IsA("BasePart") then
		return
	end
	aimRound = round
	cam.CFrame = eyeOn(head, centre)
end

local function swoop(centre: Vector3, seconds: number)
	local cam = Workspace.CurrentCamera
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	if not cam or not head or not head:IsA("BasePart") then
		return
	end
	swooping = true
	CameraMode.cinematic(CINE, true)
	cam.CameraType = Enum.CameraType.Scriptable
	local function eyeFrame(): CFrame
		return eyeOn(head :: BasePart, centre)
	end
	local first = eyeFrame()
	local away = first.Position - centre
	away = Vector3.new(away.X, 0, away.Z)
	away = if away.Magnitude > 1 then away.Unit else Vector3.zAxis
	local high = centre + SWOOP_HIGH - away * SWOOP_PAST -- over the far side of the pile, looking down at it
	local mid = centre + away * SWOOP_MID_OUT + Vector3.new(0, SWOOP_MID_UP, 0)
	local baseFov = Config.Camera.Fov
	local t0 = os.clock()
	while os.clock() - t0 < seconds do
		if not CameraMode.inHunt() or State.Match == nil or State.Match.Phase ~= "Countdown" or not head.Parent then
			break
		end
		local k = smooth(math.clamp((os.clock() - t0) / seconds, 0, 1))
		local fin = eyeFrame()
		local p = high:Lerp(mid, k):Lerp(mid:Lerp(fin.Position, k), k)
		local target = centre:Lerp(fin.Position + fin.LookVector * 10, k)
		local cf = CFrame.lookAt(p, target)
		if k > 0.85 then
			cf = cf:Lerp(fin, (k - 0.85) / 0.15)
		end
		cam.CFrame = cf
		-- tight lens over the pile, back to the first-person lens by the end of the glide
		cam.FieldOfView = SWOOP_FOV + (baseFov - SWOOP_FOV) * smooth(math.clamp((k - 0.55) / 0.4, 0, 1))
		RunService.RenderStepped:Wait()
	end
	if cam.Parent then
		cam.CFrame = eyeFrame()
		cam.FieldOfView = baseFov
	end
	swooping = false
	CameraMode.cinematic(CINE, false)
end

-- Driver ---------------------------------------------------------------------------------------------------

local function onMatch()
	local m = State.Match
	local inMatch = m ~= nil
	if inMatch ~= hadMatch then
		hadMatch = inMatch
		whoosh(if m and typeof(m.Center) == "Vector3" then m.Center else nil, if m and type(m.Tier) == "string" then m.Tier else nil)
	end
	if not m then
		-- a new match starts its rounds at 1 again: forget this match's rounds (a stale "GO shown" kept a "1" up)
		lastRound, goRound, swoopRound, aimRound = nil, nil, nil, nil
		setNumber("")
		return
	end
	local key = IntroRules.roundKey(m.Key, m.Round)
	if key ~= lastRound then
		lastRound = key
		setNumber("")
	end
	if m.Phase == "Countdown" then
		local left = (tonumber(m.EndsAt) or 0) - Workspace:GetServerTimeNow()
		local centre = m.Center
		if arenaReady and swoopRound ~= key and not swooping and left > 1.2 and typeof(centre) == "Vector3" and not reduced() then
			swoopRound = key
			task.spawn(swoop, centre :: Vector3, math.min(SWOOP_MAX, left - 0.25))
		elseif arenaReady and reduced() then
			aimAtPile(key, centre)
		end
	elseif m.Phase == "Searching" then
		aimAtPile(key, m.Center) -- once, only when no swoop ran this round
		local next = IntroRules.onSearching(shown, goRound, key)
		if next == "GO!" then
			goRound = key
		end
		if next then
			setNumber(next)
		end
	elseif shown ~= "" and shown ~= "GO!" then
		setNumber("")
	end
end

local started = false
function RoundIntro.start()
	if started then
		return
	end
	started = true
	ensureGui()
	State.Changed.Event:Connect(function(what)
		if what == "Match" then
			onMatch()
		end
	end)
	-- the number follows the server clock between phase messages
	task.spawn(function()
		while true do
			task.wait(0.1)
			local m = State.Match
			if m and m.Phase == "Countdown" and not UI.blocked() then
				local left = math.ceil((tonumber(m.EndsAt) or 0) - Workspace:GetServerTimeNow())
				if left >= 1 and left <= 3 then
					setNumber(tostring(left))
				end
			end
		end
	end)
	onMatch()
end

return RoundIntro
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="332">
          <Properties>
            <string name="Name">SelfHide</string>
            <string name="Source"><![CDATA[--!strict
-- The player's own avatar is hidden for the player (LocalTransparencyModifier; others still see it) while
-- PopupRules.hideSelf says so: a Pet Battle (InBattle) or a tower climb (InTower). Re-applied every frame after the
-- camera, because the default camera scripts reset the modifier. Restored when the fight view ends.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PopupRules = require(Shared.PopupRules)

local SelfHide = {}

local player = Players.LocalPlayer
local hidden: { [Instance]: boolean } = {}

local function apply(on: boolean)
	local char = player.Character
	if on and char then
		for _, d in char:GetDescendants() do
			if d:IsA("BasePart") or d:IsA("Decal") then
				(d :: any).LocalTransparencyModifier = 1
				hidden[d] = true
			end
		end
	elseif not on and next(hidden) then
		for d in hidden do
			if d.Parent then
				(d :: any).LocalTransparencyModifier = 0
			end
		end
		table.clear(hidden)
	end
end

function SelfHide.wanted(): boolean
	return PopupRules.hideSelf(player:GetAttribute("InBattle") == true, player:GetAttribute("InTower") == true)
end

function SelfHide.start()
	RunService:BindToRenderStep("SelfHide", Enum.RenderPriority.Camera.Value + 2, function()
		apply(SelfHide.wanted())
	end)
end

return SelfHide
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="333">
          <Properties>
            <string name="Name">SoundCueView</string>
            <string name="Source"><![CDATA[--!strict
-- Find The Pet moment sounds heard from server messages (client only, cosmetic): Pet Battle matched / lost, training
-- taps, tower floor cleared / lost, gifts opened, coins gained. Which key plays where: shared/SoundCues. Each listener is
-- an extra connection next to the panels' own, so no panel code changes. Every id 0 plays nothing (Audio).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local SoundCues = require(Shared.SoundCues)
local Audio = require(script.Parent.Audio)
local State = require(script.Parent.State)

local SoundCueView = {}

local started = false
local lastCash: number? = nil
local sellAt = -math.huge -- a sale plays its own coin sound when the coins land (Main.client Fx "Sell")

local function listen(folderName: string, eventName: string, pick: (any) -> string?)
	task.spawn(function()
		local folder = ReplicatedStorage:WaitForChild(folderName, 60)
		local ev = folder and folder:WaitForChild(eventName, 30)
		if ev and ev:IsA("RemoteEvent") then
			ev.OnClientEvent:Connect(function(msg)
				local key = pick(msg)
				if key then
					Audio.play(key)
				end
			end)
		end
	end)
end

function SoundCueView.start()
	if started then
		return
	end
	started = true
	listen("PvpNet", "PvpEvent", SoundCues.pvp)
	listen("TowerNet", "TowerEvent", SoundCues.tower)
	Net.event("Retention").OnClientEvent:Connect(function(kind)
		local key = SoundCues.retention(kind)
		if key then
			Audio.play(key)
		end
	end)
	Net.event("Fx").OnClientEvent:Connect(function(kind)
		if kind == "Sell" then
			sellAt = os.clock()
		end
	end)
	-- coin gain: any rise of the saved coins (not the first load, not a sale, which rings when its coins land)
	State.Changed.Event:Connect(function(what)
		if what ~= "Profile" or not State.Profile then
			return
		end
		local cash = tonumber(State.Profile.Cash)
		if not cash then
			return
		end
		local before = lastCash
		lastCash = cash
		if before and cash > before and os.clock() - sellAt > 2 then
			Audio.play("CoinPickup", { Volume = 0.8, Key = "coin:gain" })
		end
	end)
end

return SoundCueView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="334">
          <Properties>
            <string name="Name">SpinView</string>
            <string name="Source"><![CDATA[--!strict
-- Spin wheel HUD hook (idea 3, client only; the server rolls and pays: RetentionService.spin, LaunchPerks.Spin).
-- A SPIN card in the HUD's lobby row, sharing the GIFT card's slot (SpinView.wanted): "in 3:59:12" counts down to the next free spin; when
-- it is ready it turns green "SPIN!" and wiggles. Tap = ask the server to spin; the answer ("Spin", { Slice, Text })
-- shows as a banner with confetti. A drawn wheel that lands on the slice is the UI thread's job (Fable): it can read
-- LaunchPerks.Spin.Slices for the slice order and listen to the same Retention "Spin" notice.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local State = require(script.Parent.State)
local UI = require(script.Parent.ui.UI)
local Theme = require(script.Parent.ui.Theme)
local HudArt = require(script.Parent.ui.HudArt)
local Juice = require(script.Parent.ui.Juice)
local Effects = require(script.Parent.Effects)
local SpinPanel = require(script.Parent.ui.SpinPanel)

local T = UI.T
local TC = Theme.Color
local SpinView = {}

local player = Players.LocalPlayer
local btn: TextButton? = nil
local sub: TextLabel? = nil
local readyAt = math.huge -- os.clock when the next spin is ready (from the last profile view)
local style = ""
local stopWiggle: (() -> ())? = nil
local asked = 0

local function clock(sec: number): string
	sec = math.max(0, math.ceil(sec))
	local h, m = sec // 3600, sec % 3600 // 60
	return if h > 0 then string.format("%d:%02d:%02d", h, m, sec % 60) else string.format("%d:%02d", m, sec % 60)
end

local function setStyle(s: string)
	local b = btn
	if not b or style == s then
		return
	end
	style = s
	UI.setStyle(b, s)
	if s == "green" and not stopWiggle then
		stopWiggle = UI.wiggle(b)
	elseif s ~= "green" and stopWiggle then
		(stopWiggle :: () -> ())()
		stopWiggle = nil
	end
end

local function refresh()
	local b, l = btn, sub
	if not b or not l then
		return
	end
	local lobby = State.Match == nil and player:GetAttribute("MatchKey") == nil and player:GetAttribute("InTower") ~= true and player:GetAttribute("InBattle") ~= true
	local left = readyAt - os.clock()
	b.Visible = lobby and State.Profile ~= nil and readyAt < math.huge and SpinView.wanted(left <= 0)
	if not b.Visible then
		return
	end
	if left <= 0 then
		l.Text = "SPIN!"
		setStyle("green")
	else
		l.Text = "in " .. clock(left)
		setStyle("blue")
	end
end

-- The HUD row has room for one of GIFT / SPIN (the phone row is full): SPIN shows once today's play gifts are all
-- opened, or while a spin is ready and no gift is. RetentionView hides GIFT while this is true.
function SpinView.wanted(spinReady: boolean?): boolean
	local p = State.Profile
	local g = p and (p :: any).Gifts
	if readyAt == math.huge then
		return false
	end
	if spinReady == nil then
		spinReady = readyAt - os.clock() <= 0
	end
	if type(g) ~= "table" or g.NextGift == nil then
		return true
	end
	return spinReady == true and (tonumber(g.Ready) or 0) <= 0
end

local function onProfile()
	local p = State.Profile
	local perks = p and (p :: any).Perks
	if type(perks) == "table" and type(perks.SpinIn) == "number" then
		readyAt = os.clock() + perks.SpinIn
	end
	refresh()
end

local function onClick()
	local b = btn
	if not b then
		return
	end
	-- the wheel panel (ui/SpinPanel) holds the SPIN button and the countdown; it asks the server itself
	if os.clock() - asked < 0.5 then
		return
	end
	asked = os.clock()
	SpinPanel.open()
end

-- the wheel panel (the HUD card's tap; the preview scene `spin` calls these too)
function SpinView.openPanel()
	SpinPanel.open()
end

function SpinView.landPanel(sliceId: string, text: string)
	SpinPanel.land(sliceId, text)
end

function SpinView.start()
	local screen = UI.screen()
	local left = screen:FindFirstChild("Left", true)
	local b = HudArt.bigButton(left or screen, {
		Name = "SpinWheel", Style = "blue", Art = "IconDaily", Title = "SPIN", Sub = "in 4:00:00", Width = 172, Height = 60, LayoutOrder = 56,
		OnClick = onClick,
	})
	if not left then
		b.Position = UDim2.fromOffset(T.Edge, T.Edge + 224)
	end
	b.Visible = false
	btn = b
	sub = b:FindFirstChild("Sub", true) :: TextLabel?
	style = "blue"
	State.Changed.Event:Connect(function(what)
		if what == "Profile" then
			onProfile()
		elseif what == "Match" then
			refresh()
		end
	end)
	Net.event("Retention").OnClientEvent:Connect(function(kind, data)
		if kind == "Spin" and type(data) == "table" then
			asked = 0
			if SpinPanel.isOpen() then
				-- the wheel spins onto the slice, then celebrates
				SpinPanel.land(tostring(data.Slice or ""), tostring(data.Text or ""))
			else
				Juice.banner("SPIN: " .. string.upper(tostring(data.Text or "")) .. "!", TC.Gold, 2)
				Effects.confetti()
			end
		elseif kind == "SpinNo" and type(data) == "table" then
			asked = 0
			local why = if type(data.In) == "number" then "Next spin in " .. clock(data.In) else tostring(data.Text or "Try again!")
			local b = btn
			if SpinPanel.isOpen() then
				SpinPanel.refuse(why)
			elseif b then
				Juice.nope(b)
				Juice.floatText(b, why, TC.Gold)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			refresh()
		end
	end)
	onProfile()
end

return SpinView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="335">
          <Properties>
            <string name="Name">StarterEggView</string>
            <string name="Source"><![CDATA[--!strict
-- The free starter egg (client only, cosmetic; the server decides and saves the pet: RetentionService "Starter").
-- A brand-new player (profile StarterEgg) sees a big glowing egg on a pedestal right next to the lobby spawn, with
-- the route arrow pointing at it and "FREE PET!" over it. Tapping the egg (or its prompt) asks the server to hatch
-- it; the answer plays the big hatch show (HatchShow) and the egg is gone for good. Action in the first 10 seconds,
-- no menus. The egg is local to this player: nobody else sees it.
--
-- Where: a Part named MapNames.StarterEggSpot in the map; else 16 studs in front of the lobby spawn.
-- REPLACE: the egg uses a "Lobby_ShrineEgg" mesh when the place has one in ReplicatedStorage, a gold spotted egg
-- otherwise. Either way it glows (Highlight + light + sparkles), bobs and turns, under a bouncing "FREE PET! ▼".

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MapNames = require(Shared.MapNames)
local HintRules = require(Shared.HintRules)
local Net = require(Shared.Net)
local State = require(script.Parent.State)
local GuideArrow = require(script.Parent.GuideArrow)
local HatchShow = require(script.Parent.HatchShow)

local StarterEggView = {}

StarterEggView.Hatched = Instance.new("BindableEvent") -- (pet) after the show (RetentionView cheers)
StarterEggView.Label = "EGG" -- the route arrow's chip text (the HUD leaves this arrow alone in the lobby)
local FORWARD = 16 -- studs in front of the spawn when the map has no StarterEggSpot

local player = Players.LocalPlayer
local model: Model? = nil
local eggPart: BasePart? = nil
local ringPart: BasePart? = nil
local asked = 0 -- os.clock of the last hatch request (one at a time)
local hatched = false
local spin: RBXScriptConnection? = nil -- the egg's slow bob + turn while it waits
-- the "FREE PET!" world tag follows the one hint rule (shared/HintRules): gone for good once hatched, and it retires
-- after HintRules.Timeout.FreePet seconds in view (it covered the arena sign from spawn; the egg keeps glowing)
local tagHints = HintRules.new()

local function inLobby(): boolean
	return State.Match == nil and player:GetAttribute("MatchKey") == nil and (player:GetAttribute("InTower") ~= true and player:GetAttribute("InBattle") ~= true) and not State.Teleport
end

local function wanted(): boolean
	local p = State.Profile
	return p ~= nil and p.StarterEgg == true and not hatched and inLobby()
end

local function groundBelow(pos: Vector3, ignore: { Instance }): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local hit = Workspace:Raycast(pos + Vector3.new(0, 40, 0), Vector3.new(0, -120, 0), params)
	return if hit then hit.Position else pos
end

-- Where the egg stands: (feet position, facing direction).
local function spot(): (Vector3?, Vector3)
	local hook = Workspace:FindFirstChild(MapNames.StarterEggSpot, true)
	if hook and hook:IsA("BasePart") then
		return hook.Position - Vector3.new(0, hook.Size.Y / 2, 0), hook.CFrame.LookVector
	end
	local spawn = Workspace:FindFirstChild(MapNames.Spawn, true) or Workspace:FindFirstChild("CT_Rocks_LobbySpawn", true)
	if not (spawn and spawn:IsA("BasePart")) then
		spawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	end
	if spawn and spawn:IsA("BasePart") then
		local look = spawn.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		local dir = if flat.Magnitude > 0.1 then flat.Unit else Vector3.new(0, 0, -1)
		return spawn.Position + dir * FORWARD, -dir
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local look = root.CFrame.LookVector
		return root.Position + Vector3.new(look.X, 0, look.Z) * FORWARD, -look
	end
	return nil, Vector3.new(0, 0, 1)
end

local function block(parent: Instance, name: string, shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function askHatch()
	if hatched or HatchShow.playing() or os.clock() - asked < 2 then
		return
	end
	asked = os.clock()
	Net.event("RetentionAction"):FireServer("Starter")
end

local function build()
	if model then
		return
	end
	local feet, face = spot()
	if not feet then
		return
	end
	local m = Instance.new("Model")
	m.Name = "StarterEgg_Local"
	local ground = groundBelow(feet, { m, player.Character :: any })
	local at = CFrame.lookAt(ground, ground + Vector3.new(face.X, 0, face.Z))
	-- chunky pedestal: two steps, a gold rim and a glowing ring (low-poly like the pets)
	block(m, "Pedestal", Enum.PartType.Cylinder, Vector3.new(1.6, 9, 9), at * CFrame.new(0, 0.8, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(176, 118, 70), Enum.Material.Wood)
	block(m, "PedestalTop", Enum.PartType.Cylinder, Vector3.new(0.5, 7.4, 7.4), at * CFrame.new(0, 1.85, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 204, 64), Enum.Material.Foil)
	local ring = block(m, "GlowRing", Enum.PartType.Cylinder, Vector3.new(0.2, 8.4, 8.4), at * CFrame.new(0, 1.7, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 224, 120), Enum.Material.Neon)
	ring.CanCollide = false
	ring.Transparency = 0.35
	ringPart = ring
	local top = 2.1
	local egg: BasePart
	local mesh = ReplicatedStorage:FindFirstChild("Lobby_ShrineEgg", true)
	if mesh and mesh:IsA("BasePart") then
		egg = mesh:Clone()
		local k = 6.5 / math.max(egg.Size.Y, 0.1)
		egg.Size = egg.Size * k
	else
		local ball = Instance.new("Part")
		ball.Shape = Enum.PartType.Ball
		ball.Size = Vector3.new(5.6, 7.4, 5.6)
		ball.Color = Color3.fromRGB(255, 196, 40) -- rarity gold: it must read as a special egg, never a plain white blob
		ball.Material = Enum.Material.SmoothPlastic
		ball.Reflectance = 0.15
		egg = ball
		for i, c in { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 120, 190), Color3.fromRGB(110, 210, 255) } do
			-- three chunky spots so it reads as a special egg, not a plain ball
			local a = i * 2.1
			local spotPart = block(m, "Spot" .. i, Enum.PartType.Ball, Vector3.new(1.4, 1.4, 0.6), CFrame.new(), c)
			spotPart.CanCollide = false
			spotPart:SetAttribute("Angle", a)
			spotPart:SetAttribute("Height", (i - 2) * 1.1)
		end
	end
	egg.Name = "Egg"
	egg.Anchored = true
	egg.CanCollide = true
	egg.CanTouch = false
	egg.CFrame = at * CFrame.new(0, top + egg.Size.Y / 2, 0)
	egg.Parent = m
	eggPart = egg
	-- spots ride on the egg's surface
	for _, sp in m:GetChildren() do
		local a = sp:GetAttribute("Angle")
		if sp:IsA("BasePart") and type(a) == "number" then
			local h = (sp:GetAttribute("Height") :: number?) or 0
			local r = egg.Size.X / 2 * math.sqrt(math.max(0, 1 - (h / (egg.Size.Y / 2)) ^ 2))
			local p = egg.Position + Vector3.new(math.cos(a) * r, h, math.sin(a) * r)
			sp.CFrame = CFrame.lookAt(p, p + (p - egg.Position))
			local weldTo = Instance.new("WeldConstraint")
			weldTo.Part0, weldTo.Part1 = egg, sp
			weldTo.Parent = sp
			sp.Anchored = false -- rides the egg's bob and turn through the weld
		end
	end
	-- a soft gold glow around the egg
	local glow = Instance.new("Highlight")
	glow.Name = "Glow"
	glow.Adornee = egg
	glow.FillColor = Color3.fromRGB(255, 220, 90)
	glow.FillTransparency = 0.75
	glow.OutlineColor = Color3.fromRGB(255, 240, 160)
	glow.OutlineTransparency = 0.1
	glow.DepthMode = Enum.HighlightDepthMode.Occluded
	glow.Parent = m
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 214, 120)
	light.Range = 16
	light.Brightness = 2
	light.Shadows = false
	light.Parent = egg
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Rate = 14
	sparkle.Lifetime = NumberRange.new(0.8, 1.4)
	sparkle.Speed = NumberRange.new(0.5, 1.5)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 230, 140))
	sparkle.Parent = egg
	-- "FREE PET!" over the egg, bobbing
	local bb = Instance.new("BillboardGui")
	bb.Name = "FreePet"
	bb.Size = UDim2.fromScale(7, 3.5) -- compact: the big 10x5 tag reached up over the signs behind the egg
	bb.StudsOffsetWorldSpace = Vector3.new(0, egg.Size.Y / 2 + 2.1, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 70
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 0.6)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = "FREE PET!"
	t.TextColor3 = Color3.fromRGB(255, 214, 64)
	local st = Instance.new("UIStroke")
	st.Thickness = 4
	st.Color = Color3.fromRGB(60, 30, 10)
	st.Parent = t
	t.Parent = bb
	local arrow = Instance.new("TextLabel")
	arrow.Name = "Arrow"
	arrow.BackgroundTransparency = 1
	arrow.Position = UDim2.fromScale(0.3, 0.55)
	arrow.Size = UDim2.fromScale(0.4, 0.45)
	arrow.Font = Enum.Font.FredokaOne
	arrow.TextScaled = true
	arrow.Text = "\u{25BC}"
	arrow.TextColor3 = Color3.fromRGB(255, 214, 64)
	local ast = st:Clone()
	ast.Parent = arrow
	arrow.Parent = bb
	bb.Parent = egg
	task.spawn(function()
		local last = os.clock()
		while bb.Parent do
			task.wait(0.25)
			local now = os.clock()
			if hatched then
				HintRules.done(tagHints, "FreePet")
			end
			if not HintRules.visible(tagHints, "FreePet", HintRules.Timeout.FreePet, StarterEggView.visible(), now - last) then
				bb.Enabled = false
				break
			end
			last = now
		end
	end)
	if not (State.Profile and State.Profile.Settings and State.Profile.Settings.ReducedMotion) then
		TweenService:Create(bb, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1, true), { StudsOffsetWorldSpace = bb.StudsOffsetWorldSpace + Vector3.new(0, 1.2, 0) }):Play()
		TweenService:Create(t, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 4 }):Play()
		-- the egg bobs and slowly turns (stops the moment the hatch show takes it)
		local home = egg.CFrame
		local t0 = os.clock()
		spin = RunService.Heartbeat:Connect(function()
			if HatchShow.playing() or not egg.Parent then
				return
			end
			local tt = os.clock() - t0
			egg.CFrame = home * CFrame.new(0, 0.35 + 0.35 * math.sin(tt * 2.2), 0) * CFrame.Angles(0, tt * 0.6, math.rad(4) * math.sin(tt * 1.3))
		end)
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "HatchStarter"
	prompt.ActionText = "Hatch!"
	prompt.ObjectText = "Free pet"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = egg
	prompt.Triggered:Connect(askHatch)
	m.Parent = Workspace
	model = m
	GuideArrow.set(egg.Position, StarterEggView.Label, ground.Y)
end

-- True while the starter egg (and with it the route arrow) is drawn in view: the HUD objective banner steps aside then.
function StarterEggView.visible(): boolean
	local egg = eggPart
	if not egg or not egg.Parent or hatched then
		return false
	end
	local cam = Workspace.CurrentCamera
	if not cam then
		return false
	end
	local _, onScreen = cam:WorldToViewportPoint(egg.Position)
	return onScreen
end

local function remove()
	if spin then
		spin:Disconnect()
		spin = nil
	end
	if model then
		model:Destroy()
		model = nil
		eggPart, ringPart = nil, nil
	end
	if GuideArrow.label() == StarterEggView.Label then
		GuideArrow.clear()
	end
end

local function refresh()
	if HatchShow.playing() then
		return
	end
	if wanted() then
		build()
	else
		remove()
	end
end

-- The server hatched the starter pet: play the show on our egg (or just celebrate if the egg is not here).
local function onHatched(pet: any)
	hatched = true
	if GuideArrow.label() == StarterEggView.Label then
		GuideArrow.clear()
	end
	local egg = eggPart
	if not egg then
		build()
		egg = eggPart
	end
	if egg and type(pet) == "table" then
		HatchShow.play(egg, pet, ringPart, function()
			remove()
			StarterEggView.Hatched:Fire(pet)
		end)
	else
		remove()
		StarterEggView.Hatched:Fire(pet)
	end
end

function StarterEggView.start()
	State.Changed.Event:Connect(function(what)
		if what == "Profile" or what == "Match" then
			refresh()
		end
	end)
	player:GetAttributeChangedSignal("MatchKey"):Connect(refresh)
	player:GetAttributeChangedSignal("InTower"):Connect(refresh)
	player:GetAttributeChangedSignal("InBattle"):Connect(refresh)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		refresh()
	end)
	Net.event("Retention").OnClientEvent:Connect(function(kind, data)
		if kind == "Starter" and type(data) == "table" then
			onHatched(data.Pet)
		end
	end)
	-- a tap or click right on the egg hatches it too (not only the prompt pill)
	UserInputService.InputEnded:Connect(function(input, processed)
		if processed or not eggPart then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local cam = Workspace.CurrentCamera
		local ray = cam:ViewportPointToRay(input.Position.X, input.Position.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { model :: any }
		local hit = Workspace:Raycast(ray.Origin, ray.Direction * 200, params)
		if hit then
			askHatch()
		end
	end)
	refresh()
end

return StarterEggView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="336">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side mirror of what the server told us. Read-only for gameplay decisions.

local State = {
	Profile = nil :: any,
	Party = nil :: any,
	Invites = {} :: { any },
	Match = nil :: any, -- { Key, Round, Tier, Phase, EndsAt, Members, Tutorial, Rocks, Remaining, MyCracked }
	Results = nil :: any,
	Teleport = false, -- true in the Match place of Teleport mode (set by the server)
	Changed = Instance.new("BindableEvent"), -- (what: "Profile" | "Party" | "Match" | "Results")
}

-- Call after changing a field so listeners refresh.
function State.update(what: string)
	State.Changed:Fire(what)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="337">
          <Properties>
            <string name="Name">StationView</string>
            <string name="Source"><![CDATA[--!strict
-- Crushing-table visuals (V3 loop), all cosmetic: the server owns every rock and every hit.
--
-- Fed by the authoritative station snapshots (`Stations` in Init and every `Rocks` batch) and the
-- ordered events (Deposit, Start, Hit, Done, Found). The snapshot is the truth: after the events of
-- a batch are played, every table is reconciled to it, so a missed event can only cost an animation.
--   * queued rocks sit on the input tray slots (slot 1 = next), the current rock on the plate;
--   * fracture progression from the server's Progress: intact -> hairline seams -> wider seams and
--     chips with the pieces drifting apart -> split into rubble that drops into the output tray;
--   * hand tools swing AT the plate (ToolAnim; the local avatar turns to face it), the jackhammer
--     vibrates the rock; machine rocks ride from the tray to the machine feed (MachineView animates
--     the machine itself from the same Start events);
--   * the geode rock opens slowly on the plate (hollow shell halves part, crystals and light inside).
-- Everything is anchored, non-colliding and bounded (rubble ring of 12, chips capped, one shared
-- animation scheduler), so a four-player round with four machines stays cheap.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PetFlair = require(Shared.PetFlair)
local PetMotionBridge = require(script.Parent.PetMotionBridge)
local GeodeModel = require(Shared.GeodeModel)
local KitModels = require(Shared.KitModels)
local Anim = require(script.Parent.Anim)
local State = require(script.Parent.State)
local ToolAnim = require(script.Parent.ToolAnim)
local Audio = require(script.Parent.Audio)
local CarryView = require(script.Parent.CarryView)
local HitFx = require(script.Parent.HitFx)
local TapCombo = require(script.Parent.TapCombo)

local StationView = {}

local player = Players.LocalPlayer
local TRAY_ROCK = 0.58 -- diameter of a queued rock (Part stand-in tray)
local TRAY_ROCK_KIT = 0.5 -- the kit input tray is 2.3 x 1.9 studs: ten smaller rocks fit
local PLATE_ROCK = 1.1 -- diameter of the rock on the plate
local RUBBLE_MAX = 12
local MAX_CHIPS = 24
local YELLOW = Config.Palette.Yellow

type Attached = { Part: BasePart, Rel: CFrame, Dir: Vector3, Tilt: Vector3, Color: Color3 }
type SV = {
	UserId: number,
	Index: number,
	Model: Model,
	Slots: { Vector3 }, -- world positions of tray slots 1..10
	PlatePos: Vector3,
	OutPos: CFrame,
	FeedPos: Vector3,
	Frame: CFrame, -- table frame (-Z toward the player)
	Tray: { [number]: Model },
	Busy: { [number]: number }, -- rock id -> os.clock() until which an animation owns its model
	PlateId: number?,
	Plate: Model?,
	Base: CFrame?, -- plate rock pivot at rest
	Parts: { Attached },
	Size: number,
	Progress: number,
	Seams: number,
	Cracks: HitFx.Cracks, -- shared crack-stage lines on the plate rock (HitFx)
	Spread: Vector2, -- rubble spread (x, z) around the output tray centre
	Rubble: { Model },
	NextRubble: number,
	Tool: string,
	Auto: boolean,
	LastHit: number,
	Geode: Model?,
	Halves: { Model },
	Light: PointLight?,
	FxT: number, -- time up to which scheduled plate animations are booked
	Pending: any?, -- snapshot waiting for those animations
}

local views: { [number]: SV } = {} -- by user id
local round = 0
local seed = 1
local folder: Folder? = nil
local chips = 0
local myIndex: number? = nil
local tableRefs: { [number]: Model } = {} -- station index -> table model
StationView.Latest = nil :: { [number]: any }?

local function trayRock(): number
	return if KitModels.template("Rock_01_Wedge") then TRAY_ROCK_KIT else TRAY_ROCK
end

local function settings(): any
	return State.Profile and State.Profile.Settings or {}
end

local function look(id: number): (number, number, number)
	return GeodeModel.rockLook(id, seed)
end

local function frameYaw(cf: CFrame): number
	local _, y = cf:ToEulerAnglesYXZ()
	return y
end

-- Finding the table models --------------------------------------------------------------------

local function findTable(index: number, pos: Vector3?): Model?
	local best: Model? = nil
	local bestD = math.huge
	for _, arena in Workspace:GetChildren() do
		if string.sub(arena.Name, 1, 15) == "CT_Rocks_Arena_" then
			local m = arena:FindFirstChild("CT_Rocks_Station_" .. index)
			if m and m:IsA("Model") and m.PrimaryPart then
				local d = if pos then (m.PrimaryPart.Position - pos).Magnitude else 0
				if d < bestD then
					best, bestD = m, d
				end
			end
		end
	end
	return best
end

local function attachPos(model: Model, partName: string, attName: string): Vector3?
	local p = model:FindFirstChild(partName)
	if p and p:IsA("BasePart") then
		local a = p:FindFirstChild(attName)
		if a and a:IsA("Attachment") then
			return p.CFrame:PointToWorldSpace(a.Position)
		end
	end
	return nil
end

local function ensureFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "CT_Rocks_StationFx"
	f.Parent = Workspace
	folder = f
	return f
end

-- Per-table geometry, read from the server's named parts.
local function buildView(st: any, tablePos: Vector3?): SV?
	local model = tableRefs[st.Index] or findTable(st.Index, tablePos)
	if not model or not model.PrimaryPart then
		return nil
	end
	tableRefs[st.Index] = model
	local surface = model.PrimaryPart :: BasePart
	-- frame: table floor origin, -Z toward the player
	local frame = surface.CFrame * CFrame.new(0, -2.75, 0)
	local slots: { Vector3 } = {}
	local slotCount = model:GetAttribute("SlotCount") -- bigger nests build more slots (StationModels)
	for i = 1, math.max(Config.Station.QueueCapacity, if type(slotCount) == "number" then slotCount else 0) do
		slots[i] = attachPos(model, "InputTray", "Slot" .. i) or frame:PointToWorldSpace(Vector3.new(2.4, 3.5, -1.2 + ((i - 1) // 2) * 0.6))
	end
	local out = model:FindFirstChild("OutputTray")
	local outCf = if out and out:IsA("BasePart") then out.CFrame else frame * CFrame.new(-2.4, 3.09, 0)
	return {
		UserId = st.UserId,
		Index = st.Index,
		Model = model,
		Slots = slots,
		PlatePos = attachPos(model, "Plate", "Plate") or frame:PointToWorldSpace(Vector3.new(0, 3.35, 0)),
		OutPos = outCf,
		FeedPos = attachPos(model, "Feed", "MachineFeed") or frame:PointToWorldSpace(Vector3.new(0, 2.6, 2.4)),
		Frame = frame,
		Tray = {},
		Busy = {},
		PlateId = nil,
		Plate = nil,
		Base = nil,
		Parts = {},
		Size = PLATE_ROCK,
		Progress = 0,
		Seams = 0,
		Cracks = HitFx.newCracks(),
		Spread = Vector2.new(if out then (out:GetAttribute("SpreadX") :: number?) or 0.6 else 0.6, if out then (out:GetAttribute("SpreadZ") :: number?) or 1.2 else 1.2),
		Rubble = {},
		NextRubble = 1,
		Tool = st.Tool or "Hammer",
		Auto = false,
		LastHit = 0,
		Geode = nil,
		Halves = {},
		Light = nil,
		FxT = 0,
		Pending = nil,
	}
end

-- Small helpers ---------------------------------------------------------------------------------

local function mini(id: number, size: number): Model
	local variant, tint, yaw = look(id)
	local m = GeodeModel.rockShell(variant, size, tostring(id), { Tint = tint, Mini = true })
	m:SetAttribute("Yaw", math.rad(yaw))
	return m
end

local function placeMini(m: Model, pos: Vector3, yawExtra: number?)
	local yaw = (m:GetAttribute("Yaw") or 0) :: number
	m:PivotTo(CFrame.new(pos) * CFrame.Angles(0, yaw + (yawExtra or 0), 0))
end

local function restY(m: Model): number
	local b = m.PrimaryPart
	return if b then b.Size.Y * 0.4 else 0.2
end

-- A few dull chips that burst out and fall (bounded, short lived).
local function burst(pos: Vector3, n: number, spread: number)
	if settings().LowEffects then
		n = math.max(1, n // 3)
	end
	local rng = Random.new(math.floor(os.clock() * 1000) % 100000)
	for _ = 1, n do
		if chips >= MAX_CHIPS then
			return
		end
		chips += 1
		local c = GeodeModel.grit(rng, 0.3)
		c.Parent = ensureFolder()
		local a = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(0.4, 1) * spread
		local goal = pos + Vector3.new(math.cos(a) * dist, -0.2, math.sin(a) * dist)
		local spin = rng:NextNumber(-4, 4)
		Anim.run(0.4, function(k)
			c.CFrame = CFrame.new(Anim.arc(pos, goal, 0.7, Anim.easeOut(k))) * CFrame.Angles(k * spin, k * spin * 0.7, 0)
			c.Transparency = k * k
		end, function()
			chips -= 1
			c:Destroy()
		end)
	end
end

-- Rubble in the output tray ---------------------------------------------------------------------

local function rubbleSpot(sv: SV, i: number): CFrame
	local rng = Random.new(i * 977 + sv.Index)
	local x = rng:NextNumber(-sv.Spread.X, sv.Spread.X)
	local z = rng:NextNumber(-sv.Spread.Y, sv.Spread.Y)
	local layer = (i - 1) // 6
	return sv.OutPos * CFrame.new(x, 0.3 + layer * 0.18, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
end

-- Material Discoveries: the finished rock's output chips are solid visual variants (the server told us the
-- material only after the crush completed). Quartz = pale solid chips; metal = bright specks on grey stone.
-- Common stone keeps the ordinary look. Looks only: same size, same rubble.
-- Shells keep the cracked egg's own pastel colour whatever the material (a grey Slate / Marble re-colour made the tray
-- read as trash, owner video): a speckled shell gets small brown flecks, a golden one small gold flecks.
local SPECKLE = Color3.fromRGB(176, 128, 96)
local function styleChip(m: Model, matId: string?)
	local mat = matId and Config.Materials[matId]
	if not mat or mat.Look == "stone" then
		return
	end
	local bounds = m.PrimaryPart
	if bounds then
		local golden = mat.Look == "specks"
		local rng = Random.new(#m.Name * 131 + math.floor(bounds.Size.X * 100))
		local at = m:GetPivot()
		for _ = 1, if golden then 4 else 5 do
			local p = Instance.new("Part")
			p.Name = "Speck"
			p.Shape = Enum.PartType.Ball
			p.Size = Vector3.one * rng:NextNumber(0.06, 0.1)
			p.Color = if golden then mat.Accent else SPECKLE
			p.Material = if golden then Enum.Material.Metal else Enum.Material.SmoothPlastic
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.CFrame = at * CFrame.new(rng:NextNumber(-0.4, 0.4) * bounds.Size.X, rng:NextNumber(-0.1, 0.35) * bounds.Size.Y, rng:NextNumber(-0.4, 0.4) * bounds.Size.Z)
			p.Parent = m
		end
	end
end

local function addRubble(sv: SV, from: Vector3?, color: number?, matId: string?)
	local i = sv.NextRubble
	sv.NextRubble = i % RUBBLE_MAX + 1
	local old = sv.Rubble[i]
	if old then
		-- the oldest shell shrinks away instead of vanishing
		if settings().ReducedMotion or not old.Parent then
			old:Destroy()
		else
			Anim.run(0.25, function(k)
				if old.Parent then
					Anim.scale(old, 1 - 0.95 * k)
				end
			end, function()
				old:Destroy()
			end)
		end
	end
	local rng = Random.new(i * 31 + round)
	local variant = ({ 2, 4, 12, 7, 11, 6 })[rng:NextInteger(1, 6)]
	local tintIdx = color or rng:NextInteger(1, 8)
	local m = GeodeModel.rubble(rng:NextNumber(0.5, 0.75), tintIdx, "rubble" .. i)
		or GeodeModel.rockShell(variant, rng:NextNumber(0.32, 0.46), "rubble", { Tint = tintIdx, Mini = true })
	m.Parent = ensureFolder()
	styleChip(m, matId)
	sv.Rubble[i] = m
	local goal = rubbleSpot(sv, i)
	if from then
		local start = from
		Anim.run(0.42, function(k)
			if m.Parent then
				m:PivotTo((goal - goal.Position) + Anim.arc(start, goal.Position, 1.2, Anim.easeOut(k)))
			end
		end)
	else
		m:PivotTo(goal)
	end
end

-- Fracture on the plate (crack lines come from HitFx; see seamParts) ---------------------------------------------------------------------------

-- Poses the plate rock and its seams for progress p (pieces drift apart as it breaks). `lean` (rotation only,
-- world axes) turns the whole egg about its foot on the plate: tap recoil and the settle roll.
local function pose(sv: SV, jitter: Vector3?, lean: CFrame?)
	local base = sv.Base
	if not base or not sv.Plate then
		return
	end
	local b = (base :: CFrame) + (jitter or Vector3.zero)
	if lean then
		local foot = Vector3.new(b.X, sv.PlatePos.Y, b.Z)
		b = CFrame.new(foot) * lean * CFrame.new(-foot) * b
	end
	local p = sv.Progress
	local D = sv.Size
	for _, a in sv.Parts do
		if a.Part.Parent then
			local drift = a.Dir * (p ^ 1.3 * 0.2 * D)
			local tilt = CFrame.Angles(a.Tilt.X * p, a.Tilt.Y * p, a.Tilt.Z * p)
			a.Part.CFrame = b * CFrame.new(drift) * a.Rel * tilt
			if a.Dir.Magnitude > 0 then
				a.Part.Color = a.Color:Lerp(Color3.fromRGB(60, 62, 66), p * 0.3)
			end
		end
	end
end

-- Kit rock stages (neutral dark ribbons, never a colour): hairline, then wide cracks, then the split
-- chunks replace the whole rock.
local function kitStage(sv: SV)
	local p = sv.Progress
	local stage = if p <= 0.001 then 0 elseif p < 0.5 then 1 elseif p < 0.85 then 2 else 3
	for _, a in sv.Parts do
		local n = a.Part.Name
		if n == "Rock" then
			a.Part.Transparency = if stage >= 3 then 1 else 0
		elseif n == "Hairline" or n == "Wide" then
			a.Part.Transparency = 1 -- the HitFx crack lines are the one crack look for every rock
		elseif n == "Chunk" then
			a.Part.Transparency = if stage >= 3 then 0 else 1
		end
	end
end

local function seamParts(sv: SV)
	local model = sv.Plate
	if not model or not sv.Base then
		return
	end
	local base = sv.Base :: CFrame
	local made = HitFx.setCracks(sv.Cracks, model, sv.Frame, base.Position, sv.Size, sv.Progress)
	for _, part in made do
		-- lines ride with the rock (jitter, vibration, drift)
		table.insert(sv.Parts, { Part = part :: BasePart, Rel = base:ToObjectSpace(part.CFrame), Dir = Vector3.zero, Tilt = Vector3.zero, Color = part.Color })
	end
	sv.Seams = sv.Cracks.Stage
	if model:GetAttribute("Kit") == true then
		kitStage(sv)
	end
end

local function clearPlate(sv: SV)
	if sv.Plate then
		sv.Plate:Destroy()
	end
	sv.Plate = nil
	sv.Base = nil
	table.clear(sv.Parts)
	sv.Seams = 0
	HitFx.clearCracks(sv.Cracks)
	sv.Progress = 0
end

local function showPlate(sv: SV, id: number, progress: number)
	clearPlate(sv)
	sv.PlateId = id
	local variant, tint, yaw = look(id)
	local m = GeodeModel.rockShell(variant, PLATE_ROCK, tostring(id), { Tint = tint, Mini = true, Cracks = true })
	m:SetAttribute("PlateEgg", true) -- HitFx takes its chip colour from this egg only
	m.Parent = ensureFolder()
	sv.Plate = m
	if sv.UserId == player.UserId and not settings().ReducedMotion then
		-- a soft pulsing glow on your own egg: it is ready to tap (dies with the model)
		local hl = Instance.new("Highlight")
		hl.Name = "ReadyGlow"
		hl.FillColor = Color3.fromRGB(255, 244, 200)
		hl.OutlineTransparency = 1
		hl.FillTransparency = 0.88
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = m
		game:GetService("TweenService"):Create(hl, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { FillTransparency = 0.7 }):Play()
	end
	local sit = restY(m)
	sv.Base = CFrame.new(sv.PlatePos + Vector3.new(0, sit, 0)) * CFrame.Angles(0, math.rad(yaw) + frameYaw(sv.Frame), 0)
	m:PivotTo(sv.Base :: CFrame)
	local rng = Random.new(id * 3 + 1)
	local kit = m:GetAttribute("Kit") == true
	for _, d in m:GetChildren() do
		if kit and d:IsA("BasePart") and (d.Name == "Hairline" or d.Name == "Wide" or d.Name == "Chunk") then
			-- kit crack ribbons ride with the rock; its split chunks drift apart once it breaks
			local rel = (sv.Base :: CFrame):ToObjectSpace(d.CFrame)
			local still = d.Name ~= "Chunk"
			local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0, 0.5), rng:NextNumber(-1, 1))
			table.insert(sv.Parts, {
				Part = d, Rel = rel, Dir = if still or dir.Magnitude < 0.05 then Vector3.zero else dir.Unit,
				Tilt = if still then Vector3.zero else Vector3.new(rng:NextNumber(-0.35, 0.35), rng:NextNumber(-0.25, 0.25), rng:NextNumber(-0.35, 0.35)), Color = d.Color,
			})
		elseif d:IsA("BasePart") and d.Name == "Rock" then
			local rel = (sv.Base :: CFrame):ToObjectSpace(d.CFrame)
			local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.2, 0.6), rng:NextNumber(-1, 1))
			table.insert(sv.Parts, {
				Part = d, Rel = rel, Dir = if dir.Magnitude > 0.05 then dir.Unit else Vector3.new(1, 0, 0),
				Tilt = Vector3.new(rng:NextNumber(-0.35, 0.35), rng:NextNumber(-0.25, 0.25), rng:NextNumber(-0.35, 0.35)), Color = d.Color,
			})
		end
	end
	-- the egg must show before its first crack: clear any leftover local fade and fetch its mesh now (a clone whose
	-- mesh had not downloaded yet drew nothing until the crack lines rebuilt it)
	local meshes: { Instance } = {}
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = 0
			if d:IsA("MeshPart") then
				table.insert(meshes, d)
			end
		end
	end
	if #meshes > 0 then
		task.spawn(function()
			pcall(function()
				game:GetService("ContentProvider"):PreloadAsync(meshes)
			end)
		end)
	end
	-- the first piece stays put; the others drift
	if sv.Parts[1] then
		sv.Parts[1].Dir = Vector3.new(0, 0, 0)
		sv.Parts[1].Tilt = Vector3.zero
	end
	sv.Progress = progress
	seamParts(sv)
	pose(sv)
end

-- The egg rolls into place on the plate: a decaying spin plus a small rocking roll, then rest (same for every egg).
-- A tap during it wins (impact poses the egg from then on).
local function settleIn(sv: SV)
	local m = sv.Plate
	if not m or settings().ReducedMotion then
		return
	end
	local t0 = os.clock()
	local side = sv.Frame:VectorToWorldSpace(Vector3.xAxis)
	Anim.run(0.42, function(k)
		if sv.Plate ~= m or sv.LastHit > t0 then
			return
		end
		local spin = -0.9 * (1 - Anim.easeOut(k))
		local roll = math.sin(k * math.pi * 2.5) * 0.2 * (1 - k)
		pose(sv, nil, CFrame.fromAxisAngle(Vector3.yAxis, spin) * CFrame.fromAxisAngle(side, roll))
	end, function()
		if sv.Plate == m and sv.LastHit <= t0 then
			pose(sv)
		end
	end)
	HitFx.nest(sv.PlatePos + Vector3.new(0, 0.15, 0), true)
end

local function setProgress(sv: SV, p: number)
	p = math.clamp(p, 0, 1)
	if p < sv.Progress - 1e-4 then
		return -- progress never goes backward on one rock
	end
	local before = sv.Seams
	sv.Progress = p
	seamParts(sv)
	pose(sv)
	local _ = before
	-- every egg warms up the same way as it nears the end (no hint which one hides the pet)
	local plate = sv.Plate
	local core = plate and (plate.PrimaryPart or plate:FindFirstChildWhichIsA("BasePart", true))
	if core then
		local glow = core:FindFirstChild("HatchGlow")
		if p > 0.6 and not settings().ReducedMotion then
			local light: PointLight
			if glow and glow:IsA("PointLight") then
				light = glow
			else
				light = Instance.new("PointLight")
				light.Name = "HatchGlow"
				light.Color = Color3.fromRGB(255, 232, 170)
				light.Range = 9
				light.Parent = core
			end
			light.Brightness = 2.5 * ((p - 0.6) / 0.4) ^ 2
		elseif glow then
			glow:Destroy()
		end
	end
end

-- Where the tool meets the rock: upper front face for hammers, the top for the jackhammer bit.
local function contactPoint(sv: SV): Vector3
	local c = if sv.Base then (sv.Base :: CFrame).Position else sv.PlatePos + Vector3.new(0, 0.55, 0)
	local D = sv.Size
	if sv.Tool == "Jackhammer" then
		return c + Vector3.new(0, 0.42 * D, 0)
	end
	return c + sv.Frame:VectorToWorldSpace(Vector3.new(0, 0.3, -0.5)) * D
end

local function impact(sv: SV)
	sv.LastHit = os.clock()
	Audio.strike(sv.Tool == "Jackhammer", sv.PlatePos)
	if not sv.Plate then
		return
	end
	if sv.Tool == "Jackhammer" then
		HitFx.dust(contactPoint(sv))
		return -- the vibration loop below shakes it
	end
	-- dip and squash in fast, hold a beat at the bottom (a tiny hit-stop), then spring back; meanwhile the egg
	-- tips away from the tap and springs back upright with a small overshoot
	local m = sv.Plate :: Model
	local base = m:GetAttribute("BaseScale") :: number?
	if not base then
		base = m:GetScale()
		m:SetAttribute("BaseScale", base)
	end
	local s0 = base :: number
	local squash = if sv.Tool == "SteelHammer" then 0.12 else 0.09
	local away = sv.Frame:VectorToWorldSpace(Vector3.zAxis) -- the tap lands on the front (-Z) face
	local axis = Vector3.yAxis:Cross(Vector3.new(away.X, 0, away.Z).Unit)
	local lean = if sv.Tool == "SteelHammer" then 0.2 else 0.15
	local lastD = -1
	Anim.run(0.45, function(k)
		local ks = math.min(1, k / 0.44) -- the squash keeps its 0.2 s timing
		local d = if ks < 0.2 then ks / 0.2 elseif ks < 0.45 then 1 else 1 - Anim.easeOut((ks - 0.45) / 0.55)
		if m.Parent and d ~= lastD then
			lastD = d
			m:ScaleTo(s0 * (1 - squash * d))
		end
		local x = (k - 0.15) / 0.85
		local a = if k < 0.15 then math.sin(k / 0.15 * math.pi / 2) else math.cos(x * math.pi * 1.5) * (1 - x)
		pose(sv, Vector3.new(0, -0.1 * d, 0), CFrame.fromAxisAngle(axis, lean * a))
	end, function()
		if m.Parent then
			m:ScaleTo(s0)
			pose(sv)
		end
	end)
	HitFx.contact(contactPoint(sv), sv.Tool == "SteelHammer")
end

-- Ordinary rock finished: it splits and its chunks drop into the output tray.
local function splitOrdinary(sv: SV, pos: Vector3?, matId: string?)
	local at = pos or (sv.PlatePos + Vector3.new(0, 0.7, 0))
	local colorIdx = if sv.PlateId then select(2, look(sv.PlateId)) else nil
	clearPlate(sv)
	sv.PlateId = nil
	Audio.rockCracked(at)
	HitFx.split(at)
	HitFx.poof(at) -- empty egg: a little cloud
	if sv.UserId == player.UserId then
		HitFx.bump(0.18) -- last tap: a small screen bump on the own nest only
	end
	for _ = 1, 3 do
		addRubble(sv, at + Vector3.new(0, 0.2, 0), colorIdx, matId)
	end
end

-- Geode ------------------------------------------------------------------------------------------

local function destroyGeode(sv: SV)
	if sv.Geode then
		sv.Geode:Destroy()
	end
	sv.Geode = nil
	for _, h in sv.Halves do
		h:Destroy()
	end
	table.clear(sv.Halves)
	if sv.Light and sv.Light.Parent then
		sv.Light.Parent:Destroy() -- (usually already gone with the geode)
	end
	sv.Light = nil
end

local function buildGeode(sv: SV, spec: { [string]: any })
	destroyGeode(sv)
	local s = 0.72
	local R = 1.25 * s
	local frame = CFrame.new(sv.PlatePos) * CFrame.Angles(0, frameYaw(sv.Frame), 0)
	local geode = GeodeModel.build(spec, { Scale = s })
	geode:PivotTo(frame)
	geode.Parent = ensureFolder()
	sv.Geode = geode
	local cy = (geode:GetAttribute("CentreY") :: number?) or (R + 0.05 * s) -- hinge and glow sit at the shell centre
	local halves = GeodeModel.frontHalves(spec, s)
	for _, h in halves do
		h:PivotTo(frame * CFrame.new(0, cy, 0))
		h.Parent = ensureFolder()
		table.insert(sv.Halves, h)
	end
	local lightPart = Instance.new("Part")
	lightPart.Name = "GeodeGlow"
	lightPart.Transparency = 1
	lightPart.Anchored = true
	lightPart.CanCollide = false
	lightPart.CanQuery = false
	lightPart.Size = Vector3.one * 0.2
	lightPart.CFrame = frame * CFrame.new(0, cy, R * 0.4)
	lightPart.Parent = geode
	local pl = Instance.new("PointLight")
	pl.Range = 9
	pl.Brightness = 0
	local mineral = Config.Minerals[spec.Mineral] or Config.Minerals.Raptor
	pl.Color = mineral.Crystal
	pl.Parent = lightPart
	sv.Light = pl
	return halves, frame, R, s
end

-- The geode rock was finished: the plate rock splits open slowly, shell halves part, the cavity lights.
local function openGeode(sv: SV)
	clearPlate(sv)
	sv.PlateId = nil
	-- The real pet is not known yet (the server sends it with the reveal), so the stand-in is built hidden: only the
	-- egg halves and the glow show until showSpecimen swaps in the pet that actually hatched.
	local spec = { Mineral = Config.Pets.Starter, Formation = "Cluster", Modifier = "Natural", Mass = 1.2, Seed = round * 17 + sv.Index }
	local halves, frame, R, s = buildGeode(sv, spec)
	if not halves then
		return
	end
	if sv.Geode then
		for _, d in sv.Geode:GetDescendants() do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 1
			elseif d:IsA("ParticleEmitter") then
				d.Enabled = false
			elseif d:IsA("Beam") then
				d.Enabled = false
			elseif d:IsA("BillboardGui") then
				d.Enabled = false
			elseif d:IsA("Light") and d ~= sv.Light then
				d.Enabled = false
			end
		end
	end
	Audio.rockCracked(sv.PlatePos)
	burst(sv.PlatePos + Vector3.new(0, 1, 0), 8, 1.4)
	if sv.UserId == player.UserId then
		HitFx.bump(0.3) -- the winning tap lands a little harder
	end
	local centre = CFrame.new(0, (sv.Geode and sv.Geode:GetAttribute("CentreY") :: number?) or (R + 0.05 * s), 0)
	Anim.run(1.8, function(k)
		local e = Anim.easeInOut(k)
		local shake = if k < 0.25 then math.sin(k * 90) * 0.04 * (1 - k * 4) else 0
		for i, h in halves do
			local side = if i == 1 then -1 else 1
			if h.Parent then
				h:PivotTo(frame * centre * CFrame.new(side * e * R * 1.05 + shake, e * R * 0.12, -e * R * 0.55) * CFrame.Angles(0, side * e * math.rad(70), side * e * math.rad(14)))
			end
		end
		if sv.Light then
			sv.Light.Brightness = 3.5 * e
		end
	end)
end

-- Reveal arrived with the real specimen: rebuild the opened geode from it (halves stay open).
function StationView.showSpecimen(uid: number, spec: { [string]: any })
	local sv = views[uid]
	if not sv or not sv.Geode or type(spec) ~= "table" or not spec.Mineral then
		return
	end
	local old = sv.Halves
	local pose0: { CFrame } = {}
	for i, h in old do
		pose0[i] = h:GetPivot()
	end
	local halves = buildGeode(sv, spec)
	if halves then
		for i, h in halves do
			if pose0[i] then
				h:PivotTo(pose0[i])
			end
		end
		if sv.Geode then
			-- the real mesh pet (ReplicatedStorage.PetModels, via PetModel.template) plays its hatch animation;
			-- a procedural stand-in or a missing PetMotion just stays as it is
			PetMotionBridge.hatch(sv.Geode)
		end
		if sv.Light then
			sv.Light.Brightness = 3.5
			if PetFlair.hatchTiming(spec.Rarity).Glow then
				-- Rare+: the nest glows in the rarity colour while the slow-motion reveal plays
				local rc = (Config.RarityColors :: any)[spec.Rarity]
				if rc then
					sv.Light.Color = rc
				end
				sv.Light.Brightness = 6
				sv.Light.Range = 14
			end
		end
	end
end

-- Reconcile with the server's snapshot -------------------------------------------------------------

-- Own nest: a small "N waiting" tag by the tray while eggs queue up.
local countParts: { [number]: Part } = {}

local function waitingTag(sv: SV, n: number)
	if sv.UserId ~= player.UserId then
		return
	end
	local old = countParts[sv.UserId]
	if n <= 0 then
		if old then
			old:Destroy()
			countParts[sv.UserId] = nil
		end
		return
	end
	local p: Part
	if old and old.Parent then
		p = old
	else
		p = Instance.new("Part")
		p.Name = "WaitingTag"
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Transparency = 1
		p.Size = Vector3.one
		p.Position = (sv.Slots[1] or sv.PlatePos) + Vector3.new(0, 1.1, 0)
		-- a world tag, not a HUD piece: the nest and eggs hide it (AlwaysOnTop drew it through everything, and from the
		-- work spot it peeked out round the objective banner), and it only shows from near the nest
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(80, 22)
		gui.AlwaysOnTop = false
		gui.LightInfluence = 0
		gui.MaxDistance = 30
		gui.Enabled = false -- switched on below once its spot is on screen
		gui.Adornee = p
		gui.Parent = p
		local l = Instance.new("TextLabel")
		l.Name = "Count"
		l.BackgroundColor3 = Color3.fromRGB(32, 34, 38)
		l.BackgroundTransparency = 0.25
		l.TextColor3 = Color3.fromRGB(255, 212, 80)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Size = UDim2.fromScale(1, 1)
		l.Parent = gui
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 8)
		c.Parent = l
		p.Parent = ensureFolder()
		countParts[sv.UserId] = p
		-- only while the tray is really in view and near: a billboard whose spot is behind the camera or off screen
		-- was drawn in the top left corner over Roblox's buttons on phones, so it is switched off there
		local conn: RBXScriptConnection? = nil
		conn = RunService.RenderStepped:Connect(function()
			if not p.Parent then
				if conn then
					conn:Disconnect()
				end
				return
			end
			local cam = Workspace.CurrentCamera
			local on = false
			if cam then
				local vp = cam.ViewportSize
				local pt, inView = cam:WorldToViewportPoint(p.Position)
				on = inView and pt.Z > 0 and pt.Z < gui.MaxDistance and pt.X > 0 and pt.X < vp.X and pt.Y > vp.Y * 0.15 and pt.Y < vp.Y
			end
			if gui.Enabled ~= on then
				gui.Enabled = on
			end
		end)
	end
	local l = p:FindFirstChild("Count", true)
	if l and l:IsA("TextLabel") then
		l.Text = n .. " waiting"
	end
end

local function reconcile(sv: SV, st: any)
	waitingTag(sv, #(st.Queue or {}))
	sv.Tool = st.Tool or sv.Tool
	sv.Auto = st.Machine ~= nil and st.State ~= "Paused"
	local now = os.clock()
	-- tray
	local want: { [number]: number } = {}
	for i, id in st.Queue or {} do
		if i <= #sv.Slots then
			want[id] = i
		end
	end
	for id, m in sv.Tray do
		if want[id] == nil and (sv.Busy[id] or 0) <= now then
			m:Destroy()
			sv.Tray[id] = nil
		end
	end
	for id, i in want do
		local m = sv.Tray[id]
		local target = sv.Slots[i] + Vector3.new(0, -0.12, 0)
		if not m then
			local fresh = mini(id, trayRock())
			fresh.Parent = ensureFolder()
			sv.Tray[id] = fresh
			placeMini(fresh, target)
		elseif (sv.Busy[id] or 0) <= now then
			local cur = m:GetPivot().Position
			if (cur - target).Magnitude > 0.05 then
				local from = cur
				local mm = m
				Anim.run(0.18, function(k)
					if mm.Parent then
						placeMini(mm, from:Lerp(target, Anim.easeOut(k)))
					end
				end)
			end
		end
	end
	-- plate (hand-tool station only; machine rocks ride the machine)
	local cur = st.Current
	if cur and not sv.Auto then
		if sv.PlateId ~= cur or not sv.Plate then
			if (sv.Busy[cur] or 0) <= now then
				if not sv.Geode then
					showPlate(sv, cur, st.Progress or 0)
				end
			end
		else
			setProgress(sv, st.Progress or sv.Progress)
		end
	elseif not cur and sv.Plate and (sv.Busy[sv.PlateId or 0] or 0) <= now then
		clearPlate(sv)
		sv.PlateId = nil
	end
end

local function nameplate(sv: SV, mine: boolean)
	local plate = sv.Model:FindFirstChild("Nameplate")
	if not plate or not plate:IsA("BasePart") then
		return
	end
	local label = plate:FindFirstChild("Name", true)
	if mine then
		plate.Color = YELLOW
		if label and label:IsA("TextLabel") then
			label.BackgroundColor3 = YELLOW
			label.TextColor3 = Color3.fromRGB(32, 34, 38)
		end
	end
	local strip = sv.Model:FindFirstChild("ColorStrip")
	if strip and strip:IsA("BasePart") and mine then
		strip.Color = YELLOW
	end
	if mine then
		for _, d in sv.Model:GetChildren() do
			if d:IsA("BasePart") and d:GetAttribute("AccentSlot") == true then
				d.Color = YELLOW -- kit tables: the Accent pieces carry the owner colour
			end
		end
	end
end

-- First-person work tool (Master Prompt 7). In first person the avatar's own third-person stroke raises the right
-- forearm about two studs in front of the eye, where it covers a third of the screen (docs/m7/quarry). So in first
-- person the local stroke is shown by a LOCAL copy of the held tool that swings from the player's right onto the rock
-- on the plate (contact at 0.3 s, when the crack shows), the real held tool is hidden locally for the stroke and the
-- arm stays at rest. Other players are unaffected: their clients play the full third-person swing from the Hit event.
-- The stroke copy leaves right after its recoil (a hammer stroke is 0.6 s; the tapper buzzes every 0.2 s): left at the
-- ready it hung in the air over the nest with no hand on it (owner video). Between strokes no first-person copy shows
-- (a resting copy at the lower right also floated with no hand on it, so it was removed).
local FP_LINGER = 0.65
local FP_LINGER_TAPPER = 0.4
local fp = { Tool = nil :: Model?, Len = 2, Kind = "Hammer", Start = 0, Until = 0, Conn = nil :: RBXScriptConnection?, Hidden = {} :: { [BasePart]: number } }

local function firstPerson(): boolean
	return player.CameraMode == Enum.CameraMode.LockFirstPerson
end

local function hideHeld(char: Model?, on: boolean)
	if on then
		local tool = char and char:FindFirstChild("CT_Rocks_HeldTool")
		if tool then
			for _, d in tool:GetDescendants() do
				if d:IsA("BasePart") and fp.Hidden[d] == nil then
					fp.Hidden[d] = d.Transparency
					d.Transparency = 1
				end
			end
		end
	else
		for p, t in fp.Hidden do
			if p.Parent then
				p.Transparency = t
			end
		end
		table.clear(fp.Hidden)
	end
end

local function fpClear()
	if fp.Conn then
		fp.Conn:Disconnect()
		fp.Conn = nil
	end
	if fp.Tool then
		fp.Tool:Destroy()
		fp.Tool = nil
	end
	hideHeld(nil, false)
end

-- A visual-only copy of the held tool (no joints, anchored, ignored by everything).
local function fpBuild(char: Model): Model?
	local src = char:FindFirstChild("CT_Rocks_HeldTool")
	if not src or not src:IsA("Model") then
		return nil
	end
	local m = src:Clone()
	for _, d in m:GetDescendants() do
		if d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Attachment") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
			d.LocalTransparencyModifier = 0
		end
	end
	m.Name = "CT_Rocks_FpTool"
	pcall(function()
		m:ScaleTo(m:GetScale() * 0.7) -- close to the eye a full-size head and handle read huge
	end)
	m.Parent = ensureFolder()
	fp.Len = math.max(m:GetExtentsSize().Y, 1)
	return m
end

-- Hammer angle (degrees above the contact pose) at time t of a stroke: wind-up, strike, recoil, ready.
local function fpAngle(t: number): number
	if t < 0.24 then
		local k = t / 0.24
		return 25 + 40 * (1 - (1 - k) ^ 2)
	elseif t < 0.3 then
		local k = (t - 0.24) / 0.06
		return 65 * (1 - k * k)
	elseif t < 0.35 then
		return 0 -- hit-stop: the head rests on the egg for a beat
	elseif t < 0.45 then
		return 12 * math.sin((t - 0.35) / 0.1 * math.pi / 2)
	elseif t < 0.6 then
		return 12 + 13 * (t - 0.45) / 0.15
	end
	return 25
end

local function fpPose(sv: SV, now: number)
	local tool, cam = fp.Tool, Workspace.CurrentCamera
	if not tool or not cam then
		return
	end
	local U = Vector3.yAxis
	local look = cam.CFrame.LookVector
	local F = Vector3.new(look.X, 0, look.Z)
	F = if F.Magnitude > 1e-3 then F.Unit else Vector3.new(0, 0, -1)
	local R = F:Cross(U).Unit
	-- the strike lands on the rock's upper front face (toward the player), so contact sits in the middle of the view
	local top = sv.PlatePos + U * (sv.Size * 0.62) - F * (sv.Size * 0.3)
	if fp.Kind == "Jackhammer" then
		-- leaning in from the right, bit on the rock, buzzing while hits come in (never across the screen centre)
		local h = (U * 0.55 + R * 0.55 - F * 0.45).Unit
		local buzz = if now < fp.Start + 0.35 then (if (now * 60) % 2 < 1 then 0.05 else -0.05) else 0
		local pos = top + h * (fp.Len * 0.92 + buzz)
		local X = h:Cross(F).Unit
		tool:PivotTo(CFrame.fromMatrix(pos, X, h))
		return
	end
	local h0 = (-R * 0.5 + F * 0.8 + U * 0.22).Unit -- grip -> head at contact: the grip is low and near, to the player's right
	local reach = fp.Len * 0.85
	local st = now - fp.Start
	local hit = (st - 0.29) / 0.15 -- the head squashes a bit on the egg (contact + hit-stop)
	ToolAnim.squash(tool, if hit < 0 or hit > 1 or settings().ReducedMotion == true then 0 else 0.13 * math.sin(hit * math.pi))
	local a = math.rad(fpAngle(st))
	local h = (h0 * math.cos(a) + U * math.sin(a)).Unit
	local grip = top + U * 0.1 - h0 * reach + U * (0.3 * math.sin(a))
	local X = h:Cross(F).Unit
	if X.Y > 0 then
		X = -X
	end
	tool:PivotTo(CFrame.fromMatrix(grip, X, h))
end

local function fpSwing(sv: SV, char: Model)
	if not fp.Tool or not fp.Tool.Parent then
		fp.Tool = fpBuild(char)
		if not fp.Tool then
			return
		end
	end
	hideHeld(char, true)
	local now = os.clock()
	fp.Kind = sv.Tool
	local linger = if fp.Kind == "Jackhammer" then FP_LINGER_TAPPER else FP_LINGER
	if fp.Kind ~= "Jackhammer" and now - fp.Start < 0.55 then
		fp.Until = fp.Start + 0.55 + linger -- still swinging; the server cadence is what counts
		return
	end
	fp.Start = if settings().ReducedMotion == true then now - 0.3 else now
	fp.Until = now + linger
	fpPose(sv, now)
	if fp.Conn then
		return -- the running pose loop picks up the new stroke
	end
	fp.Conn = RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local cur = views[player.UserId]
		if t > fp.Until or not cur or not firstPerson() then
			fpClear()
			return
		end
		fpPose(cur, t)
	end)
end

-- Public API ------------------------------------------------------------------------------------------

-- True while the local first-person stroke copy of the tool is on screen.
function StationView.strokeActive(): boolean
	return fp.Tool ~= nil
end

function StationView.clear()
	fpClear()
	HitFx.clear()
	TapCombo.clear()
	for _, sv in views do
		destroyGeode(sv)
	end
	table.clear(views)
	table.clear(tableRefs)
	table.clear(countParts)
	if folder then
		folder:Destroy()
	end
	folder = nil
	chips = 0
	myIndex = nil
	StationView.Latest = nil
end

function StationView.init(payload: any)
	StationView.clear()
	round = payload.Round or 0
	seed = payload.Seed or 1
	local tp: { [number]: Vector3 } = {}
	for _, t in payload.Tables or {} do
		if t.Position then
			tp[t.Index] = t.Position
		end
	end
	local latest: { [number]: any } = {} -- newest snapshot per user (for tables that were not streamed in yet)
	local function attempt(st: any)
		if views[st.UserId] then
			return
		end
		local sv = buildView(st, tp[st.Index])
		if sv then
			views[st.UserId] = sv
			if st.UserId == player.UserId then
				myIndex = st.Index
			end
			nameplate(sv, st.UserId == player.UserId)
			reconcile(sv, latest[st.UserId] or st)
		end
	end
	local missing = false
	for _, st in payload.Stations or {} do
		latest[st.UserId] = st
		attempt(st)
		missing = missing or views[st.UserId] == nil
	end
	StationView.Latest = latest
	if missing then
		-- the arena may still be replicating to this client (or, with StreamingEnabled, a far table streams in only
		-- when the player gets near): retry every 0.5 s at first, then every 2 s for the rest of the round
		local r = round
		task.spawn(function()
			local tries = 0
			while true do
				tries += 1
				task.wait(if tries <= 20 then 0.5 else 2)
				if round ~= r or StationView.Latest ~= latest then
					return
				end
				local still = false
				for uid, st in latest do
					attempt(st)
					still = still or views[uid] == nil
				end
				if not still then
					return
				end
			end
		end)
	end
end

-- Books a plate animation after the ones already booked for this table, so a batch like
-- Start / Hit / Done plays as one readable sequence (swing, crack, split) instead of at once.
local function sched(sv: SV, gap: number, fn: () -> (), dur: number?)
	local now = os.clock()
	local reduced = settings().ReducedMotion == true
	local t = math.max(now, sv.FxT) + (if reduced then 0 else gap)
	sv.FxT = t + (if reduced then 0 else (dur or 0))
	local function run()
		if views[sv.UserId] == sv then -- the round may have ended meanwhile
			fn()
		end
	end
	if t - now <= 0.001 then
		run()
	else
		task.delay(t - now, run)
	end
end

function StationView.onStations(stations: { any }?)
	for _, st in (stations or ({} :: { any })) do
		local keep = StationView.Latest
		if keep then
			keep[st.UserId] = st
		end
		local sv = views[st.UserId]
		if sv then
			if sv.FxT > os.clock() then
				-- animations are still booked: reconcile right after them
				local first = sv.Pending == nil
				sv.Pending = st
				if first then
					sched(sv, 0.02, function()
						local pend = sv.Pending
						sv.Pending = nil
						if pend and views[st.UserId] == sv then
							reconcile(sv, pend)
						end
					end)
				end
			else
				reconcile(sv, st)
			end
		end
	end
end

local function basketFrom(uid: number, fallback: Vector3): Vector3
	return CarryView.basketPoint(uid) or fallback
end

-- One ordered event from a "Rocks" batch (the snapshot follows it).
function StationView.onEvent(e: any, stations: { any }?)
	local sv = views[e.UserId]
	if not sv then
		return
	end
	local now = os.clock()
	if e.Kind == "Deposit" then
		for n, id in e.Ids or {} do
			local want = nil
			for _, st in (stations or ({} :: { any })) do
				if st.UserId == e.UserId then
					for i, q in st.Queue do
						if q == id then
							want = i
						end
					end
				end
			end
			local slot = want and sv.Slots[want]
			if slot and not sv.Tray[id] then
				local m = mini(id, trayRock())
				m.Parent = ensureFolder()
				sv.Tray[id] = m
				sv.Busy[id] = now + 0.12 * (n - 1) + 0.4
				local from = basketFrom(e.UserId, slot + Vector3.new(0, 2, 0))
				local target = slot + Vector3.new(0, -0.12, 0)
				local delay = 0.08 * (n - 1)
				placeMini(m, from)
				task.delay(delay, function()
					Anim.run(0.32, function(k)
						if m.Parent then
							placeMini(m, Anim.arc(from, target, 1.4, Anim.easeOut(k)), k * 3)
						end
					end, function()
						if m.Parent then
							HitFx.nest(target, false) -- straw puffs where it lands
						end
					end)
				end)
			end
		end
		return
	end
	local jack = sv.Tool == "Jackhammer"
	local lag = sv.FxT - now
	local fast = lag > 0.5 -- far behind (jackhammer on one-hit rocks): skip the long flourishes
	if e.Kind == "Start" then
		local id = e.Id
		if e.Duration then
			-- machine rock: rides from the tray to the machine feed
			sv.Busy[id] = now + 0.6
			local m = sv.Tray[id]
			if m then
				local from = m:GetPivot().Position
				Anim.run(0.4, function(k)
					if m.Parent then
						placeMini(m, Anim.arc(from, sv.FeedPos, 0.8, Anim.easeInOut(k)))
						Anim.scale(m, 1 - 0.6 * k)
					end
				end, function()
					m:Destroy()
					if sv.Tray[id] == m then
						sv.Tray[id] = nil
					end
				end)
			end
			return
		end
		if sv.Geode then
			return
		end
		sv.Busy[id] = now + 1.2
		sched(sv, 0, function()
			if sv.Geode or not views[e.UserId] then
				return
			end
			sv.PlateId = id
			local m = sv.Tray[id]
			if m and not fast then
				local from = m:GetPivot().Position
				local to = sv.PlatePos + Vector3.new(0, 0.6, 0)
				Anim.run(0.24, function(k)
					if m.Parent then
						placeMini(m, Anim.arc(from, to, 0.9, Anim.easeOut(k)), k * 2.5) -- rolls in with a little spin
						Anim.scale(m, 1 + (PLATE_ROCK / trayRock() - 1) * k)
					end
				end, function()
					m:Destroy()
					if sv.Tray[id] == m then
						sv.Tray[id] = nil
					end
					if sv.PlateId == id and not sv.Plate and not sv.Geode then
						showPlate(sv, id, 0)
						settleIn(sv)
					end
				end)
			else
				if m then
					m:Destroy()
					sv.Tray[id] = nil
				end
				showPlate(sv, id, 0)
			end
		end, if fast then 0.02 else 0.26)
	elseif e.Kind == "Hit" then
		if e.UserId ~= player.UserId then
			local pl = Players:GetPlayerByUserId(e.UserId)
			local c = pl and pl.Character
			if c then
				ToolAnim.strike(c, sv.Tool, settings().ReducedMotion == true, nil)
			end
		end
		-- the tool lands about 0.3 s after the swing starts: show the crack then
		sched(sv, if jack or fast then 0 else 0.3, function()
			if sv.Geode then
				return
			end
			if not sv.Plate or sv.PlateId ~= e.Id then
				showPlate(sv, e.Id, 0)
			end
			setProgress(sv, e.Progress or sv.Progress)
			impact(sv)
			if e.UserId == player.UserId and not jack then
				TapCombo.hit(sv.PlatePos)
			end
		end, 0.02)
	elseif e.Kind == "Done" then
		sched(sv, 0, function()
			if sv.Auto then
				-- machine rock: the machine view animates it; the tray just gets rubble
				addRubble(sv, nil, nil, e.Mat)
				return
			end
			if not sv.Plate then
				showPlate(sv, e.Id, 0)
			end
			local from = sv.Progress
			if from < 0.95 and not jack and not fast then
				-- a one-hit rock still shows its crack before it splits
				Anim.run(0.26, function(k)
					if sv.Plate then
						setProgress(sv, from + (1 - from) * k)
					end
				end, function()
					splitOrdinary(sv, nil, e.Mat)
				end)
			else
				splitOrdinary(sv, nil, e.Mat)
			end
		end, if jack or fast then 0.02 else 0.3)
	elseif e.Kind == "Found" then
		sched(sv, 0, function()
			openGeode(sv)
		end, 0)
	end
end

-- Crack edges glow softly between taps: off right after a hit, then a slow warm pulse (~1.4 s). Same on
-- every egg; skipped with Low Effects.
local function pulseCracks(sv: SV, now: number, low: boolean)
	local idle = now - sv.LastHit
	if low or not sv.Plate or sv.Seams <= 0 or idle < 0.35 then
		HitFx.glowCracks(sv.Cracks, 0)
		return
	end
	local ramp = math.min(1, (idle - 0.35) / 0.5)
	HitFx.glowCracks(sv.Cracks, ramp * (0.25 + 0.75 * (0.5 - 0.5 * math.cos(now * math.pi * 2 / 1.4))))
end

-- Jackhammer vibration over the plate while hits keep coming (every frame, from PileView); also the crack pulse.
function StationView.vibrate()
	local now = os.clock()
	local low = settings().LowEffects == true
	for _, sv in views do
		pulseCracks(sv, now, low)
		if sv.Plate and sv.Tool == "Jackhammer" and now - sv.LastHit < 0.3 then
			local k = (now * 60) % 2 < 1
			pose(sv, Vector3.new(if k then 0.06 else -0.06, if k then 0.03 else -0.03, 0))
			HitFx.dust(contactPoint(sv))
		end
	end
end

-- The local avatar swings its hammer at the plate (called when a Crush is sent).
function StationView.localSwing()
	local sv = views[player.UserId]
	local char = player.Character
	if not sv or not char then
		return
	end
	if firstPerson() then
		fpSwing(sv, char)
		return
	end
	ToolAnim.face(char, sv.PlatePos)
	ToolAnim.strike(char, sv.Tool, settings().ReducedMotion == true, nil)
end

-- True when `inst` is part of the egg on the LOCAL player's nest plate (tap-to-crack in PileView).
function StationView.isOwnPlatePart(inst: Instance?): boolean
	local sv = views[player.UserId]
	local plate = sv and sv.Plate
	return inst ~= nil and plate ~= nil and inst:IsDescendantOf(plate)
end

-- The local player's plate egg model, or nil (raycast include list for tap-to-crack).
function StationView.ownPlate(): Model?
	local sv = views[player.UserId]
	return sv and sv.Plate
end

-- Seconds of booked plate animation still to play (the reveal screen waits for the geode to open).
function StationView.fxRemaining(): number
	local worst = 0
	local now = os.clock()
	for _, sv in views do
		worst = math.max(worst, sv.FxT - now)
	end
	return worst
end

function StationView.platePosition(uid: number): Vector3?
	local sv = views[uid]
	return if sv then sv.PlatePos else nil
end

function StationView.tablePosition(uid: number): Vector3?
	local sv = views[uid]
	return if sv then sv.Frame.Position else nil
end

function StationView.myIndex(): number?
	return myIndex
end

-- Where the reticle aims to work at a nest: the egg on its plate (the old aim point was the table top, so the ring
-- opened on the nest below the egg).
function StationView.aimPoint(uid: number): Vector3?
	local sv = views[uid]
	return if sv then sv.PlatePos + Vector3.new(0, sv.Size * 0.5, 0) else nil
end

function StationView.ownModel(): Model?
	local sv = views[player.UserId]
	return if sv then sv.Model else nil
end

return StationView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="338">
          <Properties>
            <string name="Name">SurprisePop</string>
            <string name="Source"><![CDATA[--!strict
-- Surprise eggs (owner pick 2026-10-15, shared/HuntFun.Surprise): the server pays a small prize for every ordinary egg
-- a player finishes and tells only that player (MatchEvent "Surprise" { Round, List = { { Kind, Amount } }, Meter,
-- MeterNeed }). This draws it: a short screen pop right of centre ("+4 coins", "+3 pet XP", "Lucky Meter 12/30") at
-- HuntFun.PopSpots, and a JACKPOT banner with a coin flight for the rare jackpot. Purely visual; the prize is already
-- paid when the event arrives.

local Audio = require(script.Parent.Audio)
local Juice = require(script.Parent.ui.Juice)
local UI = require(script.Parent.ui.UI)
local HuntFun = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("HuntFun"))

local SurprisePop = {}

local GOLD = Color3.fromRGB(255, 212, 80)
local XP = Color3.fromRGB(120, 220, 255)
local METER = Color3.fromRGB(190, 140, 255)

local count = 0 -- pops shown so far (picks the next row, so pops in one batch never sit on each other)
local anchors: { Frame } = {}

-- An invisible spot on the notice layer for Juice.floatText to rise from (one per row, made once).
local function anchorFor(i: number): Frame?
	local a = anchors[i]
	if a and a.Parent then
		return a
	end
	local spot = HuntFun.PopSpots[i]
	local layer = UI.noticeLayer()
	local f = Instance.new("Frame")
	f.Name = "SurprisePopSpot" .. i
	f.BackgroundTransparency = 1
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(spot.X, spot.Y)
	f.Size = UDim2.fromOffset(2, 2)
	f.Parent = layer
	anchors[i] = f
	return f
end

local function pop(text: string, color: Color3)
	local spot = HuntFun.popScreen(count)
	local i = table.find(HuntFun.PopSpots, spot) or 1
	count += 1
	local a = anchorFor(i)
	if a then
		Juice.floatText(a, text, color)
	end
end

-- MatchEvent "Surprise": one batch of prizes (a fast auto nest can finish several eggs in one step). Coins and XP in a
-- batch are added up, so the screen never fills with pops.
function SurprisePop.show(data: any)
	if type(data) ~= "table" or type(data.List) ~= "table" then
		return
	end
	local coins, xp, meter, jackpot = 0, 0, 0, 0
	for _, s in data.List do
		if type(s) == "table" and type(s.Amount) == "number" then
			if s.Kind == "Coins" then
				coins += s.Amount
			elseif s.Kind == "Xp" then
				xp += s.Amount
			elseif s.Kind == "Meter" then
				meter += s.Amount
			elseif s.Kind == "Jackpot" then
				jackpot += s.Amount
			end
		end
	end
	if jackpot > 0 then
		Juice.banner("JACKPOT EGG! +" .. jackpot .. " coins", GOLD, 1.6)
		Audio.play("MatchWin")
		local a = anchorFor(1)
		local target = Juice.coinTarget()
		if a and target then
			Juice.coinFlyFrom(a.AbsolutePosition, target, jackpot)
		end
	end
	if coins > 0 then
		pop("+" .. coins .. " coins", GOLD)
		Audio.play("CoinPickup")
	end
	if xp > 0 then
		pop("+" .. xp .. " pet XP", XP)
	end
	if meter > 0 then
		local need = tonumber(data.MeterNeed)
		local now = tonumber(data.Meter)
		pop(if now and need then string.format("Lucky Meter %d/%d", now, need) else "Lucky Meter +1", METER)
		Audio.play("LuckyMeter")
	end
end

return SurprisePop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="339">
          <Properties>
            <string name="Name">TapCombo</string>
            <string name="Source"><![CDATA[--!strict
-- Tap combo counter (presentation only). Each crack the server accepted on the local player's own plate
-- (StationView's Hit event, hand mallets only) counts; hits that keep coming without a pause build a combo,
-- shown from x3 as a small "x5!" that pops above the nest and fades when the tapping stops.
-- Nothing here touches gameplay: the server's cadence decides how fast hits can come.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)
local UI = require(script.Parent.ui.UI)

local TapCombo = {}

local GAP = 1.7 -- seconds between accepted hits that still keep the combo (mallet cadence is ~0.8 to 1.1 s)
local SHOW_FROM = 3
local LINGER = 1.1

local count = 0
local lastHit = 0
local popT = 0
local anchor: Part? = nil
local label: TextLabel? = nil
local conn: RBXScriptConnection? = nil

local function reduced(): boolean
	local s = State.Profile and State.Profile.Settings
	return s ~= nil and s.ReducedMotion == true
end

local function build(): (Part, TextLabel)
	if anchor and label and anchor.Parent then
		return anchor :: Part, label :: TextLabel
	end
	local a = Instance.new("Part")
	a.Name = "CT_Rocks_TapCombo"
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.CanTouch = false
	a.Transparency = 1
	a.Size = Vector3.one * 0.2
	a.Parent = Workspace
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(96, 48)
	bb.LightInfluence = 0
	bb.AlwaysOnTop = true
	bb.MaxDistance = 60
	bb.Parent = a
	local t = UI.text(bb, "", {
		Font = UI.Head,
		TextSize = 34,
		TextColor3 = UI.Colors.Gold,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	t.TextWrapped = false
	local sc = Instance.new("UIScale")
	sc.Name = "Pop"
	sc.Parent = t
	anchor, label = a, t
	return a, t
end

local function step()
	local t = label
	if not t then
		return
	end
	local now = os.clock()
	local idle = now - lastHit
	if idle > LINGER + 0.4 then
		t.Visible = false
		if conn then
			conn:Disconnect()
			conn = nil
		end
		return
	end
	-- pop: a quick overshoot after each hit, then a fade once the taps stop
	local k = math.clamp((now - popT) / 0.18, 0, 1)
	local s = if reduced() then 1 else 1 + 0.35 * (1 - k) * (1 - k)
	local sc = t:FindFirstChild("Pop")
	if sc and sc:IsA("UIScale") then
		sc.Scale = s
	end
	t.TextTransparency = if idle > LINGER then math.clamp((idle - LINGER) / 0.4, 0, 1) else 0
end

-- One accepted hit on the own plate at `platePos`.
function TapCombo.hit(platePos: Vector3)
	local now = os.clock()
	count = if now - lastHit <= GAP then count + 1 else 1
	lastHit = now
	if count < SHOW_FROM then
		return
	end
	local a, t = build()
	a.CFrame = CFrame.new(platePos + Vector3.new(0, 2.4, 0))
	t.Text = "x" .. count .. "!"
	t.Visible = true
	popT = now
	if not conn then
		conn = RunService.Heartbeat:Connect(step)
	end
end

function TapCombo.clear()
	count = 0
	lastHit = 0
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if anchor then
		anchor:Destroy()
	end
	anchor, label = nil, nil
end

return TapCombo
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="340">
          <Properties>
            <string name="Name">ToolAnim</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural tool strokes (no animation assets exist yet, so nothing here uses an animation id).
--
-- Arms move through their shoulder Motor6Ds: each frame, after the Animator has posed the rig, an
-- extra rotation is layered onto the shoulder's Transform (RunService.Stepped), so idle and walk
-- animations still play underneath. Poses are written in the torso's frame (x right, y up, -z
-- forward) and converted into each joint's own frame from its C0, so the same numbers work on
-- R15 (RightUpperArm.RightShoulder), R6 (Torso["Right Shoulder"], turned 90 degrees) and rigs
-- with other shoulder names. A rig without a recognisable shoulder gets the whole stroke on the
-- tool grip instead (tool-only fallback). Joints we touched are restored exactly when a stroke
-- ends or stop() is called: if the Animator did not rewrite a Transform this frame, our previous
-- layer is removed before the next is added, so nothing accumulates on rigs without animations.
--
-- Hammer / steel hammer (0.65 s / 0.55 s): wind-up overhead with the head cocked back, an
-- accelerating swing that brings the head down onto the work in front at the contact moment
-- (onContact fires there), a short recoil, then back to the carry pose.
-- Jackhammer: start (0.15 s ease in), loop while pulses keep arriving, stop (0.18 s ease out).
-- Both hands go to the two grips, the tool is held upright with the silver bit down; its height
-- follows the work surface found by a ray below the bit (the rock on the table plate). Vibration
-- is a small local shake of the tool (at most 0.05 stud), none with reduced motion. Moving away,
-- unequipping or stop() (round end, reveal) ends it. Purely cosmetic: the server decides hits.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ToolAnim = {}

type Swing = {
	Start: number,
	Total: number,
	Contact: (() -> ())?,
	ContactDone: boolean,
	Reduced: boolean,
}

type Jack = {
	Start: number,
	Until: number,
	Reduced: boolean,
	Origin: Vector3,
	Raise: number,
	Work: Vector3?,
	RayAt: number,
	StopAt: number?,
}

type Rig = {
	Right: Motor6D?,
	Left: Motor6D?,
	RightHand: BasePart?,
	LeftHand: BasePart?,
	Root: BasePart?,
}

local swings: { [Model]: Swing } = {}
local jacks: { [Model]: Jack } = {}
local layers: { [Motor6D]: { Base: CFrame, Wrote: CFrame } } = {}
local restGrip: { [Motor6D]: CFrame } = {}

local HAMMER_CONTACT = 0.49 -- fraction of the stroke at which the head meets the work
local JACK_IN, JACK_OUT = 0.15, 0.18
local MAX_LEAN = math.rad(32) -- the bit leans toward the stone by at most this much

local function findMotor(parent: Instance?, name: string): Motor6D?
	local m = parent and parent:FindFirstChild(name)
	return if m and m:IsA("Motor6D") then m else nil
end

local function rigOf(character: Model): Rig
	local r: Rig = {}
	r.Right = findMotor(character:FindFirstChild("RightUpperArm"), "RightShoulder") or findMotor(character:FindFirstChild("Torso"), "Right Shoulder")
	r.Left = findMotor(character:FindFirstChild("LeftUpperArm"), "LeftShoulder") or findMotor(character:FindFirstChild("Torso"), "Left Shoulder")
	if not r.Right then
		-- other rigs: any Motor6D whose name says right + shoulder/arm
		for _, d in character:GetDescendants() do
			if d:IsA("Motor6D") then
				local n = string.lower(d.Name)
				if string.find(n, "right") and (string.find(n, "shoulder") or string.find(n, "arm")) then
					r.Right = d
				elseif string.find(n, "left") and (string.find(n, "shoulder") or string.find(n, "arm")) then
					r.Left = r.Left or d
				end
			end
		end
	end
	local function part(name: string, alt: string): BasePart?
		local p = character:FindFirstChild(name) or character:FindFirstChild(alt)
		return if p and p:IsA("BasePart") then p else nil
	end
	r.RightHand = part("RightHand", "Right Arm")
	r.LeftHand = part("LeftHand", "Left Arm")
	r.Root = part("HumanoidRootPart", "Torso")
	return r
end

local function toolOf(character: Model): (Model?, Motor6D?)
	local tool = character:FindFirstChild("CT_Rocks_HeldTool")
	if not tool or not tool:IsA("Model") then
		return nil, nil
	end
	local grip = tool.PrimaryPart
	local m = grip and grip:FindFirstChild("ToolGrip")
	return tool, if m and m:IsA("Motor6D") then m else nil
end

local function rest(tool: Model?, g: Motor6D): CFrame
	local saved = restGrip[g]
	if saved then
		return saved
	end
	local attr = tool and tool:GetAttribute("RestC0")
	local base = if typeof(attr) == "CFrame" then attr else g.C0
	restGrip[g] = base
	g.Destroying:Connect(function()
		restGrip[g] = nil
	end)
	return base
end

-- Layer `torsoRot` (a rotation about the joint, in the torso's frame) onto a shoulder.
local function layer(m: Motor6D, torsoRot: CFrame)
	local c0 = m.C0.Rotation
	local extra = c0:Inverse() * torsoRot * c0
	local cur = m.Transform
	local rec = layers[m]
	local base = if rec and cur == rec.Wrote then rec.Base else cur
	local out = base * extra
	m.Transform = out
	layers[m] = { Base = base, Wrote = out }
end

local function unlayer(m: Motor6D?)
	if not m then
		return
	end
	local rec = layers[m]
	if rec then
		if m.Transform == rec.Wrote then
			m.Transform = rec.Base
		end
		layers[m] = nil
	end
end

-- Hammer head squash on contact: the head pieces (Part tools: Head / FaceL / FaceR; kit tools: Steel /
-- SteelLight) shrink along their longest axis (the striking axis) and bulge a little on the other two,
-- about their own centres, so welds and the grip are untouched. Rest sizes are kept per part (weak keys).
local HEAD_PARTS = { Head = true, FaceL = true, FaceR = true, Steel = true, SteelLight = true }
local headCache: { [Model]: { [BasePart]: Vector3 } } = setmetatable({}, { __mode = "k" }) :: any
local squashed: { [Model]: boolean? } = setmetatable({}, { __mode = "k" }) :: any

-- amount 0 = rest size; about 0.12 reads as a firm hit.
function ToolAnim.squash(tool: Model, amount: number)
	if amount <= 0 and not squashed[tool] then
		return
	end
	local heads = headCache[tool]
	if not heads then
		local found: { [BasePart]: Vector3 } = {}
		for _, d in tool:GetDescendants() do
			if d:IsA("BasePart") and HEAD_PARTS[d.Name] then
				found[d] = d.Size
			end
		end
		headCache[tool] = found
		heads = found
	end
	squashed[tool] = if amount > 0 then true else nil
	for part, size in heads do
		if part.Parent then
			if amount <= 0 then
				part.Size = size
			else
				local long = math.max(size.X, size.Y, size.Z)
				local function f(v: number): number
					return v * (if v == long then 1 - amount else 1 + amount * 0.5)
				end
				part.Size = Vector3.new(f(size.X), f(size.Y), f(size.Z))
			end
		end
	end
end

local function restore(character: Model)
	local r = rigOf(character)
	unlayer(r.Right)
	unlayer(r.Left)
	local tool, g = toolOf(character)
	if g then
		g.C0 = rest(tool, g)
	end
	if tool then
		ToolAnim.squash(tool, 0)
	end
end

-- Torso-frame arm rotation: raise forward by `raise` (0 = hanging, pi/2 = straight ahead), then
-- bring the hand toward the body's centre line by `inward` (side = +1 right arm, -1 left arm).
local function armRot(raise: number, inward: number, side: number): CFrame
	return CFrame.Angles(raise, 0, 0) * CFrame.Angles(0, 0, -side * inward)
end

local function fistOf(hand: BasePart): CFrame
	return hand.CFrame * CFrame.new(0, -hand.Size.Y / 2 + 0.15, 0)
end

local function lerp(a: number, b: number, k: number): number
	return a + (b - a) * k
end

local function smooth(k: number): number
	k = math.clamp(k, 0, 1)
	return k * k * (3 - 2 * k)
end

-- Hammer keyframes: arm raise and the tool's angle in the hand's frame (about the hand's X axis;
-- the carry pose is -28 degrees, head up and a little forward).
local KEYS = {
	{ u = 0.0, raise = 0, tool = -28 },
	{ u = 0.3, raise = 165, tool = -135 }, -- wound up overhead, head cocked back
	{ u = HAMMER_CONTACT, raise = 128, tool = -278 }, -- head comes down on the work in front
	{ u = 0.6, raise = 136, tool = -262 }, -- recoil
	{ u = 1.0, raise = 0, tool = -28 },
}

local function hammerPose(u: number): (number, number)
	for i = 1, #KEYS - 1 do
		local a, b = KEYS[i], KEYS[i + 1]
		if u <= b.u then
			local k = (u - a.u) / (b.u - a.u)
			-- ease out on the wind-up, accelerate into contact, ease out of the recoil
			local e = if i == 1 then 1 - (1 - k) ^ 2 elseif i == 2 then k * k else smooth(k)
			return math.rad(lerp(a.raise, b.raise, e)), math.rad(lerp(a.tool, b.tool, e))
		end
	end
	return 0, math.rad(-28)
end

-- Start one stroke on a character. toolId nil = read it from the held tool.
-- Pet gear is passive: nothing is swung. A work tap is only the contact callback (hit effects) after a short beat.
function ToolAnim.strike(_character: Model, _toolId: string?, _reduced: boolean?, onContact: (() -> ())?)
	if onContact then
		task.delay(0.15, onContact)
	end
end

function ToolAnim.stop(character: Model)
	swings[character] = nil
	jacks[character] = nil
	restore(character)
end

-- The point the bit works on, cached briefly: a ray down in front of the avatar finds the rock on
-- the table plate (or the plate); without a hit, the nearest table "Plate" attachment (the rock
-- sits on it); else a spot at knee-to-hip height in front.
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local plates: { Attachment } = {}
local platesAt = -math.huge
local function workPoint(character: Model, root: BasePart, j: Jack, now: number): Vector3
	if j.Work and now - j.RayAt < 0.15 then
		return j.Work :: Vector3
	end
	j.RayAt = now
	rayParams.FilterDescendantsInstances = { character }
	local probe = root.CFrame * CFrame.new(0, 2.5, -2.2)
	local hit = Workspace:Raycast(probe.Position, Vector3.new(0, -9, 0), rayParams)
	local work = (root.CFrame * CFrame.new(0, -1.1, -2)).Position
	if hit and hit.Position.Y > root.Position.Y - 3.5 and hit.Position.Y < root.Position.Y + 3 then
		work = hit.Position
	else
		if now - platesAt > 5 then
			platesAt = now
			table.clear(plates)
			for _, d in Workspace:GetDescendants() do
				if d:IsA("Attachment") and d.Name == "Plate" then
					table.insert(plates, d)
				end
			end
		end
		local best = 6
		for _, a in plates do
			local d = (a.WorldPosition - root.Position) * Vector3.new(1, 0, 1)
			if a.Parent and d.Magnitude < best then
				best = d.Magnitude
				work = a.WorldPosition + Vector3.new(0, 0.8, 0) -- top of a rock on the plate
			end
		end
	end
	j.Work = work
	return work
end

local function stepSwing(character: Model, sw: Swing, now: number): boolean
	local u = (now - sw.Start) / sw.Total
	if u >= 1 then
		restore(character)
		return false
	end
	if not sw.ContactDone and u >= HAMMER_CONTACT then
		sw.ContactDone = true
		if sw.Contact then
			task.spawn(sw.Contact)
		end
	end
	local raise, toolAng = hammerPose(u)
	local hit = (u - HAMMER_CONTACT) / 0.14 -- head squash just after contact (none with reduced motion)
	local held = toolOf(character)
	if held then
		ToolAnim.squash(held, if sw.Reduced or hit < 0 or hit > 1 then 0 else 0.13 * math.sin(hit * math.pi))
	end
	if sw.Reduced then
		-- a small tap instead of the full overhead swing
		raise *= 0.4
		toolAng = math.rad(-28) + (toolAng - math.rad(-28)) * 0.4
	end
	local r = rigOf(character)
	local tool, g = toolOf(character)
	if r.Right then
		layer(r.Right, armRot(raise, 0, 1))
	end
	if g then
		local base = rest(tool, g)
		local fist = base * CFrame.Angles(math.rad(28), 0, 0) -- the fist frame (rest without its tilt)
		if r.Right then
			g.C0 = fist * CFrame.Angles(toolAng, 0, 0)
		else
			-- no shoulder: the whole stroke happens at the grip
			g.C0 = fist * CFrame.Angles(toolAng - raise, 0, 0)
		end
	end
	return true
end

local function stepJack(character: Model, j: Jack, now: number): boolean
	local r = rigOf(character)
	local tool, g = toolOf(character)
	local root = r.Root
	if not tool or tool:GetAttribute("ToolId") ~= "Jackhammer" or not g or not root then
		restore(character)
		return false
	end
	-- moving away from where it started ends the loop
	local flat = root.Position - j.Origin
	if not j.StopAt and (now > j.Until or Vector3.new(flat.X, 0, flat.Z).Magnitude > 3) then
		j.StopAt = now
	end
	local w = smooth((now - j.Start) / JACK_IN)
	if j.StopAt then
		w = math.min(w, 1 - smooth((now - j.StopAt) / JACK_OUT))
		if w <= 0 then
			restore(character)
			return false
		end
	end
	local len = -((tool:GetAttribute("TipY") :: number?) or -2.4) -- handlebar to bit tip
	local gripX = (tool:GetAttribute("GripX") :: number?) or 0.6
	local work = workPoint(character, root, j, now)
	local hand = r.RightHand
	if r.Right and hand then
		-- raise the arms until the bit (leaning at most MAX_LEAN toward the work) reaches it
		local m = r.Right :: Motor6D
		local joint = ((m.Part0 :: BasePart).CFrame * m.C0).Position
		local armLen = math.max((fistOf(hand).Position - joint).Magnitude, 0.5)
		local handY = work.Y + len * math.cos(MAX_LEAN * 0.7)
		local want = math.acos(math.clamp((joint.Y - handY) / armLen, -1, 1))
		want = math.clamp(want, math.rad(40), math.rad(150))
		j.Raise = if j.Raise == 0 then want else lerp(j.Raise, want, 0.25)
		local half = math.abs((root.CFrame:PointToObjectSpace(joint)).X)
		local inward = math.asin(math.clamp((half - gripX) / armLen, 0, 0.9))
		layer(m, armRot(j.Raise * w, inward * w, 1))
		if r.Left then
			layer(r.Left, armRot(j.Raise * w, inward * w, -1))
		end
	end
	-- the tool: handlebar centred between the two fists, body hanging with the bit aimed at the
	-- work (upright, leaning toward the stone by at most MAX_LEAN), facing the avatar's way
	local centre: Vector3
	if hand then
		local rf = fistOf(hand).Position
		local lf = if r.LeftHand and r.Left then fistOf(r.LeftHand :: BasePart).Position else rf - root.CFrame.RightVector * gripX * 2
		centre = (rf + lf) / 2
	else
		centre = work + Vector3.new(0, len, 0)
	end
	local down = work - centre
	if down.Magnitude < 0.1 or down.Y > -0.1 then
		down = Vector3.new(0, -1, 0)
	end
	down = down.Unit
	local lean = math.acos(math.clamp(-down.Y, -1, 1))
	if lean > MAX_LEAN then
		local horiz = Vector3.new(down.X, 0, down.Z)
		horiz = if horiz.Magnitude > 1e-3 then horiz.Unit else Vector3.zero
		down = (Vector3.new(0, -math.cos(MAX_LEAN), 0) + horiz * math.sin(MAX_LEAN)).Unit
	end
	local fwd = root.CFrame.LookVector
	local up = -down
	local right = fwd:Cross(up)
	right = if right.Magnitude > 1e-3 then right.Unit else root.CFrame.RightVector
	local back = right:Cross(up).Unit
	local orient = CFrame.fromMatrix(Vector3.zero, right, up, back)
	local shake = Vector3.zero
	if not j.Reduced then
		local t = now - j.Start
		shake = Vector3.new(math.sin(t * 97) * 0.012, (if (t * 26) % 1 < 0.5 then 0.05 else -0.03) * w, math.sin(t * 83 + 1) * 0.012)
	end
	local goal = CFrame.new(centre) * orient * CFrame.new(shake)
	local partner = g.Part0 :: BasePart
	local target = partner.CFrame:Inverse() * goal
	local base = rest(tool, g)
	g.C0 = base:Lerp(target, w)
	return true
end

RunService.Stepped:Connect(function()
	local now = os.clock()
	for character, sw in swings do
		if not character.Parent or not stepSwing(character, sw, now) then
			swings[character] = nil
		end
	end
	for character, j in jacks do
		if not character.Parent or not stepJack(character, j, now) then
			jacks[character] = nil
		end
	end
end)

-- Pickup reach: the right arm reaches forward and comes back (0.4 s). Tools are stowed while
-- collecting, so only the shoulder moves (applied after the Animator, like the strike).

local scoops: { [Model]: number } = {}

function ToolAnim.scoop(character: Model)
	local t = scoops[character]
	if t and os.clock() - t < 0.36 then
		return
	end
	scoops[character] = os.clock()
end

-- Carry pose (other players, third person): both arms come forward and in, under the basket, while it holds
-- rocks; eased in and out (0.2 s). Layered on the shoulders after the Animator like the strike; skipped
-- while the same avatar strikes, runs a jackhammer or scoops. Cosmetic only. on=false eases out and restores.
local carrying: { [Model]: { On: boolean, W: number } } = {}
local CARRY_RAISE, CARRY_INWARD = math.rad(40), 0.1

function ToolAnim.carry(character: Model, on: boolean, reduced: boolean?)
	local c = carrying[character]
	if c then
		c.On = on
	elseif on then
		carrying[character] = { On = true, W = if reduced then 1 else 0 }
	end
end

function ToolAnim.isCarrying(character: Model): boolean
	local c = carrying[character]
	return c ~= nil and c.On
end

local lastCarry = os.clock()
RunService.Stepped:Connect(function()
	local now = os.clock()
	local dt = math.min(now - lastCarry, 0.1)
	lastCarry = now
	for character, c in carrying do
		if not character.Parent then
			carrying[character] = nil
			continue
		end
		c.W = math.clamp(c.W + (if c.On then dt else -dt) / 0.2, 0, 1)
		local r = rigOf(character)
		if swings[character] or jacks[character] or scoops[character] then
			continue -- another stroke owns the arms this frame
		end
		if c.W <= 0 then
			unlayer(r.Right)
			unlayer(r.Left)
			carrying[character] = nil
			continue
		end
		local w = smooth(c.W)
		if r.Right then
			layer(r.Right, armRot(CARRY_RAISE * w, CARRY_INWARD * w, 1))
		end
		if r.Left then
			layer(r.Left, armRot(CARRY_RAISE * w, CARRY_INWARD * w, -1))
		end
	end
end)

-- Turns the character's root toward a point (yaw only) so a swing lands on the plate in front of
-- it. Only call for the local player's own character (its owner moves it).
function ToolAnim.face(character: Model, target: Vector3)
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local p = root.Position
		local flat = Vector3.new(target.X, p.Y, target.Z)
		if (flat - p).Magnitude > 0.2 then
			root.CFrame = CFrame.lookAt(p, flat)
		end
	end
end

RunService.Stepped:Connect(function()
	local now = os.clock()
	for character, t0 in scoops do
		local u = (now - t0) / 0.4
		if u >= 1 or not character.Parent then
			scoops[character] = nil
			continue
		end
		local angle = math.rad(62) * math.sin(math.pi * u)
		local upper = character:FindFirstChild("RightUpperArm")
		local m = upper and upper:FindFirstChild("RightShoulder")
		if m and m:IsA("Motor6D") then
			m.Transform = m.Transform * CFrame.Angles(angle, 0, 0)
		else
			local torso = character:FindFirstChild("Torso")
			local m6 = torso and torso:FindFirstChild("Right Shoulder")
			if m6 and m6:IsA("Motor6D") then
				m6.Transform = m6.Transform * CFrame.Angles(0, 0, angle)
			end
		end
	end
end)

return ToolAnim
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="341">
          <Properties>
            <string name="Name">Tower</string>
            <string name="Source"><![CDATA[--!strict
-- Pet Tower client boot (its own LocalScript so Main.client.luau stays untouched). See ui/TowerPanel.
require(script.Parent.ui.TowerPanel).start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="342">
          <Properties>
            <string name="Name">TowerFx</string>
            <string name="Source"><![CDATA[--!strict
-- Pet Tower juice (client only, pure presentation): a short camera shake, a red boss glow, the boss's coin and
-- sparkle burst, the gate light when a floor is cleared, the compact floor / theme title card, and a distinct
-- look per combat move (TowerFx.hit / TowerFx.special).
-- Every piece cleans itself up (Debris / tween end), counts are capped, and the viewer's settings apply:
-- Reduce Motion drops the shake, slides and bounces; Low Effects halves the pieces.

local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)
local UI = require(script.Parent.ui.UI)
local PetStyle = require(script.Parent.ui.PetStyle)

local TowerFx = {}

local function setting(key: string): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings[key] == true
end

local function folder(): Folder
	local f = Workspace:FindFirstChild("TowerFx")
	if f and f:IsA("Folder") then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = "TowerFx"
	nf.Parent = Workspace
	return nf
end

-- Camera shake: a decaying offset added after the camera scripts each frame (so it never accumulates).
-- Small on purpose (at most ~0.35 stud); off with Reduce Motion.
local shakeUntil, shakeStart, shakePower = 0, 0, 0
local shakeBound = false
local SHAKE_NAME = "CTR_TowerShake"
function TowerFx.shake(power: number, duration: number)
	if setting("ReducedMotion") then
		return
	end
	if setting("LowEffects") then
		power *= 0.5 -- Low Effects: half the camera shake
		duration *= 0.6
	end
	local now = os.clock()
	shakeStart = now
	shakeUntil = now + duration
	shakePower = math.min(math.max(power, shakePower * math.max(0, (shakeUntil - now) / duration)), 0.35)
	if shakeBound then
		return
	end
	shakeBound = true
	RunService:BindToRenderStep(SHAKE_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		local t = os.clock()
		local cam = Workspace.CurrentCamera
		if t >= shakeUntil or cam == nil then
			shakeBound = false
			shakePower = 0
			RunService:UnbindFromRenderStep(SHAKE_NAME)
			return
		end
		local k = 1 - (t - shakeStart) / math.max(shakeUntil - shakeStart, 0.01)
		local a = shakePower * k
		cam.CFrame = cam.CFrame * CFrame.new(math.sin(t * 61) * a, math.sin(t * 47 + 1.3) * a, 0) * CFrame.Angles(0, 0, math.sin(t * 39) * a * 0.02)
	end)
end

-- Boss entrance glow: a red outline and light that flare up, then settle to a faint menace glow.
function TowerFx.bossGlow(model: Model, color: Color3?)
	local c = color or Color3.fromRGB(255, 40, 30)
	local h = Instance.new("Highlight")
	h.Name = "BossGlow"
	h.FillColor = c
	h.OutlineColor = c
	h.FillTransparency = 0.35
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Adornee = model
	h.Parent = model
	-- textured mesh pets ignore Color, so the glow itself carries the "angry red" (TowerView marks them TexturedBoss)
	local settle = if model:GetAttribute("TexturedBoss") then 0.55 else 0.85
	TweenService:Create(h, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FillTransparency = settle, OutlineTransparency = 0.5 }):Play()
	local body = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if body and not setting("LowEffects") then -- Low Effects keeps the red outline but drops the dynamic light
		local l = Instance.new("PointLight")
		l.Name = "BossLight"
		l.Color = c
		l.Range = 22
		l.Brightness = 6
		l.Parent = body
		TweenService:Create(l, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = 1.2, Range = 14 }):Play()
	end
end

local COIN = Color3.fromRGB(255, 200, 50)
local liveCoins = 0
local MAX_COINS = 24

-- Boss faint: gold coins fly out and bounce down, plus a sparkle puff and a flash. Capped, gone in ~1.6 s.
function TowerFx.bossBurst(at: Vector3, groundY: number)
	local low = setting("LowEffects")
	local count = if low then 6 else 14
	local f = folder()
	-- flash + sparkles (one emitter, burst once)
	local a = Instance.new("Part")
	a.Name = "BossBurst"
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.CanTouch = false
	a.Transparency = 1
	a.Size = Vector3.one
	a.Position = at
	a.Parent = f
	if not low then
		local light = Instance.new("PointLight")
		light.Color = COIN
		light.Range = 24
		light.Brightness = 8
		light.Parent = a
		TweenService:Create(light, TweenInfo.new(0.9), { Brightness = 0 }):Play()
	end
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(Color3.new(1, 1, 1), COIN)
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new(0, 1)
	pe.Lifetime = NumberRange.new(0.6, 1.1)
	pe.Speed = NumberRange.new(8, 18)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Rate = 0
	pe.Parent = a
	pe:Emit(if low then 12 else 30)
	Debris:AddItem(a, 1.6)
	-- coins
	for i = 1, count do
		if liveCoins >= MAX_COINS then
			break
		end
		liveCoins += 1
		local c = Instance.new("Part")
		c.Name = "Coin"
		c.Shape = Enum.PartType.Cylinder
		c.Size = Vector3.new(0.25, 1.1, 1.1)
		c.Color = COIN
		c.Material = Enum.Material.Neon
		c.Anchored = true
		c.CanCollide = false
		c.CanQuery = false
		c.CanTouch = false
		c.CastShadow = false
		local ang = (i / count) * math.pi * 2 + math.random() * 0.4
		local out = Vector3.new(math.cos(ang), 0, math.sin(ang)) * (4 + math.random() * 5)
		c.CFrame = CFrame.new(at) * CFrame.Angles(0, ang, 0)
		c.Parent = f
		local up = at + out * 0.5 + Vector3.new(0, 4 + math.random() * 3, 0)
		local down = Vector3.new(at.X + out.X, groundY + 0.6, at.Z + out.Z)
		local spin = CFrame.Angles(math.rad(math.random(200, 520)), ang, 0)
		TweenService:Create(c, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(up) * spin }):Play()
		task.delay(0.35, function()
			if c.Parent then
				TweenService:Create(c, TweenInfo.new(0.5, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { CFrame = CFrame.new(down) * spin * CFrame.Angles(0, 0, math.rad(90)) }):Play()
				TweenService:Create(c, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.7), { Transparency = 1 }):Play()
			end
		end)
		task.delay(1.5, function()
			liveCoins = math.max(liveCoins - 1, 0)
			c:Destroy()
		end)
	end
end

-- Floor clear: the far gate (TowerBuilder's GateL/GateR/GateTop arch) fills with light, then fades.
-- REPLACE: when the arena gets a real door model, open it here as well (light only for now).
function TowerFx.gateLight(origin: CFrame)
	local f = folder()
	local cf = origin * CFrame.new(0, 6, 31) -- arch centre: TowerBuilder RADIUS - 3, between the 12-stud posts
	local p = Instance.new("Part")
	p.Name = "GateLight"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(255, 240, 180)
	p.Transparency = 1
	p.Size = Vector3.new(9, if setting("ReducedMotion") then 12 else 0.2, 0.3)
	p.CFrame = cf * CFrame.new(0, if setting("ReducedMotion") then 0 else -5.9, 0)
	p.Parent = f
	local l = Instance.new("SurfaceLight")
	l.Face = Enum.NormalId.Back -- toward the arena centre (-Z of the gate)
	l.Color = p.Color
	l.Range = 30
	l.Angle = 120
	l.Brightness = 0
	l.Parent = p
	local open = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(p, open, { Transparency = 0.25, Size = Vector3.new(9, 12, 0.3), CFrame = cf }):Play()
	TweenService:Create(l, open, { Brightness = 5 }):Play()
	task.delay(2.6, function()
		if p.Parent then
			TweenService:Create(p, TweenInfo.new(0.8), { Transparency = 1 }):Play()
			TweenService:Create(l, TweenInfo.new(0.8), { Brightness = 0 }):Play()
		end
	end)
	Debris:AddItem(p, 3.6)
end

-- Theme title pill ("JUNGLE  ·  FLOORS 1-10"): one short line in a small pill under the tower HUD's floor card and
-- LEAVE, the same size family as the floor card, so it never covers the pets (bug 238). Drops in, holds, fades.
local card: Frame? = nil
-- True from the floor's first hit until the floor ends: the title pill never shows over pets that are fighting
-- (Studio 2026-10-14: "JUNGLE FLOORS" sat on top of the fight). The server holds a new theme's first wave
-- TowerConfig.TitleHold seconds so the pill has its moment before the first hit.
local fightOn = false
local CARD_Y = UI.T.Edge + 100 -- below the floor card and LEAVE (TowerPanel: LEAVE ends at T.Edge + 46 + 44)
function TowerFx.titleCard(title: string, sub: string, color: Color3)
	if fightOn then
		return -- the pets already fight (a late title, e.g. after the entry camera turn): the HUD floor label says it
	end
	if card then
		card:Destroy()
		card = nil
	end
	local reduced = setting("ReducedMotion")
	-- a glossy pill in the theme's colour (PetStyle.pill look, no button): lighter top, darker edge, outlined words
	local g = UI.frame(UI.noticeLayer(), {
		Name = "TowerTitleCard", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, if reduced then CARD_Y else CARD_Y - 16),
		Size = UDim2.new(0.7, 0, 0, 34), BackgroundColor3 = color,
	})
	card = g
	local lim = Instance.new("UISizeConstraint")
	lim.MaxSize = Vector2.new(260, 34)
	lim.Parent = g
	local edgeColor = color:Lerp(PetStyle.K.Ink, 0.5)
	PetStyle.round(g, 999)
	PetStyle.vgrad(g, color:Lerp(PetStyle.K.White, 0.45), color)
	PetStyle.edge(g, edgeColor, 2.5)
	PetStyle.words(g, if sub ~= "" then title .. "  \u{00B7}  " .. sub else title, UI.T.Body, {
		Name = "Title", Position = UDim2.fromOffset(10, 3), Size = UDim2.new(1, -20, 1, -6), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2,
		OutlineColor = edgeColor, OutlineThick = 2.4,
	})
	if not reduced then
		TweenService:Create(g, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, CARD_Y) }):Play()
	end
	task.delay(1.6, function()
		if card ~= g then
			return
		end
		local out = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		if not reduced then
			TweenService:Create(g, out, { Position = UDim2.new(0.5, 0, 0, CARD_Y - 12) }):Play()
		end
		TweenService:Create(g, out, { BackgroundTransparency = 1 }):Play()
		for _, d in g:GetDescendants() do
			if d:IsA("TextLabel") then
				TweenService:Create(d, out, { TextTransparency = 1 }):Play()
			elseif d:IsA("UIStroke") then
				TweenService:Create(d, out, { Transparency = 1 }):Play()
			end
		end
		task.delay(0.45, function()
			if card == g then
				card = nil
			end
			g:Destroy()
		end)
	end)
end

-- The floor's fight has started (first hit): the title goes at once and no late one shows.
function TowerFx.fightStarted()
	fightOn = true
	TowerFx.hideTitle()
end

-- The floor is over (floor-end card, revive, leaving): the next floor may show its title again.
function TowerFx.fightStopped()
	fightOn = false
end

-- Takes the title card down at once (a floor-end card or leaving the tower must never sit under it).
function TowerFx.hideTitle()
	if card then
		card:Destroy()
		card = nil
	end
end

-- Move looks (client only): every hit and SPECIAL gets its own short procedural effect, keyed by the attacker's
-- type and the hit grade, so moves read apart at a glance. Built-in particle textures only, a handful of anchored
-- neon parts each, every piece gone within ~0.6 s (Debris), live pieces capped for phones (Low Effects: fewer).
--   Fire   = ember bolt flying in + flame puff      Nature = green slash arc + leaf sparks
--   Earth  = ground shockwave ring + rock chunks     Storm  = zigzag bolt from above + yellow sparks
--   Ice    = shard star bursting out + frost ring    Cosmic = purple star burst + glow sphere
--   mobs / no type = small white impact puff
--   Strong = bigger, plus a ring in the attacker's colour; Weak = small and dim; Crit = gold star flash
local FIRE_TEX = "rbxasset://textures/particles/fire_main.dds"
local SPARK_TEX = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE_TEX = "rbxasset://textures/particles/smoke_main.dds"
local FX_LIFE = 0.55
local MAX_FX = 36 -- move-effect parts alive at once
local LOW_MAX_FX = 16
local liveFx = 0

local FxColor = {
	Fire = Color3.fromRGB(255, 120, 40),
	Nature = Color3.fromRGB(110, 225, 90),
	Earth = Color3.fromRGB(170, 120, 70),
	Storm = Color3.fromRGB(255, 230, 80),
	Ice = Color3.fromRGB(150, 225, 255),
	Cosmic = Color3.fromRGB(190, 120, 255),
} :: { [string]: Color3 }
local GOLD = Color3.fromRGB(255, 215, 70)
local WHITE = Color3.new(1, 1, 1)

local function room(n: number): boolean
	return liveFx + n <= (if setting("LowEffects") then LOW_MAX_FX else MAX_FX)
end

local function fxPart(shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3, life: number?): Part
	local p = Instance.new("Part")
	p.Name = "MoveFx"
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = folder()
	liveFx += 1
	p.Destroying:Once(function()
		liveFx = math.max(liveFx - 1, 0)
	end)
	Debris:AddItem(p, life or FX_LIFE)
	return p
end

local function tween(i: Instance, t: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	TweenService:Create(i, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
end

-- Flat ring on the ground (or around a point) that widens and fades.
local function ring(at: Vector3, color: Color3, r0: number, r1: number, t: number)
	if not room(1) then
		return
	end
	local p = fxPart(Enum.PartType.Cylinder, Vector3.new(0.15, r0 * 2, r0 * 2), CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90)), color)
	p.Transparency = 0.2
	tween(p, t, { Size = Vector3.new(0.05, r1 * 2, r1 * 2), Transparency = 1 })
end

-- Glow ball that swells and fades.
local function orb(at: Vector3, color: Color3, d0: number, d1: number, t: number)
	if not room(1) then
		return
	end
	local p = fxPart(Enum.PartType.Ball, Vector3.one * d0, CFrame.new(at), color)
	p.Transparency = 0.3
	tween(p, t, { Size = Vector3.one * d1, Transparency = 1 })
end

-- One-shot particle burst from an invisible anchor (one part, one emitter).
local function burst(at: Vector3, color: Color3, tex: string, count: number, speed: number, size: number)
	if not room(1) then
		return
	end
	local a = fxPart(Enum.PartType.Block, Vector3.one * 0.2, CFrame.new(at), color, 0.9)
	a.Transparency = 1
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = tex
	pe.Color = ColorSequence.new(WHITE:Lerp(color, 0.4), color)
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new(0, 1)
	pe.Lifetime = NumberRange.new(0.25, 0.45)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Drag = 4
	pe.Rate = 0
	pe.Parent = a
	pe:Emit(if setting("LowEffects") then math.max(count // 2, 2) else count)
end

-- Thin glowing beam between two points that fades.
local function streak(a: Vector3, b: Vector3, color: Color3, thick: number, t: number)
	local len = (b - a).Magnitude
	if len < 0.05 or not room(1) then
		return
	end
	local p = fxPart(Enum.PartType.Block, Vector3.new(thick, thick, len), CFrame.lookAt((a + b) / 2, b), color)
	tween(p, t, { Size = Vector3.new(0.02, 0.02, len), Transparency = 1 })
end

-- Small glowing ball that flies from a to b, then pops.
local function bolt(a: Vector3, b: Vector3, color: Color3, d: number, fly: number, pop: () -> ())
	if not room(1) then
		pop()
		return
	end
	local p = fxPart(Enum.PartType.Ball, Vector3.one * d, CFrame.new(a), color, fly + 0.05)
	tween(p, fly, { CFrame = CFrame.new(b) }, Enum.EasingStyle.Linear)
	task.delay(fly, pop)
end

-- Slash arc: a few thin bars along a tilted arc in front of the target, fading fast.
local function slash(at: Vector3, face: Vector3, color: Color3, r: number)
	local n = if setting("LowEffects") then 3 else 5
	if not room(n) then
		return
	end
	local base = CFrame.lookAt(at, at + face) * CFrame.Angles(0, 0, math.rad(35))
	for i = 1, n do
		local ang = math.rad(-60 + 120 * (i - 1) / (n - 1))
		local cf = base * CFrame.new(math.sin(ang) * r, math.cos(ang) * r * 0.6, 0) * CFrame.Angles(0, 0, -ang)
		local p = fxPart(Enum.PartType.Block, Vector3.new(r * 0.55, 0.18, 0.18), cf, color)
		p.Transparency = 0.1
		task.delay((i - 1) * 0.025, function()
			if p.Parent then
				tween(p, 0.3, { Transparency = 1, Size = Vector3.new(r * 0.7, 0.05, 0.05) })
			end
		end)
	end
end

-- Little blocks thrown out from a point (rock chunks, ice shards, leaves).
local function shards(at: Vector3, color: Color3, n: number, dist: number, size: Vector3, up: number)
	n = if setting("LowEffects") then math.max(n // 2, 2) else n
	if not room(n) then
		return
	end
	local r = math.random() * math.pi
	for i = 1, n do
		local ang = r + (i / n) * math.pi * 2
		local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
		local p = fxPart(Enum.PartType.Block, size, CFrame.lookAt(at, at + dir), color)
		p.Material = Enum.Material.SmoothPlastic
		local goal = CFrame.lookAt(at + dir * dist + Vector3.new(0, up, 0), at + dir * (dist + 1)) * CFrame.Angles(math.random() * 3, 0, math.random() * 3)
		tween(p, 0.45, { CFrame = goal, Transparency = 1 })
	end
end

-- Zigzag lightning from high above down onto a point.
local function zigzag(to: Vector3, color: Color3, height: number, thick: number)
	local steps = 3
	local prev = to + Vector3.new((math.random() - 0.5) * 2, height, (math.random() - 0.5) * 2)
	for i = 1, steps do
		local nextP = if i == steps then to else prev:Lerp(to, 1 / (steps - i + 1)) + Vector3.new((math.random() - 0.5) * 1.6, 0, (math.random() - 0.5) * 1.6)
		streak(prev, nextP, color, thick, 0.3)
		prev = nextP
	end
end

-- One hit. `from` = attacker body point (nil = unknown), `to` = target body point, `ground` = target floor height.
-- grade: "Strong" | "Weak" | "Crit" | nil (normal). element nil = a mob or untyped hit.
function TowerFx.hit(from: Vector3?, to: Vector3, ground: number, element: string?, grade: string?)
	local k = if grade == "Strong" then 1.4 elseif grade == "Weak" then 0.7 elseif grade == "Crit" then 1.6 else 1
	local color = (element and FxColor[element]) or WHITE
	if grade == "Weak" then
		color = color:Lerp(Color3.fromRGB(150, 150, 160), 0.5)
	end
	local feet = Vector3.new(to.X, ground + 0.15, to.Z)
	local face = if from then (to - from) * Vector3.new(1, 0, 1) else Vector3.zAxis
	face = if face.Magnitude > 0.1 then face.Unit else Vector3.zAxis
	if element == "Fire" then
		local start = from or (to - face * 6)
		bolt(start + Vector3.new(0, 0.5, 0), to, color, 0.7 * k, 0.12, function()
			burst(to, color, FIRE_TEX, 8, 9 * k, 1.6 * k)
			orb(to, Color3.fromRGB(255, 200, 80), 0.8 * k, 3 * k, 0.25)
		end)
	elseif element == "Nature" then
		slash(to, face, color, 1.6 * k)
		burst(to, color, SPARK_TEX, 6, 7 * k, 0.6 * k)
	elseif element == "Earth" then
		ring(feet, color, 0.8, 4 * k, 0.4)
		shards(feet + Vector3.new(0, 0.3, 0), Color3.fromRGB(125, 95, 65), 4, 2.2 * k, Vector3.one * 0.45 * k, 1.6)
	elseif element == "Storm" then
		zigzag(to, color, 7, 0.22 * k)
		burst(to, color, SPARK_TEX, 8, 12 * k, 0.7 * k)
	elseif element == "Ice" then
		shards(to, color, 5, 2.4 * k, Vector3.new(0.18, 0.18, 0.9) * k, 0.4)
		ring(to, WHITE, 0.4, 2.4 * k, 0.3)
	elseif element == "Cosmic" then
		orb(to, color, 0.6 * k, 3.4 * k, 0.35)
		burst(to, Color3.fromRGB(255, 230, 140), SPARK_TEX, 8, 10 * k, 0.9 * k)
	else
		burst(to, WHITE, SMOKE_TEX, 5, 6 * k, 1.2 * k)
	end
	if grade == "Strong" and element then
		ring(to, FxColor[element] or WHITE, 0.6, 3.6, 0.35)
	elseif grade == "Crit" then
		orb(to, GOLD, 1, 5, 0.3)
		burst(to, GOLD, SPARK_TEX, 12, 16, 1.2)
	end
end

-- A SPECIAL by its Kind (TowerConfig.Specials): caster point, the standing mobs' and pets' points, floor height.
--   Burn = flame column on each mob       Slow = frost ring wave across the mob line   Chain = bolts hopping mob to mob
--   Heal = green rings rising on each pet Shield = bubble on each pet                  Stomp = big ground shockwave
--   Dash = speed streak caster -> front mob                                            Crit = gold star flash on the caster
function TowerFx.special(kind: string, caster: Vector3, mobs: { Vector3 }, pets: { Vector3 }, ground: number)
	local floorAt = function(v: Vector3): Vector3
		return Vector3.new(v.X, ground + 0.15, v.Z)
	end
	if kind == "Burn" then
		for _, m in mobs do
			burst(floorAt(m) + Vector3.new(0, 0.5, 0), FxColor.Fire, FIRE_TEX, 10, 10, 2)
			orb(m, Color3.fromRGB(255, 160, 60), 1, 3.5, 0.4)
		end
	elseif kind == "Slow" then
		local mid = Vector3.zero
		for _, m in mobs do
			mid += m
			ring(m, FxColor.Ice, 0.5, 2.8, 0.45)
		end
		if #mobs > 0 then
			ring(floorAt(mid / #mobs), Color3.fromRGB(200, 240, 255), 1, 9, 0.5)
		end
	elseif kind == "Chain" then
		local prev = caster
		for _, m in mobs do
			streak(prev, m, FxColor.Storm, 0.3, 0.35)
			burst(m, FxColor.Storm, SPARK_TEX, 6, 12, 0.8)
			prev = m
		end
	elseif kind == "Heal" then
		for _, p in pets do
			ring(floorAt(p), FxColor.Nature, 0.6, 2.6, 0.45)
			burst(floorAt(p) + Vector3.new(0, 1, 0), Color3.fromRGB(170, 255, 150), SPARK_TEX, 6, 5, 0.8)
		end
	elseif kind == "Shield" then
		for _, p in pets do
			if room(1) then
				local b = fxPart(Enum.PartType.Ball, Vector3.one * 2, CFrame.new(p), Color3.fromRGB(140, 210, 255))
				b.Material = Enum.Material.ForceField
				tween(b, 0.25, { Size = Vector3.one * 5 }, Enum.EasingStyle.Back)
				task.delay(0.3, function()
					if b.Parent then
						tween(b, 0.22, { Transparency = 1 })
					end
				end)
			end
		end
	elseif kind == "Stomp" then
		ring(floorAt(caster), FxColor.Earth, 1, 14, 0.5)
		ring(floorAt(caster), Color3.fromRGB(230, 200, 150), 0.5, 9, 0.4)
		for _, m in mobs do
			shards(floorAt(m) + Vector3.new(0, 0.3, 0), Color3.fromRGB(125, 95, 65), 3, 1.8, Vector3.one * 0.5, 1.8)
		end
		TowerFx.shake(0.18, 0.3)
	elseif kind == "Dash" then
		local front = mobs[1]
		if front then
			streak(caster, front, WHITE, 0.5, 0.25)
			streak(caster + Vector3.new(0, 0.8, 0), front + Vector3.new(0, 0.8, 0), Color3.fromRGB(150, 220, 255), 0.25, 0.35)
			ring(front, WHITE, 0.5, 3.5, 0.3)
		end
	elseif kind == "Crit" then
		orb(caster, GOLD, 1, 4.5, 0.35)
		burst(caster, GOLD, SPARK_TEX, 14, 14, 1.1)
	end
end

function TowerFx.clear()
	local f = Workspace:FindFirstChild("TowerFx")
	if f then
		f:Destroy()
	end
	liveCoins = 0
	liveFx = 0
end

return TowerFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="343">
          <Properties>
            <string name="Name">TowerMotion</string>
            <string name="Source"><![CDATA[--!strict
-- Pet Tower fight motion (client only, pure presentation): the pet's turn hop, the hit flinch with a white
-- flash, the knocked-out puff (tip over is TowerView's slide; this fades the body away in a puff of dust),
-- and the revive halo. Every piece cleans itself up; Reduce Motion drops the moves (a flash or fade stays),
-- Low Effects drops the dust and thins the halo.

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)

local TowerMotion = {}

local function setting(key: string): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings[key] == true
end

local function fxFolder(): Folder
	local f = Workspace:FindFirstChild("TowerFx")
	if f and f:IsA("Folder") then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = "TowerFx"
	nf.Parent = Workspace
	return nf
end

-- Drives a 0..1 value over `t` seconds and calls `step` each change (the NumberValue is destroyed at the end).
local function drive(t: number, style: Enum.EasingStyle, dir: Enum.EasingDirection, step: (number) -> (), done: (() -> ())?)
	local n = Instance.new("NumberValue")
	n.Value = 0
	n.Changed:Connect(step)
	local tw = TweenService:Create(n, TweenInfo.new(t, style, dir), { Value = 1 })
	tw.Completed:Connect(function()
		n:Destroy()
		if done then
			done()
		end
	end)
	tw:Play()
end

-- Pet's turn: a small hop forward (an arc up and toward the target), then a hop back home.
-- `ok` is checked before the way back so a pet knocked out mid-hop is not pulled upright again.
function TowerMotion.hop(model: Model, home: CFrame, toward: Vector3, ok: () -> boolean)
	if setting("ReducedMotion") then
		return
	end
	local function arc(from: CFrame, to: CFrame, t: number, h: number, done: (() -> ())?)
		drive(t, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, function(a)
			if model.Parent then
				model:PivotTo(from:Lerp(to, a) * CFrame.new(0, math.sin(a * math.pi) * h, 0))
			end
		end, done)
	end
	local out = home + toward.Unit * 1.4
	arc(home, out, 0.13, 1.1, function()
		if model.Parent and ok() then
			arc(out, home, 0.16, 0.5)
		end
	end)
end

-- Hit: a quick white flash over the whole body, plus a short flinch back (away from the attacker).
function TowerMotion.flinch(model: Model, home: CFrame, away: Vector3, ok: () -> boolean)
	local h = Instance.new("Highlight")
	h.Name = "HitFlash"
	h.FillColor = Color3.new(1, 1, 1)
	h.OutlineColor = Color3.new(1, 1, 1)
	h.FillTransparency = 0.15
	h.OutlineTransparency = 0.4
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Adornee = model
	h.Parent = model
	TweenService:Create(h, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FillTransparency = 1, OutlineTransparency = 1 }):Play()
	Debris:AddItem(h, 0.2)
	if setting("ReducedMotion") or away.Magnitude < 0.1 then
		return
	end
	local back = home + away.Unit * 0.6
	drive(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function(a)
		if model.Parent and ok() then
			model:PivotTo(home:Lerp(back, a))
		end
	end, function()
		drive(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function(a)
			if model.Parent and ok() then
				model:PivotTo(back:Lerp(home, a))
			end
		end)
	end)
end

-- Fades every visible piece of a model with LocalTransparencyModifier (client only, the parts keep their own
-- Transparency, so `unpuff` can bring them back exactly).
local function fadeTo(model: Model, goal: number, t: number)
	local info = TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			if t <= 0 then
				(d :: any).LocalTransparencyModifier = goal
			else
				TweenService:Create(d, info, { LocalTransparencyModifier = goal }):Play()
			end
		elseif d:IsA("Highlight") then
			d.Enabled = goal < 1 -- the boss's red glow and light go with the body
		elseif d:IsA("PointLight") then
			d.Enabled = goal < 1
		end
	end
end

-- Knocked out: after the tip over, a puff of dust and the body fades away (it stays in place, invisible,
-- so a revived pet can come back). `delay` waits for the tip-over slide.
function TowerMotion.puff(model: Model, delay: number, ok: () -> boolean)
	task.delay(delay, function()
		if not model.Parent or not ok() then
			return
		end
		fadeTo(model, 1, 0.3)
		if setting("LowEffects") then
			return -- Low Effects: just the fade, no dust
		end
		local cf, size = model:GetBoundingBox()
		local a = Instance.new("Part")
		a.Name = "KoPuff"
		a.Anchored = true
		a.CanCollide = false
		a.CanQuery = false
		a.CanTouch = false
		a.Transparency = 1
		a.Size = Vector3.new(math.max(size.X, 1), 0.5, math.max(size.Z, 1))
		a.CFrame = CFrame.new(cf.Position)
		a.Parent = fxFolder()
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
		pe.Color = ColorSequence.new(Color3.fromRGB(235, 232, 225))
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 2.6) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
		pe.Lifetime = NumberRange.new(0.4, 0.7)
		pe.Speed = NumberRange.new(3, 6)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Drag = 4
		pe.Rate = 0
		pe.Parent = a
		pe:Emit(10)
		Debris:AddItem(a, 1)
	end)
end

-- Revived: the body shows again (undoes `puff`).
function TowerMotion.unpuff(model: Model)
	fadeTo(model, 0, 0)
end

-- Revive halo: a ring of small gold lights that rises with the pet over its head, then fades.
-- `from` / `to` are the pet's feet before and after the rise; `height` puts the ring above its head.
function TowerMotion.halo(from: CFrame, to: CFrame, height: number, t: number)
	local low = setting("LowEffects")
	local n = if low then 6 else 12
	local ring = Instance.new("Model")
	ring.Name = "ReviveHalo"
	local gold = Color3.fromRGB(255, 225, 110)
	for i = 1, n do
		local ang = (i / n) * math.pi * 2
		local p = Instance.new("Part")
		p.Name = "Bead"
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.one * 0.35
		p.Color = gold
		p.Material = Enum.Material.Neon
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.CFrame = CFrame.new(math.cos(ang) * 1.1, 0, math.sin(ang) * 1.1)
		p.Parent = ring
	end
	ring.WorldPivot = CFrame.new()
	local up = CFrame.new(0, height, 0)
	ring:PivotTo(from * up)
	ring.Parent = fxFolder()
	if not setting("ReducedMotion") then
		drive(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function(a)
			if ring.Parent then
				-- rises with the pet and turns slowly
				ring:PivotTo(from:Lerp(to, a) * up * CFrame.Angles(0, a * math.pi, 0))
			end
		end)
	else
		ring:PivotTo(to * up)
	end
	local fade = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, t + 0.6)
	for _, p in ring:GetChildren() do
		if p:IsA("BasePart") then
			TweenService:Create(p, fade, { Transparency = 1 }):Play()
		end
	end
	Debris:AddItem(ring, t + 1.2)
end

return TowerMotion
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="344">
          <Properties>
            <string name="Name">TowerView</string>
            <string name="Source"><![CDATA[--!strict
-- Pet Tower 3D view: draws the pets and mobs of the current floor, health bars, hit lunges, damage pops
-- ("SUPER!" / "weak"), faints and special bursts. Pure presentation: every number comes from the server.
-- Pets use the shared PetModel when it exists (Find The Pet), else a round stand-in; mobs are procedural
-- stand-ins (REPLACE with real mob meshes).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TowerConfig = require(Shared.TowerConfig)
local FightFxRules = require(Shared.FightFxRules)
local State = require(script.Parent.State)
local Audio = require(script.Parent.Audio)
local TowerFx = require(script.Parent.TowerFx)
local TowerMotion = require(script.Parent.TowerMotion)
local PetMotionBridge = require(script.Parent.PetMotionBridge)

local TowerView = {}

TowerView.TypeColor = {
	Fire = Color3.fromRGB(255, 120, 60),
	Nature = Color3.fromRGB(110, 210, 90),
	Earth = Color3.fromRGB(200, 150, 90),
	Storm = Color3.fromRGB(250, 220, 70),
	Ice = Color3.fromRGB(120, 210, 255),
	Cosmic = Color3.fromRGB(190, 120, 255),
} :: { [string]: Color3 }

type UnitView = {
	Model: Model,
	Home: CFrame,
	Fill: Frame,
	Shield: Frame,
	Max: number,
	Billboard: BillboardGui,
	Fainted: boolean,
	Boss: boolean,
	Element: string?,
	Hp: number,
	FillColor: Color3,
	Shaking: boolean,
	Pet: boolean,
	Ghost: Frame?, -- boss only: the pale bar that drains slowly behind the real one
}

local units: { [string]: UnitView } = {}
local mobOrder: { string } = {} -- this wave's mobs in server order (pets hit the first standing one)
local livePops = 0
local popParts: { [BasePart]: boolean } = {} -- hit numbers on screen (TowerView.hush takes them all down)
local hushed = false -- floor over: no new hit numbers until the next wave is drawn
local marker: BillboardGui? = nil -- small arrow over the mob the pets are hitting
-- Called with (mobs standing, mobs in the wave) whenever that changes; TowerPanel shows it on the floor card.
TowerView.onMobsLeft = function(_left: number, _total: number) end
-- Pet Battle (PvpPanel) draws the rival's pets in the mob line; there is no single front target, so no arrow.
TowerView.showTarget = true
-- Studs between pets in a line (Pet Battle spreads both lines wider so names and bars never overlap).
TowerView.petGap = 5
TowerView.foeGap = 6
TowerView.foeZ = -4 -- Pet Battle: the rival's pet line (PvpPanel sets it from the fight's layout)
TowerView.petZ = -14 -- our pet line (the tower's; the lobby arena puts it nearer the middle)
local MAX_POPS = 3 -- floating hit numbers on screen at once (LowEffects uses LOW_POPS)
local lastOrigin: CFrame? = nil
local popRng = Random.new()
local popState: { [string]: number } = {} -- FightFxRules.popSlot: when each pet's next pop may land
local popSide: { [UnitView]: number } = {} -- which side of each pet its last pop took
-- Bottom of the tower HUD's top-centre block (floor card + LEAVE) in viewport pixels; TowerPanel sets it.
-- Hit numbers start below it. 0 = no limit.
TowerView.topClear = function(): number
	return 0
end

-- Viewer settings: Low Effects keeps at most LOW_POPS damage pops on screen at once (extra ones are skipped);
-- Reduce Motion drops the lunges and hops (units stay home, faints snap).
local LOW_POPS = 3
local function setting(key: string): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings[key] == true
end
local folder: Folder? = nil
local petModel: any = nil

do
	local m = Shared:FindFirstChild("PetModel")
	if m and m:IsA("ModuleScript") then
		local ok, mod = pcall(require, m)
		if ok then
			petModel = mod
		end
	end
end

local function root(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "TowerView"
	f.Parent = Workspace
	folder = f
	return f
end

local function ball(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = Enum.PartType.Ball
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

-- Round critter with big eyes; pivot at the feet, facing -Z. Used for every mob and as the pet fallback.
-- The owner's low-poly mobs (Studio: ReplicatedStorage.MobModels.Mob_<Id>, textured, base-centre pivot, facing -Z):
-- cloned at MOB_HEIGHT; the tower's own slides, lunges and hops move them (PetMotion would pin the pivot).
-- nil when the mob has no model yet, so the round critter stands in.
local MOB_HEIGHT = 3.2
local BOSS_HEIGHT = MOB_HEIGHT * 2.4 -- a boss is drawn this tall (visible height, see visibleHeight): reads as a boss from spawn
local MOB_Z = 3 -- mob line, studs in front of the arena centre (pets stand at -14)

-- Height of what can actually be seen: parts that are fully see-through (a mesh's invisible root or hitbox box,
-- an effect anchor) are left out. Measuring them made a boss whose model carries a big invisible part look "tall
-- enough" already, so it was never scaled up and stood as small as a normal mob (Studio report: /boss 5).
local function visibleHeight(model: Model): number
	local lo, hi = math.huge, -math.huge
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 0.99 then
			local cf, half = d.CFrame, d.Size / 2
			-- world-space vertical reach of the part's box
			local reach = math.abs(cf.RightVector.Y) * half.X + math.abs(cf.UpVector.Y) * half.Y + math.abs(cf.LookVector.Y) * half.Z
			lo = math.min(lo, cf.Position.Y - reach)
			hi = math.max(hi, cf.Position.Y + reach)
		end
	end
	if hi < lo then
		return model:GetExtentsSize().Y
	end
	return hi - lo
end
local function mobBody(kind: string, name: string): Model?
	local lib = ReplicatedStorage:FindFirstChild("MobModels")
	local src = lib and lib:FindFirstChild("Mob_" .. kind)
	if not (src and src:IsA("Model")) then
		return nil
	end
	local m = src:Clone()
	m.Name = name
	local h = visibleHeight(m)
	if h > 0 then
		m:ScaleTo(m:GetScale() * MOB_HEIGHT / h)
	end
	return m
end

local function critter(name: string, color: Color3, scale: number, boss: boolean): Model
	local m = Instance.new("Model")
	m.Name = name
	local s = scale
	local body = ball(m, "Body", Vector3.new(3.2, 2.8, 3.2) * s, CFrame.new(0, 1.4 * s, 0), color)
	for _, x in { -0.6, 0.6 } do
		ball(m, "Eye", Vector3.new(0.8, 0.9, 0.5) * s, CFrame.new(x * s, 1.9 * s, -1.35 * s), Color3.new(1, 1, 1))
		ball(m, "Pupil", Vector3.new(0.42, 0.5, 0.3) * s, CFrame.new(x * s, 1.85 * s, -1.55 * s), Color3.fromRGB(30, 30, 40))
	end
	if boss then
		local crown = Instance.new("Part")
		crown.Name = "Crown"
		crown.Size = Vector3.new(1.6, 0.8, 1.6) * s
		crown.CFrame = CFrame.new(0, 3.1 * s, 0)
		crown.Color = Color3.fromRGB(255, 200, 60)
		crown.Material = Enum.Material.Neon
		crown.Anchored = true
		crown.CanCollide = false
		crown.CanQuery = false
		crown.Parent = m
	end
	m.PrimaryPart = body
	m.WorldPivot = CFrame.new()
	return m
end

local function petBody(u: any): Model
	if petModel and u.Spec then
		local ok, model = pcall(petModel.build, u.Spec)
		if ok and typeof(model) == "Instance" and model:IsA("Model") then
			return model
		end
	end
	return critter(u.Name, TowerView.TypeColor[u.Element] or Color3.new(1, 1, 1), 0.8, false)
end

-- Boss (carter): a giant, angry version of a pet: scaled up, tinted red, glowing red eyes.
local ANGRY = Color3.fromRGB(220, 40, 40)
local function bossBody(u: any, petId: string): Model
	local model: Model? = nil
	if petModel then
		local ok, m = pcall(petModel.build, { Mineral = petId, Rarity = "Epic", Modifier = "Natural", Formation = "Standing", Mass = 2, Seed = 1 }, { Scale = 3 })
		if ok and typeof(m) == "Instance" and m:IsA("Model") then
			model = m
		end
	end
	if model == nil then
		return critter(u.Name, TowerView.TypeColor[u.Element] or ANGRY, 2.4, true)
	end
	local textured = false
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Name == "Eye" then
				d.Color = Color3.fromRGB(255, 40, 30)
				d.Material = Enum.Material.Neon
			else
				d.Color = d.Color:Lerp(ANGRY, 0.45)
			end
			if d:IsA("MeshPart") and d.TextureID ~= "" then
				textured = true
			end
		end
	end
	-- the owner's low-poly pets are textured meshes, which ignore Color: TowerFx.bossGlow keeps a stronger red fill
	model:SetAttribute("TexturedBoss", textured)
	return model
end

local PLATE_MIN_TEXT = 12 -- nameplate words (name, HP numbers) never draw under this many px
local PLATE_LIFT = 0.8 -- studs between a fighter's top and the centre of its nameplate (a boss: BOSS_PLATE_LIFT, bottom edge)
local BOSS_PLATE_LIFT = 2.2
local POP_ABOVE_PLATE = 28 -- px between the nameplate's top edge and a hit number's bottom edge when it pops

local function billboard(model: Model, u: any, height: number): (BillboardGui, Frame, Frame, Frame?)
	local bb = Instance.new("BillboardGui")
	bb.Name = "TowerBar"
	-- small enemies show just their health bar (red), pets and bosses their name too: fewer stacked labels,
	-- and the type shows as the name's colour instead of a second word
	-- sizes (bug 240): names and bars read at phone size next to the hit numbers; a boss gets a wide name bar
	local named = u.Owner ~= 0 or u.Boss == true
	local boss = u.Boss == true
	-- (Studio check 2026-10-15: names and numbers read small at phone size): taller lines, text never under 12 px
	local nameH = if boss then 26 else 22
	local barH = if boss then 20 else 18
	bb.Size = if boss then UDim2.fromOffset(210, nameH + barH + 5)
		elseif named then UDim2.fromOffset(150, nameH + barH + 5)
		else UDim2.fromOffset(104, 14)
	bb.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 140
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, nameH)
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = (Color3.new(1, 1, 1):Lerp(TowerView.TypeColor[u.Element] or Color3.new(1, 1, 1), 0.35))
	name.TextStrokeTransparency = 0.2
	name.Text = u.Name
	name.Visible = named
	local nameMin = Instance.new("UITextSizeConstraint")
	nameMin.MinTextSize = PLATE_MIN_TEXT
	nameMin.Parent = name
	name.Parent = bb
	local track = Instance.new("Frame")
	track.Position = if named then UDim2.fromOffset(10, nameH + 3) else UDim2.fromOffset(4, 1)
	track.Size = if named then UDim2.new(1, -20, 0, barH) else UDim2.new(1, -8, 0, 12)
	track.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
	track.BorderSizePixel = 0
	track.Parent = bb
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 5)
	c.Parent = track
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(math.clamp(u.Hp / math.max(u.Max, 1), 0, 1), 1)
	fill.BackgroundColor3 = if u.Owner == 0 then Color3.fromRGB(240, 80, 70) else Color3.fromRGB(90, 220, 90)
	fill.BorderSizePixel = 0
	fill.Parent = track
	c:Clone().Parent = fill
	fill.ZIndex = 2
	local ghost: Frame? = nil
	if u.Boss == true then
		-- boss "ghost" bar: a pale strip under the fill that catches up slowly after each hit (see setFill)
		local g = Instance.new("Frame")
		g.Name = "Ghost"
		g.Size = fill.Size
		g.BackgroundColor3 = Color3.fromRGB(255, 225, 200)
		g.BorderSizePixel = 0
		g.ZIndex = 1
		g.Parent = track
		c:Clone().Parent = g
		ghost = g
	end
	if u.Owner ~= 0 then
		-- pet bars carry their numbers so health stays readable at a glance
		local hpText = Instance.new("TextLabel")
		hpText.Name = "HpText"
		hpText.BackgroundTransparency = 1
		hpText.Size = UDim2.fromScale(1, 1)
		hpText.Font = Enum.Font.FredokaOne
		hpText.TextScaled = true
		hpText.TextColor3 = Color3.new(1, 1, 1)
		hpText.TextStrokeTransparency = 0.2
		hpText.ZIndex = 3
		hpText.Text = string.format("%d/%d", math.ceil(u.Hp), u.Max)
		local hpMin = Instance.new("UITextSizeConstraint")
		hpMin.MinTextSize = PLATE_MIN_TEXT
		hpMin.Parent = hpText
		hpText.Parent = track
	end
	local shield = Instance.new("Frame")
	shield.Size = UDim2.fromScale(0, 0.4)
	shield.BackgroundColor3 = Color3.fromRGB(120, 200, 255)
	shield.BorderSizePixel = 0
	shield.ZIndex = 2
	shield.Parent = track
	-- adorned to a part of this model (pet and mob meshes keep their parts in sub-models, so search deep): a bar
	-- with no adornee drew at the world origin, which put every bar in one pile at the top of the screen.
	-- It floats just above the model's real top, whatever the model's size.
	local adornee = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if adornee then
		bb.Adornee = adornee
		local cf, size = model:GetBoundingBox()
		local top = cf.Position.Y + size.Y / 2 - adornee.Position.Y
		if boss then
			-- a boss's wide name + bar sits well clear of its head, bottom edge on the anchor (SizeOffset), so it
			-- never lands on the pets' bars in front of it on screen
			bb.StudsOffsetWorldSpace = Vector3.new(0, math.max(top + BOSS_PLATE_LIFT, 3), 0)
			bb.SizeOffset = Vector2.new(0, 0.5)
		else
			bb.StudsOffsetWorldSpace = Vector3.new(0, math.max(top + PLATE_LIFT, 1.5), 0)
		end
		-- a bar whose part goes away (a mesh swapped or removed) would lose its adornee and draw at the world
		-- origin, which is the lobby (bug 252: dark bars floating in the pen): it goes with its part
		adornee.AncestryChanged:Connect(function()
			if not adornee:IsDescendantOf(Workspace) then
				bb:Destroy()
			end
		end)
	else
		bb.Enabled = false
	end
	bb.Parent = model
	return bb, fill, shield, ghost
end

-- Sets a bar's fill: eases to the new size (snaps with Reduce Motion) and keeps the pet "hp/max" text readable.
local function setFill(v: UnitView, hp: number)
	local f = math.clamp(hp / math.max(v.Max, 1), 0, 1)
	if setting("ReducedMotion") then
		v.Fill.Size = UDim2.fromScale(f, 1)
	else
		TweenService:Create(v.Fill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromScale(f, 1) }):Play()
	end
	local g = v.Ghost
	if g then
		if f >= g.Size.X.Scale or setting("ReducedMotion") then
			g.Size = UDim2.fromScale(f, 1) -- healed (or Reduce Motion): the ghost snaps with the bar
			g:SetAttribute("To", f)
		elseif g:GetAttribute("To") ~= f then
			-- only a new value restarts the drain (batches repeat unchanged health every tick)
			g:SetAttribute("To", f)
			-- drains after a short wait, slower than the real bar (a new tween on Size replaces the old one)
			TweenService:Create(g, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, 0, false, 0.45), { Size = UDim2.fromScale(f, 1) }):Play()
		end
	end
	local track = v.Fill.Parent
	local t = if track then track:FindFirstChild("HpText") else nil
	if t and t:IsA("TextLabel") then
		t.Text = string.format("%d/%d", math.ceil(hp), v.Max)
	end
end

-- World height of the fighting floor's top: TowerBuilder's floor collider ends at the arena origin's height.
local FLOOR_TOP = 0
local function floorTop(origin: CFrame): number
	return origin.Position.Y + FLOOR_TOP
end

-- The home spot moved up or down so the model's lowest point rests on the floor top (whatever its pivot).
local function seat(model: Model, home: CFrame, floorY: number): CFrame
	model:PivotTo(home)
	local cf, size = model:GetBoundingBox()
	local bottom = cf.Position.Y - size.Y / 2
	return home + Vector3.new(0, math.clamp(floorY - bottom, -4, 4), 0)
end

-- Floor cleared: the far gate lights up (the way on).
function TowerView.cleared()
	if not setting("ReducedMotion") then
		-- happy hop: every standing pet jumps twice (no faces involved)
		for _, v in units do
			if not v.Fainted and not v.Boss and v.Billboard.Parent and v.Home.LookVector.Z > 0 then
				task.spawn(function()
					for _ = 1, 2 do
						if not v.Model.Parent then
							return
						end
						TowerView.slide(v.Model, v.Home * CFrame.new(0, 1.6, 0), 0.14)
						task.wait(0.16)
						TowerView.slide(v.Model, v.Home, 0.14)
						task.wait(0.18)
					end
				end)
			end
		end
	end
	if lastOrigin then
		TowerFx.gateLight(lastOrigin)
	end
end

-- Floor over (cleared or lost): every hit number and SPECIAL! word comes down at once so none shows behind the
-- floor-end card (bug 241); new ones stay off until the next wave is drawn.
function TowerView.hush()
	hushed = true
	TowerFx.fightStopped()
	for p in popParts do
		p:Destroy()
	end
	table.clear(popParts)
	livePops = 0
	table.clear(popState)
	table.clear(popSide)
	if marker then
		marker:Destroy()
		marker = nil
	end
end

function TowerView.clear()
	TowerView.hush()
	TowerFx.clear()
	lastOrigin = nil
	for _, v in units do
		v.Model:Destroy()
	end
	table.clear(units)
	table.clear(mobOrder)
	-- the whole view folder goes too, so no bar or label is left behind in the lobby (bug 252)
	if folder then
		folder:Destroy()
		folder = nil
	end
	for _, d in Workspace:GetDescendants() do
		if d:IsA("BillboardGui") and (d.Name == "TowerBar" or d.Name == "TowerTarget") then
			d:Destroy()
		end
	end
end

-- Puts the target arrow over the first standing mob (the one the pets hit) and reports how many are left.
local function refreshTargets()
	local front: UnitView? = nil
	local left = 0
	for _, id in mobOrder do
		local v = units[id]
		if v and not v.Fainted then
			left += 1
			if front == nil then
				front = v
			end
		end
	end
	TowerView.onMobsLeft(left, #mobOrder)
	if not TowerView.showTarget then
		front = nil
	end
	local bar: BillboardGui? = if front and front.Billboard.Parent then front.Billboard else nil
	local at: Instance? = if bar then bar.Adornee else nil
	if marker and (at == nil or hushed or marker.Adornee ~= at) then
		marker:Destroy()
		marker = nil
	end
	if bar == nil or at == nil or hushed or marker then
		return
	end
	local m = Instance.new("BillboardGui")
	m.Name = "TowerTarget"
	m.Adornee = at
	m.StudsOffsetWorldSpace = bar.StudsOffsetWorldSpace
	m.Size = UDim2.fromOffset(34, 30)
	-- sits just above the name / health bar on screen
	m.SizeOffset = Vector2.new(0, 0.5 + bar.Size.Y.Offset / 30 * (0.5 + bar.SizeOffset.Y) + 0.2)
	m.AlwaysOnTop = true
	m.MaxDistance = 140
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = "▼"
	l.TextColor3 = Color3.fromRGB(255, 220, 70)
	l.TextStrokeTransparency = 0
	l.Parent = m
	if not setting("ReducedMotion") then
		l.Position = UDim2.fromOffset(0, -4)
		TweenService:Create(l, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.fromOffset(0, 3) }):Play()
	end
	m.Parent = bar.Parent
	marker = m
end

-- Draws a fresh wave: pets keep their spots, mobs are replaced.
-- The origin's flat +Z: the way our pets face (towards the mobs or the rival team). The lobby stadium's origin is
-- turned, so world +Z would leave both teams side-on (Studio test 2026-10-14).
local function forward(origin: CFrame): Vector3
	local z = origin:VectorToWorldSpace(Vector3.zAxis)
	z = Vector3.new(z.X, 0, z.Z)
	return if z.Magnitude > 1e-3 then z.Unit else Vector3.zAxis
end

function TowerView.floor(msg: any)
	local origin: CFrame = msg.Origin
	lastOrigin = origin
	hushed = false
	local pets, mobs = {}, {}
	for _, u in msg.Units do
		if u.Owner == 0 then
			table.insert(mobs, u)
		else
			table.insert(pets, u)
		end
	end
	local keep: { [string]: boolean } = {}
	for i, u in pets do
		keep[u.Id] = true
		if units[u.Id] == nil then
			local x = (i - (#pets + 1) / 2) * TowerView.petGap
			local pos = origin * Vector3.new(x, 0, TowerView.petZ)
			local home = CFrame.lookAt(pos, pos + forward(origin)) -- faces the mobs / the rival team (the origin's +Z)
			local model = petBody(u)
			model:PivotTo(home)
			model.Parent = root()
			local bb, fill, shield = billboard(model, u, 5)
			units[u.Id] = {
				Model = model, Home = home, Fill = fill, Shield = shield, Max = u.Max, Billboard = bb, Fainted = u.Hp <= 0,
				Boss = false, Element = u.Element, Hp = u.Hp, FillColor = fill.BackgroundColor3, Shaking = false, Pet = true,
			}
		else
			local v = units[u.Id]
			if v.Fainted and u.Hp > 0 then
				-- revived: stand back up (a kept unit would otherwise stay lying down with its bar hidden)
				v.Fainted = false
				v.Hp = u.Hp
				v.Max = u.Max
					setFill(v, u.Hp)
				v.Billboard.Enabled = true
				-- rises up from the floor, upright, under a ring of gold lights
				local below = v.Home * CFrame.new(0, -2, 0)
				TowerMotion.unpuff(v.Model)
				v.Model:PivotTo(below)
				local _, size = v.Model:GetBoundingBox() -- measured upright, not lying down
				TowerView.slide(v.Model, v.Home, 0.6)
				TowerMotion.halo(below, v.Home, size.Y + 0.6, 0.6)
			end
		end
	end
	table.clear(mobOrder)
	for i, u in mobs do
		keep[u.Id] = true
		table.insert(mobOrder, u.Id)
		if units[u.Id] == nil then
			local x = (i - (#mobs + 1) / 2) * (if u.Boss then 9 else TowerView.foeGap)
			-- close to the pet line (z -14), so a new wave is in the fight at once (bug 250: z 12 read as far away)
			local pos = origin * Vector3.new(x, 0, if u.Boss then MOB_Z + 5 elseif u.Foe then TowerView.foeZ else MOB_Z)
			local mob = TowerConfig.Mobs[u.Kind]
			-- a rival's pet (Pet Battle) is drawn as the pet it is
			local model = if u.Foe then petBody(u)
				elseif mob and mob.Pet then bossBody(u, mob.Pet)
				else (not u.Boss and mobBody(tostring(u.Kind), u.Name))
					or critter(u.Name, TowerView.TypeColor[u.Element] or Color3.new(1, 1, 1), if u.Boss then 2.4 else 1, u.Boss)
			if u.Boss then
				-- a boss always towers over the normal mobs (bug 251: a pet mesh that ignored PetModel's Scale
				-- came out normal-sized)
				local h = visibleHeight(model)
				if h > 0 and (h < BOSS_HEIGHT or h > BOSS_HEIGHT * 1.6) then
					model:ScaleTo(model:GetScale() * BOSS_HEIGHT / h)
				end
			end
			-- faces the pets (-Z), feet on the floor top (a mesh whose pivot is not at its base sank into the floor)
			local home = seat(model, CFrame.lookAt(pos, pos - forward(origin)), floorTop(origin))
			model:PivotTo(home * CFrame.new(0, 0, -0.01))
			model.Parent = root()
			local bb, fill, shield, ghost = billboard(model, u, if u.Boss then 9 else 4.5)
			units[u.Id] = {
				Model = model, Home = home, Fill = fill, Shield = shield, Max = u.Max, Billboard = bb, Fainted = false,
				Boss = u.Boss == true, Element = u.Element, Hp = u.Hp, FillColor = fill.BackgroundColor3, Shaking = false, Pet = false,
				Ghost = ghost,
			}
			-- pop in from the gate
			model:PivotTo(home * CFrame.new(0, 0, 8))
			TowerView.slide(model, home, 0.5)
			if u.Boss then
				-- entrance: the ground rumbles as it lands, and it flares red
				TowerFx.bossGlow(model)
				task.delay(0.4, function()
					if model.Parent then
						TowerFx.shake(0.3, 0.7)
					end
				end)
			end
		end
	end
	for id, v in units do
		if not keep[id] then
			v.Model:Destroy()
			units[id] = nil
		end
	end
	refreshTargets()
end

function TowerView.slide(model: Model, to: CFrame, t: number)
	if setting("ReducedMotion") then
		model:PivotTo(to)
		return
	end
	local v = Instance.new("CFrameValue")
	v.Value = model:GetPivot()
	v.Changed:Connect(function(cf)
		if model.Parent then
			model:PivotTo(cf)
		end
	end)
	local tw = TweenService:Create(v, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = to })
	tw.Completed:Connect(function()
		v:Destroy()
	end)
	tw:Play()
end

-- Floating hit number: pops in big (a quick scale bounce), drifts up and a little sideways, then fades.
-- Strong hits can carry a type badge: the attacker's type colour with an arrow (up = strong, down = weak).
-- `abovePx`: the label's bottom edge sits this many px above `at` on screen (it rises from above the nameplate,
-- never through it: the "Weak" tag sat on "Shadowfang 183/222", Studio check 2026-10-15).
local function pop(at: Vector3, text: string, color: Color3, big: boolean, badge: Color3?, badgeUp: boolean?, crit: boolean?, slot: number?, abovePx: number?)
	if hushed or (setting("LowEffects") and livePops >= LOW_POPS) or (livePops >= MAX_POPS and not big) then
		return -- a few numbers at once stay readable; a pile of them hides the fighters (big hits always show)
	end
	livePops += 1
	local reduced = setting("ReducedMotion")
	at += Vector3.new(0, popRng:NextNumber(-0.3, 0.3), 0)
	local bbH = if crit then 42 elseif big then 34 else 26
	local liftPx = (abovePx or 0) + bbH / 2 -- where the label's centre lands above `at`, in screen px
	-- never under the tower HUD at the top centre (floor card, LEAVE) nor off the top of the screen (a lifted number
	-- over a fighter near the top edge): a number that would land there is moved down below it and does not drift up
	local rise = if (abovePx or 0) > 0 then 0.9 else 1.4 -- a number already lifted over the plate needs less climb
	local cam = Workspace.CurrentCamera
	local band = math.max(TowerView.topClear(), 0)
	if cam then
		local sp, onScreen = cam:WorldToViewportPoint(at)
		local want = band + (if crit then 40 else 30) + liftPx
		if onScreen and sp.Z > 0 and sp.Y < want then
			local ray = cam:ViewportPointToRay(sp.X, want)
			local along = ray.Direction:Dot(cam.CFrame.LookVector)
			if along > 0.05 then
				at = ray.Origin + ray.Direction * (sp.Z / along)
				rise = 0
			end
		end
		-- and its climb stops short of the top too (a fighter near the top edge sent its number off the screen)
		if rise > 0 then
			local ep, endOn = cam:WorldToViewportPoint(at + Vector3.new(0, rise, 0))
			if endOn and ep.Z > 0 and ep.Y < want then
				rise = 0
			end
		end
	end
	local a = Instance.new("Part")
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.CanTouch = false
	a.Transparency = 1
	a.Size = Vector3.one * 0.2
	a.Position = at
	a.Parent = root()
	popParts[a] = true
	local bb = Instance.new("BillboardGui")
	-- kept modest (bug 240): the numbers must not outshout the names and bars over the fighters
	bb.Size = UDim2.fromOffset(if crit then 150 elseif big then 118 else 80, bbH)
	bb.AlwaysOnTop = true
	bb.Adornee = a
	-- the label starts `abovePx` over its anchor (clear of the nameplate), and a pet's second and third live pop sit
	-- one label height higher each, in screen space (FightFxRules.popSlot), so they never cover each other however
	-- far the camera is
	bb.SizeOffset = Vector2.new(0, liftPx / bbH + (slot or 0) * 1.1)
	local scale = Instance.new("UIScale")
	scale.Scale = if reduced then 1 else 0.4
	scale.Parent = bb
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 1
	l.Text = if crit then "CRIT! " .. text else text
	if crit then
		l.TextColor3 = Color3.fromRGB(255, 210, 60)
	end
	-- thick near-black outline: numbers stay readable over the red danger floor, fire and bright skies
	local outline = Instance.new("UIStroke")
	outline.Name = "Outline"
	outline.Color = Color3.fromRGB(20, 16, 28)
	outline.Thickness = if big or crit then 3 else 2.5
	outline.LineJoinMode = Enum.LineJoinMode.Round
	outline.Parent = l
	l.Parent = bb
	local fades: { Instance } = { l }
	if badge then
		-- type badge left of the number: coloured disc with an up/down arrow, flashing twice
		bb.Size += UDim2.fromOffset(28, 0)
		l.Position = UDim2.fromOffset(28, 0)
		l.Size = UDim2.new(1, -28, 1, 0)
		local d = Instance.new("TextLabel")
		d.Name = "TypeBadge"
		d.AnchorPoint = Vector2.new(0, 0.5)
		d.Position = UDim2.new(0, 2, 0.5, 0)
		d.Size = UDim2.fromOffset(24, 24)
		d.BackgroundColor3 = badge
		d.Font = Enum.Font.FredokaOne
		d.TextScaled = true
		d.TextColor3 = Color3.new(1, 1, 1)
		d.TextStrokeTransparency = 0.3
		d.Text = if badgeUp then "▲" else "▼"
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = d
		local st = Instance.new("UIStroke")
		st.Color = Color3.new(1, 1, 1)
		st.Thickness = 2
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Parent = d
		d.Parent = bb
		table.insert(fades, d)
		if not reduced then
			TweenService:Create(d, TweenInfo.new(0.12, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, 3, true), { BackgroundColor3 = Color3.new(1, 1, 1) }):Play()
		end
	end
	bb.Parent = a
	local drift = if reduced then Vector3.zero else Vector3.new((math.random() - 0.5) * 1.6, 0, 0)
	if not reduced then
		TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = if crit then 1.2 elseif big then 1.08 else 1 }):Play()
		if crit then
			-- crit: the number spins once as it pops in
			l.Rotation = -360
			TweenService:Create(l, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
		end
	end
	TweenService:Create(a, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = at + Vector3.new(0, rise, 0) + drift }):Play()
	local fadeInfo = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.4)
	for _, f in fades do
		if f:IsA("TextLabel") then
			TweenService:Create(f, fadeInfo, { TextTransparency = 1, TextStrokeTransparency = 1, BackgroundTransparency = 1 }):Play()
			local st = f:FindFirstChildOfClass("UIStroke")
			if st then
				TweenService:Create(st, fadeInfo, { Transparency = 1 }):Play()
			end
		end
	end
	task.delay(0.9, function()
		if popParts[a] then
			popParts[a] = nil
			livePops -= 1
		end
		a:Destroy()
	end)
end

-- Health bar hit: the bar flashes red/white and gives a short horizontal shake (no shake with Reduce Motion).
local HIT_RED = Color3.fromRGB(255, 60, 50)
local function barHit(v: UnitView)
	local fill = v.Fill
	local track = fill.Parent :: Frame?
	if track == nil then
		return
	end
	fill.BackgroundColor3 = Color3.new(1, 1, 1)
	TweenService:Create(fill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = v.FillColor }):Play()
	track.BackgroundColor3 = HIT_RED
	TweenService:Create(track, TweenInfo.new(0.3), { BackgroundColor3 = Color3.fromRGB(30, 30, 34) }):Play()
	if v.Shaking or setting("ReducedMotion") then
		return
	end
	v.Shaking = true
	local home = track.Position
	task.spawn(function()
		for i, dx in { -4, 4, -3, 2, 0 } do
			if not track.Parent then
				break
			end
			track.Position = home + UDim2.fromOffset(dx, 0)
			if i < 5 then
				task.wait(0.03)
			end
		end
		track.Position = home
		v.Shaking = false
	end)
end

-- Where a unit's hit number is anchored: the centre of its nameplate (the same point `billboard` floats the plate
-- at), stepped a little left or right as the camera sees it. The label itself is lifted above the plate in screen
-- px (pop's `abovePx`, from popClear), so it rises from over the name, never through it.
local function popSpot(v: UnitView, lift: number?, slot: number?): Vector3
	local cf, size = v.Model:GetBoundingBox()
	local cam = Workspace.CurrentCamera
	local right = if cam then cam.CFrame.RightVector * Vector3.new(1, 0, 1) else Vector3.xAxis
	right = if right.Magnitude > 0.1 then right.Unit else Vector3.xAxis
	-- a pet's first pop takes a random side, the next ones swap sides and climb a step (FightFxRules.popSlot)
	local side = popSide[v]
	if not side or (slot or 0) == 0 then
		side = if popRng:NextNumber() < 0.5 then -1 else 1
	else
		side = -side
	end
	popSide[v] = side
	local out = popRng:NextNumber(0.3, 0.9)
	local plateY = cf.Position.Y + size.Y * 0.5 + (if v.Boss then BOSS_PLATE_LIFT else PLATE_LIFT)
	local pivot = v.Model:GetPivot().Position
	return Vector3.new(pivot.X, math.max(plateY, pivot.Y + 1.5), pivot.Z) + right * side * out + Vector3.new(0, lift or 0, 0)
end

-- Screen px from a unit's plate anchor to where its hit numbers start: the plate's half height (its whole height
-- for a boss, whose plate hangs its bottom edge on the anchor) plus POP_ABOVE_PLATE.
local function popClear(v: UnitView): number
	local plateH = v.Billboard.Size.Y.Offset
	return plateH * (if v.Boss then 1 else 0.5) + POP_ABOVE_PLATE
end

-- A pop on unit `v`, staggered in time and place so one batch of hits never lands as one stack of text.
local function popOn(key: string, v: UnitView, lift: number?, text: string, color: Color3, big: boolean, badge: Color3?, badgeUp: boolean?, crit: boolean?)
	local wait, slot = FightFxRules.popSlot(popState, key, os.clock())
	local function go()
		if v.Model.Parent then
			pop(popSpot(v, lift, slot), text, color, big, badge, badgeUp, crit, slot, popClear(v))
		end
	end
	if wait <= 0 then
		go()
	else
		task.delay(wait, go)
	end
end

-- Middle of a unit's body (for move effects).
local function bodyAt(v: UnitView): Vector3
	local cf, size = v.Model:GetBoundingBox()
	return cf.Position + Vector3.new(0, size.Y * 0.1, 0)
end

-- One server event batch. `hp` = { [id] = { hp, shield } } after the batch.
function TowerView.events(list: { any }, hp: { [string]: any })
	local critFrom: { [string]: boolean } = {}
	for _, e in list do
		if e.Kind == "Hit" then
			TowerFx.fightStarted() -- no title pill over a fight
			local from, to = units[e.From or ""], units[e.To or ""]
			if from and from.Pet and not from.Fainted and to then
				-- pet's turn: a little hop toward its target (TowerMotion skips it with Reduce Motion)
				local toward = (to.Home.Position - from.Home.Position) * Vector3.new(1, 0, 1)
				if toward.Magnitude > 0.1 then
					local f = from
					TowerMotion.hop(f.Model, f.Home, toward, function()
						return not f.Fainted
					end)
				end
			elseif from and not from.Fainted and to and not setting("ReducedMotion") then
				local toward = (to.Home.Position - from.Home.Position) * Vector3.new(1, 0, 1)
				if toward.Magnitude > 0.1 then
					local lunge = from.Home + toward.Unit * 1.6
					TowerView.slide(from.Model, lunge, 0.08)
					task.delay(0.1, function()
						TowerView.slide(from.Model, from.Home, 0.15)
					end)
				end
			end
			if to then
				local strong, weak = e.Id == "Strong", e.Id == "Weak"
				local text = tostring(e.Amount or 0) .. (if strong then " Strong!" elseif weak then " Weak" else "")
				local color = if strong then Color3.fromRGB(90, 235, 100) elseif weak then Color3.fromRGB(215, 215, 225) else Color3.new(1, 1, 1)
				local attacker = from and from.Element
				local badge = if (strong or weak) and attacker then TowerView.TypeColor[attacker] else nil
				local crit = e.Crit == true or (from ~= nil and critFrom[e.From or ""] == true)
				popOn(e.To or "", to, nil, text, color, strong or crit, badge, strong, crit)
				-- each move kind has its own look: attacker type sets the shape, the grade sets size / extras
				local grade = if crit then "Crit" elseif strong then "Strong" elseif weak then "Weak" else nil
				TowerFx.hit(if from then bodyAt(from) else nil, bodyAt(to), to.Home.Position.Y, attacker, grade)
				if not to.Fainted then
					local t = to
					local away = if from then (t.Home.Position - from.Home.Position) * Vector3.new(1, 0, 1) else Vector3.zero
					TowerMotion.flinch(t.Model, t.Home, away, function()
						return not t.Fainted
					end)
				end
				Audio.play("TowerHit", { Pos = to.Home.Position, Pitch = if strong then 1.12 elseif weak then 0.9 else 1 }) -- PetSoundIds.TowerHit
				if crit then
					Audio.play("PetCrit", { Pos = to.Home.Position }) -- PetSoundIds.PetCrit (0 = silent)
				end
			end
		elseif e.Kind == "Faint" then
			local v = units[e.To or ""]
			if v and not v.Fainted then
				v.Fainted = true
				Audio.play("PetKO", { Pos = v.Home.Position }) -- cartoon slide-whistle + puff, no voice (PetSoundIds.PetKO)
				TowerView.slide(v.Model, v.Home * CFrame.new(0, -0.6, 0) * CFrame.Angles(0, 0, math.rad(80)), 0.35)
				v.Billboard.Enabled = false
				TowerMotion.puff(v.Model, if v.Boss then 0.5 else 0.4, function()
					return v.Fainted
				end)
				if v.Boss then
					local pivot = v.Model:GetPivot().Position
					TowerFx.bossBurst(pivot + Vector3.new(0, 4, 0), pivot.Y)
					TowerFx.shake(0.2, 0.4)
				end
			end
		elseif e.Kind == "Special" then
			-- a crit special (Lucky Hit): its hits later in this batch pop as crits
			local sp = TowerConfig.Specials
			local kind: string? = nil
			for _, d in sp do
				if d.Id == e.Id then
					kind = d.Kind
					if d.Kind == "Crit" and e.From then
						critFrom[e.From] = true
					end
				end
			end
			local v = units[e.From or ""]
			if v then
				if kind then
					local mobs, pets = {}, {}
					for _, id in mobOrder do
						local m = units[id]
						if m and not m.Fainted then
							table.insert(mobs, bodyAt(m))
						end
					end
					for _, u in units do
						if u.Pet and not u.Fainted then
							table.insert(pets, bodyAt(u))
						end
					end
					-- a rival's SPECIAL (Pet Battle) lands on our pets
					if v.Pet then
						TowerFx.special(kind, bodyAt(v), mobs, pets, v.Home.Position.Y)
					else
						TowerFx.special(kind, bodyAt(v), pets, mobs, v.Home.Position.Y)
					end
				end
				popOn(e.From or "", v, 0.6, "SPECIAL!", Color3.fromRGB(255, 170, 255), true)
				Audio.play("TowerSpecial", { Pos = v.Home.Position }) -- PetSoundIds.TowerSpecial
				if not setting("ReducedMotion") then
					TowerView.slide(v.Model, v.Home * CFrame.new(0, 2.5, 0), 0.12)
					task.delay(0.15, function()
						TowerView.slide(v.Model, v.Home, 0.2)
					end)
				end
			end
		end
	end
	for id, pair in hp do
		local v = units[id]
		if v and type(pair) == "table" then
			local now = pair[1] or 0
			if now < v.Hp and not v.Fainted then
				barHit(v)
			end
			v.Hp = now
				setFill(v, pair[1] or 0)
			v.Shield.Size = UDim2.fromScale(math.clamp((pair[2] or 0) / math.max(v.Max, 1), 0, 1), 0.4)
		end
	end
	refreshTargets()
end

-- A drawn unit's model (Pet Battle finisher camera).
function TowerView.model(id: string): Model?
	local v = units[id]
	return if v then v.Model else nil
end

-- Pet Battle finisher (the loser's view): the winning pet glows in its rarity colour under a big card with its power,
-- rarity and level, so the player sees exactly what beat them.
function TowerView.showcase(id: string, title: string, sub: string, color: Color3)
	local v = units[id]
	if not v then
		return
	end
	TowerFx.bossGlow(v.Model, color)
	local _, size = v.Model:GetBoundingBox()
	local bb = Instance.new("BillboardGui")
	bb.Name = "TowerBar" -- cleared with the other bars (TowerView.clear)
	bb.Adornee = (v.Model.PrimaryPart or v.Model:FindFirstChildWhichIsA("BasePart")) :: any
	bb.Size = UDim2.fromOffset(260, 76)
	bb.StudsOffsetWorldSpace = Vector3.new(0, size.Y * 0.5 + 3.2, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	local function line(text: string, y: number, h: number, c: Color3)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromOffset(0, y)
		l.Size = UDim2.new(1, 0, 0, h)
		l.Font = Enum.Font.FredokaOne
		l.TextScaled = true
		l.Text = text
		l.TextColor3 = c
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(20, 16, 28)
		st.Thickness = 3
		st.Parent = l
		l.Parent = bb
	end
	line(title, 0, 44, color)
	line(sub, 46, 30, Color3.new(1, 1, 1))
	bb.Parent = v.Model
	if not setting("ReducedMotion") then
		local sc = Instance.new("UIScale")
		sc.Scale = 0.3
		sc.Parent = bb
		TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end

-- Pet Battle KO: a big "K.O.!" pop over the last pet to fall, a ground burst and a shake.
function TowerView.knockout(id: string?)
	local v = units[id or ""]
	if v then
		local at = v.Model:GetPivot().Position
		pop(at + Vector3.new(0, 5, 0), "K.O.!", Color3.fromRGB(255, 90, 70), true)
		TowerFx.bossBurst(at + Vector3.new(0, 3, 0), v.Home.Position.Y)
	end
	TowerFx.shake(0.35, 0.5)
end

-- Pet Battle victory pose: the standing pets of the winning side (`mine` = the viewer's) jump and spin three times
-- with a gold ring under them (no mouth or roar, carter's rule). Reduce Motion: one small hop.
function TowerView.cheer(mine: boolean)
	hushed = true
	for _, v in units do
		if v.Pet == mine and not v.Fainted then
			local model, home = v.Model, v.Home
			PetMotionBridge.play(model, "win") -- the owner's win clip when PetMotion has one (no roar, no mouth)
			if setting("ReducedMotion") then
				TowerView.slide(model, home * CFrame.new(0, 1, 0), 0.15)
				task.delay(0.2, function()
					TowerView.slide(model, home, 0.15)
				end)
			else
				TowerMotion.halo(home * CFrame.new(0, -1, 0), home, 1, 0.6)
				task.spawn(function()
					for i = 1, 3 do
						if not model.Parent then
							return
						end
						TowerView.slide(model, home * CFrame.new(0, 3, 0) * CFrame.Angles(0, math.rad(180 * i), 0), 0.22)
						task.wait(0.25)
						TowerView.slide(model, home * CFrame.Angles(0, math.rad(360 * i), 0), 0.2)
						task.wait(0.35)
					end
				end)
			end
		end
	end
end

return TowerView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="345">
          <Properties>
            <string name="Name">UpgradePreview</string>
            <string name="Source"><![CDATA[--!strict
-- The ONE preview pedestal beside the lobby's Upgrades counter (Master Prompt 5 sections 2 and 6).
--
-- Entirely client-local: the pedestal the server builds (model CT_Rocks_UpgradePedestal, part PreviewAnchor)
-- is empty geometry. This module clones the selected item's preview model (ReplicatedStorage.Assets.Previews,
-- the same real tool / machine models the shop pictures use) onto the anchor in a client-only folder, so
--   * it is per player: another player's selection or equipment never changes what you see;
--   * it grants nothing and owns nothing: it reads State.Profile only to pick the default and the label;
--   * it has no per-tool stand and no price table: items come from Config.HandheldOrder / MachineOrder, so
--     any number of future tools or machines appear with no lobby geometry (add the Config entry and its
--     preview model; the pedestal normalises every model to the same height by its bounding box).
-- Default item: the player's equipped hand tool. `UpgradePreview.select(id)` (or the Selected event) shows any
-- catalog item, `select(nil)` returns to the default. Nothing here is interactive (no collision, no query).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local SignLayout = require(Shared.SignLayout)
local State = require(script.Parent.State)

local UpgradePreview = {}

UpgradePreview.Selected = Instance.new("BindableEvent") -- (itemId: string?) fired after the shown item changes

local MAX_WIDTH = 3.4 -- studs: the largest footprint a preview may take on the pedestal
local SPIN = 0.5 -- radians per second
local SHOW_RANGE = 70

local selected: string? = nil
local anchor: BasePart? = nil
local labelPart: BasePart? = nil
local localFolder: Folder? = nil
local shown: Model? = nil
local shownId: string? = nil
local shownRel: CFrame = CFrame.new()
local shownSize: Vector3 = Vector3.one
local angle = 0
local started = false

-- Every catalog item in display order: hand tools, then machines. Data comes from Config only.
function UpgradePreview.items(): { { Id: string, Name: string } }
	local out = {}
	for _, id in Config.HandheldOrder do
		local h = Config.Handhelds[id]
		if h then
			table.insert(out, { Id = id, Name = h.Name })
		end
	end
	for _, id in Config.MachineOrder do
		local mc = Config.Machines[id]
		if mc then
			table.insert(out, { Id = id, Name = mc.Name })
		end
	end
	return out
end

local function nameOf(id: string): string
	local h = Config.Handhelds[id]
	if h then
		return h.Name
	end
	local mc = Config.Machines[id]
	return if mc then mc.Name else id
end

local function isItem(id: string): boolean
	return Config.Handhelds[id] ~= nil or Config.Machines[id] ~= nil
end

-- What the pedestal shows: the explicit selection, else the equipped hand tool, else the first catalog item.
function UpgradePreview.currentId(): string?
	if selected and isItem(selected) then
		return selected
	end
	local prof = State.Profile
	local eq = prof and prof.EquippedHandheld
	if type(eq) == "string" and isItem(eq) then
		return eq
	end
	return Config.HandheldOrder[1]
end

local function setLabel(text: string)
	local p = labelPart
	if not p then
		return
	end
	local gui = p:FindFirstChildOfClass("SurfaceGui")
	local t = gui and gui:FindFirstChildWhichIsA("TextLabel")
	local w, h = p:GetAttribute("SignW"), p:GetAttribute("SignH")
	if gui and t and type(w) == "number" and type(h) == "number" then
		local f = SignLayout.fit(string.upper(text), w, h, "Plaque")
		gui.PixelsPerStud = f.PPS
		t.TextSize = f.TextSize
		t.Text = f.Text
		p:SetAttribute("SignText", f.Text)
		p:SetAttribute("SignFill", f.Fill)
	end
end

local function place()
	local m, a = shown, anchor
	if m and a then
		local target = CFrame.new(a.Position + Vector3.new(0, shownSize.Y / 2, 0)) * CFrame.Angles(0, angle, 0)
		m:PivotTo(target * shownRel)
	end
end

local function clearShown()
	if shown then
		shown:Destroy()
	end
	shown = nil
	shownId = nil
end

local function refresh()
	local a = anchor
	if not a or not a.Parent then
		return
	end
	local id = UpgradePreview.currentId()
	if id == shownId then
		return
	end
	clearShown()
	if not id then
		return
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local previews = assets and assets:FindFirstChild("Previews")
	local template = previews and previews:FindFirstChild(id)
	if not template or not template:IsA("Model") then
		setLabel(nameOf(id))
		return
	end
	local m = template:Clone()
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
			d:Destroy()
		end
	end
	-- normalise by the model's bounds: one pedestal height for a hammer or a crusher, then clamp the footprint
	local height = (a:GetAttribute("PreviewHeight") :: number?) or 3.2
	local _, size0 = m:GetBoundingBox()
	local k = height / math.max(size0.Y, 0.1)
	local widest = math.max(size0.X, size0.Z) * k
	if widest > MAX_WIDTH then
		k *= MAX_WIDTH / widest
	end
	m:ScaleTo(k * m:GetScale())
	local bb, size = m:GetBoundingBox()
	shownSize = size
	shownRel = bb:ToObjectSpace(m:GetPivot())
	m.Name = "Preview_" .. id
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d:SetAttribute("CameraIgnore", true)
		end
	end
	if not localFolder then
		local f = Instance.new("Folder")
		f.Name = "UpgradePreviewLocal"
		f.Parent = Workspace
		localFolder = f
	end
	m.Parent = localFolder
	shown = m
	shownId = id
	place()
	setLabel(nameOf(id))
	UpgradePreview.Selected:Fire(id)
end

-- Show catalog item `id` on the pedestal (this player only); nil goes back to the equipped tool.
function UpgradePreview.select(id: string?)
	if id ~= nil and not isItem(id) then
		return
	end
	selected = id
	refresh()
end

function UpgradePreview.start()
	if started then
		return
	end
	started = true
	-- The pedestal may arrive late (StreamingEnabled streams the lobby in by distance) or come back as a new part after
	-- streaming out: listen for it instead of looking once.
	local function adopt(found: Instance)
		if found.Name == "PreviewLabel" and found:IsA("BasePart") and anchor and found.Parent == anchor.Parent then
			labelPart = found
			if shownId then
				setLabel(nameOf(shownId))
			end
			return
		end
		if found.Name ~= "PreviewAnchor" or not found:IsA("BasePart") or found == anchor then
			return
		end
		anchor = found
		labelPart = (found.Parent and found.Parent:FindFirstChild("PreviewLabel")) :: BasePart?
		refresh()
	end
	local function watchLobby(lobby: Instance)
		local found = lobby:FindFirstChild("PreviewAnchor", true)
		if found then
			adopt(found)
		end
		lobby.DescendantAdded:Connect(adopt)
	end
	task.spawn(function()
		local lobby = Workspace:WaitForChild("CT_Rocks_Lobby", 30)
		if lobby then
			watchLobby(lobby)
		else
			-- the match place has no lobby (nothing to do); a lobby that turns up later is still picked up
			local conn: RBXScriptConnection? = nil
			conn = Workspace.ChildAdded:Connect(function(c)
				if c.Name == "CT_Rocks_Lobby" then
					if conn then
						conn:Disconnect()
					end
					watchLobby(c)
				end
			end)
		end
		State.Changed.Event:Connect(function(what)
			if what == "Profile" then
				refresh()
			end
		end)
		RunService.Heartbeat:Connect(function(dt: number)
			local m, a = shown, anchor
			if not m or not a then
				return
			end
			if State.Profile and State.Profile.Settings and State.Profile.Settings.ReducedMotion == true then
				return
			end
			local char = Players.LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and (root.Position - a.Position).Magnitude < SHOW_RANGE then
				angle = (angle + dt * SPIN) % (math.pi * 2)
				place()
			end
		end)
	end)
end

return UpgradePreview
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="346">
          <Properties>
            <string name="Name">VoidStatueFx</string>
            <string name="Source"><![CDATA[--!strict
-- The Void Dragon statue comes alive (client only, cosmetic; server/VoidStatue builds it):
--   a slow breathing hover of the dragon (+-0.4 studs over 4 s, a tiny sway), a ring of sparkles orbiting it, and a
--   pulsing "1 in 1000" sign. One Heartbeat connection while the statue is near; nothing is sent anywhere.
-- Reduce Motion: no hover or orbit (the sparkles still twinkle in place, the sign stays still).

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.State)

local VoidStatueFx = {}

local HOVER = 0.4 -- studs up and down
local PERIOD = 4 -- seconds per breath
local ORBITERS = 8
local NEAR = 400 -- studs: farther than this, nothing moves (saves phones)

local function reduced(): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings.ReducedMotion == true
end

local function lowFx(): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings.LowEffects == true
end

local function sparkle(parent: Instance, color: Color3): Attachment
	local a = Instance.new("Attachment")
	a.Name = "Orbiter"
	local p = Instance.new("ParticleEmitter")
	p.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	p.Rate = if lowFx() then 4 else 10
	p.Lifetime = NumberRange.new(0.6, 1.1)
	p.Speed = NumberRange.new(0, 0.5)
	p.LightEmission = 1
	p.LockedToPart = false
	p.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	p.Color = ColorSequence.new(color)
	p.Parent = a
	a.Parent = parent
	return a
end

local function attach(statue: Model)
	local dragon = statue:FindFirstChild("Dragon") :: Model?
	local home = dragon and dragon:GetAttribute("Home")
	local height = (statue:GetAttribute("Height") :: number?) or 16
	local top = (statue:GetAttribute("Top") :: number?) or 0
	local base = statue.PrimaryPart
	if not base then
		return
	end
	local floor = base.CFrame * CFrame.new(0, -base.Size.Y / 2, 0)
	local centre = (if typeof(home) == "CFrame" then home.Position else floor.Position + Vector3.new(0, top, 0)) + Vector3.new(0, height * 0.5, 0)
	local radius = height * 0.75
	local orbiters: { Attachment } = {}
	local terrain = Workspace.Terrain
	for i = 1, ORBITERS do
		table.insert(orbiters, sparkle(terrain, if i % 2 == 0 then Color3.fromRGB(240, 140, 255) else Color3.fromRGB(255, 220, 110)))
	end
	local odds: { TextLabel } = {}
	for _, d in statue:GetDescendants() do
		if d:IsA("TextLabel") and d.Name == "Odds" then
			table.insert(odds, d)
		end
	end
	local t0 = os.clock()
	local conn: RBXScriptConnection? = nil
	conn = RunService.Heartbeat:Connect(function()
		if not statue.Parent then
			for _, a in orbiters do
				a:Destroy()
			end
			if conn then
				conn:Disconnect()
			end
			return
		end
		local cam = Workspace.CurrentCamera
		if cam and (cam.CFrame.Position - centre).Magnitude > NEAR then
			return
		end
		local t = os.clock() - t0
		local calm = reduced()
		if dragon and typeof(home) == "CFrame" and not calm then
			local breath = math.sin(t * 2 * math.pi / PERIOD)
			dragon:PivotTo(home * CFrame.new(0, HOVER + HOVER * breath, 0) * CFrame.Angles(0, math.rad(3) * math.sin(t * 0.7), 0))
		end
		for i, a in orbiters do
			local ang = (if calm then 0 else t * 0.8) + (i / ORBITERS) * math.pi * 2
			local bob = if calm then 0 else math.sin(t * 1.6 + i) * height * 0.08
			a.WorldPosition = centre + Vector3.new(math.cos(ang) * radius, bob + (i % 2) * height * 0.2 - height * 0.1, math.sin(ang) * radius)
		end
		if not calm then
			local pulse = 0.5 + 0.5 * math.sin(t * 3)
			for _, l in odds do
				l.TextTransparency = 0.25 * (1 - pulse)
				l.Rotation = 2 * math.sin(t * 1.5)
				local st = l:FindFirstChildOfClass("UIStroke")
				if st then
					st.Thickness = 3 + 3 * pulse
				end
			end
		end
	end)
end

function VoidStatueFx.start()
	-- the server can rebuild the statue later (moved onto the leaderboard tree's DragonPerch): attach to each new one
	local seen: { [Instance]: boolean } = {}
	local function try(d: Instance)
		if d.Name == "VoidDragonStatue" and d:IsA("Model") and not seen[d] then
			seen[d] = true
			d.Destroying:Connect(function()
				seen[d] = nil
			end)
			task.defer(attach, d)
		end
	end
	Workspace.DescendantAdded:Connect(try)
	task.spawn(function()
		local found = Workspace:FindFirstChild("VoidDragonStatue", true)
		if found then
			try(found)
		end
	end)
end

return VoidStatueFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="347">
          <Properties>
            <string name="Name">WorldFx</string>
            <string name="Source"><![CDATA[--!strict
-- Small world effects (client only, cosmetic, nothing is sent anywhere):
--   * Plot pedestal glow: a pet shown on a plot stand (display slots, GalleryService "Display" folders) gets a soft
--     glowing disc under it in its rarity colour (Uncommon and up). The rarity is read from the plaque the server
--     already writes in Config.RarityTextColors; an "+ ADD PET" plaque or a Common pet gets no glow.
--   * Water ripples: a player walking or swimming in water (terrain water, or a part named like "Water" / "Pond")
--     leaves fading rings. Nearby players only, a few rings at a time. Stepping or dropping into the water makes a
--     splash: a wider ring and a few droplets (one shared emitter, Emit only).
--   * Feet dust (PlayerDust) and the race portal flash (PortalFx) are started from here.
--   * Secret egg: the hidden lobby egg (attribute SecretEgg = true, MapNames.SecretEgg) gives off a very faint sparkle.
--   * Zone weather in a hunt: snow in the Snow zone, ash and embers in the Volcano, twinkling stars in Space
--     (ZoneThemes landmark of the round's tier). The emitter box follows the camera.
-- Low effects: no weather, no ripples, no secret-egg sparkle; pedestal glow stays (static). Reduce Motion: weather is
-- thinner and the glow does not pulse. Every emitter and part is bounded and cleaned up.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local MapNames = require(Shared.MapNames)
local ZoneThemes = require(Shared.ZoneThemes)
local State = require(script.Parent.State)

local WorldFx = {}

local MAX_RIPPLES = 10
local RIPPLE_NEAR = 60
local RIPPLE_EVERY = 0.22

local fxFolder: Folder? = nil

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function low(): boolean
	return settings().LowEffects == true
end

local function reduced(): boolean
	return settings().ReducedMotion == true
end

local function folder(): Folder
	local f = fxFolder
	if f and f.Parent then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = "CT_Rocks_WorldFx"
	nf.Parent = Workspace
	fxFolder = nf
	return nf
end

local function deco(p: BasePart)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p:SetAttribute("CameraIgnore", true)
end

-- Plot pedestal glow ----------------------------------------------------------------------------------------

local RANK: { [string]: number } = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5 }
type Glow = { Parts: { BasePart } }
local glows: { [Instance]: Glow } = {}
local watched: { [Instance]: RBXScriptConnection } = {}
local glowParts: { BasePart } = {}

local function rarityOfInk(c: Color3): string?
	for name, col in Config.RarityTextColors :: any do
		local d = math.abs(col.R - c.R) + math.abs(col.G - c.G) + math.abs(col.B - c.B)
		if d < 0.02 then
			return name
		end
	end
	return nil
end

local function clearGlow(display: Instance)
	local g = glows[display]
	if not g then
		return
	end
	glows[display] = nil
	for _, p in g.Parts do
		local i = table.find(glowParts, p)
		if i then
			table.remove(glowParts, i)
		end
		p:Destroy()
	end
end

local function buildGlow(display: Instance)
	clearGlow(display)
	if not display.Parent or not watched[display] then
		return
	end
	local g: Glow = { Parts = {} }
	glows[display] = g
	local pets: { Model } = {}
	for _, c in display:GetChildren() do
		if c:IsA("Model") and not c:FindFirstChild("Stand") then -- wanderers carry an invisible "Stand" prompt part
			table.insert(pets, c)
		end
	end
	for _, c in display:GetChildren() do
		if c:IsA("BasePart") and c.Name == "Label" then
			local gui = c:FindFirstChildOfClass("SurfaceGui")
			local t = gui and gui:FindFirstChild("Text")
			local rarity = if t and t:IsA("TextLabel") then rarityOfInk(t.TextColor3) else nil
			if rarity and (RANK[rarity] or 1) >= 2 then
				-- the pet standing nearest this plaque
				local best: Model? = nil
				local bestD = 12
				for _, m in pets do
					local d = (m:GetPivot().Position - c.Position).Magnitude
					if d < bestD then
						best, bestD = m, d
					end
				end
				if best then
					local r = tonumber(best:GetAttribute("Radius")) or 1.5
					local at = best:GetPivot().Position
					local disc = Instance.new("Part")
					disc.Name = "PedestalGlow"
					disc.Shape = Enum.PartType.Cylinder
					disc.Size = Vector3.new(0.06, r * 2 + 1.2, r * 2 + 1.2)
					disc.CFrame = CFrame.new(at + Vector3.new(0, 0.04, 0)) * CFrame.Angles(0, 0, math.rad(90))
					disc.Material = Enum.Material.Neon
					disc.Color = (Config.RarityColors :: any)[rarity] or Color3.new(1, 1, 1)
					disc.Transparency = 0.55
					deco(disc)
					disc:SetAttribute("Rank", RANK[rarity])
					disc.Parent = folder()
					table.insert(g.Parts, disc)
					table.insert(glowParts, disc)
				end
			end
		end
	end
end

local pendingGlow: { [Instance]: boolean } = {}
local function scheduleGlow(display: Instance)
	if pendingGlow[display] then
		return
	end
	pendingGlow[display] = true
	task.delay(0.6, function()
		pendingGlow[display] = nil
		buildGlow(display)
	end)
end

local function unwatch(display: Instance)
	local conn = watched[display]
	if conn then
		conn:Disconnect()
		watched[display] = nil
	end
	clearGlow(display)
end

local function watchDisplay(display: Instance)
	if watched[display] then
		return
	end
	watched[display] = display.ChildAdded:Connect(function()
		scheduleGlow(display)
	end)
	scheduleGlow(display)
	display.AncestryChanged:Connect(function()
		if not display:IsDescendantOf(Workspace) then
			unwatch(display)
		end
	end)
end

local function isDisplay(d: Instance): boolean
	return d.Name == "Display" and d:IsA("Folder") and d.Parent ~= nil
end

-- Secret egg sparkle ----------------------------------------------------------------------------------------

local eggSparkles: { ParticleEmitter } = {}

local function addEggSparkle(part: BasePart)
	if part:FindFirstChild("CT_SecretSparkle") then
		return
	end
	local e = Instance.new("ParticleEmitter")
	e.Name = "CT_SecretSparkle"
	e.Rate = 0.8
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Speed = NumberRange.new(0.2, 0.6)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.4, 0.28), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0.35)
	e.Color = ColorSequence.new(Color3.fromRGB(255, 236, 160))
	e.LightEmission = 0.8
	e.LightInfluence = 0
	e.Enabled = not low()
	e.Parent = part
	table.insert(eggSparkles, e)
end

local function checkSecret(d: Instance)
	if d:IsA("BasePart") and (d:GetAttribute("SecretEgg") == true or d.Name == MapNames.SecretEgg) then
		addEggSparkle(d)
	elseif d:IsA("Model") and d:GetAttribute("SecretEgg") == true then
		local p = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)
		if p then
			addEggSparkle(p)
		end
	end
end

-- Water ripples ---------------------------------------------------------------------------------------------

local liveRipples = 0
local lastRipple: { [Player]: number } = {}

local function isWater(hit: RaycastResult): boolean
	if hit.Material == Enum.Material.Water then
		return true
	end
	local n = string.lower(hit.Instance.Name)
	return string.find(n, "water", 1, true) ~= nil or string.find(n, "pond", 1, true) ~= nil
end

local function ripple(pos: Vector3, wide: number?)
	if liveRipples >= MAX_RIPPLES then
		return
	end
	liveRipples += 1
	local reach = wide or 6
	local p = Instance.new("Part")
	p.Name = "Ripple"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(0.05, 1.2, 1.2)
	p.CFrame = CFrame.new(pos + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, 0, math.rad(90))
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(235, 248, 255)
	p.Transparency = 0.45
	deco(p)
	p.Parent = folder()
	local tw = TweenService:Create(p, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.05, reach, reach), Transparency = 1 })
	tw.Completed:Once(function()
		liveRipples -= 1
		p:Destroy()
	end)
	tw:Play()
end

local inWater: { [Player]: boolean } = {}
local splashHost: BasePart? = nil
local splashEmitter: ParticleEmitter? = nil

-- A splash where a player steps or drops into the water: a wide ring, a second one a moment later, and droplets.
local function splash(pos: Vector3)
	ripple(pos, 9)
	task.delay(0.15, ripple, pos, 5)
	local f = folder()
	local h, e = splashHost, splashEmitter
	if not (h and e and h.Parent == f) then
		local np = Instance.new("Part")
		np.Name = "SplashHost"
		np.Size = Vector3.new(1.4, 0.2, 1.4)
		np.Transparency = 1
		deco(np)
		local ne = Instance.new("ParticleEmitter")
		ne.Enabled = false -- Emit() only
		ne.Shape = Enum.ParticleEmitterShape.Box
		ne.EmissionDirection = Enum.NormalId.Top
		ne.Lifetime = NumberRange.new(0.45, 0.7)
		ne.Speed = NumberRange.new(6, 10)
		ne.SpreadAngle = Vector2.new(30, 30)
		ne.Acceleration = Vector3.new(0, -40, 0)
		ne.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.12) })
		ne.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0.8) })
		ne.Color = ColorSequence.new(Color3.fromRGB(225, 244, 255))
		ne.LightEmission = 0.3
		ne.Parent = np
		np.Parent = f
		h, e = np, ne
		splashHost, splashEmitter = np, ne
	end
	(h :: BasePart).CFrame = CFrame.new(pos + Vector3.new(0, 0.1, 0));
	(e :: ParticleEmitter):Emit(if reduced() then 4 else 10)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = false

local function rippleStep()
	if low() then
		return
	end
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local now = os.clock()
	local chars: { Instance } = {}
	for _, pl in Players:GetPlayers() do
		if pl.Character then
			table.insert(chars, pl.Character)
		end
	end
	rayParams.FilterDescendantsInstances = chars
	for _, pl in Players:GetPlayers() do
		local root = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and (root.Position - cam.CFrame.Position).Magnitude < RIPPLE_NEAR then
			local v = root.AssemblyLinearVelocity
			local moving = Vector2.new(v.X, v.Z).Magnitude > 2
			if (moving or v.Y < -4) and now - (lastRipple[pl] or 0) >= RIPPLE_EVERY * 2 then
				local hit = Workspace:Raycast(root.Position + Vector3.new(0, 4, 0), Vector3.new(0, -10, 0), rayParams)
				local wet = hit ~= nil and isWater(hit)
				if hit and wet then
					lastRipple[pl] = now
					if not inWater[pl] then
						splash(hit.Position)
					elseif moving then
						ripple(hit.Position)
					end
				end
				inWater[pl] = wet
			end
		end
	end
end

-- Zone weather ----------------------------------------------------------------------------------------------

local weatherPart: BasePart? = nil
local weatherKind = ""

type WeatherLook = { Box: Vector3, Up: number, Rate: number, Life: NumberRange, Speed: NumberRange, Size: NumberSequence, Colour: ColorSequence, Trans: NumberSequence, Accel: Vector3, Light: number, Spread: Vector2 }

local LOOKS: { [string]: WeatherLook } = {
	Snow = {
		Box = Vector3.new(90, 1, 90), Up = 26, Rate = 70, Life = NumberRange.new(6, 9), Speed = NumberRange.new(2, 4),
		Size = NumberSequence.new(0.28), Colour = ColorSequence.new(Color3.fromRGB(250, 252, 255)),
		Trans = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0.15), NumberSequenceKeypoint.new(0.9, 0.15), NumberSequenceKeypoint.new(1, 1) }),
		Accel = Vector3.new(0.6, -1.5, 0.3), Light = 0.3, Spread = Vector2.new(25, 25),
	},
	Ash = {
		Box = Vector3.new(90, 1, 90), Up = 24, Rate = 45, Life = NumberRange.new(6, 9), Speed = NumberRange.new(1, 2.5),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0.32) }),
		Colour = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 150, 60)), ColorSequenceKeypoint.new(0.25, Color3.fromRGB(120, 112, 108)), ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 86, 84)) }),
		Trans = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0.25), NumberSequenceKeypoint.new(0.85, 0.35), NumberSequenceKeypoint.new(1, 1) }),
		Accel = Vector3.new(0.4, -0.8, 0.2), Light = 0.15, Spread = Vector2.new(35, 35),
	},
	Stars = {
		Box = Vector3.new(260, 30, 260), Up = 70, Rate = 30, Life = NumberRange.new(3, 6), Speed = NumberRange.new(0, 0),
		Size = NumberSequence.new(0.9), Colour = ColorSequence.new(Color3.fromRGB(235, 240, 255)),
		Trans = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.1), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(0.7, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Accel = Vector3.zero, Light = 1, Spread = Vector2.zero,
	},
}

local LANDMARK_WEATHER: { [string]: string } = { IceRocks = "Snow", LavaRocks = "Ash", Crystals = "Stars" }

local function wantWeather(): string
	local m = State.Match
	if not m or low() then
		return ""
	end
	local theme = (ZoneThemes.Themes :: any)[m.Tier]
	return if theme then LANDMARK_WEATHER[theme.Landmark] or "" else ""
end

local function setWeather(kind: string)
	if kind == weatherKind then
		return
	end
	weatherKind = kind
	if weatherPart then
		weatherPart:Destroy()
		weatherPart = nil
	end
	local look = LOOKS[kind]
	if not look then
		return
	end
	local p = Instance.new("Part")
	p.Name = "Weather_" .. kind
	p.Size = look.Box
	p.Transparency = 1
	deco(p)
	local e = Instance.new("ParticleEmitter")
	e.Shape = Enum.ParticleEmitterShape.Box
	e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Rate = look.Rate * (if reduced() then 0.4 else 1)
	e.Lifetime = look.Life
	e.Speed = look.Speed
	e.Size = look.Size
	e.Color = look.Colour
	e.Transparency = look.Trans
	e.Acceleration = look.Accel
	e.LightEmission = look.Light
	e.LightInfluence = if kind == "Stars" then 0 else 0.6
	e.SpreadAngle = look.Spread
	e.RotSpeed = NumberRange.new(-40, 40)
	e.Parent = p
	p.Parent = folder()
	weatherPart = p
end

local function weatherStep()
	setWeather(wantWeather())
	local p = weatherPart
	local cam = Workspace.CurrentCamera
	if p and cam then
		local look = LOOKS[weatherKind]
		local c = cam.CFrame.Position
		p.CFrame = CFrame.new(c.X, c.Y + (if look then look.Up else 25), c.Z)
	end
end

-- Driver ----------------------------------------------------------------------------------------------------

local started = false
function WorldFx.start()
	if started then
		return
	end
	started = true
	for _, d in Workspace:GetDescendants() do
		if isDisplay(d) then
			watchDisplay(d)
		else
			checkSecret(d)
		end
	end
	Workspace.DescendantAdded:Connect(function(d)
		if d.Name == "Display" then
			task.defer(function()
				if isDisplay(d) then
					watchDisplay(d)
				end
			end)
		elseif d.Name == MapNames.SecretEgg or d:GetAttribute("SecretEgg") == true then
			task.defer(checkSecret, d)
		end
	end)
	Players.PlayerRemoving:Connect(function(pl)
		lastRipple[pl] = nil
		inWater[pl] = nil
	end)
	local fxLow, fxReduced = low(), reduced()
	State.Changed.Event:Connect(function(what)
		if what == "Profile" then
			local on = not low()
			for i = #eggSparkles, 1, -1 do
				local e = eggSparkles[i]
				if e.Parent then
					e.Enabled = on
				else
					table.remove(eggSparkles, i)
				end
			end
		end
		if what == "Profile" and (low() ~= fxLow or reduced() ~= fxReduced) then
			fxLow, fxReduced = low(), reduced()
			weatherKind = "?" -- rebuild with the current settings
		end
		if what == "Profile" or what == "Match" then
			weatherStep()
		end
	end)
	require(script.Parent.PlayerDust).start()
	require(script.Parent.PortalFx).start()
	local accR, accW = 0, 0
	local t0 = os.clock()
	RunService.Heartbeat:Connect(function(dt)
		accR += dt
		accW += dt
		if accR >= RIPPLE_EVERY then
			accR = 0
			rippleStep()
		end
		if accW >= 0.15 then
			accW = 0
			weatherStep()
			-- pedestal glow breathes gently (not with Reduce Motion / Low effects)
			if #glowParts > 0 and State.Match == nil then
				local still = reduced() or low()
				local t = os.clock() - t0
				for i, p in glowParts do
					p.Transparency = if still then 0.55 else 0.55 + 0.12 * math.sin(t * 2 + i)
				end
			end
		end
	end)
end

return WorldFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="348">
          <Properties>
            <string name="Name">YourPlotTag</string>
            <string name="Source"><![CDATA[--!strict
-- "YOUR PLOT" over the local player's own plot, only on their screen (audit 2 #3: similar yards made players check
-- every sign to find theirs). The server gives plots out on join (GalleryService, player attribute Alcove); other
-- players keep seeing the owner's name on the sign. Hidden in hunts, the tower and battles.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local MapNames = require(Shared.MapNames)
local ParkConfig = require(Shared.ParkConfig)

local YourPlotTag = {}

local player = Players.LocalPlayer
local tag: BillboardGui? = nil

-- the plot's gate sign part, else its floor
local function anchor(idx: number): BasePart?
	local m = Workspace:FindFirstChild(MapNames.plot(idx), true)
	if not m then
		return nil
	end
	for _, n in MapNames.PlotSign do
		local s = m:FindFirstChild(n, true)
		local p = if s and s:IsA("BasePart") then s elseif s and s:IsA("Model") then s.PrimaryPart or s:FindFirstChildWhichIsA("BasePart", true) else nil
		if p then
			return p
		end
	end
	local f = m:FindFirstChild(MapNames.PlotFloor, true)
	return if f and f:IsA("BasePart") then f else nil
end

local function build(at: BasePart): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Name = "YourPlotTag"
	bb.Size = UDim2.fromOffset(170, 44)
	bb.StudsOffsetWorldSpace = Vector3.new(0, at.Size.Y / 2 + 4, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 140
	bb.LightInfluence = 0
	local l = Instance.new("TextLabel")
	l.BackgroundColor3 = Color3.fromRGB(110, 200, 90)
	l.BorderSizePixel = 0
	l.Size = UDim2.fromScale(1, 1)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = ParkConfig.YourPlot
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0
	l.TextStrokeColor3 = Color3.fromRGB(40, 90, 30)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = l
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 12), UDim.new(0, 12)
	pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 4), UDim.new(0, 4)
	pad.Parent = l
	l.Parent = bb
	bb.Adornee = at
	bb.Parent = player:WaitForChild("PlayerGui")
	return bb
end

local function away(): boolean
	return player:GetAttribute("MatchKey") ~= nil or player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true
end

local function refresh()
	local idx = player:GetAttribute("Alcove")
	local at = if type(idx) == "number" then anchor(idx) else nil
	local t = tag
	if t and (not at or t.Adornee ~= at) then
		t:Destroy()
		tag, t = nil, nil
	end
	if at and not t then
		t = build(at)
		tag = t
	end
	if t then
		t.Enabled = not away()
	end
end

function YourPlotTag.start()
	for _, a in { "Alcove", "MatchKey", "InTower", "InBattle" } do
		player:GetAttributeChangedSignal(a):Connect(refresh)
	end
	task.spawn(function()
		-- the hand-built map can stream in after join: look again for a while
		for _ = 1, 30 do
			refresh()
			task.wait(2)
		end
	end)
end

return YourPlotTag
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="349">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="350">
            <Properties>
              <string name="Name">CollectionPanel</string>
              <string name="Source"><![CDATA[--!strict
-- COLLECTION (boards 6 and 7, additional 4 and 5). Tabs:
--   Collection  owned specimens as cards (real 3D thumbnails) and the selected specimen's view: name, rarity,
--               mass, value, display slot usage, PLACE ON DISPLAY / REMOVE FROM DISPLAY, favourite and the separate,
--               confirmed SELL. Empty: "No geodes yet." with START HUNT (the real Start Hunt panel).
--   Display     the real lobby display slots (Profiles.displaySlots): pick a slot, place an owned specimen, replace
--               or remove; the server keeps the list dense and updates the world display.
--   Index       (Book) every pet species by zone with its hatch chance in that zone (species are equally likely
--               within a zone), and the rarity odds from Config.RarityWeights (plus your Luck pet's odds);
--               unfound species are plain silhouettes.
--   Records     Solo finds, Competitive wins and Matches played from the server's profile; an unavailable profile
--               shows "Records unavailable" with RETRY / CLOSE (never made-up zeros).
--   Stats       the other stats (eggs cracked, coins earned, best pet, pets owned, your pet's boost) and badges.
-- Collection storage ("Owned n / max") and display capacity ("Display slots n / N") are always shown apart.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local EggPerks = require(Shared.EggPerks)
local SpeciesPool = require(Shared.SpeciesPool)
local GeodeGen = require(Shared.GeodeGen)
local UiMotion = require(Shared.UiMotion)
local Net = require(Shared.Net)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local PanelSkin = require(script.Parent.PanelSkin)
local HudArt = require(script.Parent.HudArt)
local Theme = require(script.Parent.Theme)
local GeodeView = require(script.Parent.GeodeView)
local Materials = require(Shared.Materials)
local MaterialThumb = require(script.Parent.MaterialThumb)
local PartyPanel = require(script.Parent.PartyPanel)
local ProgressConfig = require(Shared.ProgressConfig)
local PetRules = require(Shared.PetRules)
local Juice = require(script.Parent.Juice)
local PetStatView = require(Shared.PetStatView)
local PetStatsStrip = require(script.Parent.PetStatsStrip)
local PetStyle = require(script.Parent.PetStyle)
local UiJuice = require(script.Parent.UiJuice)
local LaunchPerks = require(Shared.LaunchPerks)

local T = UI.T
local TC = Theme.Color
local PET = Theme.Pet

-- The profile view the server syncs (Profiles.publicView) and one pet in it (GeodeGen.public), read loosely.
type Prof = { [string]: any }
type Pet = { [string]: any }
local Collection = {}
Collection.onTeamFull = nil :: ((string) -> ())? -- Main: MY PETS asks which team slot to swap

local PAGE = 30
local tab = "Collection"
local sortBy = "Rarity" -- "Newest" | "Rarity" | "Level" | "Type" (PetRules.sort)
local favOnly = false
local bookZone = "All" -- Pet Book zone filter: "All" or a zone name (Config.Tiers[..].Name)
local page = 1
local sellMode = false
local picked: { [string]: boolean } = {}
local detail: string? = nil
local moreOpen: string? = nil -- the pet whose detail shows the MORE stats page instead of its picture
local slotSel = 1 -- Display tab: the selected slot
local placing: string? = nil -- Display tab: a specimen waiting for a slot (from PLACE ON DISPLAY on a full display)
local picker = false -- Display tab: choosing a specimen for the selected slot
local body: Frame? = nil
local open = false
local panelRef: Frame? = nil
local closeRef: (() -> ())? = nil
local recordsWaitUntil = 0
local animateIn = false -- the next render pops its cards / rows in (set when the panel opens or the tab changes)
-- Pets that arrived since the player last looked (UiMotion.freshIds): their cards wear a red "!" and a soft glow
-- until tapped or until the Pet Book closes. nil before the first profile (nothing is new then).
local knownPets: { [string]: boolean }? = nil
local freshPets: { [string]: boolean } = {}
local function trackFresh(prof: any)
	if type(prof) ~= "table" or type(prof.Inventory) ~= "table" then
		return
	end
	local ids = {}
	for _, x in prof.Inventory do
		table.insert(ids, tostring(x.Id))
	end
	local known, fresh = UiMotion.freshIds(knownPets, ids)
	knownPets = known
	for _, id in fresh do
		freshPets[id] = true
	end
end
local equipFlip: string? = nil -- the pet whose EQUIP was just tapped: its tick flips in once the server agrees

local RANK = { Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5 }

-- `px` real pixels in logical units at the current layer scale (a 44 logical chip drew 36 real px on the Studio
-- phone window, so chip heights are set from the real size they must reach)
local function realPx(px: number): number
	return math.ceil(px / math.max(UI.Scale, 0.5))
end

-- Chip / tab-like buttons (sort, filter, zone): at least 40 real px tall, never under the touch size
local function chipH(): number
	return math.max(T.Touch, realPx(40))
end

-- A button caption on one line: TextScaled text wraps whatever TextWrapped says, so the label box is made one line
-- tall (centred in the button); the word then shrinks to the text floor instead of breaking mid-word ("NAM / E",
-- "UNEQ / UIP"). Callers that move the label (tick, icon) keep its Y scale and offset.
local function oneLine(b: GuiButton, size: number?)
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l then
		local sz = size or T.Body + 1
		local lineH = math.ceil(sz * 1.3)
		l.TextWrapped = false
		l.AnchorPoint = Vector2.new(0, 0)
		l.Position = UDim2.new(0, 6, 0.5, -math.floor(lineH / 2))
		l.Size = UDim2.new(1, -12, 0, lineH)
		UI.fit(l, sz, T.MinText)
		l.TextWrapped = false
	end
end

local function act(action: string, a: any?, b: any?)
	Net.event("CollectionAction"):FireServer(action, a, b)
end

local function slotOf(prof: Prof, id: string): number?
	return table.find(prof.DisplayAssignments, id)
end

local function findGeode(prof: Prof, id: string?): Pet?
	if not id then
		return nil
	end
	for _, g in prof.Inventory do
		if g.Id == id then
			return g
		end
	end
	return nil
end

local function sortedList(prof: Prof): { Pet }
	local list: { Pet } = {}
	for _, g in prof.Inventory do
		if favOnly and not g.Favorite then
			continue
		end
		table.insert(list, g)
	end
	PetRules.sort(list, sortBy)
	return list
end

-- Pet type (BoostKind): icon name and glow colour on cards, follower tags and the detail line.
local TYPE_ICON = { Coins = "boostCoins", Speed = "boostSpeed", Luck = "boostLuck" }

local function typeIcon(g: Pet): string
	return TYPE_ICON[PetRules.kindOf(g)] or "boostCoins"
end

local function sellable(prof: Prof, g: Pet): boolean
	return not g.Favorite and not slotOf(prof, g.Id)
end

local render

local function geodePicture(g: Pet)
	return function(c: Instance)
		local vp, model, cam = GeodeView.make(c, g, { Size = UDim2.fromScale(1, 1), Backing = true })
		GeodeView.frame(cam, model, 0.75) -- a closer frame: the pet fills its card instead of floating small in it
		Juice.turntable(vp, model) -- slow sway (capped, on-screen cards only)
	end
end

-- Rarity glow for a pet card: border in the rarity colour, shimmering from Epic up (UI.rarityGlow).
local function rarityOpts(g: Pet): (Color3?, boolean, Color3?)
	return Config.RarityColors[g.Rarity], (RANK[g.Rarity] or 0) >= 4, Config.RarityTextColors[g.Rarity]
end

local function confirmSell(prof: Prof, ids: { string }, from: GuiObject?)
	local total, count, rare = 0, 0, 0
	for _, g in prof.Inventory do
		if table.find(ids, g.Id) then
			total += g.Value
			count += 1
			if RANK[g.Rarity] >= 4 then
				rare += 1
			end
		end
	end
	UI.confirm({
		Name = "ConfirmSell",
		Title = "Sell " .. count .. " pet" .. (if count == 1 then "" else "s") .. "?",
		Message = (if rare > 0 then rare .. " Epic or Legendary! " else "") .. "They leave your Pet Book for good.",
		Icon = "egg",
		Price = total,
		Confirm = "SELL",
		Style = "red",
		OnConfirm = function()
			if from then
				Juice.coinSource(from) -- the sale's coins fly from the SELL button once the server pays
			end
			act("Sell", ids, total)
			table.clear(picked)
			sellMode = false
			detail = nil
			render()
		end,
	})
end

local KIND_WORD = PetStatView.KindWord

-- Free renaming: the server filters the name and saves it (PetService "RenamePet"); empty clears it.
local function askRename(g: Pet)
	UI.confirm({
		Name = "RenamePet",
		Title = "Name your pet",
		Picture = function(c: Instance)
			GeodeView.make(c, g, { Size = UDim2.fromScale(1, 1) })
		end,
		Input = { Text = g.Nickname or "", Placeholder = GeodeGen.displayName(g), MaxLength = Config.Pets.NameMax },
		Confirm = "SAVE",
		OnConfirm = function(text: string?)
			act("RenamePet", g.Id, text or "")
		end,
	})
end

local function isFollowing(prof: Prof, id: string): boolean
	return table.find(prof.EquippedPets or {}, id) ~= nil
end

local function petSlots(prof: Prof): number
	return prof.PetSlots or Config.Pets.Slots
end

local function countsLine(prof: Prof): string
	return "Owned " .. #prof.Inventory .. "/" .. prof.InventoryMax .. "   Following " .. #(prof.EquippedPets or {}) .. "/" .. petSlots(prof)
end

-- Selected specimen view (board 6, right): name, facts, picture, display usage, actions.
-- SHINY (LaunchPerks.Shiny, 1 in 100 pets): a small gold star tag. The pet's name already starts with "Shiny "
-- (GeodeGen.displayName), so the tag is the only other place the word shows: on the card, and beside the detail name.
local function isShiny(g: Pet): boolean
	return g.Shiny == true
end

-- A card's caption (or, `long`, the detail's name): the name minus the "Shiny " a shiny pet's name starts with (the
-- gold SHINY tag beside it says it, and "Shiny Unicorn" wrapped to two lines on a phone card). A nickname shows as it is.
local function cardLabel(g: Pet, long: boolean?): string
	local s = PetRules.label(g, not long)
	if isShiny(g) and not (type(g.Nickname) == "string" and g.Nickname ~= "") and string.sub(s, 1, 6) == "Shiny " then
		return string.sub(s, 7)
	end
	return s
end

local function shinyTag(parent: Instance, h: number, props: { [string]: any }): Frame
	local tg = PetStyle.ribbon(parent, "SHINY", PET.Gold, props)
	tg.Name = "ShinyBadge"
	PetStyle.vgrad(tg, PET.Gold:Lerp(PET.White, 0.35), PET.RibbonGold)
	local l = tg:FindFirstChildOfClass("TextLabel")
	if l then
		l.ZIndex = tg.ZIndex + 2
		l.TextColor3 = PET.TitleEdge
		local o = l:FindFirstChild("Outline")
		if o and o:IsA("UIStroke") then
			o.Enabled = false
		end
		l.Position = UDim2.fromOffset(h - 2, 0)
		l.Size = UDim2.new(1, -(h + 2), 1, 0)
		l.TextWrapped = false
		UI.fit(l, T.Tiny, T.MinText)
	end
	UI.icon(tg, "star", h - 6, { Name = "Star", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), ZIndex = tg.ZIndex + 2 })
	return tg
end

-- Repeating glint on the Pet Book cards (carter asked for motion): SHINY cards get UiJuice.sweep every ~2.5 s,
-- Legendary cards the same band every ~4 s. One loop per render (the generation stops an older loop), one sweep
-- instance per card at a time (sweep itself refuses a second), nothing per frame; off under Reduce Motion.
local GLINT_SHINY = 2.5
local GLINT_LEGEND = 4
local glintGen = 0

local function startGlints(cards: { { card: GuiObject, every: number } })
	glintGen += 1
	local gen = glintGen
	if #cards == 0 or UiJuice.still() then
		return
	end
	task.spawn(function()
		local t = 0
		local STEP = 0.5
		while gen == glintGen do
			task.wait(STEP)
			t += STEP
			if gen ~= glintGen or UiJuice.still() then
				return
			end
			local alive = 0
			for _, g in cards do
				if g.card.Parent then
					alive += 1
					if math.floor(t / g.every) ~= math.floor((t - STEP) / g.every) then
						UiJuice.sweep(g.card, T.Radius)
					end
				end
			end
			if alive == 0 then
				return
			end
		end
	end)
end

local FACTS_H = 38 -- the facts line: two lines of 14 px words
local NOTE_H = 0 -- no bonus note any more: POWER and MORE on the picture say it (pet stats rework)
local DETAIL_MIN_H = 224 + (FACTS_H - 21) + NOTE_H -- name + facts, a small 3D pet, the bonus note and two button rows
-- The clip's pet card (pet style): a holo blue gradient with a cyan glow edge and a faint white pattern, resting a
-- little tilted and leaning toward the pointer (desktop only; touch leaves it still). Reduce Motion keeps it flat.
local function holoCard(f: Frame)
	local PET = Theme.Pet
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	local g = Instance.new("UIGradient")
	g.Name = "Holo"
	g.Rotation = 70
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, PET.Holo[1]),
		ColorSequenceKeypoint.new(0.5, PET.Holo[2]),
		ColorSequenceKeypoint.new(1, PET.Holo[3]),
	})
	g.Parent = f
	local border = f:FindFirstChild("Border")
	if border and border:IsA("UIStroke") then
		border.Color = PET.HoloEdge
		border.Thickness = 2.5
	end
	-- the glow: a soft cyan ring just outside the edge (a sibling-free stroke on the card itself, drawn wide and faint)
	local glow = Instance.new("UIStroke")
	glow.Name = "Glow"
	glow.Color = PET.HoloGlow
	glow.Thickness = 7
	glow.Transparency = 0.55
	glow.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	glow.LineJoinMode = Enum.LineJoinMode.Round
	glow.Parent = f
	UI.pattern(f, Color3.new(1, 1, 1), 0.82, 30, 260, DETAIL_MIN_H)
	if UI.Reduced or not UserInputService.MouseEnabled then
		return
	end
	local rest = -2.5
	f.Rotation = rest
	f.MouseLeave:Connect(function()
		UI.spring(f, Theme.Spring.Release, { Rotation = rest })
	end)
	f.MouseMoved:Connect(function(x: number)
		local w = f.AbsoluteSize.X
		if w < 1 then
			return
		end
		local dx = math.clamp(((x - f.AbsolutePosition.X) / w - 0.5) * 2, -1, 1)
		UI.spring(f, { 0.55, 5 }, { Rotation = rest + dx * 2 })
	end)
end

local function renderDetail(side: GuiObject, prof: Prof, g: Pet)
	-- Short landscape phones (678 x 310: the side column is ~130 logical tall once the menu clears Roblox's top-left
	-- buttons) cannot fit the detail, so it sits in a scroller at its smallest height and scrolls; taller screens see
	-- the scroller's canvas match its window (nothing to scroll).
	local host = UI.scroller(side, { Name = "DetailScroll", AutomaticCanvasSize = Enum.AutomaticSize.None, ScrollBarThickness = 6 })
	-- a narrow column (a short landscape window, or under ~220 logical px wide): the action buttons stack in
	-- full-width rows, so no caption ever breaks mid-word (Studio phone window 844 x 390)
	-- (the column's width from the layout numbers, not AbsoluteSize: that read small before the first layout pass)
	local modalW = if UI.Logical.Y >= 600 then 780 else 700
	local sideW = (math.min(UI.Logical.X - 24, modalW) - 2 * T.Pad) * 0.4 - 4
	local stack = not UI.isPortrait() and (UI.isShort() or sideW < 220)
	local btnH = T.Touch -- every row keeps the full tap height; the compact header pays for the third row
	local twoRows = not stack
	local actH = if twoRows then 2 * T.Touch + 6 else 3 * btnH + 12
	local minH = DETAIL_MIN_H + (actH - (2 * T.Touch + 6))
	-- the stacked rows would push the card past a short column (it would scroll, cutting FAV / SELL under the
	-- fold): then the compact header takes over (the stats row in place of the facts line, see `short` below),
	-- which frees enough for the three rows to show whole
	local hostH = host.AbsoluteSize.Y / math.max(UI.Scale, 0.01)
	local forceShort = stack and hostH > 0 and hostH < minH
	if forceShort then
		minH = math.max(hostH, minH - 55) -- 55: the facts line and the full stats row against the compact row
	end
	local f = UI.card(host, "inset", { Name = "Detail", Size = UDim2.new(1, 0, 0, minH) })
	if Theme.PetStyle then
		holoCard(f)
	end
	local function fitDetail()
		local h = math.max(host.AbsoluteSize.Y / math.max(UI.Scale, 0.01), minH)
		local scrolls = h > host.AbsoluteSize.Y / math.max(UI.Scale, 0.01) + 0.5
		f.Size = UDim2.new(1, if scrolls then -8 else 0, 0, math.floor(h))
		host.CanvasSize = UDim2.fromOffset(0, math.floor(h))
	end
	host:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitDetail)
	fitDetail()
	UI.pad(f, 8, 6)
	local isDisp = slotOf(prof, g.Id)
	local smallW = 66 -- NAME / MORE: wide enough for the word on one line at the text floor
	local shiny = isShiny(g)
	local SHINY_W = if shiny then 86 else 0 -- the gold SHINY tag right of the name (the name box gives it room)
	local name = UI.text(f, cardLabel(g, true), { Name = "Name", Font = UI.Head, TextSize = T.Head, TextColor3 = Config.RarityTextColors[g.Rarity] or TC.Text, Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -(smallW + 4) - 28 - SHINY_W, 0, 26), TextXAlignment = Enum.TextXAlignment.Center })
	name.TextWrapped = false
	UI.fit(name, T.Head, T.MinText) -- long names ("Rainbow Infernal Hydra") shrink to fit instead of cutting off
	UI.oneLine(name) -- below the text floor too: "Rainbow Sunpetal Drake" lost "Drake" at the floor (Studio 2026-10-16)
	UI.icon(f, typeIcon(g), 22, { Name = "TypeIcon", Position = UDim2.fromOffset(0, 2) })
	if shiny then
		local badge = shinyTag(f, 20, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -(smallW + 6), 0, 13), Size = UDim2.fromOffset(SHINY_W - 6, 20), Rotation = -3 })
		UI.pop(badge, 0.6) -- the badge pops in with the detail
	end
	local rename = UI.button(f, "NAME", "gray", function()
		askRename(g)
	end, { Name = "Rename", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(smallW, btnH), TextSize = T.Small + 1 })
	oneLine(rename, T.Small + 1)
	-- One facts line (rarity, variant multiplier, hunt bonus, display state); POWER and "Lv 7/20" sit on the picture.
	local following = isFollowing(prof, g.Id)
	local nickLine = if type(g.Nickname) == "string" and g.Nickname ~= "" then GeodeGen.displayName(g, true) .. " \u{b7} " else ""
	local variant = PetStatView.variantTag(g)
	local facts = UI.text(f, nickLine .. g.Rarity .. (if variant then " \u{b7} " .. variant else "") .. " \u{b7} " .. PetStatView.bonusText(g) .. (if following then " \u{b7} following" elseif isDisp then " \u{b7} on display" else ""), {
		Name = "Facts", Font = UI.Bold, TextSize = T.Body, TextColor3 = Config.RarityTextColors[g.Rarity] or (if Theme.PetStyle then TC.Text else TC.Muted), Outline = "Normal", RichText = true,
		Position = UDim2.fromOffset(0, 25), Size = UDim2.new(1, -(smallW + 4), 0, FACTS_H), TextXAlignment = Enum.TextXAlignment.Center,
	})
	-- two lines at most: at the 14 px text floor a long facts line no longer fits one line of a phone's side column
	facts.TextWrapped = true
	UI.fit(facts, T.Body)
	-- two 44 px rows (on small phones UI.button pads the hit areas to 44 real px as well): EQUIP and PLACE share a
	-- row so the 3D pet keeps most of the height; a narrow column stacks them (three rows, see `stack`)
	local placePos = if twoRows then UDim2.new(0.42, 3, 0, 0) else UDim2.fromOffset(0, btnH + 6)
	local placeSize = if twoRows then UDim2.new(0.58, -3, 0, T.Touch) else UDim2.new(1, 0, 0, btnH)
	local view, viewModel, viewCam = GeodeView.make(f, g, { Name = "Specimen", Position = UDim2.fromOffset(0, 27 + FACTS_H), Size = UDim2.new(1, 0, 1, -(27 + FACTS_H + actH + 6 + NOTE_H)), Backing = not Theme.PetStyle }, true)
	if Theme.PetStyle then
		-- the clip's card: a soft white burst behind the pet instead of a boxed backing
		local burst = UI.frame(f, { Name = "Burst", BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.25, AnchorPoint = Vector2.new(0.5, 0.5), Position = view.Position + UDim2.new(0.5, 0, 0, 0) + UDim2.new(0, 0, 0.5, -((27 + FACTS_H + actH + 6 + NOTE_H) / 2)), Size = UDim2.new(0.8, 0, 0.8, 0), ZIndex = 0 })
		burst.Position = UDim2.new(0.5, 0, 0, view.Position.Y.Offset)
		burst.Size = view.Size
		local ar = Instance.new("UIAspectRatioConstraint")
		ar.AspectRatio = 1
		ar.Parent = burst
		burst.AnchorPoint = Vector2.new(0.5, 0)
		UI.corner(burst, 999)
		local bg = Instance.new("UIGradient")
		bg.Rotation = 90
		bg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.7, 0.35), NumberSequenceKeypoint.new(1, 0.9) })
		bg.Parent = burst
	end
	GeodeView.frame(viewCam, viewModel, 0.7) -- closer: the pet fills its box
	Juice.turntable(view, viewModel) -- sways until touched (a drag pauses it)
	-- one small line under the facts: a shiny pet's doubled sell value (LaunchPerks.Shiny.ValueMult), and / or why a
	-- Robux pet sells low (the server pays a small share of its value)
	local tagBits = {}
	if shiny then
		table.insert(tagBits, "Shiny \u{b7} " .. LaunchPerks.Shiny.ValueMult .. "x sell value")
	end
	if g.Bought == true then
		table.insert(tagBits, "Robux pet \u{b7} low sell price")
	end
	local tagLine = #tagBits > 0
	local tagLabel: TextLabel? = nil
	if tagLine then
		local tl = UI.text(f, table.concat(tagBits, "  \u{b7}  "), {
			Name = if shiny then "ShinyTag" else "RobuxTag", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = if shiny then PET.RibbonGold else TC.Muted, Outline = "Normal",
			Position = UDim2.fromOffset(0, 29 + FACTS_H), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left,
		})
		tl.TextWrapped = false
		tl.TextTruncate = Enum.TextTruncate.AtEnd
		tagLabel = tl
	end
	local actions = UI.frame(f, { Name = "Actions", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, actH) })
	-- carter's pick: ONE "bigger = better" POWER number on the picture, with a green up / red down arrow against the
	-- pet that follows you; MORE (top right) shows every stat in plain words (PetStatsStrip / PetStatView)
	local other: Pet? = nil
	local firstId = (prof.EquippedPets or {})[1]
	if firstId and firstId ~= g.Id then
		for _, o in prof.Inventory do
			if o.Id == firstId then
				other = o
			end
		end
	end
	-- Short landscape phones leave no picture between the header and the buttons, so there the row replaces the
	-- facts line (rarity shows as the name's colour) and the whole row opens MORE (NAME holds the top right).
	-- (measured: the picture's own height in layout units; under ~44 there is no room for a row on top of it)
	local viewH = view.AbsoluteSize.Y / math.max(UI.Scale, 0.01)
	local short = forceShort or (if viewH > 0 then viewH < 44 else UI.isShort())
	local statH = if short then 22 else 36
	local stats: GuiObject
	if short then
		local hit = Instance.new("TextButton")
		hit.Name = "Stats"
		hit.Text = ""
		hit.BackgroundTransparency = 1
		hit.Position = UDim2.fromOffset(0, 24)
		hit.Size = UDim2.new(1, -(smallW + 4), 0, statH)
		hit.ZIndex = view.ZIndex + 2
		hit.Parent = f
		stats = hit
		facts.Visible = false
		if tagLabel and forceShort then
			-- a short column (stacked buttons right under the row) has no room for it: it sat behind EQUIP; the SELL
			-- button shows the doubled price anyway
			tagLabel.Visible = false
		end
	else
		stats = UI.frame(f, { Name = "Stats", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 48 + (FACTS_H - 21) + (if tagLine then 16 else 0)), Size = UDim2.new(1, 0, 0, statH), ZIndex = view.ZIndex + 2 })
	end
	local moreW = smallW
	local badge = PetStatsStrip.badge(stats, PetStatView.power(g), PetStatView.compare(g, other), statH, { Position = UDim2.fromOffset(2, 0) })
	-- level next to POWER: how far it has grown and how far its rarity lets it grow (carter, 2026-10-14)
	local lv, cap = PetStatView.levelOf(g)
	local lvW = (if badge then badge.Size.X.Offset else 0) + 6
	local lvChip = PetStatsStrip.level(stats, lv, cap, if short then statH - 2 else statH - 8, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, lvW, 0.5, 0) })
	if short then
		-- the hunt bonus (and variant) after the level, then an info dot that says "tap for more"
		local x0 = lvW + lvChip.Size.X.Offset + 6
		local bits = UI.text(stats, (if variant then variant .. " \u{b7} " else "") .. PetStatView.bonusText(g), {
			Name = "Facts", Font = UI.Bold, TextSize = T.Small, TextColor3 = Config.RarityTextColors[g.Rarity] or TC.Muted, Outline = "Normal",
			Position = UDim2.fromOffset(x0, 0), Size = UDim2.new(1, -(x0 + 22), 1, 0),
		})
		-- one line, cut with "..." when the row is narrow (the 14 px floor can't shrink it, and wrapping stacked it
		-- into a column over the name on desk)
		bits.TextScaled = false
		bits.TextSize = math.max(T.Small, 14)
		bits.TextWrapped = false
		bits.TextTruncate = Enum.TextTruncate.AtEnd
		-- too narrow for the whole line: hide it (the row still opens MORE, which says the same in full)
		local function fitsBits()
			bits.Visible = bits.TextFits
		end
		bits:GetPropertyChangedSignal("TextFits"):Connect(fitsBits)
		bits:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitsBits)
		fitsBits()
		local hint = UI.icon(stats, "info", 18, { Name = "MoreHint", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0) })
		-- the info dot is only a hint (the whole row opens MORE): it steps aside when the level pill reaches it, so the
		-- pill is never covered (Studio 2026-10-16: "Lv 50 MAX" read "Lv 50 MA")
		local function clearHint()
			hint.Visible = UiMotion.clearOf(lvChip.AbsolutePosition.X + lvChip.AbsoluteSize.X, hint.AbsolutePosition.X, 2)
		end
		lvChip:GetPropertyChangedSignal("AbsoluteSize"):Connect(clearHint)
		lvChip:GetPropertyChangedSignal("AbsolutePosition"):Connect(clearHint)
		hint:GetPropertyChangedSignal("AbsolutePosition"):Connect(clearHint)
		clearHint()
	end
	-- MORE covers the picture and the buttons (portrait phones left the picture only a few lines tall) with every
	-- stat in plain words, and a BACK button under them
	local moreHost = UI.frame(f, { Name = "MoreHost", BackgroundColor3 = TC.Panel, Position = UDim2.fromOffset(0, 46 + (FACTS_H - 21)), Size = UDim2.new(1, 0, 1, -(46 + (FACTS_H - 21))), Visible = false, ZIndex = view.ZIndex + 5 })
	UI.corner(moreHost, T.RadiusSm)
	local function showMore(on: boolean)
		moreOpen = if on then g.Id else nil
		if on and moreHost:FindFirstChild("MoreStats") == nil then
			PetStatsStrip.more(moreHost, g, other ~= nil, function()
				showMore(false)
			end)
		end
		moreHost.Visible = on
	end
	if short then
		(stats :: TextButton).Activated:Connect(function()
			showMore(true)
		end)
	else
		local moreBtn = UI.button(stats, "MORE", "gray", function()
			showMore(true)
		end, { Name = "More", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -2, 0, 0), Size = UDim2.new(0, moreW, 1, 0), TextSize = T.Small })
		oneLine(moreBtn, T.Small)
	end
	if moreOpen == g.Id then
		showMore(true)
	end
	local eq: TextButton
	eq = UI.button(actions, if following then "UNEQUIP" else "EQUIP", if following then "gray" else "green", function()
		if not following and #(prof.EquippedPets or {}) >= (prof.PetSlots or Config.Pets.Slots) then
			-- the team is full: MY PETS asks which slot to swap (never a silent replace)
			local f = Collection.onTeamFull
			if f then
				f(g.Id)
				return
			end
		end
		UI.pending(eq, "\u{2026}", 4)
		equipFlip = if following then nil else g.Id
		act(if following then "UnequipPet" else "EquipPet", g.Id)
	end, { Name = "Equip", Size = if twoRows then UDim2.new(0.42, -3, 0, T.Touch) else UDim2.new(1, 0, 0, btnH), TextSize = T.Body + 1 })
	oneLine(eq)
	if following then
		-- a following pet's button carries a tick; right after EQUIP it flips in (turns over and pops)
		local tick = UI.icon(eq, "check", 22, { Name = "Tick", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), ZIndex = eq.ZIndex + 2 })
		-- the word starts right of the tick (the tick sat on the U of UNEQUIP, Studio #178)
		local el = eq:FindFirstChild("Label") :: TextLabel?
		if el then
			el.Position = UDim2.new(0, 34, el.Position.Y.Scale, el.Position.Y.Offset)
			el.Size = UDim2.new(1, -40, el.Size.Y.Scale, el.Size.Y.Offset)
		end
		if equipFlip == g.Id then
			equipFlip = nil
			if not UI.Reduced then
				UI.pop(eq, 0.8)
				UI.pop(tick, 0.2, 0.05)
				tick.Rotation = -180
				TweenService:Create(tick, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
			end
		end
	end
	local main
	if isDisp then
		main = UI.button(actions, if twoRows then "TAKE OFF DISPLAY" else "REMOVE FROM DISPLAY", "gold", function()
			UI.pending(main, "REMOVING\u{2026}", 4)
			act("Display", g.Id, false)
		end, { Name = "Place", Position = placePos, Size = placeSize, TextSize = T.Body + 1 })
		oneLine(main)
	else
		main = UI.button(actions, "PLACE ON DISPLAY", "gold", function()
			if #prof.DisplayAssignments < prof.DisplaySlots then
				UI.pending(main, "PLACING\u{2026}", 4)
				act("Display", g.Id, true)
			else
				-- display full: choose which slot to replace on the Display tab
				placing = g.Id
				picker = false
				tab = "Display"
				render()
			end
		end, { Name = "Place", Position = placePos, Size = placeSize, TextSize = T.Body + 1 })
		oneLine(main)
	end
	local row = UI.frame(actions, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, if twoRows then T.Touch + 6 else 2 * (btnH + 6)), Size = UDim2.new(1, 0, 0, if twoRows then T.Touch else btnH) })
	UI.list(row, Enum.FillDirection.Horizontal, 6)
	-- one short word per button so each reads on one line at body size: FAV (star) and SELL share the row (the ROAM
	-- button is gone: no pet walks around loose, owner 2026-10-14)
	-- the favourite button says FAV beside its star (a bare star read as an unlabelled diamond, Studio); the star
	-- steps aside when the word would not fit beside it
	local fav = UI.button(row, "FAV", "gray", function()
		act("Favorite", g.Id, not g.Favorite)
	end, { Name = "Favourite", Size = UDim2.new(0.4, -4, 1, 0), TextSize = T.Body + 1, LayoutOrder = 1 })
	local star = UI.icon(fav, "star", 22, { Name = "Star", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), ZIndex = fav.ZIndex + 2 })
	oneLine(fav)
	local fl = fav:FindFirstChild("Label") :: TextLabel?
	if fl then
		UI.iconWord(fav, fl, star, 22, T.Small)
	end
	if g.Favorite then
		UI.setSelected(fav, true)
	end
	local canSell = sellable(prof, g)
	-- a protected pet says why it can't be sold (the server refuses it too)
	local sellText = if canSell then "SELL " .. UI.num(g.Value) elseif g.Favorite then "LOCKED" else "ON DISPLAY"
	local sell: TextButton
	sell = UI.button(row, sellText, "gray", function()
		confirmSell(prof, { g.Id }, sell)
	end,{ Name = "Sell", Size = UDim2.new(0.6, -4, 1, 0), TextSize = T.Body + 1, LayoutOrder = 3 })
	oneLine(sell)
	if canSell then
		-- the coin picture says "coins" so the word fits on one line
		local sl = sell:FindFirstChild("Label") :: TextLabel?
		local coin = UI.icon(sell, "cash", 20, { Name = "Coin", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), ZIndex = sell.ZIndex + 2 })
		if sl then
			UI.iconWord(sell, sl, coin, 20, T.Small)
		end
	end
	UI.setEnabled(sell, canSell)
end

-- Zero specimens (additional board 5): one rock silhouette, two short lines, START HUNT.
local function renderEmpty(b: Frame, prof: Prof, top: number)
	if panelRef then
		UI.fitModal(panelRef, Vector2.new(520, if UI.isPortrait() then 420 else 330))
	end
	local _, btn = UI.emptyState(b, "Your Pet Book is empty!", "Go hatch your first pet!", nil, {
		Name = "EmptyState", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, top / 2 - 8),
	}, if not State.Match then {
		Text = "START HUNT",
		OnClick = function()
			PartyPanel.open()
		end,
	} else nil)
	if btn then
		btn.Name = "StartHunt"
	end
	UI.text(b, countsLine(prof) .. "   Display slots " .. #prof.DisplayAssignments .. "/" .. prof.DisplaySlots, {
		Name = "Counts", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Muted, Outline = "Light",
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center,
	})
end

local function renderCollection(b: Frame, prof: Prof, top: number)
	if #prof.Inventory == 0 then
		renderEmpty(b, prof, top)
		return
	end
	local portrait = UI.isPortrait()
	local list = sortedList(prof)
	local g = findGeode(prof, detail)
	if not g and #list > 0 then
		local first = list[1]
		g = first
		detail = first.Id
	end
	local left = UI.frame(b, { Name = "Grid", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, top), Size = if portrait then UDim2.new(1, 0, 0.45, -top / 2) else UDim2.new(0.6, -4, 1, -top) })
	-- toolbar: sort by rarity / level / type (tap again for newest first), favourites filter, sell mode
	local barH = chipH()
	local bar = UI.frame(left, { Name = "Toolbar", Size = UDim2.new(1, 0, 0, barH), BackgroundTransparency = 1 })
	UI.list(bar, Enum.FillDirection.Horizontal, 5)
	for i, key in { "Rarity", "Level", "Type" } do
		local sbtn = UI.button(bar, string.upper(key), "gray", function()
			sortBy = if sortBy == key then "Newest" else key
			page = 1
			render()
		end, { Name = "Sort" .. key, Size = UDim2.new(0.2, -4, 1, 0), TextSize = T.Body, LayoutOrder = i })
		oneLine(sbtn, T.Body)
		UI.setSelected(sbtn, sortBy == key)
	end
	local fb = UI.button(bar, "FAVS", "gray", function()
		favOnly = not favOnly
		page = 1
		render()
	end, { Name = "Favs", Size = UDim2.new(0.2, -4, 1, 0), TextSize = T.Body, LayoutOrder = 4 })
	oneLine(fb, T.Body)
	UI.setSelected(fb, favOnly)
	-- low-poly star left of FAVS (the word moves right to make room)
	local fl = fb:FindFirstChild("Label") :: TextLabel?
	if fl then
		HudArt.image(fb, "TabFavorites", 20, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0) })
		fl.Position = UDim2.new(0, 24, fl.Position.Y.Scale, fl.Position.Y.Offset)
		fl.Size = UDim2.new(1, -28, fl.Size.Y.Scale, fl.Size.Y.Offset)
	end
	local sb = UI.button(bar, if sellMode then "CANCEL" else "SELL", if sellMode then "red" else "gray", function()
		sellMode = not sellMode
		table.clear(picked)
		render()
	end, { Name = "SellMode", Size = UDim2.new(0.2, -4, 1, 0), TextSize = T.Body, LayoutOrder = 5 })
	oneLine(sb, T.Body)
	local footH = T.Touch
	local pages = math.max(1, math.ceil(#list / PAGE))
	page = math.clamp(page, 1, pages)
	local grid = UI.scroller(left, { Name = "Cards", Position = UDim2.fromOffset(0, barH + 6), Size = UDim2.new(1, 0, 1, -(barH + 6 + footH + 4)) })
	-- room under the last row as tall as the footer, so the bottom cards scroll fully clear of Owned / EQUIP BEST
	UI.pad(grid, 2, 2).PaddingBottom = UDim.new(0, footH)
	local gl = Instance.new("UIGridLayout")
	local w = (math.min(UI.Logical.X - 24, 760) - 2 * T.Pad) * (if portrait then 1 else 0.6) - 12
	local cols = math.max(3, math.floor((w + 6) / 92))
	gl.CellSize = UDim2.new(1 / cols, -6, 0, if UI.isShort() then 84 else 96)
	gl.CellPadding = UDim2.fromOffset(6, 6)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	if #list == 0 then
		UI.text(grid, "No favourites yet. Tap Favs to show all.", { Font = UI.Bold, TextSize = T.Small, TextColor3 = TC.Muted, Size = UDim2.new(1, 0, 0, 40) })
	end
	-- the pet that follows you: every card's POWER gets a green up / red down arrow against it
	local followed: Pet? = nil
	local followId = (prof.EquippedPets or {})[1]
	for _, o in prof.Inventory do
		if o.Id == followId then
			followed = o
		end
	end
	local glints: { { card: GuiObject, every: number } } = {}
	for i = (page - 1) * PAGE + 1, math.min(#list, page * PAGE) do
		local x = list[i]
		local isSel = if sellMode then picked[x.Id] == true else detail == x.Id
		local rc, shimmer, rtext = rarityOpts(x)
		local card = UI.specimenCard(grid, i, {
			-- boost shows in the detail view (cards are too narrow for name and boost)
				Name = "Spec_" .. x.Id, Caption = cardLabel(x), Selected = isSel, Picture = geodePicture(x), Rarity = x.Rarity,
			Glow = PetRules.kindColor(PetRules.kindOf(x)), TypeIcon = typeIcon(x),
			RarityColor = rc, Shimmer = shimmer, Thick = x.Rarity == "Legendary", CaptionColor = rtext,
			OnSelect = function()
				if sellMode then
					if sellable(prof, x) then
						picked[x.Id] = if picked[x.Id] then nil else true :: any
						render()
					end
				else
					freshPets[tostring(x.Id)] = nil -- seen now: the "!" and glow go
					detail = x.Id
					render()
				end
			end,
		})
		if freshPets[tostring(x.Id)] and not sellMode then
			-- new since the last look: a red "!" (wiggles in) and a soft breathing glow. The dot sits in a zero-size
			-- holder just outside the card's top-right corner, so it rides over the corner instead of covering the
			-- POWER badge / star inside it (the shared dot's home is 4 px inside its parent)
			local dotHost = UI.frame(card, { Name = "NewDotHost", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 2, 0, -2), Size = UDim2.fromOffset(8, 8), ZIndex = card.ZIndex + 5 })
			UI.newDot(dotHost, true)
			Juice.pulse(card, nil, T.Radius)
		end
		-- a bigger caption than the shared card's (names were tiny on a phone): taller line, picture a bit shorter;
		-- every name stays on one line and shrinks to fit (UI.oneLine lowers the floor): two lines cut words
		-- ("Golder / Puffquill") and crowded the Following / Display tags (Studio 2026-10-16)
		local cap = card:FindFirstChild("Caption") :: TextLabel?
		local cpic = card:FindFirstChild("Picture") :: Frame?
		if cap and cpic then
			cap.Size = UDim2.new(1, -6, 0, 24)
			cap.Position = UDim2.new(0, 3, 1, -2)
			UI.fit(cap, T.Body + 1, T.MinText)
			UI.oneLine(cap)
			cpic.Size = UDim2.new(1, -8, 1, -30)
		end
		-- POWER on the picture's top left (the type icon keeps the bottom right)
		PetStatsStrip.badge(cpic or card, PetStatView.power(x), PetStatView.compare(x, followed), 20, { Position = UDim2.fromOffset(2, 2), ZIndex = 6 })
		local nth = i - (page - 1) * PAGE
		if animateIn and nth <= 12 then
			UI.pop(card, 0.4, nth * 0.035) -- the first cards pop in one after another
		end
		if sellMode and picked[x.Id] then
			local e = card:FindFirstChild("Border") :: UIStroke?
			if e then
				e.Color = TC.Red
			end
		end
		-- card tags never cover the POWER badge (top left): the favourite star sits top right, the Following and
		-- Display words stack under the badge (Studio: "Following" hid the following pet's number)
		if x.Favorite then
			UI.icon(card, "star", 16, { Name = "FavStar", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 4), ZIndex = 7 })
		end
		local tagY = 28
		if isShiny(x) then
			-- the gold SHINY tag under the POWER badge (never over it), ahead of the Following / Display words
			shinyTag(card, 16, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, tagY), Size = UDim2.fromOffset(74, 16), Rotation = -3, ZIndex = 7 })
			tagY += 17
			table.insert(glints, { card = card :: GuiObject, every = GLINT_SHINY })
		elseif x.Rarity == "Legendary" then
			table.insert(glints, { card = card :: GuiObject, every = GLINT_LEGEND })
		end
		if isFollowing(prof, x.Id) then
			UI.text(card, "Following", { Name = "FollowBadge", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Green, Outline = "Normal", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, tagY), Size = UDim2.new(1, -8, 0, 14), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
			tagY += 14
		end
		if slotOf(prof, x.Id) then
			UI.text(card, "Display", { Name = "DisplayBadge", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Gold, Outline = "Normal", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, tagY), Size = UDim2.new(1, -8, 0, 14), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4 })
		end
	end
	startGlints(glints)
	local foot = UI.frame(left, { Name = "Footer", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, footH) })
	if sellMode then
		local ids, total = {}, 0
		for _, x in prof.Inventory do
			if picked[x.Id] then
				table.insert(ids, x.Id)
				total += x.Value
			end
		end
		local s: TextButton
		s = UI.button(foot, "SELL " .. #ids .. " \u{b7} " .. UI.money(total), "red", function()
			confirmSell(prof, ids, s)
		end,{ Name = "SellPicked", Size = UDim2.new(1, 0, 1, 0), TextSize = T.Body })
		UI.setEnabled(s, #ids > 0)
	else
		local pagesW = if pages > 1 then 2 * T.Touch + 8 else 0
		-- two readable lines, inset from the panel's rim (one tiny line touched the frame edge)
		-- one label per line (a single wrapped two-line label scaled its words down to specks, Studio #179)
		local counts = UI.frame(foot, { Name = "Counts", BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -(pagesW + 112 + 12), 1, 0) })
		local lines = {
			"Owned " .. #prof.Inventory .. "/" .. prof.InventoryMax .. (if pages > 1 then " \u{b7} Page " .. page .. "/" .. pages else ""),
			"Following " .. #(prof.EquippedPets or {}) .. "/" .. petSlots(prof),
		}
		for li, line in lines do
			local c = UI.text(counts, line, { Name = "Line" .. li, Font = UI.Bold, TextSize = T.Body + 2, Outline = "Normal", Position = UDim2.new(0, 0, (li - 1) / 2, 0), Size = UDim2.fromScale(1, 0.5) })
			c.TextWrapped = false
			UI.fit(c, T.Body + 2, T.Small)
			c.TextWrapped = false
			c.TextTruncate = Enum.TextTruncate.AtEnd
		end
		-- Equip Best: the server picks the owned pet with the highest POWER (lobby only, PetService)
		local best = UI.button(foot, "EQUIP BEST", "green", function()
			act("EquipBest")
		end, { Name = "EquipBest", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -pagesW, 0, 0), Size = UDim2.new(0, 106, 1, 0), TextSize = T.Body + 1 })
		-- greyed out: the label says why (same checks as PetService)
		local reason: string? = nil
		if State.Match ~= nil then
			reason = "IN A HUNT"
		elseif #prof.Inventory == 0 then
			reason = "NO PETS"
		else
			local bestIds = PetRules.best(prof.Inventory, Config.Pets.Slots)
			local equipped = prof.EquippedPets or {}
			local same = #bestIds == #equipped
			for i, bid in bestIds do
				if equipped[i] ~= bid then
					same = false
				end
			end
			if same then
				reason = "ALREADY BEST"
			end
		end
		-- a greyed button on the pale sheet read grey-on-grey: the off state is the navy tab-bar fill with white words
		best:SetAttribute("DisabledFill", Theme.Pet.TabBar)
		best:SetAttribute("DisabledText", Color3.new(1, 1, 1))
		UI.setEnabled(best, reason == nil)
		if reason then
			UI.setText(best, reason)
		end
		if pages > 1 then
			UI.button(foot, "<", "gray", function()
				page = math.max(1, page - 1)
				render()
			end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -(T.Touch + 4), 0, 0), Size = UDim2.new(0, T.Touch, 1, 0), TextSize = T.Small })
			UI.button(foot, ">", "gray", function()
				page = math.min(pages, page + 1)
				render()
			end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, T.Touch, 1, 0), TextSize = T.Small })
		end
	end
	local right = UI.frame(b, {
		Name = "Side", BackgroundTransparency = 1,
		Position = if portrait then UDim2.new(0, 0, 0.45, top / 2 + 6) else UDim2.new(0.6, 4, 0, top),
		Size = if portrait then UDim2.new(1, 0, 0.55, -(top / 2 + 6)) else UDim2.new(0.4, -4, 1, -top),
	})
	if sellMode then
		UI.text(right, "Tap pets to pick them. Favourites and displayed pets are protected.", { Font = UI.Bold, TextSize = T.Small, TextColor3 = TC.Muted, Size = UDim2.new(1, 0, 0, 60), TextYAlignment = Enum.TextYAlignment.Top })
	elseif g then
		renderDetail(right, prof, g)
	end
end

-- Display tab (board 7): the real slots, a selected slot and its one action.
local function renderDisplay(b: Frame, prof: Prof, top: number)
	local n = prof.DisplaySlots
	slotSel = math.clamp(slotSel, 1, math.max(n, 1))
	local used = #prof.DisplayAssignments
	local placingG = findGeode(prof, placing)
	if placing and not placingG then
		placing = nil
	end
	local info = UI.text(b, "", {
		Name = "DisplaySlots", Font = UI.Bold, TextSize = T.Body, Outline = "Normal", RichText = true,
		Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 0, 22),
	})
	info.Text = if placingG
		then "Display full: pick a slot for <font color=\"#FFC424\">" .. GeodeGen.displayName(placingG) .. "</font>"
		else "Display slots: <font color=\"#FFB020\">" .. used .. "/" .. n .. "</font>   (upgrade in Upgrades > Gallery)"
	local y = top + 26
	local actH = 50
	local gridH = if picker then 0.5 else 1
	local grid = UI.scroller(b, { Name = "Slots", Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, gridH, -(y * gridH + actH + 4)) })
	UI.pad(grid, 2, 2)
	local gl = Instance.new("UIGridLayout")
	local cols = math.clamp(math.floor((math.min(UI.Logical.X - 24, 760) - 2 * T.Pad) / 104), 3, 6)
	-- the slots the next Gallery upgrade adds show as locked frames (Config.Display levels); one short row of cards is
	-- drawn taller so it fills the tab instead of leaving a big empty area
	local capLvl = if type(prof.DisplayCapacity) == "number" then prof.DisplayCapacity else nil
	local nextLvl = if capLvl then Config.Display[capLvl + 1] else nil
	local here = if capLvl then Config.Display[capLvl] else nil
	local cards = n + (if nextLvl and here and not placingG then nextLvl.Slots - here.Slots else 0)
	local cellH = if UI.isShort() then 86 else 100
	if cards <= cols and not picker then
		cellH = if UI.isShort() then 150 else 180
	end
	gl.CellSize = UDim2.new(1 / cols, -8, 0, cellH)
	gl.CellPadding = UDim2.fromOffset(8, 8)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.Parent = grid
	for i = 1, n do
		local occ = findGeode(prof, prof.DisplayAssignments[i])
		UI.specimenCard(grid, i, {
			Name = "Slot" .. i,
			Caption = if occ then PetRules.label(occ, true) else "Empty",
			Empty = occ == nil,
			Selected = i == slotSel,
			Picture = if occ then geodePicture(occ) else nil,
			OnSelect = function()
				if placingG then
					-- a full display: replace the specimen in this slot with the one waiting
					act("DisplayAt", placingG.Id, i)
					placing = nil
					slotSel = i
					render()
					return
				end
				slotSel = i
				picker = false
				render()
			end,
		})
	end
	-- the slots the next Gallery upgrade adds, as locked frames (Config.Display levels; nothing to tap)
	if nextLvl and here and not placingG then
		local upTo = n + (nextLvl.Slots - here.Slots)
		for i = n + 1, upTo do
			local c = UI.specimenCard(grid, i, { Name = "Locked" .. i, Caption = UI.money(nextLvl.Price), Empty = true })
			c.Active = false
			c.AutoButtonColor = false
			c.BackgroundTransparency = 0.45
			local pic = c:FindFirstChild("Picture")
			if pic then
				pic:ClearAllChildren()
				UI.icon(pic, "lock", 30, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
			end
		end
	end
	-- the one action for the selected slot
	local actions = UI.frame(b, { Name = "Actions", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, actH) })
	local selId = prof.DisplayAssignments[slotSel]
	local candidates = {}
	for _, x in sortedList(prof) do
		if not slotOf(prof, x.Id) then
			table.insert(candidates, x)
		end
	end
	if placingG then
		UI.button(actions, "CANCEL", "gray", function()
			placing = nil
			render()
		end, { Name = "Cancel", Size = UDim2.fromScale(1, 1), TextSize = T.Head })
		return
	end
	if picker then
		-- choose a specimen for the selected slot (empty: the next free slot, the list stays dense; occupied: replace)
		local target = if selId then slotSel else used + 1
		local ph = UI.frame(b, { Name = "Picker", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0.5, -(y * 0.5) + 4), Size = UDim2.new(1, 0, 0.5, -(actH + 8) + y * 0.5 - 4) })
		UI.text(ph, (if selId then "Replace slot " else "Place in slot ") .. target .. ": pick a pet", { Font = UI.Bold, TextSize = T.Small, Outline = "Normal", Size = UDim2.new(1, 0, 0, 20) })
		local strip = UI.scroller(ph, { Name = "Choices", Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 1, -22), ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X })
		UI.list(strip, Enum.FillDirection.Horizontal, 6)
		if #candidates == 0 then
			UI.text(strip, "Every pet you own is already on display.", { Font = UI.Bold, TextSize = T.Small, TextColor3 = TC.Muted, Size = UDim2.fromOffset(320, 40) })
		end
		for i, x in candidates do
			local c = UI.specimenCard(strip, i, {
				Name = "Pick_" .. x.Id, Caption = PetRules.label(x, true), Picture = geodePicture(x),
				OnSelect = function()
					act("DisplayAt", x.Id, target)
					picker = false
					render()
				end,
			})
			c.Size = UDim2.new(0, 92, 1, -6)
		end
		UI.button(actions, "CANCEL", "gray", function()
			picker = false
			render()
		end, { Name = "Cancel", Size = UDim2.fromScale(1, 1), TextSize = T.Head })
		return
	end
	if selId then
		local row = UI.frame(actions, { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
		UI.list(row, Enum.FillDirection.Horizontal, 8)
		local rm
		rm = UI.button(row, "REMOVE FROM DISPLAY", "gold", function()
			UI.pending(rm, "REMOVING\u{2026}", 4)
			act("Display", selId, false)
		end, { Name = "Remove", Size = UDim2.new(0.62, -4, 1, 0), TextSize = T.Body + 1, LayoutOrder = 1 })
		local rp = UI.button(row, "REPLACE", "gray", function()
			picker = true
			render()
		end, { Name = "Replace", Size = UDim2.new(0.38, -4, 1, 0), TextSize = T.Body + 1, LayoutOrder = 2 })
		UI.setEnabled(rp, #candidates > 0)
	else
		local pb = UI.button(actions, if #prof.Inventory == 0 then "NO PETS YET" else "PLACE ON DISPLAY", "gold", function()
			picker = true
			render()
		end, { Name = "Place", Size = UDim2.fromScale(1, 1), TextSize = T.Head })
		UI.setEnabled(pb, #candidates > 0)
	end
end

-- Pet Book: every species per zone; unfound ones stay a silhouette ("Not found yet"). % = species found.
-- "50%", "3.9%", "0.1% (1 in 1000)": a chance written so a young player can read it.
local function chanceText(p: number): string
	local pct = p * 100
	local s = if pct >= 10 or math.abs(pct - math.floor(pct + 0.5)) < 0.05 then tostring(math.floor(pct + 0.5)) .. "%" else string.format("%.1f%%", pct)
	if p > 0 and p < 0.01 then
		s ..= " (1 in " .. math.floor(1 / p + 0.5) .. ")"
	end
	return s
end

local function shortChance(p: number): string
	return (string.gsub(chanceText(p), " %(.*%)", ""))
end

local function rarityChances(luck: number?): { [string]: number }
	local w = GeodeGen.rarityWeights(luck)
	local total = 0
	for _, r in Config.Rarities do
		total += w[r] or 0
	end
	local out = {}
	for _, r in Config.Rarities do
		out[r] = if total > 0 then (w[r] or 0) / total else 0
	end
	return out
end

-- The rarity odds card at the top of the Book: one chip per rarity (colour, word, chance).
local function oddsCard(parent: Instance, order: number, prof: Prof)
	local luck = if prof.PetBoosts then prof.PetBoosts.Luck or 0 else 0
	local h = 92 -- compact: shown once, at the top of All
	local card = UI.card(parent, "inset", { Name = "RarityOdds", LayoutOrder = order, Size = UDim2.new(1, -6, 0, h) })
	UI.text(card, "Rarity odds for every pet you hatch", { Name = "Title", Font = UI.Bold, TextSize = T.Small, Outline = "Normal", Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 20) })
	local row = UI.frame(card, { Name = "Chips", Position = UDim2.fromOffset(8, 24), Size = UDim2.new(1, -16, 0, 44), BackgroundTransparency = 1 })
	UI.list(row, Enum.FillDirection.Horizontal, 4)
	local base = rarityChances(0)
	local mine = rarityChances(luck)
	local n = #Config.Rarities
	for i, r in Config.Rarities do
		local chip = UI.frame(row, { Name = "Odds_" .. r, LayoutOrder = i, Size = UDim2.new(1 / n, -math.ceil(4 * (n - 1) / n), 1, 0), BackgroundColor3 = TC.Panel })
		UI.corner(chip, T.RadiusSm)
		UI.stroke(chip, Config.RarityColors[r], 2)
		-- the rarity word sits on a dark pill so every rarity colour reads (light-blue Rare vanished on the blue chip)
		local pill = UI.frame(chip, { Name = "RarityPill", Position = UDim2.fromOffset(3, 2), Size = UDim2.new(1, -6, 0, 18), BackgroundColor3 = PanelSkin.NAVY, BackgroundTransparency = 0.1 })
		UI.corner(pill, 9)
		local name = UI.text(pill, r, { Name = "Rarity", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = Config.RarityTextColors[r], Outline = "Light", Position = UDim2.fromOffset(2, 0), Size = UDim2.new(1, -4, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
		name.TextWrapped = false
		UI.fit(name, T.Tiny, T.MinText)
		local pctLabel = UI.text(chip, shortChance(base[r]), { Name = "Chance", Font = UI.Head, TextSize = T.Body, Outline = "Normal", Position = UDim2.fromOffset(2, 20), Size = UDim2.new(1, -4, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
		pctLabel.TextWrapped = false
		UI.fit(pctLabel, T.Body, T.MinText)
	end
	local legendary = base.Legendary or 0
	local foot = if legendary > 0 then "Legendary: 1 in " .. math.floor(1 / legendary + 0.5) .. " hatches." else ""
	if luck > 0 then
		foot = "With your Luck pet: Rare " .. shortChance(mine.Rare) .. ", Epic " .. shortChance(mine.Epic) .. ", Legendary " .. shortChance(mine.Legendary) .. "."
	end
	local f = UI.text(card, foot, { Name = "Foot", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Muted, Outline = "Light", Position = UDim2.fromOffset(10, h - 22), Size = UDim2.new(1, -20, 0, 18) })
	UI.fit(f, T.Tiny, T.MinText)
end

local MAX_SILHOUETTES = 32 -- 3D pet pictures per Book page (found in colour, unfound as a black shape); the rest keep a plain dot / "?"

local function renderIndex(b: Frame, prof: Prof, top: number)
	local byRarity = prof.DiscoveryRarity or {}
	local entries: { { [string]: any } }, foundN, totalN = {}, 0, 0
	for _, tid in Config.TierOrder do
		local tier = Config.Tiers[tid]
		local shown = bookZone == "All" or bookZone == tier.Name -- the % below still counts every zone
		if shown then
			table.insert(entries, { Header = tier.Name })
		end
		local now = os.time()
		local rp = {}
		local wsum = 0
		for _, r in Config.Rarities do
			wsum += Config.RarityWeights[r]
		end
		for _, r in Config.Rarities do
			rp[r] = Config.RarityWeights[r] / wsum
		end
		for _, id in SpeciesPool.list(tid, now) do -- hidden weekly pets are not listed until they are out
			local share = SpeciesPool.chance(tid, id, now, rp) -- the race egg odds GeodeGen.roll uses
			local m = Config.Minerals[id]
			local row = byRarity[id] or {}
			local n = 0
			for _, r in Config.Rarities do
				if (row[r] or 0) > 0 then
					n += 1
				end
			end
			local seen = n > 0 or (prof.DiscoveryIndex[id] or 0) > 0
			totalN += 1
			if seen then
				foundN += 1
			end
			if shown then
				table.insert(entries, { Id = id, Mineral = m, Row = row, Count = n, Seen = seen, Chance = share, Zone = tier.Name })
			end
		end
	end
	local pct = if totalN > 0 then math.floor(foundN / totalN * 100 + 0.5) else 0
	-- zone filter right under the tabs: All + one chip per zone, each with its low-poly icon (HudArt Tab<Zone>)
	local zones = { "All" }
	for _, tid in Config.TierOrder do
		table.insert(zones, Config.Tiers[tid].Name)
	end
	local zoneH = chipH()
	local zr = UI.frame(b, { Name = "ZoneTabs", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 0, zoneH) })
	UI.list(zr, Enum.FillDirection.Horizontal, 4)
	local nz = #zones
	for i, z in zones do
		local chip = UI.button(zr, z, "gray", function()
			if bookZone ~= z then
				bookZone = z
				render()
			end
		end, { Name = "Zone_" .. z, LayoutOrder = i, TextSize = T.Small + 1, Size = UDim2.new(1 / nz, -math.ceil(4 * (nz - 1) / nz), 1, 0) })
		UI.setSelected(chip, bookZone == z)
		local cl = chip:FindFirstChild("Label") :: TextLabel?
		if UI.isPortrait() then
			-- six chips on a phone held upright: picture only (the zone name heads its list below)
			HudArt.image(chip, "Tab" .. z, 32, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
			if cl then
				cl.Visible = false
			end
		elseif cl then
			-- the picture steps aside when the zone name would not fit beside it at a readable size (Studio #177)
			local zpic = HudArt.image(chip, "Tab" .. z, 30, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0) })
			cl.Font = UI.Bold
			cl.Text = z
			cl.TextWrapped = false
			cl.Position = UDim2.new(0, 3, 0.5, -11)
			cl.Size = UDim2.new(1, -6, 0, 22)
			UI.fit(cl, T.Small, T.Small)
			cl.TextWrapped = false
			UI.tabIconWord(chip, cl, zpic, 30, T.Small) -- picture and name centred as one group
		end
	end
	local sc = UI.scroller(b, { Position = UDim2.fromOffset(0, top + zoneH + 6), Size = UDim2.new(1, 0, 1, -(top + zoneH + 6)) })
	UI.pad(sc, 2, 2)
	UI.list(sc, Enum.FillDirection.Vertical, 6)
	-- how much of the Book is filled: a readable line with a bar, at the head of the list (scrolls away with it)
	local sum = UI.card(sc, "inset", { Name = "IndexSummary", LayoutOrder = -2, Size = UDim2.new(1, -6, 0, 50) })
	local sl = UI.text(sum, "Pet Book " .. pct .. "% complete \u{b7} " .. foundN .. "/" .. totalN .. " pets", { Name = "Text", Font = UI.Bold, TextSize = T.Body, Outline = "Normal", Position = UDim2.fromOffset(12, 2), Size = UDim2.new(1, -24, 0, 24) })
	sl.TextWrapped = false
	UI.fit(sl, T.Body, T.MinText)
	local _, fill = UI.bar(sum, { Name = "Progress", Position = UDim2.fromOffset(12, 30), Size = UDim2.new(1, -24, 0, 12) }, TC.Gold)
	fill.Size = UDim2.fromScale(if totalN > 0 then foundN / totalN else 0, 1)
	-- Pet Book pages by zone name (the synced view when the server sent it, else the same rules run here)
	local pages: { [string]: EggPerks.Page } = {}
	local perks: any = prof.EggPerks
	local pageList: { EggPerks.Page } = if type(perks) == "table" and type(perks.Pages) == "table" then perks.Pages else EggPerks.pages(prof.DiscoveryIndex)
	for _, pg in pageList do
		pages[pg.Name] = pg
	end
	local silhouettes = 0
	for i, c in entries do
		if c.Header then
			-- zone name on the left; the page's progress and its lasting bonus (shared/EggPerks) on the right
			local hr = UI.frame(sc, { Name = "Zone_" .. c.Header, BackgroundTransparency = 1, LayoutOrder = i, Size = UDim2.new(1, -6, 0, 22) })
			UI.text(hr, string.upper(c.Header), { Name = "Name", Font = UI.Head, TextSize = T.Body, TextColor3 = TC.Gold, Outline = "Normal", Size = UDim2.new(0.42, 0, 1, 0) })
			local page = pages[c.Header]
			if page then
				local bonus = math.floor(EggPerks.Pages.CoinsPerPage * 100 + 0.5)
				local txt = if page.Done then string.format("FULL PAGE  +%d%% coins & XP", bonus) else string.format("%d/%d  \u{b7}  full page = +%d%% coins & XP", page.Found, page.Need, bonus)
				local pl = UI.text(hr, txt, { Name = "Page", Font = UI.Bold, TextSize = T.Small, TextColor3 = if page.Done then Theme.Pet.Lime else TC.Muted, Outline = "Normal", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.58, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right })
				pl.TextWrapped = false
				UI.fit(pl, T.Small, T.MinText)
			end
			continue
		end
		local f = UI.card(sc, "inset", { LayoutOrder = i, Name = "Mineral_" .. c.Id, Size = UDim2.new(1, -6, 0, 70) })
		if animateIn and i <= 14 then
			UI.pop(f, 0.5, i * 0.03) -- rows pop in one after another when the Book opens
		end
		local dot = UI.frame(f, { Name = "Dot", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), Size = UDim2.fromOffset(48, 48), BackgroundColor3 = if c.Seen then c.Mineral.Crystal else TC.GrayDeep })
		UI.corner(dot, 24)
		UI.stroke(dot, if c.Seen then c.Mineral.Rim else TC.Outline, 2)
		local petSpec = { Mineral = c.Id, Formation = "Cluster", Modifier = "Natural", Rarity = "Common", Mass = 1.2, Seed = 1 }
		if c.Seen then
			if silhouettes < MAX_SILHOUETTES then
				-- the pet itself on a cream plate (a plain colour dot read as a green circle, Studio #180)
				silhouettes += 1
				dot.BackgroundTransparency = 1
				local edge = dot:FindFirstChildOfClass("UIStroke")
				if edge then
					edge.Enabled = false
				end
				GeodeView.make(dot, petSpec, { Name = "Picture", Size = UDim2.fromScale(1, 1), Backing = true })
			end
		else
			dot.BackgroundTransparency = 1
			if silhouettes < MAX_SILHOUETTES then
				-- the pet's own shape drawn pure black (the viewport tint), so each unfound row hints at a different pet
				silhouettes += 1
				local vp = GeodeView.make(dot, petSpec, { Name = "Silhouette", Size = UDim2.fromScale(1, 1) })
				vp.ImageColor3 = Color3.new(0, 0, 0)
				vp.Ambient = Color3.new(0, 0, 0)
				vp.LightColor = Color3.new(0, 0, 0)
			else
				-- past the cap (each picture is a 3D view): the plain shape with a question mark
				UI.icon(dot, "egg", 34, { Name = "Silhouette", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Color = TC.PanelEdge, Flat = true })
				UI.text(dot, "?", { Name = "Unknown", Font = UI.Head, TextSize = T.Head, TextColor3 = TC.Faint, Outline = "Light", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
			end
		end
		UI.text(f, if c.Seen then c.Mineral.Name else "Not found yet", { Name = "Name", Font = UI.Bold, TextSize = T.Body, Outline = "Normal", TextColor3 = if c.Seen then TC.Text else TC.Faint, Position = UDim2.fromOffset(62, 4), Size = UDim2.new(1, -186, 0, 24) })
		-- hatch chance in its zone (shown for unfound pets too: it is a fact of the game, not a spoiler)
		local ch = UI.text(f, chanceText(c.Chance), { Name = "Chance", Font = UI.Head, TextSize = T.Head, TextColor3 = TC.Count, Outline = "Normal", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(112, 26), TextXAlignment = Enum.TextXAlignment.Right })
		ch.TextWrapped = false
		-- one line that shrinks to the floor ("of Volcano pets" wrapped into three lines in its 18 px box)
		local cz = UI.text(f, "of " .. c.Zone .. " pets", { Name = "ChanceZone", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Muted, Outline = "Light", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 38), Size = UDim2.fromOffset(112, 18), TextXAlignment = Enum.TextXAlignment.Right })
		cz.TextWrapped = false
		UI.fit(cz, T.Tiny, T.MinText)
		cz.TextWrapped = false
		if c.Seen then
			local kind = (c.Mineral :: any).BoostKind or "Coins"
			-- one line that shrinks a little to stay whole (it wrapped into a box one line tall and was cut, Studio #180)
			local l2 = UI.text(f, c.Count .. " of 5 rarities \u{b7} gives " .. (KIND_WORD[kind] or "coins"), { Name = "Line2", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Muted, Outline = "Light", Position = UDim2.fromOffset(62, 27), Size = UDim2.new(1, -190, 0, 20) })
			l2.TextWrapped = false
			UI.fit(l2, T.Tiny, 10)
			l2.TextWrapped = false
			l2.TextTruncate = Enum.TextTruncate.AtEnd
			for k, r in Config.Rarities do
				local has = (c.Row[r] or 0) > 0
				local gem = UI.frame(f, { Name = "Gem_" .. r, Position = UDim2.fromOffset(62 + (k - 1) * 22, 48), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = if has then Config.RarityColors[r] else TC.GrayDeep })
				UI.corner(gem, T.RadiusSm)
			end
		else
			local l2 = UI.text(f, "Hatch eggs in the " .. c.Zone .. " zone", { Name = "Line2", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Faint, Outline = "Light", Position = UDim2.fromOffset(62, 30), Size = UDim2.new(1, -190, 0, 20) })
			l2.TextWrapped = false
			UI.fit(l2, T.Tiny, 10)
			l2.TextWrapped = false
			l2.TextTruncate = Enum.TextTruncate.AtEnd
		end
	end
	-- the rarity odds are the same in every zone: shown once, on All, after the last page (first they hid the
	-- pages below the fold on a 390 px tall window)
	if bookZone == "All" then
		oddsCard(sc, #entries + 1, prof)
	end
end

-- Materials: a checklist of ordinary stone types cracked (presentation only: nothing here changes a price).
local function renderMaterials(b: Frame, prof: Prof, top: number)
	local mats = prof.Materials or { Found = {}, Counts = {} }
	local have, total = Materials.progress(mats)
	UI.text(b, "Materials discovered: " .. have .. "/" .. total, { Name = "MaterialsProgress", Font = UI.Bold, TextSize = T.Body, Outline = "Normal", Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 0, 22) })
	local sc = UI.scroller(b, { Position = UDim2.fromOffset(0, top + 26), Size = UDim2.new(1, 0, 1, -(top + 26)) })
	UI.pad(sc, 2, 2)
	UI.list(sc, Enum.FillDirection.Vertical, 6)
	for i, id in Materials.order() do
		local mat = Config.Materials[id]
		local found = mats.Found[id] == true
		local row = UI.card(sc, "inset", { Name = "Material_" .. id, Size = UDim2.new(1, -6, 0, 70), LayoutOrder = i })
		MaterialThumb.make(row, id, found, 48, { Position = UDim2.fromOffset(10, 11) })
		UI.text(row, if found then mat.Name else "Unknown material", { Name = "Name", Font = UI.Bold, TextSize = T.Body, Outline = "Normal", TextColor3 = if found then TC.Text else TC.Faint, Position = UDim2.fromOffset(70, 4), Size = UDim2.new(1, -180, 0, 22) })
		UI.text(row, if found then mat.Desc else "Hatch more eggs to find out what is inside.", { Name = "Desc", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Muted, Outline = "Light", TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(70, 28), Size = UDim2.new(1, -80, 0, 38) })
		if found then
			UI.text(row, "Found " .. (mats.Counts[id] or 0), { Name = "Count", Font = UI.Head, TextSize = T.Body, TextColor3 = TC.Count, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -110, 0, 4), Size = UDim2.fromOffset(100, 22) })
		end
	end
end

-- Record rows slide in from the right one after another. Unlike Juice.slideIn this eases without overshoot (the Back
-- overshoot pushed rows past the left edge and cut their first letters) and snaps every row to its resting spot once
-- the slide should be over, so an interrupted tween (re-render, app backgrounded on a phone) never leaves rows
-- staggered sideways.
local function slideIn(row: GuiObject, order: number)
	if UI.Reduced or not row.Parent then
		return
	end
	local holder = Instance.new("Frame")
	holder.Name = row.Name
	holder.BackgroundTransparency = 1
	holder.Size = row.Size
	holder.LayoutOrder = row.LayoutOrder
	holder.Parent = row.Parent
	row.Size = UDim2.fromScale(1, 1)
	row.Position = UDim2.fromScale(0.6, 0)
	row.Parent = holder
	local delay = math.max(0, order - 1) * 0.04
	TweenService:Create(row, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay), { Position = UDim2.new() }):Play()
	task.delay(delay + 0.35, function()
		if row.Parent then
			row.Position = UDim2.new()
		end
	end)
end

-- Records (additional board 4): the server's own numbers, or an honest unavailable state.
local function renderRecords(b: Frame, prof: Prof?, top: number, which: string?)
	local st = prof and prof.Stats
	if not prof or type(st) ~= "table" then -- (st is nil whenever prof is)
		if os.clock() < recordsWaitUntil then
			UI.loadingState(b, "Loading records", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, top / 2) })
			return
		end
		UI.errorState(b, "Records unavailable", "Your records could not be loaded right now.", function()
			recordsWaitUntil = os.clock() + 6
			Net.event("ClientReady"):FireServer() -- asks the server to send the profile again (rate limited there)
			render()
			task.delay(6.1, render)
		end, function()
			if closeRef then
				closeRef()
			end
		end, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, top / 2) })
		return
	end
	-- Records: three big rows that share the tab's height (no empty panel under them); Stats: a scrolling list
	local sc: GuiObject = if which ~= "Stats"
		then UI.frame(b, { Name = "Records", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 1, -top) })
		else UI.scroller(b, { Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 1, -top) })
	UI.pad(sc, 2, 2)
	UI.list(sc, Enum.FillDirection.Vertical, 8)
	local function big(order: number, icon: string, label: string, value: any)
		local row = UI.card(sc, "inset", { Name = "Record_" .. label, Size = UDim2.new(1, -6, 1 / 3, -6), LayoutOrder = order })
		local cap = Instance.new("UISizeConstraint")
		cap.MaxSize = Vector2.new(math.huge, 110)
		cap.MinSize = Vector2.new(0, 50)
		cap.Parent = row
		UI.icon(row, icon, 48, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0) })
		local l = UI.text(row, label, { Name = "Label", Font = UI.Bold, TextSize = T.Head + 2, Outline = "Normal", Position = UDim2.fromOffset(76, 0), Size = UDim2.new(1, -(76 + 112 + 24), 1, 0) })
		l.TextWrapped = false
		-- the number sits in a flat squared chip (a big gold number under a heavy outline read as a coin, Studio #181)
		local chip = UI.frame(row, { Name = "ValueChip", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.new(0, 112, 0.62, 0), BackgroundColor3 = TC.Panel })
		local cc = Instance.new("UISizeConstraint")
		cc.MaxSize = Vector2.new(112, 50)
		cc.Parent = chip
		UI.corner(chip, T.RadiusSm)
		UI.stroke(chip, TC.InsetEdge, 1.5)
		local v = UI.text(chip, tostring(value), { Name = "Value", Font = UI.Head, TextSize = T.Title, TextColor3 = TC.Text, Outline = "Normal", Position = UDim2.fromOffset(6, 0), Size = UDim2.new(1, -12, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
		v.TextWrapped = false
		if animateIn then
			slideIn(row, order) -- the record rows slide in one after another when the tab opens
		end
	end
	local function stat(order: number, label: string, value: string)
		local row = UI.statRow(sc, order, label, value)
		if animateIn and order <= 14 then
			slideIn(row, order - 3)
		end
	end
	if which ~= "Stats" then
		big(1, "star", "Solo finds", st.SoloFinds or 0)
		big(2, "trophy", "Competitive wins", st.MultiplayerWins or 0)
		big(3, "calendar", "Matches played", st.MatchesPlayed or 0)
		return
	end
	stat(4, "Eggs hatched", tostring(st.RocksCracked or 0))
	stat(5, "Coins earned", UI.money(st.CashEarned or 0))
	-- best pet value in the same coins the SELL button shows (each pet's Value is Profiles.priceValue); the saved
	-- record only counts hunt finds, so a tower or Robux egg pet would otherwise sell for more than the "best"
	local best = if type(st.BestGeodeValue) == "number" then st.BestGeodeValue else 0
	for _, g in prof.Inventory do
		if type(g.Value) == "number" and g.Value > best then
			best = g.Value
		end
	end
	stat(6, "Best pet value", UI.money(best))
	stat(7, "Pets owned", tostring(#prof.Inventory))
	local pb = prof.PetBoost
	local boostLine = if pb and pb.Kind and pb.Amount > 0 then PetStatView.pct(pb.Amount) .. " " .. (KIND_WORD[pb.Kind] or "coins") else "none yet"
	stat(8, "Your pet gives", boostLine)
	-- launch badges (the server awards the Roblox badge once the owner has set its id)
	local progress = ProgressConfig.badgeProgress({
		Stats = st, DiscoveryIndex = prof.DiscoveryIndex, DiscoveryRarity = prof.DiscoveryRarity, Inventory = prof.Inventory,
		TowerBest = prof.TowerBest, UnlockedTiers = prof.UnlockedTiers, SecretEggFound = prof.SecretEggFound,
	})
	for i, key in ProgressConfig.BadgeOrder do
		local bd = ProgressConfig.Badges[key]
		local p = progress[key]
		stat(8 + i, bd.Name, if p.Done then "earned" elseif key == "SecretEgg" then "???" elseif p.Need > 1 then (p.Have .. "/" .. p.Need) else "not yet")
	end
	-- room under the last row so it scrolls fully clear of the panel's bottom edge (it was cut off, Studio #182)
	UI.frame(sc, { Name = "EndSpacer", BackgroundTransparency = 1, LayoutOrder = 10000, Size = UDim2.new(1, 0, 0, 24) })
end

-- third entry: the low-poly tab icon (HudArt Icon* slots)
local TABS = {
	{ "Collection", "Pets", HudArt.Slots.IconPets.Image },
	{ "Index", "Book", HudArt.tabPicture("IconPetBook") or "" },
	{ "Records", "Records", HudArt.Slots.IconLeaderboard.Image },
	{ "Stats", "Stats" },
	{ "Display", "Display" },
}

local function modalSize(): Vector2
	if UI.isPortrait() then
		return Vector2.new(480, 720)
	elseif UI.Logical.Y >= 600 then
		return Vector2.new(780, 480)
	end
	return Vector2.new(700, 380)
end

function render()
	if not open or not body then
		return
	end
	local b = body :: Frame
	for _, c in b:GetChildren() do
		if not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
	if panelRef then
		UI.fitModal(panelRef, modalSize())
	end
	UI.tabBar(b, TABS, tab, function(name)
		tab = name
		animateIn = true
		picker = false
		placing = nil
		sellMode = false
		render()
	end)
	local top = T.Tab + T.Gap
	local prof = State.Profile
	if not prof then
		if tab == "Records" or tab == "Stats" then
			renderRecords(b, nil, top, tab)
		else
			UI.loadingState(b, "Loading Pet Book", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, top / 2) })
		end
		return
	end
	if tab == "Collection" then
		renderCollection(b, prof, top)
	elseif tab == "Display" then
		renderDisplay(b, prof, top)
	elseif tab == "Index" then
		renderIndex(b, prof, top)
	elseif tab == "Materials" then
		renderMaterials(b, prof, top)
	else
		renderRecords(b, prof, top, tab)
	end
	animateIn = false
end

function Collection.open(openTab: string?)
	if type(openTab) == "string" then
		for _, t in TABS do
			if t[1] == openTab then
				tab = openTab
			end
		end
	end
	local panel, b, close = UI.modal("Collection", "PET BOOK", modalSize(), { Fixed = true })
	PanelSkin.dress(panel, "IconPetBook", "PET BOOK")
	panelRef = panel
	body = b
	closeRef = close
	open = true
	animateIn = true
	picker = false
	placing = nil
	sellMode = false
	local conn
	conn = UI.ModalChanged.Event:Connect(function(name)
		if name ~= "Collection" then
			table.clear(freshPets) -- the player has looked: nothing is new next time
			open = false
			body = nil
			panelRef = nil
			closeRef = nil
			glintGen += 1 -- the card glint loop ends with the panel
			conn:Disconnect()
		end
	end)
	render()
end

-- Opens straight on one specimen (used by the tutorial's display step).
-- MY PETS' DISPLAY with every dome full: the Display tab, already placing this pet (tap a dome to swap it in)
function Collection.openPlacing(id: string)
	tab = "Display"
	Collection.open()
	placing = id
	render()
end

function Collection.openOn(id: string?)
	tab = "Collection"
	detail = id
	Collection.open()
end

-- Profile updates come in bursts (sell, place, reward); each one used to rebuild the whole Pet Book (audit 31).
-- Closed panel: nothing to do (render returns at once). Open: a burst is coalesced into one rebuild 0.1 s later.
local renderQueued = false
function Collection.start()
	trackFresh(State.Profile)
	State.Changed.Event:Connect(function(what)
		if what == "Profile" then
			trackFresh(State.Profile)
		end
		if what == "Profile" and open and not renderQueued then
			renderQueued = true
			task.delay(0.1, function()
				renderQueued = false
				render()
			end)
		end
	end)
end

return Collection
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="351">
            <Properties>
              <string name="Name">GeodeView</string>
              <string name="Source"><![CDATA[--!strict
-- ViewportFrame showing one pet (GeodeModel.build -> PetModel), framed from the model's bounding box (no
-- cropping). The pet faces the camera (-Z), turned about 22 degrees so its round 3D shape reads; manual drag turns
-- it (no forced spin). A WorldModel holds the parts. Bright, soft light for the pastel look.
-- The hatch reveal (RevealView), results, collection and inspect panels all use this same view.

local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GeodeModel = require(Shared.GeodeModel)

local GeodeView = {}

local FOV = 32
local BASE_YAW = math.rad(-22) -- a slight 3/4 turn so the round body reads (a flat front view looks like a sticker)
GeodeView.Yaw = BASE_YAW
GeodeView.Ambient = Color3.fromRGB(150, 146, 160)
GeodeView.LightColor = Color3.fromRGB(255, 244, 228)
GeodeView.LightDirection = Vector3.new(-0.45, -0.6, 0.66)

-- The pet's own box: see-through effect parts (the wide rarity aura ring on the ground, glow discs) are left out,
-- or a small pet is framed for the size of its ring and shows up tiny in its card.
local function bodyBox(model: Model): (Vector3, Vector3)
	local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 0.5 and d.Name ~= "Aura" and d.Name ~= "TypeGlow" then
			local half = d.Size * 0.5
			for _, sx in { -1, 1 } do
				for _, sy in { -1, 1 } do
					for _, sz in { -1, 1 } do
						local p = d.CFrame:PointToWorldSpace(Vector3.new(half.X * sx, half.Y * sy, half.Z * sz))
						lo = lo:Min(p)
						hi = hi:Max(p)
					end
				end
			end
		end
	end
	if lo.X > hi.X then
		local cf, size = model:GetBoundingBox()
		return cf.Position, size
	end
	return (lo + hi) / 2, hi - lo
end

-- Camera on the -Z side (the pet faces -Z), slightly above, far enough that the whole
-- bounding sphere fits with a margin.
function GeodeView.frame(cam: Camera, model: Model, margin: number?)
	local centre, size = bodyBox(model)
	local radius = size.Magnitude / 2 * (margin or 0.9) -- the box diagonal over-states the round pet, 0.9 still fits
	local dist = radius / math.tan(math.rad(FOV / 2))
	local target = centre
	local pitch = math.rad(16)
	cam.FieldOfView = FOV
	cam.CFrame = CFrame.lookAt(target + Vector3.new(0, math.sin(pitch) * dist, -math.cos(pitch) * dist), target)
end

function GeodeView.make(parent: Instance, spec, props: { [string]: any }?, draggable: boolean?): (ViewportFrame, Model, Camera)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Ambient = GeodeView.Ambient
	vp.LightColor = GeodeView.LightColor
	vp.LightDirection = GeodeView.LightDirection
	local backing = false
	if props then
		for k, v in props do
			if k == "Backing" then
				backing = v == true
			else
				(vp :: any)[k] = v
			end
		end
	end
	if backing then
		-- a soft cream plate behind the pet, so blue and green pets don't melt into the blue menu
		vp.BackgroundColor3 = Color3.fromRGB(255, 248, 232)
		vp.BackgroundTransparency = 0.1
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 10)
		c.Parent = vp
	end
	vp.Parent = parent
	local world = Instance.new("WorldModel")
	world.Parent = vp
	local model = GeodeModel.build(spec, { Scale = 1 })
	-- the evolve force-field shell reads as a solid ball in a viewport; picture cards keep the sparkles only
	local aura = model:FindFirstChild("EvolveAura")
	if aura and aura:IsA("BasePart") then
		aura.Transparency = 1
	end
	model.Parent = world
	local cam = Instance.new("Camera")
	cam.Parent = vp
	vp.CurrentCamera = cam
	GeodeView.frame(cam, model)
	model:PivotTo(CFrame.Angles(0, BASE_YAW, 0))
	if draggable then
		local yaw = BASE_YAW
		local dragging: InputObject? = nil
		local last = Vector2.zero
		vp.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = input
				last = Vector2.new(input.Position.X, input.Position.Y)
			end
		end)
		local c1 = UserInputService.InputChanged:Connect(function(input: InputObject)
			if dragging and (input == dragging or input.UserInputType == Enum.UserInputType.MouseMovement) and vp.Parent then
				local pos = Vector2.new(input.Position.X, input.Position.Y)
				yaw = math.clamp(yaw + (pos.X - last.X) * 0.01, -1.3, 1.3)
				last = pos
				model:PivotTo(CFrame.Angles(0, yaw, 0))
			end
		end)
		local c2 = UserInputService.InputEnded:Connect(function(input)
			if input == dragging or input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = nil
			end
		end)
		vp.Destroying:Connect(function()
			c1:Disconnect()
			c2:Disconnect()
		end)
	end
	return vp, model, cam
end

return GeodeView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="352">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Always-on HUD, UI v2 (docs/ui_v2/BRIEF_UI_V2.md, boards 1-3).
--   Lobby: cash (and the rubble bag when it holds any) top left; a compact right column with Settings, Upgrades,
--     Collection and Party; the first-hunt cue pill and tutorial hints. Nothing hunt-only.
--   Hunt: objective card top centre, the real round timer top right (with the pile count), labelled counters top
--     left (CARRIED basket, QUEUE at the station, RUBBLE storage), a processing card that reflects the server's
--     plate state, tool slots (1 HAND / 2 tool) bottom centre, the contextual action bottom right (placed by
--     TouchLayout clear of the jump button), Settings and Lobby in the right column.
--   Notifications go through UI.notify (coalesced, above menus).
-- While a menu, dialog or the reveal owns the screen, gameplay pieces hide and holding stops.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Config = require(Shared.Config)
local State = require(script.Parent.Parent.State)
local PileView = require(script.Parent.Parent.PileView)
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local QuestPanel = require(script.Parent.QuestPanel)
local Audio = require(script.Parent.Parent.Audio)
local Effects = require(script.Parent.Parent.Effects)
local GuideArrow = require(script.Parent.Parent.GuideArrow)
local ActionRules = require(Shared.ActionRules)
local TouchLayout = require(Shared.TouchLayout)
local ColumnFit = require(Shared.ColumnFit)
local SafeZones = require(Shared.SafeZones)
local StarterEggView = require(script.Parent.Parent.StarterEggView)
local RaceRules = require(Shared.RaceRules)
local EggConfig = require(Shared.EggConfig)
local Juice = require(script.Parent.Juice)
local HudArt = require(script.Parent.HudArt)
local PetStyle = require(script.Parent.PetStyle)
local ItemView = require(script.Parent.ItemView)
local PanelSkin = require(script.Parent.PanelSkin)

local FEW_EGGS = 10 -- the "10 EGGS LEFT!" banner
local fewShownFor: number? = nil -- SearchStart of the hunt the banner was shown for
local fewArmedFor: number? = nil -- SearchStart of the hunt whose pile was seen above FEW_EGGS
local seenPets: number? = nil -- pets owned when the Pet Book was last open (red "!" on its tile)
local lastPets: number? = nil -- pets owned at the last HUD refresh
local pulseSecond = -1 -- last whole second the timer pulsed
local shookTimer = false -- the one-time shake at the start of the red countdown
local lastObjPhase: string? = nil -- phase the objective title last slid in for
local lastActPickup = false -- PICK UP was showing on the previous tick

local C = UI.Colors
local T = UI.T
local TC = Theme.Color
local Hud = {}

Hud.hintText = nil :: (() -> string?)?
Hud.hintDismissed = nil :: string?

local player = Players.LocalPlayer
local refs: { [string]: any } = {}
local openPanel: (string) -> () = function() end
local shownCash = -1
local cashTween: Tween? = nil
local cashValue = Instance.new("NumberValue")

local basketWasFull = false
local queueWasFull = false
local pileWarned = false
local LEFT_W = 132
local FIT_MIN_CARD = 40 -- smallest left-column card height (logical px) when the column is squeezed on a short phone
local BOX_PAD = 12 -- room left of the column inside that box
local LEFT_GAP = 14 -- minimum screen px between the left HUD cards and the safe-area edge
local TILE = 68 -- menu tile (bug #218: the 60 px tiles read cramped with tiny captions on a phone)
local RIGHT_W = 72
local LOBBY_W = 172 -- lobby buttons in the left column (PLAY, the TOWER + photo row, DAILY) share one width
local BOX_W = 2 * LOBBY_W + 6 + 24 -- clipped box around the left column: TOWER + BATTLE side by side, plus rims and dots
local SLOT = 76-- one hunt hotbar slot (HAND / tool)
local DOCK_W = 2 * SLOT + 8 -- hunt tool dock (bottom centre)
local RACE_H = 24 -- one race bar row (name, eggs cracked, share bar)

-- Lobby HUD v2 (ui/LobbyHudV2) takes over the lobby: the old left column and tile menu hide in the lobby while it
-- is on (they come back in hunts, and whenever it is off).
local lobbyHidden = false
function Hud.setLobbyHidden(on: boolean)
	if lobbyHidden ~= on then
		lobbyHidden = on
		Hud.refresh()
	end
end

function Hud.setPanelOpener(fn: (string) -> ())
	openPanel = fn
end

local TOOL_SHORT = { Hammer = "COLLAR", SteelHammer = "TREATS", Jackhammer = "WHISTLE" }
local MACHINE_ICON = { AutoCracker = "machine", HydraulicPress = "press", IndustrialCrusher = "crusher" }

local function myMachine(m: any): any?
	for _, e in (m and m.Machines) or {} do
		if e.UserId == player.UserId then
			return e
		end
	end
	return nil
end

local function ownStation(m: any): any?
	for _, st in (m and m.Stations) or {} do
		if st.UserId == player.UserId then
			return st
		end
	end
	return nil
end

-- Daily rewards ready to claim (the red number on DAILY): quests done and not claimed, plus the gift when it is
-- ready, read from the rows the server sent (the same rule as shared/Quests.view's Claimable, which is the fallback).
local function dailyReady(prof: any): number
	local d = prof and prof.Daily
	if type(d) ~= "table" then
		return 0
	end
	if type(d.Quests) ~= "table" or type(d.Gift) ~= "table" then
		return tonumber(d.Claimable) or 0
	end
	local n = if d.Gift.Ready == true then 1 else 0
	for _, q in d.Quests do
		if q.Done == true and q.Claimed ~= true then
			n += 1
		end
	end
	return n
end
Hud.dailyReady = dailyReady -- LobbyHudV2's DAILY reminder wiggle

-- Compact menu tile (lobby mockup): blue rounded square, picture, one-word caption. `icon` is a HudArt slot (owner
-- picture with a stand-in) or a plain UI.icon kind.
local BAG_FOLD_W = 150 -- the candy bag pill, folded for the landscape phone row (Hud.arrangeLobby)
local TILE_CAP = T.Body + 2 -- tile caption size (fitted down to T.Small when "Settings" needs it; the body size read tiny on a phone)
-- The red count badge (UI.newDot) on a 12 px anchor: made now, 34 px across (UI.newDot draws 20; 28 real px or
-- more at the phone scale), its number at body size, so it reads on a phone. UI.newDot keeps the frame on later
-- calls (it only flips Visible and the number).
local function badge(anchor: Frame): Frame
	local d = UI.newDot(anchor, false)
	d.Size = UDim2.fromOffset(34, 34)
	local mark = d:FindFirstChild("Mark") :: TextLabel?
	if mark then
		UI.fit(mark, T.Body + 4, T.MinText)
	end
	return d
end

local function tile(parent: Instance, name: string, caption: string?, icon: string, order: number, onClick: () -> (), small: boolean?): TextButton
	local s = if small then 44 else TILE
	local b = UI.button(parent, "", "blue", onClick, { Name = name, Size = UDim2.fromOffset(s, s), LayoutOrder = order })
	UI.corner(b, 14)
	if not small then
		if Theme.PetStyle then
			PetStyle.iconTile(b, s) -- the video's square: light top, dark lip, drifting streaks, white rim
		else
			HudArt.skin(b, "btn_square_blue")
		end
	end
	local l = b:FindFirstChild("Label")
	if l then
		l:Destroy()
	end
	local hasCap = caption ~= nil and not small
	local isz = if small then 28 else (if hasCap then 38 else 42)
	local iprops = { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, if small then 8 elseif hasCap then 3 else 11), ZIndex = 3 }
	if HudArt.Slots[icon] then
		HudArt.image(b, icon, isz, iprops)
	else
		UI.icon(b, icon, isz, iprops)
	end
	if hasCap then
		-- plain words on all four tiles, one size: the word pictures (only Upgrade and Party have one) shrank into a
		-- thin strip at this width and made those two captions smaller than the others;
		-- the box runs 3 px past each side of the tile so "Settings" keeps the full size
		local cap = UI.text(b, caption :: string, { Name = "Caption", Font = UI.Bold, TextSize = TILE_CAP, Outline = "Normal", Size = UDim2.new(1, 8, 0, 24), Position = UDim2.new(0, -4, 1, -25), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
		cap.TextWrapped = false
		UI.fit(cap, TILE_CAP, T.Small)
	end
	return b
end

-- Tool slot (board 2/3): number, icon, caption; gold ring when it is the tool in use. Display only: tools follow
-- the context (hand at the pile, hammer at the plate), there is no manual switching in this game.
local SLOT_ICON = 40 -- hotbar picture size
local function toolSlot(parent: Instance, name: string, num: string, icon: string, caption: string, order: number): Frame
	local f = UI.card(parent, "hud", { Name = name, Size = UDim2.fromOffset(SLOT, SLOT + 2), LayoutOrder = order })
	UI.text(f, num, { Name = "Num", Font = UI.Head, TextSize = T.Body, Outline = "Strong", Position = UDim2.fromOffset(6, 3), Size = UDim2.fromOffset(18, 20) })
	refs[name .. "Icon"] = UI.icon(f, icon, SLOT_ICON, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8) })
	local cap = UI.text(f, caption, { Name = "Caption", Font = UI.Head, TextSize = T.Body, Outline = "Normal", Position = UDim2.new(0, 2, 1, -23), Size = UDim2.new(1, -4, 0, 21), TextXAlignment = Enum.TextXAlignment.Center })
	cap.TextWrapped = false
	UI.fit(cap, T.Body, T.MinText) -- RAINBOW is the longest tool word; it shrinks rather than clipping to "RAINBO"
	return f
end

-- Hunt hotbar (owner mockup reference/ui/hunt_hud): the tool in use is a gold slot, the other blue. The blue slot can
-- carry the owner's picture (HudArt slot_blue, added once); the gold one is drawn over it.
local function setSlot(f: Frame, on: boolean)
	if not f:GetAttribute("Skinned") then
		f:SetAttribute("Skinned", true)
		HudArt.skin(f, "slot_blue", SLOT + 2)
	end
	local skin = f:FindFirstChild("Skin") :: ImageLabel?
	local edge = f:FindFirstChild("Border") :: UIStroke?
	if edge then
		edge.Enabled = on or skin == nil
		edge.Color = if on then TC.GoldDeep else TC.PanelEdge
		edge.Thickness = 3
	end
	if skin then
		skin.Visible = not on
	end
	f.BackgroundTransparency = if skin and not on then 1 else 0
	f.BackgroundColor3 = if on then TC.Gold else TC.Hud
	-- gold arrow over the slot in use (not only the colour says it; the dock sits on the bottom edge), big enough to
	-- read at a glance on a phone
	local arrow = f:FindFirstChild("InUse") :: TextLabel?
	if not arrow then
		local a = UI.text(f, "\u{25BC}", { Name = "InUse", Font = UI.Bold, TextSize = 24, TextColor3 = TC.Gold, Outline = "Strong", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, 1), Size = UDim2.fromOffset(32, 24), TextXAlignment = Enum.TextXAlignment.Center })
		a.TextWrapped = false
		arrow = a
	end
	(arrow :: TextLabel).Visible = on
end

-- Hunt cards (timer, CARRIED, SHELLS): cream with a navy edge and a gold rim, navy captions (owner mockup).
-- Pet style: the clip's white-blue card with a sky edge and no rim, navy words.
local PET = Theme.Pet
local CREAM = PanelSkin.CREAM
local CARD_EDGE = if Theme.PetStyle then PET.QuestEdge else TC.PanelEdge
local function creamCard(f: Frame)
	f.BackgroundColor3 = CREAM
	f.BackgroundTransparency = 0
	local edge = f:FindFirstChild("Border") :: UIStroke?
	if edge then
		edge.Color = CARD_EDGE
		edge.Thickness = 3
	end
	if not Theme.PetStyle then
		local rim = UI.frame(f, { Name = "Rim", Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1 })
		UI.corner(rim, T.Radius - 2)
		UI.stroke(rim, TC.Gold, 3)
	end
	HudArt.skin(f, "hud_card", f.Size.Y.Offset)
	for _, name in { "Caption", "Pile" } do
		local l = f:FindFirstChild(name) :: TextLabel?
		if l then
			l.TextColor3 = PanelSkin.NAVY
			local o = l:FindFirstChildOfClass("UIStroke")
			if o then
				o.Enabled = false
			end
		end
	end
end

-- Hunt counters (CARRIED / NEST / CANDY): the caption reads as a label in its own right (display font, body size)
-- and the number keeps its weight under it, inside a slightly taller card.
local COUNTER_H = 56
local function huntCounter(f: Frame)
	f.Size = UDim2.fromOffset(f.Size.X.Offset, COUNTER_H)
	local icon = f:FindFirstChild("Icon") :: GuiObject?
	if icon then
		icon.Position = UDim2.fromOffset(7, (COUNTER_H - 30) // 2)
	end
	local cap = f:FindFirstChild("Caption") :: TextLabel?
	if cap then
		cap.Font = UI.Head
		cap.Position = UDim2.fromOffset(44, 5)
		cap.Size = UDim2.new(1, -50, 0, 20)
		cap.TextWrapped = false
		UI.fit(cap, T.Body, T.MinText)
	end
	local v = f:FindFirstChild("Value") :: TextLabel?
	if v then
		v.Position = UDim2.fromOffset(44, 25)
		v.Size = UDim2.new(1, -50, 0, 26)
		UI.fit(v, T.Count, T.Body)
	end
end

-- One "full" look for CARRIED and QUEUE: a red number and a red card edge (the colour change alone was easy to miss).
local function markFull(card: Frame, full: boolean)
	local edge = card:FindFirstChild("Border") :: UIStroke?
	if edge then
		edge.Color = if full then TC.Red else TC.PanelEdge
	end
	local v = card:FindFirstChild("Value") :: TextLabel?
	if v and full then
		v.TextColor3 = TC.Red
	end
end

-- Notifications ---------------------------------------------------------------------------------
-- Gameplay messages from PileView and the server, reworded to short actionable text and coalesced by UI.notify.
local REWORD = {
	["Basket full: take eggs to your nest"] = "Basket full. Take your eggs to your nest.",
	["Tray full: hatch some eggs first"] = "Nest is full. Hatch some eggs first.",
	["Candy bag full: sell at a candy stand"] = "Candy bag full. Sell at a candy stand.",
	["Your candy bag is empty. Nothing to sell."] = "No candy to sell.",
}

local function tagOf(text: string): string?
	if string.find(text, "^Basket full") then
		return "arena:basket"
	elseif string.find(text, "^Candy bag full") then
		return "arena:bag"
	elseif string.find(text, "^Collect more eggs") or string.find(text, "^Walk closer") or string.find(text, "^Move closer") or string.find(text, "^Nest is full") or string.find(text, "^Your Auto Nest hatches") then
		return "arena:" .. string.lower(string.sub(text, 1, 12))
	end
	return nil
end

-- Quick left-right wiggle of a counter card's icon (basket full feedback).
local function shakeIcon(card: Instance?)
	local icon = card and card:FindFirstChild("Icon") :: GuiObject?
	if not icon or UI.Reduced then
		return
	end
	task.spawn(function()
		for _, r in { -14, 12, -8, 5, 0 } do
			icon.Rotation = r
			task.wait(0.05)
		end
	end)
end

-- Shells counter: rolls up to a higher number instead of jumping (0.4 s), drops show at once.
local rubbleShown = -1
local rubbleToken = 0
local rubbleRoll: { N: number, Cap: number }? = nil -- the roll-up in progress (refreshes with the same count let it finish)
local function setRubbleRolling(n: number, cap: number)
	if rubbleRoll and rubbleRoll.N == n and rubbleRoll.Cap == cap then
		return
	end
	rubbleToken += 1
	local token = rubbleToken
	local from = rubbleShown
	rubbleShown = n
	rubbleRoll = nil
	if UI.Reduced or from < 0 or n <= from then
		refs.SetRubble(n, cap)
		return
	end
	rubbleRoll = { N = n, Cap = cap }
	task.spawn(function()
		local t0 = os.clock()
		while token == rubbleToken do
			local k = math.min(1, (os.clock() - t0) / 0.4)
			refs.SetRubble(math.floor(from + (n - from) * k + 0.5), cap)
			if k >= 1 then
				rubbleRoll = nil
				break
			end
			task.wait()
		end
	end)
end

function Hud.toast(text: string, kind: string?)
	if type(text) ~= "string" then
		return
	end
	if string.find(text, "^Basket full") and refs.CarryCard and refs.CarryCard.Visible then
		shakeIcon(refs.CarryCard) -- the basket icon and the BASKET FULL button already say it
		return
	end
	local t = REWORD[text] or text
	local k = kind or "info"
	if string.find(t, "invited you to a hunt party") and not State.Match and not State.Party then
		return -- the PARTY INVITE dialog (PartyPanel) already says it, with ACCEPT / DECLINE
	end
	if string.find(t, "^Basket full") then
		k = "basket"
	end
	UI.notify(t, k, { Tag = tagOf(t) })
end

-- Removes guidance notifications: "basket" | "bag" | "arena" (all arena guidance) | "all".
function Hud.dismissToasts(tag: string)
	if tag == "all" or tag == "arena" then
		UI.dismissNotices("arena:")
	else
		UI.dismissNotices("arena:" .. tag)
	end
end

-- Material discoveries: quiet, merged (Config.MaterialNoticeSeconds). The full record is in Collection > Materials.
local matPending: { string } = {}
local matScheduled = false
local matShownAt = -math.huge
function Hud.materialNotice(ids: { string })
	for _, id in ids do
		if type(id) == "string" and Config.Materials[id] and not table.find(matPending, id) then
			table.insert(matPending, id)
		end
	end
	if matScheduled or #matPending == 0 then
		return
	end
	matScheduled = true
	local wait = math.max(0.35, matShownAt + Config.MaterialNoticeSeconds - os.clock())
	task.delay(wait, function()
		matScheduled = false
		local names = {}
		for _, id in matPending do
			table.insert(names, Config.Materials[id].Name)
		end
		table.clear(matPending)
		local m = State.Match
		if #names == 0 or not m or m.Phase ~= "Searching" then
			return -- the geode was found meanwhile: the reveal is not covered (the record is in Collection)
		end
		matShownAt = os.clock()
		UI.notify("Material discovered: " .. table.concat(names, ", "), "material")
	end)
end

-- Entering the reveal: every gameplay notice (and a pending discovery) leaves the screen at once.
function Hud.clearMessages()
	table.clear(matPending)
	UI.dismissNotices("")
end

-- Cash counter rolls to the new value (display only).
local function setCash(n: number)
	if n == shownCash then
		return
	end
	if cashTween then
		cashTween:Cancel()
	end
	-- (not in the pet tower: the coin pill is hidden there and the floor-end card already says the coins)
	-- (not in a hunt either: the surprise egg pops there already say the coins, and the pill is hidden, so the text
	-- landed on the hunt clock card; never on a pill that is not drawn: Juice.onScreen)
	if shownCash >= 0 and n > shownCash and refs.Cash and (player:GetAttribute("InTower") ~= true and player:GetAttribute("InBattle") ~= true)
		and State.Match == nil and Juice.onScreen(refs.Cash) then
		Juice.payout(n - shownCash) -- coins fly from the CLAIM / OPEN / SELL button that earned them (if one did)
		Juice.floatText(refs.Cash, "+" .. UI.money(n - shownCash), TC.Cash)
		if refs.CoinIcon then
			Juice.spin(refs.CoinIcon) -- the coin picture turns once as the coins land
		end
	end
	if UI.Reduced or shownCash < 0 then
		cashValue.Value = n
	else
		cashValue.Value = shownCash
		local tw = TweenService:Create(cashValue, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = n })
		cashTween = tw
		tw:Play()
	end
	shownCash = n
	UI.modalCash(n)
end

-- "Start your first hunt" is a brief cue, not a banner: CUE_SECONDS after the lobby appears, gone once any panel opens.
local CUE_SECONDS = 14
local clockTick = 1 -- timer clock tick direction (flips each second)
local cueStart: number? = nil
local cueBrowsed = false
-- True while the top-centre objective card (START YOUR FIRST HUNT, PARTY 2/4, FIND THE PET...) is on screen.
function Hud.objectiveShown(): boolean
	local obj, top = refs.Objective, refs.Top
	return obj ~= nil and top ~= nil and obj.Visible and top.Visible
end

function Hud.cueActive(): boolean
	if cueBrowsed then
		return false
	end
	if cueStart == nil then
		cueStart = os.clock()
	end
	return os.clock() - (cueStart :: number) < CUE_SECONDS
end

-- Processing: the plate bar is shown only while the server's progress for the current rock is actually moving
-- (an update within PROGRESS_LIVE seconds) or the station's machine is running. Leaving the table, a new round
-- or the end of the hunt hides it; nothing animates it on the client.
local PROGRESS_LIVE = 1.6
local PROC_HOLD = 0.8 -- seconds the card stays after its reason ends (no flicker between hits or context ticks)
local lastProgress: number? = nil
local lastProgressAt = -math.huge
local lastProgressKey: any = nil
local procUntil = -math.huge -- the card stays on screen until this os.clock()
-- The bar eases between server values (over about the time between the last two hits) instead of jumping, and the
-- percent follows the eased value. It only ever moves toward a value the server sent (nothing is predicted).
local procShown = Instance.new("NumberValue")
local procTween: Tween? = nil
local procGoal = -1
local procGap = 0.4
local procBase = "HATCHING"

function Hud.build()
	local root = UI.screen()
	UI.ModalChanged.Event:Connect(function(name)
		if name ~= nil then
			cueBrowsed = true
		end
	end)

	-- Left column: cash (lobby) / counters (hunt), processing, machine, roster. One list: nothing overlaps.
	local left = UI.frame(root, { Name = "Left", Position = UDim2.fromOffset(T.Edge + 4, T.Edge), Size = UDim2.fromOffset(LEFT_W, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 })
	UI.list(left, Enum.FillDirection.Vertical, 6)
	-- The column sits in a clipped box that only scrolls when a very short screen still cannot hold it at the smallest
	-- card size (fitLeft); the box has room for the cards' rims and the red dots, which hang past the column.
	local leftBox = Instance.new("ScrollingFrame")
	leftBox.Name = "LeftBox"
	leftBox.BackgroundTransparency = 1
	leftBox.BorderSizePixel = 0
	leftBox.ScrollBarThickness = 0
	leftBox.VerticalScrollBarPosition = Enum.VerticalScrollBarPosition.Left -- the bar hugs the column, not the far side of the box
	leftBox.ScrollingDirection = Enum.ScrollingDirection.Y
	leftBox.ScrollingEnabled = false
	leftBox.Active = false
	leftBox.CanvasSize = UDim2.new()
	leftBox.Size = UDim2.fromOffset(BOX_W, 1000)
	leftBox.Parent = root
	left.Position = UDim2.fromOffset(BOX_PAD, 0)
	left.Parent = leftBox
	refs.Stats = left
	refs.LeftList = left:FindFirstChildOfClass("UIListLayout")
	-- coin counter (mockup): a cream pill with the amount, the coin picture overlapping its left end
	local cashRow = UI.frame(left, { Name = "Resources", LayoutOrder = 1, Size = UDim2.fromOffset(LEFT_W + 24, 40), BackgroundTransparency = 1 })
	-- (pet style: the clip's navy pill with white digits, the coin picture over its left end)
	local pill = UI.frame(cashRow, { Name = "Pill", Position = UDim2.fromOffset(20, 5), Size = UDim2.new(1, -20, 1, -10), BackgroundColor3 = if Theme.PetStyle then PET.TabBar else Color3.fromRGB(255, 246, 214) })
	UI.corner(pill, 15)
	-- a light blue edge on the navy pill (the dark edge sank into the world behind it on a phone)
	UI.stroke(pill, if Theme.PetStyle then PET.QuestEdge else TC.PanelEdge, 3)
	HudArt.skin(pill, "coin_pill", 30)
	-- no drifting light band on the coin pill: on the flat cream it read as a half-filled progress bar
	local drift = pill:FindFirstChild("Drift", true)
	if drift then
		drift:Destroy()
	end
	refs.CoinIcon = HudArt.image(cashRow, "Coin", 40, { Position = UDim2.fromOffset(0, 0), ZIndex = 3 })
	-- a clear gap between the coin picture (40 px, over the pill's first 20) and the first digit
	local amount = UI.text(pill, "0", { Name = "Amount", Font = UI.Head, TextSize = 26, TextColor3 = if Theme.PetStyle then TC.Text else TC.DarkText, Outline = if Theme.PetStyle then "Normal" else false, Position = UDim2.fromOffset(31, 1), Size = UDim2.new(1, -37, 1, -2) })
	amount.TextWrapped = false
	UI.fit(amount, 26, T.MinText)
	refs.Resources = cashRow
	local function showCash(v: number)
		-- short from 10,000 up (12.5K) so the pill keeps its big digits
		local n = math.floor(v + 0.5)
		amount.Text = if n >= 10000 and n < 100000 then (string.gsub(string.format("%.1f", math.floor(n / 100) / 10), "%.0$", "")) .. "K" else UI.num(n)
	end
	cashValue.Changed:Connect(showCash)
	showCash(0)
	refs.Cash = amount
	Effects.setCashTarget(refs.Cash)
	Juice.setCoinTarget(refs.Cash) -- coins earned on a menu button fly here (Juice.payout)
	-- lobby: the candy bag (only when it holds shells to sell): how full it is, and what to do with it
	-- a cream card like the coin pill above it (navy words, no outline)
	-- (as wide as PLAY, so the "sell" line keeps a readable size; the shell icon matches the hunt counter)
	local bag = UI.frame(left, { Name = "BagLine", BackgroundColor3 = PanelSkin.CREAM, Size = UDim2.fromOffset(LOBBY_W, 54), LayoutOrder = 2, Visible = false })
	UI.corner(bag, 12)
	UI.stroke(bag, PanelSkin.NAVY, 2.5)
	UI.icon(bag, "rubble", 30, { Name = "Icon", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 5, 0.5, 0) })
	refs.Rubble = UI.text(bag, "", { Name = "Bag", Font = UI.Bold, TextSize = T.Body, TextColor3 = PanelSkin.NAVY, Outline = false, Position = UDim2.fromOffset(40, 3), Size = UDim2.new(1, -44, 0, 22) })
	refs.Rubble.TextXAlignment = Enum.TextXAlignment.Left
	refs.Rubble.TextWrapped = false
	UI.fit(refs.Rubble, T.Body, T.MinText)
	-- the call to action as big as the count and in a strong green on the cream (it was small navy and read faint)
	refs.RubbleSub = UI.text(bag, "Sell for coins!", { Name = "BagSub", Font = UI.Bold, TextSize = T.Body + 2, TextColor3 = Color3.fromRGB(14, 112, 40), Outline = false, Position = UDim2.fromOffset(40, 27), Size = UDim2.new(1, -44, 0, 23) })
	refs.RubbleSub.TextWrapped = false
	UI.fit(refs.RubbleSub, T.Body + 2, T.Small) -- short words so the line keeps a big size (bug #220)
	refs.BagLine = bag
	-- Daily gift + quests (lobby only), under the cash: the right column is full on short phones (JUMP sits under
	-- it). A small red dot shows how many rewards are ready to claim.
	-- (under PLAY and the TOWER row, as in the lobby mockup)
	local daily = HudArt.bigButton(left, {
		Name = "Quests", Style = "blue", Art = "Calendar", Skin = "btn_blue", Title = "DAILY", Width = LOBBY_W - 20, Height = 52, LayoutOrder = 70,
		OnClick = function()
			if UI.modalOpen() == "Quests" then
				UI.closeModal()
			else
				QuestPanel.open()
			end
		end,
	})
	-- red "!" dot (UI.newDot) with the number of rewards ready to claim. It hangs on a small anchor at the button's
	-- right end, level with its top, so it sits beside DAILY (narrower than TOWER) instead of over the TOWER button;
	-- just outside the rounded corner (it covered the corner), in the room the narrower DAILY leaves
	-- (2026-10-15 phone review: the dot was tiny and inside the picture) now a 34 px badge on the button's top-right
	-- corner, half outside it sideways (DAILY is 20 px narrower than the column, so it stays clear of the screen
	-- edge) and up to the gap above (the TOWER row is drawn later, so the badge never goes under it)
	-- (runner review: the badge sat on the tile's words) centred on the corner itself, half outside both ways
	local dotAt = UI.frame(daily, { Name = "DotAt", BackgroundTransparency = 1, Position = UDim2.new(1, -8, 0, -6), Size = UDim2.fromOffset(12, 12), ZIndex = 6 })
	badge(dotAt)
	refs.QuestsDot = dotAt
	refs.BtnQuests = daily
	-- hunt counters (labelled: what you carry vs what waits at your station vs what you stored)
	refs.CarryCard, refs.SetCarry = UI.counter(left, "basket", "CARRIED", { Name = "CarryCard", LayoutOrder = 3, Size = UDim2.fromOffset(LEFT_W, 52) })
	refs.QueueCard, refs.SetQueue = UI.counter(left, "queue", "NEST", { Name = "TableQueue", LayoutOrder = 4, Size = UDim2.fromOffset(LEFT_W, 52) })
	refs.RubbleCard, refs.SetRubble = UI.counter(left, "rubble", "CANDY", { Name = "RubbleCard", LayoutOrder = 5, Size = UDim2.fromOffset(LEFT_W, 52) })
	for _, c in { refs.CarryCard, refs.QueueCard, refs.RubbleCard } do
		huntCounter(c)
		creamCard(c)
	end
	-- processing (server plate progress)
	local proc = UI.card(left, "hud", { Name = "Processing", Size = UDim2.fromOffset(LEFT_W, 40), LayoutOrder = 6, Visible = false })
	refs.ProcText = UI.text(proc, "HATCHING", { Font = UI.Bold, TextSize = T.Tiny, Outline = "Normal", Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 18) })
	local _, pfill = UI.bar(proc, { Position = UDim2.new(0, 8, 1, -14), Size = UDim2.new(1, -16, 0, 8) })
	refs.ProcFill = pfill
	refs.Proc = proc
	procShown.Changed:Connect(function(v)
		pfill.Size = UDim2.fromScale(math.clamp(v, 0, 1), 1)
		refs.ProcText.Text = if procBase == "HATCHING" then procBase .. " " .. math.floor(v * 100 + 0.5) .. "%" else procBase
	end)
	-- machine chip: state of the installed machine; tapping starts / stops it (server ToggleMachine)
	local mach = UI.button(left, "", "gray", function()
		local prof = State.Profile
		if prof and prof.InstalledMachine and myMachine(State.Match) then
			Net.event("ShopAction"):FireServer("ToggleMachine")
		end
	end, { Name = "Machine", Size = UDim2.fromOffset(LEFT_W, 44), LayoutOrder = 7, Visible = false })
	local ml = mach:FindFirstChild("Label") :: TextLabel
	ml.Position = UDim2.fromOffset(38, 2)
	ml.Size = UDim2.new(1, -42, 1, -4)
	ml.TextXAlignment = Enum.TextXAlignment.Left
	ml.Font = UI.Bold
	UI.fit(ml, T.Tiny + 1, T.MinText)
	refs.MachLabel = ml
	refs.MachIconKind = ""
	refs.Mach = mach
	-- party roster (hunt)
	local roster = UI.frame(left, { Name = "Roster", Size = UDim2.fromOffset(LEFT_W, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 8, Visible = false })
	UI.list(roster, Enum.FillDirection.Vertical, 3)
	refs.Roster = roster
	-- lobby mode row under PLAY: the TOWER button (TowerPanel fills it)
	local modeRow = UI.frame(left, { Name = "ModeRow", BackgroundTransparency = 1, Size = UDim2.fromOffset(LOBBY_W, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 60 })
	local modeList = UI.list(modeRow, Enum.FillDirection.Horizontal, 6)
	refs.ModeList = modeList
	-- Touch screens: the lobby buttons (PLAY, GIFT, TOWER, BATTLE, DAILY) leave the column and go into this grid, a
	-- row along the top on a landscape phone or two columns on an upright one, so none sits in Roblox's thumbstick
	-- zone (the lower left; a button there takes the touch and the player cannot walk: carter, phone, 2026-10-15).
	-- SafeZones.lobbyLayout decides; arrangeLobby (below) moves the buttons whenever the screen or the set changes.
	local actions = UI.frame(left, { Name = "Actions", BackgroundTransparency = 1, Size = UDim2.fromOffset(LOBBY_W, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 45, Visible = false })
	local actionGrid = Instance.new("UIGridLayout")
	actionGrid.Name = "Grid"
	actionGrid.CellPadding = UDim2.fromOffset(6, 6)
	actionGrid.SortOrder = Enum.SortOrder.LayoutOrder
	actionGrid.FillDirection = Enum.FillDirection.Horizontal
	actionGrid.Parent = actions
	-- landscape phones: one row, the PLAY pill wider than the square tiles after it (a grid cannot do that), so
	-- the row swaps the grid for this list; grid and list never sit in the frame at the same time
	local actionRow = Instance.new("UIListLayout")
	actionRow.Name = "Row"
	actionRow.FillDirection = Enum.FillDirection.Horizontal
	actionRow.Padding = UDim.new(0, 6)
	actionRow.SortOrder = Enum.SortOrder.LayoutOrder
	actionRow.VerticalAlignment = Enum.VerticalAlignment.Center
	-- PlayQueue is PlayButton's wrapper (the PLAY button and the queue card inside it share its size)
	local LOBBY_BUTTONS = { "PlayQueue", "FreeGift", "SpinWheel", "TowerButton", "BattleButton", "Quests" }
	local boxW = BOX_W -- width of the clipped box; wider than the column when the touch row needs it (fitLeft keeps it)
	local function shapeOne(b: GuiObject, w: number?, h: number?)
		if b:GetAttribute("HomeW") == nil then
			b:SetAttribute("HomeW", b.Size.X.Offset)
			b:SetAttribute("HomeH", b.Size.Y.Offset)
		end
		local cw = w or b:GetAttribute("HomeW") :: number
		local ch = h or b:GetAttribute("HomeH") :: number
		b.Size = UDim2.fromOffset(cw, ch)
		if b:IsA("GuiButton") then
			HudArt.compact(b, w ~= nil, cw, ch)
		end
	end
	local function shape(b: GuiObject, w: number?, h: number?)
		shapeOne(b, w, h)
		if b.Name == "PlayQueue" then
			for _, c in b:GetChildren() do
				if c:IsA("GuiObject") then
					shapeOne(c, w, h)
				end
			end
		end
	end
	-- The candy bag card folded to one line (icon + "Candy bag 84/100", no "Sell for coins!" line) for the landscape
	-- phone row, and back to the full card elsewhere.
	local function foldBag(on: boolean)
		local bag = refs.BagLine
		local icon = bag:FindFirstChild("Icon") :: GuiObject?
		if bag:GetAttribute("Folded") == on then
			return
		end
		bag:SetAttribute("Folded", on)
		local prof = State.Profile
		if prof then
			refs.Rubble.Text = (if on then (if prof.Rubble >= prof.Capacity then "FULL " else "Candy ") elseif prof.Rubble >= prof.Capacity then "Candy bag FULL " else "Candy bag ") .. prof.Rubble .. "/" .. prof.Capacity
		end
		-- the drawn icon's parts are offsets, so it shrinks through a UIScale (around its anchor) and not its Size
		local iconScale: UIScale? = if icon then icon:FindFirstChild("Fold") :: UIScale? else nil
		if icon and not iconScale then
			local sc = Instance.new("UIScale")
			sc.Name = "Fold"
			sc.Parent = icon
			iconScale = sc
		end
		if on then
			bag.Size = UDim2.fromOffset(BAG_FOLD_W, 30)
			if iconScale then
				iconScale.Scale = 22 / 30
			end
			refs.Rubble.Position = UDim2.fromOffset(32, 0)
			refs.Rubble.Size = UDim2.new(1, -36, 1, 0)
			refs.RubbleSub.Visible = false
		else
			bag.Size = UDim2.fromOffset(LOBBY_W, 54)
			if iconScale then
				iconScale.Scale = 1
			end
			refs.Rubble.Position = UDim2.fromOffset(40, 3)
			refs.Rubble.Size = UDim2.new(1, -44, 0, 22)
			refs.RubbleSub.Visible = true
		end
	end
	local function arrangeLobby()
		local touch = UserInputService.TouchEnabled
		local L = SafeZones.lobbyLayout(UI.Logical.X, UI.Logical.Y, touch, LOBBY_W)
		local found: { [string]: GuiObject } = {}
		for _, holder in { left, modeRow, actions } do
			for _, c in holder:GetChildren() do
				if c:IsA("GuiObject") and table.find(LOBBY_BUTTONS, c.Name) then
					found[c.Name] = c
				end
			end
		end
		for i, name in LOBBY_BUTTONS do
			local b = found[name]
			if b then
				if b:GetAttribute("HomeOrder") == nil then
					b:SetAttribute("HomeOrder", b.LayoutOrder)
				end
				if L.Mode == "column" then
					shape(b)
					b.LayoutOrder = b:GetAttribute("HomeOrder") :: number
					local home: Instance = if name == "TowerButton" or name == "BattleButton" then modeRow else left
					if b.Parent ~= home then
						b.Parent = home
					end
				else
					-- row mode: PLAY keeps a wide pill, the four others are squares (SafeZones.lobbyLayout)
					shape(b, if name == "PlayQueue" and L.PlayW then L.PlayW else L.CellW, L.CellH)
					b.LayoutOrder = i
					if b.Parent ~= actions then
						b.Parent = actions
					end
				end
			end
		end
		local bagLine = left:FindFirstChild("BagLine")
		if L.Mode == "column" then
			actions.Visible = false
			actions.LayoutOrder = 45
			modeRow.Visible = true
			if bagLine and bagLine:IsA("GuiObject") then
				bagLine.LayoutOrder = 2
			end
			foldBag(false)
			refs.ObjPillW = nil
			boxW = BOX_W
		else
			local w
			if L.Mode == "row" then
				actionGrid.Parent = nil
				actionRow.Parent = actions
				w = SafeZones.rowWidth(L, 6)
			else
				actionRow.Parent = nil
				actionGrid.Parent = actions
				actionGrid.CellSize = UDim2.fromOffset(L.CellW, L.CellH)
				actionGrid.FillDirectionMaxCells = L.Cols
				w = L.Cols * L.CellW + (L.Cols - 1) * 6
			end
			actions.Size = UDim2.fromOffset(w, 0)
			actions.Visible = true
			actions.LayoutOrder = 2 -- right under the coins: anything else in the column (objective, candy line) goes below
			modeRow.Visible = false
			-- the candy line (a plain card, it takes no touches) goes under the buttons so the row stays high; on a
			-- landscape phone it folds to one small pill so the HUD covers less of the view (carter, phone, 2026-10-15)
			if bagLine and bagLine:IsA("GuiObject") then
				bagLine.LayoutOrder = 46
			end
			foldBag(L.Mode == "row")
			-- the NEXT UP pill (ObjLayout) spans the row, so its sub line keeps one line
			refs.ObjPillW = math.max(LEFT_W + 24, w)
			boxW = math.max(BOX_W, w + 2 * BOX_PAD + 12)
		end
		leftBox.Size = UDim2.fromOffset(boxW, leftBox.Size.Y.Offset)
		-- the objective follows the same verdict (pill under the row, card at the top centre in column mode)
		if refs.ObjLayout and refs.ObjInMatch ~= nil then
			refs.ObjLayout(refs.ObjInMatch, L.Mode ~= "column")
		end
		local obj = refs.Objective
		if obj and refs.ObjPill == true then
			obj.Size = UDim2.fromOffset(refs.ObjPillW or (LEFT_W + 24), obj.Size.Y.Offset)
		end
	end
	refs.ArrangeLobby = arrangeLobby
	for _, holder in { left, modeRow } do
		holder.ChildAdded:Connect(function(c)
			if table.find(LOBBY_BUTTONS, c.Name) then
				task.defer(arrangeLobby)
			end
		end)
	end
	UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(function()
		task.defer(arrangeLobby)
	end)

	-- Studio test status only (never shown to players)
	local so = UI.card(root, "hud", { Name = "TestStatus", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, T.Edge, 1, -T.Edge), Size = UDim2.fromOffset(160, 24), Visible = false })
	local sot = UI.text(so, "Studio test: saves off", { TextSize = T.Tiny, TextColor3 = TC.Count, Outline = "Normal", Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0), TextXAlignment = Enum.TextXAlignment.Center })
	sot.TextWrapped = false
	refs.SavesOff = so

	-- Right column: timer (hunt), then Settings and the menu tiles.
	local right = UI.frame(root, { Name = "Menu", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -T.Edge, 0, T.Edge), Size = UDim2.fromOffset(RIGHT_W, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 })
	UI.list(right, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Right)
	refs.Menu = right
	-- The hunt timer and pile count sit at the top of the LEFT column: Roblox's player list opens over the top right
	-- corner (it has no "is open" signal), so essential round numbers never go there.
	local timer = UI.card(left, "hud", { Name = "Timer", Size = UDim2.fromOffset(LEFT_W, 52), LayoutOrder = 0, Visible = false })
	local clock = UI.icon(timer, "clock", 30, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 22, 0.5, 0) }) -- mockup: clock left of the time
	refs.Clock = clock
	refs.TimerText = UI.text(timer, "0:00", { Name = "Time", Font = UI.Head, TextSize = Theme.Text.Timer, TextColor3 = TC.Gold, Position = UDim2.fromOffset(42, 5), Size = UDim2.new(1, -46, 0, 28), TextXAlignment = Enum.TextXAlignment.Center })
	refs.TimerText.TextWrapped = false
	-- clear of the card's rim (the digits' tops were cut off at the old 1 px top) and fitted to the box
	UI.fit(refs.TimerText, Theme.Text.Timer, 18)
	refs.PileText = UI.text(timer, "", { Name = "Pile", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Muted, Outline = "Normal", Position = UDim2.new(0, 42, 1, -19), Size = UDim2.new(1, -46, 0, 16), TextXAlignment = Enum.TextXAlignment.Center })
	refs.PileText.TextWrapped = false
	UI.fit(refs.PileText, T.Tiny, 11)
	refs.Timer = timer
	creamCard(timer)
	-- lobby mockup order: My Pets, Upgrade, Party, Settings (the owner's DEV tile stays last, LayoutOrder 99)
	refs.BtnCollection = tile(right, "Collection", "My Pets", "Paw", 2, function()
		openPanel("Collection")
	end)
	-- the red "!" hangs on an anchor inside the tile's top-right corner (above every tile layer), so the whole dot
	-- shows; on the tile's own corner its top half was cut off at the top of the menu column
	-- (2026-10-15 phone review: the "!" was tiny and over the picture's corner) now a 34 px badge on the tile's
	-- top-right corner, half outside it (the menu column's gap to the screen edge keeps it on screen)
	refs.PetsDot = UI.frame(refs.BtnCollection, { Name = "DotAt", BackgroundTransparency = 1, Position = UDim2.new(1, -8, 0, -4), Size = UDim2.fromOffset(12, 12), ZIndex = 8 })
	badge(refs.PetsDot)
	refs.BtnShop = tile(right, "Shop", "Upgrade", "Hammer", 3, function()
		openPanel("Shop")
	end)
	refs.BtnParty = tile(right, "Party", "Party", "Party", 4, function()
		openPanel("Party")
	end)
	refs.BtnSettings = tile(right, "Settings", "Settings", "Gear", 5, function()
		openPanel("Settings")
	end)
	refs.BtnLobby = tile(right, "Lobby", "Lobby", "exit", 6, function()
		openPanel("ConfirmReturn")
	end)
	-- the tile you last opened keeps a soft gold ring until another menu opens (where you were, at a glance)
	local lastRing: UIStroke? = nil
	local TILE_OF = { Collection = refs.BtnCollection, Shop = refs.BtnShop, Party = refs.BtnParty, Settings = refs.BtnSettings }
	UI.ModalChanged.Event:Connect(function(name)
		if name == "Collection" and lastPets ~= nil then
			-- opening the Pet Book is seeing the new pets: the "!" goes now, not at the next profile change
			seenPets = lastPets
			UI.newDot(refs.PetsDot, false)
		end
		local t = if name then TILE_OF[name] else nil
		if not t then
			return
		end
		if lastRing then
			lastRing:Destroy()
		end
		local ring = Instance.new("UIStroke")
		ring.Name = "LastOpened"
		ring.Color = TC.Gold
		ring.Thickness = 3
		ring.Transparency = 0.25
		ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		ring.Parent = t
		lastRing = ring
	end)
	refs.BtnResults = tile(right, "Results", "Results", "results", 7, function()
		openPanel("Results")
	end)
	-- Right column vs Roblox's jump button (TouchLayout, screen px). On short wide phones (phone-1108x512) one column
	-- of four tiles reaches into the jump area, so the tiles fold into two columns while that would happen.
	local menuList = right:FindFirstChildOfClass("UIListLayout")
	local menuGrid = Instance.new("UIGridLayout")
	menuGrid.Name = "Fold"
	menuGrid.CellSize = UDim2.fromOffset(TILE, TILE)
	menuGrid.CellPadding = UDim2.fromOffset(6, 6)
	menuGrid.FillDirection = Enum.FillDirection.Horizontal
	menuGrid.FillDirectionMaxCells = 2
	menuGrid.HorizontalAlignment = Enum.HorizontalAlignment.Right
	menuGrid.SortOrder = Enum.SortOrder.LayoutOrder
	-- Lobby on a phone: the tiles go into the top right corner of the whole screen (owner video, polish #105). The HUD
	-- layer keeps Roblox's safe area (top bar + notch insets), which on a notched phone left the grid low and well in
	-- from the edge, though that corner is empty (Roblox's own buttons sit top left). An empty full-screen ScreenGui
	-- measures the insets in the same pixels as the HUD layer, so nothing is guessed per device.
	local insetProbe = Instance.new("ScreenGui")
	insetProbe.Name = "HudInsetProbe"
	insetProbe.ResetOnSpawn = false
	insetProbe.IgnoreGuiInset = true
	insetProbe.ScreenInsets = Enum.ScreenInsets.None
	insetProbe.Enabled = false -- draws nothing; its absolute rectangle is all we read
	insetProbe.Parent = player:WaitForChild("PlayerGui")
	local CLEAR_JUMP = 36 -- screen px kept free between the lowest tile and the reserved jump area (polish #106)
	local function fitMenu()
		if not right.Parent then
			return
		end
		local gui = UI.screen()
		local px = gui.AbsoluteSize
		local cam = Workspace.CurrentCamera
		local full = if cam then cam.ViewportSize else px
		local scale = math.max(UI.Scale, 0.1)
		-- insets of the HUD layer inside the full screen (screen px; 0 when the probe has no size yet)
		local topIn, rightIn, bottomIn = 0, 0, 0
		local pa, ps = insetProbe.AbsolutePosition, insetProbe.AbsoluteSize
		if ps.X > 1 and ps.Y > 1 then
			local ga = gui.AbsolutePosition
			topIn = math.clamp(ga.Y - pa.Y, 0, ps.Y * 0.25)
			rightIn = math.clamp((pa.X + ps.X) - (ga.X + px.X), 0, ps.X * 0.2)
			bottomIn = math.clamp((pa.Y + ps.Y) - (ga.Y + px.Y), 0, ps.Y * 0.25)
		end
		local h, n = 0, 0
		for _, c in right:GetChildren() do
			if c:IsA("GuiObject") and c.Visible then
				h += c.Size.Y.Offset
				n += 1
			end
		end
		h += math.max(0, n - 1) * 6
		local fold = false
		-- hunts: the few tiles left (Settings, Lobby, Results) sit in one row in the top right corner, so they no
		-- longer hang down the side of the view (they covered the nest sign) and the action button has room there
		local hunt = State.Match ~= nil and n > 0
		if hunt then
			-- portrait: placeTop already put the row under the full-width top stack (objective, hint); keep that
			-- height, or the hint card covers the tiles
			right.Position = UDim2.new(1, -T.Edge, 0, if UI.isPortrait() then right.Position.Y.Offset else T.Edge)
			menuGrid.FillDirectionMaxCells = n
			if menuList then
				menuList.Parent = nil
			end
			menuGrid.Parent = right
			right.Size = UDim2.fromOffset(n * TILE + (n - 1) * 6, 0)
			return
		end
		local touch = UserInputService.TouchEnabled and px.Y > 1
		-- touch only: on a computer Roblox's player list opens in that corner (it is closed by default on phones)
		-- up into the empty right end of Roblox's top bar in landscape only: in portrait that strip is the phone's
		-- status bar / notch
		local up = if touch and px.X > px.Y then topIn / scale else 0
		local out = if touch then rightIn / scale else 0
		-- portrait: placeTop put the menu under the full-width top stack (objective, hint); keep that height, or the
		-- objective card covers the first tile's caption ("My Pets", phone-portrait check 2026-10-14)
		local y = if UI.isPortrait() then math.max(T.Edge, right.Position.Y.Offset) else T.Edge - up
		right.Position = UDim2.new(1, -T.Edge + out, 0, y)
		local cols = 1
		if touch then
			-- the lowest tile stays CLEAR_JUMP px above the reserved jump area (screen px from the real bottom):
			-- one column if that fits, else two, else three columns
			-- (and never inside Roblox's jump-button corner, SafeZones.jumpZone)
			local limit = math.max(TouchLayout.reserved(full.X, full.Y).Top + CLEAR_JUMP, (px.Y / scale - SafeZones.columnLimit(px.X / scale, px.Y / scale, scale)) * scale)
			local topPx = y * scale -- the menu's top in HUD-layer px
			local screenBottom = px.Y + bottomIn
			local function fits(c: number): boolean
				local rows = math.ceil(n / c)
				local hh = if c == 1 then h else rows * TILE + math.max(0, rows - 1) * 6
				return screenBottom - (topPx + hh * scale) >= limit
			end
			cols = if fits(1) then 1 elseif fits(2) or n <= 2 then 2 else 3
		end
		fold = cols > 1
		menuGrid.FillDirectionMaxCells = cols
		if menuList then
			menuList.Parent = if fold then nil else right
		end
		menuGrid.Parent = if fold then right else nil
		right.Size = UDim2.fromOffset(if fold then cols * TILE + (cols - 1) * 6 else RIGHT_W, 0)
	end
	refs.FitMenu = fitMenu
	for _, c in right:GetChildren() do
		if c:IsA("GuiObject") then
			c:GetPropertyChangedSignal("Visible"):Connect(function()
				task.defer(fitMenu)
			end)
		end
	end
	-- tiles added later (the owner's DEV tile) count too
	right.ChildAdded:Connect(function(c)
		if c:IsA("GuiObject") then
			c:GetPropertyChangedSignal("Visible"):Connect(function()
				task.defer(fitMenu)
			end)
			task.defer(fitMenu)
		end
	end)
	UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(fitMenu)
	-- rotation, resizes and safe-area changes move the insets
	for _, g in { UI.screen() :: GuiBase2d, insetProbe :: GuiBase2d } do
		g:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			task.defer(fitMenu)
		end)
		g:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
			task.defer(fitMenu)
		end)
	end
	task.defer(fitMenu)

	-- Top centre: objective, then the tutorial hint and the rubble-full notice.
	local top = UI.frame(root, { Name = "Top", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, T.Edge), Size = UDim2.new(1, -2 * (LEFT_W + 2 * T.Edge + 8), 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 })
	local lim = Instance.new("UISizeConstraint")
	lim.MaxSize = Vector2.new(360, 1000)
	lim.Parent = top
	UI.list(top, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	-- an opaque cream card with a navy edge and gold rim like the hunt cards (the see-through one let world signs and
	-- billboards show through the words); the title keeps its outlined bubble letters, the line under it is navy
	-- (pet style: the clip's NEXT UP bar: white-blue body, sky edge, a tilted yellow "NEXT UP!" tag on its top left
	-- corner in the lobby, the line under the title in quest blue)
	local obj = UI.frame(top, { Name = "Objective", Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 1, BackgroundColor3 = CREAM, BackgroundTransparency = 0 })
	UI.corner(obj, T.Radius)
	UI.stroke(obj, CARD_EDGE, 3)
	if not Theme.PetStyle then
		local objRim = UI.frame(obj, { Name = "Rim", Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1 })
		UI.corner(objRim, T.Radius - 2)
		UI.stroke(objRim, TC.Gold, 3)
	end
	local objTag: TextLabel? = nil
	if Theme.PetStyle then
		local tag = UI.text(obj, "NEXT UP!", { Name = "Tag", Font = UI.Head, TextSize = T.Small, TextColor3 = PET.Tag, Outline = "Normal", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromOffset(10, -2), Size = UDim2.fromOffset(84, 22), Rotation = -4, ZIndex = 3, TextXAlignment = Enum.TextXAlignment.Left })
		tag.TextWrapped = false
		local to = tag:FindFirstChild("Outline")
		if to and to:IsA("UIStroke") then
			to.Color = PET.TagEdge
			to.Thickness = 2.6
		end
		objTag = tag
	end
	refs.ObjTitle = UI.text(obj, "", { Name = "Title", Font = UI.Head, TextSize = T.Head + 4, RichText = true, Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 28), TextXAlignment = Enum.TextXAlignment.Center })
	refs.ObjTitle.TextWrapped = false
	-- (the title's box ends a pixel above the sub line: on a phone the big letters' tails sat on the sub words)
	refs.ObjSub = UI.text(obj, "", { Name = "Sub", Font = UI.Bold, TextSize = T.Body, TextColor3 = if Theme.PetStyle then PET.QuestTitle else TC.PanelEdge, Outline = false, Position = UDim2.fromOffset(8, 32), Size = UDim2.new(1, -16, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
	refs.Objective = obj
	-- In a hunt the line under the title is what to do next, so it gets the big letters and the title (FIND THE PET,
	-- GET READY...) becomes a smaller header; the lobby keeps the title-first card.
	local objHunt: boolean? = nil
	local objPill: boolean? = nil
	refs.ObjLayout = function(hunt: boolean, pill: boolean?)
		local isPill = pill == true and not hunt
		if objHunt == hunt and objPill == isPill then
			return
		end
		objHunt = hunt
		objPill = isPill
		-- Phones in the lobby: a small pill in the left column, right under the coin bar (the top centre of the view
		-- holds the world's arch sign). The title and the line under it stay, in small fitted letters.
		obj.Parent = if isPill then left else top
		obj.LayoutOrder = if isPill then 2 else 1
		refs.ObjPill = isPill
		if objTag then
			objTag.Visible = not hunt and not isPill
		end
		if isPill then
			refs.ObjFullH = 38
			obj.Size = UDim2.fromOffset(refs.ObjPillW or (LEFT_W + 24), 38)
			local title, sub = refs.ObjTitle, refs.ObjSub
			-- (the two lines keep a 4 px gap: with the title box running into the sub's, the big letters' tails
			-- sat on the sub words on a phone)
			title.Position = UDim2.fromOffset(6, 1)
			title.Size = UDim2.new(1, -12, 0, 16)
			UI.fit(title, T.Small + 2, T.MinText)
			sub.Font = UI.Bold
			sub.Position = UDim2.fromOffset(6, 21)
			sub.Size = UDim2.new(1, -12, 0, 16)
			sub.TextWrapped = false
			UI.fit(sub, T.Small, T.MinText)
			return
		end
		refs.ObjFullH = if hunt then 62 else 56 -- the hunt card is a little taller for its bigger title
		local title, sub = refs.ObjTitle, refs.ObjSub
		if hunt then
			title.Position = UDim2.fromOffset(8, 3)
			title.Size = UDim2.new(1, -16, 0, 26)
			UI.fit(title, T.Head, T.Body)
			sub.Font = UI.Head
			sub.Position = UDim2.fromOffset(8, 29)
			sub.Size = UDim2.new(1, -16, 0, 27)
			sub.TextWrapped = false
			UI.fit(sub, T.Head + 2, T.Small)
		else
			title.Position = UDim2.fromOffset(8, 2)
			title.Size = UDim2.new(1, -16, 0, 30)
			UI.fit(title, T.Head + 4, T.Head)
			sub.Font = UI.Bold
			sub.Position = UDim2.fromOffset(8, 31)
			sub.Size = UDim2.new(1, -16, 0, 22)
			sub.TextWrapped = true
			UI.fit(sub, T.Body, T.MinText)
		end
	end
	-- Lobby logo (mockup): the owner's FIND THE PET picture, or a bubble-text stand-in with the tagline pill.
	local logo = UI.frame(top, { Name = "Logo", Size = UDim2.new(1, 0, 0, 92), LayoutOrder = 0, BackgroundTransparency = 1, Visible = false })
	if HudArt.has("Logo") then
		local img = Instance.new("ImageLabel")
		img.Name = "LogoImage"
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.Image = HudArt.Slots.Logo.Image
		img.ScaleType = Enum.ScaleType.Fit
		img.Parent = logo
	else
		local lt = UI.text(logo, "FIND THE <font color=\"#FFC424\">PET</font>", { Name = "LogoText", Font = UI.Head, TextSize = 46, RichText = true, Outline = "Strong", Size = UDim2.new(1, 0, 0, 56), TextXAlignment = Enum.TextXAlignment.Center })
		lt.TextWrapped = false
		UI.fit(lt, 46, T.Head)
		local tag = UI.frame(logo, { Name = "Tagline", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 58), Size = UDim2.new(0.86, 0, 0, 28), BackgroundColor3 = TC.PanelEdge, BackgroundTransparency = 0.05 })
		UI.corner(tag, 14)
		UI.stroke(tag, TC.Hud, 2)
		local tt = UI.text(tag, "One egg hides a <font color=\"#FFC424\">rare pet!</font>", { Font = UI.Bold, TextSize = T.Body, RichText = true, Outline = "Normal", Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), TextXAlignment = Enum.TextXAlignment.Center })
		tt.TextWrapped = false
		UI.fit(tt, T.Body, T.MinText)
	end
	refs.Logo = logo
	local hint = UI.card(top, "hud", { Name = "Hint", Size = UDim2.new(1, 0, 0, 54), LayoutOrder = 2, Visible = false })
	UI.icon(hint, "hint", 22, { Position = UDim2.fromOffset(8, 16) })
	refs.HintText = UI.text(hint, "", { Font = UI.Bold, TextSize = T.Body, Outline = "Normal", Size = UDim2.new(1, -160, 1, -4), Position = UDim2.fromOffset(36, 2) })
	-- SKIP ends the whole tutorial (server: TutorialAction "Skip"); the free starter pet is kept / still given
	local hintSkip = UI.button(hint, "SKIP", "blue", function()
		UI.confirm({
			Name = "SkipTutorial",
			Title = "Skip the tutorial?",
			Message = "No more tips. You keep your free starter pet.",
			Icon = "hint",
			Confirm = "SKIP",
			OnConfirm = function()
				Net.event("TutorialAction"):FireServer("Skip")
			end,
		})
	end, { Name = "SkipTutorial", Size = UDim2.fromOffset(56, T.Touch), Position = UDim2.new(1, -120, 0, 5), TextSize = T.Small })
	local hsl = hintSkip:FindFirstChild("Label") :: TextLabel?
	if hsl then
		HudArt.word(hsl, 0.8) -- owner's SKIP word picture (reference/ui/settings/text_skip.png) once uploaded
	end
	UI.button(hint, "OK", "blue", function()
		Hud.hintDismissed = refs.HintText.Text
		Hud.refresh()
	end, { Size = UDim2.fromOffset(52, T.Touch), Position = UDim2.new(1, -58, 0, 5), TextSize = T.Small })
	refs.Hint = hint
	local lowHint = UI.frame(root, { Name = "HintLow", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -(T.Edge + 54)), Size = UDim2.new(1, -2 * (LEFT_W + 2 * T.Edge), 0, 54), BackgroundTransparency = 1 })
	local lowLim = Instance.new("UISizeConstraint")
	lowLim.MaxSize = Vector2.new(400, 60)
	lowLim.Parent = lowHint
	refs.HintLow = lowHint
	local full = UI.card(top, "hud", { Name = "BagNotice", Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 3, Visible = false })
	UI.icon(full, "rubble", 26, { Position = UDim2.fromOffset(8, 9) })
	UI.text(full, "Candy bag full", { Font = UI.Head, TextSize = T.Body, Size = UDim2.new(1, -48, 0, 22), Position = UDim2.fromOffset(42, 2) })
	UI.text(full, "Sell candy to keep hatching", { Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Muted, Outline = "Normal", Size = UDim2.new(1, -48, 0, 18), Position = UDim2.fromOffset(42, 23) })
	refs.BagNotice = full
	refs.Top = top
	refs.HintTopHolder = top

	-- Portrait phones: the objective spans the top and the two columns start under it.
	-- Short screens: the left column must end above the bottom edge. A UIScale on the column shrinks every card by
	-- the ColumnFit size rule (cards never below FIT_MIN_CARD logical px tall); tall screens stay at scale 1.
	local fitScale = Instance.new("UIScale")
	fitScale.Name = "FitScale"
	fitScale.Parent = left
	local function fitLeft()
		local list = refs.LeftList :: UIListLayout?
		if not list then
			return
		end
		arrangeLobby()
		-- all heights in the units the layout reports (screen px); k = px per logical px
		local cur = math.max(fitScale.Scale, 0.1)
		local k = left.AbsoluteSize.X / (math.max(left.Size.X.Offset, 1) * cur)
		if k <= 0.01 then
			return
		end
		local n, sum = 0, 0
		for _, c in left:GetChildren() do
			if c:IsA("GuiObject") and c.Visible then
				n += 1
				sum += c.AbsoluteSize.Y / cur
			end
		end
		if n == 0 then
			return
		end
		local gapPx = list.Padding.Offset * k
		local content = sum + gapPx * (n - 1)
		local avail = root.AbsoluteSize.Y - (leftBox.AbsolutePosition.Y - root.AbsolutePosition.Y) - T.Edge * k
		local mean = sum / n
		local f = ColumnFit.fit(avail, n, gapPx, FIT_MIN_CARD * k, mean)
		-- cols > 1: even the smallest card size does not fit one column, so the column scrolls instead
		local size = if f.cols > 1 then FIT_MIN_CARD * k else f.size
		local sc = if content <= avail then 1 else math.min(1, size / mean)
		if math.abs(fitScale.Scale - sc) > 0.005 then
			fitScale.Scale = sc
		end
		local shownH = (sum * sc + gapPx * (n - 1) * sc) -- height of the column after scaling, px
		leftBox.ScrollingEnabled = shownH > avail + 0.5
		leftBox.ScrollBarThickness = if leftBox.ScrollingEnabled then 4 else 0
		leftBox.Size = UDim2.fromOffset(boxW, math.max(1, math.floor(avail / k)))
		leftBox.CanvasSize = UDim2.fromOffset(0, math.ceil(shownH / k))
	end
	local function placeTop()
		local topH = if refs.Objective.Visible and top.Visible and refs.Objective.Parent == top then refs.Objective.Size.Y.Offset + 8 else 0
		if refs.Logo.Visible and top.Visible then
			topH += refs.Logo.Size.Y.Offset + 6
		end
		-- portrait: the columns start under everything in the top stack (objective, hint, rubble notice)
		local stackH = topH
		if top.Visible then
			if refs.Hint.Visible and refs.Hint.Parent == top then
				stackH += refs.Hint.Size.Y.Offset + 6
			end
			if refs.BagNotice.Visible then
				stackH += refs.BagNotice.Size.Y.Offset + 6
			end
		end
		-- the left cards keep a safe gap from the screen edge: the HUD layer already sits inside Roblox's safe insets
		-- (notch, top bar), and the gap is at least LEFT_GAP screen px whatever the UI scale (on a small phone T.Edge
		-- alone shrank to a few px and the card rims touched the edge)
		local leftX = math.max(T.Edge + 4, math.ceil(LEFT_GAP / math.max(UI.Scale, 0.1)))
		-- portrait: TOWER and BATTLE stack in the mode row (side by side they ran under the right menu tiles)
		if refs.ModeList then
			(refs.ModeList :: UIListLayout).FillDirection = if UI.isPortrait() then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal
		end
		if UI.isPortrait() then
			top.AnchorPoint = Vector2.new(0.5, 0)
			top.Position = UDim2.new(0.5, 0, 0, T.Edge)
			top.Size = UDim2.new(1, -2 * T.Edge, 0, 0)
			lim.MaxSize = Vector2.new(420, 1000)
			leftBox.Position = UDim2.fromOffset(leftX - BOX_PAD, T.Edge + stackH)
			right.Position = UDim2.new(1, -T.Edge, 0, T.Edge + stackH)
			refs.HintLow.Size = UDim2.new(1, -2 * T.Edge, 0, 54)
		else
			top.AnchorPoint = Vector2.new(0.5, 0)
			top.Position = UDim2.new(0.5, 0, 0, T.Edge)
			-- the lobby column holds the wider PLAY / TOWER / DAILY buttons (LOBBY_W): sized for the hunt's LEFT_W, the
			-- objective card overlapped PLAY (the gold tab seen under the banner was the world marker, see Main)
			local colW = if State.Match then LEFT_W else LOBBY_W
			top.Size = UDim2.new(1, -2 * (colW + leftX + T.Edge + 8), 0, 0)
			lim.MaxSize = Vector2.new(360, 1000)
			leftBox.Position = UDim2.fromOffset(leftX - BOX_PAD, T.Edge)
			right.Position = UDim2.new(1, -T.Edge, 0, T.Edge)
			refs.HintLow.Size = UDim2.new(1, -2 * (LEFT_W + 2 * T.Edge), 0, 54)
		end
		-- notifications sit under the top bar
		if UI.isPortrait() and State.Match ~= nil then
			-- full width under the counter and menu columns (the gap between them is too narrow for a card)
			local cols = 0
			for _, c in left:GetChildren() do
				if c:IsA("GuiObject") and c.Visible then
					if c == refs.Roster then
						cols += refs.RosterH or 0 -- auto-sized: the race bar's own height (chips + gaps)
					else
						cols += c.Size.Y.Offset + 6
					end
				end
			end
			UI.placeNotices(T.Edge + stackH + math.max(cols, 170) + 4)
		else
			UI.placeNotices(T.Edge + topH + (if refs.Hint.Visible or refs.BagNotice.Visible then 62 else 4))
		end
		fitLeft()
		fitMenu()
	end
	placeTop()
	refs.PlaceTop = placeTop
	-- the column grows and shrinks as cards show and hide: refit when its content height changes
	if refs.LeftList then
		refs.LeftList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			task.defer(placeTop)
		end)
	end
	UI.screen():GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		task.defer(placeTop)
	end)

	-- Bottom centre: tool slots (hunt only).
	local dock = UI.frame(root, { Name = "Dock", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -T.Edge), Size = UDim2.fromOffset(DOCK_W, SLOT + 2), BackgroundTransparency = 1, Visible = false })
	UI.list(dock, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)
	refs.SlotHand = toolSlot(dock, "SlotHand", "1", "hand", "HAND", 1)
	refs.SlotTool = toolSlot(dock, "SlotTool", "2", "boostLuck", "COLLAR", 2)
	refs.SlotToolKind = ""
	refs.Dock = dock

	-- Primary action: gold, one short verb; neutral states are flat gray and say why nothing can be done.
	local act = Instance.new("TextButton")
	act.Name = "PrimaryAction"
	act.AnchorPoint = Vector2.new(1, 1)
	act.Position = UDim2.new(1, -T.Edge - 8, 1, -150)
	act.Size = UDim2.fromOffset(T.Primary.X, T.Primary.Y)
	act.BackgroundColor3 = TC.Gold
	act.AutoButtonColor = false
	act.Text = ""
	act.Visible = false
	act.Parent = root
	UI.corner(act, 12)
	refs.ActStroke = UI.stroke(act, TC.GoldDeep, 3)
	-- the key sits on a small dark badge in the corner, above the label (it was drawn under the words)
	local keyBadge = UI.frame(act, { Name = "KeyBadge", BackgroundColor3 = TC.Hud, AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(-4, -6), Size = UDim2.fromOffset(26, 22), ZIndex = 4, Visible = false })
	UI.corner(keyBadge, 7)
	UI.stroke(keyBadge, TC.PanelEdge, 2)
	refs.ActKey = UI.text(keyBadge, "E", { Name = "KeyHint", Font = UI.Head, TextSize = T.Tiny, TextColor3 = TC.Text, Outline = false, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5 })
	refs.ActKey:GetPropertyChangedSignal("Visible"):Connect(function()
		keyBadge.Visible = refs.ActKey.Visible
	end)
	refs.ActText = UI.text(act, "PICK UP", { Name = "Label", Font = UI.Head, TextSize = T.Head + 2, TextColor3 = TC.DarkText, Outline = false, Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -16, 1, -12), TextXAlignment = Enum.TextXAlignment.Center, LineHeight = 0.9 })
	UI.squashScale(act)
	UI.bevel(act)
	-- One press at a time; the finger-lift watcher is dropped when the button hides or a menu opens.
	local pressConn: RBXScriptConnection? = nil
	local function releaseAct()
		if pressConn then
			pressConn:Disconnect()
			pressConn = nil
		end
		UI.squash(act, false)
		PileView.stopAll()
	end
	act.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		if pressConn then
			return -- a second finger must not start a second loop
		end
		PileView.holdBegin()
		UI.squash(act, true)
		pressConn = input:GetPropertyChangedSignal("UserInputState"):Connect(function()
			if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then
				if pressConn then
					pressConn:Disconnect()
					pressConn = nil
				end
				PileView.holdEnd()
				UI.squash(act, false)
			end
		end)
	end)
	act:GetPropertyChangedSignal("Visible"):Connect(function()
		if not act.Visible then
			releaseAct()
		end
	end)
	refs.Act = act
	-- Sell card (board "Rubble sale"): rides above the action while it says SELL RUBBLE. Numbers are the server's view
	-- of the bag (profile Rubble / Capacity / RubbleValue); the receipt after the sale is the server's notification.
	local sellCard = UI.card(act, "panel", { Name = "SellPreview", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 0, -8), Size = UDim2.fromOffset(T.Primary.X + 40, 58), Visible = false })
	UI.icon(sellCard, "basket", 34, { Position = UDim2.fromOffset(6, 12) })
	refs.SellQty = UI.text(sellCard, "", { Font = UI.Bold, TextSize = T.Body, Outline = "Normal", RichText = true, Position = UDim2.fromOffset(46, 4), Size = UDim2.new(1, -52, 0, 24) })
	refs.SellCash = UI.text(sellCard, "", { Font = UI.Head, TextSize = T.Body, TextColor3 = TC.Cash, Position = UDim2.fromOffset(46, 28), Size = UDim2.new(1, -52, 0, 24) })
	refs.SellCard = sellCard

	-- Where the action sits (TouchLayout: clear of Roblox's jump button, screen pixels).
	local function placeAction()
		local gui = UI.screen()
		local px = gui.AbsoluteSize
		local cam = Workspace.CurrentCamera
		local fullSize = if cam then cam.ViewportSize else px
		local scale = if UI.Logical.X > 0 then px.X / UI.Logical.X else 1
		-- CRACK (refs.ActBig) is the big thumb button; everything else keeps the normal size
		local big = refs.ActBig == true
		local w = if big then T.Primary.X + 26 else T.Primary.X
		local h = if big then T.Primary.Y + 30 else T.Primary.Y
		local topLimit = px.Y - (T.Edge + 190) * scale -- keep the right column (timer, menu) free
		local menu = refs.Menu :: Frame
		if State.Match ~= nil and menu.Visible and menu.AbsoluteSize.Y > 1 then
			-- hunt: the menu is one short row, so the action may rise to just under it (above the jump button, at the
			-- screen edge) instead of moving in toward the middle of the view, where it covered the nest's name board
			topLimit = px.Y - (menu.AbsolutePosition.Y - gui.AbsolutePosition.Y + menu.AbsoluteSize.Y + 12 * scale)
		end
		local r, bottom, mode = TouchLayout.place(fullSize.X, fullSize.Y, h * scale, topLimit, UserInputService.TouchEnabled)
		if mode == "left" then
			-- on the bottom row the button must stay right of the tool dock (bottom centre, DOCK_W wide)
			local room = (px.X / 2 - (DOCK_W / 2 + 10) * scale - r) / scale
			w = math.max(math.min(w, room), math.min(T.Primary.X, room), 96)
		end
		act.Size = UDim2.fromOffset(w, h)
		act.Position = UDim2.new(1, -r / scale, 1, -bottom / scale)
		refs.ActMode = mode
		refs.ActRightPx = r
	end
	refs.PlaceAction = placeAction
	placeAction()
	UI.screen():GetPropertyChangedSignal("AbsoluteSize"):Connect(placeAction)
	for _, prop in { "AbsoluteSize", "Visible" } do
		refs.Menu:GetPropertyChangedSignal(prop):Connect(function()
			task.defer(placeAction)
		end)
	end
	UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(placeAction)

	-- The rectangle (HUD pixels) the route-hint chip may use: between the two columns, below the top bar, above the dock.
	GuideArrow.setBounds(function()
		local gui = UI.screen()
		local origin, size = gui.AbsolutePosition, gui.AbsoluteSize
		local scale = if UI.Logical.X > 0 then size.X / UI.Logical.X else 1
		local l = refs.Stats.AbsolutePosition.X - origin.X + refs.Stats.AbsoluteSize.X + 12 * scale
		local r = refs.Menu.AbsolutePosition.X - origin.X - 12 * scale
		if refs.Act.Visible then
			r = math.min(r, refs.Act.AbsolutePosition.X - origin.X - 12 * scale)
		end
		local t = 40 * scale
		if refs.Top.Visible then
			t = refs.Top.AbsolutePosition.Y - origin.Y + refs.Top.AbsoluteSize.Y + 12 * scale
		end
		local bt = size.Y - 20 * scale
		if refs.Dock.Visible then
			bt = refs.Dock.AbsolutePosition.Y - origin.Y - 8 * scale
		end
		if r - l < 100 then
			t = math.max(t, refs.Stats.AbsolutePosition.Y - origin.Y + refs.Stats.AbsoluteSize.Y + 8 * scale)
			l = 12 * scale
		end
		if r - l < 100 or bt - t < 60 then
			return 60, 60, size.X - 60, size.Y - 60
		end
		return l, t, r, bt
	end)

	Hud.refresh()
	State.Changed.Event:Connect(function()
		Hud.refresh()
	end)
	player:GetAttributeChangedSignal("MatchKey"):Connect(Hud.refresh)
	player:GetAttributeChangedSignal("InTower"):Connect(Hud.refresh)
	player:GetAttributeChangedSignal("InBattle"):Connect(Hud.refresh)
	UI.BlockChanged.Event:Connect(function(blocked)
		if blocked then
			PileView.stopAll()
			PileView.clearSelection()
		end
		Hud.refresh()
	end)
	task.spawn(function()
		local warned = false
		while true do
			task.wait(0.2)
			-- one failing tick must not end the loop (audit 16): log the first error, keep ticking
			local ok, err = pcall(Hud.tick)
			if not ok and not warned then
				warned = true
				warn("[Hud] tick failed (further errors silenced): " .. tostring(err))
			end
		end
	end)
end

-- Eggs not cracked yet this hunt (server counters: Total - Broken), for the line under the clock.
local function uncracked(m: any): number
	local c = m.Counts
	if c and type(c.Unopened) == "number" then
		return c.Unopened
	end
	return if c and type(c.Pile) == "number" then c.Pile else (m.Remaining or m.Rocks or 0)
end

local function fmtTime(s: number): string
	s = math.max(0, math.floor(s))
	return string.format("%d:%02d", s // 60, s % 60)
end

-- Contextual primary action (V3 loop). The id comes from PileView.context(), the same rules the server applies,
-- so the button never promises what it cannot do. Neutral = a status (flat gray), never a second primary.
local ACTION = {
	pickup = { Text = "PICK UP" },
	take = { Text = "BASKET FULL", Neutral = true },
	deposit = { Text = "DEPOSIT\nEGGS" },
	crush = { Text = "HATCH!", Big = true }, -- the big thumb button; tapping the nest egg also cracks
	machine = { Text = "MACHINE\nRUNNING", Neutral = true },
	collect = { Text = "COLLECT\nEGGS", Go = true }, -- the next step (empty basket at the nest): bright green, never gray
	sell = { Text = "SELL\nCANDY" },
	bagfull = { Text = "STORAGE\nFULL", Neutral = true },
	closer = { Text = "MOVE\nCLOSER", Neutral = true, Hint = true }, -- blue with a white edge: "walk closer", not broken
	wait = { Text = "GET\nREADY", Neutral = true },
	securing = { Text = "SECURING\u{2026}", Neutral = true },
}
local lastCtxId: string? = nil -- the contextual action shown last tick (stale "Move closer" cards are dropped on change)

-- Key hint for keyboard and gamepad players (touch shows none).
local function keyHint(): string?
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return nil
	elseif string.sub(last.Name, 1, 7) == "Gamepad" then
		return "RT"
	elseif last == Enum.UserInputType.Keyboard or last == Enum.UserInputType.MouseButton1 or last == Enum.UserInputType.MouseMovement then
		return "E"
	end
	return nil
end

-- Sell hoppers of the current arena (found once per match key; the arena does not move during a match).
local hopperKey: any = nil
local hoppers: { BasePart } = {}
local function nearestHopper(m: any): BasePart?
	if hopperKey ~= m.Key then
		hopperKey = m.Key
		table.clear(hoppers)
		for _, d in Workspace:GetDescendants() do
			if d:IsA("Model") and d:GetAttribute("Hopper") then
				local body = d:FindFirstChild("Body")
				if body and body:IsA("BasePart") then
					table.insert(hoppers, body)
				end
			end
		end
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local best, bestD = nil, 400
	for _, b in hoppers do
		if b.Parent then
			local d = (b.Position - root.Position).Magnitude
			if d < bestD then
				best, bestD = b, d
			end
		end
	end
	return best
end

-- Contexts that mean "standing at the own table".
local AT_TABLE = { deposit = true, crush = true, machine = true, collect = true, bagfull = true }

-- the equipped pet gear's own picture (its Gear_<Id> model, or ItemView's gear icon), never the old hammer
local function setToolSlotIcon(gearId: string)
	if refs.SlotToolKind == gearId then
		return
	end
	refs.SlotToolKind = gearId
	if refs.SlotToolIcon then
		refs.SlotToolIcon:Destroy()
	end
	refs.SlotToolIcon = ItemView.make(refs.SlotTool, gearId, { Name = "SlotToolIcon", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(SLOT_ICON, SLOT_ICON) }, SLOT_ICON)
end

function Hud.tick()
	local m = State.Match
	if m == nil and refs.CueShown and not Hud.cueActive() then
		refs.CueShown = false
		Hud.refresh()
		return
	end
	if not m or not refs.Act then
		if m == nil and refs.Act and GuideArrow.label() ~= "" and GuideArrow.label() ~= "EGG" then
			GuideArrow.clear() -- the post-hunt SELL chip never follows the player into the lobby (the starter EGG arrow stays)
		end
		Hud.updateHint()
		return
	end
	Hud.updateHint()
	local now = Workspace:GetServerTimeNow()
	if m.Phase == "Countdown" then
		local leftS = math.max(1, math.ceil(m.EndsAt - now))
		refs.ObjSub.Text = "Starting in " .. leftS
		Audio.countdown(leftS)
		-- the timer card is up from the countdown: the full round time waits to run down from GO
		local ot0 = EggConfig.Overtime
		refs.TimerText.Text = if ot0.Enabled and not m.Tutorial then fmtTime(ot0.RoundSeconds) else "0:00"
	elseif m.Phase == "Searching" then
		local elapsed = now - (m.SearchStart or now)
		-- 3-minute rounds (EggConfig.Overtime): the clock runs DOWN to the moment the pet egg glows gold for everyone,
		-- then stays at 0:00 while the race finishes; the practice round (no glow) counts up as before
		local ot1 = EggConfig.Overtime
		local tt = if ot1.Enabled and not m.Tutorial then fmtTime(math.max(0, math.ceil(ot1.RoundSeconds - elapsed))) else fmtTime(elapsed)
		if tt ~= refs.TimerText.Text and refs.Clock and not UI.Reduced then
			-- the clock gives a small tick each second (left, right, left...)
			clockTick = -clockTick
			refs.Clock.Rotation = 8 * clockTick
			TweenService:Create(refs.Clock, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
		end
		refs.TimerText.Text = tt
		-- last 10 seconds before the overtime glow (EggConfig.Overtime): the clock turns red and pulses each second
		local ot = EggConfig.Overtime
		local toGlow = ot.RoundSeconds - elapsed
		if ot.Enabled and not m.Tutorial and toGlow > 0 and toGlow <= 10 then
			refs.TimerText.TextColor3 = Theme.Fx.Danger
			refs.PileText.TextColor3 = Theme.Fx.Danger
			pileWarned = true
			if not shookTimer then
				shookTimer = true
				if not UI.Reduced then
					task.spawn(function()
						for _, r in { 6, -5, 4, -2, 0 } do
							if not refs.Timer.Parent then
								return
							end
							refs.Timer.Rotation = r
							task.wait(0.045)
						end
					end)
				end
			end
			local sec = math.floor(elapsed)
			if sec ~= pulseSecond then
				pulseSecond = sec
				UI.pop(refs.Timer, 1.15)
			end
		elseif refs.TimerText.TextColor3 == Theme.Fx.Danger then
			refs.TimerText.TextColor3 = TC.Gold
		end
		if toGlow > 10 then
			shookTimer = false
		end
		-- eggs-left line: orange for the last 30 s before the overtime glow, red for the last 10 s (above)
		if ot.Enabled and not m.Tutorial and toGlow > 10 and toGlow <= 30 then
			refs.PileText.TextColor3 = TC.Warn
			pileWarned = true
		elseif pileWarned and not (ot.Enabled and not m.Tutorial and toGlow > 0 and toGlow <= 10) then
			refs.PileText.TextColor3 = TC.Muted
			pileWarned = false
		end
	elseif m.SearchStart and m.SearchEnd then
		refs.TimerText.Text = fmtTime(m.SearchEnd - m.SearchStart) -- stopped at the authoritative end
	end
	local blocked = UI.blocked()
	local phase = m.Phase
	local actionPhase = phase == "Countdown" or phase == "Searching" or phase == "RewardPending"
	local ctx = PileView.context()
	-- a "Move closer" card is stale the moment a real action is offered (PICK UP, DEPOSIT, CRACK...): drop it
	if ctx.Id ~= "closer" and ctx.Id ~= lastCtxId and ACTION[ctx.Id] and ACTION[ctx.Id].Neutral ~= true then
		UI.dismissNotices("arena:move closer")
	end
	lastCtxId = ctx.Id
	local show = actionPhase and not blocked and ActionRules.visible(ctx.Id)
	if refs.Act.Visible ~= show then
		refs.Act.Visible = show
	end
	-- PICK UP bounces once when it becomes available
	local pickupNow = show and ctx.Id == "pickup"
	if pickupNow and not lastActPickup then
		UI.pop(refs.Act, 0.82)
	end
	lastActPickup = pickupNow
	if show then
		local a = ACTION[ctx.Id] or ACTION.closer
		local neutral = a.Neutral == true
		local hintLook = a.Hint == true
		local go = a.Go == true -- active "go there" step: green with white outlined letters
		refs.Act.BackgroundColor3 = if hintLook then TC.Gray elseif neutral then TC.Disabled elseif go then TC.Green else TC.Gold
		refs.ActStroke.Color = if hintLook then TC.Text elseif neutral then TC.PanelEdge elseif go then TC.GreenDeep else TC.GoldDeep
		refs.ActText.TextColor3 = if neutral or go then TC.Text else TC.DarkText
		local o = refs.ActText:FindFirstChild("Outline")
		if (neutral or go) and not o then
			UI.outline(refs.ActText, "Normal")
		elseif not (neutral or go) and o then
			o:Destroy()
		end
		refs.ActText.Text = a.Text
		-- CRACK is the big thumb button (an egg is on the own nest plate); every other action keeps the normal size
		local big = a.Big == true
		if refs.ActBig ~= big then
			refs.ActBig = big
			UI.fit(refs.ActText, if big then T.Head + 10 else T.Head + 2)
			refs.PlaceAction()
		end
		local key = keyHint()
		refs.ActKey.Visible = key ~= nil and not neutral
		if key then
			refs.ActKey.Text = key
		end
		refs.Act:SetAttribute("Disabled", neutral)
	end
	refs.CtxId = ctx.Id
	if phase == "Searching" then
		refs.ObjSub.Text = Hud.searchLine(m, ctx.Id)
	end
	local prof = State.Profile
	local sellOn = show and ctx.Id == "sell" and prof ~= nil
	if refs.SellCard.Visible ~= sellOn then
		refs.SellCard.Visible = sellOn
	end
	if sellOn and prof then
		if prof.Rubble > 0 then
			refs.SellQty.Text = "Candy: <font color=\"#FFB020\">" .. prof.Rubble .. "</font>/" .. prof.Capacity
			refs.SellCash.Text = "+" .. UI.money(prof.RubbleValue or 0)
		else
			refs.SellQty.Text = "No candy to sell."
			refs.SellCash.Text = ""
		end
	end
	-- after the hunt, while the tutorial's next step is selling: the route hint points at the nearest bin
	local hop = if phase == "Results" and not blocked and prof and not prof.OnboardDone and prof.Onboard and not prof.Onboard.Sold and prof.Rubble > 0 then nearestHopper(m) else nil
	if hop then
		GuideArrow.set(hop.Position, "SELL", hop.Position.Y)
	else
		PileView.updateGuide(ctx, phase == "Searching" and not blocked, prof ~= nil and not prof.OnboardDone)
	end

	-- Own station: queue, processing, machine, tool slots.
	local st = ownStation(m)
	local searching = st ~= nil and phase == "Searching" and not blocked
	local atTable = searching and AT_TABLE[ctx.Id] == true
	local cap = if st and st.QueueCap then st.QueueCap else Config.Station.QueueCapacity
	local queued = if st then #st.Queue else 0
	-- the QUEUE card keeps its slot for the whole hunt (from the countdown on): popping in and out at the nest made
	-- the left column jump
	refs.QueueCard.Visible = st ~= nil and actionPhase
	if st then
		refs.SetQueue(queued, cap)
		local qFull = queued >= cap and cap > 0
		markFull(refs.QueueCard, qFull)
		if qFull and not queueWasFull then
			shakeIcon(refs.QueueCard) -- same wiggle as the basket the moment the nest tray fills
		end
		queueWasFull = qFull
	end
	-- processing indicator from the server's plate state only
	local procOn, procText, procV = false, "", 0
	if searching and st then
		local running = st.Machine ~= nil and st.State == "Running"
		local key = st.Current
		local p = st.Progress or 0
		local newRock = key ~= lastProgressKey
		if newRock then
			lastProgressKey = key
			lastProgress = p
			lastProgressAt = if p > 0 then os.clock() else -math.huge
		elseif lastProgress ~= p then
			procGap = math.clamp(os.clock() - lastProgressAt, 0.15, 0.8) -- time between the last two server values
			lastProgress = p
			lastProgressAt = os.clock()
		end
		-- a rock on the own plate that has started cracking keeps the card up while the player is at the nest (it no
		-- longer drops out between two hits)
		local live = key ~= nil and (p > 0 or os.clock() - lastProgressAt < PROGRESS_LIVE)
		if running and (key ~= nil or queued > 0) then
			procOn, procText, procV = true, "AUTO NEST HATCHING", if key then p else 0
		elseif live and atTable then
			procOn, procText, procV = true, "HATCHING", p
		end
		if newRock then
			procGoal = -1 -- a new rock starts its bar from its own value, not eased down from the last one
		end
	else
		lastProgressKey = nil
	end
	local nowC = os.clock()
	if procOn then
		procUntil = nowC + PROC_HOLD
	elseif refs.Proc.Visible and searching and nowC < procUntil and lastProgressKey ~= nil then
		procOn, procText, procV = true, procBase, procGoal -- short hold: a context flicker does not blink the card
	end
	if refs.Proc.Visible ~= procOn then
		refs.Proc.Visible = procOn
	end
	if procOn then
		procBase = procText
		local goal = math.clamp(procV, 0, 1)
		if goal ~= procGoal then
			local first = procGoal < 0 or goal < procGoal
			procGoal = goal
			if procTween then
				procTween:Cancel()
				procTween = nil
			end
			if first or UI.Reduced then
				procShown.Value = goal
			else
				local tw = TweenService:Create(procShown, TweenInfo.new(procGap, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Value = goal })
				procTween = tw
				tw:Play()
			end
		end
		-- the label follows the eased value (the Changed handler); a new label word shows at once
		refs.ProcText.Text = if procBase == "HATCHING" then procBase .. " " .. math.floor(procShown.Value * 100 + 0.5) .. "%" else procBase
	else
		procGoal = -1
	end
	-- tool slots: the hand while collecting / depositing, the tool while cracking
	local dockOn = searching
	if refs.Dock.Visible ~= dockOn then
		refs.Dock.Visible = dockOn
	end
	if dockOn then
		local toolInUse = ctx.Id == "crush"
		setSlot(refs.SlotHand, not toolInUse)
		setSlot(refs.SlotTool, toolInUse)
	end
end

-- The objective line while searching. It follows the contextual action (re-read every tick, not only on server
-- updates), so it never says "Grab eggs" while the DEPOSIT button is up at the nest.
function Hud.searchLine(m: any, ctxId: string): string
	local mine = ownStation(m)
	local n = if mine then #mine.Basket else 0
	local cap = if mine and mine.CarryCap then mine.CarryCap else Config.Carry.Capacity
	if m and m.Tutorial then
		-- the first (practice) hunt: one tip at a time, three words at most (the route arrow shows where)
		if ctxId == "deposit" then
			return "Drop eggs in!"
		elseif ctxId == "crush" or ctxId == "machine" or ctxId == "bagfull" then
			return "Tap to hatch!"
		elseif n > 0 and (n >= cap or ctxId ~= "pickup") then
			return "Go to nest!"
		end
		return "Grab eggs!"
	end
	if ctxId == "deposit" then
		return "Put your eggs in your nest!"
	elseif ctxId == "crush" or ctxId == "machine" or ctxId == "bagfull" then
		return "Hatch eggs at your nest!"
	elseif n >= cap then
		return "Take your eggs to your nest!"
	elseif n > 0 and ctxId ~= "pickup" then
		return "Grab more eggs or take them to your nest!"
	end
	return "Grab eggs from the pile!"
end

-- The one next step after a hunt (HUD objective while the results card is closed). Tutorial players get the
-- tutorial's next stage; everyone else is told how to hunt again.
function Hud.nextStep(): string
	local prof = State.Profile
	if prof and not prof.OnboardDone and prof.Onboard then
		local ob = prof.Onboard
		if not ob.Sold and prof.Rubble > 0 then
			return "Next: sell candy at the candy stand"
		elseif ob.Geode and not ob.Displayed and #prof.Inventory > 0 then
			return "Next: tap LOBBY, then show your pet"
		end
	end
	return "Tap RESULTS to hunt again"
end

function Hud.refresh()
	if not refs.Act then
		return
	end
	local prof = State.Profile
	local m = State.Match
	local blocked = UI.blocked()
	local full = false
	local inMatch = m ~= nil
	-- lobby-only pieces go the moment the server puts us in a hunt (MatchKey), not when the hunt state lands later
	local lobbyUi = not inMatch and player:GetAttribute("MatchKey") == nil
	local phase = if m then m.Phase else nil
	if prof then
		setCash(prof.Cash)
		full = prof.Rubble >= prof.Capacity
		local folded = refs.BagLine:GetAttribute("Folded") == true -- the short pill of the phone row (foldBag)
		refs.Rubble.Text = (if folded then (if full then "FULL " else "Candy ") elseif full then "Candy bag FULL " else "Candy bag ") .. prof.Rubble .. "/" .. prof.Capacity
		local near = not full and prof.Capacity > 0 and prof.Rubble >= prof.Capacity * 0.8
		refs.Rubble.TextColor3 = if full then TC.Red elseif near then Color3.fromRGB(230, 120, 20) else PanelSkin.NAVY
		local bagEdge = refs.BagLine:FindFirstChildOfClass("UIStroke")
		if bagEdge then
			bagEdge.Color = if full then TC.Red elseif near then Color3.fromRGB(230, 120, 20) else PanelSkin.NAVY
		end
		refs.RubbleSub.Text = if full then "Sell, then hunt!" else "Sell for coins!"
		refs.BagLine.Visible = lobbyUi and prof.Rubble > 0
		setRubbleRolling(prof.Rubble, prof.Capacity)
		refs.SavesOff.Visible = prof.SavesOff == true and RunService:IsStudio() and not blocked
		local h = Config.Handhelds[prof.EquippedHandheld]
		local slotCap = refs.SlotTool:FindFirstChild("Caption") :: TextLabel?
		if slotCap then
			slotCap.Text = TOOL_SHORT[prof.EquippedHandheld] or (if h then string.upper(h.Name) else "COLLAR")
		end
		setToolSlotIcon(prof.EquippedHandheld or "Hammer")
	end
	local mine = ownStation(m)
	do
		local n = if mine then #mine.Basket else 0
		local carryCap = if mine and mine.CarryCap then mine.CarryCap else Config.Carry.Capacity -- basket upgrades
		refs.SetCarry(n, carryCap)
		local nowFull = n >= carryCap and carryCap > 0
		markFull(refs.CarryCard, nowFull)
		if nowFull and not basketWasFull then
			shakeIcon(refs.CarryCard) -- the meter wiggles the moment the basket fills
		end
		basketWasFull = nowFull
		refs.CarryCard.Visible = inMatch and mine ~= nil
		refs.RubbleCard.Visible = inMatch and mine ~= nil
		if refs.LeftList then
			refs.LeftList.Padding = UDim.new(0, if inMatch then 9 else 6) -- hunt cards get a clear gap between them
		end
		if n < carryCap then
			Hud.dismissToasts("basket")
		end
	end
	-- machine chip (hunt, own machine installed)
	if prof then
		local id = prof.InstalledMachine
		local entry = myMachine(m)
		local want = if id then (MACHINE_ICON[id] or "machine") else "machine"
		if want ~= refs.MachIconKind then
			refs.MachIconKind = want
			if refs.MachIcon then
				refs.MachIcon:Destroy()
			end
			refs.MachIcon = UI.icon(refs.Mach, want, 26, { Position = UDim2.fromOffset(7, 9) })
		end
		local label = "Off in practice"
		if id and entry then
			label = if entry.State == "Running" then "Running \u{b7} tap to pause" elseif entry.State == "Paused" then "Paused \u{b7} tap to run" elseif entry.State == "Full" then "Storage full" else "Installed"
		end
		refs.MachLabel.Text = label
		refs.Mach.Visible = inMatch and id ~= nil and mine ~= nil and phase == "Searching" and not blocked
		UI.setEnabled(refs.Mach, entry ~= nil)
	end
	if not inMatch then
		Hud.dismissToasts("all") -- arena directions do not follow the player into the lobby
	elseif not full then
		Hud.dismissToasts("bag")
	end
	-- lobby menu vs hunt menu
	refs.Resources.Visible = lobbyUi
	refs.BtnShop.Visible = lobbyUi
	refs.BtnParty.Visible = lobbyUi
	refs.BtnCollection.Visible = lobbyUi
	refs.BtnQuests.Visible = lobbyUi
	do
		-- (bug #249) counted again from the quest rows and the gift on every refresh (each profile change and the
		-- MatchKey change on the way back to the lobby), so a claim clears the dot as soon as its profile lands
		UI.newDot(refs.QuestsDot, dailyReady(prof) > 0, dailyReady(prof))
		-- red "!" on the Pet Book tile for pets hatched since it was last opened (this session only, client side)
		-- (counted from the first loaded profile: counting from "no profile yet" = 0 lit the "!" for every pet you own
		-- and it never cleared unless the profile changed while the book was open)
		local have = if prof and prof.Inventory then #prof.Inventory else nil
		if have then
			if seenPets == nil or UI.modalOpen() == "Collection" or have < (seenPets :: number) then
				seenPets = have
			end
			lastPets = have
		end
		UI.newDot(refs.PetsDot, have ~= nil and seenPets ~= nil and have > (seenPets :: number))
	end
	refs.BtnLobby.Visible = inMatch
	refs.BtnResults.Visible = inMatch and phase == "Results" and State.Results ~= nil and UI.modalOpen() ~= "Results"
	refs.Timer.Visible = inMatch and (phase == "Searching" or phase == "Countdown" or ((phase == "RewardPending" or phase == "Reveal" or phase == "Results") and m.SearchEnd ~= nil))
	-- after the find the clock is stopped: say so, so the card never reads as a live hunt
	local final = inMatch and phase ~= "Searching" and phase ~= "Countdown"
	-- the count under the clock is every egg not cracked yet (pile + baskets + nests: the pet can be in any of them),
	-- so it goes down with each crack; the pile alone did not move while eggs were cracked at the nests
	local pileText = if final then "FINAL TIME" elseif m then (uncracked(m) .. " to hatch") else ""
	if pileText ~= refs.PileText.Text then
		local flip = not final and refs.PileText.Text ~= "" and refs.PileText.Text ~= "FINAL TIME" and refs.Timer.Visible
		refs.PileText.Text = pileText
		if flip then
			Juice.flip(refs.PileText) -- the eggs-left number turns over like a counter
		end
	end
	refs.TimerText.TextColor3 = if final then TC.Muted else TC.Gold
	-- "10 EGGS LEFT!" banner: once per hunt, when the uncracked count first drops to FEW_EGGS or fewer
	if m and phase == "Searching" and m.SearchStart then
		local pile = uncracked(m)
		-- only when the count really drops past the line (a small pile that starts under it shows no banner)
		if type(pile) == "number" then
			if pile > FEW_EGGS then
				fewArmedFor = m.SearchStart
			elseif pile > 0 and fewArmedFor == m.SearchStart and fewShownFor ~= m.SearchStart then
				fewShownFor = m.SearchStart
				Juice.banner(pile .. (if pile == 1 then " EGG LEFT!" else " EGGS LEFT!"), TC.Gold)
			end
		end
	end
	-- race bar (party hunts): eggs each hunter has cracked this round, from the server's station views only
	for _, c in refs.Roster:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local members = if m then (m.Members or {}) else {}
	refs.Roster.Visible = inMatch and #members > 1
	refs.RosterH = if inMatch and #members > 1 then #members * (RACE_H + 3) + 6 else 0
	if inMatch and #members > 1 then
		local rows = RaceRules.standings(m.Stations, members)
		for i, row in rows do
			local me = row.UserId == player.UserId
			local chip = UI.frame(refs.Roster, { Name = "Racer" .. i, Size = UDim2.fromOffset(LEFT_W, RACE_H), BackgroundColor3 = TC.Hud, BackgroundTransparency = 0.2, LayoutOrder = i })
			UI.corner(chip, 6)
			if me then
				UI.stroke(chip, TC.Gold, 2)
			end
			if row.Leader then
				UI.icon(chip, "crown", 15, { Position = UDim2.fromOffset(4, 1) })
			end
			local nm = UI.text(chip, (if me then "You" else row.Name) .. (if row.Present then "" else " (left)"), {
				Font = UI.Bold, TextSize = T.Tiny, Outline = "Normal", Size = UDim2.new(1, -60, 0, 17), Position = UDim2.fromOffset(22, 0),
				TextColor3 = if row.Present then TC.Text else TC.Faint,
			})
			nm.TextWrapped = false
			nm.TextTruncate = Enum.TextTruncate.AtEnd
			local cnt = UI.text(chip, tostring(row.Cracked), {
				Name = "Count", Font = UI.Head, TextSize = T.Tiny, TextColor3 = TC.Gold, Outline = "Normal",
				AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -5, 0, 0), Size = UDim2.fromOffset(34, 17), TextXAlignment = Enum.TextXAlignment.Right,
			})
			cnt.TextWrapped = false
			local _, fill = UI.bar(chip, { Position = UDim2.new(0, 6, 1, -6), Size = UDim2.new(1, -12, 0, 4) }, if me then TC.Gold else TC.Muted)
			fill.Size = UDim2.fromScale(row.Share, 1)
		end
	end
	if not inMatch then
		refs.Act.Visible = false
		refs.Proc.Visible = false
		refs.QueueCard.Visible = false
		refs.Dock.Visible = false
		refs.Mach.Visible = false
	end
	UI.MaxNotices = if inMatch and phase == "Searching" then 2 else 3 -- keep the nest and the egg in view
	refs.Top.Visible = not blocked
	-- in the pet tower only the tower HUD shows: the lobby columns (coins, bag, PLAY, DAILY, tiles) step aside
	local inTower = (player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true)
	local v2 = lobbyHidden and lobbyUi
	refs.Stats.Visible = not blocked and not inTower and not v2
	refs.Menu.Visible = not blocked and not inTower and not v2
	refs.BagNotice.Visible = inMatch and phase == "Searching" and full and not blocked
	if not inMatch or phase ~= "Searching" or blocked then
		PileView.stopAll()
	end

	local showObjective = true
	if not inMatch then
		local party = State.Party
		if not lobbyUi then
			showObjective = false -- on the way into a hunt: nothing from the lobby
		elseif prof and prof.StarterEgg == true and not party and Hud.cueActive() then
			refs.ObjTitle.Text = "FREE PET!"
			refs.ObjSub.Text = "Tap the glowing egg!" -- the starter egg comes first (StarterEggView)
		elseif prof and prof.TutorialStep == 0 and not party and Hud.cueActive() then
			refs.ObjTitle.Text = "START YOUR FIRST HUNT"
			refs.ObjSub.Text = "Tap PLAY. One egg hides a rare pet!"
			refs.CueShown = true
		elseif party and #party.Members > 1 then
			refs.ObjTitle.Text = "PARTY " .. #party.Members .. "/" .. party.Max
			refs.ObjSub.Text = party.Reason or "Everyone is ready"
		else
			showObjective = false -- the logo says what the game is (lobby mockup)
		end
	else
		if phase == "Countdown" then
			refs.ObjTitle.Text = "GET READY"
		elseif phase == "Searching" then
			refs.ObjTitle.Text = "FIND THE <font color=\"#FFC424\">PET</font>"
			refs.ObjSub.Text = Hud.searchLine(m, PileView.context().Id)
		elseif phase == "RewardPending" then
			refs.ObjTitle.Text = string.upper(m.WinnerName or "Someone") .. " FOUND IT!"
			local mine3 = m.WinnerName == player.DisplayName or m.WinnerName == player.Name
			refs.ObjSub.Text = if mine3 then "Hatching the pet\u{2026}" else "Next time! Hatching their pet\u{2026}"
			if lastObjPhase ~= "RewardPending" and not UI.Reduced then
				-- the winner line slides in from the side instead of popping
				refs.ObjTitle.Position = UDim2.fromOffset(120, 2)
				refs.ObjTitle.TextTransparency = 1
				TweenService:Create(refs.ObjTitle, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.fromOffset(8, 4), TextTransparency = 0 }):Play()
			end
		elseif phase == "Reveal" then
			refs.ObjTitle.Text = string.upper(m.WinnerName or "Someone") .. " FOUND IT!"
			refs.ObjSub.Text = "Pet hatched!"
		elseif phase == "Results" then
			refs.ObjTitle.Text = "HUNT OVER"
			refs.ObjSub.Text = Hud.nextStep()
		end
	end
	lastObjPhase = if inMatch then phase else nil
	refs.ObjInMatch = inMatch
	refs.ObjLayout(inMatch, SafeZones.compactLobby(UI.Logical.X, UI.Logical.Y, UserInputService.TouchEnabled))
	refs.ShowObjective = showObjective
	refs.Objective.Visible = showObjective
	refs.Logo.Visible = false -- owner: no FIND THE PET title in the lobby for now
	refs.PlaceTop()
	Hud.updateHint()
	Hud.tick()
end

-- Hint lifetime (done / timeout, bugs #216, #221) is one rule, shared/HintRules, applied by Main's Hud.hintText before
-- the text gets here; the HUD only decides where the card sits and whether the screen is free for it.

-- One tutorial hint at a time, re-evaluated every tick (it follows what the avatar is doing).
function Hud.updateHint()
	if not refs.Hint then
		return
	end
	local fn = Hud.hintText
	local hint = if fn then fn() else nil
	if hint and State.Match and string.find(hint, "^Basket full") and refs.CarryCard and refs.CarryCard.Visible then
		-- the red CARRIED count and the BASKET FULL button already say it (and the arrow shows the way): no third copy
		hint = nil
	end
	local want = if State.Match then refs.HintTopHolder else refs.HintLow
	if refs.Hint.Parent ~= want and want then
		refs.Hint.Parent = want
	end
	-- in the pet tower the tower HUD owns the top of the screen: no lobby objective or tutorial hint behind it
	local inTower = (player:GetAttribute("InTower") == true or player:GetAttribute("InBattle") == true)
	-- (hidden during the 3-2-1 so the countdown numbers stay clear)
	local counting = State.Match ~= nil and State.Match.Phase == "Countdown"
	local vis = hint ~= nil and hint ~= Hud.hintDismissed and not UI.blocked() and not inTower and not counting
	-- One guidance card at a time: while a tutorial hint shows in the lobby or a hunt search, the objective steps
	-- aside (the hint says what to do); after a hunt it keeps only its title (HUNT OVER), so the stack never covers
	-- the view and two cards never ask for different things.
	local m = State.Match
	local objVis = refs.ShowObjective ~= false and not inTower and not (vis and (m == nil or m.Phase == "Searching"))
	-- the starter-egg line steps aside while the egg and its route arrow are on screen (they say the same thing, and the
	-- top-centre card covered the arch sign over spawn on PC too)
	if objVis and StarterEggView.visible() then
		objVis = false
	end
	local pillMode = refs.ObjPill == true
	local subVis = pillMode or not (vis and m ~= nil)
	local objH = if pillMode then 38 elseif subVis then (refs.ObjFullH or 56) else 34
	if refs.Hint.Visible ~= vis or refs.Objective.Visible ~= objVis or refs.ObjSub.Visible ~= subVis or refs.Objective.Size.Y.Offset ~= objH then
		if vis and not refs.Hint.Visible then
			UI.pop(refs.Hint, 0.85) -- the hint bar pops in instead of just appearing
		end
		refs.Hint.Visible = vis
		refs.Objective.Visible = objVis
		refs.ObjSub.Visible = subVis
		refs.Objective.Size = if pillMode then UDim2.fromOffset(refs.ObjPillW or (LEFT_W + 24), objH) else UDim2.new(1, 0, 0, objH)
		refs.PlaceTop()
	end
	if hint and refs.HintText.Text ~= hint then
		refs.HintText.Text = hint
	end
end

local _ = C
return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="353">
            <Properties>
              <string name="Name">HudArt</string>
              <string name="Source"><![CDATA[--!strict
-- Lobby HUD art (owner mockup 2026-10-12, docs: /mnt/project-files/reference/ui/lobby_hud_mockup.png).
-- One table of picture slots for the HUD buttons. Each slot starts with id 0 and draws a stand-in: the procedural
-- UI.icon when one exists, else an emoji. To use the owner's pictures, upload each PNG in Studio and paste its id
-- into Image below (REPLACE markers). Each slot names its picture in /mnt/project-files/reference/ui/icons/.
-- Nothing else needs to change.
-- Also: HudArt.bigButton, the chunky left-column button (picture, bubble title, small caption pill).

local ContentProvider = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService")

local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)

local T = UI.T
local TC = Theme.Color
local HudArt = {}

export type Slot = { Image: string, Icon: string?, Emoji: string, Badge: string? }

HudArt.Slots = {
	-- plain coin (owner upload 2026-10-13); the old icons/coin.png (74874264229011) had a paw on its face
	Coin = { Image = "rbxassetid://115219544717046", Icon = "cash", Emoji = "\u{1FA99}" },
	Egg = { Image = "rbxassetid://103668102240419", Icon = "egg", Emoji = "\u{1F95A}" }, -- icons/egg.png, spotted egg (PLAY)
	Tower = { Image = "rbxassetid://99375195419423", Icon = nil, Emoji = "\u{1F3F0}" }, -- icons/tower.png, castle tower (TOWER)
	Calendar = { Image = "rbxassetid://120813968101346", Icon = "calendar", Emoji = "\u{1F4C5}" }, -- icons/calendar.png (DAILY)
	Paw = { Image = "rbxassetid://95216121363258", Icon = nil, Emoji = "\u{1F43E}" }, -- icons/paw.png (My Pets)
	-- the UPGRADE tile: a pet collar (owner upload 2026-10-14, IMPORT_NOW/icon_upgrade.png) with a small green up-arrow
	-- badge so it reads as "upgrade"; the old icons/hammer.png (98508674379928) was a mining tool
	Hammer = { Image = "rbxassetid://102877925830559", Icon = "boostLuck", Emoji = "\u{2B06}\u{FE0F}", Badge = "up" },
	Party = { Image = "rbxassetid://119307883183320", Icon = "party", Emoji = "\u{1F465}" }, -- icons/party.png, party people (Party)
	Gear = { Image = "rbxassetid://120609709962908", Icon = "gear", Emoji = "\u{2699}\u{FE0F}" }, -- icons/gear.png (Settings)
	Camera = { Image = "rbxassetid://95284429074133", Icon = "camera", Emoji = "\u{1F4F7}" }, -- icons/camera.png (photo button)
	-- The logo picture should carry the "One egg hides a rare pet!" line itself; the text stand-in draws both.
	-- Low-poly button icons (polish #72, rendered from the game's own models): for buttons that only had words
	IconPlay = { Image = "rbxassetid://123009599855834", Icon = "egg", Emoji = "\u{1F95A}" }, -- Icon_Play
	IconDaily = { Image = "rbxassetid://115944751580313", Icon = "calendar", Emoji = "\u{1F381}" }, -- Icon_Daily (gift)
	IconTower = { Image = "rbxassetid://89508066417725", Icon = nil, Emoji = "\u{1F3F0}" }, -- Icon_Tower
	IconPets = { Image = "rbxassetid://71060132379263", Icon = nil, Emoji = "\u{1F43E}" }, -- Icon_Pets (paw)
	-- REPLACE: Icon_PetBook. The upload 86197129278145 showed as a plain blue square in Studio (Book tab and the
	-- PET BOOK header), so the drawn book stands in until a working id for icons/Icon_PetBook is pasted here
	IconPetBook = { Image = "rbxassetid://0", Icon = "book", Emoji = "\u{1F4D8}" },
	IconShop = { Image = "rbxassetid://104340058683648", Icon = "cash", Emoji = "\u{1FA99}" }, -- Icon_Shop (coin)
	IconSettings = { Image = "rbxassetid://83896590237238", Icon = "gear", Emoji = "\u{2699}\u{FE0F}" }, -- Icon_Settings
	IconLeaderboard = { Image = "rbxassetid://108477862918584", Icon = nil, Emoji = "\u{1F3C6}" }, -- Icon_Leaderboard
	-- Pet Book zone tabs (polish #66, low-poly renders); keyed by zone name. All = the Pets paw, Tower = the tower.
	TabAll = { Image = "rbxassetid://71060132379263", Icon = nil, Emoji = "\u{1F43E}" }, -- Tab_All
	TabMeadow = { Image = "rbxassetid://73889450063316", Icon = nil, Emoji = "\u{1F33C}" }, -- Tab_Meadow
	TabForest = { Image = "rbxassetid://77721269403352", Icon = nil, Emoji = "\u{1F332}" }, -- Tab_Forest
	TabSnow = { Image = "rbxassetid://105292673580149", Icon = nil, Emoji = "\u{2744}\u{FE0F}" }, -- Tab_Snow
	TabVolcano = { Image = "rbxassetid://95614141244341", Icon = nil, Emoji = "\u{1F30B}" }, -- Tab_Volcano
	TabSpace = { Image = "rbxassetid://70553344841939", Icon = nil, Emoji = "\u{1FA90}" }, -- Tab_Space
	TabTower = { Image = "rbxassetid://89508066417725", Icon = nil, Emoji = "\u{1F3F0}" }, -- Tab_Tower (no Tower section in the Book yet)
	TabFavorites = { Image = "rbxassetid://101374665155273", Icon = nil, Emoji = "\u{2B50}" }, -- Tab_Favorites (FAVS filter)
	-- SETTINGS row icons (reference/ui/settings/); Camera Sensitivity reuses Camera above
	Music = { Image = "rbxassetid://97371583022210", Icon = "music", Emoji = "\u{1F3B5}" }, -- settings/icon_music.png
	Sound = { Image = "rbxassetid://105745506130146", Icon = "speaker", Emoji = "\u{1F50A}" }, -- settings/icon_sound.png
	Motion = { Image = "rbxassetid://91756220886385", Icon = "motion", Emoji = "\u{1F6B6}" }, -- settings/icon_reduce_motion.png
	Sparkle = { Image = "rbxassetid://102842945119030", Icon = "sparkle", Emoji = "\u{2728}" }, -- settings/icon_low_effects.png
	Bulb = { Image = "rbxassetid://140183110000190", Icon = "hint", Emoji = "\u{1F4A1}" }, -- settings/icon_hints.png
	Info = { Image = "rbxassetid://100408466405157", Icon = "info", Emoji = "\u{2139}\u{FE0F}" }, -- settings/icon_info.png
	-- START HUNT pieces (reference/ui/start_hunt/)
	EggPink = { Image = "rbxassetid://96034035112982", Icon = "egg", Emoji = "\u{1F95A}" }, -- start_hunt/egg_pink.png (solo card, tab)
	CheckGreen = { Image = "rbxassetid://111089747987064", Icon = nil, Emoji = "\u{2705}" }, -- start_hunt/check_green.png (success toast)
	Logo = { Image = "rbxassetid://0", Icon = nil, Emoji = "" }, -- REPLACE: icons/logo.png, FIND THE PET logo (wide, about 3:1)
} :: { [string]: Slot }

-- Button backgrounds (owner pictures, 2026-10-12), drawn as 9-slice ImageLabels so they stretch to any width. Rect is
-- the picture's opaque area in UPLOADED pixels (Roblox shrinks uploads to 1024 on the long side: the 1983 px wide
-- PNGs are stored 1024 wide, the 1254 px square one 1024), Inset the corner size kept unstretched.
-- While Image is id 0 the button keeps its drawn look (UI.button fill, outline, gloss).
export type Skin = { Image: string, Rect: { number }, Inset: number }

HudArt.Buttons = {
	btn_yellow = { Image = "rbxassetid://85287297082386", Rect = { 25, 66, 973, 275 }, Inset = 103 }, -- icons/btn_yellow.png (PLAY)
	btn_green = { Image = "rbxassetid://138290207229363", Rect = { 25, 48, 973, 306 }, Inset = 114 }, -- icons/btn_green.png (TOWER)
	btn_blue = { Image = "rbxassetid://71058843862567", Rect = { 22, 49, 981, 303 }, Inset = 103 }, -- icons/btn_blue.png (DAILY)
	btn_square_blue = { Image = "rbxassetid://122888270350671", Rect = { 56, 82, 908, 870 }, Inset = 229 }, -- icons/btn_square_blue.png (right tiles)
	coin_pill = { Image = "rbxassetid://89951108537678", Rect = { 20, 48, 983, 262 }, Inset = 136 }, -- icons/coin_pill.png (coin counter)
	-- DAILY panel pieces (reference/ui/daily/, owner 2026-10-12; rects in stored pixels, 1024 on the long side)
	tile_blue = { Image = "rbxassetid://91872036085012", Rect = { 101, 85, 618, 859 }, Inset = 110 }, -- daily/tile_blue.png (day tile)
	tile_gold = { Image = "rbxassetid://81935709573093", Rect = { 88, 83, 644, 866 }, Inset = 110 }, -- daily/tile_gold.png (today)
	tile_cream = { Image = "rbxassetid://109847489698973", Rect = { 90, 93, 640, 843 }, Inset = 110 }, -- daily/tile_cream.png (day 7)
	btn_grey = { Image = "rbxassetid://125874583720932", Rect = { 48, 58, 928, 264 }, Inset = 110 }, -- daily/btn_grey.png (not ready)
	btn_close_x = { Image = "rbxassetid://140480545375801", Rect = { 105, 114, 814, 795 }, Inset = 397 }, -- daily/btn_close_x.png (square, X stays sharp)
	bar_track = { Image = "rbxassetid://89803827523657", Rect = { 36, 134, 952, 73 }, Inset = 36 }, -- daily/bar_track.png
	bar_fill = { Image = "rbxassetid://105957798330697", Rect = { 31, 129, 962, 83 }, Inset = 41 }, -- daily/bar_fill.png
	-- OPEN has its word baked in, so it is drawn whole (ScaleType Fit), not sliced; QuestPanel adds the amount beside it
	btn_open = { Image = "rbxassetid://101506495443942", Rect = { 45, 34, 933, 371 }, Inset = 185 }, -- daily/btn_open.png
	-- Panel / hunt pieces still to be drawn by the owner (2026-10-13); the code already asks for these names:
	-- panel_bg, panel_tab (PanelSkin), settings_row (SETTINGS rows), hunt_card (START HUNT cards),
	-- hud_card (hunt timer / CARRIED / SHELLS cards), slot_blue (hunt hotbar slot). Add each here with its stored-pixel
	-- Rect and Inset once uploaded; until then they are drawn.
} :: { [string]: Skin }

local function hasId(image: string): boolean
	return image ~= "" and (string.match(image, "%d+") or "0") ~= "0"
end

-- Puts a button picture behind `b` (a UI.button, or a plain frame) once its id is set; the drawn fill, outline and
-- gloss step aside. The corners scale with the height (`height`, else b's offset height) so they keep the picture's
-- shape; the middle stretches sideways. A pill's rounded ends take the whole height, so the inset stops at the middle.
function HudArt.skin(b: GuiObject, key: string, height: number?): boolean
	local k = HudArt.Buttons[key]
	if Theme.PetStyle or not k or not hasId(k.Image) then
		return false -- the pet style draws its own buttons and cards (the cream / gold pictures belong to the old look)
	end
	-- the owner's picture wins over the shared kit picture (UI.kitSkin): drop it and keep it from coming back
	local kit = b:FindFirstChild("KitSkin")
	if kit then
		kit:Destroy()
	end
	b:SetAttribute("OwnerSkin", true)
	local r = k.Rect
	local img = Instance.new("ImageLabel")
	img.Name = "Skin"
	img.BackgroundTransparency = 1
	img.Size = UDim2.fromScale(1, 1)
	img.ZIndex = -1 -- under the shine sweep (ZIndex 0) and the captions
	img.Image = k.Image
	img.ImageRectOffset = Vector2.new(r[1], r[2])
	img.ImageRectSize = Vector2.new(r[3], r[4])
	img.ScaleType = Enum.ScaleType.Slice
	local iy = math.min(k.Inset, math.floor(r[4] / 2) - 4)
	img.SliceCenter = Rect.new(k.Inset, iy, r[3] - k.Inset, r[4] - iy)
	img.SliceScale = (height or b.Size.Y.Offset) / r[4]
	img.Parent = b
	b.BackgroundTransparency = 1
	local gloss = b:FindFirstChild("Gloss")
	if gloss then
		gloss:Destroy() -- the picture has its own shine; UI.shine's glint sweep stays on top of it
	end
	-- slow light band drifting across the picture (owner ask 2026-10-12): one looping tween, nothing per frame
	if not UI.Reduced then
		local g = Instance.new("UIGradient")
		g.Name = "Drift"
		g.Rotation = 25
		local dim, hi = Color3.fromRGB(215, 215, 215), Color3.fromRGB(255, 255, 255)
		g.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, dim), ColorSequenceKeypoint.new(0.5, hi), ColorSequenceKeypoint.new(1, dim) })
		g.Offset = Vector2.new(-0.6, 0)
		g.Parent = img
		TweenService:Create(g, TweenInfo.new(2.6 + math.random() * 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Offset = Vector2.new(0.6, 0) }):Play()
	end
	for _, c in b:GetChildren() do
		if c:IsA("UIStroke") then
			c.Enabled = false
		end
	end
	-- hover a touch brighter, disabled grayed (the press squash comes from UI.button)
	local function tint()
		img.ImageColor3 = if b:GetAttribute("Disabled") then Color3.fromRGB(150, 150, 150) elseif b:GetAttribute("Hover") then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(235, 235, 235)
	end
	b:GetAttributeChangedSignal("Disabled"):Connect(tint)
	b:GetAttributeChangedSignal("Hover"):Connect(tint)
	tint()
	return true
end

-- True once a HudArt.Buttons picture has its id.
function HudArt.hasSkin(key: string): boolean
	local k = HudArt.Buttons[key]
	return k ~= nil and hasId(k.Image)
end

-- True once the slot has a real uploaded picture.
function HudArt.has(slot: string): boolean
	local s = HudArt.Slots[slot]
	return s ~= nil and hasId(s.Image)
end

-- What a UI.tabs entry draws for a slot: the uploaded picture's id, else the drawn icon kind, else nothing.
function HudArt.tabPicture(slot: string): string?
	local s = HudArt.Slots[slot]
	if not s then
		return nil
	end
	return if HudArt.has(slot) then s.Image else s.Icon
end

-- Square picture for a slot: the uploaded image, else the procedural icon, else the emoji. Returns the holder.
function HudArt.image(parent: Instance, slot: string, size: number, props: { [string]: any }?): GuiObject
	local s = HudArt.Slots[slot]
	if HudArt.has(slot) then
		local img = Instance.new("ImageLabel")
		img.Name = "Icon"
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromOffset(size, size)
		img.Image = s.Image
		img.ScaleType = Enum.ScaleType.Fit
		for k, v in (props or {}) :: { [string]: any } do
			(img :: any)[k] = v
		end
		img.Parent = parent
		if s.Badge == "up" then
			-- a green circle with a white "+" on the picture's lower right corner (the thin up-arrow glyph read as a
			-- stray mark on a phone)
			local d = math.max(16, math.floor(size * 0.46))
			local badge = Instance.new("Frame")
			badge.Name = "UpBadge"
			badge.AnchorPoint = Vector2.new(1, 1)
			badge.Position = UDim2.new(1, 2, 1, 2)
			badge.Size = UDim2.fromOffset(d, d)
			badge.BackgroundColor3 = Color3.fromRGB(64, 186, 84)
			badge.ZIndex = img.ZIndex + 1
			UI.corner(badge, d // 2)
			UI.stroke(badge, Color3.fromRGB(255, 255, 255), 2)
			local arrow = UI.text(badge, "+", { Name = "Arrow", Font = UI.Head, Size = UDim2.fromScale(1, 1), TextSize = math.floor(d * 0.9), TextXAlignment = Enum.TextXAlignment.Center, Outline = false })
			arrow.TextWrapped = false
			arrow.ZIndex = badge.ZIndex + 1
			badge.Parent = img
		end
		return img
	end
	if s and s.Icon then
		return UI.icon(parent, s.Icon, size, props)
	end
	local g = UI.text(parent, if s then s.Emoji else "?", { Name = "Icon", Size = UDim2.fromOffset(size, size), TextSize = size * 0.8, TextXAlignment = Enum.TextXAlignment.Center, Outline = false })
	g.TextWrapped = false
	for k, v in (props or {}) :: { [string]: any } do
		(g :: any)[k] = v
	end
	return g
end

-- Word pictures (owner's bubble-letter captions): slot "text_<word>", e.g. text_play, text_egg_hunt_race. While a slot
-- is missing or id 0 the normal fitted text shows. Rect = the letters' area in STORED pixels (Roblox keeps uploads at
-- most 1024 px on the long side), so the see-through margin is cropped; leave it out to use the whole picture.
export type Word = { Image: string, Rect: { number }? }

HudArt.Words = {
	text_play = { Image = "rbxassetid://89875527302311", Rect = { 46, 26, 932, 290 } }, -- icons/text_play.png
	text_egg_hunt_race = { Image = "rbxassetid://120944707801640", Rect = { 19, 93, 992, 171 } }, -- icons/text_egg_hunt_race.png
	text_tower = { Image = "rbxassetid://84214979694639", Rect = { 18, 55, 985, 233 } }, -- icons/text_tower.png
	text_pet_battles = { Image = "rbxassetid://134681102183895", Rect = { 19, 68, 997, 186 } }, -- icons/text_pet_battles.png
	text_daily = { Image = "rbxassetid://107024905458130", Rect = { 31, 50, 965, 279 } }, -- icons/text_daily.png
	text_upgrade = { Image = "rbxassetid://112790280058453", Rect = { 19, 43, 989, 265 } }, -- icons/text_upgrade.png
	text_party = { Image = "rbxassetid://117976168232642", Rect = { 28, 47, 979, 338 } }, -- icons/text_party.png
	text_settings = { Image = "rbxassetid://91132635339082", Rect = { 31, 72, 963, 193 } }, -- settings/text_settings.png (owner swap 2026-10-13)
	text_my_pets = { Image = "rbxassetid://0" }, -- REPLACE: icons/text_my_pets.png (picture not made yet; add its Rect)
	-- the lobby Settings tile caption, in the same lettering as text_upgrade / text_party (text_settings above is the
	-- all-caps SETTINGS panel title and looked small and out of place on the tile); plain text until it exists
	text_settings_tile = { Image = "rbxassetid://132909300773968", Rect = { 3, 3, 1020, 155 } }, -- "Settings" like Upgrade
	-- DAILY panel words (reference/ui/daily/); slot names follow the caption text, so two differ from the file names
	text_daily_gift = { Image = "rbxassetid://130529219531710", Rect = { 24, 92, 988, 175 } }, -- daily/text_daily_gift.png
	text_day_7_is_the_big_one = { Image = "rbxassetid://106652209321014", Rect = { 18, 87, 993, 162 } }, -- daily/text_day7_big_one.png
	text_today_s_quests = { Image = "rbxassetid://110000450222400", Rect = { 23, 95, 978, 148 } }, -- daily/text_todays_quests.png
	-- SETTINGS row words (reference/ui/settings/, file = slot name + .png). settings/text_settings.png is a newer copy
	-- of the SETTINGS word above; the uploaded icons/ one stays until the owner swaps it.
	text_music = { Image = "rbxassetid://72628283899221", Rect = { 119, 52, 793, 240 } }, -- settings/text_music.png
	text_sounds = { Image = "rbxassetid://82395505445227", Rect = { 37, 49, 951, 244 } }, -- settings/text_sounds.png
	text_camera_sensitivity = { Image = "rbxassetid://132418772668568", Rect = { 22, 96, 982, 144 } }, -- settings/text_camera_sensitivity.png
	text_reduce_motion = { Image = "rbxassetid://104818690518475", Rect = { 23, 82, 984, 151 } }, -- settings/text_reduce_motion.png
	text_low_effects = { Image = "rbxassetid://108851463070888", Rect = { 20, 86, 989, 181 } }, -- settings/text_low_effects.png
	text_hints = { Image = "rbxassetid://134098200846150", Rect = { 99, 48, 853, 286 } }, -- settings/text_hints.png
	text_skip = { Image = "rbxassetid://115555347320224", Rect = { 55, 61, 918, 294 } }, -- settings/text_skip.png (SETTINGS and hint SKIP buttons)
	text_first_hunt_guide = { Image = "rbxassetid://97113691309913", Rect = { 18, 87, 989, 170 } }, -- settings/text_first_hunt_guide.png
	-- Panel titles and common buttons (ui-50 #50)
	text_upgrades = { Image = "rbxassetid://86763512409354", Rect = { 3, 3, 1020, 143 } }, -- UPGRADES (Upgrades panel tab)
	text_pet_book = { Image = "rbxassetid://134985513090430", Rect = { 3, 3, 1020, 153 } }, -- PET BOOK (Pet Book panel tab)
	text_egg_shop = { Image = "rbxassetid://140406046399302", Rect = { 3, 3, 1020, 152 } }, -- EGG SHOP (Egg Shop panel tab)
	text_pet_tower = { Image = "rbxassetid://89720726468934", Rect = { 2, 2, 1021, 135 } }, -- PET TOWER (Tower panel tab)
	text_buy = { Image = "rbxassetid://71487225037993", Rect = { 7, 7, 1016, 364 } }, -- BUY (list row buttons)
	text_equip = { Image = "rbxassetid://132606053786336", Rect = { 6, 5, 1018, 263 } }, -- EQUIP (list row and detail buttons)
	text_play_again = { Image = "rbxassetid://128295643129855", Rect = { 2, 2, 1021, 129 } }, -- PLAY AGAIN (results)
	text_lobby = { Image = "rbxassetid://84037549662887", Rect = { 5, 5, 1018, 230 } }, -- LOBBY (results)
	-- START HUNT words (reference/ui/start_hunt/, file = slot name + .png); "up to 4" follows Config.Party.MaxSize
	text_start_hunt = { Image = "rbxassetid://113207439376464", Rect = { 24, 105, 981, 143 } }, -- start_hunt/text_start_hunt.png
	text_one_pile_one_pet = { Image = "rbxassetid://84728739832356", Rect = { 13, 93, 1002, 154 } }, -- start_hunt/text_one_pile_one_pet.png
	text_practice_hunt = { Image = "rbxassetid://112929180082685", Rect = { 18, 106, 989, 127 } }, -- start_hunt/text_practice_hunt.png
	text_a_small_pile_to_learn_the_ropes = { Image = "rbxassetid://115723738140463", Rect = { 8, 113, 1009, 107 } }, -- start_hunt/text_a_small_pile_to_learn_the_ropes.png
	text_party_hunt = { Image = "rbxassetid://115143501322966", Rect = { 31, 94, 968, 147 } }, -- start_hunt/text_party_hunt.png
	text_up_to_4_players_one_pet = { Image = "rbxassetid://89221769499641", Rect = { 18, 116, 992, 114 } }, -- start_hunt/text_up_to_4_players_one_pet.png
	text_start = { Image = "rbxassetid://80189452461987", Rect = { 54, 57, 931, 250 } }, -- start_hunt/text_start.png
	text_create_party = { Image = "rbxassetid://84981341306787", Rect = { 11, 99, 1004, 144 } }, -- start_hunt/text_create_party.png
} :: { [string]: Word }

-- success toasts show the owner's green tick once its picture is uploaded; it is fetched now, so the first toast
-- shows it straight away instead of the drawn tick swapping to the picture a moment later
if hasId(HudArt.Slots.CheckGreen.Image) then
	local tick = HudArt.Slots.CheckGreen.Image
	UI.OkPicture = tick
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ tick }, function(_, status)
				if status == Enum.AssetFetchStatus.Success then
					UI.OkPictureReady = true
				end
			end)
		end)
	end)
end

-- every uploaded word picture is fetched at start-up, so the lobby buttons show their words as
-- soon as the HUD appears
task.spawn(function()
	local ids = {}
	for _, w in HudArt.Words do
		if hasId(w.Image) then
			table.insert(ids, w.Image)
		end
	end
	pcall(function()
		ContentProvider:PreloadAsync(ids)
	end)
end)

function HudArt.wordKey(text: string): string
	local k = string.gsub(string.gsub(string.lower(text), "[^%w]+", "_"), "^_*(.-)_*$", "%1")
	return "text_" .. k
end

-- Shows the word picture for whatever `label` says (when that word has one) in place of the label: same box, kept
-- in proportion, left-aligned or centred like the text. Follows later text changes (PLAY -> "PLAY 2/4" shows text).
-- `fill` (0..1, default 1) shrinks the picture inside that box so it keeps a margin from the button's rim.
function HudArt.word(label: TextLabel, fill: number?)
	local parent = label.Parent
	if not parent or Theme.PetStyle then
		return -- the pet style keeps every word as text (the bubble word pictures belong to the old look)
	end
	-- one picture per label: UI.button may already have added it, so a later call only changes the fill
	label:SetAttribute("WordFill", fill or 1)
	if label:GetAttribute("HasWord") then
		return
	end
	label:SetAttribute("HasWord", true)
	local img = Instance.new("ImageLabel")
	img.Name = "WordImage"
	img.BackgroundTransparency = 1
	img.ScaleType = Enum.ScaleType.Fit
	img.ZIndex = label.ZIndex
	img.LayoutOrder = label.LayoutOrder -- takes the label's place when it sits in a list layout
	img.Visible = false
	local ar = Instance.new("UIAspectRatioConstraint")
	ar.AspectType = Enum.AspectType.FitWithinMaxSize
	ar.Parent = img
	img.Parent = parent
	local function update()
		-- a label can name its own slot (WordKey attribute) when the plain word's picture has the wrong style there
		local key = label:GetAttribute("WordKey")
		local w = HudArt.Words[if type(key) == "string" then key else HudArt.wordKey(label.Text)]
		local on = w ~= nil and hasId(w.Image)
		if w and on then
			img.Image = w.Image
			local r = w.Rect
			if r then
				img.ImageRectOffset = Vector2.new(r[1], r[2])
				img.ImageRectSize = Vector2.new(r[3], r[4])
				ar.AspectRatio = r[3] / r[4]
			else
				img.ImageRectOffset = Vector2.zero
				img.ImageRectSize = Vector2.zero
				ar.AspectRatio = 3
			end
			-- anchor on the text's alignment side so the shrunk box stays where the words were
			local ax = if label.TextXAlignment == Enum.TextXAlignment.Left then 0 elseif label.TextXAlignment == Enum.TextXAlignment.Right then 1 else 0.5
			img.AnchorPoint = Vector2.new(ax, 0.5)
			local p, z = label.Position, label.Size
			-- measured from the label's own anchor (a bottom-anchored caption must not drop half a box lower)
			local la = label.AnchorPoint
			local kx, ky = ax - la.X, 0.5 - la.Y
			img.Position = UDim2.new(p.X.Scale + z.X.Scale * kx, p.X.Offset + z.X.Offset * kx, p.Y.Scale + z.Y.Scale * ky, p.Y.Offset + z.Y.Offset * ky)
			local f = (label:GetAttribute("WordFill") :: number?) or 1
			img.Size = UDim2.new(z.X.Scale * f, z.X.Offset * f, z.Y.Scale * f, z.Y.Offset * f)
		end
		-- (gating on IsLoaded kept the plain word up for good in Studio; the word pictures are preloaded instead,
		-- at start-up, so a slow phone does not show an empty tile for long)
		img.Visible = on
		label.Visible = not on
	end
	-- follow the label when its owner moves it after the picture was added (bigButton shifts the title right of
	-- its icon after UI.button made it; without this the word stayed centred under the icon)
	for _, prop in { "Text", "Position", "Size", "AnchorPoint", "TextXAlignment" } do
		label:GetPropertyChangedSignal(prop):Connect(update)
	end
	label:GetAttributeChangedSignal("WordFill"):Connect(update)
	update()
end

export type BigOpts = {
	Name: string,
	Style: string,
	Art: string,
	Skin: string?,
	Title: string,
	Sub: string?,
	Width: number,
	Height: number,
	LayoutOrder: number?,
	OnClick: () -> (),
}

-- Caption pill height of a big button `h` tall, and the gap kept between the title and that pill.
local SUB_GAP = 4
local SUB_BOTTOM = 5 -- gap under the caption pill
local function subPillH(h: number): number
	return math.max(22, math.floor(h * 0.36)) -- tall enough for body-size words (bug #220: "Best floor 4" read tiny)
end

-- Chunky lobby button (mockup): picture on the left, bubble title, caption in a darker pill under it. Uses UI.button,
-- so it keeps the press squash and spring-back bounce, hover, and the touch pad. The title stays the "Label" child.
function HudArt.bigButton(parent: Instance, o: BigOpts): TextButton
	local h = o.Height
	local b = UI.button(parent, o.Title, o.Style, o.OnClick, { Name = o.Name, Size = UDim2.fromOffset(o.Width, h), LayoutOrder = o.LayoutOrder or 0, TextSize = if o.Sub then T.Head + 2 else T.Head })
	UI.corner(b, 14)
	if o.Skin then
		HudArt.skin(b, o.Skin)
	end
	local art = math.floor(h - (if o.Sub then 20 else 12))
	HudArt.image(b, o.Art, art, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), ZIndex = b.ZIndex + 1 })
	local x = art + 10
	local label = b:FindFirstChild("Label") :: TextLabel?
	if label then
		-- title centred in the space right of the picture, clear of the rim (the skin's lip covers the top few pixels)
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.TextWrapped = false
		if o.Sub then
			-- the title ends a clear gap above the caption pill (bubble letters touched the pill and read as overlapping)
			local top = math.floor(h * 0.08)
			label.Position = UDim2.fromOffset(x, top)
			label.Size = UDim2.new(1, -(x + 10), 0, h - subPillH(h) - SUB_BOTTOM - SUB_GAP - top)
		else
			label.Position = UDim2.fromOffset(x, math.floor(h * 0.14))
			label.Size = UDim2.new(1, -(x + 10), 1, -math.floor(h * 0.28))
		end
		HudArt.word(label, if o.Sub then 0.9 else 0.94)
	end
	if o.Sub then
		local ph = subPillH(h)
		local pill = UI.frame(b, { Name = "SubPill", Position = UDim2.new(0, x - 4, 1, -(ph + SUB_BOTTOM)), Size = UDim2.new(1, -(x + 6), 0, ph), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.78 })
		UI.corner(pill, ph // 2)
		local st = UI.styleOf(o.Style)
		local sub = UI.text(pill, o.Sub, { Name = "Sub", Font = UI.Bold, TextSize = T.Body, TextColor3 = if st == "gold" then TC.DarkText else TC.Text, Outline = if st == "gold" then false else "Normal", Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0), TextXAlignment = Enum.TextXAlignment.Center })
		sub.TextWrapped = false
		UI.fit(sub, T.Body, T.MinText)
		sub.TextWrapped = false
		HudArt.word(sub, 0.84)
		HudArt.fitSub(b)
		UI.Resized.Event:Connect(function()
			if b.Parent then
				HudArt.fitSub(b)
			end
		end)
	end
	return b
end

-- The caption pill shows only where it can hold its words at the text floor (12 real px: UI.fit's minimum at the
-- current scale). On a short screen (under 420 logical px tall) a pill too thin for that is hidden rather than its
-- words shrunk under the floor. The pill remembers the verdict (TooShort) so HudArt.compact never shows it again.
function HudArt.fitSub(b: GuiObject)
	local pill = b:FindFirstChild("SubPill") :: GuiObject?
	local sub = if pill then pill:FindFirstChild("Sub") :: TextLabel? else nil
	if not pill or not sub then
		return
	end
	local fit = sub:FindFirstChild("Fit") :: UITextSizeConstraint?
	local lo = if fit then fit.MinTextSize else T.MinText
	local tooShort = UI.Logical.Y < 420 and pill.Size.Y.Offset < lo * 1.2 + 2
	pill:SetAttribute("TooShort", tooShort)
	if tooShort then
		pill.Visible = false
	elseif pill:GetAttribute("Compact") ~= true then
		pill.Visible = true
	end
end

-- puts the full title back after the square tile's short word (HudArt.compact)
function HudArt.restoreText(label: TextLabel?)
	local home = if label then label:GetAttribute("HomeText") else nil
	if label and type(home) == "string" then
		label.Text = home
	end
end

-- Compact form of a big button for the touch rows (narrow cells, SafeZones.lobbyLayout): the caption pill is hidden,
-- the picture shrinks (and goes when the cell is under 100 px), and the title alone fills the rest. `on = false`
-- restores the layout bigButton made. Works on the button itself; PlayButton's wrapper passes its children.
function HudArt.compact(b: GuiObject, on: boolean, w: number, h: number)
	local label = b:FindFirstChild("Label") :: TextLabel?
	local icon = b:FindFirstChild("Icon") :: GuiObject?
	local pill = b:FindFirstChild("SubPill") :: GuiObject?
	if label and label:GetAttribute("HomePos") == nil then
		label:SetAttribute("HomePos", label.Position)
		label:SetAttribute("HomeSize", label.Size)
		label:SetAttribute("HomeAlign", label.TextXAlignment)
	end
	if icon and icon:GetAttribute("HomeSize") == nil then
		icon:SetAttribute("HomeSize", icon.Size)
		icon:SetAttribute("HomePos", icon.Position)
		icon:SetAttribute("HomeAnchor", icon.AnchorPoint)
	end
	if pill then
		pill:SetAttribute("Compact", on)
		pill.Visible = not on and pill:GetAttribute("TooShort") ~= true
	end
	if on and w <= h + 8 then
		-- square tile (landscape phone row, 2026-10-15): the picture centred in the top part, the one word along the
		-- bottom edge, full width, never wrapped (the fitted text goes down to the 12 px floor, not under it)
		local a = math.max(16, h - 32)
		if icon then
			icon.Visible = true
			icon.Size = UDim2.fromOffset(a, a)
			icon.AnchorPoint = Vector2.new(0.5, 0)
			icon.Position = UDim2.new(0.5, 0, 0, 3)
		end
		if label then
			-- a 24 px word box: about 20 real px at the phone scale (12 read tiny in the Studio phone window)
			label.Position = UDim2.new(0, 1, 1, -26)
			label.Size = UDim2.new(1, -2, 0, 24)
			label.TextXAlignment = Enum.TextXAlignment.Center
			label.TextWrapped = false
			-- a tile is too narrow for TOWER / BATTLE at the text floor (fitted text wraps mid-word), so the button's
			-- short word (Short attribute: TRAIN, FIGHT) takes over while it is square
			local short = b:GetAttribute("Short")
			if type(short) == "string" then
				if label:GetAttribute("HomeText") == nil then
					label:SetAttribute("HomeText", label.Text)
				end
				label.Text = short
			end
		end
	elseif on then
		HudArt.restoreText(label)
		local showIcon = w >= 100
		local a = if showIcon then math.max(16, h - 16) else 0
		if icon then
			icon.Visible = showIcon
			icon.Size = UDim2.fromOffset(a, a)
			icon.AnchorPoint = icon:GetAttribute("HomeAnchor") :: Vector2
			icon.Position = icon:GetAttribute("HomePos") :: UDim2
		end
		if label then
			local x = if showIcon then a + 10 else 8
			label.Position = UDim2.fromOffset(x, math.floor(h * 0.14))
			label.Size = UDim2.new(1, -(x + 8), 1, -math.floor(h * 0.28))
			label.TextXAlignment = label:GetAttribute("HomeAlign") :: Enum.TextXAlignment
			label.TextWrapped = false
		end
	else
		HudArt.restoreText(label)
		if icon then
			icon.Visible = true
			icon.Size = icon:GetAttribute("HomeSize") :: UDim2
			icon.AnchorPoint = icon:GetAttribute("HomeAnchor") :: Vector2
			icon.Position = icon:GetAttribute("HomePos") :: UDim2
		end
		if label then
			label.Position = label:GetAttribute("HomePos") :: UDim2
			label.Size = label:GetAttribute("HomeSize") :: UDim2
			label.TextXAlignment = label:GetAttribute("HomeAlign") :: Enum.TextXAlignment
		end
	end
end

-- any UI.button whose word has an uploaded picture (BUY, EQUIP, PLAY AGAIN...) shows it; others stay text
UI.ButtonWord = function(label: TextLabel)
	local w = HudArt.Words[HudArt.wordKey(label.Text)]
	if w and hasId(w.Image) then
		HudArt.word(label, 0.8)
	end
end

return HudArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="354">
            <Properties>
              <string name="Name">InspectPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Read-only inspect card for a specimen in someone's lobby gallery. Opened by the server's
-- "Inspect" event (a visitor pressed Inspect on a displayed geode). It only looks: the one
-- button closes it. Selling, moving or displaying belongs to the owner's own Collection.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PetRules = require(Shared.PetRules)
local Net = require(Shared.Net)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local PanelSkin = require(script.Parent.PanelSkin)
local PetStyle = require(script.Parent.PetStyle)
local GeodeView = require(script.Parent.GeodeView)

local C = UI.Colors
local PET = Theme.Pet
local Inspect = {}

-- card = { Owner = display name, IsYou = boolean, Specimen = public specimen }
function Inspect.show(card)
	if type(card) ~= "table" or type(card.Specimen) ~= "table" or State.Match then
		return -- never over a hunt
	end
	local g = card.Specimen
	local owner = tostring(card.Owner or "Someone")
	local inspectPanel, b, close, footer = UI.modal("Inspect", "INSPECT", Vector2.new(560, 330), { Fixed = true, Footer = 58 })
	PanelSkin.dress(inspectPanel, "Paw", "INSPECT")
	-- the pet in a rounded pet-style frame: white into the clip's light card blue, a soft blue edge and a thin
	-- rarity-coloured ring just inside it (the rarity still shows at a glance)
	local rarityColor: Color3 = Config.RarityColors[g.Rarity] or C.Rock
	local frame = UI.frame(b, { Name = "PetFrame", Position = UDim2.fromOffset(0, 0), Size = UDim2.new(0.44, 0, 1, 0), BackgroundColor3 = PET.White, BackgroundTransparency = 0 })
	PetStyle.round(frame, 18)
	PetStyle.edge(frame, PET.QuestEdge, 3)
	PetStyle.vgrad(frame, PET.White, PET.QuestBody)
	PetStyle.pattern(frame, PET.QuestEdge, 0.8, 30, 240, 240, 60)
	local ring = UI.frame(frame, { Name = "RarityRing", Position = UDim2.fromOffset(5, 5), Size = UDim2.new(1, -10, 1, -10), BackgroundTransparency = 1 })
	PetStyle.round(ring, 14)
	PetStyle.edge(ring, rarityColor, 2)
	local view = GeodeView.make(frame, g, { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 1, -16), BackgroundTransparency = 1 }, true)
	view.Name = "Specimen"
	local info = UI.frame(b, { Position = UDim2.new(0.44, 12, 0, 0), Size = UDim2.new(0.56, -12, 1, 0), BackgroundTransparency = 1 })
	UI.list(info, Enum.FillDirection.Vertical, 6)
	UI.text(info, PetRules.label(g), { Font = UI.Head, TextSize = UI.T.Title, LayoutOrder = 1 })
	local chip = UI.chip(info, g.Rarity, Config.RarityColors[g.Rarity] or C.Rock, { Size = UDim2.fromOffset(110, 26), LayoutOrder = 2 })
	chip.Name = "Rarity"
	UI.text(info, string.format("%s · %.2f kg", Config.FormationNames[g.Formation] or g.Formation, g.Mass), { TextSize = UI.T.Body, TextColor3 = C.Muted, LayoutOrder = 3 })
	if type(card.Power) == "number" then
		-- a pet following its owner (tap-to-inspect): its battle power and level, the reason to want one like it
		local stars = string.rep("\u{2605}", tonumber(card.Evolve) or 0)
		-- a glossy lime pill with white outlined words (the clip's price / claim pill)
		local pill = UI.frame(info, { Name = "PowerPill", Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = PET.Lime, LayoutOrder = 4 })
		PetStyle.round(pill, 999)
		PetStyle.vgrad(pill, PET.LimeTop, PET.Lime)
		PetStyle.edge(pill, PET.LimeEdge, 2.5)
		PetStyle.words(pill, string.format("\u{26A1} %s  ·  Lv %d/%d %s", UI.num(card.Power), card.Level or 1, card.Cap or 1, stars), UI.T.Head, {
			Name = "Power", Font = UI.Head, Size = UDim2.new(1, -20, 1, -6), Position = UDim2.fromOffset(10, 3),
			TextXAlignment = Enum.TextXAlignment.Center, OutlineColor = PET.LimeEdge, OutlineThick = 2.4,
		})
	else
		UI.text(info, "Value " .. UI.money(g.Value) .. (if g.Solo then " · solo find" else ""), { TextSize = UI.T.Body, TextColor3 = C.Muted, LayoutOrder = 4 })
	end
	local who = if type(card.Where) == "string" then card.Where
		elseif card.IsYou then "On display in your gallery" else "On display in " .. owner .. "'s gallery"
	UI.text(info, who, { TextSize = UI.T.Body, Font = UI.Head, TextColor3 = PET.TitleEdge, Outline = false, LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 44) }) -- two lines on an upright phone
	UI.text(info, "Look only. Drag to turn it.", {
		TextSize = UI.T.Small, TextColor3 = C.Muted, LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 22),
	})
	if footer then
		UI.button(footer, "CLOSE", "gray", close, { Size = UDim2.new(1, 0, 1, 0), TextSize = UI.T.Head })
	end
end

function Inspect.start()
	Net.event("Inspect").OnClientEvent:Connect(function(card)
		Inspect.show(card)
	end)
end

return Inspect
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="355">
            <Properties>
              <string name="Name">ItemView</string>
              <string name="Source"><![CDATA[--!strict
-- 3D picture of a shop item (hand tool or machine) in a ViewportFrame.
-- Source order: ReplicatedStorage.Assets.Kit.<name> (Blender kit model, when marked Ready), then
-- ReplicatedStorage.Assets.Previews.<id> (the Part / uploaded-mesh model the server builds from the
-- same factories as the world, see server/PreviewKit), then a drawn icon. Never an invented asset.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)

local ItemView = {}

local GearKit = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GearKit")) -- Gear_<Id> first, old names after
local FALLBACK_ICON = {
	Hammer = "boostLuck", SteelHammer = "boostCoins", Jackhammer = "boostSpeed",
	AutoCracker = "queue", HydraulicPress = "egg", IndustrialCrusher = "sparkle",
}

local TOOLS = { Hammer = true, SteelHammer = true, Jackhammer = true }

-- Shop-picture finish for the upgrade tools (Studio: the Golden Mallet read as recoloured wood, the Rainbow Tapper
-- as a plain grey drill). Only untextured parts are tinted, so a real textured mesh keeps its own look; the handle,
-- grip rubber and drill bit stay as they are. Picture only: the held tool is untouched.
local GOLD = Color3.fromRGB(255, 196, 46)
local function finish(model: Instance, id: string)
	if id ~= "SteelHammer" and id ~= "Jackhammer" then
		return
	end
	local parts: { BasePart } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 and d:FindFirstChildOfClass("SurfaceAppearance") == nil
			and not (d:IsA("MeshPart") and d.TextureID ~= "") then
			local n = string.lower(d.Name)
			if not (string.find(n, "wood") or string.find(n, "rubber") or string.find(n, "grip") or string.find(n, "handle") or n == "bit") then
				table.insert(parts, d)
			end
		end
	end
	table.sort(parts, function(a, b)
		return a.Position.Y > b.Position.Y
	end)
	for i, p in parts do
		if id == "SteelHammer" then
			p.Color = GOLD:Lerp(Color3.fromRGB(255, 236, 140), if string.find(string.lower(p.Name), "light") then 0.45 else 0)
			p.Material = Enum.Material.Metal
			p.Reflectance = 0.15
		else
			p.Color = Color3.fromHSV(((i - 1) / math.max(#parts, 1)) * 0.85, 0.75, 1)
			p.Material = Enum.Material.SmoothPlastic
		end
	end
end

local function template(id: string): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		return nil
	end
	local kit = assets:FindFirstChild("Kit")
	if kit then
		for _, n in GearKit.kitNames(id) do
			local m = kit:FindFirstChild(n)
			if m and m:IsA("Model") and m:GetAttribute("Ready") then
				return m
			end
		end
	end
	local pv = assets:FindFirstChild("Previews")
	local m = pv and pv:FindFirstChild(id)
	if m and m:IsA("Model") then
		return m
	end
	return nil
end

-- Returns the viewport, or a drawn icon frame when no model exists. `props` go to the container.
-- `iconSize` sizes the drawn fallback icon to the slot (a fixed 56 spilled out of the smaller shop-row thumbs).
function ItemView.make(parent: Instance, id: string, props: { [string]: any }?, iconSize: number?): GuiObject
	local src = template(id)
	if not src then
		local holder = UI.frame(parent, { BackgroundTransparency = 1 })
		if props then
			for k, v in props do
				(holder :: any)[k] = v
			end
		end
		UI.icon(holder, FALLBACK_ICON[id] or "star", iconSize or 56, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		return holder
	end
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(170, 166, 160)
	vp.LightColor = Color3.fromRGB(255, 244, 228)
	vp.LightDirection = Vector3.new(-0.4, -0.6, 0.7)
	if props then
		for k, v in props do
			(vp :: any)[k] = v
		end
	end
	vp.Parent = parent
	local world = Instance.new("WorldModel")
	world.Parent = vp
	local model = src:Clone()
	finish(model, id)
	-- "Jackhammer" (Rainbow Tapper) has a lower-case h: it missed the tool pose and showed flat and small
	local isTool = TOOLS[id] == true
	-- tools stand diagonally like the sheet; machines face the camera (front is -Z)
	local turn = if isTool then CFrame.Angles(0, math.rad(-30), math.rad(32)) else CFrame.Angles(0, math.rad(-24), 0)
	model.Parent = world
	model:PivotTo(turn)
	local cf, size = model:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.Parent = vp
	vp.CurrentCamera = cam
	local radius = size.Magnitude / 2 * 0.95
	local dist = radius / math.tan(math.rad(35 / 2))
	cam.FieldOfView = 35
	local target = cf.Position
	cam.CFrame = CFrame.lookAt(target + Vector3.new(0, math.sin(math.rad(14)) * dist, -math.cos(math.rad(14)) * dist), target)
	return vp
end

return ItemView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="356">
            <Properties>
              <string name="Name">Juice</string>
              <string name="Source"><![CDATA[--!strict
-- Client-only UI juice shared by the panels: big pop-in banners ("10 EGGS LEFT!"), confetti and coin bursts, a
-- checkmark stamp, a waiting shake, and a slow turntable for 3D pet cards. Presentation only: nothing here sends
-- anything to the server or reads anything the server has not already shown the player.
-- Every effect cleans itself up (Debris), keeps its particle count small, and respects Reduce Motion (UI.Reduced).

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UiMotion = require(Shared.UiMotion)
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local UiJuice = require(script.Parent.UiJuice)

local TC = Theme.Color

local Juice = {}

-- Logical centre of `src` inside its own ScreenGui (the layers carry a UIScale, so absolute pixels are divided
-- back by it). Effects are parented to that ScreenGui so they fly over scrollers and panel edges.
local function anchor(src: GuiObject): (ScreenGui?, Vector2)
	local sg = src:FindFirstAncestorOfClass("ScreenGui")
	if not sg then
		return nil, Vector2.zero
	end
	local sc = if UI.Scale > 0 then UI.Scale else 1
	local c = src.AbsolutePosition + src.AbsoluteSize / 2 - sg.AbsolutePosition
	return sg, c / sc
end

local function fxLayer(sg: ScreenGui): Frame
	local f = Instance.new("Frame")
	f.Name = "Juice"
	f.BackgroundTransparency = 1
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = 50
	f.Parent = sg
	return f
end

-- Big pop-in banner across the upper middle of the screen (notice layer): springs in, holds, fades.
function Juice.banner(text: string, color: Color3?, hold: number?)
	local root = UI.noticeLayer()
	local old = root:FindFirstChild("JuiceBanner")
	if old then
		old:Destroy()
	end
	local f = UI.frame(root, {
		Name = "JuiceBanner", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.new(0.9, 0, 0, 64), BackgroundTransparency = 1, ZIndex = 40,
	})
	local lim = Instance.new("UISizeConstraint")
	lim.MaxSize = Vector2.new(560, 64)
	lim.Parent = f
	local l = UI.text(f, text, { Name = "Text", Font = UI.Head, TextSize = 48, TextColor3 = color or TC.Gold, Outline = "Strong", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 41 })
	l.TextWrapped = false
	l.Rotation = if UI.Reduced then 0 else -4
	UI.pop(f, 0.3)
	if not UI.Reduced then
		TweenService:Create(l, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	end
	local stay = hold or 1.8
	task.delay(stay, function()
		if not f.Parent then
			return
		end
		local info = TweenInfo.new(0.3)
		TweenService:Create(l, info, { TextTransparency = 1 }):Play()
		local o = l:FindFirstChild("Outline")
		if o and o:IsA("UIStroke") then
			TweenService:Create(o, info, { Transparency = 1 }):Play()
		end
	end)
	Debris:AddItem(f, stay + 0.4)
end

-- One flying piece: up and out with an ease out, then down with an ease in, spinning and fading.
local function fling(layer: Frame, piece: GuiObject, from: Vector2, dx: number, up: number, fall: number, life: number)
	piece.AnchorPoint = Vector2.new(0.5, 0.5)
	piece.Position = UDim2.fromOffset(from.X, from.Y)
	piece.Parent = layer
	local top = from + Vector2.new(dx * 0.6, -up)
	local a = TweenService:Create(piece, TweenInfo.new(life * 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.fromOffset(top.X, top.Y), Rotation = piece.Rotation + dx,
	})
	a.Completed:Connect(function()
		if piece.Parent then
			local props: { [string]: any } = { Position = UDim2.fromOffset(from.X + dx, top.Y + fall), Rotation = piece.Rotation + dx * 2 }
			if piece:IsA("Frame") then
				props.BackgroundTransparency = 1
			end
			TweenService:Create(piece, TweenInfo.new(life * 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), props):Play()
		end
	end)
	a:Play()
end

-- Confetti from the centre of `src` (at most 24 pieces, gone after ~1.3 s).
function Juice.confetti(src: GuiObject, count: number?)
	if UI.Reduced then
		return
	end
	local sg, at = anchor(src)
	if not sg then
		return
	end
	local layer = fxLayer(sg)
	local colors = Theme.Fx.Confetti
	for i = 1, math.min(count or 20, 24) do
		local p = Instance.new("Frame")
		p.BorderSizePixel = 0
		p.Size = UDim2.fromOffset(math.random(6, 10), math.random(10, 15))
		p.BackgroundColor3 = colors[(i - 1) % #colors + 1]
		p.Rotation = math.random(0, 180)
		p.ZIndex = 51
		fling(layer, p, at, math.random(-130, 130), math.random(60, 140), math.random(120, 200), 1.1 + math.random() * 0.2)
	end
	Debris:AddItem(layer, 1.5)
end

-- A burst of small coins from `src` (at most 10).
function Juice.coins(src: GuiObject, count: number?)
	if UI.Reduced then
		return
	end
	local sg, at = anchor(src)
	if not sg then
		return
	end
	local layer = fxLayer(sg)
	for _ = 1, math.min(count or 8, 10) do
		local c = UI.icon(layer, "cash", 20, { ZIndex = 51 })
		fling(layer, c, at, math.random(-90, 90), math.random(40, 100), math.random(60, 110), 0.9 + math.random() * 0.2)
	end
	Debris:AddItem(layer, 1.2)
end

-- "+50"-style number pop-up: springs in big over `src`, floats up and fades (simulator reward numbers).
function Juice.floatText(src: GuiObject, text: string, color: Color3?)
	local sg, at = anchor(src)
	if not sg then
		return
	end
	local layer = fxLayer(sg)
	local l = UI.text(layer, text, {
		Name = "FloatText", Font = UI.Head, TextSize = 30, TextColor3 = color or TC.Gold, Outline = "Strong",
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(at.X, at.Y), Size = UDim2.fromOffset(160, 36),
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 52,
	})
	l.TextWrapped = false
	if UI.Reduced then
		Debris:AddItem(layer, 1)
		return
	end
	l.Rotation = math.random(-8, 8)
	UI.pop(l, 0.3)
	local rise = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	-- the layer starts under Roblox's top bar (IgnoreGuiInset off): a pop near the top (the coin pill) floats down
	-- instead of up, so it never draws over the Roblox menu and chat buttons
	local endY = if at.Y - 56 < 22 then at.Y + 40 else at.Y - 56
	TweenService:Create(l, rise, { Position = UDim2.fromOffset(at.X + math.random(-12, 12), endY) }):Play()
	task.delay(0.55, function()
		if not l.Parent then
			return
		end
		local fade = TweenInfo.new(0.35)
		TweenService:Create(l, fade, { TextTransparency = 1 }):Play()
		local o = l:FindFirstChild("Outline")
		if o and o:IsA("UIStroke") then
			TweenService:Create(o, fade, { Transparency = 1 }):Play()
		end
	end)
	Debris:AddItem(layer, 1.1)
end

-- Spinning sun rays behind `target` (a reward card or prize icon), gone after `life` seconds (default 2.5).
-- Parented beside the target, one ZIndex below it, so the target stays on top.
function Juice.rays(target: GuiObject, color: Color3?, life: number?)
	if UI.Reduced or not target.Parent then
		return
	end
	local span = math.max(target.AbsoluteSize.X, target.AbsoluteSize.Y) / (if UI.Scale > 0 then UI.Scale else 1) * 1.9
	local hub = Instance.new("Frame")
	hub.Name = "Rays"
	hub.BackgroundTransparency = 1
	hub.AnchorPoint = Vector2.new(0.5, 0.5)
	hub.Position = UDim2.new(target.Position.X.Scale, target.Position.X.Offset + target.Size.X.Offset * (0.5 - target.AnchorPoint.X),
		target.Position.Y.Scale, target.Position.Y.Offset + target.Size.Y.Offset * (0.5 - target.AnchorPoint.Y))
	hub.Size = UDim2.fromOffset(span, span)
	hub.ZIndex = target.ZIndex - 1
	for i = 0, 7 do
		local ray = Instance.new("Frame")
		ray.BorderSizePixel = 0
		ray.BackgroundColor3 = color or TC.Gold
		ray.AnchorPoint = Vector2.new(0.5, 0.5)
		ray.Position = UDim2.fromScale(0.5, 0.5)
		ray.Size = UDim2.new(1, 0, 0, math.max(span * 0.09, 8))
		ray.Rotation = i * 22.5
		ray.ZIndex = hub.ZIndex
		local g = Instance.new("UIGradient")
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		})
		g.Parent = ray
		ray.Parent = hub
	end
	hub.Parent = target.Parent
	UI.pop(hub, 0.2)
	local t = life or 2.5
	TweenService:Create(hub, TweenInfo.new(t, Enum.EasingStyle.Linear), { Rotation = Theme.Loop.RaysSpin * t }):Play()
	task.delay(math.max(t - 0.4, 0), function()
		for _, r in hub:GetChildren() do
			if r:IsA("Frame") then
				TweenService:Create(r, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			end
		end
	end)
	Debris:AddItem(hub, t)
end

-- A green checkmark stamp slammed onto `target` (springs down from big, tilted), stays with the target.
function Juice.stamp(target: GuiObject)
	local old = target:FindFirstChild("Stamp")
	if old then
		old:Destroy()
	end
	local s = UI.frame(target, {
		Name = "Stamp", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = TC.Green, Rotation = -12, ZIndex = target.ZIndex + 10,
	})
	UI.corner(s, 20)
	UI.stroke(s, TC.GreenDeep, 3)
	UI.icon(s, "check", 26, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = s.ZIndex + 1 })
	if UI.Reduced then
		return
	end
	local sc = UI.squashScale(s)
	sc.Scale = 2.4
	UI.spring(sc, { 0.5, 5 }, { Scale = 1 })
end

-- Waiting shake: `obj` wiggles a few degrees every couple of seconds until it leaves the screen.
function Juice.shake(obj: GuiObject)
	if UI.Reduced then
		return
	end
	task.spawn(function()
		while obj.Parent do
			for _, r in { -8, 8, -6, 6, -3, 0 } do
				if not obj.Parent then
					return
				end
				obj.Rotation = r
				task.wait(0.05)
			end
			task.wait(1.6)
		end
	end)
end

-- Turntable for 3D pet cards: the model sways slowly round its starting yaw (±0.5 rad). One shared loop at
-- 12 Hz, at most MAX_TURN viewports at once, only while they are on screen and inside their scroller; a touch on
-- the view pauses it for a few seconds so a drag (GeodeView) is never fought.
local MAX_TURN = 8
type Turn = { Vp: ViewportFrame, Model: Model, Base: CFrame, Phase: number, PauseUntil: number }
local turns: { Turn } = {}
local turnLoop = false

local function onScreen(vp: ViewportFrame): boolean
	if not vp.Visible or vp.AbsoluteSize.X < 2 then
		return false
	end
	local sf = vp:FindFirstAncestorOfClass("ScrollingFrame")
	if sf then
		local a, b = vp.AbsolutePosition, sf.AbsolutePosition
		if a.Y + vp.AbsoluteSize.Y < b.Y or a.Y > b.Y + sf.AbsoluteSize.Y then
			return false
		end
	end
	return true
end

function Juice.turntable(vp: ViewportFrame, model: Model)
	if UI.Reduced or #turns >= MAX_TURN then
		return
	end
	local t: Turn = { Vp = vp, Model = model, Base = model:GetPivot(), Phase = math.random() * 6, PauseUntil = 0 }
	table.insert(turns, t)
	vp.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			t.PauseUntil = os.clock() + 4
		end
	end)
	if turnLoop then
		return
	end
	turnLoop = true
	task.spawn(function()
		while #turns > 0 do
			local now = os.clock()
			for i = #turns, 1, -1 do
				local x = turns[i]
				if x.Vp.Parent == nil or x.Model.Parent == nil then
					table.remove(turns, i)
				elseif now >= x.PauseUntil and not UI.Reduced and onScreen(x.Vp) then
					x.Model:PivotTo(CFrame.Angles(0, math.sin(now * 0.7 + x.Phase) * 0.5, 0) * x.Base)
				end
			end
			task.wait(1 / 12)
		end
		turnLoop = false
	end)
end

-- Counter flip: `label` (its text just changed) drops in from a little above and fades up into place, like a
-- flip counter turning over. The resting position is remembered so a flip mid-flip never drifts.
function Juice.flip(label: TextLabel)
	if UI.Reduced or not label.Parent then
		return
	end
	local base = label:GetAttribute("FlipBase")
	if typeof(base) ~= "UDim2" then
		base = label.Position
		label:SetAttribute("FlipBase", base)
	end
	local home = base :: UDim2
	label.Position = home + UDim2.fromOffset(0, -8)
	label.TextTransparency = 0.7
	local info = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(label, info, { Position = home, TextTransparency = 0 }):Play()
end

-- "No" shake for a locked thing that was tapped: a quick side-to-side jolt (position, so it never fights the
-- press squash scale). Inside a list or grid the layout owns the position, so it jolts by rotation there.
-- Ignored while one is already running.
function Juice.nope(obj: GuiObject)
	if UI.Reduced or obj:GetAttribute("Nope") then
		return
	end
	obj:SetAttribute("Nope", true)
	local parent = obj.Parent
	local laidOut = parent ~= nil and parent:FindFirstChildWhichIsA("UIGridStyleLayout") ~= nil
	local home, turn = obj.Position, obj.Rotation
	task.spawn(function()
		for _, dx in { -7, 7, -5, 5, -2, 0 } do
			if not obj.Parent then
				return
			end
			if laidOut then
				obj.Rotation = turn + dx * 0.8
			else
				obj.Position = home + UDim2.fromOffset(dx, 0)
			end
			task.wait(0.04)
		end
		obj.Position = home
		obj.Rotation = turn
		obj:SetAttribute("Nope", nil)
	end)
end

-- One full turn of a coin icon when coins arrive (the readout's own bump is separate). Rotation only.
function Juice.spin(obj: GuiObject)
	if UI.Reduced or obj:GetAttribute("Spinning") then
		return
	end
	obj:SetAttribute("Spinning", true)
	obj.Rotation = 0
	local tw = TweenService:Create(obj, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = 360 })
	tw.Completed:Connect(function()
		obj.Rotation = 0
		obj:SetAttribute("Spinning", nil)
	end)
	tw:Play()
end

-- List rows slide in from the right one after another (`order` = 1, 2, ...). Rows inside a UIListLayout cannot
-- move themselves, so the row is placed in a same-size holder that takes its place in the list and the row
-- slides inside it.
function Juice.slideIn(row: GuiObject, order: number)
	if UI.Reduced or not row.Parent then
		return
	end
	local holder = Instance.new("Frame")
	holder.Name = row.Name
	holder.BackgroundTransparency = 1
	holder.Size = row.Size
	holder.LayoutOrder = row.LayoutOrder
	holder.Parent = row.Parent
	row.Size = UDim2.fromScale(1, 1)
	row.Position = UDim2.new(0.6, 0, 0, 0)
	row.Parent = holder
	TweenService:Create(row, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, (order - 1) * 0.05), { Position = UDim2.new() }):Play()
end

-- Idle wobble for shop egg tiles: every registered icon rocks a few degrees on its own phase. One shared loop
-- (15 Hz), at most MAX_WOBBLE at once, only while visible; Reduce Motion holds them still.
local MAX_WOBBLE = 12
type Wob = { Obj: GuiObject, Phase: number }
local wobbles: { Wob } = {}
local wobbleLoop = false

function Juice.wobble(obj: GuiObject)
	if #wobbles >= MAX_WOBBLE then
		return
	end
	table.insert(wobbles, { Obj = obj, Phase = math.random() * 6 })
	if wobbleLoop then
		return
	end
	wobbleLoop = true
	task.spawn(function()
		while #wobbles > 0 do
			local now = os.clock()
			for i = #wobbles, 1, -1 do
				local w = wobbles[i]
				if w.Obj.Parent == nil then
					table.remove(wobbles, i)
				elseif UI.Reduced then
					w.Obj.Rotation = 0
				elseif w.Obj.Visible and w.Obj.AbsoluteSize.X > 1 then
					-- a rock with a short pause at the ends (sin cubed): gentle, not a constant swing
					local a = math.sin(now * 2.4 + w.Phase)
					w.Obj.Rotation = a * a * a * 7
				end
			end
			task.wait(1 / 15)
		end
		wobbleLoop = false
	end)
end

-- Timer ring: RING_DOTS dots round a circle, lit clockwise from the top; set(f) lights the first f (0..1) of them
-- so the ring drains as the time runs out. Returns (frame, set).
local RING_DOTS = 20
function Juice.ring(parent: Instance, size: number, color: Color3, props: { [string]: any }?): (Frame, (number) -> ())
	local f = UI.frame(parent, { Name = "Ring", BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size) })
	for k, v in (props or {}) :: { [string]: any } do
		(f :: any)[k] = v
	end
	local d = math.max(math.floor(size * 0.2), 4)
	local r = size / 2 - d / 2
	local dots: { Frame } = {}
	for i = 1, RING_DOTS do
		local a = (i - 1) / RING_DOTS * math.pi * 2
		local dot = UI.frame(f, {
			Name = "Dot" .. i, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(d, d), BackgroundColor3 = color,
			Position = UDim2.fromOffset(size / 2 + math.sin(a) * r, size / 2 - math.cos(a) * r),
		})
		UI.corner(dot, d)
		dots[i] = dot
	end
	local lit = -1
	return f, function(frac: number)
		local n = math.ceil(math.clamp(frac, 0, 1) * RING_DOTS)
		if n == lit then
			return
		end
		lit = n
		for i, dot in dots do
			dot.BackgroundTransparency = if i <= n then 0 else 0.78 -- spent time stays as a faint trace of the ring
		end
	end
end

-- Claimable glow (quest CLAIM, daily gift, upgrades you can afford, new pets): see UiJuice.pulse.
Juice.pulse = UiJuice.pulse
-- One shine sweep across a card (hover / select): see UiJuice.sweep.
Juice.sweep = UiJuice.sweep

-- Coin flight -------------------------------------------------------------------------------------------------
-- Coins fly from where they were earned (a CLAIM / OPEN / SELL button) to the coin counter that is on screen (the
-- open menu's cash header, else the HUD coin pill) along an arc, then the counter bumps. The tap only remembers
-- where the button was (Juice.coinSource); the flight starts when the server's new cash arrives (Juice.payout,
-- called by the HUD), so nothing flies for a claim the server refused.
local hudCoins: GuiObject? = nil
local source: { At: Vector2, Time: number }? = nil
local SOURCE_TTL = 4 -- seconds a tap waits for its coins

function Juice.setCoinTarget(obj: GuiObject?)
	hudCoins = obj
end

local function centre(obj: GuiObject): Vector2
	return obj.AbsolutePosition + obj.AbsoluteSize / 2
end

-- Remembers `obj` (its screen centre, now) as where the next coins come from.
function Juice.coinSource(obj: GuiObject)
	if obj.Parent and obj.AbsoluteSize.X > 0 then
		source = { At = centre(obj), Time = os.clock() }
	end
end

local function coinTarget(): GuiObject?
	local m = UI.modalCashTarget()
	if m then
		return m
	end
	local h = hudCoins
	if h and h.Parent and h.Visible and h.AbsoluteSize.X > 0 then
		return h
	end
	return nil
end

-- A few small coins fly from the absolute screen point `fromAbs` to `target` along UiMotion's arc; the last one
-- bumps the target. One tween per coin (nothing keeps running once they land).
function Juice.coinFlyFrom(fromAbs: Vector2, target: GuiObject, amount: number)
	if UiJuice.still() or not target.Parent then
		return
	end
	local sg = UI.noticeLayer()
	local sc = if UI.Scale > 0 then UI.Scale else 1
	local p0 = (fromAbs - sg.AbsolutePosition) / sc
	local p1 = (centre(target) - sg.AbsolutePosition) / sc
	local layer = fxLayer(sg)
	layer.Name = "CoinFly"
	local n = UiMotion.coinCount(amount)
	local flight = 0.55
	for i = 1, n do
		local c = UI.icon(layer, "cash", 22, { Name = "FlyCoin", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(p0.X, p0.Y), ZIndex = 52 })
		local from = p0 + Vector2.new((i - (n + 1) / 2) * 10, (i % 2) * 8 - 4)
		local lift = 50 + i * 6
		c.Position = UDim2.fromOffset(from.X, from.Y)
		local a = Instance.new("NumberValue")
		a.Changed:Connect(function(t: number)
			local pt = UiMotion.arcPoint(from, p1, lift, t)
			c.Position = UDim2.fromOffset(pt.X, pt.Y)
		end)
		local tw = TweenService:Create(a, TweenInfo.new(flight, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, (i - 1) * 0.06), { Value = 1 })
		tw.Completed:Connect(function()
			c:Destroy()
			a:Destroy()
			if i == n and target.Parent then
				UI.pop(target, 1.18) -- the counter bumps as the last coin lands
			end
		end)
		tw:Play()
	end
	Debris:AddItem(layer, flight + n * 0.06 + 0.5)
end

-- Coins were paid (`amount` > 0: the HUD saw the cash go up): fly them from the remembered source while it is
-- fresh. Returns true when coins flew.
function Juice.payout(amount: number): boolean
	local s = source
	if not s or amount <= 0 or os.clock() - s.Time > SOURCE_TTL then
		return false
	end
	source = nil
	local t = coinTarget()
	if not t then
		return false
	end
	Juice.coinFlyFrom(s.At, t, amount)
	return true
end

-- Is `obj` really drawn: in a parent chain of visible GuiObjects under an enabled ScreenGui, with a size? A hidden pill
-- keeps a stale AbsolutePosition (in a hunt the coin pill's spot is under the hunt clock card), so effects aimed at a
-- hidden object landed on whatever is there now (Studio 2026-10-15: "+4 coins" on the clock).
function Juice.onScreen(obj: GuiObject?): boolean
	if not obj or not obj.Parent or obj.AbsoluteSize.X <= 0 then
		return false
	end
	local chain: { boolean } = {}
	local cur: Instance? = obj
	while cur do
		if cur:IsA("GuiObject") then
			table.insert(chain, cur.Visible)
		elseif cur:IsA("LayerCollector") then
			table.insert(chain, cur.Enabled)
			break
		end
		cur = cur.Parent
	end
	return UiMotion.shownChain(chain)
end

-- The HUD coin counter coins fly to (nil while it is hidden).
Juice.coinTarget = coinTarget

return Juice
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="357">
            <Properties>
              <string name="Name">LaunchPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Teleport mode UI (Config.Places.Mode = "Teleport"): a card at the top of the screen that shows
--   * in the lobby: the party heading to the quarry, with RETRY / CANCEL when a teleport failed
--   * in the Match place: WaitingForParty with arrival checkmarks, the 30 s countdown and, if
--     members are missing, START WITH ARRIVED / RETURN options
--   * returning to the lobby, and rejected arrivals
-- It only displays what the server sends and sends intents back (LaunchAction). Never shown in
-- the default single-place mode.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local PetStyle = require(script.Parent.PetStyle)

local C = UI.Colors
local PET = Theme.Pet
local T = UI.T
local LaunchPanel = {}

-- Pet style: a sky-blue PetStyle.card (drop shadow, pattern, tilt) with a floating title, white outlined words, light
-- member rows and lime / navy pills. `card` is the card's wrapper (position, size, destroy); `face` holds the content.
local CARD_W = 460
local CARD_PAD_X, CARD_PAD_Y, CARD_GAP = 14, 10, 6
local card: Frame? = nil
local face: Frame? = nil
local last: { Kind: string, Data: any }? = nil
-- The Waiting card arrives every second (countdown). Rebuilding it each time destroyed the buttons under the
-- player's finger and lost taps, so when only the countdown changed the message text is updated in place.
local waitSig: string? = nil
local msgLabel: TextLabel? = nil

local function act(action: string)
	Net.event("LaunchAction"):FireServer(action)
end

local function ensureCard(): Frame
	if card and card.Parent and face and face.Parent then
		return face :: Frame
	end
	local root = UI.overlay()
	-- the pattern is laid for the card's full width; the wrapper then takes the screen width up to CARD_W
	local f = PetStyle.card(root, "sky", { Name = "LaunchCard", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(CARD_W, 120), Active = true })
	local wrap = f.Parent :: Frame
	wrap.Size = UDim2.new(1, -32, 0, 120)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(CARD_W, 1000)
	limit.Parent = wrap
	-- the content lives in its own frame: a list layout on the face would stack the pattern host as a row
	local content = UI.frame(f, { Name = "Content", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3 })
	UI.pad(content, CARD_PAD_X, CARD_PAD_Y)
	UI.list(content, Enum.FillDirection.Vertical, CARD_GAP)
	card = wrap
	face = content
	return content
end

-- The wrapper grows to its content (every child has a fixed height; a scale-sized face cannot size itself).
local function fitHeight(f: Frame)
	local h = 0
	local n = 0
	for _, c in f:GetChildren() do
		if c:IsA("GuiObject") and c.Visible and c.Name ~= "Pattern" and c.Name ~= "Drop" then
			h += c.Size.Y.Offset
			n += 1
		end
	end
	h += CARD_PAD_Y * 2 + CARD_GAP * math.max(n - 1, 0)
	local w = card
	if w then
		w.Size = UDim2.new(1, -32, 0, h)
	end
end

-- A round badge: green check (here / sent), red cross (failed), grey ring (still on the way).
local function badge(parent: Instance, kind: string, order: number): Frame
	local b = UI.frame(parent, {
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = if kind == "good" then PET.Lime elseif kind == "bad" then PET.Red else C.Disabled,
		LayoutOrder = order,
	})
	PetStyle.round(b, 12)
	PetStyle.edge(b, if kind == "good" then PET.LimeEdge elseif kind == "bad" then PET.RedEdge else C.GrayDeep, 2)
	local function bar(w: number, h: number, x: number, y: number, rot: number)
		local r = UI.frame(b, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(w, h),
			Rotation = rot,
			BackgroundColor3 = if kind == "bad" then PET.White else PET.Ink,
		})
		UI.corner(r, 2)
	end
	if kind == "good" then
		bar(3, 8, 9, 14, 45)
		bar(3, 14, 15, 12, -45)
	elseif kind == "bad" then
		bar(3, 14, 12, 12, 45)
		bar(3, 14, 12, 12, -45)
	else
		for i = 0, 2 do
			local d = UI.frame(b, { Position = UDim2.fromOffset(5 + i * 6, 10), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = C.Muted })
			UI.corner(d, 2)
		end
	end
	return b
end

-- A light pill row on the blue card: badge, name in the deep title blue, the state word on the right.
local function memberRow(parent: Instance, name: string, kind: string, word: string, isLeader: boolean, order: number)
	local row = UI.frame(parent, { Name = "Member", Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = PET.QuestBody, LayoutOrder = order, ZIndex = 3 })
	PetStyle.round(row, 999)
	PetStyle.edge(row, PET.QuestEdge, 2)
	local b = badge(row, kind, 0)
	b.Position = UDim2.fromOffset(6, 3)
	b.ZIndex = 4
	UI.text(row, if isLeader then "\u{2605} " .. name else name, { Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -176, 1, 0), TextSize = T.Small, Font = UI.Bold, TextColor3 = PET.TitleEdge, Outline = false, ZIndex = 4 })
	local state = UI.text(row, word, {
		Position = UDim2.new(1, -132, 0, 0),
		Size = UDim2.fromOffset(120, 30),
		TextSize = T.Tiny,
		Font = UI.Head,
		Outline = false,
		ZIndex = 4,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = if kind == "good" then PET.PriceEdge elseif kind == "bad" then PET.RedEdge else C.Muted,
	})
	state.TextWrapped = false -- one line: the fitted words shrink instead of wrapping
end

local function clear(f: Frame)
	for _, c in f:GetChildren() do
		if c:IsA("GuiObject") and c.Name ~= "Pattern" then
			c:Destroy()
		end
	end
end

local function head(f: Frame, title: string, message: string?)
	-- the title and its drop copy sit in one box (two labels in the list would take two rows)
	local box = UI.frame(f, { Name = "Head", Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = 1, ZIndex = 3 })
	PetStyle.title(box, UI.titleCase(title), T.Head + 2, { Size = UDim2.new(1, 0, 1, 0), ZIndex = 4 })
	if message and message ~= "" then
		msgLabel = PetStyle.words(f, message, T.Small, { Name = "Message", LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 36), TextYAlignment = Enum.TextYAlignment.Top, OutlineColor = PET.TitleEdge, OutlineThick = 1.8, ZIndex = 3 })
	end
end

-- Pills: "yellow" = lime (go), "dark" = navy (back / cancel); a disabled one is flat grey and takes no taps.
local function buttons(f: Frame, specs: { { Text: string, Style: string, Enabled: boolean?, Action: (() -> ())? } })
	if #specs == 0 then
		return
	end
	local row = UI.frame(f, { Name = "Buttons", Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, LayoutOrder = 100, ZIndex = 3 })
	UI.list(row, Enum.FillDirection.Horizontal, 8)
	for i, s in specs do
		local props = { Size = UDim2.new(1 / #specs, -8 * (#specs - 1) / #specs, 1, 0), LayoutOrder = i }
		local b: TextButton
		if s.Enabled == false then
			b = PetStyle.pill(row, s.Text, C.Disabled, C.Disabled, C.GrayDeep, props, T.Body)
			b.Active = false
			b:SetAttribute("Disabled", true)
		elseif s.Style == "yellow" then
			b = PetStyle.pill(row, s.Text, PET.LimeTop, PET.Lime, PET.LimeEdge, props, T.Body)
		else
			b = PetStyle.pill(row, s.Text, PET.TabBar, PET.TabBar, PET.TabBarEdge, props, T.Body)
		end
		local action = s.Action
		if action and s.Enabled ~= false then
			b.Activated:Connect(action)
		end
	end
end

-- Everything on the Waiting card except the countdown seconds; equal signatures mean only the text changed.
local function waitingSignature(data: any): string
	local parts = { tostring(data.Status), tostring(data.CanStart), tostring(data.CanReturnAll) }
	for _, m in data.Members or {} do
		table.insert(parts, tostring(m.Name) .. ":" .. tostring(m.Arrived) .. ":" .. tostring(m.Leader))
	end
	return table.concat(parts, "|")
end

local function render(kind: string, data: any)
	if kind == "Waiting" then
		local sig = waitingSignature(data)
		local label = msgLabel
		if last and last.Kind == "Waiting" and sig == waitSig and card and card.Parent and label and label.Parent then
			if data.Status ~= "Loading" and data.Status ~= "TimedOut" then
				label.Text = "Everyone is on the way. The hunt starts when the whole party is here.  " .. tostring(data.Remaining) .. " s"
			end
			last = { Kind = "Waiting" :: string, Data = data }
			return
		end
		waitSig = sig
	else
		waitSig = nil
	end
	local f = ensureCard()
	clear(f)
	msgLabel = nil
	last = { Kind = kind, Data = data }
	if kind == "Launch" then
		local phase = data.Phase
		local title = "HEADING TO THE PET HUNT"
		if phase == "Failed" then
			title = "COULD NOT GET THERE"
		elseif phase == "Partial" then
			title = "PART OF THE PARTY IS MISSING"
		elseif phase == "Preparing" then
			title = "GETTING READY"
		end
		head(f, title, data.Message)
		for i, m in data.Members do
			local k, word = "wait", "ON THE WAY"
			if m.State == "Away" then
				k, word = "good", "IN THE HUNT"
			elseif m.State == "Sent" then
				k, word = "good", "SENT"
			elseif m.State == "Failed" then
				k, word = "bad", "FAILED"
			end
			memberRow(f, m.Name, k, word, m.UserId == data.Leader, 10 + i)
		end
		if phase == "Failed" or phase == "Partial" then
			buttons(f, {
				{ Text = "RETRY", Style = "yellow", Enabled = data.CanRetry == true, Action = function()
					act("Retry")
				end },
				{ Text = "CANCEL", Style = "dark", Action = function()
					act("Cancel")
				end },
			})
		end
	elseif kind == "Waiting" then
		local status = data.Status
		local title = "WAITING FOR YOUR PARTY"
		local msg = "Everyone is on the way. The hunt starts when the whole party is here."
		if status == "Loading" then
			title = "EVERYONE IS HERE"
			msg = "Loading your gear..."
		elseif status == "TimedOut" then
			title = "SOME PLAYERS ARE MISSING"
			msg = if data.CanStart then "Start with the players who are here, or go back to the lobby." else "Waiting for the party leader to decide."
		else
			msg = msg .. "  " .. tostring(data.Remaining) .. " s"
		end
		head(f, title, msg)
		for i, m in data.Members do
			memberRow(f, m.Name, if m.Arrived then "good" else "wait", if m.Arrived then "HERE" else "ON THE WAY", m.Leader, 10 + i)
		end
		local specs = {}
		if data.CanStart then
			table.insert(specs, { Text = "START WITH ARRIVED", Style = "yellow", Action = function()
				act("StartWithArrived")
			end })
		end
		table.insert(specs, { Text = if data.CanReturnAll then "RETURN ALL" else "RETURN", Style = "dark", Action = function()
			act(if data.CanReturnAll then "ReturnAll" else "Return")
		end })
		buttons(f, specs)
	elseif kind == "ReturnFailed" then
		head(f, "COULD NOT GO BACK YET", "Nothing was lost. Try again in a moment.")
		buttons(f, { { Text = "TRY AGAIN", Style = "yellow", Action = function()
			act("Return")
		end } })
	elseif kind == "Rejected" then
		head(f, "NOT AVAILABLE", data.Message)
	elseif kind == "Returning" then
		head(f, "BACK TO THE LOBBY", data.Message)
	end
	fitHeight(f)
end

function LaunchPanel.hide()
	last = nil
	waitSig = nil
	msgLabel = nil
	if card then
		(card :: Frame):Destroy()
		card = nil
		face = nil
	end
end

function LaunchPanel.onEvent(kind: string, data: any)
	if kind == "Hide" then
		LaunchPanel.hide()
	elseif kind == "Mode" then
		State.Teleport = data.Teleport == true
		State.update("Match")
	elseif kind == "Launch" or kind == "Waiting" or kind == "ReturnFailed" or kind == "Rejected" or kind == "Returning" then
		render(kind, data)
	end
end

function LaunchPanel.start()
	Net.event("LaunchEvent").OnClientEvent:Connect(LaunchPanel.onEvent)
	-- A hunt starting or ending replaces the waiting card.
	State.Changed.Event:Connect(function(what)
		if what == "Match" and State.Match and last and last.Kind == "Waiting" then
			LaunchPanel.hide()
		end
	end)
end

return LaunchPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="358">
            <Properties>
              <string name="Name">LobbyHudV2</string>
              <string name="Source"><![CDATA[--!strict
-- Lobby HUD v2: carter's lobby screen (ChatGPT prototype + carter's painted buttons, 2026-10-15). LIVE: on for
-- everyone in the lobby (carter "put it in the game"); Workspace attribute LobbyHudV2 = false turns it off.
--   coin pill (real coins), FIND THE PET title, MY PETS / PET BOOK left, DAILY / SPIN / SHOP right,
--   TRAIN / PLAY / FIGHT bottom, and a queue line over PLAY while a hunt queue is counting.
-- Each button opens the same thing its old HUD button did (Main passes the actions in). While it shows, the old
-- lobby column and tile menu hide (Hud.setLobbyHidden) and come back in hunts, the tower and battles. It also hides
-- while a menu is open. carter asked for no Settings / Party / Upgrade / Gift buttons on this screen (2026-10-15).
-- Every piece is its own object so each can move on its own:
--   <Piece> (Frame, placed by shared/LobbyHudLayout)
--     Visual + UIScale "CosmeticScale"  <- entrance pop, press squash, hover grow
--       Art (carter's picture) [+ ShineClip/Shine on PLAY], or the drawn stand-in when an id is 0
--     Hit (TextButton, invisible)        <- input (never moves, so the tap target stays put)
-- Idle personality (shared/LobbyHudIdle): now and then one button does its own short move (Visual's Position / Size /
-- Rotation, so the press squash on CosmeticScale never fights it), with a light decoration of its own (stars, a glow
-- under TRAIN, an edge flash on FIGHT). DAILY only wiggles while a reward is claimable. A press or hover stops the
-- move at once; menus over the HUD pause it; Reduce Motion turns it off; Low Effects drops the decorations.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local LobbyHudLayout = require(Shared.LobbyHudLayout)
local LobbyHudArt = require(Shared.LobbyHudArt)
local LobbyHudIdle = require(Shared.LobbyHudIdle)
local PopupRules = require(Shared.PopupRules)
local UI = require(script.Parent.UI)
local State = require(script.Parent.Parent.State)

local LobbyHudV2 = {}
LobbyHudV2.Motion = true -- one switch for every cosmetic tween (UI.Reduced also turns them off)
LobbyHudV2.Attr = "LobbyHudV2" -- Workspace attribute; false = off

export type Actions = {
	open: { [string]: () -> () }, -- piece name -> what a tap does
	status: () -> string?, -- the queue line over PLAY
	hideOld: (boolean) -> (), -- the old lobby HUD steps aside
	claimable: (() -> boolean)?, -- a daily reward is ready (DAILY's reminder wiggle)
}
local actions: Actions? = nil

local NAVY = Color3.fromHex("071747")
local CYAN = Color3.fromHex("25E8FF")
local BLUE = Color3.fromHex("009DFF")
local PURPLE = Color3.fromHex("8734F5")
local LIME_TOP = Color3.fromHex("B9FF16")
local LIME = Color3.fromHex("80FF32")
local ORANGE = Color3.fromHex("FFA008")
local YELLOW = Color3.fromHex("FFD72D")
local WHITE = Color3.new(1, 1, 1)
local FONT = Enum.Font.FredokaOne

type Spec = { Label: string, Sub: string?, Icon: string, Fill: Color3, Top: Color3 }
local SPECS: { [string]: Spec } = {
	MyPets = { Label = "MY PETS", Icon = "\u{1F43E}", Fill = BLUE, Top = Color3.fromHex("4FC3FF") },
	PetBook = { Label = "PET BOOK", Icon = "\u{1F4D6}", Fill = PURPLE, Top = Color3.fromHex("B07BFF") },
	Daily = { Label = "DAILY", Icon = "\u{1F381}", Fill = BLUE, Top = Color3.fromHex("4FC3FF") },
	Spin = { Label = "SPIN", Icon = "\u{1F3A1}", Fill = BLUE, Top = Color3.fromHex("4FC3FF") },
	Shop = { Label = "SHOP", Icon = "\u{1F6CD}", Fill = BLUE, Top = Color3.fromHex("4FC3FF") },
	Train = { Label = "TRAIN", Icon = "\u{1F3F0}", Fill = Color3.fromHex("1EC8F0"), Top = Color3.fromHex("6BE6FF") },
	Play = { Label = "PLAY", Sub = "3-MIN HUNT", Icon = "\u{1F95A}", Fill = LIME, Top = LIME_TOP },
	Fight = { Label = "FIGHT", Icon = "\u{2694}", Fill = ORANGE, Top = Color3.fromHex("FFC44D") },
}

local player = Players.LocalPlayer
local gui: ScreenGui? = nil
local pieces: { [string]: Frame } = {}
local scales: { [string]: UIScale } = {}
local visuals: { [string]: Frame } = {}
local arts: { [string]: ImageLabel } = {}
local shown = false
local stepped: { [ScreenGui]: boolean } = {}

local function settings(): { [string]: any }
	local prof: any = State.Profile
	return (prof and type(prof.Settings) == "table" and prof.Settings) or {}
end

local function motion(): boolean
	return LobbyHudV2.Motion and not UI.Reduced and settings().ReducedMotion ~= true
end

local function lowFx(): boolean
	return settings().LowEffects == true
end

local function corner(p: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = p
end

local function stroke(p: Instance, color: Color3, thick: number)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thick
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = p
	return s
end

local function frame(parent: Instance, name: string, props: { [string]: any }): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BorderSizePixel = 0
	f.BackgroundTransparency = 1
	for k, v in props do
		(f :: any)[k] = v
	end
	f.Parent = parent
	return f
end

-- fitted text: scaled to its box with a floor and a ceiling, navy outline
local function words(parent: Instance, name: string, text: string, props: { [string]: any }, min: number, max: number): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Font = FONT
	l.Text = text
	l.TextColor3 = WHITE
	l.TextScaled = true
	for k, v in props do
		(l :: any)[k] = v
	end
	local c = Instance.new("UITextSizeConstraint")
	c.MinTextSize = min
	c.MaxTextSize = max
	c.Parent = l
	local s = Instance.new("UIStroke")
	s.Color = NAVY
	s.Thickness = 2.5
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.Parent = l
	l.Parent = parent
	return l
end

local function tween(obj: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

-- Idle personality ---------------------------------------------------------------------------------------------
local busy: { [string]: boolean? } = {} -- held down or hovered: no idle move
local token: { [string]: number } = {}
local running: { [string]: Tween } = {}
local decor: { [string]: { Instance } } = {}

local REST_POS = UDim2.fromScale(0.5, 0.5)
local REST_SIZE = UDim2.fromScale(1, 1)

local function atRest(name: string)
	local v = visuals[name]
	if v then
		v.Position, v.Size, v.Rotation = REST_POS, REST_SIZE, 0
	end
	local art = arts[name]
	if art then
		art.ScaleType = Enum.ScaleType.Fit
	end
end

local function clearDecor(name: string)
	local list = decor[name]
	decor[name] = nil
	if list then
		for _, d in list do
			d:Destroy()
		end
	end
end

-- stop a button's move now and put it back at rest (press feedback wins over idle; menus pause it)
local function idleStop(name: string)
	token[name] = (token[name] or 0) + 1
	local tw = running[name]
	if tw then
		tw:Cancel()
		running[name] = nil
	end
	atRest(name)
	clearDecor(name)
end

local function idleStopAll()
	for name in visuals do
		if running[name] or decor[name] then
			idleStop(name)
		end
	end
end

local function keep(name: string, obj: Instance)
	local list = decor[name] or {}
	table.insert(list, obj)
	decor[name] = list
end

local function fade(obj: Instance, t: number, delay: number, props: { [string]: any })
	task.delay(delay, function()
		if obj.Parent then
			TweenService:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
		end
	end)
end

-- tiny separate stars that pop and fade round the button's edges
local function stars(name: string, holder: Frame)
	local spots = (LobbyHudIdle.StarSpots :: any)[name] or {}
	local big = if name == "Play" then 0.3 else 0.2
	for i, spot in spots do
		local star = Instance.new("TextLabel")
		star.Name = "IdleStar"
		star.BackgroundTransparency = 1
		star.Font = FONT
		star.Text = "\u{2605}"
		star.TextScaled = true
		star.TextColor3 = if i % 2 == 0 then WHITE else Color3.fromHex("FFE14D")
		star.AnchorPoint = Vector2.new(0.5, 0.5)
		star.Position = UDim2.fromScale(spot.x, spot.y)
		star.SizeConstraint = Enum.SizeConstraint.RelativeYY
		star.Size = UDim2.fromScale(0, 0)
		star.ZIndex = 6
		local edge = Instance.new("UIStroke")
		edge.Color = NAVY
		edge.Thickness = 1.5
		edge.Parent = star
		star.Parent = holder
		keep(name, star)
		local wait = (i - 1) * 0.06
		task.delay(wait, function()
			if star.Parent then
				TweenService:Create(star, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromScale(big, big), Rotation = 30 }):Play()
			end
		end)
		fade(star, 0.25, wait + 0.24, { TextTransparency = 1, Rotation = 60 })
		fade(edge, 0.25, wait + 0.24, { Transparency = 1 })
	end
end

-- a soft cyan glow under the button (behind the picture)
local function glow(name: string, holder: Frame)
	local g = frame(holder, "IdleGlow", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.96), Size = UDim2.fromScale(0.6, 0.16), BackgroundColor3 = CYAN, BackgroundTransparency = 1, ZIndex = 0 })
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = g
	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
	grad.Parent = g
	keep(name, g)
	fade(g, 0.16, 0, { BackgroundTransparency = 0.15, Size = UDim2.fromScale(0.9, 0.24) })
	fade(g, 0.35, 0.3, { BackgroundTransparency = 1, Size = UDim2.fromScale(0.7, 0.18) })
end

-- a quick white flash round the button's edge (tilts with the picture)
local function flash(name: string, visual: Frame)
	local f = frame(visual, "IdleFlash", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.47), Size = UDim2.fromScale(0.97, 0.9), ZIndex = 3 })
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.22, 0)
	c.Parent = f
	local edge = stroke(f, WHITE, 4)
	edge.Transparency = 1
	keep(name, f)
	fade(edge, 0.05, 0, { Transparency = 0.05 })
	fade(edge, 0.25, 0.08, { Transparency = 1 })
end

local STYLE: { [string]: Enum.EasingStyle } = { Quad = Enum.EasingStyle.Quad, Sine = Enum.EasingStyle.Sine, Back = Enum.EasingStyle.Back }

-- play one button's move (returns when it ends or is stopped)
local function idlePlay(name: string)
	local move = LobbyHudIdle.Moves[name]
	local v, holder = visuals[name], pieces[name]
	if not move or not v or not holder then
		return
	end
	idleStop(name)
	local my = token[name]
	local art = arts[name]
	if move.Stretch and art then
		art.ScaleType = Enum.ScaleType.Stretch -- the picture box keeps the picture's own shape at rest, so squash reads
	end
	if move.Fx and not lowFx() then
		task.delay(move.FxAt or 0, function()
			if token[name] ~= my then
				return
			end
			if move.Fx == "Stars" or move.Fx == "Burst" then
				stars(name, holder)
			elseif move.Fx == "Glow" then
				glow(name, holder)
			elseif move.Fx == "Flash" then
				flash(name, v)
			end
		end)
	end
	for _, s in move.Steps do
		local dir = if s.dir == "In" then Enum.EasingDirection.In else Enum.EasingDirection.Out
		local tw = TweenService:Create(v, TweenInfo.new(s.d, STYLE[s.style or "Quad"] or Enum.EasingStyle.Quad, dir), {
			Position = UDim2.fromScale(0.5 + (s.x or 0), 0.5 + (s.y or 0)),
			Size = UDim2.fromScale(s.sx or 1, s.sy or 1),
			Rotation = s.rot or 0,
		})
		running[name] = tw
		tw:Play()
		task.wait(s.d)
		if token[name] ~= my then
			return
		end
	end
	running[name] = nil
	atRest(name)
	task.delay(0.6, function()
		if token[name] == my then
			clearDecor(name)
		end
	end)
end

-- one button at a time, a few quiet seconds between moments, only while the HUD shows and motion is on
local function idleLoop()
	task.spawn(function()
		local lastAt: { [string]: number } = {}
		local last: string? = nil
		local wait = LobbyHudIdle.FirstWait
		while gui and gui.Parent do
			task.wait(wait)
			wait = 0.5
			if shown and motion() then
				local a = actions
				local claim = a ~= nil and a.claimable ~= nil and a.claimable()
				local now = os.clock()
				local name = LobbyHudIdle.pick(now, lastAt, last, claim, math.random(), busy)
				if name then
					lastAt[name], last = now, name
					idlePlay(name)
					wait = LobbyHudIdle.gap(math.random())
				end
			end
		end
	end)
end

-- press / hover feedback on one piece (never stacks: every tween sets an absolute target)
local function hook(name: string, hit: TextButton, sc: UIScale)
	local hover, down = false, false
	local function mark()
		busy[name] = (hover or down) or nil
		if hover or down then
			idleStop(name) -- press feedback wins: the idle move snaps home first
		end
	end
	local function rest(): number
		return if down then 0.96 elseif hover then 1.04 else 1
	end
	local function go(t: number, style: Enum.EasingStyle?)
		mark()
		if motion() then
			tween(sc, t, { Scale = rest() }, style)
		else
			sc.Scale = 1
		end
	end
	hit.MouseEnter:Connect(function()
		hover = true
		go(0.12)
	end)
	hit.MouseLeave:Connect(function()
		hover, down = false, false
		go(0.12)
	end)
	hit.MouseButton1Down:Connect(function()
		down = true
		go(0.06)
	end)
	local function up()
		if down then
			down = false
			go(0.14, Enum.EasingStyle.Back)
		end
	end
	hit.MouseButton1Up:Connect(up)
	hit.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			up()
		end
	end)
	hit.Activated:Connect(function()
		local a = actions
		local fn = a and a.open[name]
		if fn then
			fn()
		end
	end)
end

local function hitBox(holder: Frame, name: string, sc: UIScale)
	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 10
	hit.AutoButtonColor = false
	hit.Parent = holder
	hook(name, hit, sc)
end

-- carter's painted button: the whole picture (label, icon, rim, shadow baked in) moves as one; PLAY gets a light
-- sweep clipped to its face
local function picture(holder: Frame, visual: Frame, name: string, image: string)
	local art = Instance.new("ImageLabel")
	art.Name = "Art"
	art.BackgroundTransparency = 1
	art.Image = image
	art.ScaleType = Enum.ScaleType.Fit
	art.Size = UDim2.fromScale(1, 1)
	art.Parent = visual
	arts[name] = art
	if name == "Play" then
		local face = frame(visual, "ShineClip", { Position = UDim2.fromScale(0.04, 0.08), Size = UDim2.fromScale(0.92, 0.74), ClipsDescendants = true, ZIndex = 2 })
		corner(face, 18)
		frame(face, "Shine", { Size = UDim2.new(0.12, 0, 1.6, 0), Position = UDim2.new(-0.3, 0, -0.3, 0), Rotation = 20, BackgroundColor3 = WHITE, BackgroundTransparency = 0.65 })
	end
	local _ = holder
end

-- one chunky button: carter's picture when its id is set, else the drawn stand-in (shadow, body with gradient,
-- navy outline, cyan rim, gloss, icon, label (+ sub))
local function button(root: Instance, name: string, spec: Spec): Frame
	local holder = frame(root, name, {})
	local visual = frame(holder, "Visual", { AnchorPoint = Vector2.new(0.5, 0.5), Position = REST_POS, Size = REST_SIZE })
	visuals[name] = visual
	local sc = Instance.new("UIScale")
	sc.Name = "CosmeticScale"
	sc.Parent = visual
	scales[name] = sc
	local image = LobbyHudArt.image(name)
	if image then
		picture(holder, visual, name, image)
		hitBox(holder, name, sc)
		return holder
	end
	local big = name == "Play"
	local r = if big then 22 else 16
	local shadow = frame(visual, "Shadow", { Size = UDim2.new(1, 0, 1, 0), Position = UDim2.fromOffset(0, 5), BackgroundColor3 = NAVY, BackgroundTransparency = 0 })
	corner(shadow, r)
	local body = frame(visual, "Body", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0, ClipsDescendants = true })
	corner(body, r)
	stroke(body, NAVY, 3.5)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(spec.Top, spec.Fill)
	g.Rotation = 90
	g.Parent = body
	local rim = frame(body, "Rim", { Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3) })
	corner(rim, r - 3)
	stroke(rim, CYAN, 2).Transparency = if big then 0.35 else 0.1
	local gloss = frame(body, "Gloss", { Size = UDim2.new(1, -16, 0.36, 0), Position = UDim2.fromOffset(8, 5), BackgroundColor3 = WHITE, BackgroundTransparency = 0.72 })
	corner(gloss, r - 6)
	if big then
		local shine = frame(body, "Shine", { Size = UDim2.new(0.18, 0, 1.6, 0), Position = UDim2.new(-0.3, 0, -0.3, 0), Rotation = 20, BackgroundColor3 = WHITE, BackgroundTransparency = 0.6 })
		local _ = shine
		words(visual, "Icon", spec.Icon, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.06, 0, 0.5, 0), Size = UDim2.new(0.2, 0, 0.72, 0), TextStrokeTransparency = 1 }, 14, 64)
		words(visual, "Label", spec.Label, { Position = UDim2.new(0.28, 0, 0.06, 0), Size = UDim2.new(0.68, 0, 0.6, 0) }, 18, 72)
		local sub = words(visual, "Sub", spec.Sub or "", { Position = UDim2.new(0.28, 0, 0.64, 0), Size = UDim2.new(0.68, 0, 0.26, 0), TextColor3 = Color3.fromHex("0F6B1E") }, 10, 26)
		local subEdge = sub:FindFirstChildOfClass("UIStroke")
		if subEdge then
			subEdge.Color = WHITE
		end
	else
		words(visual, "Icon", spec.Icon, { Position = UDim2.new(0.1, 0, 0.06, 0), Size = UDim2.new(0.8, 0, 0.56, 0) }, 12, 56)
		words(visual, "Label", spec.Label, { Position = UDim2.new(0.04, 0, 0.62, 0), Size = UDim2.new(0.92, 0, 0.32, 0) }, 11, 30)
	end
	hitBox(holder, name, sc)
	return holder
end

local function coins(root: Instance): Frame
	local holder = frame(root, "Coins", {})
	local visual = frame(holder, "Visual", { Size = UDim2.fromScale(1, 1) })
	local sc = Instance.new("UIScale")
	sc.Name = "CosmeticScale"
	sc.Parent = visual
	scales.Coins = sc
	local shadow = frame(visual, "Shadow", { Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, 4), BackgroundColor3 = NAVY, BackgroundTransparency = 0 })
	corner(shadow, 999)
	local body = frame(visual, "Body", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromHex("10245E"), BackgroundTransparency = 0 })
	corner(body, 999)
	stroke(body, CYAN, 3)
	local coin = frame(visual, "CoinIcon", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.new(1, 0, 1, 6), SizeConstraint = Enum.SizeConstraint.RelativeYY, BackgroundColor3 = YELLOW, BackgroundTransparency = 0 })
	corner(coin, 999)
	stroke(coin, NAVY, 3)
	words(coin, "Paw", "\u{1F43E}", { Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.15, 0.15), TextStrokeTransparency = 1 }, 8, 30)
	words(visual, "AmountLabel", "0", { Position = UDim2.new(0.34, 0, 0.12, 0), Size = UDim2.new(0.6, 0, 0.76, 0) }, 14, 36)
	return holder
end

local function title(root: Instance): Frame
	local holder = frame(root, "Title", {})
	local visual = frame(holder, "Visual", { Size = UDim2.fromScale(1, 1) })
	local sc = Instance.new("UIScale")
	sc.Name = "CosmeticScale"
	sc.Parent = visual
	scales.Title = sc
	local a = words(visual, "FindTheLabel", "FIND THE", { Position = UDim2.fromScale(0.12, 0), Size = UDim2.fromScale(0.76, 0.42) }, 12, 48)
	local b = words(visual, "PetLabel", "PET", { Position = UDim2.fromScale(0.2, 0.36), Size = UDim2.fromScale(0.6, 0.64), TextColor3 = YELLOW }, 16, 80)
	for _, l in { a, b } do
		(l:FindFirstChildOfClass("UIStroke") :: UIStroke).Thickness = 3.5
	end
	return holder
end

local function statusLine(root: Instance): Frame
	local holder = frame(root, "Status", { Visible = false })
	local body = frame(holder, "Body", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromHex("10245E"), BackgroundTransparency = 0.1 })
	corner(body, 999)
	stroke(body, CYAN, 2)
	words(holder, "Text", "", { Position = UDim2.fromScale(0.04, 0.1), Size = UDim2.fromScale(0.92, 0.8) }, 10, 22)
	return holder
end

local function place()
	local sg = gui
	local root = sg and sg:FindFirstChild("SafeHUDRoot") :: Frame?
	local scale = root and root:FindFirstChild("Scale") :: UIScale?
	if not sg or not root or not scale then
		return
	end
	-- own fit from this layer's real size (UI.scaleFor rule), so the logical canvas always matches the screen
	local v = sg.AbsoluteSize
	if v.X < 2 or v.Y < 2 then
		local cam = Workspace.CurrentCamera
		v = if cam then cam.ViewportSize else Vector2.new(800, 400)
	end
	local k = UI.scaleFor(v)
	scale.Scale = k
	local w, h = v.X / k, v.Y / k
	root.Size = UDim2.fromOffset(w, h)
	local lay = LobbyHudLayout.layout(w, h, k, true)
	for name, r in lay do
		local p = pieces[name]
		if p then
			p.Position = UDim2.fromOffset(r.x, r.y)
			p.Size = UDim2.fromOffset(r.w, r.h)
		end
	end
end

-- a short entrance: each group rises a few px and fades in, a little after the last
local function entrance()
	if not motion() then
		return
	end
	local groups = { { "Coins", "Title" }, { "MyPets", "PetBook" }, { "Daily", "Spin", "Shop" }, { "Train", "Play", "Fight" } }
	for i, group in groups do
		for _, n in group do
			local sc = scales[n]
			if sc then
				sc.Scale = 0.85
				task.delay((i - 1) * 0.06, function()
					tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
				end)
			end
		end
	end
end

-- one sparing light sweep across PLAY now and then
local function shineLoop()
	task.spawn(function()
		while gui and gui.Parent do
			task.wait(6)
			local play = pieces.Play
			local shine = play and play:FindFirstChild("Shine", true) :: Frame?
			if shown and shine and motion() then
				shine.Position = UDim2.new(-0.3, 0, -0.3, 0)
				tween(shine, 0.7, { Position = UDim2.new(1.2, 0, -0.3, 0) }, Enum.EasingStyle.Sine)
			end
		end
	end)
end

local function build()
	local sg = Instance.new("ScreenGui")
	sg.Name = "LobbyHudV2"
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = false
	sg.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.DisplayOrder = 6
	sg.Enabled = false
	-- the UIScale sits on the root frame (not the ScreenGui) so the root's logical canvas scales from its corner
	local root = frame(sg, "SafeHUDRoot", {})
	local scale = Instance.new("UIScale")
	scale.Name = "Scale"
	scale.Scale = UI.Scale
	scale.Parent = root
	pieces.Coins = coins(root)
	pieces.Title = title(root)
	pieces.Status = statusLine(root)
	for name, spec in SPECS do
		pieces[name] = button(root, name, spec)
	end
	sg.Parent = player:WaitForChild("PlayerGui")
	gui = sg
	place()
	sg:GetPropertyChangedSignal("AbsoluteSize"):Connect(place)
	shineLoop()
	idleLoop()
end

local function inLobby(): boolean
	return player:GetAttribute("MatchKey") == nil and player:GetAttribute("InTower") ~= true and player:GetAttribute("InBattle") ~= true
end

-- a big card (NEXT GOAL, away nest) is up: the HUD steps aside so the card never sits over PLAY (Studio 2026-10-15)
local function bigCard(): boolean
	local pg = player:FindFirstChild("PlayerGui")
	local layer = pg and pg:FindFirstChild("CrackTheRocksDialog")
	if layer then
		for _, n in PopupRules.Cards do
			if layer:FindFirstChild(n) then
				return true
			end
		end
	end
	return false
end

local lastLobby = false
local function refresh()
	local lobby = Workspace:GetAttribute(LobbyHudV2.Attr) ~= false and inLobby()
	local want = lobby and not UI.blocked() and not bigCard()
	if want and not gui then
		build()
	end
	local sg = gui
	if sg then
		sg.Enabled = want
	end
	local a = actions
	if a then
		a.hideOld(lobby)
	end
	-- the emote corner steps aside in the lobby (it sat on FIGHT); only what this module turned off comes back
	local pg = player:FindFirstChild("PlayerGui")
	local hang = pg and pg:FindFirstChild("CT_Hangout")
	if hang and hang:IsA("ScreenGui") then
		if lobby then
			if hang.Enabled then
				hang.Enabled = false
				stepped[hang] = true
			end
		elseif stepped[hang] then
			hang.Enabled = true
			stepped[hang] = nil
		end
	end
	if shown and not want then
		idleStopAll() -- a menu covers the HUD (or we left the lobby): everything back at rest
	end
	if want and not shown then
		place()
		if not lastLobby then
			entrance() -- the pop-in plays on arrival in the lobby, not after every menu closes
		end
	end
	shown = want
	lastLobby = lobby
end

-- coins and the queue line, a few times a second while showing
local function tick()
	local root = gui and gui:FindFirstChild("SafeHUDRoot")
	if not root or not shown then
		return
	end
	local prof: any = State.Profile
	local amount = root:FindFirstChild("AmountLabel", true) :: TextLabel?
	if amount and prof and type(prof.Cash) == "number" then
		local t = UI.num(prof.Cash)
		if amount.Text ~= t then
			amount.Text = t
		end
	end
	-- the old HUD's top-centre card (first-hunt hint, objective) keeps its place: the title steps aside for it
	local top = UI.screen():FindFirstChild("Top") :: GuiObject?
	local title = pieces.Title
	if title then
		title.Visible = not (top and top.Visible and top.AbsoluteSize.Y > 4)
	end
	local st = pieces.Status
	local a = actions
	local line = if a then a.status() else nil
	if st then
		st.Visible = line ~= nil
		local label = st:FindFirstChild("Text") :: TextLabel?
		if label and line and label.Text ~= line then
			label.Text = line
		end
	end
end

function LobbyHudV2.start(a: Actions)
	actions = a
	Workspace:GetAttributeChangedSignal(LobbyHudV2.Attr):Connect(refresh)
	task.spawn(function()
		while true do
			task.wait(0.25)
			refresh() -- menus opening / closing (UI.blocked) have no single signal
			tick()
		end
	end)
	for _, a in { "MatchKey", "InTower", "InBattle" } do
		player:GetAttributeChangedSignal(a):Connect(refresh)
	end
	refresh()
end

-- for the preview scene and tests
function LobbyHudV2.pieces(): { [string]: Frame }
	return pieces
end

-- play one button's idle move now (preview scene)
function LobbyHudV2.idle(name: string)
	task.spawn(idlePlay, name)
end

return LobbyHudV2
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="359">
            <Properties>
              <string name="Name">MaterialThumb</string>
              <string name="Source"><![CDATA[--!strict
-- Thumbnail for one ordinary-material category (Config.Materials), drawn from frames: no asset ids.
-- Found: the category's real colours. Unfound: one restrained silhouette that tells nothing about the material.
-- Quartz is a SOLID faceted chip (never a hollow geode); metallic specks are small bright flecks on grey stone.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local UI = require(script.Parent.UI)

local MaterialThumb = {}

local SILHOUETTE = Color3.fromRGB(208, 198, 180)
local SILHOUETTE_EDGE = Color3.fromRGB(190, 178, 156)

local function piece(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, rot: number, round: number): Frame
	local f = UI.frame(parent, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(w, h),
		BackgroundColor3 = color,
		Rotation = rot,
	})
	UI.corner(f, round)
	return f
end

function MaterialThumb.make(parent: Instance, id: string, found: boolean, size: number, props: { [string]: any }?): Frame
	local mat = Config.Materials[id]
	local box = UI.frame(parent, { Name = "MaterialThumb", Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	if props then
		for k, v in props do
			(box :: any)[k] = v
		end
	end
	local r = math.max(3, math.floor(size * 0.18))
	local look = if mat then mat.Look else "stone"
	if not found or not mat then
		-- silhouette: the same plain stone outline for every unknown entry
		piece(box, 0.5, 0.56, 0.78, 0.6, SILHOUETTE_EDGE, 0, r)
		piece(box, 0.5, 0.54, 0.7, 0.52, SILHOUETTE, 0, r)
		return box
	end
	local base = mat.Color
	local dark = base:Lerp(Color3.new(0, 0, 0), 0.28)
	local light = mat.Accent
	if look == "chip" then
		-- a solid faceted chip: two overlapping rotated blocks and a highlight facet
		piece(box, 0.5, 0.56, 0.62, 0.62, dark, 45, math.max(2, r - 2))
		piece(box, 0.5, 0.52, 0.56, 0.56, base, 45, math.max(2, r - 2))
		piece(box, 0.4, 0.4, 0.22, 0.22, light, 45, 2)
	else
		piece(box, 0.5, 0.58, 0.8, 0.58, dark, 0, r)
		piece(box, 0.5, 0.54, 0.72, 0.5, base, 0, r)
		piece(box, 0.38, 0.42, 0.26, 0.14, light:Lerp(base, 0.55), 0, 3)
		if look == "specks" then
			for _, p in { { 0.62, 0.5, 0.1 }, { 0.46, 0.62, 0.08 }, { 0.72, 0.62, 0.07 }, { 0.34, 0.54, 0.07 }, { 0.58, 0.4, 0.06 } } do
				piece(box, p[1], p[2], p[3], p[3], light, 0, 99)
			end
		end
	end
	return box
end

return MaterialThumb
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="360">
            <Properties>
              <string name="Name">ModelThumb</string>
              <string name="Source"><![CDATA[--!strict
-- Still ViewportFrame thumbnails of the game's own Blender kit models (Rock_* names show a procedural egg) (ReplicatedStorage.Assets.Kit, see
-- shared/KitModels) for catalog rows and previews: the carry basket, a rock, the station tray, the rubble bin,
-- the gallery cabinet. One static render each (no spin, no physics, nothing per frame); the frame owns the
-- clone, so destroying the screen frees it. When the kit model is not loaded the drawn icon is used instead.
-- Never an invented asset id.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local KitModels = require(Shared.KitModels)
local GeodeModel = require(Shared.GeodeModel)
local UI = require(script.Parent.UI)

local ModelThumb = {}

-- kit name -> (yaw degrees, pitch degrees)
local POSE = {
	Basket_Filled = { -24, 22 },
	Basket_Empty = { -24, 22 },
	Rock_03_SquatBoulder = { -30, 18 },
	Station_InputTray = { -28, 28 },
	Station_RubbleBin = { -28, 20 },
	Prop_StoneBin = { -28, 20 },
	Gallery_Cabinet = { -18, 10 },
	Gallery_Shelf = { -18, 12 },
	Gallery_Showcase = { -18, 12 },
}

-- Returns the container (a ViewportFrame, or a frame holding the fallback icon). `size` sizes the fallback icon.
function ModelThumb.make(parent: Instance, kitName: string, fallbackIcon: string, size: number, props: { [string]: any }?): GuiObject
	-- rocks are eggs now (Find The Pet): a procedural spotted egg instead of the quarry rock mesh
	local m: Model? = if string.sub(kitName, 1, 5) == "Rock_" then GeodeModel.rockShell(1, 2, kitName, { Tint = 3 }) else KitModels.clone(kitName)
	if not m then
		local holder = UI.frame(parent, { Name = "Thumb", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
		UI.apply(holder, props)
		UI.icon(holder, fallbackIcon, size, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		return holder
	end
	local vp = Instance.new("ViewportFrame")
	vp.Name = "Thumb"
	vp.BackgroundTransparency = 1
	vp.Size = UDim2.fromScale(1, 1)
	vp.Ambient = Color3.fromRGB(150, 148, 144)
	vp.LightColor = Color3.fromRGB(255, 244, 228)
	vp.LightDirection = Vector3.new(-0.45, -0.7, 0.55)
	UI.apply(vp, props)
	vp.Parent = parent
	local pose = POSE[kitName] or { -26, 18 }
	m:PivotTo(CFrame.Angles(0, math.rad(pose[1]), 0))
	m.Parent = vp
	local cf, ext = m:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.Parent = vp
	vp.CurrentCamera = cam
	local radius = ext.Magnitude / 2 * 0.92
	local dist = radius / math.tan(math.rad(15))
	local pitch = math.rad(pose[2])
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, math.sin(pitch) * dist, -math.cos(pitch) * dist), cf.Position)
	return vp
end

return ModelThumb
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="361">
            <Properties>
              <string name="Name">MyPetsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- MY PETS (carter's low-poly reference, 2026-10-15): the one team and the pet collection.
--   YOUR TEAM   three slots: the ONE team (profile EquippedPets, Config.Pets.Slots = 3) that follows you in the lobby
--               and fights in the Training Tower and Pet Battles. Tap a slot = select that pet.
--   toolbar     pets owned / storage, search by name, sort (Power, Rarity, Level, Newest)
--   grid        every pet as a card (real 3D pet, full name, POWER); a green tick = on the team, a white outline =
--               selected (two different marks)
--   EQUIP BEST  the server fills the team with the highest POWER pets (PetService, PetRules.best)
--   pet panel   the selected pet: full name, rarity, big 3D picture (drag to turn), ON TEAM / ON DISPLAY roles, POWER,
--               level and XP to the next level, EQUIP / UNEQUIP, DISPLAY (plot dome, its own thing), favourite star
-- A full team never swaps a pet silently: EQUIP asks which slot (the team slots light up) and the server swaps only
-- the slot picked (PetRules.swapSlot). The client sends intents only; the server decides.
-- Look: carter's low-poly frame pictures (shared/MyPetsArt, 2026-10-16): the main frame, the pet panel frame, a frame
-- per rarity on every card (the cyan selected frame on the picked card), team slot frames, blank lime / orange / blue
-- buttons with live white lettering, the red X and the gold star. Every frame is a nine-sliced border drawn ABOVE a
-- native backing, with the live content inside its opening; decorations never take taps. Until the pictures are
-- uploaded (id 0) the same pieces are drawn natively (faceted gradients, thick navy outline). The paw on the title is
-- carter's MY PETS button picture.
-- Layout: shared/MyPetsLayout (tested on PC, landscape and upright phones).

local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local GeodeGen = require(Shared.GeodeGen)
local Net = require(Shared.Net)
local PetRules = require(Shared.PetRules)
local PetStats = require(Shared.PetStats)
local PetStatView = require(Shared.PetStatView)
local TowerConfig = require(Shared.TowerConfig)
local MyPetsLayout = require(Shared.MyPetsLayout)
local LobbyHudArt = require(Shared.LobbyHudArt)
local MyPetsArt = require(Shared.MyPetsArt)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local GeodeView = require(script.Parent.GeodeView)

type Pet = { [string]: any }
type Rect = MyPetsLayout.Rect

local MyPets = {}
MyPets.Debug = false
MyPets.onDisplayFull = nil :: ((string) -> ())? -- Main: the Pet Book's display tab, placing this pet

local NAVY = Color3.fromHex("071747")
local NAVY_SOFT = Color3.fromHex("10245E")
local CYAN = Color3.fromHex("25E8FF")
local SKY = Color3.fromHex("009DFF")
local SKY_LIGHT = Color3.fromHex("4FC3FF")
local LIME = Color3.fromHex("80FF32")
local LIME_DARK = Color3.fromHex("3FBF1A")
local ORANGE = Color3.fromHex("FFA008")
local RED = Color3.fromHex("FF3B3B")
local GOLD = Color3.fromHex("FFD72D")
local WHITE = Color3.new(1, 1, 1)
local VOID = Color3.fromRGB(112, 52, 210)
local TICK = Color3.fromHex("7CFF3A")

local SORTS = { "Power", "Rarity", "Level", "Newest" }
local PAGE = 30

local open = false
local panelRef: Frame? = nil
local canvas: Frame? = nil
local closeFn: (() -> ())? = nil
local selected: string? = nil
local search = ""
local sortBy = "Power"
local shownCount = PAGE
local swapFor: string? = nil -- a pet waiting to join a full team: the player picks the slot
local refs: { [string]: any } = {}
local lay: MyPetsLayout.Layout = {}

local function act(action: string, a: any?, b: any?)
	Net.event("CollectionAction"):FireServer(action, a, b)
end

local function prof(): { [string]: any }?
	return State.Profile :: any
end

local function motion(): boolean
	return not UI.Reduced
end

-- Low-poly kit ---------------------------------------------------------------------------------------------------

local function place(obj: GuiObject, r: Rect)
	obj.Position = UDim2.fromOffset(math.floor(r.x), math.floor(r.y))
	obj.Size = UDim2.fromOffset(math.floor(r.w), math.floor(r.h))
end

local function darker(c: Color3, k: number): Color3
	return Color3.new(c.R * k, c.G * k, c.B * k)
end

local function lighter(c: Color3, k: number): Color3
	return c:Lerp(WHITE, k)
end

-- flat triangular planes: a hard-stepped gradient across the face (no gloss), two tones of `base`
local function facets(obj: GuiObject, base: Color3, angle: number?)
	local a, b, c = lighter(base, 0.18), base, darker(base, 0.88)
	local g = Instance.new("UIGradient")
	g.Name = "Facets"
	g.Rotation = angle or 32
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, a),
		ColorSequenceKeypoint.new(0.3, a),
		ColorSequenceKeypoint.new(0.3001, b),
		ColorSequenceKeypoint.new(0.55, b),
		ColorSequenceKeypoint.new(0.5501, lighter(base, 0.08)),
		ColorSequenceKeypoint.new(0.78, lighter(base, 0.08)),
		ColorSequenceKeypoint.new(0.7801, c),
		ColorSequenceKeypoint.new(1, c),
	})
	g.Parent = obj
end

-- a chunky low-poly plate: faceted face, thick navy outline, and a navy lower edge drawn as a sibling just under it
-- (a child would draw on top of the face), kept in step with the face's place
local function plate(parent: Instance, name: string, color: Color3, props: { [string]: any }?, edge: number?): Frame
	local drop = UI.frame(parent, { Name = name .. "Drop", BackgroundColor3 = NAVY, BackgroundTransparency = 0 })
	UI.corner(drop, 7)
	local f = UI.frame(parent, { Name = name, BackgroundColor3 = WHITE, BackgroundTransparency = 0 })
	if props then
		for k, v in props do
			(f :: any)[k] = v
		end
	end
	drop.ZIndex = math.max(f.ZIndex - 1, 1)
	UI.corner(f, 7)
	local s = Instance.new("UIStroke")
	s.Name = "Edge"
	s.Color = NAVY
	s.Thickness = edge or 3
	s.LineJoinMode = Enum.LineJoinMode.Miter
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = f
	facets(f, color)
	local function sync()
		drop.Position = f.Position + UDim2.fromOffset(0, 4)
		drop.Size = f.Size
		drop.AnchorPoint = f.AnchorPoint
	end
	f:GetPropertyChangedSignal("Position"):Connect(sync)
	f:GetPropertyChangedSignal("Size"):Connect(sync)
	f.Destroying:Connect(function()
		drop:Destroy()
	end)
	sync()
	return f
end

local function words(parent: Instance, text: string, size: number, props: { [string]: any }?): TextLabel
	local p: { [string]: any } = { Font = UI.Head, TextSize = size, TextColor3 = WHITE, Outline = "Strong", TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1) }
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	local l = UI.text(parent, text, p)
	return l
end

-- a frame / button picture from carter's art pack, or nil while it is not uploaded. `border` (logical px) = nine-slice
-- the picture so its left border is that wide; nil = the whole picture fitted (the X and the star). A button's
-- slice follows its height (`follow`), so it keeps its bevelled ends at any width.
local function art(parent: Instance, key: string, name: string, z: number, border: number?, follow: boolean?): ImageLabel?
	local piece = MyPetsArt.get(key)
	if not piece then
		return nil
	end
	local img = Instance.new("ImageLabel")
	img.Name = name
	img.BackgroundTransparency = 1
	img.Image = "rbxassetid://" .. piece.Id
	img.Active = false
	img.Size = UDim2.fromScale(1, 1)
	img.ZIndex = z
	if follow and parent:IsA("GuiObject") then
		local x0, y0, x1, y1 = MyPetsArt.slice(piece)
		img.ScaleType = Enum.ScaleType.Slice
		img.SliceCenter = Rect.new(x0, y0, x1, y1)
		local host = parent :: GuiObject
		local function fit()
			img.SliceScale = math.max(host.Size.Y.Offset, 8) / piece.H
		end
		host:GetPropertyChangedSignal("Size"):Connect(fit)
		fit()
	elseif border then
		local x0, y0, x1, y1 = MyPetsArt.slice(piece)
		img.ScaleType = Enum.ScaleType.Slice
		img.SliceCenter = Rect.new(x0, y0, x1, y1)
		img.SliceScale = MyPetsArt.scaleFor(piece, border)
	else
		img.ScaleType = Enum.ScaleType.Fit
	end
	img.Parent = parent
	return img
end

-- the native backing under a frame picture: a faceted face tucked under the frame's border
local function backing(parent: Instance, color: Color3, inset: number, z: number): Frame
	local f = UI.frame(parent, { Name = "Backing", BackgroundColor3 = WHITE, BackgroundTransparency = 0, Position = UDim2.fromOffset(inset, inset), Size = UDim2.new(1, -2 * inset, 1, -2 * inset), ZIndex = z })
	UI.corner(f, 8)
	facets(f, color)
	return f
end

-- a press-squash button (one piece; the hit box never moves)
local function pressy(b: GuiButton)
	local sc = Instance.new("UIScale")
	sc.Name = "Press"
	sc.Parent = b
	local function go(s: number, t: number, style: Enum.EasingStyle?)
		if motion() then
			TweenService:Create(sc, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = s }):Play()
		else
			sc.Scale = 1
		end
	end
	b.MouseButton1Down:Connect(function()
		go(0.94, 0.06)
	end)
	b.MouseButton1Up:Connect(function()
		go(1, 0.16, Enum.EasingStyle.Back)
	end)
	b.MouseLeave:Connect(function()
		go(1, 0.12)
	end)
end

-- `skin` = the art pack button behind the label (Lime / Orange / Blue; Close and Fav carry their own symbol, so they
-- get no label at all); without the picture the button is drawn in `color`
local function button(parent: Instance, name: string, text: string, color: Color3, onTap: () -> (), size: number?, skin: string?): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = ""
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.BackgroundColor3 = WHITE
	b.Parent = parent
	local symbol = skin == "Close" or skin == "Fav"
	local pic = if skin then art(b, skin, "Art", 1, nil, not symbol) else nil
	if pic then
		b.BackgroundTransparency = 1
		b:SetAttribute("Art", skin)
	else
		UI.corner(b, 7)
		local s = Instance.new("UIStroke")
		s.Name = "Edge"
		s.Color = NAVY
		s.Thickness = 3
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		s.Parent = b
		facets(b, color)
	end
	if pic and symbol then
		pressy(b)
		b.Activated:Connect(onTap)
		return b
	end
	local l = words(b, text, size or 20, { Name = "Label", Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 1, -8), ZIndex = 2 })
	l.TextWrapped = false
	pressy(b)
	b.Activated:Connect(onTap)
	return b
end

local function rarityColor(g: Pet): Color3
	if TowerConfig.CapSpecies[g.Mineral] then
		return VOID
	end
	return (Config.RarityColors :: any)[g.Rarity] or SKY
end

local function rarityWord(g: Pet): string
	if TowerConfig.CapSpecies[g.Mineral] then
		return "VOID"
	end
	return string.upper(tostring(g.Rarity or "?"))
end

-- the full name (nickname first when the pet has one), never cut short
local function fullName(g: Pet): string
	local species = GeodeGen.displayName(g :: any)
	if type(g.Nickname) == "string" and g.Nickname ~= "" then
		return g.Nickname .. " (" .. species .. ")"
	end
	return species
end

-- Data -------------------------------------------------------------------------------------------------------------

local function pets(): { Pet }
	local p = prof()
	return (p and type(p.Inventory) == "table" and p.Inventory) or {}
end

local function team(): { string }
	local p = prof()
	return (p and type(p.EquippedPets) == "table" and p.EquippedPets) or {}
end

local function slots(): number
	local p = prof()
	return (p and tonumber(p.PetSlots)) or Config.Pets.Slots
end

local function find(id: string?): Pet?
	if not id then
		return nil
	end
	for _, g in pets() do
		if g.Id == id then
			return g
		end
	end
	return nil
end

local function onTeam(id: string): boolean
	return table.find(team(), id) ~= nil
end

local function onDisplay(id: string): boolean
	local p = prof()
	return p ~= nil and type(p.DisplayAssignments) == "table" and table.find(p.DisplayAssignments, id) ~= nil
end

local function power(g: Pet): number
	return PetStatView.power(g) or 0
end

-- matching pets, sorted (Power: biggest first; ties newest, as PetRules.sort)
local function list(): { Pet }
	local out = {}
	local q = string.lower(search)
	for _, g in pets() do
		if q == "" or string.find(string.lower(fullName(g)), q, 1, true) then
			table.insert(out, g)
		end
	end
	if sortBy == "Power" then
		PetRules.sort(out, "Newest")
		local pw: { [any]: number } = {}
		for _, g in out do
			pw[g] = power(g)
		end
		local order: { [any]: number } = {}
		for i, g in out do
			order[g] = i
		end
		table.sort(out, function(a, b)
			if pw[a] ~= pw[b] then
				return pw[a] > pw[b]
			end
			return order[a] < order[b]
		end)
	else
		PetRules.sort(out, sortBy)
	end
	return out
end

-- level, cap and the share of the way to the next level (full at the cap), from the real tower XP
local function levelInfo(g: Pet): (number, number, number)
	local cap = PetStats.cap(g :: any)
	local xp = if type(g.TowerXP) == "number" then g.TowerXP else 0
	local lv, into, need = PetStats.level(xp, cap)
	local frac = if need > 0 then math.clamp(into / need, 0, 1) else 1
	return lv, cap, frac
end

-- Pieces -----------------------------------------------------------------------------------------------------------

-- the real 3D pet fitted by its own bounds (GeodeView.frame), so big and small species both fill the picture
local function petPicture(parent: Instance, g: Pet, name: string, drag: boolean?, margin: number?): ViewportFrame
	local vp, model, cam = GeodeView.make(parent, g, { Name = name, Size = UDim2.fromScale(1, 1), ZIndex = 3 }, drag)
	GeodeView.frame(cam, model, margin or 0.66)
	return vp
end

local function tick(parent: Instance, size: number): TextLabel
	local t = words(parent, "\u{2714}", size, { Name = "OnTeam", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 2), Size = UDim2.fromOffset(size + 6, size + 6), TextColor3 = TICK, ZIndex = 8 })
	t.TextWrapped = false
	return t
end

local refresh: () -> ()

local function select(id: string?)
	if selected ~= id then
		selected = id
		refresh()
	end
end

local function slotTapped(i: number)
	local id = team()[i]
	if swapFor then
		act("EquipPet", swapFor, i) -- the server swaps exactly this slot
		selected = swapFor
		swapFor = nil
		refresh()
		return
	end
	if id then
		select(id)
	end
end

local function drawTeam()
	local holder = refs.Slots :: Frame
	holder:ClearAllChildren()
	local ids = team()
	for i = 1, 3 do
		local r = lay["Slot" .. i]
		if not r then
			continue
		end
		local t = lay.Team
		local local_ = { x = r.x - t.x, y = r.y - t.y, w = r.w, h = r.h }
		local g = find(ids[i])
		local usable = i <= slots()
		local hit = Instance.new("TextButton")
		hit.Name = "Slot" .. i
		hit.Text = ""
		hit.AutoButtonColor = false
		hit.BackgroundTransparency = 1
		hit.ZIndex = 10
		hit.Parent = holder
		place(hit, local_)
		local face: Frame
		local slotArt = MyPetsArt.get("Slot")
		if slotArt then
			-- the slot frame picture over a rarity-coloured face; the pet, number and tick sit on top
			face = UI.frame(holder, { Name = "SlotFace" .. i, BackgroundTransparency = 1, ZIndex = 2 })
			place(face, local_)
			local bw = math.max(local_.w * 0.1, 6)
			backing(face, if g then rarityColor(g) else NAVY_SOFT, bw * 0.6, 1)
			art(face, "Slot", "Frame", 5, bw)
		else
			face = plate(holder, "SlotFace" .. i, if g then rarityColor(g) else NAVY_SOFT, { ZIndex = 2 })
			place(face, local_)
		end
		if g then
			petPicture(face, g, "Pet")
			tick(face, 18)
		elseif usable then
			words(face, "+", 30, { Name = "Empty", TextTransparency = 0.4, ZIndex = 4 })
		end
		local num = UI.frame(face, { Name = "Num", BackgroundColor3 = NAVY, BackgroundTransparency = 0, Position = UDim2.fromOffset(3, 3), Size = UDim2.fromOffset(22, 22), ZIndex = 6 })
		UI.corner(num, 11)
		words(num, tostring(i), 14, { Name = "N", ZIndex = 7 })
		if swapFor then
			local glow = Instance.new("UIStroke")
			glow.Name = "SwapGlow"
			glow.Color = GOLD
			glow.Thickness = 4
			glow.Parent = hit
			words(face, "SWAP", 16, { Name = "Swap", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -2), Size = UDim2.new(1, -4, 0, 20), TextColor3 = GOLD, ZIndex = 8 })
		end
		hit.Activated:Connect(function()
			slotTapped(i)
		end)
	end
	local note = refs.TeamNote :: TextLabel
	note.Text = if swapFor then "Tap a slot to swap!" else "Follows you \u{2022} Battles with you"
	note.TextColor3 = if swapFor then GOLD else WHITE
end

local cardSize = Vector2.new(120, 100)

local function card(parent: Instance, g: Pet, i: number)
	local c = Instance.new("TextButton")
	c.Name = "Card"
	c.LayoutOrder = i
	c.Text = ""
	c.AutoButtonColor = false
	c.BackgroundColor3 = WHITE
	c.Parent = parent
	local sel = g.Id == selected
	if sel then
		c:SetAttribute("Selected", true)
	end
	local key = MyPetsArt.cardKey(g.Rarity, TowerConfig.CapSpecies[g.Mineral] ~= nil)
	local piece = MyPetsArt.get(if sel then "Selected" else key)
	local content: Frame
	local contentH = cardSize.Y - 6
	if piece then
		-- art: a rarity-coloured backing, the live pet / name / POWER clipped to the frame's opening, the frame on top
		-- (the selected card swaps its rarity frame for the cyan selected frame, never two thick borders)
		c.BackgroundTransparency = 1
		local bw = MyPetsLayout.cardBorder(cardSize.X)
		local k = MyPetsArt.scaleFor(piece, bw)
		local l, t, r, b = MyPetsArt.opening(piece, k)
		backing(c, rarityColor(g), bw * 0.55, 1)
		contentH = cardSize.Y - math.floor(t + b)
		content = UI.frame(c, { Name = "Content", BackgroundTransparency = 1, ClipsDescendants = true, Position = UDim2.fromOffset(math.floor(l), math.floor(t)), Size = UDim2.new(1, -math.floor(l + r), 1, -math.floor(t + b)), ZIndex = 2 })
		local frame = art(c, if sel then "Selected" else key, "Frame", 6, bw)
		if frame then
			frame:SetAttribute("Rarity", key)
		end
	else
		UI.corner(c, 7)
		facets(c, rarityColor(g))
		local edge = Instance.new("UIStroke")
		edge.Name = "Edge"
		edge.Color = if sel then WHITE else NAVY
		edge.Thickness = if sel then 5 else 3
		edge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		edge.Parent = c
		if sel then
			local ring = Instance.new("Frame")
			ring.Name = "SelectedRing"
			ring.BackgroundTransparency = 1
			ring.Size = UDim2.new(1, 8, 1, 8)
			ring.Position = UDim2.fromOffset(-4, -4)
			ring.Parent = c
			UI.corner(ring, 10)
			local rs = Instance.new("UIStroke")
			rs.Color = CYAN
			rs.Thickness = 3
			rs.Parent = ring
		end
		content = UI.frame(c, { Name = "Content", BackgroundTransparency = 1, Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6), ZIndex = 2 })
	end
	-- name over POWER in a navy band along the bottom: tall enough for a readable name on the flattest phone card
	local bandH = math.clamp(math.floor(contentH * 0.5), 34, 50)
	local pic = UI.frame(content, { Name = "Picture", Size = UDim2.new(1, 0, 1, -bandH + 6), BackgroundTransparency = 1, ZIndex = 2 })
	petPicture(pic, g, "Pet")
	local band = UI.frame(content, { Name = "Band", BackgroundColor3 = NAVY, BackgroundTransparency = 0.25, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, bandH), ZIndex = 4 })
	UI.corner(band, 5)
	local nameH = math.floor(bandH * 0.46)
	local nm = words(band, fullName(g), 16, { Name = "Name", Position = UDim2.fromOffset(3, 1), Size = UDim2.new(1, -6, 0, nameH), ZIndex = 5 })
	UI.fit(nm, 16, 9)
	UI.oneLine(nm, 8) -- "Skeleton Thunderstrut" wrapped and showed only "Skeleton"
	words(band, UI.num(power(g)), 22, { Name = "Power", Position = UDim2.fromOffset(0, nameH + 1), Size = UDim2.new(1, 0, 1, -nameH - 2), TextColor3 = WHITE, ZIndex = 5 })
	if onTeam(g.Id) then
		tick(c, 20)
	end
	if g.Favorite == true then
		local st = words(c, "\u{2605}", 18, { Name = "Fav", Position = UDim2.fromOffset(5, 3), Size = UDim2.fromOffset(22, 22), TextColor3 = GOLD, ZIndex = 8 })
		st.TextWrapped = false
	end
	pressy(c)
	c.Activated:Connect(function()
		select(g.Id)
	end)
end

local function drawGrid()
	local grid = refs.Grid :: ScrollingFrame
	for _, ch in grid:GetChildren() do
		if not ch:IsA("UIGridLayout") and not ch:IsA("UIPadding") then
			ch:Destroy()
		end
	end
	local all = list()
	local count = refs.Count :: TextLabel
	local p = prof()
	count.Text = tostring(#pets()) .. " / " .. tostring((p and p.InventoryMax) or Config.Inventory.Max)
	if #all == 0 then
		words(grid, if #pets() == 0 then "No pets yet! Tap PLAY to find one." else "No pet called that.", 18, { Name = "Empty", Size = UDim2.new(1, 0, 0, 60), LayoutOrder = 1 })
		return
	end
	for i, g in all do
		if i > shownCount then
			local more = button(grid, "More", "MORE (" .. (#all - shownCount) .. ")", SKY, function()
				shownCount += PAGE
				drawGrid()
			end, 18)
			more.LayoutOrder = i
			break
		end
		card(grid, g, i)
	end
end

local function role(parent: Instance, text: string, color: Color3, order: number, width: number?)
	local chip = UI.frame(parent, { Name = "Role", BackgroundColor3 = color, BackgroundTransparency = 0, Size = UDim2.fromOffset(width or 104, 22), LayoutOrder = order, ZIndex = 6 })
	UI.corner(chip, 6)
	local s = Instance.new("UIStroke")
	s.Color = NAVY
	s.Thickness = 2
	s.Parent = chip
	local l = words(chip, text, 12, { Name = "Text", Position = UDim2.fromOffset(4, 1), Size = UDim2.new(1, -8, 1, -2), ZIndex = 7 })
	UI.oneLine(l, 8)
end

local function drawDetail()
	local d = refs.Detail :: Frame
	for _, ch in d:GetChildren() do
		if ch.Name ~= "Edge" and ch.Name ~= "Facets" and ch.Name ~= "Drop" and ch.Name ~= "Backing" and ch.Name ~= "Frame" and not ch:IsA("UICorner") then
			ch:Destroy()
		end
	end
	local g = find(selected)
	local dr = lay.Detail
	local function at(n: string): (UDim2, UDim2)
		local r = lay[n]
		return UDim2.fromOffset(math.floor(r.x - dr.x), math.floor(r.y - dr.y)), UDim2.fromOffset(math.floor(r.w), math.floor(r.h))
	end
	if not g then
		words(d, if #pets() == 0 then "Find your first pet in a hunt!" else "Tap a pet to see it here.", 20, { Name = "None", Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0) })
		return
	end
	local pos, size = at("Name")
	-- the whole name on one line, shrunk to fit ("SHINY GOLDEN RAZORCLAW" wrapped and lost its last word on a phone)
	local nm = words(d, string.upper(fullName(g)), 38, { Name = "Name", Position = pos, Size = size })
	UI.fit(nm, 38, 12)
	UI.oneLine(nm, 10)
	pos, size = at("Badge")
	local badge = UI.frame(d, { Name = "Badge", Position = pos, Size = size, BackgroundColor3 = rarityColor(g), BackgroundTransparency = 0 })
	UI.corner(badge, 6)
	local bs = Instance.new("UIStroke")
	bs.Color = NAVY
	bs.Thickness = 2.5
	bs.Parent = badge
	local rw = words(badge, rarityWord(g), 16, { Name = "Rarity", Position = UDim2.fromOffset(4, 1), Size = UDim2.new(1, -8, 1, -2) })
	rw.TextWrapped = false
	UI.fit(rw, 16, 8)
	pos, size = at("Preview")
	local box = UI.frame(d, { Name = "Preview", Position = pos, Size = size, BackgroundTransparency = 1, ClipsDescendants = false })
	local shadow = UI.frame(box, { Name = "Floor", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.9), Size = UDim2.fromScale(0.7, 0.12), BackgroundColor3 = NAVY, BackgroundTransparency = 0.7 })
	UI.corner(shadow, 999)
	local vp = petPicture(box, g, "Pet", true, 0.6)
	if motion() then -- a slow gentle bob
		vp.Position = UDim2.fromOffset(0, 0)
		TweenService:Create(vp, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.fromOffset(0, -6) }):Play()
	end
	-- ON TEAM / ON DISPLAY: their own row on short screens (lay.Roles), else stacked in the picture's top corner,
	-- a step in from its edge so the frame never cuts a chip
	local chips: { { text: string, color: Color3 } } = {}
	if onTeam(g.Id) then
		table.insert(chips, { text = "ON TEAM", color = LIME_DARK })
	end
	if onDisplay(g.Id) then
		table.insert(chips, { text = "ON DISPLAY", color = SKY })
	end
	local rr = lay.Roles
	local roles: Frame
	local chipW = 104
	if rr then
		roles = UI.frame(d, { Name = "Roles", BackgroundTransparency = 1, Position = UDim2.fromOffset(math.floor(rr.x - dr.x), math.floor(rr.y - dr.y)), Size = UDim2.fromOffset(math.floor(rr.w), math.floor(rr.h)), ZIndex = 6 })
		UI.list(roles, Enum.FillDirection.Horizontal, 4)
		chipW = math.floor(math.min(104, (rr.w - 4 * (#chips - 1)) / math.max(#chips, 1)))
	else
		roles = UI.frame(box, { Name = "Roles", BackgroundTransparency = 1, Position = UDim2.fromOffset(4, 2), Size = UDim2.new(0, 108, 0, 50), ZIndex = 6 })
		UI.list(roles, Enum.FillDirection.Vertical, 4)
	end
	for i, c in chips do
		role(roles, c.text, c.color, i, chipW)
	end
	pos, size = at("PowerLabel")
	local pl = words(d, "POWER", 18, { Name = "PowerLabel", Position = pos, Size = size })
	pl.TextWrapped = false
	pos, size = at("Power")
	local pill = UI.frame(d, { Name = "Power", Position = pos, Size = size, BackgroundColor3 = NAVY, BackgroundTransparency = 0 })
	UI.corner(pill, 8)
	words(pill, UI.num(power(g)), 48, { Name = "Value", Position = UDim2.fromOffset(6, 1), Size = UDim2.new(1, -12, 1, -2), TextColor3 = GOLD })
	local lv, cap, frac = levelInfo(g)
	pos, size = at("Level")
	words(d, "Level " .. lv .. " / " .. cap, 18, { Name = "Level", Position = pos, Size = size })
	pos, size = at("Bar")
	local bar = UI.frame(d, { Name = "Bar", Position = pos, Size = size, BackgroundColor3 = NAVY, BackgroundTransparency = 0 })
	UI.corner(bar, 7)
	local fill = UI.frame(bar, { Name = "Fill", BackgroundColor3 = LIME, BackgroundTransparency = 0, Position = UDim2.fromOffset(2, 2), Size = UDim2.new(math.max(frac, 0.04), -4, 1, -4) })
	UI.corner(fill, 5)
	-- EQUIP / UNEQUIP / SWAP IN (full team: pick a slot)
	local mine = onTeam(g.Id)
	local full = #team() >= slots()
	local label = if mine then "UNEQUIP" elseif full then "SWAP IN" else "EQUIP"
	local actB = button(d, "Action", label, if mine or full then ORANGE else LIME_DARK, function()
		if mine then
			act("UnequipPet", g.Id)
		elseif full then
			swapFor = if swapFor == g.Id then nil else g.Id
			refresh()
		else
			act("EquipPet", g.Id)
		end
	end, 24, if mine or full then "Orange" else "Lime")
	pos, size = at("Action")
	actB.Position, actB.Size = pos, size
	local shown = onDisplay(g.Id)
	local disp = button(d, "Display", if shown then "TAKE OFF" else "DISPLAY", SKY, function()
		local p = prof()
		if shown then
			act("Display", g.Id, false)
		elseif p and type(p.DisplayAssignments) == "table" and #p.DisplayAssignments < (tonumber(p.DisplaySlots) or 0) then
			act("Display", g.Id, true)
		else
			-- the domes are full: the Pet Book's display tab asks which one to swap
			local f = MyPets.onDisplayFull
			if f then
				f(g.Id)
			end
		end
	end, 20, "Blue")
	pos, size = at("Display")
	disp.Position, disp.Size = pos, size
	local fav = button(d, "Fav", "\u{2605}", GOLD, function()
		act("Favorite", g.Id, not (g.Favorite == true))
	end, 26, "Fav")
	pos, size = at("Fav")
	fav.Position, fav.Size = pos, size
	local star = fav:FindFirstChild("Label") :: TextLabel?
	if star then
		star.TextColor3 = if g.Favorite == true then WHITE else NAVY_SOFT
	end
	local starArt = fav:FindFirstChild("Art") :: ImageLabel?
	if starArt then -- not a favourite yet: the gold star waits dimmed
		starArt.ImageTransparency = if g.Favorite == true then 0 else 0.45
	end
	fav:SetAttribute("On", g.Favorite == true)
end

refresh = function()
	if not open or not canvas then
		return
	end
	-- the selection follows the data: a sold or missing pet falls back to the first on the team, then the first pet
	if not find(selected) then
		selected = team()[1] or (pets()[1] and pets()[1].Id) or nil
	end
	if swapFor and (not find(swapFor) or onTeam(swapFor) or #team() < slots()) then
		swapFor = nil
	end
	drawTeam()
	drawGrid()
	drawDetail()
end

-- Build ----------------------------------------------------------------------------------------------------------

local function build(w: number, h: number)
	local c = canvas
	if not c then
		return
	end
	c:ClearAllChildren()
	lay = MyPetsLayout.layout(w, h)
	-- the backdrop: the main frame picture over a blue face (the frame sits above the content, the title and X above
	-- the frame, as in carter's art); without the picture, one big drawn cyan plate
	local border = MyPetsLayout.Border(w, h)
	if MyPetsArt.get("Main") then
		backing(c, SKY, border * 0.5, 1).Name = "Back"
		art(c, "Main", "Frame", 9, border)
	else
		plate(c, "Back", SKY, { Size = UDim2.fromScale(1, 1), ZIndex = 1 }, 4)
	end
	-- title: carter's paw picture + MY (white) PETS (gold)
	local title = UI.frame(c, { Name = "Title", BackgroundTransparency = 1, ZIndex = 11 })
	place(title, lay.Title)
	local th = math.min(lay.Title.h, lay.Title.w / 4.9) -- paw + MY + PETS always fit their box
	local paw = LobbyHudArt.image("MyPets")
	if paw then
		local img = Instance.new("ImageLabel")
		img.Name = "Paw"
		img.BackgroundTransparency = 1
		img.Image = paw
		img.ScaleType = Enum.ScaleType.Fit
		img.Size = UDim2.fromOffset(th, th)
		img.ZIndex = 11
		img.Parent = title
	end
	local my = words(title, "MY", 46, { Name = "My", Position = UDim2.fromOffset(th + 6, 0), Size = UDim2.fromOffset(math.floor(th * 1.25), th), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11 })
	my.TextWrapped = false
	local pt = words(title, "PETS", 46, { Name = "Pets", Position = UDim2.fromOffset(th + 10 + math.floor(th * 1.25), 0), Size = UDim2.fromOffset(math.floor(th * 2.4), th), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = GOLD, ZIndex = 11 })
	pt.TextWrapped = false
	local x = button(c, "Close", "X", RED, function()
		local f = closeFn
		if f then
			f()
		end
	end, 26, "Close")
	place(x, lay.Close)
	x.ZIndex = 11
	-- team strip
	local teamF = plate(c, "Team", SKY_LIGHT, { ZIndex = 2 })
	place(teamF, lay.Team)
	local tl = lay.TeamLabel
	local labelBox = UI.frame(teamF, { Name = "TeamLabel", BackgroundTransparency = 1, Position = UDim2.fromOffset(tl.x - lay.Team.x, tl.y - lay.Team.y), Size = UDim2.fromOffset(tl.w, tl.h), ZIndex = 3 })
	local slim = tl.h < 40 or tl.w < 170 -- short phones: just the words, EQUIP BEST sits beside or under them
	words(labelBox, "YOUR TEAM", 32, { Name = "Head", Size = UDim2.fromScale(1, if slim then 1 else 0.6), ZIndex = 3 })
	local note = words(labelBox, "Follows you \u{2022} Battles with you", 16, { Name = "Note", Position = UDim2.fromScale(0, 0.6), Size = UDim2.fromScale(1, 0.4), ZIndex = 3 })
	note.TextWrapped = false
	note.Visible = not slim -- the gold SWAP marks on the slots still show a swap
	UI.fit(note, 16, 9)
	refs.TeamNote = note
	local slotsF = UI.frame(teamF, { Name = "Slots", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 3 })
	refs.Slots = slotsF
	-- toolbar
	local countF = plate(c, "Count", NAVY_SOFT, { ZIndex = 2 })
	place(countF, lay.Count)
	refs.Count = words(countF, "0 / 0", 22, { Name = "Text", Position = UDim2.fromOffset(6, 1), Size = UDim2.new(1, -12, 1, -4) })
	local searchF = plate(c, "Search", Color3.fromHex("E8F6FF"), { ZIndex = 2 })
	place(searchF, lay.Search)
	local box = Instance.new("TextBox")
	box.Name = "Box"
	box.BackgroundTransparency = 1
	box.Font = UI.Bold
	box.PlaceholderText = "\u{1F50D} Search pets"
	box.PlaceholderColor3 = Color3.fromHex("6A7FA8")
	box.Text = search
	box.TextColor3 = NAVY
	box.TextScaled = true
	box.ClearTextOnFocus = false
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.Position = UDim2.fromOffset(10, 4)
	box.Size = UDim2.new(1, -20, 1, -10)
	box.Parent = searchF
	local lim = Instance.new("UITextSizeConstraint")
	lim.MaxTextSize = 20
	lim.MinTextSize = 12
	lim.Parent = box
	box:GetPropertyChangedSignal("Text"):Connect(function()
		search = string.sub(box.Text, 1, 30)
		shownCount = PAGE
		drawGrid()
	end)
	local sortB = button(c, "Sort", sortBy .. " \u{25BE}", Color3.fromHex("E8F6FF"), function() end, 18)
	place(sortB, lay.Sort)
	local sl = sortB:FindFirstChild("Label") :: TextLabel?
	if sl then
		sl.TextColor3 = NAVY
		local o = sl:FindFirstChild("Outline")
		if o then
			o:Destroy()
		end
	end
	sortB.Activated:Connect(function()
		local i = table.find(SORTS, sortBy) or 1
		sortBy = SORTS[i % #SORTS + 1]
		if sl then
			sl.Text = sortBy .. " \u{25BE}"
		end
		shownCount = PAGE
		drawGrid()
	end)
	-- grid
	local grid = UI.scroller(c, { Name = "Grid", ZIndex = 2 })
	place(grid, lay.Grid)
	local cols, cw, chh = MyPetsLayout.cards(lay.Grid.w, UI.ScrollBar, lay.Grid.h)
	cardSize = Vector2.new(cw, chh)
	local gl = Instance.new("UIGridLayout")
	gl.CellSize = UDim2.fromOffset(cw, chh)
	gl.CellPadding = UDim2.fromOffset(MyPetsLayout.Gap, MyPetsLayout.Gap)
	gl.SortOrder = Enum.SortOrder.LayoutOrder
	gl.FillDirectionMaxCells = cols
	gl.Parent = grid
	local gp = Instance.new("UIPadding")
	gp.PaddingTop = UDim.new(0, MyPetsLayout.GridPad.Top)
	gp.PaddingLeft = UDim.new(0, MyPetsLayout.GridPad.Side)
	gp.PaddingBottom = UDim.new(0, MyPetsLayout.GridPad.Bottom)
	gp.Parent = grid
	refs.Grid = grid
	-- equip best
	local best = button(c, "EquipBest", "EQUIP BEST", LIME_DARK, function()
		act("EquipBest")
	end, 30, "Lime")
	place(best, lay.EquipBest)
	best.ZIndex = 4 -- above the team strip when a short upright phone puts it there
	-- pet panel
	local det: Frame
	if MyPetsArt.get("Detail") then
		det = UI.frame(c, { Name = "Detail", BackgroundTransparency = 1, ZIndex = 2 })
		place(det, lay.Detail)
		local db = MyPetsLayout.detailBorder(lay.Detail)
		backing(det, SKY_LIGHT, db * 0.5, 0)
		art(det, "Detail", "Frame", 20, db)
	else
		det = plate(c, "Detail", SKY_LIGHT, { ZIndex = 2 })
		place(det, lay.Detail)
	end
	refs.Detail = det
	refresh()
end

-- the panel's own size in the units its children are drawn in: a 100 x 100 probe inside it says how many screen
-- pixels one unit is (UI scale and the pop-in spring alike), so the layout always fills the panel exactly
local function measure(): (number, number)
	local p = panelRef
	local probe = p and p:FindFirstChild("Probe") :: Frame?
	if p and probe and probe.AbsoluteSize.X > 1 and p.AbsoluteSize.X > 10 then
		local k = probe.AbsoluteSize.X / 100
		return p.AbsoluteSize.X / k, p.AbsoluteSize.Y / k
	end
	return math.min(UI.Logical.X - 24, 900), math.min(UI.Logical.Y - 24, 500)
end

local lastSize = Vector2.zero
local function rebuildIfResized()
	local w, h = measure()
	local v = Vector2.new(math.floor(w), math.floor(h))
	if MyPets.Debug then
		local p = panelRef
		print("MYPETS measure", w, h, p and p.AbsoluteSize, p and p.Parent and (p.Parent :: any).AbsoluteSize, UI.Logical, UI.Scale)
	end
	if (v - lastSize).Magnitude >= 2 then
		lastSize = v
		build(v.X, v.Y)
	end
end

function MyPets.open(focus: string?)
	local panel, body, close = UI.modal("MyPets", "MY PETS", Vector2.new(900, 500), { Fixed = true, NoClose = true })
	-- the shell's own skin steps aside: this screen draws its own low-poly frame
	for _, ch in panel:GetChildren() do
		if ch ~= body and not ch:IsA("UISizeConstraint") and not (ch:IsA("UIScale") and ch.Name == "Enter") then
			ch:Destroy()
		end
	end
	panel.BackgroundTransparency = 1
	UI.frame(panel, { Name = "Probe", BackgroundTransparency = 1, Size = UDim2.fromOffset(100, 100), Visible = false })
	for _, ch in body:GetChildren() do
		ch:Destroy()
	end
	body.Position = UDim2.fromOffset(0, 0)
	body.Size = UDim2.fromScale(1, 1)
	panelRef = panel
	canvas = body
	closeFn = close
	open = true
	swapFor = nil
	shownCount = PAGE
	if focus then
		selected = focus
	end
	lastSize = Vector2.zero
	rebuildIfResized()
	panel:GetPropertyChangedSignal("AbsoluteSize"):Connect(rebuildIfResized)
	local conn: RBXScriptConnection
	conn = UI.ModalChanged.Event:Connect(function(name)
		if name ~= "MyPets" then
			open = false
			canvas, panelRef, closeFn = nil, nil, nil
			refs = {}
			conn:Disconnect()
		end
	end)
end

-- the Pet Book (or anything else) asks to put a pet on a full team: MY PETS opens with the slots lit up
function MyPets.openSwap(id: string)
	MyPets.open(id)
	if #team() >= slots() and not onTeam(id) then
		swapFor = id
		refresh()
	end
end

function MyPets.isOpen(): boolean
	return open
end

-- profile updates come in bursts: one redraw a moment later
local queued = false
function MyPets.start()
	State.Changed.Event:Connect(function(what)
		if what == "Profile" and open and not queued then
			queued = true
			task.delay(0.1, function()
				queued = false
				refresh()
			end)
		end
	end)
end

return MyPets
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="362">
            <Properties>
              <string name="Name">NewsPopup</string>
              <string name="Source"><![CDATA[--!strict
-- WHAT'S NEW pop-up (shared/WhatsNew): shown once per new version, in the lobby, when no other menu is open and the
-- tutorial is done. Showing it tells the server (SettingsAction { LastSeenNews = version }), which stores the
-- version in the profile, so it does not come back on the next visit. The same lines are on the park's board.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local WhatsNew = require(Shared.WhatsNew)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local PanelSkin = require(script.Parent.PanelSkin)
local PopupGate = require(script.Parent.Parent.PopupGate)
local Theme = require(script.Parent.Theme)

local T = UI.T
local TC = Theme.Color
local NewsPopup = {}

local shown = false -- once per session at most (the server keeps it across visits)
local queued = false -- waiting its turn behind another big card (NEXT GOAL, away nest) or a menu

function NewsPopup.open()
	local lines = WhatsNew.Lines
	local newsPanel, body, close, footer = UI.modal("WhatsNew", WhatsNew.Title, Vector2.new(440, 120 + #lines * 40 + 70), { Footer = 64, Center = true }) -- body scrolls: many lines never clip on short or portrait screens
	PanelSkin.dress(newsPanel, "Info", WhatsNew.Title, { Center = true })
	UI.list(body, Enum.FillDirection.Vertical, 6)
	for i, line in lines do
		local row = UI.frame(body, { Name = "Line" .. i, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = i })
		UI.text(row, "\u{2022}", { Name = "Dot", Font = UI.Head, TextSize = T.Body, TextColor3 = TC.Gold, Size = UDim2.fromOffset(20, 34), TextXAlignment = Enum.TextXAlignment.Center })
		UI.text(row, line, { Name = "Text", Font = UI.Bold, TextSize = T.Body, Outline = "Normal", Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -24, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })
	end
	if footer then
		UI.button(footer, "GOT IT", "gold", close, { Name = "GotIt", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.6, 0, 0, 46), TextSize = T.Head })
	end
end

local function wanted(): boolean
	local prof = State.Profile
	return not shown and prof ~= nil and WhatsNew.shouldShow(prof.LastSeenNews, prof.OnboardDone == true)
end

-- a big card like the others: one at a time (shared/PopupRules), never over a hunt, a menu or the NEXT GOAL card
local function check()
	if queued or not wanted() then
		return
	end
	queued = true
	PopupGate.later("Card", function()
		queued = false
		if not wanted() or UI.blocked() or not PopupGate.free("Card") then
			if wanted() then
				task.delay(1, check)
			end
			return
		end
		shown = true
		Net.event("SettingsAction"):FireServer({ LastSeenNews = WhatsNew.Version })
		NewsPopup.open()
	end)
end

function NewsPopup.start()
	State.Changed.Event:Connect(function(what)
		if what == "Profile" or what == "Match" then
			task.delay(2, check) -- let the lobby settle first
		end
	end)
	UI.ModalChanged.Event:Connect(function(name)
		if name == nil then
			task.delay(1, check)
		end
	end)
end

return NewsPopup
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="363">
            <Properties>
              <string name="Name">PanelSkin</string>
              <string name="Source"><![CDATA[--!strict
-- Owner mockup panel look (2026-10-12; reference/ui/daily, settings, start_hunt): cream panel with a navy edge and a
-- gold rim, a yellow title tab over the top edge (picture + word), the owner's red X and coin pill. Shared by the
-- DAILY, SETTINGS and START HUNT / PARTY panels on top of UI.modal (which keeps opening, closing and blocking).
-- Picture slots (HudArt.Buttons panel_bg / panel_tab, btn_close_x, coin_pill) replace the drawn parts once uploaded.

local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local HudArt = require(script.Parent.HudArt)

local T = UI.T
local TC = Theme.Color
local PanelSkin = {}

-- Pet style (Theme.PetStyle, 2026-10-15): the cream becomes the clip's white-blue card, the navy its deep title
-- blue; the gold title tab, rims and owner pictures step aside (the modal header draws the floating title and X).
local PET = Theme.Pet
PanelSkin.CREAM = if Theme.PetStyle then PET.QuestBody else Color3.fromRGB(255, 247, 224)
PanelSkin.SKY = if Theme.PetStyle then PET.BlueTop else Color3.fromRGB(128, 198, 255) -- boxes inside a panel (gift box, choice cards)
PanelSkin.SKY_EDGE = if Theme.PetStyle then PET.Blue else Color3.fromRGB(40, 122, 232)
PanelSkin.ROW = if Theme.PetStyle then TC.Inset else Color3.fromRGB(196, 228, 255) -- rows and tiles
PanelSkin.NAVY = if Theme.PetStyle then PET.TitleEdge else TC.PanelEdge
PanelSkin.BAR = if Theme.PetStyle then PET.Blue else Color3.fromRGB(46, 136, 245)

-- Rounded box with an outline.
function PanelSkin.box(parent: Instance, name: string, color: Color3, edge: Color3, thick: number, props: { [string]: any }): Frame
	local f = UI.frame(parent, props)
	f.Name = name
	f.BackgroundColor3 = color
	UI.corner(f, 12)
	UI.stroke(f, edge, thick)
	return f
end

-- Inner frame for a box's padding and layout: a skin picture sits on the box itself, outside the layout (a layout
-- would place the picture like any other child).
function PanelSkin.content(f: Frame): Frame
	return UI.frame(f, { Name = "Content", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = f.ZIndex })
end

-- Fitted one-line text that fills its box (TextScaled inside a size cap), so it never spills out of a tile.
function PanelSkin.word(parent: Instance, text: string, size: number, props: { [string]: any }): TextLabel
	local l = UI.text(parent, text, props)
	l.TextWrapped = false
	UI.fit(l, size, math.min(size, 10))
	return l
end

export type DressOpts = { Center: boolean?, Tiles: boolean? }

-- Restyles a UI.modal panel: `icon` is a HudArt slot for the tab picture, `title` the tab word (HudArt.word picks
-- the owner's word picture when one matches). Center puts the tab in the middle (SETTINGS, START HUNT).
function PanelSkin.dress(panel: Frame, icon: string, title: string, opts: DressOpts?)
	local o: DressOpts = opts or {}
	local NAVY, CREAM = PanelSkin.NAVY, PanelSkin.CREAM
	if Theme.PetStyle then
		-- the sheet, floating title and X come from UI.modal; a centred title moves to the middle, a subtitle goes navy
		local header = panel:FindFirstChild("Header")
		for _, name in { "Title", "TitleShadow" } do
			local t = if header then header:FindFirstChild(name) else nil
			if t and t:IsA("TextLabel") then
				t.Text = UI.titleCase(title)
				if o.Center then
					t.TextXAlignment = Enum.TextXAlignment.Center
					t.Position = UDim2.fromOffset(0, t.Position.Y.Offset)
					t.Size = UDim2.new(1, 0, 0, t.Size.Y.Offset)
				end
			end
		end
		local sub = panel:FindFirstChild("Subtitle") :: TextLabel?
		if sub then
			sub.TextColor3 = NAVY
			local ol = sub:FindFirstChildOfClass("UIStroke")
			if ol then
				ol.Enabled = false
			end
			sub.TextXAlignment = Enum.TextXAlignment.Center
		end
		return
	end
	panel.BackgroundColor3 = CREAM
	local shade = panel:FindFirstChild("PanelShade")
	if shade then
		shade:Destroy()
	end
	local edge = panel:FindFirstChildOfClass("UIStroke")
	if edge then
		edge.Color = NAVY
		edge.Thickness = 3
	end
	local rim = UI.frame(panel, { Name = "Rim", Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1 })
	UI.corner(rim, T.RadiusLg - 2)
	UI.stroke(rim, TC.Gold, 4)
	-- Tiles (START HUNT, owner 2026-10-13): no dedicated panel art yet, so reuse the DAILY cream and gold tiles
	local skinned = HudArt.skin(panel, "panel_bg", 470) or (o.Tiles == true and HudArt.skin(panel, "tile_cream", 470))
	if skinned or panel:GetAttribute("KitOn") then
		rim:Destroy() -- the picture has its own rim: the drawn gold one inside it made a double border (Studio #186)
	end
	local header = panel:FindFirstChild("Header")
	if not header then
		return
	end
	-- the header (tab, X, coins) draws over the panel picture and rim: their top edge must not cut through the tab
	local top = 0
	for _, c in panel:GetChildren() do
		if c ~= header and c:IsA("GuiObject") then
			top = math.max(top, c.ZIndex)
		end
	end
	if header:IsA("GuiObject") and header.ZIndex <= top then
		header.ZIndex = top + 1
	end
	local t = header:FindFirstChild("Title") :: TextLabel?
	if t then
		t.Visible = false
	end
	-- the tab sits half above the panel's top edge
	-- wider on an upright phone so a two-word title (PET BOOK) stays on one line (not when the coins sit there)
	local TAB_H = UI.headerTab() -- 56, compact 46 on the shortest phones
	local tabSize = UDim2.new(if o.Center then 0.56 elseif UI.isPortrait() and not header:FindFirstChild("Cash") then 0.6 else 0.42, 0, 0, TAB_H)
	local tab = PanelSkin.box(header, "Tab", TC.Gold, NAVY, 3, {
		AnchorPoint = Vector2.new(if o.Center then 0.5 else 0, 0.5),
		Position = if o.Center then UDim2.new(0.5, 0, 0, 4) else UDim2.new(0, 14, 0, 4),
		Size = tabSize,
		ZIndex = 5,
	})
	local back = header:FindFirstChild("Back")
	if o.Center and back and back:IsA("GuiObject") and header:IsA("GuiObject") then
		-- a BACK button holds the header's left side (EGG SHOP from UPGRADES): the centred tab keeps clear of it on
		-- both sides (the X sits on the right) on any panel width
		local reserve = back.Position.X.Offset + back.Size.X.Offset + 10
		local function fitTab()
			local w = header.AbsoluteSize.X / math.max(UI.Scale, 0.01) -- logical px, like the offsets
			if w > 0 then
				tab.Size = UDim2.new(0, math.floor(math.max(120, math.min(w * 0.56, w - 2 * reserve))), 0, TAB_H)
			end
		end
		fitTab()
		header:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitTab)
	end
	UI.corner(tab, TAB_H // 2)
	local _ = HudArt.skin(tab, "panel_tab", TAB_H) or (o.Tiles and HudArt.skin(tab, "tile_gold", TAB_H))
	local tin = PanelSkin.content(tab)
	UI.pad(tin, 10, 5)
	-- always laid out from the left (a centred list let the picture and word drift out of the tab on the owner's
	-- phone, onto the BACK button); a centred tab centres its word in the room right of the picture instead
	UI.list(tin, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local pic = HudArt.image(tin, icon, 40, { Size = UDim2.fromScale(1, 1), LayoutOrder = 1, ZIndex = 6 })
	local ar = Instance.new("UIAspectRatioConstraint")
	ar.AspectRatio = 1
	ar.Parent = pic
	local w = PanelSkin.word(tin, title, T.Title, {
		Name = "Word", Font = UI.Head, Outline = "Strong", Size = UDim2.new(1, -52, 1, 0), LayoutOrder = 2, ZIndex = 6,
		TextXAlignment = if o.Center then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left,
	})
	HudArt.word(w)
	if t then
		-- panels that retitle themselves (PARTY 2/4) keep the tab in step
		t:GetPropertyChangedSignal("Text"):Connect(function()
			w.Text = t.Text
		end)
	end
	-- red X picture (square, drawn whole); its drawn X steps aside
	local x = header:FindFirstChild("Close") :: GuiButton?
	if x and HudArt.skin(x, "btn_close_x") then
		for _, c in x:GetChildren() do
			if c:IsA("GuiObject") and c.Name ~= "Skin" then
				c.Visible = false
			end
		end
	end
	-- coin readout as a cream pill
	local cash = header:FindFirstChild("Cash") :: Frame?
	if cash then
		cash.BackgroundTransparency = 0
		cash.BackgroundColor3 = CREAM
		UI.corner(cash, 14)
		UI.stroke(cash, TC.GoldDeep, 3)
		HudArt.skin(cash, "coin_pill", cash.Size.Y.Offset)
		-- the owner's coin picture (as on the HUD) in place of the drawn coin, whose parts read as an "I" on the
		-- cream pill (Studio #187)
		local drawn = cash:FindFirstChild("Icon")
		if drawn and drawn:IsA("GuiObject") and HudArt.has("Coin") then
			local h = cash.Size.Y.Offset
			drawn:Destroy()
			HudArt.image(cash, "Coin", h + 6, { Name = "Icon", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -4, 0.5, 0), ZIndex = cash.ZIndex + 1 })
		end
		local amt = cash:FindFirstChild("Amount") :: TextLabel?
		if amt then
			amt.TextColor3 = NAVY
			local ol = amt:FindFirstChildOfClass("UIStroke")
			if ol then
				ol.Enabled = false
			end
		end
	end
	-- a subtitle line (START HUNT "One pile. One pet.") sits on cream: navy, no outline
	local sub = panel:FindFirstChild("Subtitle") :: TextLabel?
	if sub then
		sub.TextColor3 = NAVY
		local ol = sub:FindFirstChildOfClass("UIStroke")
		if ol then
			ol.Enabled = false
		end
		sub.TextXAlignment = Enum.TextXAlignment.Center
		HudArt.word(sub)
	end
end

-- Picture skins for the buttons of a cream card, by UI.button style (red stays drawn: no red picture yet).
local STYLE_SKIN = { gold = "btn_yellow", gray = "btn_grey", blue = "btn_blue", green = "btn_green" }

-- Cream look for small cards (yes/no dialogs, party invite, toasts): cream fill, navy edge, gold rim, navy body
-- text, picture buttons and the red X picture. `edgeColor` keeps a toast's green / red edge meaning.
function PanelSkin.card(f: Frame, edgeColor: Color3?)
	f.BackgroundColor3 = PanelSkin.CREAM
	f.BackgroundTransparency = 0
	local shade = f:FindFirstChild("PanelShade")
	if shade then
		shade:Destroy()
	end
	local edge = f:FindFirstChildOfClass("UIStroke")
	if edge then
		edge.Color = edgeColor or (if Theme.PetStyle then PET.QuestEdge else PanelSkin.NAVY)
		edge.Thickness = 3
	end
	if not Theme.PetStyle then
		local rim = UI.frame(f, { Name = "Rim", Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), BackgroundTransparency = 1, ZIndex = 0 })
		local c = f:FindFirstChildOfClass("UICorner")
		UI.corner(rim, if c then math.max(0, c.CornerRadius.Offset - 3) else T.Radius)
		UI.stroke(rim, TC.Gold, 2)
	end
	for _, d in f:GetDescendants() do
		if d:IsA("TextLabel") and (d.Name == "Message" or d.Name == "Text") then
			d.TextColor3 = PanelSkin.NAVY
			local ol = d:FindFirstChildOfClass("UIStroke")
			if ol then
				ol.Enabled = false
			end
		elseif d:IsA("GuiButton") and d.Name == "Close" then
			if HudArt.skin(d, "btn_close_x") then
				for _, k in d:GetChildren() do
					if k:IsA("GuiObject") and k.Name ~= "Skin" then
						k.Visible = false
					end
				end
			end
		elseif d:IsA("GuiButton") and d.Parent and d.Parent.Name == "Buttons" then
			local key = STYLE_SKIN[tostring(d:GetAttribute("Style"))]
			if key then
				HudArt.skin(d, key, d.AbsoluteSize.Y > 0 and d.AbsoluteSize.Y or 46)
			end
		end
	end
end

UI.DialogDress = function(panel: Frame)
	PanelSkin.card(panel)
end
UI.NoticeDress = function(card: Frame, kind: string)
	PanelSkin.card(card, if kind == "ok" or kind == "geode" then TC.Green elseif kind == "warn" then TC.Red else nil)
end

return PanelSkin
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="364">
            <Properties>
              <string name="Name">PartyPanel</string>
              <string name="Source"><![CDATA[--!strict
-- START HUNT and PARTY (boards 8 and 9, additional 6-8), all through the real PartyService (PartyAction):
--   no party:  START HUNT "One pile. One geode." with SOLO HUNT (START) and PARTY HUNT (CREATE PARTY); while the
--              request is on its way the cards give way to "Starting hunt..." (no double start). The pending state
--              stays on the start view even when the server's solo party arrives before the hunt does, ends when
--              the hunt arrives or the server refuses (a warning), and gives up after START_WAIT seconds with a
--              notice (the server still refuses a second start while one is running).
--   a party:   PARTY n/4 with Members (avatar, name, leader crown, the server's ready state or blocker, empty slots,
--              kick for the leader), the hunt tier, READY, START HUNT (leader only, enabled when the server says it
--              can start) and LEAVE; Invite (leader): eligible lobby players only, no invites once the party is full.
--   invitations: a dialog with the inviter, ACCEPT / DECLINE; an invite that expires or vanishes closes it with
--              "Party invitation expired."
-- The server validates every action; refusals arrive as notifications.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local Juice = require(script.Parent.Juice)
local HudArt = require(script.Parent.HudArt)
local PanelSkin = require(script.Parent.PanelSkin)

local T = UI.T
local TC = Theme.Color
local PartyPanel = {}

local player = Players.LocalPlayer
local open = false
local body: Frame? = nil
local panelRef: Frame? = nil
local view = "Members" -- party tabs: Members | Invite
local openedWithParty = false -- the shell (title / subtitle) was built for a party view
local starting = false -- a Solo / Start request is on its way
local startingFrom = "" -- "Solo" (start view) or "Start" (party view)
local startingSeq = 0
local START_WAIT = 8
local sentInvite: { [number]: number } = {} -- userId -> os.clock() of the last invite sent (button shows SENT)

-- Preview seam (tools/preview/scenes/party.luau): with Hold set, requests wait in Held instead of going to the
-- server, so the pending state can be seen and the double-start guard counted offline. Never set in the game.
PartyPanel.Hold = false
PartyPanel.Held = {} :: { { any } }

local function act(action: string, arg: any?)
	if PartyPanel.Hold then
		table.insert(PartyPanel.Held, { action, arg } :: { any })
		return
	end
	Net.event("PartyAction"):FireServer(action, arg)
end

-- Sends what the preview held back.
function PartyPanel.release()
	PartyPanel.Hold = false
	local held = PartyPanel.Held
	PartyPanel.Held = {}
	for _, h in held do
		act(h[1], h[2])
	end
end

function PartyPanel.isStarting(): boolean
	return starting
end

local render

local function setStarting(on: boolean, from: string?)
	starting = on
	startingSeq += 1
	if on then
		startingFrom = from or "Solo"
		local mine = startingSeq
		task.delay(START_WAIT, function()
			if starting and startingSeq == mine then
				starting = false
				render()
				UI.notify("The hunt did not start. Try again.", "info", { Tag = "start-timeout" })
			end
		end)
	end
	render()
end

-- Ends a pending start (the hunt arrived or the server refused); rebuilds the shell if the view changed.
local function endStarting()
	if not starting then
		return
	end
	starting = false
	startingSeq += 1
	render()
end

-- Avatar headshot from Roblox's own thumbnail service (rbxthumb), with the drawn user glyph behind it.
local function avatar(parent: Instance, userId: number, size: number, props: { [string]: any }?): Frame
	local f = UI.frame(parent, { Name = "Avatar", Size = UDim2.fromOffset(size, size), BackgroundColor3 = TC.Inset })
	UI.apply(f, props)
	UI.corner(f, T.RadiusSm)
	UI.stroke(f, TC.Outline, 1.5)
	UI.icon(f, "user", math.floor(size * 0.8), { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
	if userId > 0 then
		local img = Instance.new("ImageLabel")
		img.Name = "Headshot"
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.Image = "rbxthumb://type=AvatarHeadShot&id=" .. userId .. "&w=48&h=48"
		img.Parent = f
		UI.corner(img, T.RadiusSm)
	end
	return f
end

local function clear(b: Instance)
	for _, c in b:GetChildren() do
		if not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
end

-- Pending invitations shown at the top of the panel too (the dialog is the main path).
local function inviteRows(b: Frame, y: number): number
	for _, inv in State.Invites do
		local row = UI.card(b, "inset", { Name = "Invite", Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 52) })
		UI.text(row, inv.From .. " invited you", { Font = UI.Bold, TextSize = T.Body, Outline = "Normal", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -230, 1, 0) })
		local ab
		ab = UI.button(row, "ACCEPT", "gold", function()
			UI.pending(ab, "JOINING\u{2026}", 4)
			act("Accept", inv.PartyId)
		end, { Size = UDim2.fromOffset(100, T.Touch), Position = UDim2.new(1, -212, 0, 4), TextSize = T.Body })
		UI.button(row, "DECLINE", "gray", function()
			act("Decline", inv.PartyId)
		end, { Size = UDim2.fromOffset(100, T.Touch), Position = UDim2.new(1, -106, 0, 4), TextSize = T.Body })
		y += 58
	end
	return y
end

-- A card picture (HudArt slot) as big as its box allows, kept square and centred.
local function picture(p: Instance, slot: string)
	local img = HudArt.image(p, slot, 64, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.9, 0.9) })
	local ar = Instance.new("UIAspectRatioConstraint")
	ar.AspectRatio = 1
	ar.Parent = img
end

-- Board 8: the two ways to hunt.
local function renderStart(b: Frame)
	if starting then
		-- additional board 8: a compact pending card instead of an empty menu
		if panelRef then
			UI.fitModal(panelRef, Vector2.new(420, 200 + 54 * #State.Invites))
		end
		local y0 = inviteRows(b, 0)
		UI.loadingState(b, "Starting hunt\u{2026}", { Name = "Starting", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, y0 / 2) })
		return
	end
	if panelRef then
		UI.fitModal(panelRef, Vector2.new(560, if UI.isPortrait() then 520 else 360))
	end
	local y = inviteRows(b, 0)
	local prof = State.Profile
	local practice = prof ~= nil and prof.TutorialStep == 0
	local portrait = UI.isPortrait()
	local cards = UI.frame(b, { Name = "Choices", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 1, -y) })
	UI.list(cards, if portrait then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal, T.Gap)
	local function card(order: number, name: string, title: string, sub: string, btnText: string, pic: (Instance) -> (), onClick: () -> ())
		-- sky card (owner mockup reference/ui/start_hunt/mockup.png): picture, title, one line, gold button
		local box = PanelSkin.box(cards, name, PanelSkin.SKY, PanelSkin.SKY_EDGE, 3, { LayoutOrder = order, Size = if portrait then UDim2.new(1, 0, 0.5, -4) else UDim2.new(0.5, -4, 1, 0) })
		-- the owner's blue card picture (DAILY tile_blue) until a dedicated hunt_card exists
		local _ = HudArt.skin(box, "hunt_card", 220) or HudArt.skin(box, "tile_blue", 220)
		local c = PanelSkin.content(box)
		UI.pad(c, 8, 8)
		-- the caption line is 26 px tall: its word picture is about 9:1, so an 18 px box drew it as a thin strip
		local SUB_H = 26
		-- a clear gap between the caption line and the button (they touched, Studio #186)
		local GAP = 10
		local p = UI.frame(c, { Name = "Picture", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -(28 + SUB_H + 46 + GAP)) })
		pic(p)
		local tl = UI.text(c, title, { Name = "Title", Font = UI.Head, TextSize = T.Head + 2, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -(46 + GAP + SUB_H)), Size = UDim2.new(1, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Center })
		local sl = UI.text(c, sub, { Name = "Sub", Font = UI.Bold, TextSize = T.Body + 1, Outline = "Normal", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -(46 + GAP)), Size = UDim2.new(1, 0, 0, SUB_H), TextXAlignment = Enum.TextXAlignment.Center })
		sl.TextWrapped = false
		local bt = UI.button(c, btnText, "gold", function()
			if starting then
				return
			end
			onClick()
		end, { Name = if order == 1 then "StartSolo" else "CreateParty", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 46), TextSize = T.Head + 2 })
		HudArt.skin(bt, "btn_yellow", 46)
		-- owner's word pictures (reference/ui/start_hunt/) where one matches; other lines keep the text
		HudArt.word(tl)
		HudArt.word(sl, 0.9)
		local bl = bt:FindFirstChild("Label") :: TextLabel?
		if bl then
			HudArt.word(bl, 0.8)
		end
		return bt
	end
	card(1, "Solo", if practice then "PRACTICE HUNT" else "SOLO HUNT", if practice then "A small pile to learn the ropes" else "Find the pet yourself", "START", function(p)
		picture(p, if HudArt.has("EggPink") then "EggPink" else "Egg")
	end, function()
		if starting then
			return
		end
		setStarting(true, "Solo")
		act("Solo")
	end)
	card(2, "Party", "PARTY HUNT", "Up to " .. Config.Party.MaxSize .. " players, one pet", "CREATE PARTY", function(p)
		picture(p, "Party")
	end, function()
		act("Create")
	end)
end

-- One member row (board 9).
local function memberRow(parent: Instance, order: number, mem: any?, isLeader: boolean, solo: boolean)
	local row = UI.card(parent, "inset", { Name = if mem then "Member_" .. order else "Empty_" .. order, LayoutOrder = order, Size = UDim2.new(1, -6, 0, 40) })
	if not mem then
		avatar(row, 0, 30, { Position = UDim2.fromOffset(38, 5), BackgroundTransparency = 1 })
		UI.text(row, "Empty Slot", { Font = UI.Bold, TextSize = T.Body, TextColor3 = TC.Faint, Outline = "Light", Position = UDim2.fromOffset(78, 0), Size = UDim2.new(1, -160, 1, 0) })
		UI.text(row, "---", { Font = UI.Bold, TextSize = T.Body, TextColor3 = TC.Faint, Outline = "Light", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0), Size = UDim2.fromOffset(60, 40), TextXAlignment = Enum.TextXAlignment.Right })
		return
	end
	if mem.Leader then
		UI.icon(row, "crown", 24, { Position = UDim2.fromOffset(8, 8) })
	else
		UI.text(row, tostring(order), { Font = UI.Head, TextSize = T.Head, Position = UDim2.fromOffset(8, 0), Size = UDim2.fromOffset(24, 40), TextXAlignment = Enum.TextXAlignment.Center })
	end
	avatar(row, mem.UserId, 30, { Position = UDim2.fromOffset(38, 5) })
	local you = mem.UserId == player.UserId
	local name = UI.text(row, mem.Name .. (if mem.Leader then "  (Leader)" elseif you then "  (You)" else ""), { Name = "Name", Font = UI.Bold, TextSize = T.Body, Outline = "Normal", Position = UDim2.fromOffset(78, 0), Size = UDim2.new(1, -(78 + 120), 1, 0) })
	name.TextWrapped = false
	name.TextTruncate = Enum.TextTruncate.AtEnd
	local blockers = mem.Blockers or {}
	local status = if solo then "Solo" elseif #blockers > 0 then blockers[1] elseif mem.Ready then "Ready" else "Not ready"
	local col = if solo then TC.Muted elseif #blockers > 0 then TC.Warn elseif mem.Ready then TC.Green else TC.Count
	local kick = isLeader and not you
	local st = UI.text(row, status, { Name = "State", Font = UI.Bold, TextSize = T.Body, TextColor3 = col, Outline = "Normal", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, if kick then -54 else -12, 0, 0), Size = UDim2.fromOffset(110, 40), TextXAlignment = Enum.TextXAlignment.Right })
	st.TextWrapped = false
	if kick then
		UI.closeButton(row, function()
			-- a mis-tap must not remove a friend: ask first
			UI.confirm({
				Name = "PartyKick",
				Title = "Remove " .. mem.Name .. "?",
				Message = mem.Name .. " leaves your party.",
				Icon = "party",
				Confirm = "REMOVE",
				Cancel = "KEEP",
				Style = "red",
				OnConfirm = function()
					act("Kick", mem.UserId)
				end,
			})
		end, { Name = "Kick", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(T.Touch, T.Touch) })
	end
end

-- Eligible players to invite: in this server, not in the party, not in a hunt.
local function eligible(party): { Player }
	local inParty = {}
	for _, mem in party.Members do
		inParty[mem.UserId] = true
	end
	local out = {}
	for _, p in Players:GetPlayers() do
		if not inParty[p.UserId] and p ~= player and not p:GetAttribute("MatchKey") then
			table.insert(out, p)
		end
	end
	table.sort(out, function(a, b)
		return a.DisplayName < b.DisplayName
	end)
	return out
end

local function renderParty(b: Frame, party: { [string]: any })
	local prof = State.Profile
	local isLeader = party.Leader == player.UserId
	local me
	for _, mem in party.Members do
		if mem.UserId == player.UserId then
			me = mem
		end
	end
	if panelRef then
		UI.fitModal(panelRef, Vector2.new(560, if UI.isPortrait() then 620 else 400))
		local title = panelRef:FindFirstChild("Header") and (panelRef :: any).Header:FindFirstChild("Title")
		if title then
			title.Text = "PARTY " .. #party.Members .. "/" .. party.Max
		end
	end
	if not isLeader then
		view = "Members"
	end
	local y = inviteRows(b, 0)
	if isLeader then
		UI.tabs(b, { { "Members", "Members" }, { "Invite", "Invite" } }, view, function(id)
			view = id
			render()
		end, { Position = UDim2.fromOffset(0, y) })
		y += T.Tab + 6
	end
	local footH = 50
	if view == "Invite" and isLeader then
		local full = #party.Members >= party.Max
		local list = UI.scroller(b, { Name = "InviteList", Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 1, -(y + 26)) })
		UI.pad(list, 2, 2)
		UI.list(list, Enum.FillDirection.Vertical, 6)
		local people = eligible(party)
		if full then
			UI.text(list, "The party is full.", { Name = "Full", Font = UI.Bold, TextSize = T.Body, TextColor3 = TC.Muted, Outline = "Normal", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center })
		elseif #people == 0 then
			UI.text(list, "Nobody else in the lobby can join right now.", { Name = "Nobody", Font = UI.Bold, TextSize = T.Body, TextColor3 = TC.Muted, Outline = "Normal", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center })
		else
			for i, p in people do
				local row = UI.card(list, "inset", { Name = "Player_" .. p.UserId, LayoutOrder = i, Size = UDim2.new(1, -6, 0, 50) })
				avatar(row, p.UserId, 38, { Position = UDim2.fromOffset(8, 6) })
				local nm = UI.text(row, p.DisplayName, { Font = UI.Bold, TextSize = T.Head - 2, Outline = "Normal", Position = UDim2.fromOffset(56, 0), Size = UDim2.new(1, -(56 + 130), 1, 0) })
				nm.TextWrapped = false
				nm.TextTruncate = Enum.TextTruncate.AtEnd
				local recent = sentInvite[p.UserId] and os.clock() - sentInvite[p.UserId] < 8
				local ib = UI.button(row, if recent then "SENT" else "INVITE", "gold", function()
					sentInvite[p.UserId] = os.clock()
					act("Invite", p.UserId)
					render()
					task.delay(8.1, render)
				end, { Name = "Invite", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(112, T.Touch), TextSize = T.Body + 1 })
				if recent then
					UI.setEnabled(ib, false)
				end
			end
		end
		UI.text(b, "Party size: " .. #party.Members .. "/" .. party.Max, { Name = "Size", Font = UI.Bold, TextSize = T.Body, Outline = "Normal", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
		return
	end
	-- Members
	local solo = false
	local tierH = 36
	local reasonH = 24
	local list = UI.scroller(b, { Name = "Members", Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 1, -(y + tierH + reasonH + footH + 12)) })
	UI.pad(list, 2, 2)
	UI.list(list, Enum.FillDirection.Vertical, 5)
	for i = 1, party.Max do
		memberRow(list, i, party.Members[i], isLeader, solo)
	end
	-- hunt tier (the leader picks; locked tiers are visible but not pickable)
	local tiers = UI.scroller(b, { Name = "Tiers", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -(footH + reasonH + 8)), Size = UDim2.new(1, 0, 0, tierH), ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 0 })
	UI.list(tiers, Enum.FillDirection.Horizontal, 6)
	if party.Tutorial then
		UI.text(tiers, "Practice pile \u{b7} " .. party.TierRocks .. " eggs", { Font = UI.Bold, TextSize = T.Body, Outline = "Normal", Size = UDim2.fromOffset(260, tierH) })
	else
		for i, tid in Config.TierOrder do
			local tier = Config.Tiers[tid]
			local unlocked = prof and prof.UnlockedTiers[tid]
			local sel = party.Tier == tid
			local tb = UI.button(tiers, tier.Name, if sel then "gold" else "gray", function()
				if isLeader and not sel then
					act("Tier", tid)
				end
			end, { Name = "Tier_" .. tid, Size = UDim2.fromOffset(104, tierH), TextSize = T.Body, LayoutOrder = i })
			if not sel and (not isLeader or not unlocked) then
				UI.setEnabled(tb, false)
			end
			if not unlocked and not sel then
				tb.Activated:Connect(function()
					Juice.nope(tb) -- a locked zone shakes "no" when tapped
				end)
			end
		end
	end
	local reason = if starting then "Starting hunt\u{2026}" elseif not isLeader then "The leader picks the tier and starts the hunt." else (party.Reason or "Everyone is ready. Start when you like!")
	if isLeader and not starting and me and not me.Ready then
		reason = "Tap READY, then START HUNT." -- "Waiting for <you> to ready" read as someone else holding things up
	end
	UI.text(b, reason, { Name = "Reason", Font = UI.Bold, TextSize = T.Body + 1, TextColor3 = if starting then TC.Gold elseif party.CanStart then TC.Green else TC.Muted, Outline = "Normal", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -(footH + 4)), Size = UDim2.new(1, 0, 0, reasonH), TextXAlignment = Enum.TextXAlignment.Center })
	-- footer: READY, START HUNT (leader), LEAVE
	local foot = UI.frame(b, { Name = "Buttons", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, footH - 4) })
	UI.list(foot, Enum.FillDirection.Horizontal, 8)
	-- one main button that changes with the state (READY and a grey WAITING FOR READY side by side read as two
	-- choices, #235): READY until you are ready; then the leader's turns into START HUNT once the server says the
	-- party can start, or CANCEL READY while it waits on someone (the reason line above says who)
	local ready = me and me.Ready
	if isLeader and ready then
		local waiting = not party.CanStart and string.find(party.Reason or "", "^Waiting for") ~= nil
		local start
		if waiting and not starting then
			start = UI.button(foot, "CANCEL READY", "gray", function()
				act("Ready", false)
			end, { Name = "Ready", Size = UDim2.new(0.68, -6, 1, 0), TextSize = T.Head, LayoutOrder = 1 })
		else
			start = UI.button(foot, if starting then "STARTING\u{2026}" else "START HUNT", "gold", function()
				if starting then
					return
				end
				setStarting(true, "Start")
				act("Start")
			end, { Name = "Start", Size = UDim2.new(0.68, -6, 1, 0), TextSize = T.Head, LayoutOrder = 1 })
			UI.setEnabled(start, party.CanStart and not starting)
		end
	else
		UI.button(foot, if ready then "NOT READY" else "READY", if ready then "gray" else "gold", function()
			act("Ready", not ready)
		end, { Name = "Ready", Size = UDim2.new(if isLeader then 0.68 else 0.6, -6, 1, 0), TextSize = T.Head, LayoutOrder = 1 })
	end
	UI.button(foot, "LEAVE", "gray", function()
		act("Leave")
	end, { Name = "Leave", Size = UDim2.new(if isLeader then 0.32 else 0.4, -6, 1, 0), TextSize = T.Head, LayoutOrder = 3 })
end

function render()
	if not open or not body then
		return
	end
	local b = body :: Frame
	clear(b)
	local party = State.Party
	if party and not (starting and startingFrom == "Solo") then
		renderParty(b, party)
	else
		if panelRef then
			local h = panelRef:FindFirstChild("Header")
			local t = h and h:FindFirstChild("Title")
			if t and t:IsA("TextLabel") then
				t.Text = "START HUNT"
			end
		end
		renderStart(b)
	end
end

function PartyPanel.open()
	view = "Members"
	local party = State.Party
	openedWithParty = party ~= nil
	local panel, b = UI.modal("Party", if party then "PARTY" else "START HUNT", Vector2.new(560, 360), { Fixed = true, Subtitle = if party then nil else "One pile. One pet." })
	local egg = if HudArt.has("EggPink") then "EggPink" else "Egg"
	PanelSkin.dress(panel, if party then "Party" else egg, if party then "PARTY" else "START HUNT", { Center = true, Tiles = not party })
	-- "One pile. One pet." in a taller box (its 6.5:1 word picture drew tiny in the modal's 24 px line); it still ends
	-- where the body starts (header 54 + 22)
	local subtitle = panel:FindFirstChild("Subtitle") :: TextLabel?
	if subtitle then
		subtitle.Position = UDim2.fromOffset(16, 42)
		subtitle.Size = UDim2.new(1, -32, 0, 34)
		subtitle.TextWrapped = false
		UI.fit(subtitle, T.Head, T.MinText)
	end
	body = b
	panelRef = panel
	open = true
	local conn
	conn = UI.ModalChanged.Event:Connect(function(name)
		if name ~= "Party" then
			open = false
			body = nil
			panelRef = nil
			conn:Disconnect()
		end
	end)
	render()
	return function()
		if open then
			UI.closeModal()
		end
	end
end

-- Invitation dialogs ------------------------------------------------------------------------------
local dialogFor: string? = nil -- PartyId the dialog is about
local dialogClose: (() -> ())? = nil
local answered = false
local seen: { [string]: boolean } = {}

local function inviteDialog(inv: { [string]: any })
	dialogFor = inv.PartyId
	answered = false
	dialogClose = UI.confirm({
		Name = "PartyInvite",
		Title = "PARTY INVITE",
		Message = inv.From .. " invited you.",
		Icon = "party",
		Confirm = "ACCEPT",
		Cancel = "DECLINE",
		OnConfirm = function()
			answered = true
			dialogFor = nil
			act("Accept", inv.PartyId)
		end,
		OnCancel = function()
			answered = true
			dialogFor = nil
			act("Decline", inv.PartyId)
		end,
	})
end

local function checkInvites()
	local present: { [string]: boolean } = {}
	for _, inv in (State.Invites or {}) :: { any } do
		present[inv.PartyId] = true
	end
	-- the invite on screen expired or vanished
	if dialogFor and not present[dialogFor] then
		local was = dialogFor
		dialogFor = nil
		if dialogClose and UI.dialogOpen() == "PartyInvite" then
			dialogClose()
		end
		if not answered and not (State.Party and State.Party.Id == was) then
			UI.notify("Party invitation expired.", "info")
		end
	end
	for pid in seen do
		if not present[pid] then
			seen[pid] = nil
		end
	end
	if State.Match or State.Party then
		return
	end
	for _, inv in (State.Invites or {}) :: { any } do
		if not seen[inv.PartyId] then
			seen[inv.PartyId] = true
			if dialogFor == nil and UI.dialogOpen() == nil then
				inviteDialog(inv)
			end
		end
	end
end

function PartyPanel.start()
	State.Changed.Event:Connect(function(what)
		if what == "Party" then
			checkInvites()
		end
		if what == "Match" and State.Match and starting then
			endStarting() -- the hunt began
		end
		local soloPending = starting and startingFrom == "Solo"
		if what == "Party" and open and not soloPending and (State.Party ~= nil) ~= openedWithParty and not State.Match then
			PartyPanel.open() -- start view <-> party view: rebuild the shell (title, subtitle)
			return
		end
		if what == "Party" or what == "Profile" then
			render()
		end
	end)
	-- a refusal ends a pending start at once
	UI.Notice.Event:Connect(function(_, kind)
		if kind == "warn" and starting then
			endStarting()
			-- a refused solo start leaves a party of one behind: show it in its own shell
			if open and (State.Party ~= nil) ~= openedWithParty and not State.Match then
				PartyPanel.open()
			end
		end
	end)
	Players.PlayerAdded:Connect(function()
		task.defer(render)
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(render)
	end)
end

return PartyPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="365">
            <Properties>
              <string name="Name">PetShop</string>
              <string name="Source"><![CDATA[--!strict
-- PET SHOP: the Robux shop drawn in the style of the owner's reference clip (docs/UI_STYLE_REF.md on branch
-- claude/project-thread-lb94zs: Pet Simulator style). No panel sheet: a "Shop" title, a navy tab strip with a lime
-- selected pill, a coin pill and a red X float over the blurred world; the content is wide gradient cards with a
-- faint diamond pattern, white heavy-outlined names, green price pills and small ribbons. Cards tilt toward the
-- pointer and lift on hover (CardTilt); the selected tab pill slides.
--
-- Content comes from shared/RobuxConfig (eggs with full odds, luck potion, game passes). Prices are read from
-- Roblox (MarketplaceService:GetProductInfo); "R$ ?" until known; an id of 0 shows SOON. Tapping a price pill asks
-- the server (RobuxAction), which re-checks and opens Roblox's own prompt; the panel never grants anything.
--
-- Opened by the EGG SHOP hut prompt (Main.client panels.RobuxShop) and the Robux tab of UPGRADES (ShopPanel).
-- Preview scene: `petshop`.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local RobuxConfig = require(Shared.RobuxConfig)
local LuckEvents = require(Shared.LuckEvents)
local EggPerks = require(Shared.EggPerks)
local LaunchPerks = require(Shared.LaunchPerks)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)

local PetStyle = require(script.Parent.PetStyle)
local ShopEgg = require(script.Parent.ShopEgg)
local PetShop = {}
local player = Players.LocalPlayer

local K, TONES, MOTION = PetStyle.K, PetStyle.Tones, PetStyle.Motion
local still, words, vgrad, round, edge, shadowed, pattern, card, pill, ribbon, dot =
	PetStyle.still, PetStyle.words, PetStyle.vgrad, PetStyle.round, PetStyle.edge, PetStyle.shadowed, PetStyle.pattern, PetStyle.card, PetStyle.pill, PetStyle.ribbon, PetStyle.dot
local RARITY_HEX: { [string]: Color3 } = {
	Common = Color3.fromRGB(236, 240, 244),
	Uncommon = Color3.fromRGB(120, 240, 110),
	Rare = Color3.fromRGB(90, 190, 255),
	Epic = Color3.fromRGB(220, 110, 255),
	Legendary = Color3.fromRGB(255, 200, 40),
}
local EGG_TONE: { [string]: string } = { BasicEgg = "sky", RareEgg = "gold", MythicEgg = "purple" }
local EGG_TAG: { [string]: string } = { BasicEgg = "STARTER", RareEgg = "POPULAR", MythicEgg = "BEST ODDS" }
local EGG_BLURB: { [string]: string } = {
	BasicEgg = "Same odds as a race egg. Pets from your best zone.",
	RareEgg = "1 in 200 Legendary. Rare pets twice as likely.",
	MythicEgg = "1 in 100 Legendary. The best egg in the game.",
}
local PASS_TONE: { [string]: string } = { VIP = "gold", DoubleCoins = "sun", TripleHatch = "purple", AutoHatch = "green", PetStorage = "blue", ExtraPlots = "pink" }
local PASS_EFFECT: { [string]: string } = { VIP = "+50% luck", DoubleCoins = "2x coins", TripleHatch = "3 at once", AutoHatch = "hands free", PetStorage = "+250 pets", ExtraPlots = "+10 spots" }
local PASS_ICON: { [string]: string } = { VIP = "crown", DoubleCoins = "cash", TripleHatch = "egg", AutoHatch = "clock", PetStorage = "book", ExtraPlots = "display" }
local LIMITED_TONE = "pink"

local TABS = { "Featured", "Eggs", "Passes", "Potions" }
local tab = "Featured"
local open = false
local content: ScrollingFrame? = nil
local contentW = 600 -- logical width of the content column (build sets it)
local render: () -> ()
local rendering = false
local renderQueued = false
local function requestRender()
	if not open then
		return
	end
	if rendering then
		renderQueued = true
		return
	end
	task.defer(function()
		if open and not rendering then
			render()
		end
	end)
end

-- Prices from Roblox, cached ---------------------------------------------------------------------------------------

local priceCache: { [string]: string } = {}
local priceAsked: { [string]: boolean } = {}
local function priceText(id: number, isPass: boolean): string
	if id <= 0 then
		return "SOON"
	end
	local key = (if isPass then "p" else "d") .. id
	if priceCache[key] then
		return priceCache[key]
	end
	if not priceAsked[key] then
		priceAsked[key] = true
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(id, if isPass then Enum.InfoType.GamePass else Enum.InfoType.Product)
			end)
			if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
				priceCache[key] = UI.num(info.PriceInRobux)
				requestRender()
			end
		end)
	end
	return "..."
end

-- Countdowns (shared/LaunchPerks view) ------------------------------------------------------------------------------
-- Labels that count down are updated once a second in place (never a re-render): `tickers` holds one function per
-- live label; the content ones are dropped by every render, the header one lives with build().

local tickers: { [string]: (() -> ())? } = {}
local tickRun = 0
local function startTicking()
	tickRun += 1
	local token = tickRun
	task.spawn(function()
		while open and tickRun == token do
			task.wait(1)
			if not open or tickRun ~= token then
				return
			end
			for _, fn in table.clone(tickers) do
				local ok, err = pcall(fn :: any)
				if not ok then
					warn("[PetShop] tick failed: " .. tostring(err))
				end
			end
		end
	end)
end

-- "2d 4h" from a day up, else "1:59:59" / "43:12".
local function endsText(secs: number): string
	local s = math.max(0, math.floor(secs))
	if s >= 86400 then
		return string.format("%dd %dh", s // 86400, (s % 86400) // 3600)
	end
	return LuckEvents.clock(s)
end

local function prof(): any
	return State.Profile
end

-- The profile's Perks view carries seconds-left numbers (Limited.EndsIn, LuckyHourIn) that are true when the view
-- arrives: they are anchored to the clock once per view so the countdowns keep running between syncs.
local perksSeen: any = nil
local limitedEndsAt = 0
local luckyStartAt = 0
local function perks(): any
	local p = prof()
	local pk = if p and type(p.Perks) == "table" then p.Perks else nil
	if pk ~= perksSeen then
		perksSeen = pk
		local now = os.time()
		limitedEndsAt = if pk and type(pk.Limited) == "table" then now + (tonumber(pk.Limited.EndsIn) or 0) else 0
		luckyStartAt = if pk then now + (tonumber(pk.LuckyHourIn) or 0) else 0
	end
	return pk
end

-- The limited egg on sale for this player (RobuxConfig.LimitedEggs entry named by Perks.Limited), or nil.
local function limitedEgg(): RobuxConfig.Egg?
	local pk = perks()
	if not pk or type(pk.Limited) ~= "table" then
		return nil
	end
	local egg = RobuxConfig.egg(pk.Limited.Id)
	return if egg and egg.Limited then egg else nil
end

-- Lucky hour chip state: "on" (running, ReplicatedStorage.LuckyHourUntil) with seconds left, "soon" (under two
-- hours away) with seconds until it starts, or nil (no chip).
local LUCKY_SOON = 2 * 3600
local function luckyMode(): (string?, number)
	local now = os.time()
	local untilT = ReplicatedStorage:GetAttribute("LuckyHourUntil")
	if type(untilT) == "number" and untilT > now then
		return "on", untilT - now
	end
	if perks() and luckyStartAt > now and luckyStartAt - now < LUCKY_SOON then
		return "soon", luckyStartAt - now
	end
	return nil, 0
end
local function luckyText(mode: string, left: number): string
	return if mode == "on" then "LUCKY HOUR 2x \u{b7} " .. LuckEvents.clock(left) else "LUCKY HOUR in " .. LuckEvents.clock(left)
end

-- Drawing kit ----------------------------------------------------------------------------------------------------

-- The Robux mark: a white ring with a square dot (no asset id).
local function robuxMark(parent: Instance, size: number, props: { [string]: any }?): Frame
	local ring = Instance.new("Frame")
	ring.Name = "Robux"
	ring.BackgroundTransparency = 1
	ring.Size = UDim2.fromOffset(size, size)
	ring.ZIndex = 6
	UI.apply(ring, props)
	round(ring, 999)
	edge(ring, K.White, math.max(1.6, size * 0.11))
	local dot = Instance.new("Frame")
	dot.BackgroundColor3 = K.White
	dot.BorderSizePixel = 0
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromScale(0.42, 0.42)
	dot.Rotation = 45
	dot.ZIndex = 6
	round(dot, 2)
	dot.Parent = ring
	ring.Parent = parent
	return ring
end

-- Green price pill: Robux mark + the price (or SOON / ...). `onBuy` runs on tap when the price is known.
local function pricePill(parent: Instance, price: string, props: { [string]: any }?, size: number?, onBuy: (() -> ())?): TextButton
	local b, l = pill(parent, price, K.PriceTop, K.Price, K.PriceEdge, props, size)
	b.Name = "Buy"
	local s = size or 18
	local w = s * 1.05
	robuxMark(b, w, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, s * 0.6, 0.5, 0) })
	l.Position = UDim2.fromOffset(s * 0.6 + w + 4, 0)
	l.Size = UDim2.new(1, -(s * 0.6 + w + 10), 1, -4)
	l.TextXAlignment = Enum.TextXAlignment.Center
	if onBuy then
		b.Activated:Connect(function()
			if price ~= "SOON" and price ~= "..." then
				onBuy()
			end
		end)
	end
	if not still() then
		-- a glint sweeps the pill now and then (the clip's buttons shine)
		task.spawn(function()
			while b.Parent and open do
				task.wait(Theme.Loop.ShineEvery + (string.len(price) % 3) * 0.4)
				if b.Parent and open then
					UI.Juice.sweep(b, 999)
				end
			end
		end)
	end
	return b
end

-- A gold pill with a coin and the coin price (the Eggs tab paid with coins); grey "NEED n" when the player is short.
local function coinPill(parent: Instance, price: number, cash: number, props: { [string]: any }?, size: number?, onBuy: (() -> ())?): TextButton
	local short = cash < price
	local text = UI.num(price) -- short of coins: the pill goes grey and does nothing (the server also refuses)
	local top, bottom, edgeColor = K.Gold, K.RibbonGold, Theme.Color.GoldDeep
	if short then
		top, bottom, edgeColor = Theme.Color.Disabled, Theme.Color.Disabled, Theme.Color.GrayDeep
	end
	local b, l = pill(parent, text, top, bottom, edgeColor, props, size)
	b.Name = "BuyCoins"
	local s = size or 18
	local w = s * 1.05
	UI.icon(b, "cash", w, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, s * 0.6, 0.5, 0), ZIndex = b.ZIndex + 1 })
	l.Position = UDim2.fromOffset(s * 0.6 + w + 4, 0)
	l.Size = UDim2.new(1, -(s * 0.6 + w + 10), 1, -4)
	l.TextXAlignment = Enum.TextXAlignment.Center
	if onBuy and not short then
		b.Activated:Connect(onBuy)
	end
	return b
end

-- One of the three shop eggs, each with its own look (ShopEgg), spinning slowly on a halo disc.
local function eggView(parent: Instance, eggId: string, variant: number, props: { [string]: any }?, yaw: number?, pitch: number?, halo: boolean?): GuiObject
	local egg = RobuxConfig.egg(eggId)
	return ShopEgg.view(parent, eggId, props, { Yaw = yaw, Pitch = pitch, Variant = variant, Halo = halo ~= false, Image = if egg then egg.Image else nil })
end

-- Section heading: icon disc, big name, grey one-liner.
local function heading(parent: Instance, icon: string, name: string, blurb: string, order: number)
	local row = UI.frame(parent, { Name = "Head_" .. name, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = order })
	local disc = dot(row, K.Blue, 28, { Position = UDim2.fromOffset(2, 3) })
	UI.icon(disc, icon, 18, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6 })
	-- an upright phone stacks the one-liner under the name (each on its own row; centred in one 48 px row they met)
	local portrait = UI.isPortrait()
	words(row, name, 26, { Position = UDim2.fromOffset(38, 0), Size = UDim2.new(0, 220, 0, if portrait then 30 else 34), OutlineColor = K.TitleEdge, OutlineThick = 2.6 })
	words(row, blurb, 13, { Position = UDim2.fromOffset(if portrait then 38 else 250, if portrait then 30 else 2), Size = UDim2.new(1, if portrait then -48 else -260, 0, if portrait then 18 else 30), OutlineThick = 1.6 })
	if portrait then
		row.Size = UDim2.new(1, 0, 0, 50)
	end
end

-- Buying ----------------------------------------------------------------------------------------------------------

local function buyEgg(egg: RobuxConfig.Egg, count: number)
	Net.event("RobuxAction"):FireServer("Buy", egg.Id, count)
end
-- the same egg for coins (the old hatch stand's shrine route; the server checks the price, the room and the distance)
local payCoins = false -- Eggs tab: prices in coins instead of Robux (the "Pay with" switch)
local function buyEggCoins(egg: RobuxConfig.Egg, count: number)
	Net.event("RobuxAction"):FireServer("BuyEggCoins", egg.Id, count)
end
local function buyPotion()
	Net.event("RobuxAction"):FireServer("Buy", RobuxConfig.Potion.Id)
end
local function buyPass(key: string)
	Net.event("RobuxAction"):FireServer("Buy", key)
end
-- the Starter Pack is one Developer Product (RobuxConfig.StarterPack); the server hides nothing, it re-checks
local function buyPack()
	Net.event("RobuxAction"):FireServer("Buy", RobuxConfig.StarterPack.Id)
end
-- Auto Hatch (the pass): the shrine re-buys this coin egg; "" stops it. The server refuses without the pass (toast).
local function setAuto(eggId: string)
	Net.event("RobuxAction"):FireServer("AutoHatch", eggId)
end

-- Cards -------------------------------------------------------------------------------------------------------------

local function eggOdds(egg: RobuxConfig.Egg)
	local p = prof()
	local tierId = RobuxConfig.eggTier(if p then p.UnlockedTiers else nil)
	return LuckEvents.eggOdds(tierId, 0, RobuxConfig.eggRarity(egg))
end

local function pct(p: number): string
	if p >= 0.1 then
		return string.format("%d%%", math.floor(p * 100 + 0.5))
	elseif p >= 0.01 then
		return string.format("%.1f%%", p * 100)
	end
	return string.format("%.2g%%", p * 100)
end

-- Hero card (Featured): the Mythic egg with three eggs, a tag, a blurb and the 1-egg price.
local function heroCard(parent: Instance, egg: RobuxConfig.Egg, w: number, h: number, order: number): Frame
	local c = card(parent, EGG_TONE[egg.Id] or "purple", { Name = "Hero", Size = UDim2.fromOffset(w, h), LayoutOrder = order })
	local k = h / 190 -- the reference hero is 0.32 of the screen height; everything scales with it
	-- rows from the top: ribbon, title, a two-line blurb, then the price pill on the bottom row. Computed from the
	-- card height so a short card (844x390 window) never cuts the blurb ("The best egg in the") or stacks rows.
	local ribbonY = math.floor(6 + 4 * k)
	local titleY = ribbonY + 20
	local pillH = math.floor(math.clamp(h * 0.24, 26, 34))
	local pillTop = h - 8 - pillH
	local blurbH = 32 -- two lines of body words
	local blurbY = pillTop - 2 - blurbH
	local titleH = math.max(22, blurbY - titleY - 2)
	ribbon(c, EGG_TAG[egg.Id] or "FEATURED", K.RibbonPink, { Position = UDim2.fromOffset(16, ribbonY), Size = UDim2.fromOffset(108, 20) }) -- wide enough for BEST ODDS on one line at the text floor
	local title = words(c, egg.Name .. "!", math.floor(36 * k + 6), { Position = UDim2.fromOffset(16, titleY), Size = UDim2.new(0.56, 0, 0, titleH), OutlineThick = 3, ZIndex = 5 })
	title.TextWrapped = false
	words(c, EGG_BLURB[egg.Id] or "", 14, { Position = UDim2.fromOffset(16, blurbY), Size = UDim2.new(0.56, 0, 0, blurbH), TextYAlignment = Enum.TextYAlignment.Top, OutlineThick = 1.6, ZIndex = 5 })
	pricePill(c, priceText(egg.Products[1] or 0, false), { Position = UDim2.fromOffset(16, pillTop), Size = UDim2.fromOffset(104, pillH) }, 20, function()
		buyEgg(egg, 1)
	end)
	-- three eggs on glowing discs
	local cx = w * 0.74
	local big = math.min(h * 0.84, w * 0.26)
	local function disc(x: number, y: number, s: number, variant: number, yaw: number)
		local d = Instance.new("Frame")
		d.BackgroundColor3 = K.White
		d.BackgroundTransparency = 0.72
		d.BorderSizePixel = 0
		d.AnchorPoint = Vector2.new(0.5, 0.5)
		d.Position = UDim2.fromOffset(x, y)
		d.Size = UDim2.fromOffset(s, s)
		d.ZIndex = 4
		round(d, 999)
		edge(d, K.White, 2)
		d.Parent = c
		eggView(d, egg.Id, variant, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.05, 1.05) }, yaw, 0, false)
		return d
	end
	disc(cx - big * 0.7, h * 0.54, big * 0.7, 2, -40)
	disc(cx + big * 0.7, h * 0.54, big * 0.7, 3, 30)
	disc(cx, h * 0.48, big, 1, -15)
	-- carousel dots (one page for now)
	local nav = UI.frame(c, { Name = "Nav", BackgroundColor3 = K.Shade, BackgroundTransparency = 0.6, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -12), Size = UDim2.fromOffset(60, 18), ZIndex = 5 })
	round(nav, 999)
	local pip = UI.frame(nav, { BackgroundColor3 = K.White, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(22, 8), ZIndex = 6 })
	round(pip, 999)
	return c
end

-- Small side card (Featured right column): name, one line, a price pill, an egg or an icon.
local function sideCard(parent: Instance, tone: string, name: string, line: string, price: string, w: number, h: number, order: number, tag: string?, tagColor: Color3?, art: (Frame) -> (), onBuy: (() -> ())?): Frame
	local c = card(parent, tone, { Name = "Side_" .. name, Size = UDim2.fromOffset(w, h), LayoutOrder = order })
	local artBox = UI.frame(c, { Name = "Art", BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 4), Size = UDim2.fromOffset(h - 8, h - 8), ZIndex = 4 })
	art(artBox)
	-- rows from the top, right of the art: ribbon (when there is a tag), name, one-line blurb; the price pill sits on
	-- the bottom row. Everything is computed from the card height: a short card drops the blurb, then shrinks the
	-- name, rather than letting a row sit over another (the 844x390 window showed "15 MIN" over "Luck Potion").
	local x0 = h + 2
	local tw = w - (h + 10)
	local ph = math.floor(math.clamp(h * 0.36, 24, 28)) -- holds the price words at the text floor
	local pillTop = h - 3 - ph
	local ns = math.floor(math.clamp(h * 0.26, 15, 22))
	local titleH = ns + 4
	local lineH = 15
	local y = 1
	if tag then
		ribbon(c, tag, tagColor or K.RibbonGold, { Position = UDim2.fromOffset(x0, y), Size = UDim2.fromOffset(66, 16) })
		y += 17
	end
	local room = pillTop - y
	local showLine = room >= titleH + lineH
	if not showLine and room < titleH then
		titleH = math.max(room, 17)
		ns = math.clamp(titleH - 4, 14, ns)
	end
	local nameL = words(c, name, ns, { Position = UDim2.fromOffset(x0, y), Size = UDim2.new(0, tw, 0, titleH), OutlineThick = 2.4, ZIndex = 5 })
	nameL.TextWrapped = false
	y += titleH
	if showLine then
		words(c, line, 12, { Position = UDim2.fromOffset(x0, y), Size = UDim2.new(0, tw, 0, lineH), OutlineThick = 1.4, TextWrapped = false, ZIndex = 5 })
	end
	pricePill(c, price, { Position = UDim2.fromOffset(x0, pillTop), Size = UDim2.fromOffset(84, ph) }, 14, onBuy)
	return c
end

local EGG_ROW_H = 44 -- a thumb-sized buy row; the pill fills it less 6
local EGG_ROW_GAP = 10
local function portraitArtW(w: number): number
	return math.min(150, math.floor(w * 0.4))
end
-- Height of an upright-phone egg card (the egg, the odds row, the Lucky Meter and the buy rows stacked).
local function eggCardHeight(w: number): number
	local n = 5 -- rarities (RARITY_HEX)
	local colW = (w - 20) / n
	local ds = math.floor(math.clamp(math.min(44, colW * 0.6), 28, 44))
	local oy = portraitArtW(w) + 24
	local my = oy + ds + 40
	local colY = my + 16 + 10
	return colY + (if payCoins then 4 else 0) + #RobuxConfig.EggCounts * (EGG_ROW_H + EGG_ROW_GAP) - EGG_ROW_GAP + 10
end
-- A limited egg's wide card is taller by its ENDS IN chip row (an upright phone keeps the chip beside the egg).
local function limitedCardH(eggH: number): number
	return if UI.isPortrait() then eggH else eggH + 26
end

-- Wide egg card: big egg, name, tag, the full rarity odds, and the 1 / 3 / 10 egg price rows on the right.
local function eggCard(parent: Instance, egg: RobuxConfig.Egg, w: number, h: number, order: number): Frame
	local limited = egg.Limited == true
	local c = card(parent, EGG_TONE[egg.Id] or (if limited then LIMITED_TONE else "gold"), { Name = "EggCard_" .. egg.Id, Size = UDim2.fromOffset(w, h), LayoutOrder = order })
	local portrait = UI.isPortrait()
	local rows = RobuxConfig.EggCounts
	local rowH = EGG_ROW_H
	local gap = EGG_ROW_GAP
	local colWidth = if portrait then w - 20 else math.floor(w * 0.27)
	local colX = if portrait then 10 else w - colWidth - 14
	local artW = if portrait then portraitArtW(w) else math.min(h * 0.86, w * 0.2)
	eggView(c, egg.Id, 1, { Position = UDim2.fromOffset(12, if portrait then 10 else (h - artW) / 2), Size = UDim2.fromOffset(artW, artW) }, -25, 0)
	ribbon(c, EGG_TAG[egg.Id] or (if limited then "LIMITED" else ""), K.RibbonRed, { Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(108, 20), Rotation = -8 })
	local x0 = artW + 26
	local textW = if portrait then w - x0 - 10 else colX - x0 - 12
	local titleL = words(c, egg.Name, 30, { Position = UDim2.fromOffset(x0, 8), Size = UDim2.fromOffset(math.min(200, textW), 38), OutlineThick = 3, ZIndex = 5 })
	titleL.TextWrapped = false -- one line, shrunk to fit (two lines ran into the blurb on an upright phone)
	if textW > 300 and not limited then
		-- tags are fitted text, which wraps when the box is narrower than the words at the text floor: the boxes are
		-- wide enough for the longest tag on one line (BETTER ODDS broke into two lines on a phone)
		ribbon(c, if egg.Rarity then "BETTER ODDS" else "RACE ODDS", K.Blue, { Position = UDim2.fromOffset(x0 + 204, 16), Size = UDim2.fromOffset(118, 22) })
	end
	-- the blurb wraps to two lines beside a tall egg on an upright phone, and on a narrow landscape window where one
	-- line of body words (about 7.5 px a letter) would not fit: the box is tall enough for both, and the odds row
	-- starts under it (the second line ran into the dots on the 844x390 window)
	local blurb = EGG_BLURB[egg.Id] or (if limited then string.format("1 in %d SHINY! Gone when time's up.", egg.ShinyOneIn or LaunchPerks.Shiny.OneIn) else "")
	local blurbLines = if portrait or textW < #blurb * 7.5 then 2 else 1
	local blurbH = if blurbLines == 2 then 34 else 18
	words(c, blurb, 13, { Position = UDim2.fromOffset(x0, 48), Size = UDim2.fromOffset(textW, blurbH), TextYAlignment = Enum.TextYAlignment.Top, OutlineThick = 1.6, ZIndex = 5 })
	-- limited egg: a dark chip with the clock counting down to the end of the sale (label updated once a second)
	local chipH = 0
	if limited then
		chipH = 26
		local chip = UI.frame(c, { Name = "EndsIn", BackgroundColor3 = K.TabBar, Position = UDim2.fromOffset(x0, 48 + blurbH + 2), Size = UDim2.fromOffset(math.min(176, textW), 22), ZIndex = 5 })
		round(chip, 999)
		edge(chip, K.TabBarEdge, 2)
		UI.icon(chip, "clock", 14, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), ZIndex = 6 })
		local lbl = words(chip, "ENDS IN " .. endsText(limitedEndsAt - os.time()), 12, { Name = "Text", Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -32, 1, 0), TextColor3 = K.Gold, OutlineThick = 1.4, ZIndex = 6 })
		lbl.TextWrapped = false
		tickers.Limited = function()
			if lbl.Parent then
				lbl.Text = "ENDS IN " .. endsText(limitedEndsAt - os.time())
			end
		end
	end
	-- odds: a dot per rarity with its name and chance
	local odds = eggOdds(egg)
	local n = #odds.Rarity
	local oddsX = if portrait then 10 else x0
	local oddsW = if portrait then w - 20 else textW
	local colW = oddsW / n
	local meterH = 16
	local autoH = if payCoins then 26 else 0 -- the AUTO pill shares the meter row and sits a little lower
	local meterY = if portrait then 0 else h - 6 - meterH - (if payCoins then 4 else 0) -- (portrait: set after the odds row)
	-- the dots row sits under the blurb (never over it or the BETTER ODDS ribbon), and above the Lucky Meter with
	-- room for the name and the chance under each dot; dots are 28 px or more (a fingertip)
	local oy = if portrait then artW + 24 else 48 + blurbH + 4 + chipH
	local dotRoom = if portrait then 44 else meterY - 4 - oy - 40 -- name (18) + chance (18) rows under the dots
	local ds = math.floor(math.clamp(math.min(44, colW * 0.6, h * 0.24, dotRoom), 28, 44))
	for i, r in odds.Rarity do
		local x = oddsX + (i - 1) * colW
		local col = RARITY_HEX[r.Name] or K.White
		dot(c, col, ds, { Position = UDim2.fromOffset(x + (colW - ds) / 2, oy) })
		if portrait or colW < 78 then
			-- narrow columns: the chance sits inside the dot and the names zigzag over two rows so neighbours never touch
			words(c, pct(r.P), 12, { Position = UDim2.fromOffset(x + (colW - ds) / 2, oy), Size = UDim2.fromOffset(ds, ds), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = K.Ink, Outline = false, ZIndex = 6 })
			local nameL = words(c, r.Name, 12, { Position = UDim2.fromOffset(x - 8, oy + ds + 2 + (i % 2) * 15), Size = UDim2.fromOffset(colW + 16, 15), TextXAlignment = Enum.TextXAlignment.Center, OutlineThick = 1.6, ZIndex = 5 })
			nameL.TextWrapped = false
		else
			local nameL = words(c, r.Name, 12, { Position = UDim2.fromOffset(x - 6, oy + ds + 2), Size = UDim2.fromOffset(colW + 12, 18), TextXAlignment = Enum.TextXAlignment.Center, OutlineThick = 1.6, ZIndex = 5 })
			nameL.TextWrapped = false -- one word stays one line (never "Legendar" over a clipped second line)
			words(c, pct(r.P), 13, { Position = UDim2.fromOffset(x - 6, oy + ds + 20), Size = UDim2.fromOffset(colW + 12, 18), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = col, OutlineThick = 1.6, ZIndex = 5 })
		end
	end
	-- Lucky Meter (shared/EggPerks): every shop egg fills it; full = the next egg is Epic or better. Shown with the
	-- odds, so a Robux egg's pity rule is disclosed before buying.
	local me = prof()
	local eggPerks: any = if me then me.EggPerks else nil
	local meter = if type(eggPerks) == "table" then tonumber(eggPerks.Meter) or 0 else 0
	local need = if type(eggPerks) == "table" then tonumber(eggPerks.MeterNeed) or EggPerks.Meter.Need else EggPerks.Meter.Need
	local pts = EggPerks.Meter.Points[egg.Id] or 1
	local my = if portrait then oy + ds + 40 else meterY
	local mh = meterH
	-- paying with coins: the AUTO pill (Auto Hatch pass) takes the right end of the meter row
	local autoW = if payCoins then 92 else 0
	local trackW = oddsW - (if payCoins then autoW + 8 else 0)
	local track = UI.frame(c, { Name = "LuckyMeter", BackgroundColor3 = K.Ink, BackgroundTransparency = 0.82, Position = UDim2.fromOffset(oddsX, my), Size = UDim2.fromOffset(trackW, mh), ZIndex = 4 })
	round(track, 999)
	local fill = UI.frame(track, { Name = "Fill", BackgroundColor3 = K.Lime, Size = UDim2.new(math.clamp(meter / math.max(need, 1), 0, 1), 0, 1, 0), ZIndex = 5 })
	round(fill, 999)
	PetStyle.vgrad(fill, K.LimeTop, K.Lime)
	local meterText = string.format("LUCKY METER %d/%d  \u{b7}  +%d per egg  \u{b7}  full = EPIC or better", meter, need, pts)
	if trackW < 240 then
		meterText = string.format("METER %d/%d  \u{b7}  EPIC+", meter, need)
	elseif trackW < 420 then
		meterText = string.format("LUCKY METER %d/%d  \u{b7}  full = EPIC+", meter, need)
	end
	local ml = words(track, meterText, 12, { Name = "Text", Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0), TextXAlignment = Enum.TextXAlignment.Center, OutlineThick = 1.4, ZIndex = 6 })
	ml.TextWrapped = false
	if payCoins then
		-- AUTO: green "AUTO ON" when this is the egg the shrine is auto-hatching (Perks.AutoEgg), blue "AUTO" otherwise.
		-- The colour is the only thing the client decides: the server checks the pass and toasts without it.
		local pk = perks()
		local on = pk ~= nil and pk.AutoEgg == egg.Id
		local pos = { Name = "Auto", Position = UDim2.fromOffset(oddsX + oddsW - autoW, my + mh / 2 - autoH / 2), Size = UDim2.fromOffset(autoW, autoH) }
		local b = if on
			then pill(c, "AUTO ON", K.LimeTop, K.Lime, K.LimeEdge, pos, 13)
			else pill(c, "AUTO", K.BlueTop, K.Blue, K.BlueEdge, pos, 13)
		b.Name = "Auto"
		b.Activated:Connect(function()
			setAuto(if on then "" else egg.Id)
		end)
	end
	-- buy rows (right column, or a bottom stack in portrait)
	local colY = if portrait then my + mh + 10 + (if payCoins then 4 else 0) else math.floor((h - (#rows * rowH + (#rows - 1) * gap)) / 2)
	for i, count in rows do
		local y = colY + (i - 1) * (rowH + gap)
		local row = UI.frame(c, { Name = "Row" .. count, BackgroundColor3 = K.White, Position = UDim2.fromOffset(colX, y), Size = UDim2.fromOffset(colWidth, rowH), ZIndex = 4 })
		round(row, 999)
		edge(row, K.Ink, 2)
		local countL = words(row, count .. (if count == 1 then " Egg" else " Eggs"), 17, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.5, -14, 1, 0), TextColor3 = K.Ink, Outline = false, ZIndex = 5 })
		countL.TextWrapped = false
		if i == #rows then
			-- the tag hangs on the row's top edge, inside the gap above it (never over the odds dots to the left)
			ribbon(row, "BEST VALUE", K.RibbonGold, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(120, 18), Rotation = -4 })
		end
		local pillProps = { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -3, 0.5, 0), Size = UDim2.fromOffset(math.min(96, colWidth * 0.5), rowH - 6) }
		if payCoins then
			local p = prof()
			local tierId = RobuxConfig.eggTier(if p then p.UnlockedTiers else nil)
			local price = RobuxConfig.eggCoinPrice(egg.Id, tierId, count) or 0
			coinPill(row, price, if p then tonumber(p.Cash) or 0 else 0, pillProps, 16, function()
				buyEggCoins(egg, count)
			end)
		else
			pricePill(row, priceText(egg.Products[count] or 0, false), pillProps, 16, function()
				buyEgg(egg, count)
			end)
		end
	end
	return c
end

-- Pass card: icon disc with a gift badge, name, effect pill, description, price.
local function passCard(parent: Instance, pass: RobuxConfig.Pass, w: number, h: number, order: number, owned: boolean, pos: UDim2?): Frame
	local c = card(parent, PASS_TONE[pass.Key] or "blue", { Name = "Pass_" .. pass.Key, Size = UDim2.fromOffset(w, h), LayoutOrder = order, Position = pos or UDim2.new() })
	local ds = math.floor(h * 0.3)
	local disc = dot(c, K.White:Lerp(TONES[PASS_TONE[pass.Key] or "blue"][1], 0.4), ds, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6) })
	if pass.Key == "DoubleCoins" then
		local coinD = dot(disc, K.Gold, ds * 0.62, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		words(coinD, "$", ds * 0.4, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(140, 90, 0), Outline = false, ZIndex = 7 })
	else
		UI.icon(disc, PASS_ICON[pass.Key] or "star", ds * 0.6, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6 })
	end
	local gift = dot(c, K.RibbonPink, 22, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6) })
	UI.icon(gift, "star", 13, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6 })
	words(c, pass.Name, 17, { Position = UDim2.fromOffset(6, ds + 8), Size = UDim2.new(1, -12, 0, 22), TextXAlignment = Enum.TextXAlignment.Center, OutlineThick = 2.4, ZIndex = 5 })
	local eff = UI.frame(c, { BackgroundColor3 = K.Shade, BackgroundTransparency = 0.45, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, ds + 32), Size = UDim2.fromOffset(w * 0.72, 18), ZIndex = 4 })
	round(eff, 999)
	words(eff, PASS_EFFECT[pass.Key] or "", 12, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = K.Gold, OutlineThick = 1.4, ZIndex = 5 })
	words(c, pass.Desc, 11, { Position = UDim2.fromOffset(8, ds + 52), Size = UDim2.new(1, -16, 0, 28), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, OutlineThick = 1.3, ZIndex = 5 })
	if owned then
		local b = pill(c, "OWNED", K.BlueTop, K.Blue, K.BlueEdge, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.fromOffset(w * 0.84, 26) }, 14)
		b.Name = "Owned"
	else
		pricePill(c, priceText(pass.PassId, true), { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.fromOffset(w * 0.84, 26) }, 14, function()
			buyPass(pass.Key)
		end)
	end
	return c
end

-- Potion card: a wide violet card with a bottle drawn from parts, the effect and the price.
local function potionCard(parent: Instance, w: number, h: number, order: number): Frame
	local c = card(parent, "violet", { Name = "Potion", Size = UDim2.fromOffset(w, h), LayoutOrder = order })
	local portrait = UI.isPortrait()
	-- an upright phone: the bottle keeps the top-left, the words run the card's width and the price pill sits on the
	-- bottom row (the title broke into two lines over the blurb, and the blurb ran under the pill)
	local ds = if portrait then math.min(h * 0.5, 72) else h * 0.68
	local disc = dot(c, Color3.fromRGB(120, 230, 90), ds, { Position = UDim2.fromOffset(14, if portrait then 12 else h * 0.16) })
	UI.icon(disc, "boostLuck", ds * 0.62, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6 })
	local x0 = math.floor(ds + (if portrait then 28 else 30))
	ribbon(c, "15 MIN", K.RibbonGold, { Position = UDim2.fromOffset(x0, 10), Size = UDim2.fromOffset(64, 18) })
	local title = words(c, RobuxConfig.Potion.Name, 28, { Position = UDim2.fromOffset(x0, 28), Size = if portrait then UDim2.new(1, -(x0 + 14), 0, 36) else UDim2.new(0.5, 0, 0, 36), OutlineThick = 3, ZIndex = 5 })
	title.TextWrapped = false -- one line, shrunk to fit
	local blurb = "Rare and better pets twice as likely for 15 minutes. Stacks."
	if portrait then
		words(c, blurb, 13, { Position = UDim2.fromOffset(x0, 66), Size = UDim2.new(1, -(x0 + 14), 0, 36), TextYAlignment = Enum.TextYAlignment.Top, OutlineThick = 1.6, ZIndex = 5 })
		pricePill(c, priceText(RobuxConfig.Potion.ProductId, false), { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -8), Size = UDim2.fromOffset(110, 38) }, 20, buyPotion)
	else
		words(c, blurb, 13, { Position = UDim2.fromOffset(x0, 64), Size = UDim2.new(1, -(x0 + 140), 0, 20), OutlineThick = 1.6, ZIndex = 5 })
		pricePill(c, priceText(RobuxConfig.Potion.ProductId, false), { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0), Size = UDim2.fromOffset(110, 38) }, 20, buyPotion)
	end
	return c
end

-- Starter Pack card (Featured, once per player; RobuxConfig.StarterPack): the pack's eggs fanned on a disc, a ONE
-- TIME ONLY ribbon, what is inside and the Robux price. Hidden once Perks.StarterPack is true.
local function packCard(parent: Instance, w: number, h: number, order: number): Frame
	local pack = RobuxConfig.StarterPack
	local c = card(parent, "green", { Name = "Pack", Size = UDim2.fromOffset(w, h), LayoutOrder = order })
	local portrait = UI.isPortrait()
	local ds = if portrait then math.min(h * 0.5, 72) else h * 0.68
	local disc = dot(c, K.White:Lerp(TONES.green[1], 0.3), ds, { Position = UDim2.fromOffset(14, if portrait then 12 else h * 0.16) })
	local eggId, n = "RareEgg", 0
	local parts = {}
	for id, count in pack.Eggs do
		local e = RobuxConfig.egg(id)
		eggId = id
		n += count
		table.insert(parts, count .. " " .. (if e then e.Name else "Egg") .. (if count == 1 then "" else "s"))
	end
	table.sort(parts)
	-- the eggs inside, fanned on the disc, with their count on a small gold tag
	eggView(disc, eggId, 2, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.3, 0.52), Size = UDim2.fromScale(0.62, 0.62), ZIndex = 6 }, -30, 0, false)
	eggView(disc, eggId, 3, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.7, 0.52), Size = UDim2.fromScale(0.62, 0.62), ZIndex = 6 }, 30, 0, false)
	eggView(disc, eggId, 1, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.46), Size = UDim2.fromScale(0.74, 0.74), ZIndex = 7 }, -10, 0, false)
	ribbon(disc, "x" .. n, K.RibbonGold, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 4, 1, 2), Size = UDim2.fromOffset(40, 18), ZIndex = 8 })
	local x0 = math.floor(ds + (if portrait then 28 else 30))
	ribbon(c, "ONE TIME ONLY", K.RibbonPink, { Position = UDim2.fromOffset(x0, 8), Size = UDim2.fromOffset(140, 20) }) -- wide enough for one line at the text floor
	local title = words(c, pack.Name .. "!", 28, { Position = UDim2.fromOffset(x0, 28), Size = if portrait then UDim2.new(1, -(x0 + 14), 0, 36) else UDim2.new(0.5, 0, 0, 36), OutlineThick = 3, ZIndex = 5 })
	title.TextWrapped = false -- one line, shrunk to fit
	local inside = table.concat(parts, " + ") .. " + " .. math.floor(pack.PotionSeconds / 60) .. " min 2x luck"
	local price = priceText(pack.ProductId, false)
	if portrait then
		words(c, inside, 13, { Position = UDim2.fromOffset(x0, 66), Size = UDim2.new(1, -(x0 + 14), 0, 36), TextYAlignment = Enum.TextYAlignment.Top, OutlineThick = 1.6, ZIndex = 5 })
		pricePill(c, price, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -8), Size = UDim2.fromOffset(110, 38) }, 20, buyPack)
	else
		words(c, inside, 13, { Position = UDim2.fromOffset(x0, 64), Size = UDim2.new(1, -(x0 + 140), 0, 20), OutlineThick = 1.6, ZIndex = 5 })
		pricePill(c, price, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0), Size = UDim2.fromOffset(110, 38) }, 20, buyPack)
	end
	return c
end

-- White sheet with the pass cards in a row (a grid in portrait).
local function passSheet(parent: Instance, w: number, order: number): Frame
	local p = prof()
	local ownedN = 0
	local keys = RobuxConfig.PassOrder
	for _, k in keys do
		if p and p.Robux and p.Robux.Passes and p.Robux.Passes[k] then
			ownedN += 1
		end
	end
	local portrait = UI.isPortrait()
	local gap = 10
	-- one row of six on a wide screen; a phone on its side (844 wide) gets two rows of three, an upright phone three
	-- rows of two, so every card keeps at least 150 px for its name, effect pill and price
	local cols = if portrait then 2 elseif (w - 24 - gap * (#keys - 1)) / #keys >= 150 then #keys else math.ceil(#keys / 2)
	-- wide screens: the cards grow (up to 250) and the row sits in the middle, so no empty white field is left
	local cardW = if portrait then (w - 24 - gap) / 2 else math.floor(math.min(250, (w - 24 - gap * (cols - 1)) / cols))
	local rowX = if portrait then 12 else math.floor((w - (cols * cardW + (cols - 1) * gap)) / 2)
	local cardH = 180
	local rows = math.ceil(#keys / cols)
	local sheetH = 44 + rows * cardH + (rows - 1) * gap + 14
	local _, sheet = shadowed(parent, 14, 4, nil, { Name = "PassSheet", Size = UDim2.fromOffset(w, sheetH), LayoutOrder = order })
	edge(sheet, K.PanelEdge, 2)
	pattern(sheet, K.PanelPattern, 0.25, 40, w, sheetH)
	local disc = dot(sheet, K.Blue, 26, { Position = UDim2.fromOffset(12, 9) })
	UI.icon(disc, "egg", 16, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6 })
	words(sheet, "Boosts", 22, { Position = UDim2.fromOffset(44, 6), Size = UDim2.fromOffset(120, 32), TextColor3 = K.Blue, OutlineColor = K.TitleEdge, OutlineThick = 2.2, ZIndex = 5 })
	local cnt = UI.frame(sheet, { BackgroundColor3 = K.TabBar, Position = UDim2.fromOffset(166, 12), Size = UDim2.fromOffset(84, 20), ZIndex = 4 })
	round(cnt, 999)
	words(cnt, ownedN .. "/" .. #keys .. " owned", 12, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, OutlineThick = 1.2, ZIndex = 5 })
	if not portrait then
		words(sheet, "More coins, more pets, more spots", 13, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 12), Size = UDim2.fromOffset(240, 20), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = K.TitleEdge, Outline = false, ZIndex = 5 })
	end
	for i, key in keys do
		local pass = RobuxConfig.Passes[key]
		local col = (i - 1) % cols
		local row = (i - 1) // cols
		passCard(sheet, pass, cardW, cardH, i, p ~= nil and p.Robux ~= nil and p.Robux.Passes ~= nil and p.Robux.Passes[key] == true, UDim2.fromOffset(rowX + col * (cardW + gap), 44 + row * (cardH + gap)))
	end
	return sheet
end

-- Screen ------------------------------------------------------------------------------------------------------------

local function renderNow()
	local sc = content
	if not sc or not open then
		return
	end
	for _, ch in table.clone(sc:GetChildren()) do
		if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then
			ch:Destroy()
		end
	end
	tickers.Limited = nil -- the content's countdown label is rebuilt below
	local portrait = UI.isPortrait()
	local w = contentW
	local p = prof()
	local pk = perks()
	local hidden = player:GetAttribute("PaidRandomRestricted") ~= false
	local limitedOn = limitedEgg() -- the limited egg on sale (Robux only: it has no coin price)
	local order = 0
	local function next(): number
		order += 1
		return order
	end
	local eggs = RobuxConfig.Eggs
	local mythic = eggs[#eggs]
	if tab == "Featured" then
		if not hidden then
			-- hero + side column
			local H = UI.Logical.Y
			-- 144 or taller: the two side cards (half of it each) need their ribbon, name and pill rows
			local heroH = if portrait then 150 else math.floor(math.clamp(H * 0.32, 144, 200))
			local eggH = if portrait then eggCardHeight(w) else math.floor(math.clamp(H * 0.38, 172, 230))
			if portrait then
				heroCard(sc, mythic, w, heroH, next())
				sideCard(sc, "gold", eggs[2].Name, "1 in 200 Legendary", priceText(eggs[2].Products[1] or 0, false), w, 64, next(), nil, nil, function(box)
					eggView(box, eggs[2].Id, 2, { Size = UDim2.fromScale(1, 1) }, -20, 0, false)
				end, function()
					buyEgg(eggs[2], 1)
				end)
				sideCard(sc, "violet", RobuxConfig.Potion.Name, "+1 luck for 15 minutes", priceText(RobuxConfig.Potion.ProductId, false), w, 64, next(), "15 MIN", K.RibbonGold, function(box)
					UI.icon(box, "boostLuck", 36, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6 })
				end, buyPotion)
			else
				local rowF = UI.frame(sc, { Name = "TopRow", BackgroundTransparency = 1, Size = UDim2.fromOffset(w, heroH), LayoutOrder = next() })
				local sideW = math.floor(w * 0.3)
				local heroW = w - sideW - 12
				heroCard(rowF, mythic, heroW, heroH, 1)
				local col = UI.frame(rowF, { Name = "Side", BackgroundTransparency = 1, Position = UDim2.fromOffset(heroW + 12, 0), Size = UDim2.fromOffset(sideW, heroH) })
				UI.list(col, Enum.FillDirection.Vertical, 12)
				local sh = (heroH - 12) / 2
				sideCard(col, "gold", eggs[2].Name, "1 in 200 Legendary", priceText(eggs[2].Products[1] or 0, false), sideW, sh, 1, nil, nil, function(box)
					eggView(box, eggs[2].Id, 2, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.3, 1.3) }, -20, 0, false)
				end, function()
					buyEgg(eggs[2], 1)
				end)
				sideCard(col, "violet", RobuxConfig.Potion.Name, "+1 luck for 15 minutes", priceText(RobuxConfig.Potion.ProductId, false), sideW, sh, 2, "15 MIN", K.RibbonGold, function(box)
					UI.icon(box, "boostLuck", math.min(36, sh * 0.6), { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6 })
				end, buyPotion)
			end
			-- Starter Pack (once per player; Perks.StarterPack hides it, the server re-checks) and the limited egg
			if not (pk and pk.StarterPack == true) then
				packCard(sc, w, if portrait then 160 else 110, next())
			end
			if limitedOn then
				eggCard(sc, limitedOn, w, limitedCardH(eggH), next())
			end
			eggCard(sc, mythic, w, eggH, next())
		end
		heading(sc, "egg", "Gamepasses", "Permanent. Pay once, keep forever", next())
		passSheet(sc, w, next())
	elseif tab == "Eggs" then
		if hidden then
			words(sc, "Eggs are not for sale on this account.", 16, { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = next() })
		else
			-- "Pay with" switch: Robux (the products) or coins (the old hatch stand's prices, for the player's best zone)
			local sw = UI.frame(sc, { Name = "PayWith", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = next() })
			words(sw, "Pay with", 16, { Position = UDim2.fromOffset(4, 0), Size = UDim2.fromOffset(90, 36), OutlineThick = 2 })
			local function payPill(x: number, label: string, coins: boolean)
				local on = payCoins == coins
				local b = if on
					then pill(sw, label, K.LimeTop, K.Lime, K.LimeEdge, { Position = UDim2.fromOffset(x, 2), Size = UDim2.fromOffset(96, 32) }, 15)
					else pill(sw, label, K.TabBar, K.TabBar, K.TabBarEdge, { Position = UDim2.fromOffset(x, 2), Size = UDim2.fromOffset(96, 32) }, 15)
				b.Name = "Pay_" .. label
				b.Activated:Connect(function()
					if payCoins ~= coins then
						payCoins = coins
						requestRender()
					end
				end)
			end
			payPill(96, "Robux", false)
			payPill(200, "Coins", true)
			local H = UI.Logical.Y
			local eggH = if portrait then eggCardHeight(w) else math.floor(math.clamp(H * 0.38, 172, 230))
			if limitedOn and not payCoins then
				eggCard(sc, limitedOn, w, limitedCardH(eggH), next())
			end
			for i = #eggs, 1, -1 do
				eggCard(sc, eggs[i], w, eggH, next())
			end
		end
	elseif tab == "Passes" then
		heading(sc, "egg", "Gamepasses", "Permanent. Pay once, keep forever", next())
		passSheet(sc, w, next())
	elseif tab == "Potions" then
		if hidden then
			words(sc, "Potions are not for sale on this account.", 16, { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = next() })
		else
			potionCard(sc, w, if portrait then 160 else 110, next()) -- upright: the words sit over the pill
			local until_ = if p and p.Robux then p.Robux.LuckUntil or 0 else 0
			local left = math.max(0, until_ - os.time())
			-- the status line sits on its own white strip (plain words straight on the world read unfinished)
			local _, strip = shadowed(sc, 12, 3, nil, { Name = "PotionStatus", Size = UDim2.new(1, 0, 0, 40), LayoutOrder = next() })
			edge(strip, K.PanelEdge, 2)
			words(strip, if left > 0 then string.format("Potion running: %d min left", math.ceil(left / 60)) else "No potion running. Weekends are 2x luck for everyone.", 14, { Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0), TextColor3 = K.TitleEdge, Outline = false, ZIndex = 5 })
		end
	end
	UI.frame(sc, { Name = "EndGap", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 12), LayoutOrder = next() })
	-- the cards pop in one after another (Theme.Spring.Pop; Reduce Motion: none)
	local i = 0
	for _, ch in sc:GetChildren() do
		if ch:IsA("GuiObject") and ch.Visible and ch.Name ~= "EndGap" and ch.AbsoluteSize.Y ~= 0 then
			UI.pop(ch, 0.86, i * 0.04)
			i += 1
		end
	end
end

function render()
	if rendering then
		renderQueued = true
		return
	end
	rendering = true
	local ok, err = pcall(renderNow :: any)
	rendering = false
	if not ok then
		warn("[PetShop] render failed: " .. tostring(err))
	end
	if renderQueued then
		renderQueued = false
		task.defer(render)
	end
end

local function closeShop()
	open = false
	UI.closeModal()
end

local function build()
	-- the modal gives the shade, the blur, the gamepad focus and the close rules; its own sheet is hidden
	local pnl = UI.modal("PetShop", "", Vector2.new(4000, 4000), { Fixed = true, NoClose = true })
	pnl.BackgroundTransparency = 1
	pnl:SetAttribute("KitHeaderOnRim", nil)
	pnl:SetAttribute("KitPanel", nil)
	pnl:SetAttribute("OwnerSkin", true)
	for _, ch in table.clone(pnl:GetChildren()) do
		if ch.Name ~= "Body" and ch.Name ~= "Enter" and not ch:IsA("UISizeConstraint") then
			ch:Destroy()
		end
	end
	local body = pnl:FindFirstChild("Body") :: Frame
	body.Position = UDim2.fromOffset(0, 0)
	body.Size = UDim2.fromScale(1, 1)
	local bp = body:FindFirstChildOfClass("UIPadding")
	if bp then
		bp:Destroy()
	end
	local shade = pnl.Parent
	if shade and shade:IsA("GuiObject") then
		shade.BackgroundTransparency = 0.42
	end
	local portrait = UI.isPortrait()
	-- the modal panel is the screen less its margins (Size = 1 - 24 px wide, 1 - gap tall): laying out from the
	-- whole screen ran the cards past the panel's right edge (flat corners, buy pills on the rim)
	local W = UI.Logical.X + pnl.Size.X.Offset
	local H = UI.Logical.Y + pnl.Size.Y.Offset
	local sideGap = if portrait then 10 else math.floor(W * 0.07)
	local topY = if portrait then 8 else math.floor(H * 0.07)
	local barH = 44 -- the tab pills and the coin pill: a fingertip tall on every screen
	-- title
	local titleW = if portrait then 90 else 120
	local shadow = words(body, "Shop", if portrait then 34 else 42, { Name = "TitleShadow", Position = UDim2.fromOffset(sideGap, topY + 3), Size = UDim2.fromOffset(titleW, barH + 6), TextColor3 = K.TitleShadow, OutlineColor = K.TitleShadow, OutlineThick = 4, ZIndex = 3 })
	shadow.TextTransparency = 0
	words(body, "Shop", if portrait then 34 else 42, { Name = "Title", Position = UDim2.fromOffset(sideGap, topY), Size = UDim2.fromOffset(titleW, barH + 6), OutlineColor = K.TitleEdge, OutlineThick = 3.4, ZIndex = 4 })
	-- lucky hour chip (LaunchPerks): hangs under the coin pill while a lucky hour runs or is under two hours away;
	-- the rows under it move down by its height, and a change of state rebuilds the header (once an hour at most)
	local chipMode, chipLeft = luckyMode()
	local chipH = if chipMode then 24 else 0
	local chipGap = if chipMode then chipH + 4 else 0
	-- tab strip
	local coinW = if portrait then 134 else 144 -- upright: room for "12.4K" on one line beside the + disc
	local xW = barH + 8
	local stripX = sideGap + titleW + 8
	local stripW = W - sideGap - xW - 12 - coinW - 12 - stripX
	local stripY = topY + 4
	if portrait then
		stripX = sideGap
		stripY = topY + barH + 14 + chipGap
		stripW = W - 2 * sideGap
	end
	local strip = UI.frame(body, { Name = "Tabs", BackgroundColor3 = K.TabBar, Position = UDim2.fromOffset(stripX, stripY), Size = UDim2.fromOffset(stripW, barH), ZIndex = 3 })
	round(strip, 999)
	edge(strip, K.TabBarEdge, 2.5)
	local n = #TABS
	local tabW = (stripW - 8) / n
	local sel = UI.frame(strip, { Name = "Selected", BackgroundColor3 = K.Lime, Position = UDim2.fromOffset(4, 3), Size = UDim2.fromOffset(tabW, barH - 6), ZIndex = 4 })
	round(sel, 999)
	vgrad(sel, K.LimeTop, K.Lime)
	edge(sel, K.LimeEdge, 2)
	local tabButtons: { [string]: TextLabel } = {}
	local function placeSel(instant: boolean)
		local i = table.find(TABS, tab) or 1
		local target = UDim2.fromOffset(4 + (i - 1) * tabW, 3)
		if instant or still() then
			sel.Position = target
		else
			UI.spring(sel, MOTION.TabSlide, { Position = target })
		end
		for name, l in tabButtons do
			l.TextColor3 = if name == tab then K.Ink else K.TabText
			local o = l:FindFirstChild("Outline")
			if o and o:IsA("UIStroke") then
				o.Transparency = if name == tab then 1 else 0
			end
		end
	end
	for i, name in TABS do
		local b = Instance.new("TextButton")
		b.Name = "Tab_" .. name
		b.BackgroundTransparency = 1
		b.Text = ""
		b.AutoButtonColor = false
		b.Position = UDim2.fromOffset(4 + (i - 1) * tabW, 0)
		b.Size = UDim2.fromOffset(tabW, barH)
		b.ZIndex = 5
		b.Parent = strip
		local l = words(b, name, if portrait then 14 else 16, { Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = K.TabText, OutlineThick = 1.4, ZIndex = 6 })
		tabButtons[name] = l
		b.Activated:Connect(function()
			if tab ~= name then
				tab = name
				placeSel(false)
				render()
				if content then
					content.CanvasPosition = Vector2.new()
				end
			end
		end)
	end
	placeSel(true)
	-- coin pill
	local coinX = W - sideGap - xW - 12 - coinW
	local coinY = topY + 4
	local coin = UI.frame(body, { Name = "Coins", BackgroundColor3 = K.TabBar, Position = UDim2.fromOffset(coinX, coinY), Size = UDim2.fromOffset(coinW, barH), ZIndex = 3 })
	round(coin, 999)
	edge(coin, K.TabBarEdge, 2.5)
	local coinDisc = dot(coin, K.Gold, barH - 10, { Position = UDim2.fromOffset(5, 5) })
	words(coinDisc, "$", 16, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(140, 90, 0), Outline = false, ZIndex = 6 })
	local cashN = if prof() then prof().Cash or 0 else 0
	-- an upright phone's narrow pill shows 12.5K from 10,000 up (the full number split over two lines)
	local cashText = if portrait and cashN >= 10000 then (string.gsub(string.format("%.1f", math.floor(cashN / 100) / 10), "%.0$", "")) .. "K" else UI.num(cashN)
	-- the "+" disc is a fingertip wide (32 or more) and the amount keeps the room left of it
	local plusS = math.max(32, barH - 8)
	local cashL = words(coin, cashText, 17, { Position = UDim2.fromOffset(barH, 0), Size = UDim2.new(1, -(barH + plusS + 6), 1, 0), OutlineThick = 1.6, ZIndex = 5 })
	cashL.TextWrapped = false -- one line: on an upright phone the digits split over two (12,4 / 80)
	-- coins change while the shop is open (a coin egg, a gift): the amount follows them (Studio 2026-10-15 stayed 0)
	tickers.Cash = function()
		local n = if prof() then prof().Cash or 0 else 0
		local t = if portrait and n >= 10000 then (string.gsub(string.format("%.1f", math.floor(n / 100) / 10), "%.0$", "")) .. "K" else UI.num(n)
		if cashL.Parent and cashL.Text ~= t then
			cashL.Text = t
		end
	end
	local plus = dot(coin, K.Lime, plusS, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0) })
	words(plus, "+", 20, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = K.LimeEdge, Outline = false, ZIndex = 6 })
	-- the lucky hour chip: gold while it runs ("LUCKY HOUR 2x · 43:12"), navy with gold words before ("in 1:20:00")
	tickers.Lucky = nil
	if chipMode then
		local on = chipMode == "on"
		local chip = UI.frame(body, { Name = "LuckyHour", BackgroundColor3 = if on then K.Gold else K.TabBar, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromOffset(coinX + coinW, coinY + barH + 4), Size = UDim2.fromOffset(if portrait then 176 else 190, chipH), ZIndex = 3 })
		round(chip, 999)
		edge(chip, if on then Theme.Color.GoldDeep else K.TabBarEdge, 2)
		if on then
			vgrad(chip, K.Gold:Lerp(K.White, 0.3), K.Gold)
		end
		local lbl = words(chip, luckyText(chipMode, chipLeft), 13, {
			Name = "Text", Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = if on then Theme.Color.DarkText else K.Gold, Outline = if on then false else nil, OutlineThick = 1.4, ZIndex = 5,
		})
		lbl.TextWrapped = false
		local mode0 = chipMode
		tickers.Lucky = function()
			local mode, left = luckyMode()
			if mode ~= mode0 then
				tickers.Lucky = nil
				task.defer(function()
					if open then
						build()
					end
				end)
			elseif lbl.Parent and mode then
				lbl.Text = luckyText(mode, left)
			end
		end
	else
		tickers.Lucky = function()
			if luckyMode() ~= nil then
				tickers.Lucky = nil
				task.defer(function()
					if open then
						build()
					end
				end)
			end
		end
	end
	-- red X
	local x = pill(body, "X", K.RedTop, K.Red, K.RedEdge, { Name = "Close", Position = UDim2.fromOffset(W - sideGap - xW, topY + 2), Size = UDim2.fromOffset(xW, xW) }, 24)
	x.Rotation = 4
	local xc = x:FindFirstChildOfClass("UICorner")
	if xc then
		xc.CornerRadius = UDim.new(0, 12)
	end
	x.Activated:Connect(closeShop)
	-- content
	local contentY = stripY + barH + (if portrait then 10 else 16 + chipGap)
	local sc = UI.scroller(body, { Name = "Content", Position = UDim2.fromOffset(sideGap, contentY), Size = UDim2.new(1, -2 * sideGap, 1, -contentY - 10) })
	sc.ScrollBarThickness = 6
	sc.ScrollBarImageColor3 = K.PanelEdge
	contentW = W - 2 * sideGap - UI.ScrollBar - 6
	UI.list(sc, Enum.FillDirection.Vertical, if portrait then 12 else 14)
	content = sc
	render()
	local conn
	conn = UI.ModalChanged.Event:Connect(function(name)
		if name ~= "PetShop" then
			open = false
					content = nil
			conn:Disconnect()
		end
	end)
end

function PetShop.open(openTab: string?)
	if openTab and table.find(TABS, openTab) then
		tab = openTab
	end
	open = true
	build()
	startTicking()
end

-- Eggs tab paid with coins (the preview scene flips it; the switch on the tab does in play).
function PetShop.setPayCoins(on: boolean)
	payCoins = on
end

function PetShop.isOpen(): boolean
	return open
end

function PetShop.start()
	State.Changed.Event:Connect(requestRender)
	-- a window resized or a phone turned while the shop is open: the header and cards are laid out for the old size
	UI.Resized.Event:Connect(function()
		if open then
			task.defer(function()
				if open then
					build()
				end
			end)
		end
	end)
	player:GetAttributeChangedSignal("PaidRandomRestricted"):Connect(requestRender)
end

return PetShop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="366">
            <Properties>
              <string name="Name">PetStatsStrip</string>
              <string name="Source"><![CDATA[--!strict
-- Pet stats drawn for young players (data from shared/PetStatView): the POWER badge (one "bigger = better" number
-- with a green up / red down arrow against the pet that follows you) and the MORE page (every stat in one plain
-- sentence). Used by the Pet Book cards and detail (CollectionPanel) and the Pet Tower picker (TowerPanel).

local TextService = game:GetService("TextService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PetStatView = require(Shared.PetStatView)
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local PetStyle = require(script.Parent.PetStyle)

local T = UI.T
local TC = Theme.Color
local K = Theme.Pet

local Strip = {}

local UP = K.Lime
local DOWN = K.Red

-- A glossy pet-style pill (lighter top, dark edge) behind a badge: blue for the readouts, gold once a pet is maxed.
local function pillSkin(f: Frame, h: number, top: Color3, bottom: Color3, edge: Color3)
	PetStyle.round(f, math.floor(h / 2))
	PetStyle.vgrad(f, top, bottom)
	PetStyle.edge(f, edge, if h >= 30 then 2 else 1.5)
end

-- The POWER badge: bolt icon, the number, and a green up / red down arrow against the pet that follows you
-- (cmp from PetStatView.compare). `h` is its height; the width follows the number (AutomaticSize).
-- Attributes Power / Cmp let preview checks read it.
function Strip.badge(parent: Instance, power: number?, cmp: number, h: number, props: { [string]: any }?): Frame?
	if power == nil then
		return nil
	end
	-- sized from the measured number (nested AutomaticSize left pills narrower than their words, see UI.lua SubPill)
	local text = UI.num(power)
	local size = math.floor(h * 0.72)
	local tw = math.ceil(TextService:GetTextSize(text, size, UI.Head, Vector2.new(1000, 1000)).X) + 2
	local ih = h - 4
	local aw = if cmp ~= 0 then math.floor(h * 0.62) else 0
	local w = 2 + ih + 3 + tw + (if aw > 0 then aw + 2 else 0) + math.floor(h * 0.3)
	local f = UI.frame(parent, { Name = "Power", BackgroundColor3 = K.Blue, Size = UDim2.fromOffset(w, h) })
	if props then
		for k, v in props do
			(f :: any)[k] = v
		end
	end
	pillSkin(f, h, K.BlueTop, K.Blue, K.BlueEdge)
	f:SetAttribute("Power", power)
	f:SetAttribute("Cmp", cmp)
	UI.icon(f, "statPower", ih, { Name = "Icon", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0) })
	local num = UI.text(f, text, {
		Name = "Value", Font = UI.Head, TextSize = size, TextColor3 = K.Gold, Outline = "Normal",
		Position = UDim2.fromOffset(2 + ih + 3, 0), Size = UDim2.fromOffset(tw, h),
	})
	num.TextWrapped = false
	local numEdge = num:FindFirstChild("Outline")
	if numEdge and numEdge:IsA("UIStroke") then
		numEdge.Color = K.BlueEdge
	end
	if cmp ~= 0 then
		UI.icon(f, "arrow", aw, {
			Name = if cmp > 0 then "Better" else "Worse",
			Color = if cmp > 0 then UP else DOWN,
			Rotation = if cmp > 0 then 0 else 180,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 2 + ih + 3 + tw + 2, 0.5, 0),
		})
	end
	return f
end

-- "Lv 7/20" chip next to the POWER badge; gold "MAX" style once the pet reached its rarity's cap.
function Strip.level(parent: Instance, level: number, cap: number, h: number, props: { [string]: any }?): Frame
	local maxed = level >= cap
	local text = PetStatView.levelText(level, cap)
	local size = math.floor(h * 0.7)
	local tw = math.ceil(TextService:GetTextSize(text, size, UI.Head, Vector2.new(1000, 1000)).X) + 2
	local f = UI.frame(parent, { Name = "Level", BackgroundColor3 = if maxed then K.Gold else K.Blue, Size = UDim2.fromOffset(tw + 14, h) })
	if props then
		for k, v in props do
			(f :: any)[k] = v
		end
	end
	if maxed then
		pillSkin(f, h, K.Gold:Lerp(K.White, 0.3), K.Gold, K.TagEdge)
	else
		pillSkin(f, h, K.BlueTop, K.Blue, K.BlueEdge)
	end
	f:SetAttribute("Level", level)
	f:SetAttribute("Cap", cap)
	local l = UI.text(f, text, { Name = "Value", Font = UI.Head, TextSize = size, TextColor3 = if maxed then TC.DarkText else K.White, Outline = if maxed then false else "Normal", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	l.TextWrapped = false
	local lEdge = l:FindFirstChild("Outline")
	if lEdge and lEdge:IsA("UIStroke") then
		lEdge.Color = K.BlueEdge
	end
	return f
end

-- The MORE page: every stat as icon, bold head and one or two lines of words, in a scroll list filling `parent`
-- above a BACK button (`onBack`).
function Strip.more(parent: Instance, g: { [string]: any }, comparing: boolean, onBack: () -> ()): ScrollingFrame
	local sc = UI.scroller(parent, { Name = "MoreStats", Size = UDim2.new(1, 0, 1, -(T.Touch + 4)) })
	UI.list(sc, Enum.FillDirection.Vertical, 4)
	local order = 0
	local function line(icon: string?, head: string, text: string)
		order += 1
		local r = UI.frame(sc, { Name = "Line" .. order, LayoutOrder = order, BackgroundColor3 = TC.Inset, Size = UDim2.new(1, -4, 0, 54) })
		UI.corner(r, T.RadiusSm)
		if icon then
			UI.icon(r, icon, 24, { Name = "Icon", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0) })
		end
		local h = UI.text(r, head, { Name = "Head", Font = UI.Head, TextSize = T.Body, Outline = "Normal", Position = UDim2.fromOffset(32, 2), Size = UDim2.new(1, -36, 0, 20) })
		UI.fit(h, T.Body, 10)
		h.TextWrapped = false
		local b = UI.text(r, text, { Name = "Text", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Muted, Outline = "Light", Position = UDim2.fromOffset(32, 22), Size = UDim2.new(1, -36, 0, 30), TextYAlignment = Enum.TextYAlignment.Top })
		UI.fit(b, T.Tiny, 8)
		b.TextWrapped = true
	end
	for _, l in PetStatView.more(g) do
		line(l.Icon, l.Head, l.Text)
	end
	if comparing then
		line("arrow", "Arrows", "Green up = more POWER than the pet following you. Red down = less.")
	end
	UI.button(parent, "BACK", "gray", onBack, { Name = "Back", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.new(0.6, 0, 0, T.Touch), TextSize = T.Body })
	return sc
end

return Strip
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="367">
            <Properties>
              <string name="Name">PetStyle</string>
              <string name="Source"><![CDATA[--!strict
-- Pet style kit (owner's reference clip, Pet Simulator style; docs/UI_STYLE_REF.md): the colours, cards, pills,
-- ribbons, tab strip and motion every screen shares. First drawn for the Pet Shop (PetShop.luau), then applied to
-- every menu through UI.modal / UI.tabs / UI.button and the HUD. Pure drawing: no game state, no remotes.
--
-- Children draw above their parent in Roblox, so a drop shadow is a sibling under a face (PetStyle.shadowed).
-- Cards tilt toward the pointer and lift on hover (PetStyle.card); Reduce Motion stops every loop (PetStyle.still).

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)

local PetStyle = {}
PetStyle.On = true -- the whole interface uses this look (Theme / UI read it)
PetStyle.Sweeps = {} :: { RBXScriptConnection } -- pattern drift loops; each ends with its card (Destroying)

-- Colours measured on the reference clip (Theme.Pet; docs/UI_STYLE_REF.md section 2).
PetStyle.K = Theme.Pet
PetStyle.Tones = ({
	purple = { Color3.fromRGB(70, 110, 255), Color3.fromRGB(150, 60, 255), Color3.fromRGB(240, 80, 220) },
	gold = { Color3.fromRGB(255, 214, 120), Color3.fromRGB(255, 150, 40), Color3.fromRGB(220, 70, 40) },
	blue = { Color3.fromRGB(40, 120, 255), Color3.fromRGB(30, 190, 255), Color3.fromRGB(90, 90, 255) },
	pink = { Color3.fromRGB(255, 110, 190), Color3.fromRGB(220, 90, 255), Color3.fromRGB(170, 90, 255) },
	green = { Color3.fromRGB(60, 200, 90), Color3.fromRGB(120, 230, 60), Color3.fromRGB(30, 160, 120) },
	sky = { Color3.fromRGB(70, 200, 255), Color3.fromRGB(40, 150, 255), Color3.fromRGB(80, 110, 255) },
	violet = { Color3.fromRGB(120, 60, 220), Color3.fromRGB(80, 30, 160), Color3.fromRGB(60, 20, 110) },
	sun = { Color3.fromRGB(255, 230, 90), Color3.fromRGB(255, 190, 40), Color3.fromRGB(255, 140, 30) },
}) :: { [string]: { Color3 } }
-- Motion (docs/UI_STYLE_REF.md section 4). Reduce Motion stops all of it (UI.Reduced).
PetStyle.Motion = {
	TiltDeg = 3, -- card tilt toward the pointer, degrees at the card's edge
	TiltPx = 5, -- card slide toward the pointer, logical px at the edge
	Hover = 1.035, -- card lift
	TiltSpring = { 0.55, 5 }, -- damping, Hz
	TabSlide = { 0.7, 7 },
	PatternSpeed = 0.012, -- pattern drift (card widths per second)
	StripeSpeed = 0.08, -- HUD square streaks (card widths per second)
}
local K, TONES, MOTION = PetStyle.K, PetStyle.Tones, PetStyle.Motion

function PetStyle.still(): boolean
	return UI.Reduced
end

function PetStyle.words(parent: Instance, text: string, size: number, props: { [string]: any }?): TextLabel
	local p: { [string]: any } = { Font = UI.Bold, TextColor3 = K.White, Outline = "Normal" }
	local oColor: Color3? = nil
	local oThick: number? = nil
	if props then
		for k, v in props do
			if k == "OutlineColor" then
				oColor = v
			elseif k == "OutlineThick" then
				oThick = v
			else
				p[k] = v
			end
		end
	end
	p.TextSize = size
	local t = UI.text(parent, text, p)
	local o = t:FindFirstChild("Outline")
	if o and o:IsA("UIStroke") then
		o.Color = oColor or K.Ink
		if oThick then
			o.Thickness = oThick
		end
	end
	return t
end

-- Vertical gradient (lighter top) over a fill: the glossy pill look.
function PetStyle.vgrad(obj: GuiObject, top: Color3, bottom: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = rotation or 90
	g.Parent = obj
	return g
end

function PetStyle.hgrad(obj: GuiObject, stops: { Color3 }): UIGradient
	local kps = {}
	for i, c in stops do
		table.insert(kps, ColorSequenceKeypoint.new((i - 1) / (#stops - 1), c))
	end
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(kps)
	g.Rotation = 0
	g.Parent = obj
	return g
end

function PetStyle.round(obj: GuiObject, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = obj
end

function PetStyle.edge(obj: GuiObject, color: Color3, thick: number): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thick
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = obj
	return s
end

-- A wrapper holding a dark copy `dy` px lower (the drop shadow) under a face frame. Children draw above their
-- parent in Roblox, so the shadow has to be a sibling of the face, not its child. Layout props (Name, Size,
-- Position, LayoutOrder, Anchor) go on the wrapper; the face fills it. Returns (wrapper, face).
function PetStyle.shadowed(parent: Instance, r: number, dy: number, color: Color3?, props: { [string]: any }?): (Frame, Frame)
	local wrap = Instance.new("Frame")
	wrap.Name = "Card"
	wrap.BackgroundTransparency = 1
	wrap.ZIndex = 2
	UI.apply(wrap, props)
	local d = Instance.new("Frame")
	d.Name = "Drop"
	d.BackgroundColor3 = color or K.Shade
	d.BackgroundTransparency = if color then 0 else 0.5
	d.BorderSizePixel = 0
	d.Size = UDim2.fromScale(1, 1)
	d.Position = UDim2.fromOffset(0, dy)
	d.ZIndex = 1
	PetStyle.round(d, r)
	d.Parent = wrap
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.BackgroundColor3 = K.White
	face.BorderSizePixel = 0
	face.Size = UDim2.fromScale(1, 1)
	face.ZIndex = 2
	PetStyle.round(face, r)
	face.Parent = wrap
	wrap.Parent = parent
	return wrap, face
end

-- The faint diamond pattern on cards and sheets (drawn by UI.pattern, which the modal sheet shares).
PetStyle.pattern = UI.pattern

-- A gradient card with the drop shadow and the pattern. Tilts toward the pointer (CardTilt) and lifts on hover.
function PetStyle.card(parent: Instance, tone: string, props: { [string]: any }?): Frame
	local f, face = PetStyle.shadowed(parent, 12, 4, nil, props)
	PetStyle.hgrad(face, TONES[tone] or TONES.blue)
	PetStyle.edge(face, K.CardEdge, 2.5)
	local sz = if props and props.Size then props.Size :: UDim2 else UDim2.fromOffset(400, 160)
	PetStyle.pattern(face, K.White, 0.9, 34, sz.X.Offset, sz.Y.Offset)
	-- tilt and lift
	local tilt = Instance.new("UIScale")
	tilt.Name = "Lift"
	tilt.Parent = f
	local base = f.Position -- captured once: re-reading it mid-spring made the card drift away
	local function settle()
		UI.spring(f, MOTION.TiltSpring, { Rotation = 0, Position = base })
		UI.spring(tilt, Theme.Spring.Release, { Scale = 1 })
	end
	f.MouseEnter:Connect(function()
		if UserInputService.MouseEnabled and not PetStyle.still() then
			UI.spring(tilt, Theme.Spring.Release, { Scale = MOTION.Hover })
		end
	end)
	f.MouseLeave:Connect(settle)
	f.MouseMoved:Connect(function(x: number, y: number)
		if PetStyle.still() or not UserInputService.MouseEnabled then
			return
		end
		local size = f.AbsoluteSize
		if size.X < 1 or size.Y < 1 then
			return
		end
		local dx = math.clamp(((x - f.AbsolutePosition.X) / size.X - 0.5) * 2, -1, 1)
		local dy = math.clamp(((y - f.AbsolutePosition.Y) / size.Y - 0.5) * 2, -1, 1)
		UI.spring(f, MOTION.TiltSpring, {
			Rotation = dx * MOTION.TiltDeg,
			Position = base + UDim2.fromOffset(dx * MOTION.TiltPx, dy * MOTION.TiltPx * 0.6),
		})
	end)
	f:SetAttribute("Tone", tone)
	return face
end

-- A rounded pill with a glossy vertical gradient and a dark edge; returns the pill and its label.
function PetStyle.pill(parent: Instance, text: string, top: Color3, bottom: Color3, edgeColor: Color3, props: { [string]: any }?, size: number?): (TextButton, TextLabel)
	local b = Instance.new("TextButton")
	b.Name = "Pill"
	b.AutoButtonColor = false
	b.Text = ""
	b.BackgroundColor3 = K.White
	b.BorderSizePixel = 0
	b.ZIndex = 4
	UI.apply(b, props)
	PetStyle.round(b, 999)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, top),
		ColorSequenceKeypoint.new(0.55, bottom),
		ColorSequenceKeypoint.new(0.8, bottom),
		ColorSequenceKeypoint.new(0.81, bottom:Lerp(edgeColor, 0.55)),
		ColorSequenceKeypoint.new(1, bottom:Lerp(edgeColor, 0.55)),
	})
	g.Rotation = 90
	g.Parent = b
	PetStyle.edge(b, edgeColor, 2.5)
	b.Parent = parent
	local l = PetStyle.words(b, text, size or 18, {
		Name = "Label", TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -16, 1, -4), Position = UDim2.fromOffset(8, 0), ZIndex = 5,
		OutlineColor = edgeColor, OutlineThick = 2.4,
	})
	UI.squashScale(b)
	b.MouseButton1Down:Connect(function()
		UI.squash(b, true)
	end)
	b.MouseButton1Up:Connect(function()
		UI.squash(b, false)
	end)
	b.MouseLeave:Connect(function()
		UI.squash(b, false)
	end)
	return b, l
end

-- A small tilted ribbon tag ("BEST DEAL", "LIMITED!").
function PetStyle.ribbon(parent: Instance, text: string, color: Color3, props: { [string]: any }?): Frame
	local f = Instance.new("Frame")
	f.Name = "Ribbon"
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.Size = UDim2.fromOffset(84, 20)
	f.ZIndex = 6
	UI.apply(f, props)
	PetStyle.round(f, 999)
	PetStyle.edge(f, K.Ink, 2)
	f.Parent = parent
	PetStyle.words(f, text, 12, { TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0), ZIndex = 7, OutlineThick = 1.6 })
	return f
end

-- A rarity dot: a small disc in the rarity colour with a dark edge.
function PetStyle.dot(parent: Instance, color: Color3, size: number, props: { [string]: any }?): Frame
	local d = Instance.new("Frame")
	d.Name = "Dot"
	d.BackgroundColor3 = color
	d.BorderSizePixel = 0
	d.Size = UDim2.fromOffset(size, size)
	d.ZIndex = 5
	UI.apply(d, props)
	PetStyle.round(d, 999)
	PetStyle.edge(d, K.Ink, 2)
	PetStyle.vgrad(d, K.White:Lerp(color, 0.55), color)
	d.Parent = parent
	return d
end


-- Stops every pattern drift loop (called when a screen that made them closes).
function PetStyle.clearSweeps()
	for _, c in PetStyle.Sweeps do
		c:Disconnect()
	end
	PetStyle.Sweeps = {}
end

-- A navy pill with a gold coin and the amount (the clip's currency readout). Returns the pill and a setter.
function PetStyle.coinPill(parent: Instance, w: number, h: number, props: { [string]: any }?): (Frame, (number) -> ())
	local coin = UI.frame(parent, { Name = "Coins", BackgroundColor3 = K.TabBar, Size = UDim2.fromOffset(w, h), ZIndex = 3 })
	UI.apply(coin, props)
	PetStyle.round(coin, 999)
	PetStyle.edge(coin, K.TabBarEdge, 2.5)
	local disc = PetStyle.dot(coin, K.Gold, h - 10, { Position = UDim2.fromOffset(5, 5) })
	PetStyle.words(disc, "$", math.floor((h - 10) * 0.6), { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(140, 90, 0), Outline = false, ZIndex = 6 })
	local amt = PetStyle.words(coin, "0", math.floor(h * 0.45), { Name = "Amount", Position = UDim2.fromOffset(h, 0), Size = UDim2.new(1, -(h + 8), 1, 0), OutlineThick = 1.6, ZIndex = 5 })
	amt.TextWrapped = false
	local last: number? = nil
	return coin, function(n: number)
		UI.Juice.countTo(amt, last or n, n, UI.num)
		last = n
	end
end

-- The red X square (tilted a touch like the clip's).
function PetStyle.closeX(parent: Instance, size: number, onClick: () -> (), props: { [string]: any }?): TextButton
	local x = PetStyle.pill(parent, "X", K.RedTop, K.Red, K.RedEdge, props, math.floor(size * 0.52))
	x.Name = "Close"
	x.Size = UDim2.fromOffset(size, size)
	x.Rotation = 4
	local c = x:FindFirstChildOfClass("UICorner")
	if c then
		c.CornerRadius = UDim.new(0, math.floor(size * 0.26))
	end
	x.Activated:Connect(onClick)
	return x
end

-- Big menu title with a dark drop copy ("Shop", "Pets"): white Fredoka, blue edge.
function PetStyle.title(parent: Instance, text: string, size: number, props: { [string]: any }?): TextLabel
	local p: { [string]: any } = props or {}
	local shadowProps = table.clone(p)
	shadowProps.Name = "TitleShadow"
	shadowProps.Position = (p.Position or UDim2.new()) + UDim2.fromOffset(0, 3)
	shadowProps.TextColor3 = K.TitleShadow
	shadowProps.OutlineColor = K.TitleShadow
	shadowProps.OutlineThick = 4
	shadowProps.ZIndex = (p.ZIndex or 3) - 1
	PetStyle.words(parent, text, size, shadowProps)
	local tp = table.clone(p)
	tp.Name = tp.Name or "Title"
	tp.OutlineColor = K.TitleEdge
	tp.OutlineThick = 3.4
	return PetStyle.words(parent, text, size, tp)
end

-- Navy tab strip with a lime pill that slides to the picked tab. `items` = { { id, label } }; returns the strip and
-- a function that moves the pill (instant or sprung) and recolours the words.
function PetStyle.tabStrip(parent: Instance, items: { { string } }, current: string, onPick: (string) -> (), props: { [string]: any }?): (Frame, (string, boolean?) -> ())
	local strip = UI.frame(parent, { Name = "Tabs", BackgroundColor3 = K.TabBar, Size = UDim2.new(1, 0, 0, 38), ZIndex = 3 })
	UI.apply(strip, props)
	PetStyle.round(strip, 999)
	PetStyle.edge(strip, K.TabBarEdge, 2.5)
	local n = #items
	local sel = UI.frame(strip, { Name = "Selected", BackgroundColor3 = K.Lime, Position = UDim2.new(0, 4, 0, 3), Size = UDim2.new(1 / n, -8 / n, 1, -6), ZIndex = 4 })
	PetStyle.round(sel, 999)
	PetStyle.vgrad(sel, K.LimeTop, K.Lime)
	PetStyle.edge(sel, K.LimeEdge, 2)
	local labels: { [string]: TextLabel } = {}
	local cur = current
	local function place(id: string, instant: boolean?)
		cur = id
		local i = 1
		for k, it in items do
			if it[1] == id then
				i = k
			end
		end
		local target = UDim2.new((i - 1) / n, 4, 0, 3)
		if instant or UI.Reduced then
			sel.Position = target
		else
			UI.spring(sel, MOTION.TabSlide, { Position = target })
		end
		for k, l in labels do
			l.TextColor3 = if k == id then K.Ink else K.TabText
			local o = l:FindFirstChild("Outline")
			if o and o:IsA("UIStroke") then
				o.Transparency = if k == id then 1 else 0
			end
		end
	end
	for i, it in items do
		local b = Instance.new("TextButton")
		b.Name = "Tab_" .. it[1]
		b.BackgroundTransparency = 1
		b.Text = ""
		b.AutoButtonColor = false
		b.Position = UDim2.new((i - 1) / n, 4, 0, 0)
		b.Size = UDim2.new(1 / n, -8 / n, 1, 0)
		b.ZIndex = 5
		b.Parent = strip
		local l = PetStyle.words(b, it[2], 16, { Name = "Label", Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = K.TabText, OutlineThick = 1.4, ZIndex = 6 })
		l.TextWrapped = false
		labels[it[1]] = l
		b.Activated:Connect(function()
			if cur ~= it[1] then
				place(it[1], false)
				onPick(it[1])
			end
		end)
	end
	place(current, true)
	return strip, place
end

-- Drifting diagonal light stripes inside a clipped host (the video's HUD squares: pale streaks sliding across the
-- blue). Stops with the card. Lives under everything else on the card (ZIndex 0).
function PetStyle.stripes(card: GuiObject, color: Color3, alpha: number, radius: number)
	local host = Instance.new("Frame")
	host.Name = "Shine"
	host.BackgroundTransparency = 1
	host.ClipsDescendants = true
	host.Size = UDim2.fromScale(1, 1)
	host.ZIndex = 0
	host.Parent = card
	PetStyle.round(host, radius)
	local band = Instance.new("Frame")
	band.Name = "Drift"
	band.BackgroundTransparency = 1
	band.Size = UDim2.fromScale(3, 1)
	band.Position = UDim2.fromScale(-1, 0)
	band.ZIndex = 0
	band.Parent = host
	-- three streaks of two widths per card width, repeated over the wide band
	local widths = { 0.09, 0.05, 0.12 }
	local n = 0
	for rep = 0, 2 do
		for i, w in widths do
			n += 1
			local st = Instance.new("Frame")
			st.Name = "Streak"
			st.BackgroundColor3 = color
			st.BackgroundTransparency = alpha
			st.BorderSizePixel = 0
			st.AnchorPoint = Vector2.new(0.5, 0.5)
			st.Rotation = -32
			st.Size = UDim2.new(w / 3, 0, 2.2, 0)
			st.Position = UDim2.fromScale((rep + (i - 1) * 0.36 + 0.1) / 3, 0.5)
			st.ZIndex = 0
			st.Parent = band
		end
	end
	if not PetStyle.still() then
		local t0 = os.clock()
		local conn: RBXScriptConnection? = nil
		conn = RunService.RenderStepped:Connect(function()
			if not host.Parent then
				if conn then
					conn:Disconnect()
				end
				return
			end
			local t = (os.clock() - t0) * MOTION.StripeSpeed
			band.Position = UDim2.fromScale(-1 + (t % 1) / 3, 0)
		end)
		card.Destroying:Connect(function()
			if conn then
				conn:Disconnect()
			end
		end)
	end
end

-- Dresses a square HUD button like the video's: cyan face with a lighter top, a darker lip along the bottom, drifting
-- light streaks and a white rim. The button's own fill is left to it (hover / press colours stay on the face).
function PetStyle.iconTile(b: GuiObject, size: number)
	local r = math.floor(size * 0.2)
	PetStyle.vgrad(b, K.CyanTop, K.Cyan)
	local border = b:FindFirstChild("Border")
	if border and border:IsA("UIStroke") then
		border.Color = K.White
		border.Thickness = 2.5
	else
		PetStyle.edge(b, K.White, 2.5)
	end
	PetStyle.stripes(b, K.White, 0.8, r)
	local lip = Instance.new("Frame")
	lip.Name = "Lip"
	lip.BackgroundColor3 = K.CyanLip
	lip.BackgroundTransparency = 0.55
	lip.BorderSizePixel = 0
	lip.AnchorPoint = Vector2.new(0.5, 1)
	lip.Position = UDim2.new(0.5, 0, 1, 0)
	lip.Size = UDim2.new(1, 0, 0, math.floor(size * 0.12))
	lip.ZIndex = 1
	lip.Parent = b
	PetStyle.round(lip, r)
	-- the lip's top corners are squared off by a strip over them (a frame's corners round on every side)
	local fillTop = Instance.new("Frame")
	fillTop.Name = "LipTop"
	fillTop.BackgroundColor3 = K.CyanLip
	fillTop.BackgroundTransparency = 0.55
	fillTop.BorderSizePixel = 0
	fillTop.Size = UDim2.new(1, -2 * r, 0, r)
	fillTop.Position = UDim2.fromOffset(r, 0)
	fillTop.ZIndex = 1
	fillTop.Parent = lip
end

return PetStyle
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="368">
            <Properties>
              <string name="Name">PlayButton</string>
              <string name="Source"><![CDATA[--!strict
-- Lobby PLAY button and hunt-queue card (left HUD column, under the cash). Lobby only.
--   not queued: a big PLAY button (shows "2/4" when an open queue is already counting down)
--   queued:     "HUNT IN 12s" with the player count and LEAVE
-- It only shows what the server sends (LaunchEvent "Queue") and sends intents (PartyAction "Queue" / "Unqueue").
-- Walking onto the lobby portal pads joins the same queue on the server.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local HudArt = require(script.Parent.HudArt)

local T = UI.T
local TC = Theme.Color
local PlayButton = {}

local WIDTH = 172 -- same width as the TOWER row (Hud LOBBY_W)
local HEIGHT = 70 -- PLAY and the queue card share it, so the column never jumps when one replaces the other
local LEAVE_W = 64
type QView = { Count: number, Max: number, StartsAt: number, Remaining: number }

local root: Frame? = nil
local playBtn: TextButton? = nil
local card: Frame? = nil
local countText: TextLabel? = nil
local subText: TextLabel? = nil
local mine: QView? = nil
local open: QView? = nil
local pendingUntil = 0 -- a join / leave request is on its way (no double taps)
local pulse: Tween? = nil -- "STARTING" breathes while the server builds the hunt (it reads as working, not stuck)

local function act(action: string)
	if os.clock() < pendingUntil then
		return
	end
	pendingUntil = os.clock() + 0.6
	Net.event("PartyAction"):FireServer(action)
end

local function secondsLeft(v: QView): number
	return math.max(0, math.ceil(v.StartsAt - Workspace:GetServerTimeNow()))
end

local function setPulse(on: boolean)
	local ct = countText :: TextLabel
	if on and not pulse and not UI.Reduced then
		local tw = TweenService:Create(ct, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { TextTransparency = 0.45 })
		pulse = tw
		tw:Play()
	elseif not on and pulse then
		(pulse :: Tween):Cancel()
		pulse = nil
		ct.TextTransparency = 0
	end
end

local function refresh()
	local r = root
	if not r then
		return
	end
	-- gone the moment the server puts us in a hunt (MatchKey), before the hunt state arrives
	local lobby = State.Match == nil and Players.LocalPlayer:GetAttribute("MatchKey") == nil
	r.Visible = lobby
	if not lobby then
		setPulse(false)
		return
	end
	local m = mine
	;(card :: Frame).Visible = m ~= nil
	;(playBtn :: TextButton).Visible = m == nil
	if m then
		local left = secondsLeft(m)
		-- while starting, the dots step every quarter second (the refresh loop) and the word breathes
		local dots = string.rep(".", 1 + math.floor(os.clock() * 4) % 3)
		;(countText :: TextLabel).Text = if left > 0 then "HUNT IN " .. left .. "s" else "STARTING" .. dots
		setPulse(left <= 0)
		;(subText :: TextLabel).Text = "(" .. m.Count .. "/" .. m.Max .. ") players"
	else
		setPulse(false)
		local label = (playBtn :: TextButton):FindFirstChild("Label") :: TextLabel?
		local o = open
		if label then
			label.Text = if o then "PLAY  " .. o.Count .. "/" .. o.Max else "PLAY"
		end
	end
end

local function build()
	local screen = UI.screen()
	-- Sit in the HUD's left column list when it exists (so nothing overlaps); else a fixed spot under the cash.
	local left = screen:FindFirstChild("Left", true)
	local r = UI.frame(left or screen, {
		Name = "PlayQueue",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 50,
	})
	if not left then
		r.Position = UDim2.fromOffset(T.Edge, T.Edge + 80)
	end
	root = r
	-- big gold PLAY (lobby mockup): egg picture, title, and what PLAY is (the main game) so it never reads like TOWER
	playBtn = HudArt.bigButton(r, {
		Name = "Play", Style = "gold", Art = "Egg", Skin = "btn_yellow", Title = "PLAY", Sub = "Egg hunt race", Width = WIDTH, Height = HEIGHT,
		OnClick = function()
			act("Queue")
		end,
	})
	UI.wiggle(playBtn :: TextButton)
	-- queue card: count and players on the left, LEAVE on the right, PLAY's height
	local c = UI.card(r, "hud", { Name = "QueueCard", Size = UDim2.fromOffset(WIDTH, HEIGHT), Visible = false })
	card = c
	local textW = -(LEAVE_W + 18)
	countText = UI.text(c, "", { Name = "Count", Font = UI.Head, TextSize = T.Body, TextColor3 = TC.Gold, Outline = "Normal", Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, textW, 0, 28), TextXAlignment = Enum.TextXAlignment.Center })
	;(countText :: TextLabel).TextWrapped = false
	UI.fit(countText :: TextLabel, T.Body, T.MinText) -- short words, and they shrink before they clip on small phones
	subText = UI.text(c, "", { Name = "Players", Font = UI.Bold, TextSize = T.Small, Outline = "Normal", Position = UDim2.fromOffset(8, 38), Size = UDim2.new(1, textW, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
	;(subText :: TextLabel).TextWrapped = false
	UI.fit(subText :: TextLabel, T.Small, T.MinText)
	UI.button(c, "LEAVE", "gray", function()
		act("Unqueue")
	end, { Name = "Leave", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(LEAVE_W, HEIGHT - 16), TextSize = T.Small })
	refresh()
end

function PlayButton.onQueue(data: any)
	if type(data) ~= "table" then
		return
	end
	mine = data.Mine
	open = data.Open
	pendingUntil = 0
	refresh()
end

function PlayButton.start()
	build()
	Net.event("LaunchEvent").OnClientEvent:Connect(function(kind, data)
		if kind == "Queue" then
			PlayButton.onQueue(data)
		end
	end)
	State.Changed.Event:Connect(function(what)
		if what == "Match" then
			refresh()
		end
	end)
	Players.LocalPlayer:GetAttributeChangedSignal("MatchKey"):Connect(refresh)
	task.spawn(function()
		while true do
			task.wait(0.25)
			if mine then
				refresh()
			end
		end
	end)
	Net.event("PartyAction"):FireServer("Sync") -- the server answers with the queue state too
end

-- Lobby HUD v2 PLAY (ui/LobbyHudV2): one tap joins the queue, a tap while queued leaves it.
function PlayButton.tap()
	act(if mine then "Unqueue" else "Queue")
end

-- The queue line over the v2 PLAY button, or nil when there is nothing to say.
function PlayButton.status(): string?
	local m, o = mine, open
	if m then
		local left = secondsLeft(m)
		return (if left > 0 then "HUNT IN " .. left .. "s" else "STARTING...") .. "  \u{b7}  " .. m.Count .. "/" .. m.Max .. " players  \u{b7}  tap PLAY to leave"
	elseif o then
		return o.Count .. "/" .. o.Max .. " players waiting \u{b7} tap PLAY to join"
	end
	return nil
end

return PlayButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="369">
            <Properties>
              <string name="Name">PvpPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Pet Battle + Pet Training screens (carter 2026-10-14: find the pet -> train the pet -> fight other pets).
-- BATTLE button (HUD mode row) -> battle card (team, power, trophies, FIGHT / TRAIN); train card (tap TRAIN on a pet
-- to level it up, pick the team); queue strip while looking for a rival; fight HUD (names, timer, SPECIAL, LEAVE);
-- result card. The 3D fight is drawn by TowerView. Sends intents only (PvpNet.PvpAction); the server decides all.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PvpConfig = require(Shared.PvpConfig)
local PvpRules = require(Shared.PvpRules)
local TouchLayout = require(Shared.TouchLayout)
local UiMotion = require(Shared.UiMotion)
local UI = require(script.Parent.UI)
local State = require(script.Parent.Parent.State)
local PanelSkin = require(script.Parent.PanelSkin)
local Theme = require(script.Parent.Theme)
local HudArt = require(script.Parent.HudArt)
local Juice = require(script.Parent.Juice)
local GeodeView = require(script.Parent.GeodeView)
local TowerView = require(script.Parent.Parent.TowerView)
local Audio = require(script.Parent.Parent.Audio)
local PetShop = require(script.Parent.PetShop)
local PetFollow = require(script.Parent.Parent.PetFollow)
local TowerPanel = require(script.Parent.TowerPanel)
local PetFx = require(script.Parent.Parent.PetFx)
local FightFx = require(script.Parent.Parent.FightFx)
local FightCam = require(script.Parent.Parent.FightCam)
local PetMotionBridge = require(script.Parent.Parent.PetMotionBridge)
local TapFight = require(script.Parent.TapFight)

local TC = Theme.Color
local T = UI.T
local player = Players.LocalPlayer

local PvpPanel = {}

local send: (any) -> () = function() end
local roster: any = nil
-- when the roster arrived: a card opened later asks again (levels, names and power change outside the cards: hunt XP,
-- /maxpet, hatching; Studio 2026-10-16 the TRAIN card kept Lv 1 after the Pet Book showed 50/50). The server allows
-- one Open per second, so a roster under ROSTER_FRESH old is reused.
local rosterAt = -math.huge
local ROSTER_FRESH = 1.1
local function stale(): boolean
	return roster == nil or os.clock() - rosterAt > ROSTER_FRESH
end
local inFight = false
local queuedAt: number? = nil
local queueBot = PvpConfig.BotAfter
local fightEnds = 0
local fightStarts = 0
local hud: Frame? = nil
local queueStrip: Frame? = nil
local queueLabel: TextLabel? = nil
local timerLabel: TextLabel? = nil
local namesLabel: TextLabel? = nil
local specialBtn: TextButton? = nil
local meterFill: Frame? = nil
local trainRows: { [string]: Frame } = {}
local picked: { string } = {}
local lastTap = 0
local wantCard: string? = nil -- the card to open when the next roster arrives
local unitInfo: { [string]: any } = {} -- this fight's units: Foe, Info { Rarity, Level, Cap, Power }, Name
local beatBy: any = nil -- the rival pet the finisher showed (named on the loss card)

-- One FightFx moment (FightFx.play); false when it could not play, so callers can fall back.
local function moment(kind: string, opts: { [string]: any })
	local ok = pcall(FightFx.play, kind, opts)
	return ok
end

-- Pet line spacing for this fight (PvpConfig.Layouts), and back to the tower's after.
local function applyLayout(layout: any?)
	if layout then
		TowerView.petZ, TowerView.foeZ = layout.PetZ, layout.FoeZ
		TowerView.petGap, TowerView.foeGap = layout.PetGap, layout.FoeGap
		TowerView.showTarget = false
	else
		TowerView.petZ, TowerView.foeZ, TowerView.petGap, TowerView.foeGap = -14, -4, 5, 6
		TowerView.showTarget = true
	end
end

local RARITY_COLOR = {
	Common = Color3.fromRGB(200, 200, 206),
	Uncommon = Color3.fromRGB(110, 220, 90),
	Rare = Color3.fromRGB(80, 170, 255),
	Epic = Color3.fromRGB(200, 120, 255),
	Legendary = Color3.fromRGB(255, 200, 40),
} :: { [string]: Color3 }

local RANK_COLOR: { [string]: Color3 } = {}
for _, r in PvpConfig.Ranks do
	RANK_COLOR[r.Name] = r.Color
end

local function holder(name: string): Frame
	return UI.frame(UI.screen(), { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2 })
end

local function reduced(): boolean
	return UI.Reduced == true
end

-- One pet picture (the same 3D view the Pet Book uses).
local function picture(parent: Instance, spec: any, size: number, pos: UDim2?)
	local pic = UI.frame(parent, { Name = "Picture", Position = pos or UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	if type(spec) == "table" then
		pcall(GeodeView.make, pic, spec, { Size = UDim2.fromScale(1, 1), Backing = true })
	end
	return pic
end

local function petById(id: string): any?
	if roster == nil then
		return nil
	end
	for _, p in roster.Pets do
		if p.Id == id then
			return p
		end
	end
	return nil
end

-- BATTLE card ------------------------------------------------------------------------------------------------------

local openTrain: () -> ()

local function openBattle()
	if stale() then
		wantCard = "Battle"
		send({ Op = "Open" })
		return
	end
	local panel, body, close, footer = UI.modal("Battle", "PET BATTLE", Vector2.new(600, 450), {
		Subtitle = string.format("%s rank · %d trophies · win streak %d", roster.Rank, roster.Trophies, roster.Streak),
		Footer = T.Primary.Y + 16,
	})
	PanelSkin.dress(panel, "IconLeaderboard", "PET BATTLE")
	-- a short landscape screen (the Studio 844 x 390 window, landscape phones: under 420 logical px tall) sees the
	-- card through a ~200 px window: smaller team cards and heading there, so the record and the free-egg lines
	-- show without scrolling (they hid under the TRAIN / FIGHT footer, Studio check 2026-10-15)
	local short = not UI.isPortrait() and UI.Logical.Y < 420
	local twoLines = false
	for _, id in roster.Team do
		local p = petById(id)
		twoLines = twoLines or (p ~= nil and UiMotion.twoLineName(p.Name))
	end
	-- room for a two-line name ("Skeleton Thunderstrut") only when a team pet has one
	local cardH = (if short then 100 else 132) + (if twoLines then (if short then 16 else 18) else 0)
	local pic = if short then 56 else 72
	UI.list(body, Enum.FillDirection.Vertical, if short then 4 else 8)
	if #roster.Pets == 0 then
		UI.emptyState(body, "No pets yet", "Hatch a pet in the egg race first. Then it can battle!")
	else
		-- the clip's quest-title blue, no outline, like the other headings on the white sheet (gold read weak there)
		UI.text(body, string.format("YOUR TEAM · POWER %s", UI.num(roster.Power)), {
			Name = "TeamPower", Font = UI.Head, TextSize = T.Head, Size = UDim2.new(1, 0, 0, if short then 28 else 34), TextColor3 = Theme.Pet.QuestTitle, Outline = "Normal", LayoutOrder = 1,
		})
		local row = UI.frame(body, { Name = "Team", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, cardH), LayoutOrder = 2 })
		UI.list(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
		for i, id in roster.Team do
			local p = petById(id)
			if p then
				local c = UI.card(row, "inset", { Name = "Pet" .. i, Size = UDim2.new(1 / 3, -6, 1, 0), LayoutOrder = i })
				picture(c, p.Spec, pic, UDim2.new(0.5, -pic / 2, 0, 4))
				-- up to two lines ("Skeleton Thunderstrut" wrapped and hid the level, then ended in "..." on one line, on a
				-- 844x390 phone); the level sits on the power line below
				local nameH = if twoLines then (if short then 34 else 40) else (if short then 18 else 22) -- same row height on every card
				UI.text(c, p.Name, {
					Name = "PetName", Font = UI.Bold, TextSize = T.Small, Position = UDim2.fromOffset(4, pic + 4), Size = UDim2.new(1, -8, 0, nameH),
					TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = TowerView.TypeColor[p.Element] or TC.Text,
				})
				UI.text(c, "\u{26A1} " .. UI.num(p.Power2) .. "  Lv " .. p.Level, {
					Font = UI.Head, TextSize = T.Body, Position = UDim2.fromOffset(4, pic + 4 + nameH), Size = UDim2.new(1, -8, 0, if short then 20 else 26),
					TextXAlignment = Enum.TextXAlignment.Center,
				})
			end
		end
		UI.text(body, string.format("Wins %d · Losses %d · Best streak %d", roster.Wins, roster.Losses, roster.BestStreak), {
			Name = "Record", TextSize = T.Small, TextColor3 = TC.Muted, Size = UDim2.new(1, 0, 0, if short then 22 else 24), LayoutOrder = 3,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		-- free eggs (shared/EggPerks): every 3rd battle win banks a free Basic Egg
		local prof: any = State.Profile
		local perks: any = if prof then prof.EggPerks else nil
		local toEgg = if type(perks) == "table" then tonumber(perks.WinsToEgg) else nil
		if toEgg and toEgg > 0 then
			UI.text(body, string.format("Win %d more = FREE EGG!", toEgg), {
				Name = "FreeEgg", Font = UI.Head, TextSize = T.Body, TextColor3 = Theme.Pet.Lime, Outline = "Normal", Size = UDim2.new(1, 0, 0, if short then 24 else 26), LayoutOrder = 4,
				TextXAlignment = Enum.TextXAlignment.Center,
			})
		end
		local nextText = if roster.NextRank then string.format("%d more trophies to %s!", roster.NextAt - roster.Trophies, roster.NextRank) else "Top rank! You are a Champion!"
		UI.text(body, "Win = coins + trophies. Train pets to make them stronger! " .. nextText, {
			Name = "Tip", TextSize = T.Small, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 5, TextXAlignment = Enum.TextXAlignment.Center,
		})
	end
	if footer then
		UI.list(footer, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		UI.button(footer, "TRAIN", "blue", function()
			openTrain()
		end, { Name = "Train", Size = UDim2.new(0.42, -5, 1, 0), LayoutOrder = 1 })
		UI.button(footer, if queuedAt then "CANCEL" else "FIGHT!", if queuedAt then "gray" else "green", function()
			close()
			send({ Op = if queuedAt then "Cancel" else "Queue" })
		end, { Name = "Fight", Size = UDim2.new(0.42, -5, 1, 0), LayoutOrder = 2 })
	end
end

-- TRAIN card -------------------------------------------------------------------------------------------------------

local function setRow(row: Frame, p: any)
	local lv = row:FindFirstChild("Level") :: TextLabel?
	if lv then
		lv.Text = string.format("%s%s  Lv %d/%d", p.Name, string.rep("\u{2605}", p.Evolve or 0), p.Level, p.Cap or p.Level)
	end
	local pw = row:FindFirstChild("Power") :: TextLabel?
	if pw then
		-- at the cap the copies count shows how close an EVOLVE is (3 copies of the same pet)
		local maxedNow = p.Cap ~= nil and p.Level >= p.Cap
		local copies = if maxedNow and p.EvolveWhy ~= "Stage" and p.Copies then string.format("   \u{1F9EC} %d/3", p.Copies) else ""
		pw.Text = "\u{26A1} " .. UI.num(p.Power2) .. copies
	end
	local fill = row:FindFirstChild("Fill", true) :: Frame?
	if fill then
		local f = if (p.XpNeed or 0) > 0 then math.clamp(p.XpInto / p.XpNeed, 0, 1) else 1
		fill.Size = UDim2.fromScale(f, 1)
	end
	local train = row:FindFirstChild("TrainBtn") :: TextButton?
	if train then
		local maxed = p.Cap ~= nil and p.Level >= p.Cap
		local label = train:FindFirstChild("Label") :: TextLabel?
		local evolve = maxed and p.CanEvolve == true
		if label then
			label.Text = if evolve then "EVOLVE!" elseif maxed then "MAX" else "TRAIN!"
		end
		UI.setEnabled(train, evolve or not maxed, if evolve then "blue" else "gold")
	end
	local team = row:FindFirstChild("TeamBtn") :: TextButton?
	if team then
		local on = table.find(picked, p.Id) ~= nil
		local label = team:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = if on then "IN TEAM" else "ADD"
		end
		UI.setEnabled(team, true, if on then "green" else "gray")
	end
end

function openTrain()
	if stale() then
		wantCard = "Train"
		send({ Op = "Open" })
		return
	end
	picked = table.clone(roster.Team)
	local panel, body, _close, footer = UI.modal("Train", "TRAIN PETS", Vector2.new(620, 440), {
		Subtitle = "Tap TRAIN, climb the TOWER or hunt eggs to level up your pets!",
		Footer = T.Primary.Y + 16,
	})
	PanelSkin.dress(panel, "IconPets", "TRAIN PETS")
	UI.list(body, Enum.FillDirection.Vertical, 6)
	table.clear(trainRows)
	if #roster.Pets == 0 then
		UI.emptyState(body, "No pets yet", "Hatch a pet in the egg race first!")
	end
	local sorted = table.clone(roster.Pets)
	table.sort(sorted, function(a: any, b: any)
		return a.Power2 > b.Power2
	end)
	for i, p in sorted do
		local row = UI.card(body, "inset", { Name = "Pet_" .. tostring(p.Id), Size = UDim2.new(1, 0, 0, 74), LayoutOrder = i })
		picture(row, p.Spec, 62)
		-- one line shrunk to fit, so a long variant name never pushes "Lv 4/10" out of the box
		UI.oneLine(UI.text(row, "", { Name = "Level", Font = UI.Bold, TextSize = T.Body, Position = UDim2.fromOffset(74, 4), Size = UDim2.new(0.5, -78, 0, 24), TextColor3 = TowerView.TypeColor[p.Element] or TC.Text }))
		UI.text(row, "", { Name = "Power", Font = UI.Head, TextSize = T.Body, Position = UDim2.fromOffset(74, 28), Size = UDim2.new(0.5, -78, 0, 22) })
		UI.bar(row, { Name = "Xp", Position = UDim2.fromOffset(74, 54), Size = UDim2.new(0.5, -78, 0, 10) }, TC.Gold)
		UI.button(row, "ADD", "gray", function()
			local at = table.find(picked, p.Id)
			if at then
				table.remove(picked, at)
			elseif #picked < PvpConfig.TeamSize then
				table.insert(picked, p.Id)
			else
				UI.notify("Your team is full. Tap IN TEAM on a pet to take it out.", "info")
				return
			end
			send({ Op = "SetTeam", Pets = picked })
			for _, q in roster.Pets do
				local r = trainRows[q.Id]
				if r then
					setRow(r, q)
				end
			end
		end, { Name = "TeamBtn", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -132, 0.5, 0), Size = UDim2.fromOffset(104, 44), TextSize = T.Small })
		UI.button(row, "TRAIN!", "gold", function()
			local cur = petById(p.Id) or p
			if cur.CanEvolve and cur.Cap and cur.Level >= cur.Cap then
				UI.confirm({
					Name = "Evolve", Title = "Evolve " .. tostring(cur.Name) .. "?",
					Message = "Uses 2 other copies of this pet. It grows bigger, stronger and can level higher!",
					Confirm = "EVOLVE!", Cancel = "NOT NOW", Style = "blue",
					OnConfirm = function()
						send({ Op = "Evolve", Pet = cur.Id })
					end,
				})
				return
			end
			local now = os.clock()
			if now - lastTap < 1 / PvpConfig.Train.TapsPerSecond then
				return -- the server counts at most TapsPerSecond taps; faster taps would just be dropped
			end
			lastTap = now
			send({ Op = "Train", Pet = p.Id })
			if not reduced() then
				Juice.wobble(row)
			end
		end, { Name = "TrainBtn", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(116, 54) })
		trainRows[p.Id] = row
		setRow(row, p)
	end
	if footer then
		UI.list(footer, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		UI.button(footer, "BEST", "gray", function()
			send({ Op = "EquipBest" })
		end, { Name = "Best", Size = UDim2.new(0.24, -6, 1, 0), LayoutOrder = 1 })
		-- the Training Tower (carter 2026-10-14): every floor climbed gives the team XP
		UI.button(footer, "TOWER", "blue", function()
			TowerPanel.openPicker()
		end, { Name = "Tower", Size = UDim2.new(0.24, -6, 1, 0), LayoutOrder = 2 })
		-- rarer pets grow higher (level caps): the egg shrine is the other way to get stronger
		UI.button(footer, "HATCH", "gold", function()
			PetShop.setPayCoins(true)
			PetShop.open("Eggs")
		end, { Name = "Hatch", Size = UDim2.new(0.24, -6, 1, 0), LayoutOrder = 3 })
		UI.button(footer, "BATTLE", "green", function()
			wantCard = "Battle"
			send({ Op = "Open" })
		end, { Name = "ToBattle", Size = UDim2.new(0.24, -6, 1, 0), LayoutOrder = 4 })
	end
end

-- The trained pet, when it follows the player, does its "train" clip (PetMotion) while the taps keep coming and a
-- squash hop each tap; a level up gets PetFx's level-up burst.
local trainUntil: { [string]: number } = {}
local function trainMotion(msg: any)
	local m = PetFollow.modelFor(player, msg.Pet)
	if not m then
		return
	end
	PetMotionBridge.setAnim(m, "train")
	local id = tostring(msg.Pet)
	trainUntil[id] = os.clock() + 1.5
	task.delay(1.6, function()
		if os.clock() >= (trainUntil[id] or 0) and m.Parent and m:GetAttribute("Anim") == "train" then
			trainUntil[id] = nil
			PetMotionBridge.setAnim(m, nil)
		end
	end)
	if msg.LevelUp then
		if not moment("levelup", { Target = m, Level = msg.Level, Mine = true }) then
			pcall(PetFx.levelUp, m, msg.Level)
		end
	elseif (msg.Gain or 0) > 0 and not reduced() then
		pcall(PetFx.squash, m)
	end
end

local function onTrained(msg: any)
	local p = petById(msg.Pet)
	if not p then
		return
	end
	trainMotion(msg)
	p.Level, p.XpInto, p.XpNeed, p.Power2 = msg.Level, msg.XpInto, msg.XpNeed, msg.Power
	if msg.Maxed and not msg.LevelUp then
		UI.notify(string.format("%s is at max level! Rarer pets can grow higher.", p.Name), "info", { Tag = "trainmax" })
	end
	local row = trainRows[p.Id]
	if row and row.Parent then
		setRow(row, p)
		local btn = row:FindFirstChild("TrainBtn") :: GuiObject?
		if btn then
			Juice.floatText(btn, "+" .. tostring(msg.Gain) .. " XP", TC.Gold)
		end
	end
	if msg.LevelUp then
		Juice.banner(string.format("LEVEL UP! %s Lv %d", p.Name, msg.Level), TC.Gold, 1.4)
		UI.notify(string.format("%s power %s \u{2192} %s!", p.Name, UI.num(msg.PowerBefore or msg.Power), UI.num(msg.Power)), "success", { Tag = "trainlv" })
		Audio.play("LevelUp") -- PetSoundIds.LevelUp (stand-in RarityAccent until uploaded)
		if row and row.Parent then
			Juice.confetti(row, 18)
		end
	end
end

-- HUD: entry button, queue strip, fight bar --------------------------------------------------------------------------

local function buildEntry()
	local screen = UI.screen()
	local box = screen:WaitForChild("LeftBox", 10) -- the HUD wraps its left column in this box
	local left = if box then box:WaitForChild("Left", 10) else nil
	local row = if left then left:WaitForChild("ModeRow", 5) or left else nil
	local b: TextButton = HudArt.bigButton(row or screen, {
		Name = "BattleButton", Style = "red", Art = "IconLeaderboard", Title = "BATTLE", Sub = "Pet vs pet", Width = 172, Height = 60, LayoutOrder = 2,
		OnClick = openBattle,
	})
	b:SetAttribute("Short", "FIGHT") -- the word on the square phone tile (HudArt.compact)
	if not left then
		b.Position = UDim2.fromOffset(T.Edge, T.Edge + 220)
	end
	local function refresh()
		b.Visible = player:GetAttribute("MatchKey") == nil and player:GetAttribute("InTower") == nil and player:GetAttribute("InBattle") == nil
	end
	for _, a in { "MatchKey", "InTower", "InBattle" } do
		player:GetAttributeChangedSignal(a):Connect(refresh)
	end
	refresh()
end

local function buildQueueStrip()
	local g = holder("BattleQueue")
	local strip = UI.card(g, "hud", { Name = "Strip", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, T.Edge + 48), Size = UDim2.fromOffset(340, 48) })
	queueLabel = UI.text(strip, "Finding a rival...", { Font = UI.Bold, TextSize = T.Body, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -120, 1, 0) })
	UI.button(strip, "CANCEL", "gray", function()
		send({ Op = "Cancel" })
	end, { Name = "Cancel", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(100, 38), TextSize = T.Small })
	g.Visible = false
	queueStrip = g
end

local function setQueued(on: boolean)
	queuedAt = if on then os.clock() else nil
	if queueStrip then
		queueStrip.Visible = on
	end
end

local SPECIAL_W = 160
local function buildHud()
	local g = holder("BattleHud")
	g.Visible = false
	hud = g
	local top = UI.card(g, "hud", { Name = "Top", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, T.Edge), Size = UDim2.fromOffset(380, 66) })
	namesLabel = UI.text(top, "YOU vs RIVAL", {
		Font = UI.Head, TextSize = T.Body, Outline = "Strong", Size = UDim2.new(1, -12, 0, 32), Position = UDim2.fromOffset(6, 2), TextXAlignment = Enum.TextXAlignment.Center,
	})
	timerLabel = UI.text(top, "1:00", {
		Font = UI.Head, TextSize = T.Body, TextColor3 = TC.Gold, Size = UDim2.new(1, -12, 0, 28), Position = UDim2.fromOffset(6, 34), TextXAlignment = Enum.TextXAlignment.Center,
	})
	TowerView.topClear = function(): number
		if g.Visible then
			local inset = (GuiService:GetGuiInset())
			return inset.Y + top.AbsolutePosition.Y + top.AbsoluteSize.Y
		end
		return 0
	end
	UI.button(g, "LEAVE", "red", function()
		UI.confirm({
			Name = "BattleLeave", Title = "Leave the battle?", Message = "Leaving counts as a loss.", Confirm = "LEAVE", Cancel = "STAY", Style = "red",
			OnConfirm = function()
				send({ Op = "Leave" })
			end,
		})
	end, { Name = "Leave", Position = UDim2.new(0, T.Edge, 0.14, 0), Size = UDim2.fromOffset(100, T.Touch), TextSize = T.Small })
	local sp = UI.button(g, "SPECIAL", "gold", function()
		send({ Op = "Special" })
	end, { Name = "Special", AnchorPoint = Vector2.new(1, 1), Size = UDim2.fromOffset(SPECIAL_W, T.Primary.Y + 6) })
	sp:SetAttribute("DisabledFill", Color3.fromRGB(40, 48, 66))
	sp:SetAttribute("DisabledText", Color3.new(1, 1, 1))
	specialBtn = sp
	local _, fill = UI.bar(sp, { Name = "Meter", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -6), Size = UDim2.new(1, 0, 0, 10) }, TC.Gold)
	meterFill = fill
	-- same spot as the tower's SPECIAL: above or beside Roblox's jump button, never on the thumbstick side
	local function place()
		local px = UI.screen().AbsoluteSize
		if px.X < 2 or px.Y < 2 then
			return
		end
		local cam = Workspace.CurrentCamera
		local full = if cam then cam.ViewportSize else px
		local scale = math.max(UI.Scale, 0.1)
		local h = T.Primary.Y + 6 + 16
		local topLimit = px.Y - (T.Edge + 250) * scale
		local r, bottom, mode = TouchLayout.place(full.X, full.Y, h * scale, topLimit, UserInputService.TouchEnabled)
		local w = SPECIAL_W
		if mode == "left" then
			w = math.max(96, math.min(w, (px.X * 0.6 - r) / scale))
		end
		sp.Size = UDim2.fromOffset(w, T.Primary.Y + 6)
		sp.Position = UDim2.new(1, -r / scale, 1, -bottom / scale)
	end
	place()
	UI.screen():GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		task.defer(place)
	end)
	TapFight.build(g, sp, function(msg)
		send(msg)
	end)
end

local wasFull = false
local hasSpecial = true -- only Epic+ pets bring a SPECIAL (carter 2026-10-14)
local function setMeter(f: number)
	if not hasSpecial then
		f = 0
	end
	f = math.clamp(f, 0, 1)
	if meterFill then
		meterFill.Size = UDim2.fromScale(f, 1)
		meterFill.BackgroundColor3 = if f >= 1 then TC.Gold else Color3.fromRGB(105, 218, 232)
	end
	local sp = specialBtn
	if sp then
		UI.setEnabled(sp, f >= 1, "gold")
		local label = sp:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = if not hasSpecial then "EPIC+ ONLY" elseif f >= 1 then "SPECIAL!" else "CHARGING " .. math.floor(f * 100) .. "%"
		end
		if f >= 1 and not wasFull then
			Audio.play("RarityAccent", { Volume = 0.6, Key = "pvp:special-ready" })
			if not reduced() then
				task.spawn(function()
					for _, rot in { -6, 6, -4, 4, 0 } do
						TweenService:Create(sp, TweenInfo.new(0.06, Enum.EasingStyle.Sine), { Rotation = rot }):Play()
						task.wait(0.06)
					end
				end)
			end
		end
	end
	wasFull = f >= 1
end

-- The VS splash while the fight camera sweeps in: the two sides slide in from the edges, a big VS pops between them.
local function vsSplash(left: string, right: string, hold: number)
	local root = UI.noticeLayer()
	local old = root:FindFirstChild("PvpVs")
	if old then
		old:Destroy()
	end
	local f = UI.frame(root, {
		Name = "PvpVs", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.68), Size = UDim2.new(0.94, 0, 0, 74), BackgroundTransparency = 1, ZIndex = 38,
	})
	local lim = Instance.new("UISizeConstraint")
	lim.MaxSize = Vector2.new(720, 74)
	lim.Parent = f
	local function plate(name: string, text: string, color: Color3, x: number, from: number)
		local card = UI.frame(f, {
			Name = name, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(from, 0.5), Size = UDim2.new(0.4, 0, 0, 52),
			BackgroundColor3 = color, BackgroundTransparency = 0.12, ZIndex = 38,
		})
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 14)
		c.Parent = card
		local st = Instance.new("UIStroke")
		st.Color = Color3.new(1, 1, 1)
		st.Thickness = 3
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		st.Parent = card
		UI.text(card, text, { Name = "Text", Font = UI.Head, TextSize = T.Head, TextColor3 = Color3.new(1, 1, 1), Outline = "Strong", Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 39 })
		if UI.Reduced then
			card.Position = UDim2.fromScale(x, 0.5)
		else
			TweenService:Create(card, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.fromScale(x, 0.5) }):Play()
		end
	end
	plate("Me", left, Color3.fromRGB(60, 140, 255), 0.22, -0.3)
	plate("Foe", right, Color3.fromRGB(235, 70, 70), 0.78, 1.3)
	local vs = UI.text(f, "VS", { Name = "Vs", Font = UI.Head, TextSize = 56, TextColor3 = TC.Gold, Outline = "Strong", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.18, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 40 })
	vs.TextWrapped = false
	task.delay(if UI.Reduced then 0 else 0.3, function()
		if vs.Parent then
			UI.pop(vs, 0.3)
		end
	end)
	task.delay(hold, function()
		if not f.Parent then
			return
		end
		local info = TweenInfo.new(0.35)
		for _, d in f:GetDescendants() do
			if d:IsA("TextLabel") then
				TweenService:Create(d, info, { TextTransparency = 1 }):Play()
			elseif d:IsA("Frame") then
				TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
			elseif d:IsA("UIStroke") then
				TweenService:Create(d, info, { Transparency = 1 }):Play()
			end
		end
	end)
	Debris:AddItem(f, hold + 0.5)
end

local function countIn(n: number)
	task.spawn(function()
		for i = math.floor(n), 1, -1 do
			if not inFight then
				return
			end
			Juice.banner(tostring(i), TC.Gold, 0.6)
			task.wait(1)
		end
		if inFight then
			Juice.banner("FIGHT!", Color3.fromRGB(255, 110, 80), 0.9)
		end
	end)
end

-- The loser's finisher: the camera eases in on the rival's strongest standing pet, which glows in its rarity colour
-- under a big card (power, rarity, level). It is what beat you, and what you could have.
local function finisher()
	local best, bestPower = nil, -1
	for id, u in unitInfo do
		local m = TowerView.model(id)
		local standing = m ~= nil and u.Hp > 0
		local p = (u.Info and u.Info.Power or 0) + (if standing then 1e6 else 0)
		if u.Foe and m and p > bestPower then
			best, bestPower = id, p
		end
	end
	if not best then
		return
	end
	local u = unitInfo[best]
	local info = u.Info or {}
	beatBy = { Name = u.Name, Power = info.Power or 0, Rarity = info.Rarity or "Common", Level = info.Level or 1, Cap = info.Cap or 1, Modifier = info.Modifier }
	local variant = if info.Modifier and info.Modifier ~= "Natural" then string.upper(info.Modifier) .. " " else ""
	TowerView.showcase(best, "\u{26A1}" .. UI.num(beatBy.Power), string.format("%s%s · Lv %d/%d", variant, string.upper(beatBy.Rarity), beatBy.Level, beatBy.Cap), RARITY_COLOR[beatBy.Rarity] or TC.Gold)
	local model = TowerView.model(best)
	if model then
		FightCam.hero(model) -- a low push-in on what beat you, held until the fight closes
	end
end

local function endFightView()
	inFight = false
	TapFight.stop()
	FightCam.stop()
	table.clear(unitInfo)
	applyLayout(nil)
	if hud then
		hud.Visible = false
	end
	TowerView.clear()
	task.delay(0.3, function()
		local cam = Workspace.CurrentCamera
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if cam and root and root:IsA("BasePart") and cam.CameraType == Enum.CameraType.Custom and not inFight then
			local p = root.Position
			cam.CFrame = CFrame.lookAt(p - root.CFrame.LookVector * 10 + Vector3.new(0, 5, 0), p + Vector3.new(0, 1.5, 0))
		end
	end)
end

local function showResult(msg: any)
	local title = if msg.Result == "Win" then "VICTORY!" elseif msg.Result == "Loss" then "DEFEAT" else "DRAW"
	local lines = {}
	table.insert(lines, string.format("+%s coins", UI.num(msg.Coins)))
	if msg.TrophyChange ~= 0 then
		table.insert(lines, string.format("%s%d trophies", if msg.TrophyChange > 0 then "+" else "", msg.TrophyChange))
	end
	if msg.Streak >= 2 then
		table.insert(lines, string.format("%d win streak!", msg.Streak))
	end
	local text = table.concat(lines, " · ") .. string.format("\n+%d pet XP · %s rank (%d trophies)", msg.Xp, msg.Rank, msg.Trophies)
	for _, up in msg.LevelUps or {} do
		text ..= string.format("\n%s reached Lv %d (power %s)!", up.Name, up.Level, UI.num(up.Power))
	end
	local lost = msg.Result == "Loss" and beatBy ~= nil
	if lost then
		-- what beat you, and how to get there: train, hatch rarer pets
		text ..= string.format("\nBeaten by %s: \u{26A1}%s, %s Lv %d/%d. Get stronger!", beatBy.Name, UI.num(beatBy.Power), beatBy.Rarity, beatBy.Level, beatBy.Cap)
	end
	beatBy = nil
	UI.confirm({
		Name = "BattleResult", Title = title, Message = text, Confirm = if lost then "GET STRONGER" else "FIGHT AGAIN", Cancel = "OK",
		Style = if msg.Result == "Win" then "green" else "gold",
		OnConfirm = function()
			if lost then
				openTrain()
			else
				send({ Op = "Queue" })
			end
		end,
	})
	if msg.Result == "Win" then
		Audio.play("BattleWin") -- PetSoundIds.BattleWin (stand-in MatchWin until uploaded)
		local shade = UI.dialogLayer():FindFirstChild("Dialog_BattleResult")
		local panel = shade and shade:FindFirstChild("Panel")
		if panel and panel:IsA("GuiObject") then
			Juice.confetti(panel, 30)
		end
	end
	roster = nil -- stale (trophies, levels): the next card asks again
end

-- Fight moments on top of TowerView's hit drawing: FightFx (crit / special / K.O. with the
-- winner's showcase; screen effects only when one of the player's own pets is in it) and the owner's PetMotion attack
-- and hit clips (no-op without them). Fighters and watchers both see them.
local function units(list: { any }?)
	table.clear(unitInfo)
	local all: { any } = list or {}
	for _, u in all do
		unitInfo[u.Id] = { Foe = u.Foe == true, Info = u.Info, Name = u.Name, Hp = u.Hp, Element = u.Element }
	end
end

local function syncHp(hp: any)
	for id, pair in hp or {} do
		local u = unitInfo[id]
		if u and type(pair) == "table" then
			u.Hp = pair[1] or 0
		end
	end
end

-- The K.O.: the last pet that fainted, and the strongest pet still standing on the other side gets the showcase.
local function knockout(fainted: string?)
	local lost = fainted and unitInfo[fainted]
	local winner: Model? = nil
	local bestPower = -1
	for id, u in unitInfo do
		local m = TowerView.model(id)
		if m and u.Hp > 0 and (lost == nil or u.Foe ~= lost.Foe) then
			local p = u.Info and u.Info.Power or 0
			if p > bestPower then
				winner, bestPower = m, p
			end
		end
	end
	local target = fainted and TowerView.model(fainted)
	local winnerMine = false
	if lost then
		winnerMine = lost.Foe -- the foe fainted: my side won
	end
	local played = target ~= nil and moment("ko", {
		Target = target,
		Winner = winner,
		Mine = inFight,
		Cinematic = false, -- FightCam directs the K.O. (orbit, then the winner's hero shot)
		WinnerMine = winnerMine,
	})
	if inFight and target then
		FightCam.ko(target, winner)
	end
	if not played then
		TowerView.knockout(fainted)
	end
end

local function fightMotion(list: { any })
	for _, e in list do
		if e.Kind == "Hit" then
			local from, to = TowerView.model(e.From or ""), TowerView.model(e.To or "")
			PetMotionBridge.play(from, "attack")
			PetMotionBridge.play(to, "hit")
			-- plain and type-advantage hits are TowerView's numbers and "Strong!" pops; FightFx adds the crits (a second
			-- pop on every hit buried the fight in text on a phone)
			if inFight and to then
				-- no lean on every hit (Studio 2026-10-15 camera log: the leans and a close-up on every type-advantage
				-- hit kept the wide shot off both teams most of the fight); crits only get a close-up, spaced out by
				-- FightCamRules.CUT_GAP
				if e.Crit then
					FightCam.cut("crit", to, from)
				end
			end
			if to and e.Crit then
				local att = unitInfo[e.From or ""]
				local def = unitInfo[e.To or ""]
				moment("crit", {
					Target = to,
					Attacker = from,
					Element = att and att.Element,
					Quiet = true, -- TowerView already pops "CRIT! 72" (two words stacked on a phone)
					Mine = inFight and def ~= nil and (not def.Foe or (att ~= nil and not att.Foe)),
				})
			end
		elseif e.Kind == "Special" then
			local from = TowerView.model(e.From or "")
			local att = unitInfo[e.From or ""]
			if from then
				local target: Model? = nil
				for id, u in unitInfo do
					if att and u.Foe ~= att.Foe and u.Hp > 0 then
						target = TowerView.model(id)
						break
					end
				end
				moment("special", { Attacker = from, Target = target or from, Element = att and att.Element, Mine = inFight })
				if inFight and att then
					if att.Foe then
						FightCam.cut("special", target or from, from) -- the rival's SPECIAL lands on our pets
					else
						FightCam.cut("charge", from) -- ours: over the caster's shoulder
					end
				end
			end
		end
	end
end

local function onEvent(msg: any)
	if type(msg) ~= "table" then
		return
	end
	local k = msg.Kind
	if k == "Roster" then
		roster = msg
		rosterAt = os.clock()
		local want = wantCard
		wantCard = nil
		if want == "Train" then
			openTrain()
		elseif want == "Battle" or (want == nil and UI.modalOpen() == "Battle") then
			openBattle()
		elseif UI.modalOpen() == "Train" then
			-- a team change: restyle the open train card in place (keeps its scroll position)
			picked = table.clone(msg.Team)
			for _, q in msg.Pets do
				local r = trainRows[q.Id]
				if r and r.Parent then
					setRow(r, q)
				end
			end
		end
	elseif k == "OpenCard" then
		wantCard = msg.Card
	elseif k == "Trained" then
		onTrained(msg)
	elseif k == "Evolved" then
		if msg.Ok then
			Juice.banner(string.format("EVOLVED! %s", string.rep("\u{2605}", msg.Stage or 1)), TC.Gold, 2)
			UI.notify(string.format("Power %s \u{2192} %s! New max level %d.", UI.num(msg.PowerBefore or 0), UI.num(msg.Power or 0), msg.Cap or 0), "success", { Tag = "evolve" })
			Audio.play("Evolve") -- PetSoundIds.Evolve (stand-in RarityAccent until uploaded)
			-- the evolved pet, if it follows the player, celebrates (PetFx level-up burst + a happy bounce)
			task.delay(0.6, function()
				local m = PetFollow.modelFor(player, msg.Pet)
				if m then
					pcall(PetFx.happy, m)
					pcall(PetFx.pop, m:GetPivot().Position + Vector3.new(0, 4, 0), "EVOLVED!", TC.Gold, true)
				end
				pcall(PetFollow.bounce, player, msg.Pet)
			end)
		elseif msg.Why == "Copies" then
			UI.notify("You need 3 copies of this pet to evolve. Pets that follow you or sit on your plot are kept safe.", "info", { Tag = "evolve" })
		end
	elseif k == "Queued" then
		queueBot = msg.BotAfter or PvpConfig.BotAfter
		setQueued(true)
		UI.notify("Looking for a rival! You can walk around while you wait.", "info", { Tag = "pvpqueue" })
	elseif k == "Unqueued" then
		local was = queuedAt ~= nil
		setQueued(false)
		local why = PvpRules.unqueueText(msg.Why)
		if was and why then
			UI.notify(why, "info", { Tag = "pvpqueue" })
		end
	elseif k == "Start" then
		setQueued(false)
		UI.closeModal()
		UI.closeDialog()
		for _, name in { "NextGoal", "AwayNest" } do
			local card = UI.dialogLayer():FindFirstChild(name)
			if card then
				card:Destroy() -- a welcome card never covers the fight (it waits for the lobby: RetentionView)
			end
		end
		inFight = true
		TowerView.clear()
		applyLayout(msg.Layout or PvpConfig.Layouts.Private)
		TowerView.floor({ Origin = msg.Origin, Units = msg.Units })
		units(msg.Units)
		beatBy = nil
		fightStarts = os.clock() + (msg.CountIn or 0)
		fightEnds = fightStarts + (msg.FightTime or PvpConfig.FightTime)
		if namesLabel then
			local foe = msg.Foe or {}
			namesLabel.Text = string.format("YOU (%s)  vs  %s%s (%s)", UI.num(msg.Me and msg.Me.Power or 0), string.upper(tostring(foe.Name)), if foe.Bot then " BOT" else "", UI.num(foe.Power or 0))
		end
		if hud then
			hud.Visible = true
		end
		hasSpecial = msg.HasSpecial ~= false
		setMeter(0)
		TapFight.start(msg.MySide or 1)
		task.delay(msg.CountIn or 0, function()
			if inFight then
				TapFight.live()
			end
		end)
		if not hasSpecial then
			UI.notify("Epic and Legendary pets bring a SPECIAL to battles!", "info", { Tag = "pvpspecial" })
		end
		local n = msg.CountIn or 0
		FightCam.start(msg.Origin, msg.Layout or PvpConfig.Layouts.Private, n > 0, n, msg.Units)
		local foe = msg.Foe or {}
		vsSplash(string.format("YOU \u{26A1}%s", UI.num(msg.Me and msg.Me.Power or 0)), string.format("%s%s \u{26A1}%s", string.upper(tostring(foe.Name)), if foe.Bot then " BOT" else "", UI.num(foe.Power or 0)), math.max(n - 0.4, 1.8))
		countIn(n)
	elseif k == "Events" then
		if not inFight then
			return
		end
		TowerView.events(msg.List, msg.Hp)
		syncHp(msg.Hp)
		fightMotion(msg.List)
		TapFight.events(msg.List)
		setMeter(msg.Meter or 0)
		local lastFaint: string? = nil
		for _, e in msg.List do
			if e.Kind == "Faint" then
				lastFaint = e.To
			elseif e.Kind == "KO" then
				knockout(lastFaint)
			elseif e.Kind == "TimeUp" then
				Juice.banner("TIME UP!", TC.Gold, 0.9)
			end
		end
	elseif k == "Over" then
		local won = msg.Winner == msg.MySide
		if msg.Winner == 0 then
			Juice.banner("DRAW!", TC.Gold, 1.6)
		else
			TowerView.cheer(won)
			Juice.banner(if won then "YOU WIN!" else "K.O.! YOU LOSE", if won then TC.Gold else Color3.fromRGB(230, 90, 80), 1.8)
			if not won then
				if hud then
					hud.Visible = false -- the finisher card takes the top of the screen
				end
				finisher()
			end
		end
		if specialBtn then
			UI.setEnabled(specialBtn, false, "gold")
		end
		TapFight.stop()
	elseif k == "Result" then
		if inFight then
			endFightView()
		end
		showResult(msg)
	elseif k == "Closed" then
		if inFight then
			endFightView()
		end
	elseif k == "Notice" then
		UI.notify(tostring(msg.Text), "info")
	end
end

function PvpPanel.start()
	local net = game:GetService("ReplicatedStorage"):WaitForChild("PvpNet")
	local action = net:WaitForChild("PvpAction") :: RemoteEvent
	local event = net:WaitForChild("PvpEvent") :: RemoteEvent
	send = function(msg)
		action:FireServer(msg)
	end
	task.spawn(buildEntry)
	buildQueueStrip()
	buildHud()
	event.OnClientEvent:Connect(onEvent)
	-- queue strip countdown and fight timer
	task.spawn(function()
		while true do
			task.wait(0.25)
			if queuedAt and queueLabel then
				local waited = os.clock() - queuedAt
				local left = math.max(math.ceil(queueBot - waited), 0)
				queueLabel.Text = if left > 0 then string.format("Finding a rival... %d", left) else "Bringing a bot rival!"
			end
			if inFight and timerLabel then
				local left = math.max(math.ceil(fightEnds - os.clock()), 0)
				timerLabel.Text = if os.clock() < fightStarts then "GET READY" else string.format("%d:%02d", left // 60, left % 60)
			end
		end
	end)
end

PvpPanel.openBattle = openBattle
PvpPanel.openTrain = function()
	openTrain()
end

return PvpPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="370">
            <Properties>
              <string name="Name">QuestPanel</string>
              <string name="Source"><![CDATA[--!strict
-- DAILY: the daily login gift (7-day streak, day 7 pays the most) and today's three quests (Find The Pet part 2).
-- Everything shown comes from the server's profile view (`prof.Daily`, built by shared/Quests.view); the buttons
-- only send claims (ShopAction "ClaimGift" / "ClaimQuest", index) and the server decides and pays. Coins only.
-- Entry point: QuestPanel.open() (the HUD "Daily" tile).

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local UiKit = require(Shared.UiKit)
local LaunchPerks = require(Shared.LaunchPerks)
local RobuxConfig = require(Shared.RobuxConfig)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local Juice = require(script.Parent.Juice)
local HudArt = require(script.Parent.HudArt)
local PanelSkin = require(script.Parent.PanelSkin)
local PetStyle = require(script.Parent.PetStyle)
local ShopEgg = require(script.Parent.ShopEgg)

local T = UI.T
local TC = Theme.Color
local PET = Theme.Pet
local QuestPanel = {}

local body: any = nil
local isOpen = false
local openPanel: Instance? = nil -- the panel isOpen belongs to; an older panel closing late must not clear it
local started = false
-- Celebrations play only once the server's profile shows the claim went through (never on the tap itself).
local giftAsked = false -- OPEN was tapped and the gift was still ready
local questAsked: { [number]: boolean } = {} -- CLAIM was tapped for quest i

local function shop(action: string, id: any?)
	Net.event("ShopAction"):FireServer(action, id)
end

-- "5h 12m" / "12m" until the UTC midnight turnover.
local function untilText(at: number): string
	local left = math.max(0, at - os.time())
	local h = math.floor(left / 3600)
	local m = math.floor((left % 3600) / 60)
	return if h > 0 then (h .. "h " .. m .. "m") else (math.max(m, 1) .. "m")
end

-- Pet style (Theme.Pet, docs/UI_STYLE_REF.md): the white patterned sheet comes from UI.modal; the gift box and the
-- quest rows are light QuestBody cards with the soft blue QuestEdge, headings in the clip's QuestTitle blue, body words
-- in the deep title blue (no outline on the light cards), the seven days as glossy blue tiles (day 7 gold), the streak
-- and the next-gift countdown on the tilted yellow Tag, CLAIM / OPEN as lime pills (UI.button "gold" draws lime).
-- Picture slots (HudArt.Buttons daily_*) stay off under the pet style (HudArt.skin returns false).
local NAVY, BLUE, BAR = PET.TitleEdge, PET.QuestTitle, PET.Blue
local box, content, word = PanelSkin.box, PanelSkin.content, PanelSkin.word

-- The tilted yellow tag (the clip's "NEXT UP!"): gold fill, brown edge, dark words. Returns the tag and its label.
-- `light` draws the words white with the dark outline instead (the small "Streak 1" in brown on orange was hard to
-- read at phone size, Studio check 2026-10-15).
local function tag(parent: Instance, text: string, size: number, props: { [string]: any }, light: boolean?): (Frame, TextLabel)
	local f = UI.frame(parent, props)
	f.Name = props.Name or "Tag"
	f.BackgroundColor3 = PET.Tag
	PetStyle.round(f, 999)
	PetStyle.edge(f, PET.TagEdge, 2)
	PetStyle.vgrad(f, PET.Gold:Lerp(PET.White, 0.25), PET.Tag)
	local l = word(f, text, size, {
		Name = "Text", Font = UI.Head, TextColor3 = if light then PET.White else PET.TagEdge, Outline = if light then "Normal" else false,
		Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = f.ZIndex + 1,
	})
	return f, l
end

-- Short landscape screens (the Studio 844 x 390 window, landscape phones: under 420 logical px tall) see the quest
-- list through a ~200 px window. The gift box compacts there (streak tag beside the heading, no coin picture on the
-- day tiles, less padding) so one whole quest row shows under it without scrolling.
local function shortScreen(): boolean
	return not UI.isPortrait() and UI.Logical.Y < 420
end

-- How much shorter (logical px) the quest window should be (its height now plus `extra`) so that, at the top, it
-- ends on a whole row (UiKit.snapCut, like UI.rowCut). Pixels per logical px come from the gift box's own drawn
-- height against the height it was given, so the cut is right under any stack of UIScales above the list (the
-- layer's, the menu's pop-in spring, a preview wrapper): a guessed scale cut the first quest row mid-way.
local function rowCut(sc: ScrollingFrame, extra: number): number
	local gift = sc:FindFirstChild("Gift") :: GuiObject?
	local k = if gift and gift.AbsoluteSize.Y > 0 and gift.Size.Y.Offset > 0 then gift.AbsoluteSize.Y / gift.Size.Y.Offset else math.max(UI.Scale, 0.01)
	local window = sc.AbsoluteWindowSize.Y / k + extra
	local top = sc.AbsolutePosition.Y
	local bottoms: { number } = {}
	local heights: { number } = {}
	for _, c in sc:GetChildren() do
		if c:IsA("GuiObject") and c.Visible and c.AbsoluteSize.Y > 0 then
			table.insert(bottoms, (c.AbsolutePosition.Y + c.AbsoluteSize.Y - top) / k + sc.CanvasPosition.Y + 2)
			table.insert(heights, c.AbsoluteSize.Y / k)
		end
	end
	return UiKit.snapCut(bottoms, window, nil, heights)
end

local MORE_H = 62 -- footer strip under the list for the MORE QUESTS button (it overlapped the third quest)
local MORE_H_TIGHT = 46 -- the same on a very short landscape phone, where the list needs every stud

local function oneLine(b: GuiButton)
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l then
		l.TextWrapped = false
		-- the button is built before the list lays out (size 0), so a one-off fit leaves the words tiny: scale with the box
		UI.fit(l, T.Body + 4, T.MinText) -- the shared text floor (14 logical, 12 real px), re-fitted with the scale
	end
end

-- The free egg the day 7 gift banks (LaunchPerks.StreakEgg): its shop look in a still viewport (ShopEgg: drawn
-- stand-in parts, or the owner's egg picture when RobuxConfig has one; no asset ids invented here).
local function streakEgg(parent: Instance, props: { [string]: any }): GuiObject
	local id = LaunchPerks.StreakEgg.Egg
	local egg = RobuxConfig.egg(id)
	local v = ShopEgg.view(parent, id, props, { Spin = false, Halo = false, Variant = 1, Yaw = -25, Image = if egg then egg.Image else nil })
	v.Name = "FreeEgg"
	return v
end

-- OPEN +N: the owner's OPEN picture (word baked in) drawn whole, with the coin amount in a small badge on its corner.
local function openPicture(b: TextButton, reward: number)
	local k = HudArt.Buttons.btn_open
	if Theme.PetStyle or not HudArt.hasSkin("btn_open") then
		HudArt.skin(b, "btn_yellow", 48) -- the pet style keeps the drawn lime pill with "OPEN +N" on it
		return
	end
	b.BackgroundTransparency = 1
	for _, c in b:GetChildren() do
		if c:IsA("UIStroke") then
			c.Enabled = false
		elseif c:IsA("GuiObject") then
			c.Visible = false
		end
	end
	local r = k.Rect
	local img = Instance.new("ImageLabel")
	img.Name = "Skin"
	img.BackgroundTransparency = 1
	-- the picture keeps the left part and the amount sits beside it, never on the word (+25 covered OPEN, Studio #187)
	img.Size = UDim2.fromScale(0.68, 1)
	img.Image = k.Image
	img.ImageRectOffset = Vector2.new(r[1], r[2])
	img.ImageRectSize = Vector2.new(r[3], r[4])
	img.ScaleType = Enum.ScaleType.Fit
	img.ZIndex = 0
	img.Parent = b
	tag(b, "+" .. reward, T.Body, { Name = "Amount", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromScale(0.3, 0.7), ZIndex = 3 })
end

local function render()
	if not isOpen or not body or not body.Parent then
		return
	end
	for _, c in body:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local prof = State.Profile
	local daily = prof and prof.Daily
	if not daily then
		UI.loadingState(body, "Loading daily quests")
		return
	end
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	-- Daily gift: title and OPEN on top, the seven days under it ---------------------------------------
	local gift = daily.Gift
	local short = shortScreen()
	-- the top row holds the OPEN button: at least 44 real px tall whatever the scale (UI.minTouch)
	local topH = math.max(48, UI.minTouch())
	local padY = if short then 5 else 8
	local stripH = if short then 54 else 80 -- the day tiles' row (about 50 px tiles on a short screen, 75 otherwise)
	local giftH = padY * 2 + topH + 6 + stripH -- 150 at the design size, ~124 on a short screen
	local gc = box(body, "Gift", PET.QuestBody, PET.QuestEdge, 3, { Size = UDim2.new(1, -6, 0, giftH), LayoutOrder = nextOrder() })
	HudArt.skin(gc, "daily_gift_box", giftH)
	PetStyle.pattern(gc, PET.QuestEdge, 0.82, 34, 540, giftH, 80)
	local gin = content(gc) -- pictures and layouts never share a parent (a layout would place the picture too)
	UI.pad(gin, 10, padY)
	UI.list(gin, Enum.FillDirection.Vertical, 6)
	local top = UI.frame(gin, { Name = "Top", Size = UDim2.new(1, 0, 0, topH), BackgroundTransparency = 1, LayoutOrder = 1 })
	-- placed by position, not a list layout: a word picture (HudArt.word) anchors on its label's centre line, which a
	-- list layout pushed half a line down, so the "Day 7" line showed behind the Day 1 / Day 2 tiles
	local titles = UI.frame(top, { Name = "Titles", Size = UDim2.fromScale(0.58, 1), BackgroundTransparency = 1, ClipsDescendants = true })
	-- the streak tag sits under the heading, or beside it on a short screen (the box has no second line there)
	local CHIP_H = if short then 26 else 24
	local gTitle = word(titles, "Daily Gift", T.Head + 4, {
		Name = "Title", Font = UI.Head, TextColor3 = BLUE, Outline = false,
		Size = if short then UDim2.fromScale(0.46, 1) else UDim2.fromScale(1, 0.55),
	})
	HudArt.word(gTitle)
	local streak = gift.Streak or 0
	if streak > 0 then
		-- the streak sits on a tilted yellow tag: star + "Streak N", the shield count and the gift multiplier (hidden at 0)
		local parts = { "Streak " .. streak }
		if (gift.Shields or 0) > 0 then
			table.insert(parts, "Shields " .. gift.Shields)
		end
		if (gift.Mult or 1) > 1 then
			table.insert(parts, "x" .. string.format("%.2g", gift.Mult))
		end
		-- white words with the dark outline at body size: the brown-on-orange caption was too faint at phone size
		local chipProps = if short
			then { Name = "StreakChip", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.47, 0, 0.5, 0), Size = UDim2.new(0.53, 0, 0, CHIP_H), Rotation = -2 }
			else { Name = "StreakChip", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 2, 1, 0), Size = UDim2.new(0.74, 0, 0, CHIP_H), Rotation = -2 }
		local chip, chipText = tag(titles, table.concat(parts, if short then " \u{b7} " else "  \u{b7}  "), T.Body, chipProps, true)
		chipText.Name = "StreakText"
		chipText.Size = UDim2.new(1, -32, 1, 0)
		chipText.Position = UDim2.fromOffset(26, 0)
		chipText.TextXAlignment = Enum.TextXAlignment.Left
		UI.icon(chip, "star", 16, { Name = "StreakIcon", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), ZIndex = chip.ZIndex + 1 })
	else
		HudArt.word(word(titles, "Day 7 is the big one!", T.Small, {
			Name = "Sub", Font = UI.Bold, TextColor3 = NAVY, Outline = false,
			Position = if short then UDim2.fromScale(0.47, 0) else UDim2.fromScale(0, 0.58),
			Size = if short then UDim2.fromScale(0.53, 1) else UDim2.fromScale(1, 0.42),
		}))
	end
	local bProps = { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromScale(0.4, 1), TextSize = T.Head }
	if gift.Ready then
		local open: TextButton
		open = UI.button(top, "OPEN +" .. gift.Reward, "gold", function()
			giftAsked = true
			Juice.coinSource(open) -- the gift's coins fly from here once the server pays
			shop("ClaimGift")
		end, bProps)
		open.Name = "ClaimGift"
		openPicture(open, gift.Reward)
		Juice.pulse(open, nil, T.Radius) -- ready to open: a soft glow breathes round it
		Juice.shake(open) -- the gift waits: a little shake every couple of seconds
	else
		-- a friendly countdown, not a dead grey button: the yellow tag with a clock and dark words
		local nextPill, nextText = tag(top, "Next gift in " .. untilText(daily.NextReset), T.Body, { Name = "Next", AnchorPoint = bProps.AnchorPoint, Position = bProps.Position, Size = UDim2.fromScale(0.4, 0.86), Rotation = -2 }, true)
		UI.icon(nextPill, "clock", 24, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), ZIndex = nextPill.ZIndex + 1 })
		nextText.Position = UDim2.fromOffset(36, 0)
		nextText.Size = UDim2.new(1, -42, 1, 0)
		if giftAsked then
			-- the server took the claim: the box pops with confetti
			giftAsked = false
			UI.pop(gc, 1.06)
			task.defer(Juice.confetti, gc, 22)
		end
	end
	-- the 7 streak days: one row of equal glossy blue tiles. Claimed days grey with a big tick, today's claimable day a
	-- green ring with TODAY on it, day 7 marked only by its gold colour and a star (Studio: day 7 sat taller and
	-- day 1 was gold like day 7, so the current day was unclear)
	local strip = UI.frame(gin, { Name = "Days", Size = UDim2.new(1, 0, 0, stripH), BackgroundTransparency = 1, LayoutOrder = 2 })
	local sl = UI.list(strip, Enum.FillDirection.Horizontal, 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	sl.Padding = UDim.new(0.008, 0)
	local n = #gift.Rewards
	local W = (1 - 0.008 * math.max(n - 1, 0)) / math.max(n, 1) - 0.002 -- every day the same width, gaps included
	for i, coins in gift.Rewards do
		local isNext = i == gift.StreakDay
		local today = isNext and gift.Ready
		local done = i < gift.StreakDay or (not gift.Ready and isNext)
		local last = i == n
		local tile = box(strip, "Day" .. i, if done then TC.Disabled elseif last then PET.Tag else PET.Blue, if done then TC.GrayDeep elseif last then PET.TagEdge else PET.BlueEdge, 2.5, {
			LayoutOrder = i, Size = UDim2.fromScale(W, 0.94),
		})
		local tin = content(tile)
		if not done then
			HudArt.skin(tile, if last then "tile_cream" else "tile_blue", 92) -- claimed days keep the plain grey tile
			PetStyle.vgrad(tile, if last then PET.Gold:Lerp(PET.White, 0.3) else PET.BlueTop, if last then PET.Tag else PET.Blue)
		end
		UI.pad(tin, 2, 3)
		UI.list(tin, Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		-- an upright phone's tiles are too narrow for "Day 2" at the 14 px text floor: the number alone (today keeps its
		-- green colour and ring)
		local dayText = if UI.isPortrait() then tostring(i) elseif today then "TODAY" else "Day " .. i
		-- white outlined words on the blue tile (dark words on the gold day 7 and the grey claimed tiles)
		local dark = last or done
		-- day word and amount at body / heading size (fitted, never under the shared floor); a short screen's ~50 px
		-- tile has no room for the coin picture between them
		word(tin, dayText, T.Body, {
			Name = "Day", Font = if today then UI.Head else UI.Bold, TextColor3 = if today then PET.LimeTop elseif dark then NAVY else PET.White, Outline = if dark then false else "Normal",
			Size = UDim2.fromScale(1, if short then 0.42 else 0.24), LayoutOrder = 1, TextXAlignment = Enum.TextXAlignment.Center,
		})
		local coin: GuiObject? = nil
		-- day 7 also banks a free Rare Egg (LaunchPerks.StreakEgg): the egg takes the coin picture's place with a
		-- small "RARE EGG" ribbon over its foot, so the tile reads "Day 7: 300 coins + Rare Egg"
		local freeEgg = LaunchPerks.streakEgg(i) ~= nil
		if not short then
			if freeEgg then
				local eggBox = UI.frame(tin, { Name = "EggBox", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 0.4), LayoutOrder = 2 })
				local ar = Instance.new("UIAspectRatioConstraint")
				ar.AspectRatio = 1
				ar.Parent = eggBox
				streakEgg(eggBox, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromScale(1.25, 1.25), ZIndex = tile.ZIndex + 2 })
				coin = eggBox
			else
				local c = HudArt.image(tin, "Coin", 28, { Size = UDim2.fromScale(1, 0.4), LayoutOrder = 2 })
				local ar = Instance.new("UIAspectRatioConstraint")
				ar.AspectRatio = 1
				ar.Parent = c
				coin = c
			end
		end
		if short and freeEgg then
			-- a short screen's tile has no picture row: the egg sits beside the amount ("300 [egg]")
			local line = UI.frame(tin, { Name = "CoinsLine", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 0.56), LayoutOrder = 3 })
			word(line, tostring(coins), T.Head, {
				Name = "Coins", Font = UI.Head, TextColor3 = if dark then NAVY else PET.White, Outline = if dark then false else "Normal",
				Size = UDim2.new(1, -26, 1, 0), TextXAlignment = Enum.TextXAlignment.Center,
			})
			local eggBox = UI.frame(line, { Name = "EggBox", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(26, 26) })
			streakEgg(eggBox, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.5, 1.5), ZIndex = tile.ZIndex + 2 })
		else
			word(tin, tostring(coins), T.Head, {
				Name = "Coins", Font = UI.Head, TextColor3 = if dark then NAVY else PET.White, Outline = if dark then false else "Normal",
				Size = UDim2.fromScale(1, if short then 0.56 else 0.34), LayoutOrder = 3, TextXAlignment = Enum.TextXAlignment.Center,
			})
		end
		if freeEgg and not short then
			-- the ribbon hangs over the egg's foot (inside the tile: anything over its edge gets clipped by the gift box).
			-- An upright phone's tile is too narrow for "RARE EGG" at the text floor: "+EGG" there.
			-- (fitted text wraps when it cannot shrink further, so the word must fit the ~45 px upright tile: "EGG")
			local rb = PetStyle.ribbon(tile, if UI.isPortrait() then "EGG" else "RARE EGG", PET.Lime, {
				Name = "EggRibbon", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.58, 0), Size = UDim2.new(1, -4, 0, 16), Rotation = -4, ZIndex = tile.ZIndex + 3,
			})
			local rl = rb:FindFirstChildOfClass("TextLabel")
			if rl then
				rl.ZIndex = rb.ZIndex + 1
				rl.Position = UDim2.fromOffset(2, 0)
				rl.Size = UDim2.new(1, -4, 1, 0)
				UI.fit(rl, T.Tiny, T.MinText)
			end
		end
		if last and not done then
			-- the big day: a small star badge on the corner (colour and icon only, same size as the others)
			-- inside the tile beside the coin: hanging over the corner, the gift box clipped it to a stray dot (Studio check
			-- 2026-10-14), and the top corner covered "Day 7"
			UI.icon(tile, "star", 16, { Name = "Star", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -3, 0.45, 0), ZIndex = tile.ZIndex + 4 })
		end
		if today then
			-- the one to open now: a thick green ring over the tile (drawn on top so a tile picture never hides it)
			local ring = UI.frame(tile, { Name = "TodayRing", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = tile.ZIndex + 3 })
			UI.corner(ring, 12)
			UI.stroke(ring, PET.Lime, 4)
			if coin then
				Juice.shake(coin) -- today's coin waits to be opened
			end
		end
		if done then
			-- claimed: the tile greys out and a big green check sits over it (a tiny tick was easy to miss)
			for _, c in tin:GetDescendants() do
				if c:IsA("TextLabel") and c.Name == "Coins" then
					-- the check takes the amount's place; the label keeps its room so the day word stays at the top
					-- (hidden, the list centred the word under the check)
					c.TextTransparency = 1
					local o = c:FindFirstChild("Outline")
					if o and o:IsA("UIStroke") then
						o.Enabled = false
					end
				elseif c:IsA("TextLabel") then
					c.TextTransparency = 0.45
				elseif c:IsA("ImageLabel") then
					c.ImageTransparency = 0.55
				end
			end
			local big = UI.frame(tile, { Name = "Claimed", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = tile.ZIndex + 4 })
			-- the check sits below the day word, not over it (a 40 px check covered "Day 3" on a short screen's tile)
			local ck = UI.icon(big, "check", if short then 26 else 34, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, if short then 0.66 else 0.6), ZIndex = tile.ZIndex + 5 })
			local cr = Instance.new("UIAspectRatioConstraint")
			cr.AspectRatio = 1
			cr.Parent = ck
		end
	end

	-- Quests ---------------------------------------------------------------------------------------------
	local qh = UI.frame(body, { Name = "QuestsTitle", Size = UDim2.new(1, -6, 0, if short then 30 else 34), BackgroundTransparency = 1, LayoutOrder = nextOrder() })
	local qt = word(qh, "Today's Quests", T.Head + 4, { Name = "Title", Font = UI.Head, TextColor3 = BLUE, Outline = false, Size = UDim2.fromScale(0.5, 1) })
	HudArt.word(qt)
	-- right of the title: when the quests renew (an empty unlabelled bar sat here before, Studio report)
	UI.icon(qh, "clock", 22, { Name = "ResetIcon", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.5, 6, 0.5, 0) })
	word(qh, "New quests in " .. untilText(daily.NextReset), T.Body, {
		Name = "Reset", Font = UI.Bold, TextColor3 = NAVY, Outline = false, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.new(0.5, -34, 0, 26), TextXAlignment = Enum.TextXAlignment.Right,
	})
	for i, q in daily.Quests do
		local row = box(body, "Quest" .. i, PET.QuestBody, PET.QuestEdge, 3, { Size = UDim2.new(1, -6, 0, 64), LayoutOrder = nextOrder() })
		HudArt.skin(row, "quest_row", 64)
		local rin = content(row)
		UI.pad(rin, 12, 8)
		-- left: name over the bar and count; right: the reward button
		local info = UI.frame(rin, { Name = "Info", Size = UDim2.fromScale(0.66, 1), BackgroundTransparency = 1 })
		UI.list(info, Enum.FillDirection.Vertical, 4)
		word(info, q.Text, T.Head, { Name = "Text", Font = UI.Bold, TextColor3 = NAVY, Outline = false, Size = UDim2.fromScale(1, 0.5), LayoutOrder = 1 })
		local line = UI.frame(info, { Name = "Line", Size = UDim2.fromScale(1, 0.42), BackgroundTransparency = 1, LayoutOrder = 2 })
		-- the count sits right after the bar's end on the same centre line (it floated off at the row's far edge,
		-- Studio #187): bar and count share one fixed split
		local COUNT_W = 64
		local track, fill = UI.bar(line, { Name = "Progress", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, -(COUNT_W + 6), 0, 16) }, if q.Done then TC.Green else BAR)
		fill.Size = UDim2.fromScale(math.clamp(q.Progress / math.max(q.Goal, 1), 0, 1), 1)
		track.BackgroundColor3 = PET.White -- light track so an empty bar reads empty
		UI.stroke(track, PET.QuestEdge, 2)
		HudArt.skin(track, "bar_track", 16)
		if not q.Done then
			HudArt.skin(fill, "bar_fill", 16)
		end
		word(line, q.Progress .. "/" .. q.Goal, T.Body, {
			Name = "Count", Font = UI.Head, TextColor3 = NAVY, Outline = false, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.new(0, COUNT_W, 0, 22), TextXAlignment = Enum.TextXAlignment.Left,
		})
		local cProps = { Name = "Claim", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromScale(0.31, 0.92), TextSize = T.Body + 2 }
		-- three clearly different states: claimed = dim green CLAIMED, claimable = bright green CLAIM with a pulsing
		-- glow, locked = grey with a lock and the progress (the old dimmed gold read brown, much like the claimable one)
		if q.Claimed then
			local b = UI.button(rin, "CLAIMED", "gold", nil, cProps)
			UI.setEnabled(b, false, "gold")
			b:SetAttribute("Disabled", false) -- keep the green (claimed), it still takes no taps (no onClick)
			UI.paint(b)
			oneLine(b)
			b.BackgroundTransparency = 0.5
			local cl = b:FindFirstChild("Label") :: TextLabel?
			if cl then
				cl.TextTransparency = 0.3
			end
			if questAsked[i] then
				-- the server paid it: a stamp on the button and a burst of coins
				questAsked[i] = nil
				Juice.stamp(b)
				-- after the rebuilt row has been laid out: a deferred call still saw the new button at the list's
				-- origin, so the coins and "+80" flew off from the panel's left edge instead of from this button
				task.delay(0.1, function()
					if b.Parent and b.AbsoluteSize.X > 0 then
						Juice.coins(b, 8)
						Juice.floatText(b, "+" .. q.Reward .. " COINS", TC.Cash)
					end
				end)
			end
		elseif q.Done then
			local b: TextButton
			b = UI.button(rin, "CLAIM +" .. q.Reward, "gold", function()
				questAsked[i] = true
				Juice.coinSource(b) -- the coins fly from here once the server pays
				shop("ClaimQuest", i)
			end, cProps)
			HudArt.skin(b, "btn_green", 64)
			oneLine(b)
			Juice.shake(b)
			Juice.pulse(b, nil, T.Radius) -- a claimable reward breathes a soft glow
		else
			-- the reward, not the progress again (the bar beside it already shows "0/30")
			local b = UI.button(rin, "+" .. q.Reward, "gray", nil, cProps)
			HudArt.skin(b, "btn_grey", 64)
			UI.setEnabled(b, false, "gray")
			oneLine(b)
			-- a lock left of the reward, the reward takes the rest of the button
			UI.icon(b, "lock", 18, { Name = "Lock", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), ZIndex = b.ZIndex + 1 })
			local ll = b:FindFirstChild("Label") :: TextLabel?
			if ll then
				ll.Position = UDim2.fromOffset(28, 3)
				ll.Size = UDim2.new(1, -34, 1, -6)
			end
		end
	end
	word(body, "Quests renew at midnight UTC. Rewards are coins.", T.Small, {
		Name = "ResetNote", Font = UI.Bold, TextColor3 = NAVY, Outline = false, LayoutOrder = nextOrder(), Size = UDim2.new(1, -6, 0, 22), TextXAlignment = Enum.TextXAlignment.Center,
	})
end

function QuestPanel.open()
	QuestPanel.start()
	local moreH = if not UI.isPortrait() and UI.Logical.Y < 395 then MORE_H_TIGHT else MORE_H
	local h = if UI.isPortrait() then 600 else 480
	local panel, b, close, footer = UI.modal("Quests", "DAILY", Vector2.new(560, h), { Cash = true, Footer = moreH })
	local _ = close
	PanelSkin.dress(panel, "Calendar", "DAILY")
	body = b
	isOpen = true
	openPanel = panel
	local gap = if shortScreen() then 6 else 8
	local listLayout = UI.list(b, Enum.FillDirection.Vertical, gap)
	if b:IsA("ScrollingFrame") then
		-- the canvas is measured from the list (+ one card gap), so the last quest card always scrolls fully into view
		UI.fitCanvas(b :: ScrollingFrame, listLayout, gap)
	end
	-- the quest list scrolls on short screens: a solid scroll bar and a "more below" tag until the end is in view
	if b:IsA("ScrollingFrame") and footer then
		local sc = b :: ScrollingFrame
		-- the list gives the footer strip back when nothing is left below (the button hides then)
		local short = sc.Size
		local full = UDim2.new(short.X.Scale, short.X.Offset, short.Y.Scale, short.Y.Offset + moreH)
		-- a real button, not a small tag: tapping it scrolls the quests into view (#232: the tag alone went unnoticed)
		-- below the list in the modal's footer strip, so it never covers a quest row
		local more = UI.button(footer, "MORE QUESTS", "blue", function()
			local target = Vector2.new(0, math.max(0, sc.AbsoluteCanvasSize.Y - sc.AbsoluteWindowSize.Y) / math.max(UI.Scale, 0.01))
			if UI.Reduced then
				sc.CanvasPosition = target
			else
				TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CanvasPosition = target }):Play()
			end
		end, {
			Name = "MoreHint", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(190, if moreH == MORE_H_TIGHT then 30 else 40), TextSize = T.Body + 1,
		})
		-- hint() resizes the scroller, which re-fires AbsoluteWindowSize; a guard keeps it to one pass per change
		-- (Studio: "Maximum event re-entrancy depth exceeded", and the list came up empty)
		local hinting = false
		local function hint()
			if hinting then
				return
			end
			hinting = true
			local below = sc.CanvasPosition.Y + sc.AbsoluteWindowSize.Y < sc.AbsoluteCanvasSize.Y - 6
			more.Visible = below
			local want = if below then short else full
			-- the window ends on a whole row (a card cut mid-way looked broken, Studio check 2026-10-14): measured from
			-- the window it would have at `want`, the freed strip stays as bottom padding
			local cut = if sc.AbsoluteWindowSize.Y > 0 then rowCut(sc, want.Y.Offset - sc.Size.Y.Offset) else 0
			local size = UDim2.new(want.X.Scale, want.X.Offset, want.Y.Scale, want.Y.Offset - cut)
			if sc.Size ~= size then
				sc.Size = size
			end
			hinting = false
		end
		sc:GetPropertyChangedSignal("CanvasPosition"):Connect(hint)
		sc:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(hint)
		sc:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(hint)
		hint()
		task.delay(0.2, hint) -- after the first render has filled the list
	end
	if State.Profile then
		UI.modalCash(State.Profile.Cash)
	end
	-- A closing panel is destroyed after its close tween (~0.2 s); reopening inside that window made the old
	-- panel's Destroying clear isOpen for the new one (audit 28), so only the current panel may close it.
	panel.Destroying:Connect(function()
		if openPanel == panel then
			isOpen = false
			openPanel = nil
		end
	end)
	panel.AncestryChanged:Connect(function()
		if openPanel == panel and not panel:IsDescendantOf(game) then
			isOpen = false
			openPanel = nil
		end
	end)
	render()
end

function QuestPanel.start()
	if started then
		return
	end
	started = true
	State.Changed.Event:Connect(function(what)
		if what == "Profile" and isOpen and UI.modalOpen() == "Quests" then
			if State.Profile then
				UI.modalCash(State.Profile.Cash)
			end
			render()
		end
	end)
end

return QuestPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="371">
            <Properties>
              <string name="Name">RareBanner</string>
              <string name="Source"><![CDATA[--!strict
-- Rare hatch banner (owner pick). The server (RareHatch) sends ("Local" | "Global", { Name, Pet, Rarity }):
--   Local  - someone in THIS server hatched a Rare+ pet: screen fireworks and a gold banner.
--   Global - a Rare+ hatch in another server (MessagingService): the same gold banner, no fireworks.
-- Banners queue (at most Config.RareHatch.QueueMax waiting, extras are dropped) and each shows for BannerSeconds.
-- Low Effects: two small bursts instead of five; Reduce Motion: no fireworks, the banner just appears. Cosmetic only.
-- A Legendary Local hatch also washes the world gold for 3 s for everyone here (HatchFx.goldSky; Lighting untouched).

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local PetFlair = require(Shared.PetFlair)
local SafeZones = require(Shared.SafeZones)
local UserInputService = game:GetService("UserInputService")
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local PetStyle = require(script.Parent.PetStyle)
local State = require(script.Parent.Parent.State)
local Audio = require(script.Parent.Parent.Audio)
local HatchFx = require(script.Parent.Parent.HatchFx)
local Juice = require(script.Parent.Juice)

local RareBanner = {}

local T = UI.T
local K = Theme.Pet
local cfg = Config.RareHatch

type Item = { Kind: string, P: PetFlair.Payload }
local queue: { Item } = {}
local showing = false
local rng = Random.new()

local function settings(): { [string]: any }
	return (State.Profile and State.Profile.Settings) or {}
end

local function holder(): Frame
	local layer = UI.noticeLayer()
	local f = layer:FindFirstChild("RareBannerLayer") :: Frame?
	if f then
		return f
	end
	local nf = Instance.new("Frame")
	nf.Name = "RareBannerLayer"
	nf.BackgroundTransparency = 1
	nf.Size = UDim2.fromScale(1, 1)
	nf.ZIndex = 40
	nf.Parent = layer
	return nf
end

-- One firework: a ring of small squares flying out from a point and fading.
local function burst(parent: Frame, at: UDim2, color: Color3, count: number)
	for i = 1, count do
		local a = (i / count) * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local d = rng:NextNumber(50, 90)
		local s = rng:NextInteger(6, 10)
		local dot = Instance.new("Frame")
		dot.Name = "Spark"
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Position = at
		dot.Size = UDim2.fromOffset(s, s)
		dot.BorderSizePixel = 0
		dot.BackgroundColor3 = if i % 3 == 0 then K.White else color
		dot.Rotation = 45
		dot.ZIndex = 41
		dot.Parent = parent
		local goal = at + UDim2.fromOffset(math.cos(a) * d, math.sin(a) * d + 18)
		local tw = TweenService:Create(dot, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = goal, BackgroundTransparency = 1, Size = UDim2.fromOffset(2, 2),
		})
		tw:Play()
		task.delay(1, function()
			dot:Destroy()
		end)
	end
end

local function fireworks(parent: Frame, rarity: string)
	local s = settings()
	if s.ReducedMotion == true then
		return
	end
	local low = s.LowEffects == true
	local bursts = if low then 2 else 5
	local per = if low then 8 else 14
	-- the rarity's colour, then the pet palette: gold, ribbon pink, the HUD cyan
	local colors = { (Config.RarityColors :: any)[rarity] or K.Gold, K.Gold, K.RibbonPink, K.CyanTop }
	for b = 1, bursts do
		task.delay((b - 1) * 0.28, function()
			if parent.Parent then
				local at = UDim2.new(rng:NextNumber(0.15, 0.85), 0, rng:NextNumber(0.12, 0.45), 0)
				burst(parent, at, colors[(b - 1) % #colors + 1], per)
			end
		end)
	end
end

local function build(parent: Frame, item: Item): Frame
	local p = item.P
	local portrait = UI.isPortrait()
	-- landscape: in the gap between the left HUD column (cash, DAILY, PLAY) and the right tiles, so no button is covered
	local w = if portrait then math.min(360, UI.Logical.X - 24) else math.min(440, UI.Logical.X * 0.5)
	local pos = if portrait then UDim2.new(0.5, 0, 0.43, 0) else UDim2.new(0.56, 0, 0, 58)
	if not portrait and SafeZones.compactLobby(UI.Logical.X, UI.Logical.Y, UserInputService.TouchEnabled) then
		-- landscape phone: the lobby buttons sit in one row at the top left (SafeZones.lobbyLayout), so the banner
		-- goes in the gap between that row and the right tiles, or under the row when the gap is too thin
		local L = SafeZones.lobbyLayout(UI.Logical.X, UI.Logical.Y, UserInputService.TouchEnabled, 172)
		local rowRight = 14 + SafeZones.rowWidth(L, 6) + 20
		local tilesLeft = UI.Logical.X - 150
		if tilesLeft - rowRight >= 240 then
			w = math.min(440, tilesLeft - rowRight)
			pos = UDim2.fromOffset(math.floor((rowRight + tilesLeft) / 2), 58)
		else
			w = math.min(440, UI.Logical.X * 0.5)
			pos = UDim2.new(0.5, 0, 0, 14 + 40 + 6 + L.CellH + 16)
		end
	end
	local banner = Instance.new("Frame")
	banner.Name = "RareBanner"
	-- portrait: below the notice stack (top) and the HUD counters; landscape: just under the top buttons
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Position = pos
	banner.Size = UDim2.fromOffset(w, if portrait then 78 else 66)
	-- the pet-style gold tag: glossy gold (lighter top), the tag's dark gold edge, white outlined Fredoka words
	banner.BackgroundColor3 = K.Tag
	banner.BorderSizePixel = 0
	banner.ZIndex = 42
	banner.Parent = parent
	PetStyle.round(banner, T.RadiusLg)
	PetStyle.edge(banner, K.TagEdge, 3)
	PetStyle.vgrad(banner, K.Gold:Lerp(K.White, 0.3), K.Tag)
	banner:SetAttribute("Style", "gold") -- the glint sweeps across it like a gold button
	UI.shine(banner)
	task.defer(Juice.rays, banner, K.Gold, 2.2)
	local what = if p.Rarity == "Legendary" then "LEGENDARY" elseif PetFlair.isShinyName(p.Pet) then "SHINY" else "RARE"
	local head = if item.Kind == "Local" then what .. " HATCH!" else what .. " HATCH IN ANOTHER SERVER"
	PetStyle.words(banner, head, T.Small, {
		Name = "Head", OutlineColor = K.TagEdge, OutlineThick = 2,
		TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 18), ZIndex = 43,
	})
	PetStyle.words(banner, PetFlair.bannerLine(p), T.Head, {
		Name = "Line", OutlineColor = K.TagEdge, OutlineThick = 2.6,
		TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(10, 22), Size = UDim2.new(1, -20, 1, -26), ZIndex = 43,
	})
	return banner
end

-- Legendary hatch here (idea 10): one big full-screen flash for everyone in the server, white then the rainbow, and
-- the sparkle sound. Never with Reduced Motion (the gold sky and banner still show).
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 120)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 210, 70)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(110, 230, 120)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 180, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 120, 255)),
})
local function megaFlash(parent: Instance)
	Audio.play("HatchSparkle")
	if settings().ReducedMotion == true then
		return
	end
	local f = Instance.new("Frame")
	f.Name = "LegendaryFlash"
	f.Size = UDim2.fromScale(1, 1)
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BackgroundTransparency = 0.15
	f.ZIndex = 40
	f.Parent = parent
	local g = Instance.new("UIGradient")
	g.Color = RAINBOW
	g.Rotation = 35
	g.Enabled = false
	g.Parent = f
	task.delay(0.12, function()
		g.Enabled = true
		f.BackgroundTransparency = 0.35
		TweenService:Create(g, TweenInfo.new(0.9), { Rotation = 215 }):Play()
		TweenService:Create(f, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
	end)
	task.delay(1.2, function()
		f:Destroy()
	end)
end

local function pump()
	if showing then
		return
	end
	local item = table.remove(queue, 1)
	if not item then
		return
	end
	showing = true
	local parent = holder()
	if item.Kind == "Local" then
		fireworks(parent, item.P.Rarity)
		if item.P.Rarity == "Legendary" then
			megaFlash(parent)
			HatchFx.goldSky(3) -- everyone in this server sees the world wash gold for a moment
		end
	end
	Audio.play("RarityAccent")
	local banner = build(parent, item)
	if settings().ReducedMotion ~= true then
		local goal = banner.Position
		banner.Position = goal - UDim2.fromOffset(0, 40)
		TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = goal }):Play()
	end
	task.delay(cfg.BannerSeconds, function()
		banner:Destroy()
		showing = false
		pump()
	end)
end

function RareBanner.show(kind: string, data: any)
	if kind ~= "Local" and kind ~= "Global" or type(data) ~= "table" then
		return
	end
	local p = PetFlair.payload(data.Name, data.Pet, data.Rarity)
	if not p then
		return
	end
	if #queue >= cfg.QueueMax then
		return
	end
	local item: Item = { Kind = kind :: string, P = p }
	table.insert(queue, item)
	pump()
end

local started = false
function RareBanner.start()
	if started then
		return
	end
	started = true
	Net.event("RareHatch").OnClientEvent:Connect(RareBanner.show)
end

return RareBanner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="372">
            <Properties>
              <string name="Name">ResultsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Geode reveal and RESULTS (board 10).
-- Reveal: RevealView plays the sequence and owns the screen (UI.block).
-- Results: the SAME specimen on the left; the real winner (avatar, crown), the local player's own hunt figures
-- (rubble earned, rocks cracked, rubble sold, storage now: HuntLedger numbers, never recomputed), and the specimen
-- line only for the recipient ("Geode added to collection" once the profile holds it). Others read who found it.
-- PLAY AGAIN follows the existing rematch rules (the leader starts once everyone tapped it; members mark ready),
-- LOBBY returns through the existing flow.
-- Polish: the pet stands on a gold winner's podium in the hero view, confetti falls once when the card opens, and a
-- bouncing "NEW!" sticker marks the recipient's first ever pet of that species and rarity (Pet Book count of 1).

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local GeodeGen = require(Shared.GeodeGen)
local Net = require(Shared.Net)
local ResultsRules = require(Shared.ResultsRules)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local PanelSkin = require(script.Parent.PanelSkin)
local Theme = require(script.Parent.Theme)
local PetStyle = require(script.Parent.PetStyle)
local GeodeView = require(script.Parent.GeodeView)
local RevealView = require(script.Parent.Parent.RevealView)
local Effects = require(script.Parent.Parent.Effects)

local T = UI.T
local TC = Theme.Color
local K = Theme.Pet
local player = Players.LocalPlayer
local Results = {}

local resultsOpen = false
local body: Frame? = nil
local footer: Frame? = nil
local panelRef: Frame? = nil

Results.OnTutorialAction = nil :: ((string) -> ())? -- set by Main: "Train" (open the TRAIN card back in the lobby)
Results.OnOpenPet = nil :: ((string) -> ())? -- set by Main: opens the Pet Book on that pet

local function act(a: string)
	Net.event("MatchAction"):FireServer(a)
end

local function headline(res): string
	if res.Kind == "Tutorial" then
		return "PRACTICE HUNT DONE!"
	elseif res.Winner == player.UserId and res.Kind ~= "Solo" then
		return "YOU FOUND IT!"
	end
	return "PET HATCHED!"
end
Results.headline = headline

function Results.reveal(res)
	UI.closeModal()
	local text = if res.Kind == "Tutorial" then "YOU FOUND THE PET!" elseif res.Kind == "Solo" then "HATCHED A PET!" elseif res.Winner == player.UserId then "YOU HATCHED A PET!" else string.upper(res.WinnerName or "?") .. " HATCHED A PET!"
	RevealView.play(res, text, res.Winner == player.UserId) -- the practice pet is yours too: "You hatched ...!" + confetti
end

local stickerShown: { [any]: boolean } = {} -- spec ids whose NEW! sticker already bounced in (re-renders stay still)
local confettiFor: any = nil -- the results table the confetti already fell for

-- A gold two-step podium under the pet (inside the model, so a drag turns it too), then the camera re-fits both.
-- Pet palette gold on top, the deeper gold of the buttons' edge below.
local function podium(model: Model, cam: Camera)
	local cf, size = model:GetBoundingBox()
	local w = math.max(size.X, size.Z)
	local h = math.max(size.Y * 0.22, 0.3)
	local baseY = cf.Position.Y - size.Y / 2
	local function disc(name: string, d: number, hh: number, y: number, color: Color3)
		local p = Instance.new("Part")
		p.Name = name
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(hh, d, d)
		p.CFrame = CFrame.new(cf.Position.X, y, cf.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
		p.Anchored = true
		p.CanCollide = false
		p.Material = Enum.Material.SmoothPlastic
		p.Color = color
		p.Parent = model
	end
	disc("PodiumTop", w * 1.15, h, baseY - h / 2, K.Gold)
	disc("PodiumBase", w * 1.4, h * 0.6, baseY - h - h * 0.3, TC.GoldDeep)
	GeodeView.frame(cam, model)
end

-- First pet of this species and rarity in the player's Pet Book (the server counts it before the results arrive).
local function firstOfKind(prof: any, spec: any): boolean
	if type(prof) ~= "table" or type(prof.DiscoveryRarity) ~= "table" or type(spec) ~= "table" then
		return false
	end
	local row = prof.DiscoveryRarity[spec.Mineral]
	return type(row) == "table" and row[spec.Rarity] == 1
end

local function newSticker(parent: Instance, key: any)
	-- the pet-style ribbon tag (red pill, ink edge, white outlined words), tilted like the shop's "LIMITED!"
	local tag = PetStyle.ribbon(parent, "NEW!", K.Red, {
		Name = "NewSticker", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(42, 22), Size = UDim2.fromOffset(66, 28),
		Rotation = -12, ZIndex = 4,
	})
	PetStyle.vgrad(tag, K.RedTop, K.Red)
	local tagWords = tag:FindFirstChildOfClass("TextLabel")
	if tagWords then
		tagWords.TextSize = T.Small
	end
	if stickerShown[key] or UI.Reduced then
		return
	end
	stickerShown[key] = true
	local sc = Instance.new("UIScale")
	sc.Scale = 0
	sc.Parent = tag
	local pop = TweenService:Create(sc, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	pop.Completed:Connect(function()
		if sc.Parent then
			TweenService:Create(sc, TweenInfo.new(0.22, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 3, true), { Scale = 1.15 }):Play()
		end
	end)
	pop:Play()
end

-- When the results opened: how long the specimen has been "securing" without showing in the collection.
local openedAt = 0
local SECURE_WAIT = 8

local function tileStat(parent: Instance, order: number, name: string, icon: string, label: string, value: string, color: Color3?): TextLabel
	local f = UI.card(parent, "inset", { Name = name, LayoutOrder = order, Size = UDim2.new(0.5, -3, 0, 58) })
	UI.text(f, label, { Name = "Label", Font = UI.Bold, TextSize = T.Small, Outline = "Normal", Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 21) })
	UI.icon(f, icon, 26, { Position = UDim2.fromOffset(8, 26) })
	local v = UI.text(f, value, { Name = "Value", Font = UI.Head, TextSize = T.Head + 2, TextColor3 = color or TC.Text, Position = UDim2.fromOffset(40, 23), Size = UDim2.new(1, -46, 0, 30) })
	v.TextWrapped = false
	return v
end

-- The two score tiles count up from 0 once per results table (re-renders show the final number at once).
local countedFor: any = nil
local function countTile(label: TextLabel, n: number, delay: number)
	if UI.Reduced or n <= 0 then
		return
	end
	label.Text = "0"
	task.delay(delay, function()
		if label.Parent then
			UI.countUp(label, 0, n, 0.7)
		end
	end)
end

local glow: (GuiButton) -> () -- defined below render (PLAY AGAIN glow)
local function render()
	if not resultsOpen or not body or not footer then
		return
	end
	local b = body :: Frame
	local foot = footer :: Frame
	for _, c in b:GetChildren() do
		if not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
	for _, c in foot:GetChildren() do
		if not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
	local res = State.Results
	local m = State.Match
	local prof = State.Profile
	if not res or not m then
		UI.loadingState(b, "Loading results", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		return
	end
	local spec = res.Specimen
	local won = res.Winner == player.UserId
	local mine
	for _, mem in res.Members do
		if mem.UserId == player.UserId then
			mine = mem
		end
	end
	local portrait = UI.isPortrait()

	-- left: the specimen (opening faces the camera), its name and rarity
	local hero = UI.card(b, "inset", { Name = "Hero", Size = if portrait then UDim2.new(1, 0, 0, 170) else UDim2.new(0.42, -4, 1, 0) })
	local _, model, heroCam = GeodeView.make(hero, spec, { Name = "Specimen", Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -30) }, true)
	model:PivotTo(CFrame.new())
	podium(model, heroCam)
	local nm = UI.text(hero, GeodeGen.displayName(spec) .. " \u{b7} " .. spec.Rarity, { Name = "SpecimenName", Font = UI.Bold, TextSize = T.Body, TextColor3 = Config.RarityTextColors[spec.Rarity] or TC.Text, Outline = "Normal", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 6, 1, -4), Size = UDim2.new(1, -12, 0, 20), TextXAlignment = Enum.TextXAlignment.Center })
	nm.TextWrapped = false

	-- right: winner, recipient line, own figures
	-- scrolls when the facts (tutorial stage, payout, others, rematch note) outgrow a short phone
	local col = UI.scroller(b, { Name = "Facts", VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar, Position = if portrait then UDim2.fromOffset(0, 178) else UDim2.new(0.42, 4, 0, 0), Size = if portrait then UDim2.new(1, 0, 1, -178) else UDim2.new(0.58, -4, 1, 0) })
	UI.list(col, Enum.FillDirection.Vertical, 6)
	local who = UI.card(col, "inset", { Name = "Winner", LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 58) })
	UI.text(who, if res.Kind == "Solo" or res.Kind == "Tutorial" then "Solo find:" else "Winner:", { Font = UI.Bold, TextSize = T.Small, Outline = "Normal", Position = UDim2.fromOffset(10, 2), Size = UDim2.new(1, -20, 0, 21) })
	UI.icon(who, "crown", 24, { Position = UDim2.fromOffset(10, 26) })
	if type(res.Winner) == "number" and res.Winner > 0 then
		local av = UI.frame(who, { Name = "Avatar", Position = UDim2.fromOffset(40, 23), Size = UDim2.fromOffset(30, 30), BackgroundColor3 = TC.Panel })
		UI.corner(av, 6)
		UI.stroke(av, K.CardEdge, 1.5)
		UI.icon(av, "user", 24, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		img.Image = "rbxthumb://type=AvatarHeadShot&id=" .. res.Winner .. "&w=48&h=48"
		img.Parent = av
	end
	local wn = UI.text(who, (res.WinnerName or "?") .. (if won then " (You)" else ""), { Name = "WinnerName", Font = UI.Head, TextSize = T.Head, Position = UDim2.fromOffset(78, 22), Size = UDim2.new(1, -86, 0, 32) })
	wn.TextWrapped = false
	wn.TextTruncate = Enum.TextTruncate.AtEnd

	-- the specimen line: only the recipient hears about the collection
	local line, lineColor, lineIcon = "", TC.Muted, "info"
	if won and res.Kind ~= "Tutorial" then
		local have = false
		if prof then
			for _, g in prof.Inventory do
				if g.Id == spec.Id then
					have = true
					break
				end
			end
		end
		local waited = os.clock() - openedAt
		if have then
			line, lineColor, lineIcon = "Pet added to your Pet Book!", TC.Green, "check"
			if firstOfKind(prof, spec) then
				newSticker(hero, spec.Id)
			end
			if prof and prof.SavesOff then
				line = "Added (saves are off: not kept after you leave)"
			end
		elseif waited < SECURE_WAIT then
			line, lineColor, lineIcon = "Hatching your pet\u{2026}", TC.Muted, "clock"
			task.delay(SECURE_WAIT - waited + 0.1, render)
		else
			line, lineColor, lineIcon = "Recorded: added the next time you join.", TC.Warn, "clock"
		end
	elseif res.Kind == "Tutorial" then
		-- the practice ends when the geode is found, not when the pile is empty
		line, lineColor, lineIcon = "Practice complete: pet hatched!", TC.Green, "check"
	elseif not won then
		local sp = spec
		local petName = if type(sp) == "table" and sp.Rarity and sp.Mineral then sp.Rarity .. " " .. (Config.Minerals[sp.Mineral] and Config.Minerals[sp.Mineral].Name or "Pet") else "Pet"
		local shells = if mine then " +" .. tostring(mine.RubbleEarned) .. " candy" else ""
		line, lineIcon = (res.WinnerName or "?") .. " hatched a " .. petName .. "! Better luck next egg!" .. shells, "info"
		local prize = mine and mine.Prize
		if type(prize) == "table" and type(prize.Medal) == "string" then
			-- prizes for everyone (shared/HuntFun.Prizes): the medal by eggs finished, already paid by the server
			line, lineColor, lineIcon = string.format("%s medal! +%d coins +%d pet XP", prize.Medal, tonumber(prize.Coins) or 0, tonumber(prize.Xp) or 0), TC.Gold, "crown"
		end
	end
	local rl = UI.frame(col, { Name = "Reward", BackgroundTransparency = 1, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 28) })
	if lineIcon == "check" and UI.OkPicture then
		-- "Pet added to your Pet Book!": the owner's green tick picture
		local img = Instance.new("ImageLabel")
		img.Name = "Icon"
		img.BackgroundTransparency = 1
		img.Image = UI.OkPicture
		img.ScaleType = Enum.ScaleType.Fit
		img.Size = UDim2.fromOffset(24, 24)
		img.Parent = rl
	else
		UI.icon(rl, lineIcon, 20, { Position = UDim2.fromOffset(2, 2) })
	end
	local seeW = if lineIcon == "check" and won and Results.OnOpenPet and spec and spec.Id then 64 else 0
	UI.text(rl, line, { Name = "RewardText", Font = UI.Bold, TextSize = T.Body, TextColor3 = lineColor, Outline = "Normal", Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -(28 + seeW), 1, 0) })
	if seeW > 0 then
		-- SEE opens the Pet Book on the new pet (the Results tile brings this screen back)
		local id = spec.Id
		UI.button(rl, "SEE", "blue", function()
			if Results.OnOpenPet then
				Results.OnOpenPet(id)
			end
		end, { Name = "SeePet", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(seeW - 12, 28), TextSize = T.Small + 1 }) -- inset: its rim poked past the row
	end
	if mine then
		-- HuntLedger numbers, never recomputed here: earned, sold and stored overlap, so they are never added up
		local tiles = UI.frame(col, { Name = "Tiles", BackgroundTransparency = 1, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 58) })
		UI.list(tiles, Enum.FillDirection.Horizontal, 6)
		local earned = tileStat(tiles, 1, "Earned", "rubble", "Candy earned:", tostring(mine.RubbleEarned), TC.Count)
		local cracked = tileStat(tiles, 2, "Cracked", "egg", "Eggs hatched:", tostring(mine.Processed), TC.Count)
		if countedFor ~= res then
			countedFor = res
			countTile(earned, tonumber(mine.RubbleEarned) or 0, 0.15)
			countTile(cracked, tonumber(mine.Processed) or 0, 0.3)
		end
	end
	-- at most ResultsRules.MaxLines rows (bug #227): Reward, one Stats row, Racers for party hunts; the bag strip and
	-- the pile-left caption were the tiny lines and are gone
	local rows = ResultsRules.lines({ Tutorial = not (prof == nil or prof.OnboardDone), Leader = false, Ready = false, Racers = #res.Members })
	if table.find(rows, "Racers") then
		local present: { [number]: boolean } = {}
		for _, mm in m.Members or {} do
			present[mm.UserId] = mm.Present == true
		end
		-- one line per racer in two columns (name | eggs cracked); your own line in gold
		local board = UI.frame(col, { Name = "Others", BackgroundTransparency = 1, LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		UI.list(board, Enum.FillDirection.Vertical, 1)
		for i, mem in res.Members do
			local me = mem.UserId == player.UserId
			local r = UI.frame(board, { Name = "Racer_" .. i, LayoutOrder = i, Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = TC.Gold, BackgroundTransparency = if me then 0.7 else 1 })
			UI.corner(r, 6)
			local col3 = if me then TC.Gold else TC.Muted
			local racerName = UI.text(r, mem.Name .. (if present[mem.UserId] == false then " (left)" else "") .. (if me then " (you)" else ""), { Font = UI.Bold, TextSize = T.Small, TextColor3 = col3, Outline = "Light", Position = UDim2.fromOffset(6, 0), Size = UDim2.new(0.65, -6, 1, 0) })
			racerName.TextWrapped = false
			racerName.TextTruncate = Enum.TextTruncate.AtEnd
			UI.text(r, tostring(mem.Processed) .. " eggs", { Font = UI.Bold, TextSize = T.Small, TextColor3 = col3, Outline = "Light", Position = UDim2.fromScale(0.65, 0), Size = UDim2.new(0.35, -6, 1, 0), TextXAlignment = Enum.TextXAlignment.Right })
		end
	end

	-- footer buttons
	local buttons = UI.frame(foot, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	UI.list(buttons, Enum.FillDirection.Horizontal, T.Gap, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	-- plainWords: every caption as fitted text (no word pictures), so a row of mixed buttons shares one font
	local plainWords = false
	local function fb(text: string, style: string, fn: () -> (), w: number, name: string?)
		local btn
		btn = UI.button(buttons, text, style, function()
			UI.pending(btn, "WAIT\u{2026}", 4)
			fn()
		end, { Name = name or text, Size = UDim2.new(w, -T.Gap, 0, 46), TextSize = T.Head, Word = not plainWords })
		return btn
	end
	-- Tutorial footer only while the tutorial is still running: once it is finished or skipped, the ordinary
	-- PLAY AGAIN / LOBBY footer shows (a skipped practice result must not keep offering SKIP TUTORIAL).
	local onboardDone = prof == nil or prof.OnboardDone
	if not onboardDone and prof then
		local ob = prof.Onboard or {}
		-- the core loop as three step chips, so finishing the practice hunt reads as step one of the game, not the end:
		-- FIND (done: the practice pet hatched) -> TRAIN -> FIGHT. Done = green tick, current = gold, later = gray.
		-- (listed first in the column, so a short phone never scrolls them out of sight)
		local tick = "\u{2713} "
		local steps = {
			{ Done = ob.Geode == true, Text = "FIND", Num = "1 " },
			{ Done = false, Text = "TRAIN", Num = "2 " },
			{ Done = false, Text = "FIGHT", Num = "3 " },
		}
		local row = UI.frame(col, { Name = "Stages", BackgroundTransparency = 1, LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 32) })
		UI.list(row, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		local current = false
		for i, stp in steps do
			local isNow = not stp.Done and not current
			current = current or isNow
			local color = if stp.Done then TC.Green elseif isNow then TC.Gold else TC.Gray
			local chip = UI.chip(row, (if stp.Done then tick else stp.Num) .. stp.Text, color, { LayoutOrder = i, Size = UDim2.new(0.31, -6, 0, 28) })
			local label = chip:FindFirstChild("Text") :: TextLabel?
			if label then
				UI.fit(label, T.Body, T.Tiny) -- the shared chip is caption-sized; these steps are key labels
			end
			if label and isNow then
				-- the current step is a dark pill with gold text and a gold rim (dark-on-gold read as gold-on-gold)
				chip.BackgroundColor3 = TC.PanelEdge
				local rim = chip:FindFirstChildOfClass("UIStroke")
				if rim then
					rim.Color = TC.Gold
					rim.Thickness = 2
				end
				label.TextColor3 = TC.Gold
			end
		end
		plainWords = true
		-- the primary button pushes the loop: back to the lobby with the TRAIN card open for the new pet
		fb(ResultsRules.Label[ResultsRules.primary({ Tutorial = true, Leader = true, Ready = false, Racers = #res.Members })], "gold", function()
			if Results.OnTutorialAction then
				Results.OnTutorialAction("Train")
			end
			act("Return")
		end, 0.4)
		fb("LOBBY", "gray", function()
			act("Return")
		end, 0.3)
		fb("SKIP TUTORIAL", "gray", function()
			Net.event("TutorialAction"):FireServer("Skip")
		end, 0.3)
		UI.sameTextSize(buttons, T.Head)
		return
	end
	-- rematch: the leader starts once everyone tapped PLAY AGAIN; members mark themselves ready
	local present, leader = 0, nil
	for _, mem in m.Members or {} do
		if mem.Present then
			present += 1
			if mem.Leader then
				leader = mem.UserId
			end
		end
	end
	if not leader then
		for _, mem in m.Members or {} do
			if mem.Present then
				leader = mem.UserId
				break
			end
		end
	end
	local amLeader = leader == player.UserId
	local myReady, allReady = false, true
	for _, mem in m.Members or {} do
		if mem.Present and mem.UserId ~= leader and not mem.Rematch then
			allReady = false
		end
		if mem.UserId == player.UserId then
			myReady = mem.Rematch
		end
	end
	local together = State.Teleport and amLeader and present > 1
	if amLeader then
		local rb = fb(ResultsRules.Label.PlayAgain, "gold", function()
			act("StartRematch")
		end, if together then 0.4 else 0.55, "PlayAgain")
		UI.setEnabled(rb, allReady and m.Phase == "Results")
		glow(rb)
	else
		local rb = fb(ResultsRules.Label[ResultsRules.primary({ Tutorial = false, Leader = false, Ready = myReady == true, Racers = present })], if myReady then "green" else "gold", function()
			act("Rematch")
		end, 0.55, "PlayAgain")
		if not myReady then
			glow(rb)
		end
	end
	fb("LOBBY", "gray", function()
		act("Return")
	end, if together then 0.3 else 0.45, "Lobby")
	if together then
		fb("ALL TO LOBBY", "gray", function()
			Net.event("LaunchAction"):FireServer("ReturnAll")
		end, 0.3)
	end
	-- who the rematch is waiting for (party hunts)
	if present > 1 then
		local note = if amLeader and not allReady then "Waiting for everyone to tap PLAY AGAIN." elseif not amLeader and myReady then "Ready. The leader starts the next hunt." elseif not amLeader then "Tap PLAY AGAIN; the leader starts the next hunt." else ""
		if note ~= "" then
			UI.text(col, note, { Name = "Rematch", Font = UI.Bold, TextSize = T.Small, TextColor3 = TC.Count, Outline = "Normal", LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 22) })
		end
	end
end

-- PLAY AGAIN breathes a soft gold glow (the main way forward from this screen)
glow = function(b: GuiButton)
	if UI.Reduced then
		return
	end
	local st = Instance.new("UIStroke")
	st.Name = "Glow"
	st.Color = TC.Gold
	st.Thickness = 0
	st.Transparency = 0.2
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = b
	TweenService:Create(st, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Thickness = 4 }):Play()
end

function Results.open()
	RevealView.close()
	local res = State.Results
	-- short landscape screens (a phone): the card takes the whole height it can get, so the stat tiles stay in view
	local size = if UI.isPortrait() then Vector2.new(480, 620) elseif UI.Logical.Y >= 600 then Vector2.new(620, 400) else Vector2.new(580, math.max(360, UI.Logical.Y - 24))
	-- toasts ("New in your Pet Book") wait until the card closes: they covered the FIND / TRAIN / FIGHT chips on a phone
	UI.holdNotices(true)
	local panel, b, _, f = UI.modal("Results", if res then headline(res) else "HUNT COMPLETE!", size, { Dismissable = false, Footer = 62, Fixed = true })
	PanelSkin.dress(panel, "Egg", if res then headline(res) else "HUNT COMPLETE!", { Center = true })
	panelRef = panel
	body = b
	footer = f
	resultsOpen = true
	openedAt = os.clock()
	local conn
	conn = UI.ModalChanged.Event:Connect(function(name)
		if name ~= "Results" then
			resultsOpen = false
			UI.holdNotices(false)
			body = nil
			footer = nil
			panelRef = nil
			conn:Disconnect()
			State.update("Match") -- the HUD shows the Results tile again
		end
	end)
	render()
	-- confetti over the podium once per round (the winner also had it in the reveal; everyone cheers here)
	if res and confettiFor ~= res and res.Kind ~= "Tutorial" then
		confettiFor = res
		Effects.confetti()
	end
end

function Results.hide()
	RevealView.close()
	if UI.modalOpen() == "Results" then
		UI.closeModal()
	end
end

function Results.start()
	State.Changed.Event:Connect(function(what)
		if what == "Match" or what == "Profile" or what == "Results" then
			render()
		end
	end)
end

local _ = panelRef
return Results
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="373">
            <Properties>
              <string name="Name">RobuxShopPanel</string>
              <string name="Source"><![CDATA[--!strict
-- EGG SHOP (Robux): paid pet eggs, luck potions and game passes (server: RobuxService; tuning: shared/RobuxConfig).
-- Opened from the lobby EGG SHOP hut (a world prompt with Panel = "RobuxShop") and from the Robux tab of UPGRADES.
--
-- Layout like the UPGRADES shop: tabs (Eggs / Potions / Passes), a luck status line, the catalog on the left and one
-- selected-item card on the right (portrait: stacked). An egg card lists the FULL odds (rarity, variant, species)
-- above its buy button (Roblox rule for paid random items); the odds come from LuckEvents.eggOdds, the same weights
-- GeodeGen.roll uses on the server. Paid eggs are hidden for accounts PolicyService restricts (player attribute
-- PaidRandomRestricted, set by the server; until it is known they are hidden too). Luck potions are hidden the same way.
--
-- EGG SHRINE (coin mode, RobuxShopPanel.openCoins; the lobby hatch stand's "Buy Eggs" prompt, Panel = "EggShrine"):
-- the same egg cards and full odds, priced in coins for the player's best zone (RobuxConfig.eggCoinPrice), with the
-- coin balance on the status line. BUY sends RobuxAction "BuyEggCoins"; the server re-checks everything and answers
-- with the pets (profile update + notice) or a refusal notice. No tabs: eggs only.
--
-- Prices are read from Roblox (MarketplaceService:GetProductInfo, pcall), never written in the game; "R$ ?" until
-- known. An item whose id is still 0 shows NOT FOR SALE YET. Tapping BUY only asks the server, which re-checks and
-- opens Roblox's own purchase prompt; the grant arrives as a profile update and a notification.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local RobuxConfig = require(Shared.RobuxConfig)
local LuckEvents = require(Shared.LuckEvents)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local PanelSkin = require(script.Parent.PanelSkin)
local Theme = require(script.Parent.Theme)
local PetStyle = require(script.Parent.PetStyle)
local Juice = require(script.Parent.Juice)

local T = UI.T
local TC = Theme.Color
local K = Theme.Pet
local RobuxShopPanel = {}

local player = Players.LocalPlayer
local TABS = { { "Eggs", "Eggs" }, { "Potions", "Potions" }, { "Passes", "Passes" } }

local tab = "Eggs"
local coinMode = false -- true: the EGG SHRINE (eggs for coins)
local got: { Text: string, Until: number }? = nil -- "You got: ..." after a shrine buy (RobuxAction "Hatched")
local modalName = "RobuxShop"
local open = false
local body: Frame? = nil
local selected: { [string]: string } = {}
local pending: { Key: string, At: number }? = nil
local PENDING_SECONDS = 4
local render: () -> ()
local tickers: { () -> () } = {} -- labels with a countdown, refreshed every second while open

local function now(): number
	local ok, t = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	return if ok and type(t) == "number" then t else os.time()
end

-- Prices from Roblox, cached per kind and id ------------------------------------------------------------------------

local priceCache: { [string]: string } = {}
local priceAsked: { [string]: boolean } = {}
local function priceText(id: number, isPass: boolean): string
	if id <= 0 then
		return ""
	end
	local key = (if isPass then "p" else "d") .. id
	if priceCache[key] then
		return priceCache[key]
	end
	if not priceAsked[key] then
		priceAsked[key] = true
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(id, if isPass then Enum.InfoType.GamePass else Enum.InfoType.Product)
			end)
			if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
				priceCache[key] = "R$ " .. info.PriceInRobux
				render()
			end
		end)
	end
	return "R$ ?"
end

-- Luck the player has right now (the same sources the server adds up for a hunt pet, without friends luck).
local function luckParts(prof): { [string]: number }
	local storm = ReplicatedStorage:GetAttribute("LuckStormUntil")
	local t = LuckEvents.timed(now(), prof and prof.Robux and tonumber(prof.Robux.LuckUntil) or 0, if type(storm) == "number" then storm else 0)
	local pet = prof and prof.PetBoosts and tonumber(prof.PetBoosts.Luck) or 0
	return { Pet = pet, Potion = t.Potion, Weekend = t.Weekend, Storm = t.Storm, Hour = t.Hour, Vip = RobuxConfig.vipLuck(prof and prof.Robux) }
end

local function luckLine(prof): string
	local p = luckParts(prof)
	local total = LuckEvents.total(p :: any)
	local bits = {}
	if p.Potion > 0 then
		table.insert(bits, "Potion " .. LuckEvents.clock(RobuxConfig.potionLeft(prof.Robux, now())))
	end
	if p.Weekend > 0 then
		table.insert(bits, "Weekend")
	end
	if p.Storm > 0 then
		local storm = ReplicatedStorage:GetAttribute("LuckStormUntil")
		table.insert(bits, "Storm " .. LuckEvents.clock((if type(storm) == "number" then storm else 0) - now()))
	end
	if p.Hour > 0 then
		table.insert(bits, "Lucky Hour")
	end
	if p.Vip > 0 then
		table.insert(bits, "VIP")
	end
	if p.Pet > 0 then
		table.insert(bits, "Pets")
	end
	local factor = LuckEvents.factor(total)
	local head = "Your luck: x" .. (if factor == math.floor(factor) then tostring(factor) else string.format("%.1f", factor))
	return if #bits > 0 then head .. "  \u{b7}  " .. table.concat(bits, " \u{b7} ") else head .. "  \u{b7}  2x luck every weekend"
end

local function eggsHidden(): boolean
	return player:GetAttribute("PaidRandomRestricted") ~= false
end

-- Catalog ------------------------------------------------------------------------------------------------------------

type Item = {
	Key: string,
	Title: string,
	Icon: string,
	Sub: string,
	SubColor: Color3?,
	Id: number, -- product or pass id (0 = not created yet)
	IsPass: boolean,
	Owned: boolean?,
	Block: string?, -- why it cannot be bought now (button text)
	Egg: RobuxConfig.Egg?,
}

local function items(prof): { Item }
	local out: { Item } = {}
	if coinMode then
		local room = (prof.InventoryMax or 0) - (prof.InventoryCount or 0)
		local tierId = RobuxConfig.eggTier(prof.UnlockedTiers)
		for _, e in RobuxConfig.Eggs do
			local one = RobuxConfig.eggCoinPrice(e.Id, tierId, 1) or 0
			table.insert(out, {
				Key = e.Id, Title = e.Name, Icon = "egg_" .. string.lower((string.gsub(e.Id, "Egg$", ""))), Id = 1, IsPass = false, Egg = e,
				Block = if room <= 0 then "PET BOOK FULL" else nil,
				Sub = if room <= 0 then "Pet Book full" else "1x " .. UI.money(one),
				SubColor = if room <= 0 then TC.Faint else TC.Cash,
			})
		end
	elseif tab == "Eggs" then
		local room = (prof.InventoryMax or 0) - (prof.InventoryCount or 0)
		for _, e in RobuxConfig.Eggs do
			local one = e.Products[1] or 0
			local any = false
			for _, n in RobuxConfig.EggCounts do
				any = any or (e.Products[n] or 0) > 0
			end
			table.insert(out, {
				Key = e.Id, Title = e.Name, Icon = "egg_" .. string.lower((string.gsub(e.Id, "Egg$", ""))), Id = if any then 1 else 0, IsPass = false, Egg = e,
				Block = if room <= 0 then "PET BOOK FULL" else nil,
				Sub = if not any then "Not for sale yet" elseif room <= 0 then "Pet Book full" elseif one > 0 then "1x " .. priceText(one, false) else "3x / 10x",
				SubColor = if not any or room <= 0 then TC.Faint else TC.Cash,
			})
		end
	elseif tab == "Potions" then
		local p = RobuxConfig.Potion
		local left = RobuxConfig.potionLeft(prof.Robux, now())
		table.insert(out, {
			Key = p.Id, Title = p.Name, Icon = "sparkle", Id = p.ProductId, IsPass = false,
			Block = if left + p.Seconds > p.MaxStackSeconds then "LOTS OF TIME LEFT" else nil,
			Sub = if left > 0 then "Active " .. LuckEvents.clock(left) elseif p.ProductId <= 0 then "Not for sale yet" else priceText(p.ProductId, false),
			SubColor = if left > 0 then TC.Green elseif p.ProductId <= 0 then TC.Faint else TC.Cash,
		})
	else
		local icons = { DoubleCoins = "cash", PetStorage = "storage", ExtraPlots = "home" }
		for _, key in RobuxConfig.PassOrder do
			local pass = RobuxConfig.Passes[key]
			local owned = RobuxConfig.hasPass(prof.Robux, key)
			table.insert(out, {
				Key = key, Title = pass.Name, Icon = icons[key] or "star", Id = pass.PassId, IsPass = true, Owned = owned,
				Sub = if owned then "Owned" elseif pass.PassId <= 0 then "Not for sale yet" else priceText(pass.PassId, true),
				SubColor = if owned then TC.Green elseif pass.PassId <= 0 then TC.Faint else TC.Cash,
			})
		end
	end
	return out
end

local function buy(it: Item, count: number?)
	if pending or it.Id <= 0 or it.Block or it.Owned then
		return
	end
	pending = { Key = it.Key .. ":" .. tostring(count or 1), At = os.clock() }
	Net.event("RobuxAction"):FireServer(if coinMode then "BuyEggCoins" else "Buy", it.Key, count)
	render()
	local mine = pending
	task.delay(PENDING_SECONDS, function()
		if pending == mine then
			pending = nil
			render()
		end
	end)
end

-- Card ----------------------------------------------------------------------------------------------------------------

local function line(parent: Instance, order: number, text: string, props: { [string]: any }?): TextLabel
	local p: { [string]: any } = { Font = UI.Bold, TextSize = T.Small, Outline = "Light", LayoutOrder = order, Size = UDim2.new(1, -6, 0, 20) }
	for k, v in (props or {}) :: { [string]: any } do
		p[k] = v
	end
	return UI.text(parent, text, p)
end

local justPicked: string? = nil -- row tapped just now (its picture bounces once after the re-render)

local function oddsRow(parent: Instance, order: number, name: string, p: number, color: Color3?)
	local row = UI.frame(parent, { Name = "Odds_" .. name, BackgroundTransparency = 1, LayoutOrder = order, Size = UDim2.new(1, -6, 0, 18) })
	local x = 0
	if color then
		-- rarity dot in front of the name
		local dot = UI.frame(row, { Name = "Dot", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = color })
		UI.corner(dot, 5)
		UI.stroke(dot, TC.Outline, 1)
		x = 16
	end
	UI.text(row, name, { Font = UI.Bold, TextSize = T.Small, TextColor3 = color or TC.Text, Outline = if color then "Strong" else "Light", Position = UDim2.fromOffset(x, 0), Size = UDim2.new(0.45, -x, 1, 0) })
	UI.text(row, LuckEvents.chanceText(p), { Name = "Chance", Font = UI.Bold, TextSize = T.Small, Outline = "Light", Position = UDim2.fromScale(0.45, 0), Size = UDim2.new(0.55, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right })
end

local function eggInfo(scroll: ScrollingFrame, it: Item, prof)
	local egg = it.Egg :: RobuxConfig.Egg
	local luck = if RobuxConfig.EggsUseLuck then LuckEvents.total(luckParts(prof) :: any) else 0
	local tierId = RobuxConfig.eggTier(prof.UnlockedTiers)
	local odds = LuckEvents.eggOdds(tierId, luck, RobuxConfig.eggRarity(egg))
	local tier = Config.Tiers[tierId]
	local o = 0
	local function nextOrder(): number
		o += 1
		return o
	end
	line(scroll, nextOrder(), "RARITY ODDS", { Font = UI.Head, TextColor3 = TC.Gold })
	for _, r in odds.Rarity do
		oddsRow(scroll, nextOrder(), r.Name, r.P, (Config.RarityTextColors :: any)[r.Name])
	end
	UI.frame(scroll, { Name = "Gap1", BackgroundTransparency = 1, LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 8) })
	line(scroll, nextOrder(), "VARIANT ODDS", { Font = UI.Head, TextColor3 = TC.Gold })
	for _, v in odds.Variant do
		oddsRow(scroll, nextOrder(), v.Name, v.P)
	end
	line(scroll, nextOrder(), "Hatches " .. (if tier then tier.Name else tierId) .. " pets (your best zone) with their normal boost.", { TextColor3 = TC.Muted, Size = UDim2.new(1, -6, 0, 34) })
	UI.frame(scroll, { Name = "Gap2", BackgroundTransparency = 1, LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 8) })
	line(scroll, nextOrder(), "PET ODDS", { Font = UI.Head, TextColor3 = TC.Gold })
	for _, sp in odds.SpeciesP do
		oddsRow(scroll, nextOrder(), sp.Name .. (if sp.Chase then " (Legendary only)" else ""), sp.P)
	end
	line(scroll, nextOrder(), (if egg.Rarity then "Better rarity odds than a race egg. " else "Same odds as a race egg. ") .. (if RobuxConfig.EggsUseLuck then "Includes your luck now." else "Luck boosts don't change bought eggs."), { TextColor3 = TC.Muted, Size = UDim2.new(1, -6, 0, 34) })
	if coinMode then
		line(scroll, nextOrder(), "The coin price grows with your best zone (" .. (if tier then tier.Name else tierId) .. " now).", { TextColor3 = TC.Muted, Size = UDim2.new(1, -6, 0, 34) })
	end
	-- room under the last line, so the list never ends cut off at the card's bottom edge
	UI.frame(scroll, { Name = "EndGap", BackgroundTransparency = 1, LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 18) })
end

local function potionInfo(scroll: ScrollingFrame, prof)
	local p = RobuxConfig.Potion
	line(scroll, 1, "2x luck for " .. math.floor(p.Seconds / 60) .. " minutes: Rare and better pets twice as likely.", { Size = UDim2.new(1, -6, 0, 34) })
	line(scroll, 2, (if RobuxConfig.EggsUseLuck then "" else "Works on the pet you find in a hunt. ") .. "More potions add more time, even while you are away.", { TextColor3 = TC.Muted, Size = UDim2.new(1, -6, 0, 34) })
	line(scroll, 3, "Stacks with weekend luck and luck storms (best x" .. LuckEvents.factor(RobuxConfig.MaxLuck) .. ").", { TextColor3 = TC.Muted, Size = UDim2.new(1, -6, 0, 34) })
	-- the timer with a ring of dots that drains as the potion runs out (the last potion's worth of time)
	local row = UI.frame(scroll, { Name = "PotionTimerRow", BackgroundTransparency = 1, LayoutOrder = 4, Size = UDim2.new(1, -6, 0, 34) })
	local ring, setRing = Juice.ring(row, 30, TC.Green, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0) })
	local timer = line(row, 0, "", { Name = "PotionTimer", TextColor3 = TC.Green, Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -40, 1, 0) })
	local function tick()
		local left = RobuxConfig.potionLeft(State.Profile and State.Profile.Robux, now())
		timer.Text = if left > 0 then "Active: " .. LuckEvents.clock(left) .. " left" else "No potion active"
		ring.Visible = left > 0
		timer.Position = UDim2.fromOffset(if left > 0 then 40 else 0, 0)
		setRing(left / p.Seconds)
	end
	tick()
	table.insert(tickers, tick)
	local _ = prof
end

local function passInfo(scroll: ScrollingFrame, it: Item)
	local pass = RobuxConfig.Passes[it.Key]
	line(scroll, 1, pass.Desc, { Size = UDim2.new(1, -6, 0, 34) })
	local note = if it.Key == "DoubleCoins" then "Works with your Coins pets. Forever, on every server."
		elseif it.Key == "PetStorage" then "+" .. RobuxConfig.ExtraPetSlots .. " Pet Book slots (" .. Config.Inventory.Max .. " -> " .. (Config.Inventory.Max + RobuxConfig.ExtraPetSlots) .. ")."
		else "+" .. RobuxConfig.ExtraDisplaySlots .. " display spots. Extra pets walk around inside your plot fence."
	line(scroll, 2, note, { TextColor3 = TC.Muted, Size = UDim2.new(1, -6, 0, 34) })
end

-- buyHost: landscape egg cards put the 1x / 3x / 10x buttons under the egg list (the odds then fill the whole card).
-- One calm "coming soon" tag in place of buy buttons that can't be pressed yet (a row of grey SOON buttons read
-- like a broken shop).
local function soonTag(parent: Instance)
	local tag = UI.frame(parent, { Name = "ComingSoon", Size = UDim2.fromScale(1, 1), BackgroundColor3 = TC.Inset })
	UI.corner(tag, T.Radius)
	UI.stroke(tag, TC.Gold, 2)
	UI.icon(tag, "clock", 24, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0) })
	local l = UI.text(tag, "COMING SOON", { Name = "Text", Font = UI.Head, TextSize = T.Head, TextColor3 = TC.Gold, Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -54, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
	l.TextWrapped = false
end

local function detail(parent: Instance, it: Item, prof, buyHost: Frame?, soon: boolean?)
	local f = UI.card(parent, "inset", { Name = "Detail", Size = UDim2.fromScale(1, 1) })
	UI.pad(f, 8, 6)
	local head = UI.frame(f, { Name = "Head", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32) })
	UI.icon(head, it.Icon, 30, { Position = UDim2.fromOffset(0, 1) })
	local title = UI.text(head, it.Title, { Name = "Title", Font = UI.Head, TextSize = T.Head + 2, Position = UDim2.fromOffset(36, 0), Size = UDim2.new(1, -36, 1, 0) })
	title.TextWrapped = false
	local footH = if buyHost and it.Egg then 0 else 44
	-- the odds (or the description) sit ABOVE the buy button, always visible before buying
	local scroll = UI.scroller(f, { Name = "Info", Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 1, -(36 + footH + (if footH > 0 then 6 else 0))) })
	UI.list(scroll, Enum.FillDirection.Vertical, 2)
	if it.Egg then
		eggInfo(scroll, it, prof)
	elseif tab == "Potions" then
		potionInfo(scroll, prof)
	else
		passInfo(scroll, it)
	end
	local foot = if buyHost and it.Egg then buyHost else UI.frame(f, { Name = "Footer", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, footH) })
	if soon then
		soonTag(foot)
		return
	end
	if it.Egg and coinMode then
		-- 1x / 3x / 10x for coins at the player's zone price; a batch needs Pet Book room for every pet. A button the
		-- player can't afford is gray and reads "NEED N" (how many more coins).
		local room = (prof.InventoryMax or 0) - (prof.InventoryCount or 0)
		local tierId = RobuxConfig.eggTier(prof.UnlockedTiers)
		local counts = RobuxConfig.CoinEggs.Counts
		local n = #counts
		UI.list(foot, Enum.FillDirection.Horizontal, 6)
		for i, count in counts do
			local price = RobuxConfig.eggCoinPrice(it.Key, tierId, count) or 0
			local key = it.Key .. ":" .. count
			local cash = tonumber(prof.Cash) or 0
			local short = cash < price
			-- too few coins: the gray button says how many more (tapping it does nothing)
			local text, enabled, style = RobuxConfig.coinButton(count, price, cash, room, pending ~= nil and pending.Key == key, UI.num)
			local b = UI.button(foot, text, style, function()
				if enabled and not short then
					buy(it, count)
				end
			end, { Name = "Buy" .. count, LayoutOrder = i, Size = UDim2.new(1 / n, -math.ceil(6 * (n - 1) / n), 1, 0), TextSize = T.Body })
			if not enabled then
				UI.setEnabled(b, false)
			end
		end
		return
	end
	if it.Egg then
		-- 1x / 3x / 10x: each its own product; a batch needs Pet Book room for every pet
		local egg = it.Egg :: RobuxConfig.Egg
		local room = (prof.InventoryMax or 0) - (prof.InventoryCount or 0)
		local n = #RobuxConfig.EggCounts
		UI.list(foot, Enum.FillDirection.Horizontal, 6)
		for i, count in RobuxConfig.EggCounts do
			local id = egg.Products[count] or 0
			local key = it.Key .. ":" .. count
			local text, enabled
			if pending and pending.Key == key then
				text, enabled = "\u{2026}", false
			elseif id <= 0 then
				text, enabled = count .. "x  SOON", false
			elseif room < count then
				text, enabled = count .. "x  NO ROOM", false
			else
				text, enabled = count .. "x  " .. priceText(id, false), true
			end
			local b = UI.button(foot, text, "gold", function()
				if enabled then
					buy(it, count)
				end
			end, { Name = "Buy" .. count, LayoutOrder = i, Size = UDim2.new(1 / n, -math.ceil(6 * (n - 1) / n), 1, 0), TextSize = T.Body })
			if not enabled then
				UI.setEnabled(b, false)
			end
		end
		return
	end
	local text, enabled = "", true
	if pending and pending.Key == it.Key .. ":1" then
		text, enabled = "OPENING\u{2026}", false
	elseif it.Owned then
		text, enabled = "OWNED", false
	elseif it.Id <= 0 then
		text, enabled = "NOT FOR SALE YET", false
	elseif it.Block then
		text, enabled = it.Block, false
	else
		text = "BUY " .. priceText(it.Id, it.IsPass)
	end
	local b = UI.button(foot, text, "gold", function()
		buy(it)
	end, { Name = "Buy", Size = UDim2.fromScale(1, 1), TextSize = T.Head })
	if not enabled then
		UI.setEnabled(b, false)
	end
end

function render()
	if not open or not body then
		return
	end
	local b = body :: Frame
	for _, c in b:GetChildren() do
		if not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
	tickers = {}
	local prof = State.Profile
	if not prof then
		UI.loadingState(b, "Loading shop", { Position = UDim2.fromOffset(0, 60) })
		return
	end
	local tabsH = if coinMode then 0 else T.Gap + T.Tab
	if coinMode then
		tab = "Eggs"
	else
		UI.tabs(b, TABS, tab, function(name)
			tab = name
			render()
		end)
	end
	local function statusText(p): string
		return if coinMode then UI.num(tonumber(p.Cash) or 0) else luckLine(p)
	end
	local statusH = if coinMode then 34 else 20
	local status: TextLabel
	if coinMode then
		-- the coin balance as the pet-style coin pill (navy, gold coin, white outlined number), centred over the shop
		local pill, setCoins = PetStyle.coinPill(b, 170, statusH, { Name = "CoinPill", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, tabsH) })
		setCoins(tonumber(prof.Cash) or 0)
		status = pill:FindFirstChild("Amount") :: TextLabel
		status.Name = "Luck"
		status.TextXAlignment = Enum.TextXAlignment.Center
		status.Text = statusText(prof)
	else
		status = UI.text(b, statusText(prof), { Name = "Luck", Font = UI.Bold, TextSize = T.Small, TextColor3 = TC.Count, Outline = "Normal", Position = UDim2.fromOffset(0, tabsH), Size = UDim2.new(1, 0, 0, 20) })
	end
	status.TextWrapped = false
	table.insert(tickers, function()
		if State.Profile then
			status.Text = statusText(State.Profile)
		end
	end)
	local top = tabsH + statusH + 4
	if coinMode and got and got.Until > os.clock() then
		-- what the last buy hatched, under the coin pill: a glossy lime strip with the pet-style outlined words
		local strip = UI.frame(b, { Name = "GotStrip", Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = K.Lime })
		PetStyle.round(strip, 999)
		PetStyle.vgrad(strip, K.LimeTop, K.Lime)
		PetStyle.edge(strip, K.LimeEdge, 2)
		PetStyle.words(strip, got.Text, T.Small, { Name = "Text", Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, OutlineColor = K.LimeEdge, OutlineThick = 2 })
		top += 30
	end
	local content = UI.frame(b, { Name = "Content", Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 1, -top), BackgroundTransparency = 1 })
	if tab == "Eggs" and eggsHidden() then
		UI.emptyState(content, "Eggs not available", if coinMode then "Pet eggs can't be bought on your account." else "Pet eggs can't be bought with Robux on your account.", "lock", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		return
	end
	-- luck potions follow the same paid-random-item rule (the server refuses them too)
	if tab == "Potions" and eggsHidden() then
		UI.emptyState(content, "Potions not available", "Luck potions can't be bought with Robux on your account.", "lock", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		return
	end
	local list = items(prof)
	-- nothing on this tab can be bought yet (ids not set): say so plainly at the top instead of the luck line,
	-- so the gray SOON buttons don't look like a broken shop
	local soon = not coinMode
	for _, it in list do
		if it.Id > 0 or it.Owned == true then
			soon = false
		end
	end
	if soon then
		table.clear(tickers)
		-- a calm yellow ribbon (red read like an error)
		status.Text = "Coming soon! Have a look at what will be inside."
		status.TextColor3 = TC.DarkText
		status.BackgroundColor3 = TC.Gold
		status.BackgroundTransparency = 0
		status.TextXAlignment = Enum.TextXAlignment.Center
		local ol = status:FindFirstChildOfClass("UIStroke")
		if ol then
			ol.Enabled = false
		end
		UI.corner(status, 8)
	end
	local sel: Item? = nil
	for _, it in list do
		if it.Key == selected[tab] then
			sel = it
		end
	end
	sel = sel or list[1]
	local portrait = UI.isPortrait()
	local sideBuy = not portrait and tab == "Eggs"
	local listHost = UI.frame(content, { Name = "ListHost", BackgroundTransparency = 1, Size = if portrait then UDim2.new(1, 0, 0.4, -4) elseif sideBuy then UDim2.new(0.46, -4, 1, -50) else UDim2.new(0.46, -4, 1, 0) })
	local buyHost = if sideBuy then UI.frame(content, { Name = "BuyRow", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(0.46, -14, 0, 44) }) else nil
	local pane = UI.frame(content, {
		Name = "Pane", BackgroundTransparency = 1,
		Position = if portrait then UDim2.new(0, 0, 0.4, 4) else UDim2.new(0.46, 4, 0, 0),
		Size = if portrait then UDim2.new(1, 0, 0.6, -4) else UDim2.new(0.54, -4, 1, 0),
	})
	local scroller = UI.scroller(listHost, { Name = "List", Size = UDim2.fromScale(1, 1) })
	UI.list(scroller, Enum.FillDirection.Vertical, 6)
	UI.pad(scroller, 2, 2)
	local rowH = if UI.isShort() then 48 else 56
	for i, it in list do
		local row = UI.catalogRow(scroller, i, {
			Name = "Row_" .. it.Key, Title = it.Title, Sub = if soon then "Coming soon" else it.Sub, SubColor = if soon then TC.Count else it.SubColor, Selected = sel ~= nil and it.Key == sel.Key, Height = rowH,
			Thumb = function(c)
				local ic = UI.icon(c, it.Icon, rowH - 14, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
				if it.Egg then
					Juice.wobble(ic) -- egg tiles rock gently while the shop is open
				end
			end,
			OnSelect = function()
				selected[tab] = it.Key
				justPicked = it.Key
				render()
			end,
		})
		if justPicked == it.Key then
			-- the picked egg / potion / pass picture bounces once
			local th = row:FindFirstChild("Thumb")
			if th then
				UI.pop(th, 0.7)
			end
		end
	end
	justPicked = nil
	-- keep the selected row in view (the buy buttons below the list belong to it)
	local selIndex = if sel then table.find(list, sel) else nil
	if selIndex then
		task.defer(function()
			if scroller.Parent then
				local bottom = selIndex * (rowH + 6) + 4
				scroller.CanvasPosition = Vector2.new(0, math.max(0, bottom - scroller.AbsoluteSize.Y))
			end
		end)
	end
	if sel then
		detail(pane, sel, prof, buyHost, soon)
	end
end

local function modalSize(): Vector2
	if UI.isPortrait() then
		return Vector2.new(480, 700)
	elseif UI.Logical.Y >= 600 then
		return Vector2.new(740, 460)
	end
	return Vector2.new(680, 380)
end

-- onBack: set when another menu opened this one (Upgrades); adds a BACK button to the header that returns there.
local function openAs(coins: boolean, openTab: string?, onBack: (() -> ())?)
	coinMode = coins
	modalName = if coins then RobuxConfig.CoinEggs.Panel else "RobuxShop"
	pending = nil
	if openTab == "Eggs" or openTab == "Potions" or openTab == "Passes" then
		tab = openTab
	end
	local heading = if coins then "EGG SHRINE" else "EGG SHOP"
	local panel, b = UI.modal(modalName, heading, modalSize(), { Fixed = true })
	local head = panel:FindFirstChild("Header")
	if onBack and head then
		UI.button(head, "BACK", "gray", onBack, {
			Name = "Back", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 2), Size = UDim2.fromOffset(84, T.Touch), TextSize = T.Body,
		})
		local title = head:FindFirstChild("Title") :: TextLabel?
		if title then
			title.Position = UDim2.fromOffset(106, title.Position.Y.Offset)
			title.Size = UDim2.new(title.Size.X.Scale, title.Size.X.Offset - 90, title.Size.Y.Scale, title.Size.Y.Offset)
		end
	end
	-- centred tab: the BACK button holds the left side of the header
	PanelSkin.dress(panel, "Egg", heading, { Center = true })
	body = b
	open = true
	local conn
	conn = UI.ModalChanged.Event:Connect(function(name)
		if name ~= modalName then
			open = false
			body = nil
			tickers = {}
			conn:Disconnect()
		end
	end)
	render()
end

function RobuxShopPanel.open(openTab: string?, onBack: (() -> ())?)
	openAs(false, openTab, onBack)
end

-- The EGG SHRINE (hatch stand prompt): eggs for coins.
function RobuxShopPanel.openCoins()
	openAs(true)
end

function RobuxShopPanel.start()
	State.Changed.Event:Connect(function(what)
		if what == "Profile" then
			if not coinMode then -- coin buys wait for their own reply (Hatched / warn notice) or the timeout
				pending = nil
			end
			render()
		end
	end)
	Net.event("RobuxAction").OnClientEvent:Connect(function(kind, text)
		if kind == "Hatched" and type(text) == "string" then
			pending = nil
			local mine = { Text = text, Until = os.clock() + 8 }
			got = mine
			render()
			task.delay(8.1, function()
				if got == mine then
					got = nil
					render()
				end
			end)
		end
	end)
	player:GetAttributeChangedSignal("PaidRandomRestricted"):Connect(function()
		render()
	end)
	for _, name in { "LuckStormUntil", "LuckWeekend" } do
		ReplicatedStorage:GetAttributeChangedSignal(name):Connect(function()
			render()
		end)
	end
	-- refusals (warn notices) end the pending state at once
	UI.Notice.Event:Connect(function(_, kind)
		if kind == "warn" and pending then
			pending = nil
			render()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if open then
				for _, fn in tickers do
					fn()
				end
			end
		end
	end)
end

return RobuxShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="374">
            <Properties>
              <string name="Name">SettingsPanel</string>
              <string name="Source"><![CDATA[--!strict
-- SETTINGS (board 11). Only settings that change something, saved in the profile (SettingsAction, validated on the
-- server):
--   Music        Settings.Music -> SoundGroups Music and Ambience (0.6x), set live while dragging
--   Sounds       Settings.Sfx -> SoundGroup SFX (one-shots and machine loops)
--   Camera Sensitivity   Settings.CameraSensitivity -> UserInputService.MouseDeltaSensitivity (mouse look only, so
--                the row is shown only when a mouse is present; touch look speed is Roblox's own setting)
--   Reduce Motion        Settings.ReducedMotion (UI transitions, reveal, camera-free decorative motion)
--   Low Effects, Hints   Settings.LowEffects / Settings.Hints; SKIP TUTORIAL while the first-session steps run.

local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local PanelSkin = require(script.Parent.PanelSkin)
local HudArt = require(script.Parent.HudArt)
local Theme = require(script.Parent.Theme)
local Audio = require(script.Parent.Parent.Audio)

local T = UI.T
local SettingsPanel = {}

-- Applies a volume to the real SoundGroups right away (Audio owns them: SoundService.CTR_Audio).
local function applyLive(key: string, v: number)
	if key == "CameraSensitivity" then
		pcall(function()
			UserInputService.MouseDeltaSensitivity = math.clamp(v * 2, 0.1, 2)
		end)
		return
	end
	local master = SoundService:FindFirstChild("CTR_Audio")
	if not master then
		return
	end
	local function set(name: string, vol: number)
		local g = master:FindFirstChild(name)
		if g and g:IsA("SoundGroup") then
			g.Volume = vol
		end
	end
	if key == "Sfx" then
		set("SFX", v)
	elseif key == "Music" then
		set("Music", v)
		set("Ambience", v * 0.6)
	end
end

-- Row geometry. Rows are ROW_H tall (less on a short screen, see open()); the controls on the right share one
-- column: the ON / OFF switches and SKIP are the same width and end RIGHT px inside the row.
local ROW_H = 46
local ROW_MIN = 36
local ROW_GAP = 6
local FOOT_H = 44 -- the "Saved to your profile." line sits in the panel's footer, not in the scroller
local RIGHT = 10
-- The ON / OFF switch drawn here (not UI.toggle): at least 34 px tall with a 28 px knob, OFF in the navy tab-bar
-- colour with a white word (the shared switch read small and its OFF state washed out on the sky rows, Studio).
local TRACK_H_MIN, TRACK_H_MAX = 34, 40
local TRACK_RATIO = 84 / 34
local KNOB = 28 -- slider handle and switch knob (a 20 px handle was hard to grab with a mouse on a phone-size window)
local TC = Theme.Color
local PET = Theme.Pet

-- ON / OFF switch: a 44 px tall hit box around a track `h` px tall. Returns the hit button.
local function bigToggle(parent: Instance, on: boolean, h: number, onChange: (boolean) -> (), props: { [string]: any }): TextButton
	local w = math.floor(h * TRACK_RATIO + 0.5)
	local hit = Instance.new("TextButton")
	hit.Name = "Switch"
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.BackgroundTransparency = 1
	hit.Size = UDim2.fromOffset(w, math.max(T.Touch, UI.minTouch()))
	UI.apply(hit, props)
	hit.Parent = parent
	local track = UI.frame(hit, { Name = "Track", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(w, h) })
	UI.corner(track, math.floor(h / 2))
	UI.stroke(track, TC.Outline, 2)
	local knob = UI.frame(track, { Name = "Knob", AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(KNOB, KNOB), BackgroundColor3 = Color3.fromRGB(245, 245, 245) })
	UI.corner(knob, math.floor(KNOB / 2))
	UI.stroke(knob, TC.Outline, 1.5)
	local wordW = w - KNOB - 8
	local word = UI.text(track, "", { Name = "Word", Font = UI.Head, TextSize = T.Body, TextColor3 = Color3.new(1, 1, 1), Outline = "Normal", Size = UDim2.new(0, wordW, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
	word.TextWrapped = false
	UI.fit(word, T.Body, T.MinText)
	local state = on
	local function show()
		track.BackgroundColor3 = if state then TC.Green else PET.TabBar
		knob.Position = if state then UDim2.new(1, -(KNOB + 3), 0.5, 0) else UDim2.new(0, 3, 0.5, 0)
		word.Text = if state then "ON" else "OFF"
		word.Position = if state then UDim2.fromOffset(4, 0) else UDim2.new(1, -(wordW + 4), 0, 0)
	end
	hit.Activated:Connect(function()
		Audio.button()
		state = not state
		show()
		onChange(state)
	end)
	show()
	return hit
end

function SettingsPanel.open()
	local prof = State.Profile
	local mouse = UserInputService.MouseEnabled
	local rows = 5 + (if mouse then 1 else 0) + (if prof and not prof.OnboardDone then 1 else 0)
	local h = math.min(54 + rows * (ROW_H + ROW_GAP) + 12 + FOOT_H, if UI.isPortrait() then 640 else 470)
	local panel, b, _, footer = UI.modal("Settings", "SETTINGS", Vector2.new(500, h), { Footer = FOOT_H })
	PanelSkin.dress(panel, "Gear", "SETTINGS", { Center = true }) -- owner mockup: reference/ui/settings/mockup.png
	UI.list(b, Enum.FillDirection.Vertical, ROW_GAP, Enum.HorizontalAlignment.Center)
	-- Rows shrink (down to ROW_MIN) so the whole list fits the panel on a short screen (Studio 1434 x 658 with the
	-- mouse-only camera row overflowed: a scrollbar showed and the last line sat on the bottom border). The panel is
	-- min(h, screen + its negative size offset) tall; the body is that minus the header, the footer and its padding.
	local panelH = math.min(h, UI.Logical.Y + panel.Size.Y.Offset)
	local bodyH = panelH - (b :: GuiObject).Position.Y.Offset - FOOT_H - 12
	local rowH = math.clamp(math.floor((bodyH - (rows - 1) * ROW_GAP) / rows), ROW_MIN, ROW_H)
	-- the switches (and SKIP) share one column: 34 to 40 px tall, as the row allows
	local colH = math.clamp(rowH - 4, TRACK_H_MIN, TRACK_H_MAX)
	local colW = math.floor(colH * TRACK_RATIO + 0.5)
	if typeof(b) == "Instance" and b:IsA("ScrollingFrame") then
		local sc = b :: ScrollingFrame
		-- no scrollbar, bar image or reserved strip unless the rows really overflow
		local function fitBar()
			local over = sc.AbsoluteCanvasSize.Y > sc.AbsoluteWindowSize.Y + 1
			sc.ScrollBarThickness = if over then UI.ScrollBar else 0
			sc.ScrollBarImageTransparency = if over then 0.25 else 1
			sc.VerticalScrollBarInset = if over then Enum.ScrollBarInset.Always else Enum.ScrollBarInset.None
			sc.ScrollingEnabled = over
		end
		sc:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(fitBar)
		sc:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(fitBar)
		fitBar()
		UI.endOnRow(sc, 0) -- the window ends on a whole row above the footer; the last row scrolls fully into view
	end
	if not prof then
		UI.loadingState(b, "Loading settings")
		return
	end
	local s: { [string]: any } = table.clone(prof.Settings)
	if type(s.CameraSensitivity) ~= "number" then
		s.CameraSensitivity = 0.5
	end
	local lastSave = 0
	local function save(force: boolean?)
		local now = os.clock()
		if force or now - lastSave > 0.25 then
			lastSave = now
			Net.event("SettingsAction"):FireServer(s)
		end
	end
	local order = 0
	local narrow = UI.Logical.X < 440
	local function row(icon: string, label: string): Frame
		order += 1
		-- sky row with a darker edge (mockup); icon and name centred on the row's height
		local r = PanelSkin.box(b, "Row_" .. label, PanelSkin.SKY, PanelSkin.SKY_EDGE, 3, { Size = UDim2.new(1, -6, 0, rowH), LayoutOrder = order })
		HudArt.skin(r, "settings_row", rowH)
		-- `icon` is a HudArt slot: the owner's picture once uploaded, else the drawn icon
		HudArt.image(r, icon, 28, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0) })
		-- the strong dark outline: white words under the normal one did not read on the light sky rows (Studio)
		local l = UI.text(r, label, { Name = "Label", Font = UI.Bold, TextSize = T.Head - 2, Outline = "Strong", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 48, 0.5, 0), Size = UDim2.new(if narrow then 0.42 else 0.46, -48, 0, 24) })
		l.TextWrapped = false
		UI.fit(l, T.Head - 2, T.MinText)
		HudArt.word(l) -- owner's word picture (reference/ui/settings/) once uploaded
		return r
	end
	local function slider(key: string, icon: string, label: string)
		local r = row(icon, label)
		-- the percentage sits in a navy pill (mockup)
		-- wide enough for "100%" at the 14 px floor (a 46 px pill squeezed it under 12 px, Studio)
		local pill = UI.frame(r, { Name = "ValuePill", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -RIGHT, 0.5, 0), Size = UDim2.fromOffset(58, 30), BackgroundColor3 = PanelSkin.NAVY, BackgroundTransparency = 0.25 })
		UI.corner(pill, 10)
		local val = UI.text(pill, "", { Name = "Value", Font = UI.Head, TextSize = T.Body, Outline = "Normal", Size = UDim2.new(1, -4, 1, 0), Position = UDim2.fromOffset(2, 0), TextXAlignment = Enum.TextXAlignment.Center })
		val.TextWrapped = false
		UI.fit(val, T.Body, T.MinText)
		local function show(v: number)
			val.Text = math.floor(v * 100 + 0.5) .. "%"
		end
		local sl = UI.slider(r, s[key], function(v, final)
			s[key] = v
			show(v)
			applyLive(key, v)
			save(final)
		end, { Name = "Slider_" .. key, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -(RIGHT + 62), 0.5, 0), Size = UDim2.new(if narrow then 0.58 else 0.54, -72, 0, T.Touch) })
		-- a 28 px handle on the slim track (the drag box stays 44 px tall: UI.slider holds it at the touch minimum)
		local knob = sl:FindFirstChild("Knob", true)
		if knob and knob:IsA("Frame") then
			knob.Size = UDim2.fromOffset(KNOB, KNOB)
			local kc = knob:FindFirstChildOfClass("UICorner")
			if kc then
				kc.CornerRadius = UDim.new(0, math.floor(KNOB / 2))
			end
		end
		show(s[key])
	end
	local function toggle(key: string, icon: string, label: string)
		local r = row(icon, label)
		-- the hit box is exactly the track's width, so the drawn track ends RIGHT px inside the row, like SKIP
		bigToggle(r, s[key] == true, colH, function(on)
			s[key] = on
			if key == "ReducedMotion" then
				UI.Reduced = on -- UI transitions follow at once; the server saves it
			end
			save(true)
		end, { Name = "Switch_" .. key, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -RIGHT, 0.5, 0) })
	end
	slider("Music", "Music", "Music")
	slider("Sfx", "Sound", "Sounds")
	if mouse then
		slider("CameraSensitivity", "Camera", "Camera Sensitivity")
	end
	toggle("ReducedMotion", "Motion", "Reduce Motion")
	toggle("LowEffects", "Sparkle", "Low Effects")
	toggle("Hints", "Bulb", "Hints")
	if not prof.OnboardDone then
		local r = row("Info", "First-hunt guide")
		local skip = UI.button(r, "SKIP", "blue", function()
			Net.event("TutorialAction"):FireServer("Skip")
			UI.closeModal()
		end, { Name = "SkipTutorial", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -RIGHT, 0.5, 0), Size = UDim2.fromOffset(colW, colH), TextSize = T.Body })
		HudArt.skin(skip, "btn_blue", colH)
		local sl = skip:FindFirstChild("Label") :: TextLabel?
		if sl then
			HudArt.word(sl, 0.75)
		end
	end
	-- the footer line stays under the list (never scrolled with it) and clear of the panel's bottom border and rim
	if footer then
		local fp = footer:FindFirstChildOfClass("UIPadding")
		if fp then
			fp.PaddingTop = UDim.new(0, 2)
			fp.PaddingBottom = UDim.new(0, 14)
		end
		local note = UI.text(footer, if prof.SavesOff then "Saves are off here: changes last until you leave." else "Saved to your profile.", {
			Name = "SaveNote", Font = UI.Bold, TextSize = T.Body + 1, TextColor3 = PanelSkin.NAVY, Outline = false, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center,
		})
		note.TextWrapped = false
		UI.fit(note, T.Body + 1, T.MinText)
	end
end

return SettingsPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="375">
            <Properties>
              <string name="Name">ShopEgg</string>
              <string name="Source"><![CDATA[--!strict
-- Shop egg art: each of the three shop eggs gets its own look so the Eggs tab reads like a pet-game shop and not a pile
-- of the same egg in three tints. Basic = cream egg with soft spots and a gloss, Rare = sapphire egg with a gold band
-- and gems, Mythic = violet egg with glowing cracks and sparks orbiting it. The body is the game's own egg
-- (GeodeModel.rockShell: the owner's / Blender meshes when loaded, Parts otherwise), the trims are small Parts on its
-- surface, so no asset ids are needed. An owner picture (RobuxConfig egg Image id, 0 = none) replaces the 3D egg.
-- The egg idles with a slow spin and bob; a soft halo disc sits behind it.
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GeodeModel = require(Shared:WaitForChild("GeodeModel"))
local UI = require(script.Parent:WaitForChild("UI"))

local ShopEgg = {}

export type Look = {
	Tint: number, -- EGG_TINTS index for the body
	Body: Color3?, -- the body colour (the smooth kit egg or Parts; the textured pile eggs are skipped then)
	Spots: boolean, -- keep GeodeModel's own spot pattern
	Band: Color3?, -- a metal band round the middle
	Gems: Color3?, -- gems on the band
	Cracks: Color3?, -- glowing crack lines
	Sparks: Color3?, -- orbiting sparks
	Halo: Color3, -- the disc behind the egg
}

local LOOKS: { [string]: Look } = {
	BasicEgg = { Tint = 1, Spots = true, Halo = Color3.fromRGB(255, 236, 200) },
	RareEgg = {
		Tint = 2, Spots = false, Body = Color3.fromRGB(70, 140, 255), Band = Color3.fromRGB(255, 206, 60),
		Gems = Color3.fromRGB(120, 250, 255), Halo = Color3.fromRGB(150, 220, 255),
	},
	MythicEgg = {
		Tint = 5, Spots = false, Body = Color3.fromRGB(118, 60, 220), Cracks = Color3.fromRGB(110, 255, 255),
		Sparks = Color3.fromRGB(255, 230, 90), Halo = Color3.fromRGB(210, 170, 255),
	},
}

function ShopEgg.look(eggId: string): Look
	return LOOKS[eggId] or LOOKS.BasicEgg
end

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material, ball: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = "Trim"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = mat
	if ball then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	p.Parent = parent
	return p
end

-- point and outward normal on the egg ellipsoid (half width a, half height b): th from the top, ph round
local function eggPoint(a: number, b: number, th: number, ph: number): (Vector3, Vector3)
	local d = Vector3.new(math.sin(th) * math.cos(ph), math.cos(th), math.sin(th) * math.sin(ph))
	return Vector3.new(d.X * a, d.Y * b, d.Z * a), Vector3.new(d.X / a, d.Y / b, d.Z / a).Unit
end

-- The egg model with its trims; the model is centred on the origin.
function ShopEgg.model(eggId: string, variant: number): Model
	local look = ShopEgg.look(eggId)
	local D = 2
	-- the smooth kit egg or Parts (never the owner's textured pile eggs: their texture would hide the colour)
	local m = GeodeModel.rockShell(variant, D, "ShopEgg", { Tint = look.Tint, Low = not look.Spots, Color = look.Body, NoTexture = look.Body ~= nil })
	local _, ext = m:GetBoundingBox()
	local A, B = ext.X / 2 / 1.1, ext.Y / 2 / 1.25 -- the Bounds part pads the egg by 1.1 x 1.25
	local trims = Instance.new("Model")
	trims.Name = "Trims"
	trims.Parent = m
	-- gloss: a soft white highlight high on the shoulder (every egg)
	local gp, gn = eggPoint(A, B, 0.55, 2.3)
	part(trims, Vector3.new(0.22 * D, 0.12 * D, 0.06 * D), CFrame.lookAt(gp, gp + gn) * CFrame.new(0, 0, -0.01 * D), Color3.new(1, 1, 1), Enum.Material.Neon, true)
	if look.Band then
		-- a metal band round the middle, slightly wider than the egg
		local r = A * 1.04
		part(trims, Vector3.new(2 * r, 0.12 * D, 2 * r), CFrame.new(0, -0.02 * B, 0), look.Band, Enum.Material.Metal, true)
		local n = 6
		for i = 1, n do
			local ph = (i - 1) / n * math.pi * 2
			local p, nrm = eggPoint(A * 1.06, B, math.pi / 2 + 0.02, ph)
			local gem = part(trims, Vector3.new(0.1 * D, 0.1 * D, 0.1 * D), CFrame.lookAt(p, p + nrm), look.Gems or look.Band :: Color3, Enum.Material.Neon, true)
			gem.Name = "Gem"
		end
		-- a crown of small gems near the top
		for i = 1, 5 do
			local ph = (i - 1) / 5 * math.pi * 2 + 0.3
			local p, nrm = eggPoint(A, B, 0.75, ph)
			part(trims, Vector3.new(0.07 * D, 0.07 * D, 0.07 * D), CFrame.lookAt(p, p + nrm), look.Band :: Color3, Enum.Material.Metal, true)
		end
	end
	if look.Cracks then
		-- glowing zigzag cracks: short thin slabs laid along the surface
		local rng = Random.new(77)
		for c = 1, 6 do
			local th = rng:NextNumber(0.5, 1.7)
			local ph = (c - 1) / 6 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
			local dir = if c % 2 == 0 then 1 else -1
			for _ = 1, 3 do
				local th2 = th + rng:NextNumber(0.12, 0.28)
				local ph2 = ph + dir * rng:NextNumber(0.2, 0.45)
				dir = -dir
				local p1 = eggPoint(A, B, th, ph)
				local p2 = eggPoint(A, B, th2, ph2)
				local mid, nrm = eggPoint(A, B, (th + th2) / 2, (ph + ph2) / 2)
				local len = (p2 - p1).Magnitude
				local cf = CFrame.lookAt(mid, mid + nrm, (p2 - p1).Unit) * CFrame.new(0, 0, -0.015 * D)
				part(trims, Vector3.new(0.025 * D, len * 1.08, 0.04 * D), cf, look.Cracks :: Color3, Enum.Material.Neon)
				th, ph = th2, ph2
				if th > 2.4 then
					break
				end
			end
		end
	end
	if look.Sparks then
		-- sparks on a tilted ring round the egg; ShopEgg.view spins the ring
		local ring = Instance.new("Model")
		ring.Name = "Sparks"
		local n = 7
		for i = 1, n do
			local a = (i - 1) / n * math.pi * 2
			local r = A * 1.22
			local s = (0.06 + 0.03 * (i % 2)) * D
			local p = Vector3.new(math.cos(a) * r, math.sin(a * 3) * 0.08 * D, math.sin(a) * r)
			part(ring, Vector3.new(s, s, s), CFrame.new(p), if i % 3 == 0 then (look.Cracks or look.Sparks) :: Color3 else look.Sparks :: Color3, Enum.Material.Neon, true)
		end
		local pivot = part(ring, Vector3.new(0.1, 0.1, 0.1), CFrame.new(), Color3.new(), Enum.Material.SmoothPlastic)
		pivot.Transparency = 1
		pivot.Name = "Pivot"
		ring.PrimaryPart = pivot
		ring:PivotTo(CFrame.Angles(math.rad(-18), 0, math.rad(10)))
		ring.Parent = m
	end
	return m
end

export type ViewOpts = {
	Yaw: number?, -- degrees
	Pitch: number?, -- degrees
	Spin: boolean?, -- idle spin + bob (default true)
	Halo: boolean?, -- the disc behind the egg (default true)
	Variant: number?, -- GeodeModel pattern variant
	Image: number?, -- an owner picture instead of the 3D egg (0 / nil = none)
}

-- The egg in a still ViewportFrame (or an ImageLabel when the owner gave a picture) with a halo disc behind it.
function ShopEgg.view(parent: Instance, eggId: string, props: { [string]: any }?, opts: ViewOpts?): GuiObject
	local o: ViewOpts = opts or {}
	local look = ShopEgg.look(eggId)
	local host = Instance.new("Frame")
	host.Name = "Egg"
	host.BackgroundTransparency = 1
	host.ZIndex = 5
	UI.apply(host, props)
	host.Parent = parent
	if o.Halo ~= false then
		local halo = Instance.new("Frame")
		halo.Name = "Halo"
		halo.AnchorPoint = Vector2.new(0.5, 0.5)
		halo.Position = UDim2.fromScale(0.5, 0.54)
		halo.Size = UDim2.fromScale(0.84, 0.84)
		halo.BackgroundColor3 = look.Halo
		halo.BackgroundTransparency = 0.45
		halo.BorderSizePixel = 0
		halo.ZIndex = host.ZIndex
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = halo
		local glow = Instance.new("UIStroke")
		glow.Color = look.Halo
		glow.Thickness = 6
		glow.Transparency = 0.6
		glow.Parent = halo
		halo.Parent = host
	end
	if o.Image and o.Image > 0 then
		local img = Instance.new("ImageLabel")
		img.Name = "Picture"
		img.BackgroundTransparency = 1
		img.Image = "rbxassetid://" .. tostring(o.Image)
		img.ScaleType = Enum.ScaleType.Fit
		img.Size = UDim2.fromScale(1, 1)
		img.ZIndex = host.ZIndex + 1
		img.Parent = host
		return host
	end
	local vp = Instance.new("ViewportFrame")
	vp.Name = "View"
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(170, 168, 165)
	vp.LightColor = Color3.fromRGB(255, 246, 230)
	vp.LightDirection = Vector3.new(-0.4, -0.75, 0.5)
	vp.Size = UDim2.fromScale(1, 1)
	vp.ZIndex = host.ZIndex + 1
	vp.Parent = host
	local m = ShopEgg.model(eggId, o.Variant or 1)
	local yaw0 = math.rad(o.Yaw or -20)
	local pitch0 = math.rad(o.Pitch or 0)
	m:PivotTo(CFrame.Angles(0, yaw0, pitch0))
	m.Parent = vp
	local cf, ext = m:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 28
	cam.Parent = vp
	vp.CurrentCamera = cam
	local radius = ext.Magnitude / 2 * 0.8
	local dist = radius / math.tan(math.rad(14))
	local p = math.rad(14)
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, math.sin(p) * dist, -math.cos(p) * dist), cf.Position)
	if o.Spin ~= false then
		local t = 0
		local sparks = m:FindFirstChild("Sparks")
		local conn = RunService.RenderStepped:Connect(function(dt: number)
			t += dt
			m:PivotTo(CFrame.new(0, math.sin(t * 2.2) * 0.04, 0) * CFrame.Angles(0, yaw0 + math.sin(t * 0.9) * 0.35, pitch0))
			if sparks and sparks:IsA("Model") then
				sparks:PivotTo(CFrame.Angles(math.rad(-18), t * 1.6, math.rad(10)))
			end
		end)
		host.Destroying:Connect(function()
			conn:Disconnect()
		end)
	end
	return host
end

return ShopEgg
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="376">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[--!strict
-- UPGRADES (boards 4, 5 and additional 1-3): one shop shell for every category. Tabs only for categories that
-- exist (Tools, Machines when enabled, Storage, Tiers, Gallery, and the cosmetic Store once a real product id is
-- set). Each tab builds Specs from Config and the profile (names, prices, effects, ownership: nothing invented
-- here); the shell shows them as a catalog list on the left and ONE selected-item view on the right (portrait:
-- stacked) with a picture, one effect line, the real price or requirement and one action in its true state:
-- BUY / UPGRADE / UNLOCK / EQUIP / INSTALL, or EQUIPPED / OWNED / LOCKED / NOT ENOUGH CASH / PURCHASING.
-- Purchases ask for confirmation first (item, price, consequence); nothing is sent until CONFIRM. The server
-- re-checks everything and the interface follows its reply (profile update or a refusal notification).
--
-- Entry points: ShopPanel.open(tab?) (the HUD tile and the lobby Upgrades counter both call it).

local MarketplaceService = game:GetService("MarketplaceService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Cosmetics = require(Shared.Cosmetics)
local ProgressConfig = require(Shared.ProgressConfig)
local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local PanelSkin = require(script.Parent.PanelSkin)
local HudArt = require(script.Parent.HudArt)
local Theme = require(script.Parent.Theme)
local Juice = require(script.Parent.Juice)
local ModelThumb = require(script.Parent.ModelThumb)
local ItemView = require(script.Parent.ItemView)
local UpgradePreview = require(script.Parent.Parent.UpgradePreview)
local PetShop = require(script.Parent.PetShop)
local StyleKit = require(script.Parent.StyleKit)

local T = UI.T
local TC = Theme.Color
local ShopPanel = {}

-- Preview/development only: the ReplicatedStorage attribute "DevShopMock" = N appends N made-up Tools entries
-- (never granted, never sent to the server) so the shell can be checked with long lists. Nothing in the game sets
-- it; the offline preview scene `shop --set mock=N` does.
local function devMock(): number
	local n = game:GetService("ReplicatedStorage"):GetAttribute("DevShopMock")
	return if type(n) == "number" then math.clamp(math.floor(n), 0, 100) else 0
end

local tab = "Gear"
local body: Frame? = nil
local panelRef: Frame? = nil
local open = false
local selected: { [string]: string } = {} -- tab -> Spec.Key
local listScroll = Vector2.zero
local pending: { Key: string, At: number }? = nil -- a purchase / equip waiting for the server
local PENDING_SECONDS = 6

local TABS = { "Gear", "Nests", "Storage", "Tiers", "Gallery", "Store", "Robux" } -- "Robux" opens the EGG SHOP

-- `px` real pixels in logical units at the current layer scale (rows and tags are set from the real size they
-- must reach: a 50 logical row drew about 40 real px on the Studio phone window)
local function realPx(px: number): number
	return math.ceil(px / math.max(UI.Scale, 0.5))
end

-- Style test #1 POLYGON ADVENTURE (visual only): parchment panel, tan edges, gold gems, green active tab / buy button,
-- cream cards with a green selected outline, dark brown words. Re-applied after every render.
local PARCH, TAN, CREAMC = Color3.fromRGB(248, 236, 208), Color3.fromRGB(184, 144, 86), Color3.fromRGB(255, 249, 232)
local BROWN, GREENF, GREENL = Color3.fromRGB(70, 44, 20), Color3.fromRGB(120, 200, 110), Color3.fromRGB(58, 140, 52)
local ORANGE = Color3.fromRGB(232, 120, 30)
local GREEN_BTN: StyleKit.ButtonSkin = { Fill = GREENF, Hover = Color3.fromRGB(140, 214, 128), Line = GREENL, Text = BROWN, OffFill = Color3.fromRGB(214, 204, 178), OffText = Color3.fromRGB(120, 104, 78) }
local CREAM_BTN: StyleKit.ButtonSkin = { Fill = CREAMC, Hover = Color3.fromRGB(255, 240, 200), Line = TAN, Text = BROWN, OffFill = Color3.fromRGB(214, 204, 178), OffText = Color3.fromRGB(120, 104, 78) }

-- The kit panel picture is on (UI.kitPanel): the style test's drawn extras (gems, rail, recoloured buttons) step
-- aside and the kit draws the frame; only the parchment fill and the dark words stay (Studio check 2026-10-14).
local function kitOn(): boolean
	return panelRef ~= nil and (panelRef :: Frame):GetAttribute("KitOn") == true
end

local function skinPanel(panel: Frame)
	if Theme.PetStyle then
		return -- the shared pet look draws the sheet
	end
	StyleKit.panel(panel, PARCH, TAN, 4, Color3.fromRGB(214, 176, 80), GREENF, GREENL, BROWN)
	if panel:GetAttribute("KitOn") then
		return
	end
	for _, c in panel:GetChildren() do
		if c:IsA("ImageLabel") then
			c.Visible = false
		end
	end
	StyleKit.cornerGems(panel, Color3.fromRGB(255, 200, 60), Color3.fromRGB(150, 100, 20), 14, true)
end

local function skinBody(b: Frame)
	if Theme.PetStyle then
		return
	end
	for _, d in b:GetDescendants() do
		if d:IsA("GuiButton") and d:GetAttribute("Style") ~= nil then
			if kitOn() then
				continue -- kit primaries and flat secondaries keep their own look
			end
			local st = d:GetAttribute("Style")
			if st == "gold" or st == "green" then
				StyleKit.button(d, GREEN_BTN)
			elseif st == "gray" then
				StyleKit.button(d, CREAM_BTN)
			end
		elseif d:IsA("TextButton") and string.sub(d.Name, 1, 4) == "Row_" then
			StyleKit.holdBg(d, { TC.Inset, TC.InsetHover }, CREAMC)
			local sk = d:FindFirstChildOfClass("UIStroke")
			if sk then
				sk.Color = if d:GetAttribute("Selected") == true then GREENL else TAN
			end
		elseif d:IsA("Frame") and (d.Name == "Detail" or d.Name == "Status") then
			local equipped = d.Name == "Status" and StyleKit.near(d.BackgroundColor3, TC.GoldDim)
			local fr = d :: Frame
			fr.BackgroundColor3 = if equipped then GREENF elseif d.Name == "Detail" then CREAMC else PARCH
			local sk = fr:FindFirstChildOfClass("UIStroke")
			if sk then
				sk.Color = if equipped then GREENL else TAN
			end
		elseif d:IsA("TextLabel") and d.Name == "MoreHint" then
			d.BackgroundColor3 = Color3.fromRGB(150, 110, 60)
		end
	end
	StyleKit.text(b, function(l: TextLabel): Color3?
		if l.Name == "MoreHint" or l.Name == "Label" and l.Parent and l.Parent:GetAttribute("Style") ~= nil then
			return nil
		end
		local c = l.TextColor3
		if l.Name == "PickedArrow" then
			return ORANGE
		elseif l.Name == "Word" and l.Parent and l.Parent.Name == "Status" then
			local pf = l.Parent :: Frame
			return if StyleKit.near(pf.BackgroundColor3, GREENF) then BROWN else nil
		elseif StyleKit.near(c, TC.DarkText) then
			return nil
		elseif c.R + c.G + c.B > 2.3 then
			return BROWN -- white / pale words made for a blue panel
		elseif c.R > 0.9 and c.B < 0.3 then
			return Color3.fromRGB(176, 100, 10) -- gold and orange counts
		elseif c.G > 0.8 and c.R < 0.6 then
			return GREENL -- coin green
		end
		return nil
	end)
	-- a quiet row of low-poly accents: the tabs sit on a green rail
	local tabs = b:FindFirstChild("Tabs")
	if tabs and tabs:IsA("GuiObject") and not b:FindFirstChild("TabRail") and not kitOn() then
		local rail = Instance.new("Frame")
		rail.Name = "TabRail"
		rail.BackgroundColor3 = Color3.fromRGB(196, 226, 168)
		rail.BorderSizePixel = 0
		rail.Position = UDim2.new(0, -4, 0, -3)
		rail.Size = UDim2.new(1, 8, 0, T.Tab + 6)
		rail.ZIndex = math.max(tabs.ZIndex - 1, 0)
		local rs = Instance.new("UIStroke")
		rs.Color = GREENL
		rs.Thickness = 2
		rs.Parent = rail
		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(0, 10)
		rc.Parent = rail
		rail.Parent = b
	end
end

local function shop(action: string, id: any?)
	Net.event("ShopAction"):FireServer(action, id)
end

local function store(action: string, id: string)
	Net.event("StoreAction"):FireServer(action, id)
end

-- Robux price as Roblox reports it for the product (never invented here); until known the config placeholder.
local priceCache: { [number]: string } = {}
local priceAsked: { [number]: boolean } = {}
local render
local function robuxPrice(entry): string
	local cached = priceCache[entry.ProductId]
	if cached then
		return cached
	end
	if not priceAsked[entry.ProductId] then
		priceAsked[entry.ProductId] = true
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(entry.ProductId, Enum.InfoType.Product)
			end)
			if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
				priceCache[entry.ProductId] = "R$ " .. info.PriceInRobux
				render()
			end
		end)
	end
	return entry.PriceText
end

-- One catalog entry.
--   State: "buy" (cash purchase: Buy / Upgrade / Unlock), "equip" (owned, can be equipped / installed),
--          "equipped" (in use), "owned" (included / already bought), "locked" (a requirement is missing),
--          "fixed" (a capacity with no upgrade), "max" (fully upgraded), "robux" (cosmetic store)
export type Spec = {
	Key: string,
	Title: string,
	Thumb: (Instance, number) -> (), -- draws the picture into a container (size hint)
	Effect: string, -- one real effect / stat line
	Note: string?, -- one more line (requirement, consequence)
	State: string,
	Price: number?,
	PriceText: string?, -- Robux text
	Verb: string?, -- BUY / UPGRADE / UNLOCK / EQUIP / INSTALL / REMOVE
	Confirm: string?, -- confirmation question for cash purchases
	Consequence: string?, -- what the purchase does (shown in the confirmation)
	Reason: string?, -- why it is locked
	Action: (() -> ())?,
	Preview: string?, -- tool / machine id for the lobby pedestal
	Capacity: number?, -- "fixed" entries: the size shown in the detail view
	Unit: string?,
}

local function iconThumb(kind: string): (Instance, number) -> ()
	return function(parent: Instance, size: number)
		UI.icon(parent, kind, size, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
	end
end

-- the owner's 3D pet gear model (Assets.Kit.Gear_<Id> via ItemView; ItemView draws its own icon when it is missing)
local function gearThumb(id: string): (Instance, number) -> ()
	return function(parent: Instance, size: number)
		ItemView.make(parent, id, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(size, size) }, size)
	end
end

local function kitThumb(kit: string, icon: string): (Instance, number) -> ()
	return function(parent: Instance, size: number)
		ModelThumb.make(parent, kit, icon, size)
	end
end

-- Catalog data per tab ------------------------------------------------------------------------

local function cashState(price: number, cash: number): string
	return if cash >= price then "buy" else "poor"
end


local function toolSpecs(prof, cash: number): { Spec }
	local specs = {}
	for _, id in Config.HandheldOrder do
		local h = Config.Handhelds[id]
		local unit = if h.Hold then "pulses/s" else "taps/s"
		local spec: Spec = {
			Key = id, Title = h.Name, Thumb = gearThumb(id), Preview = id,
			Effect = "Find power " .. h.Damage .. " \u{b7} " .. string.format("%.1f", h.Rate) .. " " .. unit,
			Note = if h.Hold then "Hold to hatch eggs faster at your nest." else "Helps you hatch eggs at your nest.",
			State = cashState(h.Price, cash), Price = h.Price, Verb = "BUY",
			Confirm = "Buy this gear?", Consequence = "It is equipped right away.",
			Action = function()
				shop("BuyHandheld", id)
			end,
		}
		-- side by side with what you hold now, so the step up is easy to see
		local now = Config.Handhelds[prof.EquippedHandheld]
		if now and prof.EquippedHandheld ~= id then
			spec.Effect ..= "  (yours: Find power " .. now.Damage .. ")"
			-- the confirmation shows the change: what you hold now -> what you get
			local nowUnit = if now.Hold then "pulses/s" else "taps/s"
			spec.Consequence = "Find power " .. now.Damage .. " -> " .. h.Damage .. ", " .. string.format("%.1f", now.Rate) .. " " .. nowUnit
				.. " -> " .. string.format("%.1f", h.Rate) .. " " .. unit .. ". It is equipped right away."
		end
		if prof.EquippedHandheld == id then
			spec.State = "equipped"
		elseif prof.EquipmentOwned[id] then
			spec.State, spec.Verb = "equip", "EQUIP"
			spec.Action = function()
				shop("Equip", id)
			end
		end
		table.insert(specs, spec)
	end
	for i = 1, devMock() do
		table.insert(specs, {
			Key = "DevMock" .. i, Title = "Test item " .. i .. (if i % 5 == 0 then " with a very long catalog name" else ""), Thumb = iconThumb("boostLuck"),
			Effect = "Development mock: not a real item", State = if i % 3 == 0 then "equip" elseif i % 3 == 1 then "poor" else "locked",
			Price = i * 100, Verb = "EQUIP", Reason = "Development mock", Action = function() end,
		})
	end
	return specs
end

local MACHINE_ICON = { AutoCracker = "machine", HydraulicPress = "press", IndustrialCrusher = "crusher" }

local function machineSpecs(prof, cash: number): { Spec }
	local specs = {}
	for _, id in Config.MachineOrder do
		local mc = Config.Machines[id]
		local rate = mc.RocksPerBatch / mc.BatchSeconds
		local spec: Spec = {
			Key = id, Title = mc.Name, Thumb = gearThumb(id), Preview = id,
			Effect = "Hatches eggs for you automatically.",
			Note = string.format("%.1f eggs/s at your nest. It never fetches eggs.", rate),
			State = cashState(mc.Price, cash), Price = mc.Price, Verb = "BUY",
			Confirm = "Buy this nest upgrade?", Consequence = "It is set up at your nest right away.",
			Action = function()
				shop("BuyMachine", id)
			end,
		}
		if prof.InstalledMachine == id then
			spec.State = "equipped"
		elseif prof.EquipmentOwned[id] then
			spec.State, spec.Verb = "equip", "INSTALL"
			spec.Action = function()
				shop("InstallMachine", id)
			end
		end
		local _ = MACHINE_ICON
		table.insert(specs, spec)
	end
	return specs
end

-- Storage: the three capacities a player deals with, each upgraded with coins: the candy bag (Config.Capacity), the
-- carry basket and the hatch nest (shared/ProgressConfig; the server enforces the sizes in the round core).
-- One level at a time; the request names the level shown so a stale screen cannot buy twice.
local function levelSpec(key: string, title: string, thumb: (Instance, number) -> (), level: number, list: { any }, size: (any) -> number, unit: string, action: string, cash: number): Spec
	local lvl = ProgressConfig.clampLevel(level, #list)
	local cur, nxt = list[lvl], list[lvl + 1]
	local spec: Spec = {
		Key = key, Title = cur.Name, Thumb = thumb,
		Effect = (if key == "Basket" then "Carry " .. size(cur) .. " eggs per trip." else "Holds " .. size(cur) .. " eggs in your nest."),
		State = "max",
	}
	if nxt then
		spec.Note = "Next: " .. nxt.Name .. " (" .. size(nxt) .. " " .. unit .. ")."
		spec.State = cashState(nxt.Price, cash)
		spec.Price = nxt.Price
		spec.Verb = "UPGRADE"
		spec.Confirm = "Upgrade to the " .. nxt.Name .. "?"
		spec.Consequence = "From " .. size(cur) .. " to " .. size(nxt) .. " " .. unit .. ". Paid with coins."
		spec.Action = function()
			shop(action, lvl + 1)
		end
	else
		spec.Note = "Best " .. string.lower(title) .. " reached."
	end
	return spec
end

local function storageSpecs(prof, cash: number): { Spec }
	local specs = {}
	local upgrades = {
		levelSpec("Basket", "Basket", iconThumb("basket"), prof.BasketLevel or 1, ProgressConfig.Baskets, function(b)
			return b.Carry
		end, "eggs per trip", "BuyBasket", cash),
		levelSpec("Queue", "Nest", iconThumb("queue"), prof.NestLevel or 1, ProgressConfig.Nests, function(n)
			return n.Queue
		end, "eggs waiting", "BuyNest", cash),
	}
	local curLvl = prof.CapacityTier
	local cur = Config.Capacity[curLvl]
	local nxt = Config.Capacity[curLvl + 1]
	local rubble: Spec = {
		Key = "Rubble", Title = "Candy bag", Thumb = kitThumb("Station_RubbleBin", "rubble"),
		Effect = "Stores " .. (if cur then cur.Size else prof.Capacity) .. " candy before you sell.",
		State = "max",
	}
	if nxt then
		rubble.Note = "Next: " .. nxt.Size .. " candy."
		rubble.State = cashState(nxt.Price, cash)
		rubble.Price = nxt.Price
		rubble.Verb = "UPGRADE"
		rubble.Confirm = "Upgrade candy bag?"
		rubble.Consequence = "Storage grows from " .. (if cur then cur.Size else prof.Capacity) .. " to " .. nxt.Size .. " candy."
		rubble.Action = function()
			shop("BuyCapacity", curLvl + 1) -- the level this screen showed (the server refuses a stale one)
		end
	else
		rubble.Note = "Largest size reached."
	end
	table.insert(specs, rubble)
	for _, u in upgrades do
		table.insert(specs, u)
	end
	return specs
end

local function tierSpecs(prof, cash: number): { Spec }
	local specs = {}
	for i, tid in Config.TierOrder do
		local tier = Config.Tiers[tid]
		local spec: Spec = {
			Key = tid, Title = tier.Name, Thumb = iconThumb("tier" .. i),
			Effect = tier.Rocks .. " eggs \u{b7} candy pays " .. tier.CashPerRubble .. " coins each",
			Note = "Eggs need " .. tier.HP .. " tap" .. (if tier.HP == 1 then "" else "s") .. " to hatch. Pets from " .. tier.GeodeBase .. " coins.",
			State = "owned",
		}
		if not prof.UnlockedTiers[tid] then
			local prevOk = i == 1 or prof.UnlockedTiers[Config.TierOrder[i - 1]]
			local findsOk = prof.Finds >= tier.UnlockFinds
			if not prevOk then
				spec.State = "locked"
				spec.Reason = "Unlock " .. Config.Tiers[Config.TierOrder[i - 1]].Name .. " first."
			elseif not findsOk then
				spec.State = "locked"
				spec.Reason = "Needs " .. tier.UnlockFinds .. " pet finds (you have " .. prof.Finds .. ")."
			else
				spec.State = cashState(tier.UnlockCash, cash)
			end
			spec.Price = tier.UnlockCash
			spec.Verb = "UNLOCK"
			spec.Confirm = "Unlock " .. tier.Name .. "?"
			spec.Consequence = "You can pick " .. tier.Name .. " piles when you start a hunt."
			spec.Action = function()
				shop("UnlockTier", tid)
			end
		else
			spec.Reason = "Pick it when you start a hunt."
		end
		table.insert(specs, spec)
	end
	return specs
end

local function gallerySpecs(prof, cash: number): { Spec }
	local specs = {}
	for lvl, info in Config.Display do
		local spec: Spec = {
			Key = "Disp" .. lvl, Title = info.Slots .. "-slot display", Thumb = kitThumb("Gallery_Cabinet", "display"),
			Effect = "Show up to " .. info.Slots .. " pets in the lobby.", State = "owned",
		}
		if prof.DisplayCapacity == lvl then
			spec.State = "equipped"
		elseif prof.DisplayCapacity > lvl then
			spec.State = "owned"
			spec.Note = "Included in your bigger display."
		elseif prof.DisplayCapacity + 1 == lvl then
			spec.State = cashState(info.Price, cash)
			spec.Price = info.Price
			spec.Verb = "UPGRADE"
			spec.Confirm = "Upgrade your display?"
			spec.Consequence = "Your lobby display grows to " .. info.Slots .. " slots."
			spec.Action = function()
				shop("BuyDisplay", lvl)
			end
		else
			spec.State = "locked"
			spec.Price = info.Price
			spec.Reason = "Buy the smaller display first."
		end
		table.insert(specs, spec)
	end
	return specs
end

local function storeSpecs(prof): { Spec }
	local specs = {}
	local state = prof.Cosmetics or { Owned = {}, Equipped = {} }
	for _, e in Cosmetics.list() do
		local spec: Spec = {
			Key = e.Id, Title = e.Name, Thumb = iconThumb("gem"), Effect = Config.CosmeticKinds[e.Kind] .. ". " .. e.Desc,
			Note = "Cosmetic only, never power.", State = "robux", PriceText = nil, Verb = "BUY",
		}
		if Cosmetics.owned(state, e.Id) then
			local on = state.Equipped[e.Kind] == e.Id
			spec.State, spec.Verb = "equip", if on then "REMOVE" else "EQUIP"
			spec.Action = function()
				if on then
					store("Unequip", e.Kind)
				else
					store("Equip", e.Id)
				end
			end
		else
			spec.PriceText = robuxPrice(e)
			spec.Action = function()
				store("Buy", e.Id) -- Roblox shows its own purchase prompt with the real price
			end
		end
		table.insert(specs, spec)
	end
	return specs
end

local function specsFor(prof): { Spec }
	local cash = prof.Cash
	if tab == "Gear" then
		return toolSpecs(prof, cash)
	elseif tab == "Nests" then
		return machineSpecs(prof, cash)
	elseif tab == "Storage" then
		return storageSpecs(prof, cash)
	elseif tab == "Tiers" then
		return tierSpecs(prof, cash)
	elseif tab == "Store" then
		return storeSpecs(prof)
	end
	return gallerySpecs(prof, cash)
end

-- Row status line and colour (what the row says under its name).
local function rowStatus(s: Spec): (string, Color3)
	if pending and pending.Key == s.Key then
		return "Purchasing\u{2026}", TC.Muted
	elseif s.State == "equipped" then
		return if tab == "Nests" then "Installed" elseif tab == "Gallery" then "Current" else "Equipped", if Theme.PetStyle then Theme.Pet.Blue else TC.Gold
	elseif s.State == "equip" then
		return "Owned", TC.Green
	elseif s.State == "owned" then
		return if tab == "Tiers" then "Unlocked" else "Owned", TC.Green
	elseif s.State == "fixed" then
		return "Holds " .. tostring(s.Capacity or "") .. " \u{b7} standard", TC.Muted
	elseif s.State == "max" then
		return "Max size", TC.Gold
	elseif s.State == "locked" then
		return "Locked", TC.Faint
	elseif s.State == "robux" then
		return s.PriceText or "", TC.Text
	elseif s.Price == 0 then
		return "Free", TC.Cash
	elseif s.Price then
		return UI.money(s.Price), if s.State == "poor" then TC.Faint else TC.Cash
	end
	return "", TC.Muted
end

-- Purchase flow: confirmation (real item, price, consequence), then the request; the item shows PURCHASING
-- until the server's profile update (or a refusal) arrives.
local function act(s: Spec)
	if not s.Action or pending then
		return
	end
	local function send()
		pending = { Key = s.Key, At = os.clock() }
		s.Action()
		render()
		local mine = pending
		task.delay(PENDING_SECONDS, function()
			if pending == mine then
				pending = nil
				render()
			end
		end)
	end
	if s.State == "buy" and s.Price and s.Price > 0 and s.Confirm then
		UI.confirm({
			Name = "ConfirmPurchase",
			Title = s.Confirm,
			Message = s.Title .. ". " .. (s.Consequence or s.Effect),
			Picture = function(c)
				s.Thumb(c, 54)
			end,
			Price = s.Price,
			Confirm = "CONFIRM",
			OnConfirm = send,
		})
	else
		send()
	end
end

-- Renderer -------------------------------------------------------------------------------------

local function detail(parent: Instance, s: Spec)
	local short = UI.isShort()
	local portrait = UI.isPortrait()
	-- a very short landscape phone (about 678 x 310): the pane is barely 120 studs tall, so no picture and one line of text
	local tight = not portrait and UI.Logical.Y < 395
	local f = UI.card(parent, "inset", { Name = "Detail", Size = UDim2.fromScale(1, 1) })
	UI.pad(f, 8, 6)
	local title = UI.text(f, s.Title, { Name = "Title", Font = UI.Head, TextSize = if tight then T.Head - 2 else T.Head + 2, Size = UDim2.new(1, 0, 0, if tight then 22 else 28), TextXAlignment = Enum.TextXAlignment.Center })
	title.TextWrapped = false
	local footH = if tight then 34 else 46
	local textH = if tight then 30 elseif short then 64 else 80 -- room for a two-line description at body size (#237: it shrank to fit)
	local pic = UI.frame(f, { Name = "Picture", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 1, -(30 + textH + footH + 8)), Visible = not tight })
	local picSize = if portrait then 64 elseif short then 60 else 84
	if s.State == "fixed" and s.Capacity then
		-- capacity block: icon beside the size, the area is filled on purpose (no empty preview)
		local row = UI.frame(pic, { Name = "Capacity", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(220, 64) })
		s.Thumb(UI.frame(row, { BackgroundTransparency = 1, Size = UDim2.fromOffset(64, 64) }), 56)
		local n = UI.text(row, tostring(s.Capacity), { Name = "Size", Font = UI.Head, TextSize = 40, TextColor3 = TC.Count, Outline = "Strong", Position = UDim2.fromOffset(72, 0), Size = UDim2.fromOffset(148, 40) })
		n.TextWrapped = false
		UI.text(row, s.Unit or "", { Name = "Unit", Font = UI.Bold, TextSize = T.Small, Outline = "Normal", Position = UDim2.fromOffset(72, 40), Size = UDim2.fromOffset(148, 22) })
	elseif s.Preview then
		-- gear models fill the whole picture area (a fixed 84 box left the model at about a sixth of the frame)
		local vp = ItemView.make(pic, s.Preview, { Name = "Model", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1) }, picSize)
		local ar = Instance.new("UIAspectRatioConstraint")
		ar.AspectRatio = 1
		ar.Parent = vp
	else
		s.Thumb(pic, picSize)
	end
	local about = s.Effect
	local note = s.Reason or s.Note
	if tight then
		about, note = s.Reason or s.Effect, nil -- one line: why it is locked, else what it does
	end
	-- 10 px side padding: the wrapped lines never touch the card's edges (Studio phone window)
	local txt = UI.frame(f, { Name = "About", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -(footH + 4)), Size = UDim2.new(1, -20, 0, textH) })
	-- the description takes the whole block when there is no note, else the larger share (two body-size lines)
	local effH = if note then math.floor(textH * 0.6) else textH
	local eff = UI.text(txt, about, { Name = "Effect", Font = UI.Bold, TextSize = T.Body + 1, Outline = "Normal", Size = UDim2.new(1, 0, 0, effH), TextXAlignment = Enum.TextXAlignment.Center })
	eff.TextWrapped = true
	UI.fit(eff, T.Body + 1, T.Small)
	local noteLabel: TextLabel? = nil
	if note then
		local nl = UI.text(txt, note, { Name = "Note", Font = UI.Bold, TextSize = T.Body, TextColor3 = if s.State == "locked" then TC.Count else TC.Muted, Outline = "Light", Position = UDim2.fromOffset(0, effH), Size = UDim2.new(1, 0, 0, textH - effH), TextXAlignment = Enum.TextXAlignment.Center })
		nl.TextWrapped = true
		UI.fit(nl, T.Body, T.Small)
		noteLabel = nl
	end
	local foot = UI.frame(f, { Name = "Footer", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, footH) })
	local isPending = pending ~= nil and pending.Key == s.Key
	-- information only: plain text, nothing shaped like a button
	if s.State == "fixed" then
		UI.icon(foot, "info", 22, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0) })
		UI.text(foot, "Standard size \u{b7} nothing to buy", { Name = "InfoOnly", Font = UI.Bold, TextSize = T.Small, TextColor3 = TC.Muted, Outline = "Light", Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -40, 1, 0), TextXAlignment = Enum.TextXAlignment.Left })
		return
	end
	-- status states: no button repeating them
	if not isPending and (s.State == "equipped" or s.State == "owned" or s.State == "fixed" or s.State == "max") then
		local word = if s.State == "equipped" then (if tab == "Nests" then "INSTALLED" elseif tab == "Gallery" then "CURRENT" else "EQUIPPED")
			elseif s.State == "owned" then (if tab == "Tiers" then "UNLOCKED" else "OWNED")
			elseif s.State == "max" then "MAX SIZE"
			else "STANDARD SIZE"
		-- pet style: the equipped badge is a blue pill like the shop's OWNED pill (the muddy gold belonged to the old look)
		local pet = Theme.PetStyle and s.State == "equipped"
		local badge = UI.frame(foot, { Name = "Status", Size = UDim2.fromScale(1, 1), BackgroundColor3 = if pet then Theme.Pet.Blue elseif s.State == "equipped" then TC.GoldDim else TC.Inset })
		UI.corner(badge, if pet then 999 else T.Radius)
		UI.stroke(badge, if pet then Theme.Pet.BlueEdge elseif s.State == "equipped" then TC.Gold else TC.InsetEdge, if pet then 3 else 2)
		if pet then
			local g = Instance.new("UIGradient")
			g.Color = ColorSequence.new(Theme.Pet.BlueTop, Theme.Pet.Blue)
			g.Rotation = 90
			g.Parent = badge
		end
		if s.State == "equipped" or s.State == "owned" then
			UI.icon(badge, "check", 24, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0) })
		end
		UI.text(badge, word, { Name = "Word", Font = UI.Head, TextSize = T.Head, TextColor3 = if pet then Color3.new(1, 1, 1) elseif s.State == "equipped" then TC.Gold else TC.Text, Size = UDim2.new(1, -40, 1, 0), Position = UDim2.fromOffset(36, 0), TextXAlignment = Enum.TextXAlignment.Center })
		return
	end
	local text, style, enabled = "", "gold", true
	if isPending then
		text, enabled = "PURCHASING\u{2026}", false
	elseif s.State == "locked" then
		text, enabled = "LOCKED", false
	elseif s.State == "poor" then
		local have = if State.Profile then State.Profile.Cash else 0
		text, enabled = "NEED " .. UI.num(math.max(1, (s.Price or 0) - have)) .. " MORE", false
	elseif s.State == "buy" then
		text = (s.Verb or "BUY") .. (if s.Price and s.Price > 0 then " " .. UI.money(s.Price) elseif s.Price == 0 then " (FREE)" else "")
	elseif s.State == "robux" then
		text = "BUY " .. (s.PriceText or "")
	else
		text = s.Verb or "EQUIP"
	end
	local poor = s.State == "poor" and not isPending
	if poor then
		style = "red" -- NEED N MORE: white on red reads at a glance (grey on grey did not)
	end
	local b = UI.button(foot, text, style, function()
		if poor then
			UI.flashCash() -- a tap makes the coin counter blink red: this is what is missing (nothing is sent)
			return
		end
		act(s)
	end, { Name = "Action", Size = UDim2.fromScale(1, 1), TextSize = T.Head })
	if not enabled and not poor then
		UI.setEnabled(b, false)
	end
	if s.State == "buy" and s.Price and s.Price > 0 and not isPending then
		-- coin picture beside the price
		HudArt.image(b, "Coin", 26, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), ZIndex = 3 })
		Juice.pulse(b, nil, T.Radius) -- an upgrade you can afford breathes a soft glow
	end
	if s.State == "locked" then
		-- a tap on LOCKED shakes the button and the reason under the picture (nothing is sent)
		b.Activated:Connect(function()
			Juice.nope(b)
			if noteLabel then
				Juice.nope(noteLabel)
			end
		end)
	end
end

function render()
	if not open or not body then
		return
	end
	local b = body :: Frame
	local old = b:FindFirstChild("List", true)
	if old and old:IsA("ScrollingFrame") then
		listScroll = old.CanvasPosition
	end
	for _, c in b:GetChildren() do
		if not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
	local prof = State.Profile
	if not prof then
		UI.loadingState(b, "Loading upgrades", { Position = UDim2.fromOffset(0, 60) })
		return
	end
	UI.modalCash(prof.Cash)
	-- tabs: only categories that exist
	local names = {}
	for _, n in TABS do
		if n == "Nests" and not Config.MachinesEnabled then
			continue
		end
		if n == "Store" and not (Cosmetics.anyVisible() and prof.OnboardDone) then
			continue
		end
		if n == "Robux" and UI.isPortrait() then
			continue -- portrait: no room for one more tab; an EGG SHOP button ends the list instead
		end
		table.insert(names, n)
	end
	if not table.find(names, tab) or tab == "Robux" then
		tab = "Gear"
	end
	local items = {}
	for _, n in names do
		local it: { string } = { n, n }
		if n == "Robux" and UI.Logical.X >= 900 then -- narrow phones: the word alone (an icon pushed it out past the tab edge)
			table.insert(it, HudArt.Slots.Egg.Image) -- the EGG SHOP's egg (the coin read as one more coin upgrade)
		end
		table.insert(items, it)
	end
	local tabRow = UI.tabs(b, items, tab, function(name)
		if name == "Robux" then
			PetShop.open() -- the Robux shop is its own menu (PetShop)
			return
		end
		tab = name
		listScroll = Vector2.zero
		render()
	end)
	-- the Robux tab opens another shop: green (gold is the selected tab, so a gold Robux tab read as a second
	-- selected one, Studio #184), so it never reads as one more free tab
	local rt = tabRow:FindFirstChild("Tab_Robux", true)
	if rt and rt:IsA("GuiButton") then
		UI.setStyle(rt, "green")
	end
	-- seven tabs on a phone-size window: the shared bar's floor (body size) still cut "Robux" to "Robu", so every
	-- tab word may shrink to the text floor instead; re-applied after the bar's own re-fit (same signal, later)
	local function wholeWords()
		if not tabRow.Parent then
			return
		end
		for _, tb in tabRow:GetDescendants() do
			if tb:IsA("TextLabel") and tb.Name == "Label" and tb.Parent and string.sub(tb.Parent.Name, 1, 4) == "Tab_" then
				local fc = tb:FindFirstChild("Fit") :: UITextSizeConstraint?
				tb.TextWrapped = false
				UI.fit(tb, if fc then fc.MaxTextSize else T.Body + 2, T.MinText)
				tb.TextWrapped = false
			end
		end
	end
	task.defer(function()
		task.defer(wholeWords)
	end)
	tabRow:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		task.defer(function()
			task.defer(wholeWords)
		end)
	end)

	local specs = specsFor(prof)
	local sel: Spec? = nil
	for _, s in specs do
		if s.Key == selected[tab] then
			sel = s
		end
	end
	if not sel then
		for _, s in specs do
			if s.State == "equipped" then
				sel = s
				break
			end
		end
		sel = sel or specs[1]
	end

	local top = T.Gap + T.Tab
	local content = UI.frame(b, { Name = "Content", Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 1, -top), BackgroundTransparency = 1 })
	local portrait = UI.isPortrait()
	local listHost = UI.frame(content, { Name = "ListHost", BackgroundTransparency = 1, Size = if portrait then UDim2.new(1, 0, 0.5, -4) else UDim2.new(0.52, -4, 1, 0) })
	local pane = UI.frame(content, {
		Name = "Pane", BackgroundTransparency = 1,
		Position = if portrait then UDim2.new(0, 0, 0.5, 4) else UDim2.new(0.52, 4, 0, 0),
		Size = if portrait then UDim2.new(1, 0, 0.5, -4) else UDim2.new(0.48, -4, 1, 0),
	})
	local list = UI.scroller(listHost, { Name = "List", Size = UDim2.new(1, 0, 1, -26) })
	UI.list(list, Enum.FillDirection.Vertical, 6)
	UI.pad(list, 2, 2)
	-- a longer list than fits (Tiers): a "more below" tag until its end is in view
	local more = UI.text(listHost, "\u{25BC} more", {
		Name = "MoreHint", Font = UI.Bold, TextSize = T.Small, Outline = "Normal", AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.fromOffset(84, 22), TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundTransparency = 0.15, BackgroundColor3 = TC.PanelEdge, ZIndex = list.ZIndex + 5,
	})
	UI.corner(more, 10)
	local function hint()
		more.Visible = list.CanvasPosition.Y + list.AbsoluteWindowSize.Y < list.AbsoluteCanvasSize.Y - 6
	end
	list:GetPropertyChangedSignal("CanvasPosition"):Connect(hint)
	list:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(hint)
	list:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(hint)
	task.defer(hint)
	-- rows at least 48 real px tall (50 logical drew about 40 on the Studio phone window)
	local rowH = math.max(if UI.isShort() then 50 else 58, realPx(48))
	if #specs <= 4 and not portrait then
		-- a short list (3 tools) left most of the column empty: taller rows with bigger pictures fill it instead
		rowH = math.max(rowH, if UI.isShort() then 66 else 92)
	end
	local tagH = realPx(20) -- the Equipped / Owned tag
	local arrowH = realPx(22) -- the picked row's arrow
	for i, s in specs do
		local status, color = rowStatus(s)
		local badge: string? = nil
		if s.State == "buy" or s.State == "equip" then
			badge = if s.State == "buy" then (s.Verb or "BUY") else (s.Verb or "EQUIP")
		end
		local row = UI.catalogRow(list, i, {
			Name = "Row_" .. s.Key, Title = s.Title, Sub = status, SubColor = color, Selected = sel ~= nil and s.Key == sel.Key,
			SubPill = s.State == "equipped" or s.State == "equip" or s.State == "owned" or s.State == "max",
			Height = rowH,
			Thumb = function(c)
				s.Thumb(c, rowH - 14)
			end,
			Badge = if pending and pending.Key == s.Key then nil else badge,
			OnBadge = function()
				selected[tab] = s.Key
				act(s)
			end,
			OnSelect = function()
				selected[tab] = s.Key
				-- in the lobby the Upgrades counter's pedestal shows the picked tool or machine (presentation only)
				if s.Preview and not State.Match then
					UpgradePreview.select(s.Preview)
				end
				render()
			end,
		})
		-- the shared row's small parts, sized for the phone window: the price line at body size, the Equipped /
		-- Owned tag at least 20 real px tall, the picked arrow at least 22 (they were tiny in Studio)
		local sub = row:FindFirstChild("Sub") :: TextLabel?
		if sub then
			sub.TextWrapped = false
			UI.fit(sub, T.Body, T.Small)
		end
		local pill = row:FindFirstChild("SubPill") :: Frame?
		if pill and pill.Size.Y.Offset < tagH then
			local word = pill:FindFirstChild("Sub") :: TextLabel?
			pill.Size = UDim2.fromOffset(pill.Size.X.Offset + 4, tagH)
			pill.Position = UDim2.new(0, pill.Position.X.Offset, 0, math.max(rowH - tagH - 4, math.floor(rowH * 0.5) - 2))
			if word then
				UI.fit(word, T.Body, T.Small)
			end
		end
		local arrow = row:FindFirstChild("PickedArrow") :: TextLabel?
		if arrow then
			arrow.Size = UDim2.fromOffset(arrowH + 6, arrowH + 6)
			UI.fit(arrow, arrowH, T.Body)
		end
	end
	if UI.isPortrait() then
		local eggShop = UI.button(list, "EGG SHOP (ROBUX)", "gray", function()
			PetShop.open()
		end, { Name = "RobuxShop", LayoutOrder = #specs + 1, Size = UDim2.new(1, -6, 0, T.Touch), TextSize = T.Body })
		-- the egg left of the words (centred text keeps clear of it on a full-width row)
		HudArt.image(eggShop, "Egg", 30, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0) })
	end
	local keep = listScroll
	if keep == Vector2.zero and sel then
		-- first look at this tab: start with the picked (equipped) item in view
		for i, s in specs do
			if s.Key == sel.Key and i > 2 then
				keep = Vector2.new(0, (i - 2) * (rowH + 6))
				break
			end
		end
	end
	task.defer(function()
		if list.Parent then
			list.CanvasPosition = keep
		end
	end)
	if sel then
		detail(pane, sel)
	end
	skinBody(b)
end

local function modalSize(): Vector2
	if UI.isPortrait() then
		return Vector2.new(480, 680)
	elseif UI.Logical.Y >= 600 then
		return Vector2.new(720, 440)
	end
	return Vector2.new(660, 372)
end

function ShopPanel.open(openTab: string?)
	if type(openTab) == "string" and table.find(TABS, openTab) then
		tab = openTab
	end
	listScroll = Vector2.zero
	local panel, b = UI.modal("Shop", "UPGRADES", modalSize(), { Fixed = true, Cash = true })
	PanelSkin.dress(panel, "Hammer", "UPGRADES")
	panelRef = panel
	skinPanel(panel)
	body = b
	open = true
	local conn, noticeConn
	conn = UI.ModalChanged.Event:Connect(function(name)
		if name ~= "Shop" then
			open = false
			body = nil
			panelRef = nil
			if not State.Match then
				UpgradePreview.select(nil) -- the pedestal goes back to the equipped tool
			end
			conn:Disconnect()
			noticeConn:Disconnect()
		end
	end)
	-- a refusal (not enough cash, requirement) ends the pending state at once
	noticeConn = UI.Notice.Event:Connect(function(_, kind)
		if kind == "warn" and pending then
			pending = nil
			render()
		end
	end)
	render()
end

function ShopPanel.start()
	State.Changed.Event:Connect(function(what)
		if what == "Profile" then
			pending = nil -- the authoritative result arrived
			render()
		end
	end)
end

local _ = panelRef
return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="377">
            <Properties>
              <string name="Name">SpinPanel</string>
              <string name="Source"><![CDATA[--!strict
-- LUCKY SPIN: the free spin wheel (LaunchPerks.Spin, one spin every 4 hours). A drawn pie wheel of the eight slices
-- in LaunchPerks.Spin.Slices order; SPIN asks the server (RetentionAction "Spin"), the server rolls and pays, and its
-- answer ("Spin", { Slice, Text }: SpinView passes it to SpinPanel.land) spins the wheel onto that slice. The client
-- never picks the prize; the wheel only shows what the server already paid.

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local LaunchPerks = require(Shared.LaunchPerks)
local RobuxConfig = require(Shared.RobuxConfig)
local Net = require(Shared.Net)
local State = require(script.Parent.Parent.State)
local Effects = require(script.Parent.Parent.Effects)
local Audio = require(script.Parent.Parent.Audio)
local PopupGate = require(script.Parent.Parent.PopupGate)
local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)
local PetStyle = require(script.Parent.PetStyle)
local Juice = require(script.Parent.Juice)

local T = UI.T
local K = Theme.Pet
local SpinPanel = {}

local SLICES = LaunchPerks.Spin.Slices
local N = #SLICES
local STEP = 360 / N
local TURNS = 5 -- whole turns before the wheel settles on the slice
local SPIN_SECONDS = 4.2

-- slice colours: coins gold, luck potions pink, eggs blue / cyan / purple (the slice order alternates them)
local function sliceColor(sl: LaunchPerks.Slice): (Color3, Color3)
	if sl.Kind == "Coins" then
		return Color3.fromRGB(255, 226, 92), Color3.fromRGB(255, 190, 30)
	elseif sl.Kind == "Potion" then
		return Color3.fromRGB(255, 120, 190), Color3.fromRGB(240, 60, 140)
	elseif sl.Egg == "MythicEgg" then
		return Color3.fromRGB(190, 110, 255), Color3.fromRGB(130, 50, 230)
	elseif sl.Egg == "RareEgg" then
		return Color3.fromRGB(90, 180, 255), Color3.fromRGB(30, 120, 240)
	end
	return K.CyanTop, K.Cyan
end

-- short words for a slice on the wheel ("+500", "5 MIN LUCK", "RARE EGG")
local function sliceWord(sl: LaunchPerks.Slice, tierId: string): string
	if sl.Kind == "Coins" then
		return "+" .. UI.num(LaunchPerks.sliceCoins(sl, tierId))
	elseif sl.Kind == "Potion" then
		return (sl.Minutes or 0) .. " MIN LUCK"
	end
	local e = RobuxConfig.egg(sl.Egg)
	return string.upper(if e then e.Name else "EGG")
end

local function tierId(): string
	local p: any = State.Profile
	return RobuxConfig.eggTier(if p then p.UnlockedTiers else nil)
end

local function clock(sec: number): string
	sec = math.max(0, math.ceil(sec))
	local h, m = sec // 3600, sec % 3600 // 60
	return if h > 0 then string.format("%d:%02d:%02d", h, m, sec % 60) else string.format("%d:%02d", m, sec % 60)
end

-- open panel state
local disc: Frame? = nil
local spinBtn: TextButton? = nil
local resultL: TextLabel? = nil
local hintL: TextLabel? = nil
local spinning = false
local pendingDone: (() -> ())? = nil -- ends the SPINNING... state on the button
local closePanel: (() -> ())? = nil
local open = false

-- the prize pill: shown with its line once the wheel lands, hidden (not an empty bar) before and while spinning
local function showResult(line: string?): TextLabel?
	local l = resultL
	if not l then
		return nil
	end
	l.Text = line or ""
	local pill = l.Parent
	if pill and pill:IsA("GuiObject") then
		pill.Visible = line ~= nil
	end
	return l
end

local function readyIn(): number
	local p: any = State.Profile
	local perks = p and p.Perks
	local left = if type(perks) == "table" and type(perks.SpinIn) == "number" then perks.SpinIn else math.huge
	local seen = p and p.__spinSeen
	-- the profile view's SpinIn was true when the view arrived; count down from then
	if type(seen) == "number" then
		left -= os.clock() - seen
	end
	return left
end

-- The wheel: a round CanvasGroup (it clips to its UICorner) holding the spinning disc of eight wedges. Each wedge is
-- the bottom-right quarter of a full-size square masked to the triangle under its diagonal (a UIGradient step), so
-- the quarter reads as a 45 degree pie slice; the square is rotated about the wheel's centre by the slice's angle.
local function buildWheel(parent: Instance, d: number, props: { [string]: any }): CanvasGroup
	local tier = tierId()
	local group = Instance.new("CanvasGroup")
	group.Name = "Wheel"
	group.BackgroundColor3 = K.Ink
	group.BorderSizePixel = 0
	group.Size = UDim2.fromOffset(d, d)
	for k, v in props do
		(group :: any)[k] = v
	end
	UI.corner(group, d // 2)
	group.Parent = parent
	local spin = UI.frame(group, { Name = "Disc", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	for i, sl in SLICES do
		local holder = UI.frame(spin, { Name = "Slice" .. i, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Rotation = (i - 1) * STEP })
		local top, bottom = sliceColor(sl)
		local wedge = UI.frame(holder, { Name = "Wedge", Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = if i % 2 == 1 then top else bottom })
		UI.corner(wedge, 1) -- (a 1 px round keeps the layout checker's square-corner rule; unseen under the rim)
		local mask = Instance.new("UIGradient")
		mask.Name = "Mask"
		mask.Rotation = -45 -- across the diagonal: the half nearer the top edge stays, the rest goes
		mask.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.499, 1),
			NumberSequenceKeypoint.new(0.501, 0),
			NumberSequenceKeypoint.new(1, 0),
		})
		mask.Parent = wedge
		-- the word along the slice's middle line, read from the centre outwards
		local a = math.rad(STEP / 2)
		local r = 0.33
		local word = PetStyle.words(holder, sliceWord(sl, tier), T.Body, {
			Name = "Word", Font = UI.Head, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + r * math.cos(a), 0.5 + r * math.sin(a)),
			Size = UDim2.fromScale(0.36, 0.11), Rotation = STEP / 2, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3,
			OutlineThick = 2.4,
		})
		word.TextWrapped = false
		UI.fit(word, T.Body, T.MinText)
	end
	-- spoke lines between the slices: a line as wide as the wheel, centred on it, covers two opposite spokes
	for i = 1, N // 2 do
		local line = UI.frame(spin, { Name = "Spoke" .. i, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = K.Ink, Rotation = (i - 1) * STEP, ZIndex = 2 })
		line.BorderSizePixel = 0
	end
	-- hub
	local hub = UI.frame(group, { Name = "Hub", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.24, 0.24), BackgroundColor3 = K.White, ZIndex = 4 })
	UI.corner(hub, d) -- round
	PetStyle.edge(hub, K.Ink, 3)
	local star = PetStyle.words(hub, "\u{2605}", T.Title, { Name = "Star", Font = UI.Head, Size = UDim2.fromScale(1, 1), TextColor3 = K.Gold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5, OutlineThick = 2 })
	star.TextWrapped = false
	UI.fit(star, T.Title, T.Body)
	-- rim
	local rim = UI.frame(group, { Name = "Rim", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 6 })
	UI.corner(rim, d // 2)
	PetStyle.edge(rim, K.Ink, 5)
	disc = spin
	return group
end

local function setButton()
	local b = spinBtn
	if not b then
		return
	end
	local label = b:FindFirstChild("Label") :: TextLabel?
	if spinning or b:GetAttribute("Pending") == true then
		return
	end
	local left = readyIn()
	if left <= 0 then
		UI.setEnabled(b, true, "gold")
		if label then
			label.Text = "SPIN!"
		end
	else
		UI.setEnabled(b, false)
		if label then
			label.Text = "NEXT SPIN IN " .. clock(left)
		end
	end
end

-- Spins the disc onto slice `sliceId` (the server's roll) and then shows `text` as the prize.
function SpinPanel.land(sliceId: string, text: string)
	local d = disc
	if not d or not open then
		return
	end
	local index = 1
	for i, sl in SLICES do
		if sl.Id == sliceId then
			index = i
		end
	end
	spinning = true
	if pendingDone then
		pendingDone()
		pendingDone = nil
	end
	showResult(nil)
	if hintL then
		hintL.Text = "Spinning..."
	end
	-- the pointer sits at the top (-90 degrees): the slice's middle line must end up there
	local middle = (index - 1) * STEP + STEP / 2
	local target = -90 - middle
	local from = d.Rotation % 360
	target = target - 360 * math.floor((target - from) / 360) -- the first target angle past `from`
	target += 360 * TURNS
	Audio.play("UIWhooshSoft", { Key = "ui:spin" })
	if UI.Reduced then
		d.Rotation = target
	else
		local tw = TweenService:Create(d, TweenInfo.new(SPIN_SECONDS, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Rotation = target })
		tw:Play()
		tw.Completed:Wait()
	end
	spinning = false
	if not open then
		return
	end
	-- the pointer bounces as the wheel stops
	local box = d.Parent and d.Parent.Parent
	local pointer = if box then box:FindFirstChild("Pointer") else nil
	if pointer then
		UI.pop(pointer, 1.6)
	end
	local l = showResult(LaunchPerks.spinWon(text))
	if l then
		UI.pop(l, 0.6)
	end
	if hintL then
		hintL.Text = "Come back in 4 hours for another free spin!"
	end
	Effects.confetti() -- (no banner: the prize pill says it, and a banner covered the wheel)
	setButton()
end

function SpinPanel.isOpen(): boolean
	return open
end

local asked = 0
-- The server said no ("SpinNo": too early, or no spin to give): the button comes back and the words say why.
function SpinPanel.refuse(why: string)
	if pendingDone then
		pendingDone()
		pendingDone = nil
	end
	asked = 0
	local b = spinBtn
	if b then
		Juice.nope(b)
	end
	if hintL then
		hintL.Text = why
	end
	setButton()
end

local function onSpin()
	if spinning or readyIn() > 0 or os.clock() - asked < 1.5 then
		return
	end
	asked = os.clock()
	local b = spinBtn
	if b then
		pendingDone = UI.pending(b, "SPINNING...", 6)
	end
	Net.event("RetentionAction"):FireServer("Spin")
end

function SpinPanel.open()
	local short = UI.Logical.Y < 420
	local portrait = UI.isPortrait()
	-- (upright: a shorter panel so the footer stays above Roblox's JUMP button)
	local w, h = 580, if portrait then math.min(600, UI.Logical.Y - 200) elseif short then math.max(300, UI.Logical.Y - 24) else 400
	local panel, body, close, footer = UI.modal("Spin", "LUCKY SPIN", Vector2.new(w, h), { Fixed = true, Footer = 64 })
	open = true
	closePanel = close
	-- toasts wait while the wheel is up (Studio 2026-10-15: a free-egg "You hatched..." toast spoiled the prize mid-spin
	-- and toasts covered the panel's title); they show as soon as the panel closes
	PopupGate.hold("SpinPanel", true)
	local bodyH = h - 64 - 70
	-- landscape: the wheel on the left with its pointer, the words on the right; upright phone: wheel above words
	local d = if portrait then math.clamp(math.floor(bodyH * 0.5), 150, 230) else math.clamp(math.floor(bodyH - 8), 150, 250)
	local wheelBox = UI.frame(body, { Name = "WheelBox", Size = if portrait then UDim2.new(1, 0, 0, d + 20) else UDim2.fromOffset(d + 16, bodyH), BackgroundTransparency = 1 })
	buildWheel(wheelBox, d, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 6) })
	local pointer = PetStyle.words(wheelBox, "\u{25BC}", 34, { Name = "Pointer", Font = UI.Head, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, -d / 2 - 14), Size = UDim2.fromOffset(44, 34), TextColor3 = K.Gold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 8, OutlineThick = 2.6 })
	pointer.TextWrapped = false
	local info = UI.frame(body, { Name = "Info", Position = if portrait then UDim2.fromOffset(0, d + 28) else UDim2.fromOffset(d + 28, 0), Size = if portrait then UDim2.new(1, 0, 1, -(d + 28)) else UDim2.new(1, -(d + 28), 1, 0), BackgroundTransparency = 1 })
	UI.list(info, Enum.FillDirection.Vertical, 8)
	local title = PetStyle.words(info, "FREE SPIN EVERY 4 HOURS!", T.Head, { Name = "Line", Font = UI.Head, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1, TextColor3 = K.QuestTitle, OutlineColor = K.TitleEdge, OutlineThick = 2.4 })
	title.TextWrapped = true
	UI.fit(title, T.Head, T.MinText)
	local blurb = UI.text(info, "Win coins, luck potions or a free egg. Coins grow with your best zone.", { Name = "Blurb", Font = UI.Bold, TextSize = T.Body, TextColor3 = K.TitleEdge, Outline = false, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 2 })
	blurb.TextWrapped = true
	UI.fit(blurb, T.Body, T.MinText)
	-- the prize line: a glossy lime pill, only once the wheel lands (Studio 2026-10-15: an empty green bar before)
	local pill = UI.frame(info, { Name = "Result", Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = K.Lime, LayoutOrder = 3, Visible = false })
	PetStyle.round(pill, 999)
	PetStyle.vgrad(pill, K.LimeTop, K.Lime)
	PetStyle.edge(pill, K.LimeEdge, 2.5)
	local won = PetStyle.words(pill, "", T.Head, { Name = "Won", Font = UI.Head, Size = UDim2.new(1, -16, 1, -6), Position = UDim2.fromOffset(8, 3), TextXAlignment = Enum.TextXAlignment.Center, OutlineColor = K.LimeEdge, OutlineThick = 2.4 })
	won.TextWrapped = false
	UI.fit(won, T.Head, T.MinText)
	resultL = won
	local hint = UI.text(info, "Tap SPIN!", { Name = "Hint", Font = UI.Bold, TextSize = T.Body, TextColor3 = K.TitleEdge, Outline = false, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 4 })
	hint.TextWrapped = false
	UI.fit(hint, T.Body, T.MinText)
	hintL = hint
	if footer then
		spinBtn = UI.button(footer, "SPIN!", "gold", onSpin, { Name = "SpinButton", Size = UDim2.new(1, 0, 1, 0), TextSize = T.Head + 2 })
	end
	setButton()
	-- the countdown ticks while the panel is open
	task.spawn(function()
		while open and panel.Parent do
			task.wait(1)
			if open then
				setButton()
			end
		end
	end)
	local conn: RBXScriptConnection
	conn = UI.ModalChanged.Event:Connect(function(name)
		if name ~= "Spin" then
			PopupGate.hold("SpinPanel", false)
			open = false
			disc, spinBtn, resultL, hintL, closePanel = nil, nil, nil, nil, nil
			conn:Disconnect()
		end
	end)
	-- a new profile view (the clock restarted) refreshes the button
	State.Changed.Event:Connect(function(what)
		if what == "Profile" and open then
			local p: any = State.Profile
			if p then
				p.__spinSeen = os.clock()
			end
			setButton()
		end
	end)
	local p: any = State.Profile
	if p and p.__spinSeen == nil then
		p.__spinSeen = os.clock()
	end
end

function SpinPanel.close()
	if closePanel then
		closePanel()
	end
end

return SpinPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="378">
            <Properties>
              <string name="Name">StyleKit</string>
              <string name="Source"><![CDATA[--!strict
-- Style test helpers (owner's UI style sheet, 2026-10-14). Used ONLY by ShopPanel (#1 POLYGON ADVENTURE) and QuestPanel
-- (#7 ISLAND SIGNPOST). Visual overrides on top of what UI.luau builds: nothing here changes sizes, layout or behaviour,
-- and UI.luau's shared defaults stay as they are. A restyled button keeps its colours through hover / press / disabled
-- repaints because the override follows UI.paint's own property writes.

local Theme = require(script.Parent.Theme)

local TC = Theme.Color
local StyleKit = {}

-- The pet style (Theme.PetStyle, 2026-10-15) draws both panels from the shared look: every override here steps aside.
local OFF = Theme.PetStyle == true

export type ButtonSkin = { Fill: Color3, Hover: Color3, Line: Color3, Text: Color3, OffFill: Color3?, OffText: Color3?, Outline: boolean? }

local function near(a: Color3, b: Color3): boolean
	return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) < 0.02
end
StyleKit.near = near

-- Recolours one UI.button and keeps it recoloured when UI.paint runs again.
function StyleKit.button(b: GuiButton, skin: ButtonSkin)
	if OFF then
		return
	end
	local label = b:FindFirstChild("Label") :: TextLabel?
	local line = b:FindFirstChild("Border") :: UIStroke?
	local outline = if label then label:FindFirstChild("Outline") else nil
	local function apply()
		local off = b:GetAttribute("Disabled") == true
		local want = if off then (skin.OffFill or skin.Fill) elseif b:GetAttribute("Hover") == true then skin.Hover else skin.Fill
		if b:GetAttribute("Pressed") == true and not off then
			want = want:Lerp(Color3.new(0, 0, 0), 0.18)
		end
		if b.BackgroundColor3 ~= want then
			b.BackgroundColor3 = want
		end
		if line then
			local lc = if b:GetAttribute("Selected") then skin.Text else skin.Line
			if line.Color ~= lc then
				line.Color = lc
			end
		end
		if label then
			local tc = if off then (skin.OffText or skin.Text) else skin.Text
			if label.TextColor3 ~= tc then
				label.TextColor3 = tc
			end
			if outline and outline:IsA("UIStroke") then
				local en = skin.Outline == true
				if outline.Enabled ~= en then
					outline.Enabled = en
				end
			end
		end
	end
	apply()
	b:GetPropertyChangedSignal("BackgroundColor3"):Connect(apply)
	if label then
		label:GetPropertyChangedSignal("TextColor3"):Connect(apply)
	end
	if outline and outline:IsA("UIStroke") then
		outline:GetPropertyChangedSignal("Enabled"):Connect(apply)
	end
end

-- Holds a frame/button background: any write of a colour in `from` becomes `to` (row hover repaints).
function StyleKit.holdBg(g: GuiObject, from: { Color3 }, to: Color3)
	if OFF then
		return
	end
	local function fix()
		for _, c in from do
			if near(g.BackgroundColor3, c) then
				g.BackgroundColor3 = to
				return
			end
		end
	end
	fix()
	g:GetPropertyChangedSignal("BackgroundColor3"):Connect(fix)
end

-- Text colour remap for words that were white / pale / gold / green for a blue panel; `fn` returns the new colour or nil.
function StyleKit.text(root: Instance, fn: (TextLabel) -> Color3?)
	if OFF then
		return
	end
	for _, d in root:GetDescendants() do
		if d:IsA("TextLabel") then
			local c = fn(d)
			if c then
				d.TextColor3 = c
				local o = d:FindFirstChild("Outline")
				if o and o:IsA("UIStroke") then
					o.Enabled = false
				end
			end
		end
	end
end

-- A faceted gem: a small square turned 45 degrees, flat fill and a darker edge.
function StyleKit.gem(parent: Instance, name: string, pos: UDim2, size: number, fill: Color3, edge: Color3): Frame
	local g = Instance.new("Frame")
	g.Name = name
	if OFF then
		g.Visible = false
		g.Parent = parent
		return g
	end
	g.AnchorPoint = Vector2.new(0.5, 0.5)
	g.Position = pos
	g.Size = UDim2.fromOffset(size, size)
	g.Rotation = 45
	g.BackgroundColor3 = fill
	g.BorderSizePixel = 0
	g.ZIndex = 40
	local s = Instance.new("UIStroke")
	s.Color = edge
	s.Thickness = 2
	s.Parent = g
	-- a lighter facet on the upper half
	local f = Instance.new("Frame")
	f.Name = "Facet"
	f.BackgroundColor3 = fill:Lerp(Color3.new(1, 1, 1), 0.5)
	f.BorderSizePixel = 0
	f.Size = UDim2.fromScale(0.5, 0.5)
	f.ZIndex = g.ZIndex + 1
	f.Parent = g
	g.Parent = parent
	return g
end

-- Corner gems (four corners plus the middle of both sides when `sides`).
function StyleKit.cornerGems(panel: Instance, fill: Color3, edge: Color3, size: number, sides: boolean)
	if OFF then
		return
	end
	local pts = { UDim2.fromOffset(6, 6), UDim2.new(1, -6, 0, 6), UDim2.new(0, 6, 1, -6), UDim2.new(1, -6, 1, -6) }
	for i, p in pts do
		StyleKit.gem(panel, "Gem" .. i, p, size, fill, edge)
	end
	if sides then
		StyleKit.gem(panel, "GemL", UDim2.new(0, 2, 0.5, 0), size - 2, fill, edge)
		StyleKit.gem(panel, "GemR", UDim2.new(1, -2, 0.5, 0), size - 2, fill, edge)
	end
end

-- Recolours the stroke of the panel's own edge and its Rim frame, and the header's tab / coin pill.
function StyleKit.panel(panel: Frame, bg: Color3, edge: Color3, edgeThick: number, rim: Color3, tab: Color3, tabEdge: Color3, tabText: Color3?)
	if OFF then
		return
	end
	panel.BackgroundColor3 = bg
	local e = panel:FindFirstChildOfClass("UIStroke")
	if e then
		e.Color = edge
		e.Thickness = edgeThick
	end
	local r = panel:FindFirstChild("Rim")
	local rs = if r then r:FindFirstChildOfClass("UIStroke") else nil
	if rs then
		rs.Color = rim
	end
	local header = panel:FindFirstChild("Header")
	if not header then
		return
	end
	local t = header:FindFirstChild("Tab")
	if t and t:IsA("GuiObject") then
		t.BackgroundColor3 = tab
		local ts = t:FindFirstChildOfClass("UIStroke")
		if ts then
			ts.Color = tabEdge
		end
		if tabText then
			for _, d in t:GetDescendants() do
				if d:IsA("TextLabel") then
					d.TextColor3 = tabText
					local o = d:FindFirstChild("Outline")
					if o and o:IsA("UIStroke") then
						o.Enabled = false
					end
				end
			end
		end
	end
	local cash = header:FindFirstChild("Cash")
	local cs = if cash then cash:FindFirstChildOfClass("UIStroke") else nil
	if cs then
		cs.Color = tabEdge
	end
end

local _ = TC
return StyleKit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="379">
            <Properties>
              <string name="Name">TapFight</string>
              <string name="Source"><![CDATA[--!strict
-- Tap to fight (carter 2026-10-16: "Fight part is thin"): the player's hands in a Pet Battle.
-- TAP anywhere on the fight = a quick extra hit (a POW pop under the finger at once, the server's hit on the rival pet
-- when it lands) and a COMBO counter. A gold ring on one of our pets = a rival's big move is coming: BLOCK in time
-- for PERFECT! BLOCK with no ring misses and locks for a moment. Intents only (PvpAction Tap / Block); the server
-- decides every hit (PvpRules.tap / block). PvpPanel builds it into the fight HUD and feeds it the fight events.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local PvpConfig = require(Shared.PvpConfig)
local UI = require(script.Parent.UI)
local Juice = require(script.Parent.Juice)
local TowerView = require(script.Parent.Parent.TowerView)
local Audio = require(script.Parent.Parent.Audio)
local PetFx = require(script.Parent.Parent.PetFx)

local T = UI.T
local player = Players.LocalPlayer

local TapFight = {}

local GOLD = Color3.fromRGB(255, 205, 70)
local SHIELD = Color3.fromRGB(105, 218, 232)
local BLOCK_W = 132
local RING_LIFE = 2.2 -- a ring the server never answered (the pet fainted first) fades after this

local send: (any) -> () = function() end
local blockBtn: TextButton? = nil
local comboLabel: TextLabel? = nil
local on = false -- taps count (fighting, not counting in)
local mySide = 1
local lastSend = -math.huge
local combo, lastTapAt = 0, -math.huge
local lockedUntil = 0
local rings: { [string]: { Gui: BillboardGui, At: number } } = {} -- [attacker id] = ring on our pet
local hinted = false

local function partOf(m: Model?): BasePart?
	if m == nil then
		return nil
	end
	return m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
end

local function clearRing(from: string)
	local r = rings[from]
	if r then
		rings[from] = nil
		r.Gui:Destroy()
	end
end

local function anyRing(): boolean
	return next(rings) ~= nil
end

-- BLOCK glows gold while a ring is up, dims while locked after a miss.
local function styleBlock()
	local b = blockBtn
	if b == nil then
		return
	end
	local label = b:FindFirstChild("Label") :: TextLabel?
	local locked = os.clock() < lockedUntil
	UI.setEnabled(b, not locked, if anyRing() then "gold" else "blue")
	if label then
		label.Text = if locked then "MISSED" elseif anyRing() then "BLOCK!" else "BLOCK"
	end
end

-- A pulsing gold ring around our pet that a rival's big move is aimed at.
local function ring(from: string, to: string)
	clearRing(from)
	local part = partOf(TowerView.model(to))
	if part == nil then
		return
	end
	local g = Instance.new("BillboardGui")
	g.Name = "BlockRing"
	g.Adornee = part
	g.AlwaysOnTop = true
	g.LightInfluence = 0
	g.Size = UDim2.fromScale(7, 7)
	local circle = Instance.new("Frame")
	circle.AnchorPoint = Vector2.new(0.5, 0.5)
	circle.Position = UDim2.fromScale(0.5, 0.5)
	circle.Size = UDim2.fromScale(1, 1)
	circle.BackgroundTransparency = 1
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = circle
	local stroke = Instance.new("UIStroke")
	stroke.Color = GOLD
	stroke.Thickness = 6
	stroke.Parent = circle
	circle.Parent = g
	local word = Instance.new("TextLabel")
	word.BackgroundTransparency = 1
	-- under the ring: the pet's name and health bar sit above it
	word.AnchorPoint = Vector2.new(0.5, 0)
	word.Position = UDim2.fromScale(0.5, 1)
	word.Size = UDim2.fromScale(0.9, 0.16)
	word.Font = UI.Head
	word.Text = "BLOCK!"
	word.TextScaled = true
	word.TextColor3 = GOLD
	word.TextStrokeTransparency = 0
	word.Parent = g
	g.Parent = player:FindFirstChildOfClass("PlayerGui")
	-- shrinks in toward the pet: the hit lands as the ring closes
	TweenService:Create(circle, TweenInfo.new(PvpConfig.Block.WarnTime, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0.45, 0.45) }):Play()
	rings[from] = { Gui = g, At = os.clock() }
	Audio.play("CountdownTick", { Volume = 0.5, Key = "pvp:ring" })
	styleBlock()
end

local function comboText()
	local l = comboLabel
	if l == nil then
		return
	end
	if combo >= 2 then
		l.Visible = true
		l.Text = "COMBO x" .. combo
		l.TextColor3 = if combo > PvpConfig.Tap.ComboMax then GOLD else Color3.new(1, 1, 1)
		l.Rotation = if combo % 2 == 0 then -4 else 4
	else
		l.Visible = false
	end
end

-- A POW under the finger at once (the server's hit follows on the rival pet).
local function pow(at: Vector2)
	local screen = UI.screen()
	local inset = screen.AbsolutePosition
	local scale = math.max(UI.Scale, 0.1)
	local l = UI.text(screen, if combo > PvpConfig.Tap.ComboMax then "POW!!" else "POW!", {
		Font = UI.Head, TextSize = T.Body, Outline = "Strong", TextColor3 = if combo > 5 then GOLD else Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(90, 36), TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset((at.X - inset.X) / scale, (at.Y - inset.Y) / scale), ZIndex = 40,
	})
	l.Rotation = math.random(-12, 12)
	TweenService:Create(l, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {
		Position = l.Position - UDim2.fromOffset(0, 40), TextTransparency = 1, TextStrokeTransparency = 1,
	}):Play()
	task.delay(0.4, function()
		l:Destroy()
	end)
end

local function tap(at: Vector2)
	if not on then
		return
	end
	local now = os.clock()
	if now - lastSend < 1 / PvpConfig.Tap.PerSecond then
		return -- the server would drop it anyway
	end
	lastSend = now
	combo = if now - lastTapAt <= PvpConfig.Tap.ComboGap then combo + 1 else 1
	lastTapAt = now
	send({ Op = "Tap" })
	pow(at)
	comboText()
	Audio.play("TrainTap", { Volume = 0.45, Pitch = 1 + math.min(combo, PvpConfig.Tap.ComboMax) * 0.03, Key = "pvp:tap" })
end

-- The fight HUD's BLOCK button (left of SPECIAL) and combo counter. `special` = the SPECIAL button to sit beside.
function TapFight.build(hud: Frame, special: TextButton, sendFn: (any) -> ())
	send = sendFn
	local b = UI.button(hud, "BLOCK", "blue", function()
		if not on or os.clock() < lockedUntil then
			return
		end
		send({ Op = "Block" })
	end, { Name = "Block", AnchorPoint = Vector2.new(1, 1), Size = UDim2.fromOffset(BLOCK_W, T.Primary.Y + 6) })
	b:SetAttribute("DisabledFill", Color3.fromRGB(40, 48, 66))
	b:SetAttribute("DisabledText", Color3.new(1, 1, 1))
	blockBtn = b
	local function place()
		b.Size = UDim2.fromOffset(BLOCK_W, special.Size.Y.Offset)
		b.Position = special.Position - UDim2.fromOffset(special.Size.X.Offset + 10, 0)
	end
	place()
	special:GetPropertyChangedSignal("Position"):Connect(place)
	special:GetPropertyChangedSignal("Size"):Connect(place)
	local cl = UI.text(hud, "COMBO x2", {
		Name = "Combo", Font = UI.Head, TextSize = T.Title, Outline = "Strong", AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.78, 0), Size = UDim2.fromOffset(260, 48), TextXAlignment = Enum.TextXAlignment.Center,
	})
	cl.Visible = false
	comboLabel = cl
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not on or not hud.Visible then
			return
		end
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
			tap(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	-- rings the server never answered, the combo running out, the BLOCK lock wearing off
	task.spawn(function()
		while true do
			task.wait(0.15)
			local now = os.clock()
			for from, r in rings do
				if now - r.At > RING_LIFE then
					clearRing(from)
				end
			end
			if combo > 0 and now - lastTapAt > PvpConfig.Tap.ComboGap then
				combo = 0
				comboText()
			end
			if on then
				styleBlock()
			end
		end
	end)
end

-- A fight starts (`side` = ours) or counts in; taps count from `live` on.
function TapFight.start(side: number)
	mySide = side
	combo, lockedUntil = 0, 0
	on = false
	for from in rings do
		clearRing(from)
	end
	comboText()
	styleBlock()
end

function TapFight.live()
	on = true
	if not hinted then
		hinted = true
		UI.notify("TAP the screen to hit! Gold ring on your pet? Tap BLOCK!", "info", { Tag = "pvptap" })
	end
	styleBlock()
end

function TapFight.stop()
	on = false
	combo = 0
	for from in rings do
		clearRing(from)
	end
	comboText()
	if blockBtn then
		UI.setEnabled(blockBtn, false, "blue")
	end
end

-- Fight events from the server (after TowerView drew the plain hits).
function TapFight.events(list: { any })
	for _, e in list do
		local k = e.Kind
		if k == "Tap" then
			local m = TowerView.model(e.To or "")
			if m then
				local mine = e.Side == mySide
				pcall(PetFx.hit, m, { Damage = if mine then e.Amount else nil, Quiet = not mine })
			end
		elseif k == "Warn" then
			if e.Side == mySide and on then
				ring(e.From, e.To)
			end
		elseif k == "Blocked" then
			if e.Side == mySide then
				local r = rings[e.From or ""]
				local circle = r and r.Gui:FindFirstChildOfClass("Frame")
				local stroke = circle and circle:FindFirstChildOfClass("UIStroke")
				if stroke then
					stroke.Color = SHIELD -- guarded: waits for the move to bounce off
				end
			end
		elseif k == "Perfect" then
			clearRing(e.From or "")
			local m = TowerView.model(e.To or "")
			if e.Side == mySide then
				if m then
					pcall(PetFx.pop, m:GetPivot().Position + Vector3.new(0, 4, 0), "PERFECT!", GOLD, true)
				end
				Juice.banner("PERFECT BLOCK!", SHIELD, 0.7)
				Audio.play("PetCrit", { Volume = 0.7, Key = "pvp:perfect" })
			elseif m then
				pcall(PetFx.pop, m:GetPivot().Position + Vector3.new(0, 4, 0), "BLOCKED", SHIELD, false)
			end
			styleBlock()
		elseif k == "BlockMiss" then
			if e.Side == mySide then
				lockedUntil = os.clock() + (e.Amount or PvpConfig.Block.MissLock)
				Audio.play("Denied", { Volume = 0.5, Key = "pvp:miss" })
				styleBlock()
			end
		elseif k == "Hit" then
			-- the move landed without a block: its ring goes
			if rings[e.From or ""] then
				clearRing(e.From)
				styleBlock()
			end
		end
	end
end

return TapFight
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="380">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- FIND THE GEODE! UI v2 theme (docs/ui_v2/BRIEF_UI_V2.md, boards docs/ui_v2/*.png). Every colour, font, size,
-- border and radius of the interface lives here; UI.luau builds the components from these values only.
--
-- Look (docs/UI_STYLE.md, 2026-10-12): bright sky-blue gradient panels with a thick navy border and round corners; chunky white lettering with a black outline
-- (strong on headings and floating HUD text, light on supporting text); gold primary buttons with dark text, gray
-- secondary buttons, red close buttons with a white X; green cash; orange / gold counts and selected states.

local Theme = {}

-- Pet style (owner's reference clip 2026-10-15, docs/UI_STYLE_REF.md): white patterned sheets, navy tab strips with
-- a lime pill, lime / cyan / red buttons with white outlined Fredoka words, titles floating over the panel's edge.
-- Every colour measured on the clip lives in Theme.Pet (ui/PetStyle draws with them); the older sky-blue look is
-- what Theme.Color held before and comes back by setting PetStyle false (HudArt pictures and word art return too).
Theme.PetStyle = true
Theme.Pet = {
	TabBar = Color3.fromRGB(16, 46, 66),
	TabBarEdge = Color3.fromRGB(8, 22, 32),
	TabText = Color3.fromRGB(206, 220, 230),
	LimeTop = Color3.fromRGB(210, 254, 0),
	Lime = Color3.fromRGB(114, 254, 0),
	LimeHover = Color3.fromRGB(160, 255, 60),
	LimeEdge = Color3.fromRGB(46, 110, 0),
	RedTop = Color3.fromRGB(255, 90, 90),
	Red = Color3.fromRGB(240, 49, 49),
	RedEdge = Color3.fromRGB(122, 10, 18),
	Panel = Color3.fromRGB(255, 255, 255),
	PanelPattern = Color3.fromRGB(226, 238, 248),
	PanelEdge = Color3.fromRGB(214, 232, 248),
	TitleEdge = Color3.fromRGB(0, 69, 107),
	TitleShadow = Color3.fromRGB(0, 40, 66),
	PriceTop = Color3.fromRGB(200, 255, 40),
	Price = Color3.fromRGB(121, 253, 0),
	PriceEdge = Color3.fromRGB(36, 96, 0),
	BlueTop = Color3.fromRGB(90, 214, 255),
	Blue = Color3.fromRGB(30, 170, 255),
	BlueEdge = Color3.fromRGB(0, 60, 120),
	CyanTop = Color3.fromRGB(76, 242, 255), -- HUD squares
	Cyan = Color3.fromRGB(39, 204, 254),
	CyanLip = Color3.fromRGB(0, 108, 142),
	CyanEdge = Color3.fromRGB(0, 52, 70),
	QuestBody = Color3.fromRGB(240, 249, 254), -- the NEXT UP bar and the HUD cards
	QuestEdge = Color3.fromRGB(150, 214, 255),
	QuestTitle = Color3.fromRGB(30, 150, 240),
	Tag = Color3.fromRGB(255, 218, 52), -- the tilted yellow "NEXT UP!" tag
	TagEdge = Color3.fromRGB(150, 96, 0),
	RibbonGold = Color3.fromRGB(255, 196, 30),
	RibbonRed = Color3.fromRGB(232, 30, 60),
	RibbonPink = Color3.fromRGB(255, 70, 140),
	CardEdge = Color3.fromRGB(28, 22, 40),
	Ink = Color3.fromRGB(28, 22, 40),
	White = Color3.fromRGB(255, 255, 255),
	Gold = Color3.fromRGB(255, 216, 74),
	Shade = Color3.fromRGB(0, 0, 0),
	Holo = { Color3.fromRGB(47, 198, 255), Color3.fromRGB(120, 230, 255), Color3.fromRGB(20, 140, 245) }, -- the pet card
	HoloEdge = Color3.fromRGB(10, 90, 200),
	HoloGlow = Color3.fromRGB(95, 244, 255),
}

Theme.Color = {
	-- surfaces
	Panel = Color3.fromRGB(255, 255, 255), -- modal body (white sheet with the faint diamond pattern)
	PanelRim = Theme.Pet.PanelEdge, -- the pale blue line around a sheet
	PanelEdge = Color3.fromRGB(8, 22, 32), -- dark border around HUD cards and buttons
	Inset = Color3.fromRGB(226, 238, 248), -- rows, cards and wells inside a sheet (pale blue)
	InsetEdge = Color3.fromRGB(196, 220, 240), -- 1-2 px line around an inset
	InsetHover = Color3.fromRGB(208, 230, 250),
	Hud = Theme.Pet.TabBar, -- floating HUD cards (navy, slightly see-through)
	Shade = Color3.fromRGB(8, 8, 10), -- backdrop behind a modal
	-- text
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(60, 108, 142), -- notes on a white sheet (dark: no outline)
	Faint = Color3.fromRGB(106, 146, 176),
	Outline = Color3.fromRGB(0, 0, 0),
	DarkText = Color3.fromRGB(42, 28, 6), -- on gold
	-- accents
	Gold = Color3.fromRGB(255, 196, 36), -- selected rows, counts, the coin
	GoldDeep = Color3.fromRGB(172, 112, 8),
	GoldHover = Color3.fromRGB(255, 212, 84),
	GoldDim = Color3.fromRGB(150, 116, 30), -- equipped / in-use wells (dark gold)
	Count = Color3.fromRGB(255, 176, 32), -- important counts ("3/5", "1/3")
	Cash = Color3.fromRGB(121, 253, 0), -- money
	CashDeep = Color3.fromRGB(36, 96, 0),
	Gray = Theme.Pet.TabBar, -- secondary buttons, unselected tabs (navy)
	GrayDeep = Theme.Pet.TabBarEdge,
	GrayHover = Color3.fromRGB(26, 68, 96),
	Red = Theme.Pet.Red, -- close, destructive
	RedDeep = Theme.Pet.RedEdge,
	Green = Theme.Pet.Price, -- ready, success, ON switches, progress
	GreenDeep = Theme.Pet.PriceEdge,
	Warn = Color3.fromRGB(240, 60, 50), -- error text
	Disabled = Color3.fromRGB(154, 168, 184),
	DisabledText = Color3.fromRGB(236, 240, 246),
}

Theme.Font = {
	Display = Enum.Font.FredokaOne, -- panel titles, big counts, timer (the clip uses one round font everywhere)
	Bold = Enum.Font.FredokaOne, -- buttons, labels, names, body
	Body = Enum.Font.FredokaOne,
}

-- Text sizes (logical px before UIScale). Fitted text never grows past these and shrinks to MinText.
Theme.Text = {
	Title = 30, -- modal titles
	Head = 20, -- headings, big buttons
	Body = 16,
	Small = 15,
	Tiny = 14, -- captions; never smaller on purpose
	MinText = 14, -- the text floor (shared/UiKit.MinText): fitted words never shrink below it
	Count = 22, -- HUD counters
	Timer = 26,
}

-- Outline thickness on text (UIStroke, contextual).
Theme.Outline = {
	Strong = 3.4, -- titles, HUD floating text, big counts
	Normal = 2.6, -- buttons, labels (polish 2026-10-15: thicker dark outlines read chunkier on a phone)
	Light = 1.4, -- supporting text
}

Theme.Size = {
	Touch = 44, -- minimum touch target (logical; UI.button pads hit areas so it also holds in real px, see UI.minTouch)
	Button = 44,
	Close = 48, -- red close square (44 px or more: a thumb target, phone review 2026-10-15)
	Gap = 8,
	Pad = 12,
	Edge = 12, -- distance from the safe-area edge
	Radius = 12, -- controls and rows (round, cartoon)
	RadiusSm = 8, -- chips, gems, small thumbnails
	RadiusLg = 16, -- panels
	Border = 4, -- panel border
	BorderThin = 3, -- rows, buttons
	Tab = 44, -- tab bars are tapped like buttons
	Row = 56,
	HudTile = 54, -- lobby menu tiles
	Primary = Vector2.new(124, 64), -- hunt action button
}

-- Motion (Reduce Motion turns every one of these into an instant change).
Theme.Motion = {
	Press = 0.07, -- button dip
	PressScale = 0.95,
	ModalIn = 0.14,
	ModalOut = 0.1,
	ModalFrom = 0.96, -- starting scale of a modal (no bounce)
	PanelShrink = 0.16, -- a closed menu or dialog shrinks away over this long
	PanelShrinkTo = 0.3,
	Toast = 0.16,
	ToastHold = 2.8, -- seconds a notification stays
	ToastHoldLong = 4.2, -- important ones (purchases, geode added)
	ToastSlide = 0.28, -- notices slide in from the right
	Blur = 10, -- BlurEffect size behind an open menu (camera effect, not Lighting)
	BlurIn = 0.18,
}

-- Springs (Vendor/spr: damping ratio, frequency in Hz). Under 1 damping overshoots = the cartoon bounce.
Theme.Spring = {
	Press = { 0.7, 7 }, -- finger down: quick dip
	Release = { 0.32, 4.5 }, -- finger up: bounce back past 1 and settle
	PressScale = 0.9,
	Panel = { 0.45, 3.6 }, -- menus and dialogs spring in from PanelFrom
	PanelFrom = 0.7,
	Pop = { 0.38, 4 }, -- new things (dots, stamps, cards)
}

-- Cartoon button look: a darker lip along the bottom (UIGradient multiplies the fill; keypoint = where it starts).
Theme.Button = {
	Lip = 0.78, -- 0..1 down the button
	LipShade = Color3.fromRGB(150, 150, 150), -- (polish 2026-10-15: a deeper lip makes every button a chunky block)
	MidShade = Color3.fromRGB(226, 226, 226), -- just above the lip (soft curve into it)
	TopShade = Color3.fromRGB(255, 255, 255),
}

-- Panel gradient (multiplies the fill: lighter top, deeper bottom) and the glossy top highlight on buttons.
Theme.Panel = {
	Top = Color3.fromRGB(255, 255, 255),
	Bottom = Color3.fromRGB(236, 244, 252),
}
Theme.Gloss = {
	Transparency = 0.64, -- white sheen over the top half of a button (polish: brighter top)
	Height = 0.46,
}

-- Idle loops (Reduce Motion stops them).
Theme.Loop = {
	ShineEvery = 3.2, -- seconds between glints across a main / buy button
	ShineTime = 0.55,
	WiggleEvery = 2.6, -- seconds between "tap me" tilts on the main button
	WiggleAngle = 5,
	HoverScale = 1.06,
	RaysSpin = 40, -- degrees per second
	DotHopEvery = 4.5, -- seconds between the little hops of red "new" dots
}

-- Accent colours for UI juice (one place, so every screen matches).
Theme.Fx = {
	NewDot = Color3.fromRGB(235, 52, 44), -- red "!" dot on new things
	NewDotEdge = Color3.fromRGB(120, 14, 10),
	Confetti = {
		Color3.fromRGB(255, 196, 36),
		Color3.fromRGB(110, 230, 70),
		Color3.fromRGB(80, 170, 255),
		Color3.fromRGB(255, 104, 160),
		Color3.fromRGB(190, 120, 255),
	},
	Shine = Color3.fromRGB(255, 255, 255),
	Danger = Color3.fromRGB(255, 70, 60), -- timer in its last seconds
}

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="381">
            <Properties>
              <string name="Name">TowerPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Pet Tower screens: the TOWER entry button (lobby only), the team picker (pick up to 3 pets, see each pet's
-- type, grade, stats and moves), the fight HUD (floor, wave, SPECIAL button with its meter, LEAVE) and the
-- floor-end card. Sends intents only; the server decides everything.

local GuiService = game:GetService("GuiService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local TowerConfig = require(Shared.TowerConfig)
local PetStatView = require(Shared.PetStatView)
local PetStats = require(Shared.PetStats)
local TouchLayout = require(Shared.TouchLayout)
local UI = require(script.Parent.UI)
local PanelSkin = require(script.Parent.PanelSkin)
local Theme = require(script.Parent.Theme)
local HudArt = require(script.Parent.HudArt)
local TowerView = require(script.Parent.Parent.TowerView)
local TowerFx = require(script.Parent.Parent.TowerFx)
local State = require(script.Parent.Parent.State)
local Audio = require(script.Parent.Parent.Audio)
local Juice = require(script.Parent.Juice)
local GeodeView = require(script.Parent.GeodeView)
local PetStatsStrip = require(script.Parent.PetStatsStrip)
local TweenService = game:GetService("TweenService")

local TC = Theme.Color
local K = Theme.Pet
local T = UI.T
local player = Players.LocalPlayer

local TowerPanel = {}

local send: (any) -> () = function() end
-- The server takes one intent per 0.15 s per player and drops the rest, so fast team taps were lost (audit 20).
-- `send` goes through a small outbox spaced just over that gap: a queued SetTeam is replaced by the newest picks
-- (the last choice always reaches the server), and a second copy of any other queued op is dropped.
local SEND_GAP = 0.2
local teamQueued = false -- a SetTeam waits in the outbox
local teamHoldUntil = 0 -- a Roster reply before this may predate the last SetTeam: keep the local picks
-- The revive price is read from Roblox in the background, never inside a handler (GetProductInfo yields; audit 26).
-- A failed read is remembered and retried after REVIVE_RETRY seconds; until then the card shows "R$ ?".
local REVIVE_RETRY = 30
local revivePrice: string? = nil -- "R$ 99", read from Roblox once (never written in the game)
local reviveFetching = false
local reviveFailedAt = -math.huge
local function fetchRevivePrice()
	if TowerConfig.Revive.ProductId == 0 or revivePrice or reviveFetching or os.clock() - reviveFailedAt < REVIVE_RETRY then
		return
	end
	reviveFetching = true
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(TowerConfig.Revive.ProductId, Enum.InfoType.Product)
		end)
		if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
			revivePrice = "R$ " .. info.PriceInRobux
		else
			reviveFailedAt = os.clock()
		end
		reviveFetching = false
	end)
end
local function reviveCost(): string
	fetchRevivePrice()
	return revivePrice or "R$ ?"
end
local roster: any = nil
local picked: { string } = {}
local hud: Frame? = nil
local floorLabel: TextLabel? = nil
local coinsLabel: TextLabel? = nil -- running coin total of this climb (server RunCoins, sent with each FloorEnd)
local meterFill: Frame? = nil
local specialBtn: TextButton? = nil
local chargeRing: UIStroke? = nil
local ringPulse: Tween? = nil
local specialGlow: Frame? = nil
local glowScale: UIScale? = nil
local glowTweens: { Tween } = {}
local wasFull = false
local inRun = false
local hudFloor = 0 -- floor of the last Floor message (0 = none); early floors leave without a confirm
local pickerRows: { [any]: TextButton } = {} -- pet id -> row of the open picker
local entryButton: TextButton? = nil

local LOSE_TIPS = {
	"Level up your pets: win floors and they gain XP.",
	"Use type advantage: hits marked Strong! do extra damage.",
	"Bring pets of different types so one is always strong.",
	"Hit EQUIP BEST to send in your strongest pets.",
}

-- Shows the best floor on the TOWER button's small label.
local function setBest(n: number?)
	local b = entryButton
	local sub = if b then b:FindFirstChild("Sub", true) else nil
	if sub and sub:IsA("TextLabel") and n and n > 0 then
		sub.Text = "Best floor " .. tostring(n)
	end
end

-- The shared rarity text tints (Config): light words that take the dark outline, like the Pet Book and results.
local RARITY_COLOR = Config.RarityTextColors :: { [string]: Color3 }

local function speciesName(id: string): string
	-- Owner's display names; anything unnamed: "DireWolf" -> "Dire Wolf"
	return TowerConfig.PetNames[id] or (string.gsub(id, "(%l)(%u)", "%1 %2"))
end

-- Tower HUD pieces live on the shared HUD layer (UI.screen: safe-area insets and the same UIScale as every screen).
local function holder(name: string): Frame
	return UI.frame(UI.screen(), { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2 })
end

-- order: the pet's place in the team (1..TeamSize) when picked, else nil. A picked row gets a gold number badge,
-- so the choice reads without colour alone.
local function styleRow(b: TextButton, order: number?)
	local on = order ~= nil
	b.BackgroundColor3 = if on then TC.InsetHover else TC.Inset
	local s = b:FindFirstChild("Border") :: UIStroke?
	if s then
		s.Color = if on then TC.Gold else TC.InsetEdge
		s.Thickness = if on then 3 else 1.5
	end
	local badge = b:FindFirstChild("PickBadge") :: Frame?
	if on and not badge then
		local f = UI.frame(b, { Name = "PickBadge", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(32, 32), BackgroundColor3 = TC.Gold, ZIndex = 6 })
		UI.corner(f, 16)
		UI.stroke(f, TC.GoldDeep, 2)
		UI.text(f, "", { Name = "Num", Font = UI.Head, TextSize = T.Body, TextColor3 = TC.DarkText, Outline = false, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 7 })
		badge = f
	end
	if badge then
		badge.Visible = on
		local num = badge:FindFirstChild("Num") :: TextLabel?
		if num and order then
			num.Text = tostring(order)
		end
	end
end

local function restyleRows()
	for id, b in pickerRows do
		if b.Parent then
			styleRow(b, table.find(picked, id))
		end
	end
end

-- True when the open picker shows exactly these pets (then a roster update only restyles the rows).
local function samePets(pets: any): boolean
	if type(pets) ~= "table" then
		return false
	end
	local n = 0
	for _, p in pets do
		local b = pickerRows[p.Id]
		if not b or not b.Parent then
			return false
		end
		n += 1
	end
	local have = 0
	for _ in pickerRows do
		have += 1
	end
	return n == have
end

-- Row sizes (Studio check 2026-10-15: the row's words, chip and badge came out tiny at phone size): the row, its
-- type chip and the pick badge stay big enough to read and tap, and every fitted word keeps the shared text floor.
local ROW_H = 76
local ROW_GAP = 6
local CHIP_H = 32

local function petRow(parent: Instance, order: number, p: any, onTap: () -> ()): TextButton
	local pickOrder = table.find(picked, p.Id)
	local b = Instance.new("TextButton")
	b.Name = "Pet_" .. tostring(p.Id)
	b.Text = ""
	b.AutoButtonColor = false
	b.LayoutOrder = order
	b.Size = UDim2.new(1, 0, 0, ROW_H)
	b.BorderSizePixel = 0
	UI.corner(b, T.Radius)
	UI.stroke(b, TC.InsetEdge, 1.5)
	styleRow(b, pickOrder)
	UI.bouncy(b) -- press squash like every other row and card
	-- the pet's picture on the left (the same 3D view the collection cards use)
	local pic = UI.frame(b, { Name = "Picture", Position = UDim2.fromOffset(6, 7), Size = UDim2.fromOffset(62, 62), BackgroundTransparency = 1 })
	if type(p.Spec) == "table" then
		pcall(GeodeView.make, pic, p.Spec, { Size = UDim2.fromScale(1, 1), Backing = true })
	end
	local nameLabel = UI.text(b, (if type(p.Name) == "string" and p.Name ~= "" then p.Name else speciesName(p.Spec.Mineral or "Pet")) .. "  " .. PetStatView.levelText(tonumber(p.Level) or 1, PetStats.cap(p.Spec)), {
		Name = "Name", Font = UI.Bold, TextSize = T.Body + 1, Position = UDim2.fromOffset(76, 5), Size = UDim2.new(0.5, -80, 0, 26),
		TextColor3 = RARITY_COLOR[p.Rarity] or TC.Text,
	})
	UI.fit(nameLabel, T.Body + 1, T.MinText)
	UI.oneLine(nameLabel) -- long names shrink on one line instead of dropping "Lv" to a second line
	-- type and grade pills read at the name's size (UI.chip's caption size was too small beside it)
	local chips = UI.frame(b, { BackgroundTransparency = 1, Position = UDim2.fromOffset(76, 36), Size = UDim2.new(0.5, -80, 0, CHIP_H) })
	UI.list(chips, Enum.FillDirection.Horizontal, 6)
	local function pill(text: string, color: Color3, order: number)
		local c = UI.chip(chips, text, color, { Size = UDim2.new(1, 0, 1, 0), LayoutOrder = order })
		local lim = Instance.new("UISizeConstraint")
		lim.MaxSize = Vector2.new(124, CHIP_H)
		lim.Parent = c
		local label = c:FindFirstChild("Text") :: TextLabel?
		if label then
			label.Font = UI.Head
			UI.fit(label, T.Body, T.MinText)
			label.TextWrapped = false -- "COSMI / C" broke in two on portrait phones
		end
	end
	pill(string.upper(p.Element), TowerView.TypeColor[p.Element] or TC.Gray, 1)
	-- (the grade pill is gone: it is part of POWER now, and the Pet Book MORE page still names it)
	-- carter's pick: one "bigger = better" POWER number (the same number as the Pet Book, PetStatView.powerOf)
	PetStatsStrip.badge(b, PetStatView.powerOf(p), 0, 28, { Name = "Stats", Position = UDim2.new(0.5, 0, 0, 5) }) -- room on the right for the pick badge
	UI.text(b, p.Basic .. " · " .. p.Move .. " · " .. p.Special .. "!", {
		Name = "Moves", TextSize = T.Small, TextColor3 = TC.Muted, Position = UDim2.new(0.5, 0, 0, 36), Size = UDim2.new(0.5, -46, 0, 36),
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	b.Activated:Connect(onTap)
	b.Parent = parent
	return b
end

function TowerPanel.openPicker()
	if roster == nil or inRun then
		send({ Op = "Open" })
		return
	end
	local towerPanel, body, close, footer = UI.modal("Tower", "TRAINING TOWER", Vector2.new(620, 420), {
		Subtitle = string.format("Every floor trains your pets! Best floor %d · start at %d", roster.Best, roster.Checkpoint),
		Footer = T.Primary.Y + 16, -- the buttons' full height plus the footer padding (64 cut them off at the border)
	})
	PanelSkin.dress(towerPanel, "Tower", "TRAINING TOWER")
	UI.list(body, Enum.FillDirection.Vertical, ROW_GAP)
	if #roster.Pets == 0 then
		UI.emptyState(body, "No pets yet", "Hatch a pet in the egg race first. Then it can fight here!")
	end
	local sorted = table.clone(roster.Pets)
	table.sort(sorted, function(a: any, b: any)
		return PetStatView.powerOf(a) > PetStatView.powerOf(b) -- strongest first, so the numbers read top-down
	end)
	table.clear(pickerRows)
	for i, p in sorted do
		pickerRows[p.Id] = petRow(body, i, p, function()
			local at = table.find(picked, p.Id)
			if at then
				table.remove(picked, at)
			elseif #picked < TowerConfig.TeamSize then
				table.insert(picked, p.Id)
			else
				UI.notify("Your team is full. Tap a pet to take it out.", "info")
				return
			end
			-- the picker stays open: pick the whole team, then CLIMB (the server's roster reply restyles in place)
			restyleRows()
			send({ Op = "SetTeam", Pets = picked })
			UI.notify(string.format("Team %d/%d", #picked, TowerConfig.TeamSize), "info", { Tag = "towerteam" })
		end)
	end
	-- more pets below the buttons: a gold MORE tab between EQUIP BEST and CLIMB! until the last pet is in view
	-- (tapping it scrolls one row down). It lives in the footer, in its own slot: on the list's bottom edge it
	-- covered the last visible row's words (check_layout COVERED, 2026-10-15)
	local moreSlot: Frame? = nil
	if footer then
		UI.list(footer, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		-- both footer buttons fill the footer's padded height: T.Primary.Y (64) px, well over the 44 px touch floor
		UI.button(footer, "EQUIP BEST", "gray", function()
			close()
			send({ Op = "EquipBest" })
		end, { Name = "EquipBest", Size = UDim2.new(0.38, -6, 1, 0), LayoutOrder = 1 })
		moreSlot = UI.frame(footer, { Name = "MoreSlot", BackgroundTransparency = 1, Size = UDim2.new(0.24, -4, 1, 0), LayoutOrder = 2 })
		UI.button(footer, "CLIMB!", "green", function()
			close()
			send({ Op = "Start" })
		end, { Name = "Start", Size = UDim2.new(0.38, -6, 1, 0), LayoutOrder = 3 })
	end
	local lastRow = if #sorted > 0 then pickerRows[sorted[#sorted].Id] else nil
	if lastRow and moreSlot then
		local more = UI.button(moreSlot, "MORE \u{25BC}", "gold", function()
			body.CanvasPosition += Vector2.new(0, ROW_H + ROW_GAP)
		end, { Name = "MorePets", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, math.max(44, UI.minTouch())), TextSize = T.Small, Visible = false })
		local function update()
			local bottom = body.AbsolutePosition.Y + body.AbsoluteSize.Y
			more.Visible = lastRow.AbsolutePosition.Y + lastRow.AbsoluteSize.Y > bottom + 4
		end
		body:GetPropertyChangedSignal("CanvasPosition"):Connect(update)
		body:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
		lastRow:GetPropertyChangedSignal("AbsolutePosition"):Connect(update)
		task.defer(update)
	end
end

-- TOWER entry: a row of the HUD's left column (under PLAY, like the queue card), so it never sits on the thumbstick.
-- Falls back to a fixed spot under the cash if the HUD column is not there.
local function buildEntry()
	local screen = UI.screen()
	local box = screen:WaitForChild("LeftBox", 10) -- the HUD wraps its left column in this box
	local left = if box then box:WaitForChild("Left", 10) else nil
	-- the HUD's mode row (TOWER beside the photo button); green, so it never reads like the gold PLAY button
	local row = if left then left:WaitForChild("ModeRow", 5) or left else nil
	local b: TextButton = HudArt.bigButton(row or screen, {
		Name = "TowerButton", Style = "green", Art = "Tower", Skin = "btn_green", Title = "TOWER", Sub = "Train pets", Width = 172, Height = 60, LayoutOrder = 1,
		OnClick = TowerPanel.openPicker,
	})
	b:SetAttribute("Short", "TRAIN") -- the word on the square phone tile (HudArt.compact)
	entryButton = b
	setBest(if roster then roster.Best else nil)
	if not left then
		b.Position = UDim2.fromOffset(T.Edge, T.Edge + 150)
	end
	local function refresh()
		b.Visible = player:GetAttribute("MatchKey") == nil and player:GetAttribute("InTower") == nil and player:GetAttribute("InBattle") == nil
	end
	player:GetAttributeChangedSignal("InBattle"):Connect(refresh)
	player:GetAttributeChangedSignal("MatchKey"):Connect(refresh)
	player:GetAttributeChangedSignal("InTower"):Connect(refresh)
	refresh()
end

local SPECIAL_W = 160

local function buildHud()
	local g = holder("TowerHud")
	g.Visible = false
	hud = g
	local top = UI.card(g, "hud", { Name = "Floor", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, T.Edge), Size = UDim2.fromOffset(300, 40) })
	-- centred vertically so the floor flip (see flipFloor) squashes toward the middle like a counter card
	floorLabel = UI.text(top, "FLOOR 1", {
		Font = UI.Head, TextSize = T.Head, Outline = "Strong", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	coinsLabel = UI.text(g, "+0 coins", {
		-- beside the floor card (under it, it sat over the boss's name in the 3D view)
		Name = "RunCoins", Font = UI.Bold, TextSize = T.Small, TextColor3 = TC.Cash, Position = UDim2.new(0.5, 158, 0, T.Edge), Size = UDim2.fromOffset(130, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	UI.button(g, "LEAVE", "red", function()
		-- before the first boss floor little is at stake (the coins are kept), so no confirm
		if hudFloor < TowerConfig.BossEvery then
			send({ Op = "Leave" })
			return
		end
		UI.confirm({
			Name = "TowerLeave", Title = "Leave the tower?", Message = "You keep the coins you won.", Confirm = "LEAVE", Cancel = "STAY", Style = "red",
			OnConfirm = function()
				send({ Op = "Leave" })
			end,
		})
	end, { Name = "Leave", AnchorPoint = Vector2.new(0, 0), Position = UDim2.new(0, T.Edge, 0.14, 0), Size = UDim2.fromOffset(100, T.Touch), TextSize = T.Small })
	-- (top-left, under Roblox's menu buttons: under the floor card it covered the boss's bar, bottom-left is the thumbstick)
	-- hit numbers in the 3D view stay below the floor card (viewport px: this layer sits under the top bar)
	TowerView.topClear = function(): number
		if not g.Visible then
			return 0
		end
		local inset = (GuiService:GetGuiInset())
		return inset.Y + top.AbsolutePosition.Y + top.AbsoluteSize.Y
	end
	local sp = UI.button(g, "SPECIAL", "gold", function()
		send({ Op = "Special" })
	end, { Name = "Special", AnchorPoint = Vector2.new(1, 1), Size = UDim2.fromOffset(SPECIAL_W, T.Primary.Y + 6) })
	specialBtn = sp
	-- charging: the navy of the tab strips with a white, strongly outlined label (grey on grey did not read); paint()
	-- uses these while the button is disabled
	sp:SetAttribute("DisabledFill", K.TabBar)
	sp:SetAttribute("DisabledText", K.White)
	local spl = sp:FindFirstChild("Label")
	if spl then
		UI.outline(spl, "Strong")
	end
	-- ready glow: a soft gold halo behind the button (a sibling, so it shows around it), lit and pulsing only
	-- while SPECIAL is ready (setMeter); place() keeps it centred on the button
	local halo = UI.frame(g, {
		Name = "SpecialGlow", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = K.Gold, BackgroundTransparency = 1,
		ZIndex = math.max(sp.ZIndex - 1, 0),
	})
	UI.corner(halo, T.Radius + 10)
	local haloScale = Instance.new("UIScale")
	haloScale.Parent = halo
	specialGlow = halo
	glowScale = haloScale
	-- charge ring: a gold glow around the button that brightens as the meter fills and pulses when ready
	local glow = UI.frame(sp, {
		Name = "ChargeRing", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 8, 1, 8),
		BackgroundTransparency = 1, ZIndex = 0,
	})
	UI.corner(glow, T.Radius + 4)
	local ring = Instance.new("UIStroke")
	ring.Name = "Ring"
	ring.Color = TC.Gold
	ring.Thickness = 3
	ring.Transparency = 1
	ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ring.Parent = glow
	chargeRing = ring
	local track, fill = UI.bar(sp, { Name = "Meter", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -6), Size = UDim2.new(1, 0, 0, 10) }, TC.Gold)
	local _ = track
	meterFill = fill
	-- SPECIAL goes where the hunt's action button goes (TouchLayout, screen px): above Roblox's jump button, or left
	-- of it on the bottom row, never in the thumbstick half of the screen.
	local function place()
		local px = UI.screen().AbsoluteSize
		if px.X < 2 or px.Y < 2 then
			return
		end
		local cam = Workspace.CurrentCamera
		local full = if cam then cam.ViewportSize else px
		local scale = math.max(UI.Scale, 0.1)
		local h = T.Primary.Y + 6 + 16 -- button plus the meter above it
		-- keep the lobby menu column (top right, about 250 tall) free
		local topLimit = px.Y - (T.Edge + 250) * scale
		local r, bottom, mode = TouchLayout.place(full.X, full.Y, h * scale, topLimit, UserInputService.TouchEnabled)
		local w = SPECIAL_W
		if mode == "left" then
			-- stay in the right 60% of the screen (the thumbstick owns the left side)
			w = math.max(96, math.min(w, (px.X * 0.6 - r) / scale))
		end
		sp.Size = UDim2.fromOffset(w, T.Primary.Y + 6)
		sp.Position = UDim2.new(1, -r / scale, 1, -bottom / scale)
		halo.Size = UDim2.fromOffset(w + 22, T.Primary.Y + 6 + 22)
		halo.Position = sp.Position - UDim2.fromOffset(w / 2, (T.Primary.Y + 6) / 2)
	end
	place()
	UI.screen():GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		task.defer(place)
	end)
	UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(place)
end

local function reducedMotion(): boolean
	local p = State.Profile
	return p ~= nil and p.Settings ~= nil and p.Settings.ReducedMotion == true
end

-- Floor number change: the label flips like a counter card (squashes shut, new text, opens again).
-- Reduce Motion or a wave-only change just swaps the text.
local shownFloor = 0
local flipId = 0
local floorText = "FLOOR 1"
local mobsLeft = -1 -- standing mobs of this wave (-1 = not known yet)
local function labelText(): string
	return if mobsLeft >= 0 then string.format("%s · %d LEFT", floorText, mobsLeft) else floorText
end
local function flipFloor(label: TextLabel, text: string, floor: number, height: number)
	floorText = text
	flipId += 1
	local id = flipId
	local changed = shownFloor ~= 0 and floor ~= shownFloor
	shownFloor = floor
	if not changed or reducedMotion() then
		label.Text = labelText()
		label.Size = UDim2.fromScale(1, height)
		return
	end
	local shut = TweenService:Create(label, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.fromScale(1, 0) })
	shut.Completed:Connect(function()
		if flipId ~= id then
			return
		end
		label.Text = labelText()
		TweenService:Create(label, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromScale(1, height) }):Play()
	end)
	shut:Play()
end

-- SPECIAL's ready halo: lit and breathing (bigger and brighter, then back) while ready; steady with Reduce Motion.
local function setGlow(on: boolean)
	for _, tw in glowTweens do
		tw:Cancel()
	end
	table.clear(glowTweens)
	local halo, sc = specialGlow, glowScale
	if not (halo and sc) then
		return
	end
	sc.Scale = 1
	halo.BackgroundTransparency = if on then 0.45 else 1
	if on and not reducedMotion() then
		local info = TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
		table.insert(glowTweens, TweenService:Create(halo, info, { BackgroundTransparency = 0.8 }))
		table.insert(glowTweens, TweenService:Create(sc, info, { Scale = 1.12 }))
		for _, tw in glowTweens do
			tw:Play()
		end
	end
end

-- the ready ring: pale gold (the pet gold lifted toward white), brighter than the charging ring
local READY_RING = K.Gold:Lerp(K.White, 0.5)

local function setMeter(v: number)
	local f = math.clamp(v / TowerConfig.SpecialCharge, 0, 1)
	if meterFill then
		meterFill.Size = UDim2.fromScale(f, 1)
		meterFill.BackgroundColor3 = if f >= 1 then TC.Gold else K.Cyan -- charging cyan (the HUD squares), ready gold
	end
	local ring = chargeRing
	if ring then
		local full = f >= 1
		if full ~= wasFull then
			wasFull = full
			if ringPulse then
				ringPulse:Cancel()
				ringPulse = nil
			end
			setGlow(full)
			if full then
				Audio.play("RarityAccent", { Volume = 0.6, Key = "tower:special-ready" }) -- the "something good" chime
			end
			if full and not reducedMotion() then
				local btn = specialBtn
				if btn then
					-- ready: the button wiggles once
					task.spawn(function()
						for _, rot in { -6, 6, -4, 4, 0 } do
							if btn.Parent == nil then
								return
							end
							TweenService:Create(btn, TweenInfo.new(0.06, Enum.EasingStyle.Sine), { Rotation = rot }):Play()
							task.wait(0.06)
						end
					end)
				end
				ring.Thickness = 3
				ring.Transparency = 0
				local tw = TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Thickness = 6, Transparency = 0.45 })
				ringPulse = tw
				tw:Play()
			end
		end
		if not full or reducedMotion() then
			ring.Thickness = if full then 5 else 3
			ring.Color = if full then READY_RING else TC.Gold
			-- charging: the ring fades in with the meter (faint at the start, bright just before ready)
			ring.Transparency = if full then 0 else 1 - f * 0.75
		else
			ring.Color = READY_RING
		end
	end
	if specialBtn then
		UI.setEnabled(specialBtn, f >= 1, "gold")
		local label = specialBtn:FindFirstChild("Label") :: TextLabel?
		if label then
			-- charging vs ready, in words (the meter above turns from cool blue to gold)
			label.Text = if f >= 1 then "SPECIAL READY!" else "CHARGING " .. math.floor(f * 100) .. "%"
		end
	end
end

-- Runs `fn` once the avatar stands in the tower (InTower set and near the floor's origin), checking for up to 4 s.
-- A floor end, a newer floor or leaving cancels it (cardToken).
local cardToken = 0
local shownWave = 0 -- floor * 100 + wave of the last Floor message (a repeat, e.g. after a revive, calls nothing out)
local function whenInTower(origin: any, fn: () -> ())
	cardToken += 1
	local id = cardToken
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 4 do
			if id ~= cardToken or not inRun then
				return
			end
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if player:GetAttribute("InTower") == true and typeof(origin) == "CFrame" and root and root:IsA("BasePart") and (root.Position - origin.Position).Magnitude < 80 then
				task.wait(0.15) -- one beat for the camera to catch up with the move
				if id == cardToken and inRun then
					fn()
				end
				return
			end
			task.wait(0.1)
		end
	end)
end

-- On entry: puts the camera behind the avatar, looking over the pets at the mobs (it kept the lobby's angle, which
-- often faced the back wall). Once only; the player turns it freely afterwards.
local function faceFight(origin: any)
	local cam = Workspace.CurrentCamera
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (cam and typeof(origin) == "CFrame" and root and root:IsA("BasePart")) or cam.CameraType ~= Enum.CameraType.Custom then
		return
	end
	local fight = origin * Vector3.new(0, 2, 2) -- between the pet line and the mobs
	local back = (root.Position - fight) * Vector3.new(1, 0, 1)
	back = if back.Magnitude > 0.1 then back.Unit else origin.LookVector -- the players' side (-Z)
	cam.CFrame = CFrame.lookAt(root.Position + back * 10 + Vector3.new(0, 6, 0), fight)
end

-- Floor-end card clean-up: one clear choice (its two buttons; the red X corner button goes) and a message that
-- reads at heading size (bug 239). `grow` adds height for the bigger reward row under the message.
local function tidyCard(dialogName: string, grow: number)
	local shade = UI.dialogLayer():FindFirstChild("Dialog_" .. dialogName)
	local panel = shade and shade:FindFirstChild("Panel")
	if not (panel and panel:IsA("Frame")) then
		return
	end
	local x = panel:FindFirstChild("Close")
	if x then
		x:Destroy()
	end
	local title = panel:FindFirstChild("Title")
	if title and title:IsA("TextLabel") then
		title.Size = UDim2.new(1, -(title.Position.X.Offset + 14), 0, title.Size.Y.Offset)
	end
	local message = panel:FindFirstChild("Message")
	if message and message:IsA("TextLabel") then
		-- keeps the dialog's own message colour (dark ink on the cream card); white here was unreadable
		UI.fit(message, T.Head)
	end
	if grow > 0 then
		panel.Size += UDim2.fromOffset(0, grow)
		local lim = panel:FindFirstChildOfClass("UISizeConstraint")
		if lim then
			lim.MaxSize += Vector2.new(0, grow)
		end
	end
end

-- Floor-end reward line: turns the dialog's price line (UI.confirm Price) into "[coin] +30   [star] +120 PET XP"
-- with the drawn coin and star icons. XP is what the pets earned this climb.
local function rewardRow(dialogName: string, coins: number, xp: number)
	local shade = UI.dialogLayer():FindFirstChild("Dialog_" .. dialogName)
	local panel = shade and shade:FindFirstChild("Panel")
	local slot = panel and panel:FindFirstChild("Price")
	if not (slot and slot:IsA("Frame")) then
		return
	end
	slot:ClearAllChildren()
	slot.Size = UDim2.new(1, -(slot.Position.X.Offset + 14), 0, 34)
	UI.list(slot, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	-- fixed text boxes (UI.text fits the words inside them on narrow phones)
	local function item(icon: string, text: string, color: Color3, width: number, order: number)
		UI.icon(slot, icon, 32, { LayoutOrder = order })
		local l = UI.text(slot, text, { Name = "Reward", Font = UI.Head, TextSize = T.Head + 4, TextColor3 = color, Size = UDim2.fromOffset(width, 34), LayoutOrder = order + 1 })
		l.TextWrapped = false
		UI.pop(l, 0.7, 0.1 * order)
	end
	item("cash", "+" .. UI.num(coins), TC.Cash, 96, 1)
	item("star", string.format("+%s PET XP", UI.num(xp)), TC.Gold, 180, 3)
end

local function onEvent(msg: any)
	if type(msg) ~= "table" then
		return
	end
	if msg.Kind == "Roster" then
		roster = msg
		setBest(msg.Best)
		-- an answer to an older pick must not undo taps still on the way to the server
		if not teamQueued and os.clock() >= teamHoldUntil then
			picked = table.clone(msg.Team or {})
		end
		if not inRun and UI.modalOpen() == "Tower" and samePets(msg.Pets) then
			restyleRows() -- answer to a pick: the open picker stays put (keeps its scroll position)
		elseif not inRun then
			TowerPanel.openPicker()
		end
	elseif msg.Kind == "Floor" then
		local entering = not inRun
		if entering and coinsLabel then
			coinsLabel.Text = "+0 coins"
		end
		hudFloor = msg.Floor or 0
		inRun = true
		UI.closeModal()
		-- a new floor or wave has begun (CONTINUE, a revive, or the Studio /boss jump): the last floor's end card
		-- and its dim backdrop must not hang over the fight. Closing it this way fires no button callback, and it
		-- also closes Sticky cards (the revive offer).
		if UI.dialogOpen() == "TowerFloor" then
			UI.closeDialog()
		end
		if hud then
			hud.Visible = true
		end
		if floorLabel then
			-- every 10 floors the number gets bigger and goldener (the label is centred, so it grows both ways)
			local tier = math.min(math.floor(msg.Floor / 10), 3)
			-- the pet gold (TC.Gold read dark on the navy card) or white, both under the strong dark outline
			floorLabel.TextColor3 = if tier >= 1 then K.Gold else K.White
			-- "BOSS" only on the boss's own wave (the normal mobs before it read as the boss)
			local bossWave = msg.Boss and msg.Wave == msg.Waves
			flipFloor(floorLabel, string.format("%sFLOOR %d · WAVE %d/%d", if bossWave then "BOSS " else "", msg.Floor, msg.Wave, msg.Waves), msg.Floor, 1 + 0.12 * tier)
		end
		local waveKey = (msg.Floor or 0) * 100 + (msg.Wave or 1)
		local newWave = waveKey ~= shownWave
		shownWave = waveKey
		if newWave and (msg.Wave or 1) > 1 then
			-- a new wave on the same floor: a short call-out (text only, no backdrop, so the fight stays in view)
			local last = msg.Wave == msg.Waves
			Juice.banner(string.format("%s %d/%d!", if last and msg.Boss then "BOSS WAVE" else "WAVE", msg.Wave, msg.Waves), if last then K.RedTop else TC.Gold, 1.1)
		end
		-- only a new theme gets a title card ("JUNGLE FLOORS!"); the HUD's floor label already names every floor (a
		-- "FLOOR 3 / Jungle" card on each floor hung over the middle of the room)
		local themeCard = msg.Wave == 1 and msg.Theme ~= nil and (msg.Floor - 1) % TowerConfig.ThemeEvery == 0
		if themeCard or entering then
			local glow = TC.Gold
			for _, th in TowerConfig.Themes do
				if th.Name == msg.Theme then
					glow = th.Glow
				end
			end
			local title = string.upper(tostring(msg.Theme))
			local sub = string.format("FLOORS %d-%d", msg.Floor, msg.Floor + TowerConfig.ThemeEvery - 1)
			-- only once we are really standing in the tower (the first floor's message lands while the lobby is
			-- still on screen); on entry the camera turns to the fight first
			whenInTower(msg.Origin, function()
				if entering then
					faceFight(msg.Origin)
					UI.notify("Your pets fight for you. Tap SPECIAL when it glows!", "info", { Tag = "towertip" })
				end
				if themeCard then
					TowerFx.titleCard(title, sub, glow)
				end
			end)
		end
		setMeter(0)
		TowerView.floor(msg)
	elseif msg.Kind == "Events" then
		TowerView.events(msg.List, msg.Hp)
		setMeter((msg.Meters or {})[tostring(player.UserId)] or (msg.Meters or {})[player.UserId] or 0)
	elseif msg.Kind == "FloorEnd" then
		-- the floor's title card goes first so it never covers the floor-end card's words
		cardToken += 1
		TowerFx.hideTitle()
		TowerView.hush() -- no hit number or SPECIAL! word behind the card
		setMeter(0)
		setBest(msg.Best)
		if coinsLabel then
			coinsLabel.Text = "+" .. UI.money(msg.RunCoins or 0)
		end
		if msg.Drop then
			UI.notify(string.format("TOWER PET! You found %s!", msg.Drop), "ok")
		end
		if msg.Result == "Cleared" then
			TowerView.cleared()
			UI.confirm({
				Name = "TowerFloor", Title = string.format("FLOOR %d CLEARED!", msg.Floor),
				Message = string.format("Ready for floor %d?", msg.Floor + 1),
				Price = msg.Coins, -- reserves the reward line under the message (filled by rewardRow)
				-- Sticky: a stray tap outside or Escape must not leave the climb (audit 17); only its buttons act
				Confirm = "CONTINUE", Cancel = "LEAVE", Style = "green", Sticky = true,
				OnConfirm = function()
					send({ Op = "Next" })
				end,
				OnCancel = function()
					send({ Op = "Leave" })
				end,
			})
			tidyCard("TowerFloor", 10)
			rewardRow("TowerFloor", msg.Coins or 0, msg.Xp or 0)
		elseif (msg.Paid or 0) > 0 then
			UI.confirm({
				Name = "TowerFloor", Title = "Your pets fainted!",
				Message = string.format("Revive for %s and keep going (%d left this climb), or leave with %d coins and %d XP.", reviveCost(), msg.Paid, msg.RunCoins, msg.Xp),
				Confirm = "REVIVE (" .. reviveCost() .. ")", Cancel = "LEAVE", Style = "green", Sticky = true,
				OnConfirm = function()
					send({ Op = "BuyRevive" })
				end,
				OnCancel = function()
					send({ Op = "Leave" })
				end,
			})
			tidyCard("TowerFloor", 0)
		elseif (msg.Revives or 0) > 0 then
			UI.confirm({
				Name = "TowerFloor", Title = "Your pets fainted!",
				Message = string.format("Revive once for free and keep going, or leave with %d coins and %d XP.", msg.RunCoins, msg.Xp),
				Confirm = "REVIVE", Cancel = "LEAVE", Style = "green", Sticky = true,
				OnConfirm = function()
					send({ Op = "Revive" })
				end,
				OnCancel = function()
					send({ Op = "Leave" })
				end,
			})
			tidyCard("TowerFloor", 0)
		else
			UI.confirm({
				Name = "TowerFloor", Title = "Your pets fainted!",
				Message = string.format("You keep %d coins and %d XP. Best floor: %d. Try again!\n%s %s", msg.RunCoins, msg.Xp, msg.Best, LOSE_TIPS[(msg.Floor or 1) % #LOSE_TIPS + 1], LOSE_TIPS[((msg.Floor or 1) + 1) % #LOSE_TIPS + 1]),
				Confirm = "BACK TO LOBBY", NoCancel = true, Style = "gold",
				OnConfirm = function()
					send({ Op = "Leave" })
				end,
				OnCancel = function()
					send({ Op = "Leave" })
				end,
			})
			tidyCard("TowerFloor", 0)
		end
	elseif msg.Kind == "Closed" then
		inRun = false
		wasFull = false
		hudFloor = 0
		shownFloor = 0
		shownWave = 0
		mobsLeft = -1
		if ringPulse then
			ringPulse:Cancel()
			ringPulse = nil
		end
		setGlow(false)
		roster = nil
		cardToken += 1
		TowerFx.hideTitle()
		UI.closeDialog()
		if hud then
			hud.Visible = false
		end
		TowerView.clear()
		-- back in the lobby: once the server has moved the avatar, put the camera behind it looking ahead
		-- (otherwise it keeps the tower's angle and can end up inside the portal glow)
		task.delay(0.3, function()
			local cam = Workspace.CurrentCamera
			local char = Players.LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if cam and root and root:IsA("BasePart") and cam.CameraType == Enum.CameraType.Custom and not inRun then
				local p = root.Position
				cam.CFrame = CFrame.lookAt(p - root.CFrame.LookVector * 10 + Vector3.new(0, 5, 0), p + Vector3.new(0, 1.5, 0))
			end
		end)
	elseif msg.Kind == "Notice" then
		UI.notify(tostring(msg.Text), "info")
	end
end

function TowerPanel.start()
	if TowerConfig.Revive.ProductId ~= 0 then
		fetchRevivePrice() -- read the price early so the fainted card already has it
	end
	local net = game:GetService("ReplicatedStorage"):WaitForChild("TowerNet")
	local action = net:WaitForChild("TowerAction") :: RemoteEvent
	local event = net:WaitForChild("TowerEvent") :: RemoteEvent
	local outbox: { any } = {}
	local lastSent = -math.huge
	local pumping = false
	local function pump()
		while #outbox > 0 do
			local left = lastSent + SEND_GAP - os.clock()
			if left > 0 then
				task.wait(left)
			end
			local msg = table.remove(outbox, 1)
			if msg.Op == "SetTeam" then
				teamQueued = false
				teamHoldUntil = os.clock() + 0.6
			end
			lastSent = os.clock()
			action:FireServer(msg)
		end
		pumping = false
	end
	send = function(msg)
		if type(msg) ~= "table" then
			return
		end
		local queued = false
		for i, m in outbox do
			if m.Op == msg.Op then
				if msg.Op == "SetTeam" then
					outbox[i] = { Op = "SetTeam", Pets = table.clone(msg.Pets) } -- newest picks win
				end
				queued = true
				break
			end
		end
		if not queued then
			if msg.Op == "SetTeam" then
				msg = { Op = "SetTeam", Pets = table.clone(msg.Pets) } -- a snapshot: later taps edit `picked` in place
				teamQueued = true
			end
			table.insert(outbox, msg)
		end
		if not pumping then
			pumping = true
			task.spawn(pump)
		end
	end
	task.spawn(buildEntry) -- waits for the HUD column
	buildHud()
	-- enemies left on this wave, shown on the floor card (bug 242)
	TowerView.onMobsLeft = function(left: number, _total: number)
		mobsLeft = left
		if floorLabel then
			floorLabel.Text = labelText()
		end
	end
	event.OnClientEvent:Connect(onEvent)
end

return TowerPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="382">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[--!strict
-- UI kit v2 (docs/ui_v2/BRIEF_UI_V2.md): one theme (ui/Theme.luau) and the shared components every screen is
-- built from: fitted outlined text, drawn icons, buttons with hover / pressed / selected / disabled / pending
-- states, tabs, catalog rows, specimen cards, counters, empty / loading / error states, sliders, toggles, the
-- modal shell (header + red close), stacked confirmation dialogs and coalesced notifications.
--
-- Screen manager: UI.modal is the one primary-menu slot (opening one closes the previous one); UI.confirm
-- stacks a dialog above it without touching the menu's state; UI.block(key) is the input stack CameraMode
-- reads (free cursor, suspended look / move / tool, first person restored once when the last key goes).
--
-- Text sizing: Roblox's "Text size" accessibility setting scales TextSize-sized labels but not their boxes, so
-- every label here is TextScaled inside a box sized for the designed size with a UITextSizeConstraint whose
-- MaxTextSize is that size: designed size when it fits, shrinks (never below MinText) when it would not.

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local NoticeLayout = require(Shared.NoticeLayout)
local UiMotion = require(Shared.UiMotion)
local UiKit = require(Shared.UiKit)
local PopupRules = require(Shared.PopupRules)
local Audio = require(script.Parent.Parent.Audio)
local PopupGate = require(script.Parent.Parent.PopupGate)
local Theme = require(script.Parent.Theme)
local UiJuice = require(script.Parent.UiJuice)
local spr = require(Shared.Vendor.spr)

local UI = {}
UI.Theme = Theme

local TC = Theme.Color
local P = Config.Palette

-- Colours: the theme plus the legacy names older callers (RevealView, GuideArrow, Reticle) still read.
UI.Colors = {
	Panel = TC.Panel,
	PanelEdge = TC.PanelEdge,
	Inset = TC.Inset,
	InsetEdge = TC.InsetEdge,
	Hud = TC.Hud,
	Text = TC.Text,
	Muted = TC.Muted,
	Faint = TC.Faint,
	Outline = TC.Outline,
	DarkText = TC.DarkText,
	Gold = TC.Gold,
	GoldDeep = TC.GoldDeep,
	Count = TC.Count,
	Cash = TC.Cash,
	Gray = TC.Gray,
	GrayDeep = TC.GrayDeep,
	Red = TC.Red,
	RedDeep = TC.RedDeep,
	Green = TC.Green,
	GreenDeep = TC.GreenDeep,
	Warn = TC.Warn,
	Disabled = TC.Disabled,
	DisabledText = TC.DisabledText,
	-- legacy names
	Slate = TC.Hud,
	SlateRaised = TC.Gray,
	SlateDeep = TC.Inset,
	SlateLine = TC.InsetEdge,
	Amber = TC.Gold,
	AmberDeep = TC.GoldDeep,
	Yellow = TC.Gold,
	Orange = TC.Count,
	Ok = TC.Green,
	Ink = TC.DarkText,
	InkMuted = TC.Muted,
	Dark = TC.DarkText,
	Cream = TC.Panel,
	Paper = TC.Inset,
	Parchment = TC.Inset,
	Honey = TC.PanelEdge,
	HoneyLine = TC.InsetEdge,
	Card = TC.Inset,
	Stroke = TC.InsetEdge,
	PanelLight = TC.Gray,
	Violet = P.Violet,
	Cyan = P.Cyan,
	Rock = P.Rock,
}

local TS = Theme.Size
local PET = Theme.Pet
local TT = Theme.Text
UI.T = {
	Title = TT.Title,
	Head = TT.Head,
	Body = TT.Body,
	Small = TT.Small,
	Tiny = TT.Tiny,
	MinText = TT.MinText,
	Count = TT.Count,
	Touch = TS.Touch,
	Tab = TS.Tab,
	Gap = TS.Gap,
	Pad = TS.Pad,
	Radius = TS.Radius,
	RadiusLg = TS.RadiusLg,
	RadiusSm = TS.RadiusSm,
	Primary = TS.Primary,
	ModalMaxW = 560,
	Edge = TS.Edge,
	MenuCard = Vector2.new(TS.HudTile, TS.HudTile),
}
local T = UI.T

UI.Head = Theme.Font.Display
UI.Bold = Theme.Font.Bold
UI.Body = Theme.Font.Body
UI.BodyStrong = Theme.Font.Bold
UI.Reduced = false -- Reduce Motion (from settings)
UI.Juice = UiJuice -- the shared juice primitives (sweep, pulse, badge wiggle, tab slide, number count)
UiJuice.gameReduced = function(): boolean
	return UI.Reduced
end

-- Motion helpers (one feel everywhere) -------------------------------------------------------------------
-- Springs come from Vendor/spr; Reduce Motion turns each one into an instant change.

-- Springs `props` on `inst` with a { damping, frequency } pair from Theme.Spring.
function UI.spring(inst: Instance, params: { number }, props: { [string]: any })
	if UI.Reduced then
		spr.stop(inst)
		for k, v in props do
			(inst :: any)[k] = v
		end
		return
	end
	spr.target(inst, params[1], params[2], props)
end

-- The one press scale of an object (buttons, rows, cards, tiles): a UIScale named "Squash".
function UI.squashScale(obj: Instance): UIScale
	local s = obj:FindFirstChild("Squash")
	if s and s:IsA("UIScale") then
		return s
	end
	local n = Instance.new("UIScale")
	n.Name = "Squash"
	n.Parent = obj
	return n
end

-- Finger down: quick dip; finger up: bounce back past 1 and settle (the cartoon squash).
function UI.squash(obj: Instance, down: boolean)
	local s = UI.squashScale(obj)
	if down then
		UI.spring(s, Theme.Spring.Press, { Scale = Theme.Spring.PressScale })
	else
		local hover = obj:GetAttribute("Hover") == true and UserInputService.MouseEnabled
		UI.spring(s, Theme.Spring.Release, { Scale = if hover then Theme.Loop.HoverScale else 1 })
	end
end

-- Idle shine sweeps share one loop: each entry drops out once its button leaves the game. Reduce Motion pauses it.
local shines: { Frame } = {}
local shineLoop = false
local SHINE_STYLES = { gold = true, green = true, blue = true }

-- White glint that slides across a button every Theme.Loop.ShineEvery seconds while the button is gold, green or blue
-- and enabled (the "buy me" sparkle of simulator games). Added by UI.button; safe to call twice.
function UI.shine(b: GuiObject)
	if b:FindFirstChild("Shine") then
		return
	end
	local f = Instance.new("Frame")
	f.Name = "Shine"
	f.BackgroundColor3 = Theme.Fx.Shine
	f.BorderSizePixel = 0
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = 0 -- under the caption and icons (siblings)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, T.Radius)
	c.Parent = f
	local g = Instance.new("UIGradient")
	g.Rotation = 20
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.42, 1),
		NumberSequenceKeypoint.new(0.5, 0.35),
		NumberSequenceKeypoint.new(0.58, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	g.Offset = Vector2.new(-1.2, 0)
	g.Parent = f
	f.Parent = b
	table.insert(shines, f)
	if shineLoop then
		return
	end
	shineLoop = true
	task.spawn(function()
		while #shines > 0 do
			task.wait(Theme.Loop.ShineEvery)
			for i = #shines, 1, -1 do
				local sf = shines[i]
				local owner = sf.Parent
				if owner == nil then
					table.remove(shines, i)
				elseif not UI.Reduced and owner:IsA("GuiObject") and owner.Visible and not owner:GetAttribute("Disabled")
					and SHINE_STYLES[owner:GetAttribute("Style") :: any] then
					local sg = sf:FindFirstChildOfClass("UIGradient")
					if sg then
						sg.Offset = Vector2.new(-1.2, 0)
						TweenService:Create(sg, TweenInfo.new(Theme.Loop.ShineTime, Enum.EasingStyle.Quad), { Offset = Vector2.new(1.2, 0) }):Play()
					end
				end
			end
		end
		shineLoop = false
	end)
end

-- Soft white sheen over the top half of a button (glossy toy look). Never takes input.
function UI.gloss(b: GuiObject)
	if b:FindFirstChild("Gloss") then
		return
	end
	local f = Instance.new("Frame")
	f.Name = "Gloss"
	f.BackgroundColor3 = Theme.Fx.Shine
	f.BackgroundTransparency = Theme.Gloss.Transparency
	f.BorderSizePixel = 0
	f.Position = UDim2.fromOffset(4, 3)
	f.Size = UDim2.new(1, -8, Theme.Gloss.Height, -3)
	f.ZIndex = 0
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, math.max(T.Radius - 4, 4))
	c.Parent = f
	f.Parent = b
end

-- "Tap me" wiggle on the one object the player should press next (PLAY): a quick tilt left-right every few
-- seconds (rotation, so it never fights the press squash scale). Returns stop().
function UI.wiggle(obj: GuiObject): () -> ()
	local alive = true
	task.spawn(function()
		local steps = { -Theme.Loop.WiggleAngle, Theme.Loop.WiggleAngle, -Theme.Loop.WiggleAngle * 0.5, 0 }
		while alive and obj.Parent do
			task.wait(Theme.Loop.WiggleEvery)
			if alive and obj.Parent and obj.Visible and not UI.Reduced and not obj:GetAttribute("Disabled") then
				for _, a in steps do
					TweenService:Create(obj, TweenInfo.new(0.09, Enum.EasingStyle.Sine), { Rotation = a }):Play()
					task.wait(0.09)
				end
			end
		end
	end)
	return function()
		alive = false
		obj.Rotation = 0
	end
end

-- Lighter-top, deeper-bottom gradient over a panel's fill (bright cartoon panels instead of flat ones).
function UI.panelShade(f: GuiObject): UIGradient
	local old = f:FindFirstChild("PanelShade")
	if old and old:IsA("UIGradient") then
		return old
	end
	local g = Instance.new("UIGradient")
	g.Name = "PanelShade"
	g.Rotation = 90
	g.Color = ColorSequence.new(Theme.Panel.Top, Theme.Panel.Bottom)
	g.Parent = f
	return g
end

UI.Sweeps = {} :: { RBXScriptConnection } -- pattern drift loops; each ends with its card (Destroying)

-- The faint diamond pattern on cards and sheets (pet style): rotated squares that drift slowly to the right, in a
-- clipped host under the card's other children (ZIndex 0). `w0`/`h0` is the card's logical size (its AbsoluteSize
-- is not known while it is built); `most` caps the squares (60 on a card, more on a sheet).
function UI.pattern(card: GuiObject, color: Color3, alpha: number, cell: number, w0: number?, h0: number?, most: number?)
	local host = Instance.new("Frame")
	host.Name = "Pattern"
	host.BackgroundTransparency = 1
	host.ClipsDescendants = true
	host.Size = UDim2.fromScale(1, 1)
	host.ZIndex = 0
	host.Parent = card
	UI.corner(host, 10)
	-- the squares sit on a wider inner frame that drifts inside the clipped host (the host itself stays put, so no
	-- square ever shows outside the card)
	local drift = Instance.new("Frame")
	drift.Name = "Drift"
	drift.BackgroundTransparency = 1
	drift.Size = UDim2.new(1, cell * 2, 1, 0)
	drift.Position = UDim2.fromOffset(-cell, 0)
	drift.ZIndex = 0
	drift.Parent = host
	local w = w0 or 400
	local h = h0 or 160
	local cols = math.ceil(w / cell) + 2
	local rows = math.ceil(h / cell) + 1
	local cap = most or 60
	local n = 0
	for r = 0, rows do
		for c = -1, cols do
			n += 1
			if n > cap then
				break
			end
			local d = Instance.new("Frame")
			d.BackgroundColor3 = color
			d.BackgroundTransparency = alpha
			d.BorderSizePixel = 0
			d.Rotation = 45
			d.Size = UDim2.fromOffset(cell * 0.32, cell * 0.32)
			d.Position = UDim2.fromOffset((c + 1) * cell + (r % 2) * cell / 2, r * cell - cell * 0.2)
			d.ZIndex = 0
			UI.corner(d, 3)
			d.Parent = drift
		end
	end
	if not UI.Reduced then
		local t0 = os.clock()
		local conn = RunService.RenderStepped:Connect(function()
			if not host.Parent then
				return
			end
			local dx = ((os.clock() - t0) * 0.012 * w) % cell
			drift.Position = UDim2.fromOffset(dx - cell, 0)
		end)
		table.insert(UI.Sweeps, conn)
		card.Destroying:Once(function()
			conn:Disconnect()
			local i = table.find(UI.Sweeps, conn)
			if i then
				table.remove(UI.Sweeps, i)
			end
		end)
	end
end

-- Wires the squash to a button's own press / release (rows, cards and tiles that are not UI.button).
function UI.bouncy(b: GuiButton)
	b.MouseButton1Down:Connect(function()
		if not b:GetAttribute("Disabled") then
			UI.squash(b, true)
		end
	end)
	b.MouseButton1Up:Connect(function()
		UI.squash(b, false)
	end)
	b.MouseLeave:Connect(function()
		UI.squash(b, false)
	end)
	b.SelectionLost:Connect(function()
		UI.squash(b, false)
	end)
end

-- Pops an object in: scale from `from` (default 0.6) to 1 with an overshoot, after `delay` seconds.
function UI.pop(obj: Instance, from: number?, delay: number?)
	local s = UI.squashScale(obj)
	if UI.Reduced then
		s.Scale = 1
		return
	end
	s.Scale = from or 0.6
	local function go()
		if s.Parent then
			UI.spring(s, Theme.Spring.Pop, { Scale = 1 })
		end
	end
	if delay and delay > 0 then
		task.delay(delay, go)
	else
		go()
	end
end

-- Counts a label up from `from` to `to` over `duration` seconds (results XP / coins, rewards). `fmt` turns the
-- number into text (default: whole number). Returns stop(), which jumps to the final text. Reduce Motion: instant.
function UI.countUp(label: TextLabel, from: number, to: number, duration: number?, fmt: ((number) -> string)?): () -> ()
	local f = fmt or function(n: number): string
		return tostring(math.floor(n + 0.5))
	end
	local d = duration or 0.8
	local stopped = false
	local function stop()
		if not stopped then
			stopped = true
			if label.Parent then
				label.Text = f(to)
			end
		end
	end
	if UI.Reduced or d <= 0 or from == to then
		stop()
		return stop
	end
	label.Text = f(from)
	local t0 = os.clock()
	task.spawn(function()
		while not stopped and label.Parent do
			local a = math.clamp((os.clock() - t0) / d, 0, 1)
			local e = 1 - (1 - a) ^ 3 -- ease out: fast first, slows into the final number
			label.Text = f(from + (to - from) * e)
			if a >= 1 then
				break
			end
			task.wait(1 / 30)
		end
		stop()
	end)
	return stop
end

-- Every shown red dot hops a little every few seconds (one shared loop; hidden or destroyed dots are skipped
-- or dropped). Position only, so the hop never fights the appear pop (scale).
local DOT_HOME = UDim2.new(1, -4, 0, 4)
local dots: { Frame } = {}
local dotLoop = false
local function hopDots()
	if dotLoop then
		return
	end
	dotLoop = true
	task.spawn(function()
		while #dots > 0 do
			task.wait(Theme.Loop.DotHopEvery)
			for i = #dots, 1, -1 do
				local d = dots[i]
				if d.Parent == nil then
					table.remove(dots, i)
				elseif d.Visible and not UI.Reduced then
					local up = TweenService:Create(d, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = DOT_HOME + UDim2.fromOffset(0, -6) })
					up.Completed:Connect(function()
						if d.Parent then
							TweenService:Create(d, TweenInfo.new(0.4, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), { Position = DOT_HOME }):Play()
						end
					end)
					up:Play()
				end
			end
		end
		dotLoop = false
	end)
end

-- Red "!" dot on something new (top-right corner of `parent`). `on` false hides it; a number shows the count
-- instead of "!". Pops when it appears, then hops now and then while shown. Returns the dot.
function UI.newDot(parent: GuiObject, on: boolean, count: number?): Frame
	local dot = parent:FindFirstChild("NewDot") :: Frame?
	if not dot then
		local d = Instance.new("Frame")
		d.Name = "NewDot"
		d.AnchorPoint = Vector2.new(0.5, 0.5)
		d.Position = DOT_HOME
		d.Size = UDim2.fromOffset(20, 20)
		d.BackgroundColor3 = Theme.Fx.NewDot
		d.BorderSizePixel = 0
		d.Visible = false
		d.ZIndex = parent.ZIndex + 5
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = d
		local st = Instance.new("UIStroke")
		st.Color = Theme.Fx.NewDotEdge
		st.Thickness = 2
		st.Parent = d
		UI.kitSkin(d, "badge_dot") -- kit badge picture (drawn red dot while its id is 0)
		d.Parent = parent
		dot = d
		table.insert(dots, d)
		hopDots()
	end
	local d = dot :: Frame
	local label = d:FindFirstChild("Mark") :: TextLabel?
	if not label then
		local l = UI.text(d, "!", { Name = "Mark", Font = UI.Head, TextSize = T.Tiny, Outline = "Light", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = d.ZIndex + 1 })
		l.TextWrapped = false
		label = l
	end
	local text = if count and count > 0 then tostring(math.min(count, 99)) else "!"
	if label and label.Text ~= text then
		label.Text = text
		if on and d.Visible then
			UI.pop(d, 0.7)
			UiJuice.wiggle(d) -- a new number: the badge wiggles
		end
	end
	if on and not d.Visible then
		d.Visible = true
		UI.pop(d, 0.3)
		UiJuice.wiggle(d)
	elseif not on then
		d.Visible = false
	end
	return d
end

-- Rarity glow: a border in the rarity colour, and for the rarest ones (shimmer = true) a light band that slowly
-- travels round it. One shared loop (15 Hz) turns every shimmer; destroyed ones drop out.
local shimmers: { UIGradient } = {}
local shimmerLoop = false
function UI.rarityGlow(obj: GuiObject, color: Color3, shimmer: boolean?): UIStroke
	local st = obj:FindFirstChild("RarityGlow") :: UIStroke?
	if not st then
		local n = Instance.new("UIStroke")
		n.Name = "RarityGlow"
		n.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		n.LineJoinMode = Enum.LineJoinMode.Round
		n.Parent = obj
		st = n
	end
	local s = st :: UIStroke
	-- an object has one visible border: hide the ordinary one under the glow
	local plain = obj:FindFirstChild("Border")
	if plain and plain:IsA("UIStroke") then
		plain.Enabled = false
	end
	s.Color = color
	s.Thickness = 2.5
	if shimmer and not s:FindFirstChild("Shimmer") then
		local g = Instance.new("UIGradient")
		g.Name = "Shimmer"
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, color),
			ColorSequenceKeypoint.new(0.45, color),
			ColorSequenceKeypoint.new(0.5, Theme.Fx.Shine),
			ColorSequenceKeypoint.new(0.55, color),
			ColorSequenceKeypoint.new(1, color),
		})
		g.Parent = s
		table.insert(shimmers, g)
		if not shimmerLoop and not UI.Reduced then
			shimmerLoop = true
			task.spawn(function()
				while #shimmers > 0 do
					local r = (os.clock() * 90) % 360
					for i = #shimmers, 1, -1 do
						local gi = shimmers[i]
						if gi.Parent == nil then
							table.remove(shimmers, i)
						elseif not UI.Reduced then
							gi.Rotation = r
						end
					end
					task.wait(1 / 15)
				end
				shimmerLoop = false
			end)
		end
	end
	return s
end

local player = Players.LocalPlayer
local layers: { [string]: ScreenGui } = {}

-- Scale: design canvas ~800 x 400. Landscape phones 667-1108 wide land at 0.83-1.3 (unchanged). Bigger screens keep
-- growing with the height so a menu takes about the same share of a 1080p or 1440p monitor as of a phone:
-- past 1.3 the logical canvas is held at ~600 tall (1080p -> 1.8, 1440p -> 2.4, 4K -> 3.6). A 1366 x 768
-- laptop stays at 1.3.
local DESIGN_W, DESIGN_H, BIG_H = 800, 400, 600
-- Portrait phones are held to a ~390 wide canvas (390 -> 1.0, 430 -> 1.1): the landscape rule would floor them at
-- 0.8 and shrink every label by a fifth.
local PORTRAIT_W = 390
function UI.scaleFor(v: Vector2): number
	if v.Y > v.X then
		return math.clamp(v.X / PORTRAIT_W, 0.8, 1.3)
	end
	local s = math.min(v.X / DESIGN_W, v.Y / DESIGN_H)
	if s <= 1.3 then
		return math.max(s, 0.8)
	end
	return math.max(1.3, math.min(s, v.Y / BIG_H))
end

-- Every constraint UI.fit made, with its design (size, minSize): re-applied when UI.Scale changes so the real-pixel
-- text floor follows the screen (weak keys: a destroyed label drops out).
local fitted: { [UITextSizeConstraint]: { number | any } } = setmetatable({}, { __mode = "k" }) :: any
local fittedScale = 1
local function refitText()
	if math.abs(UI.Scale - fittedScale) < 0.001 then
		return
	end
	fittedScale = UI.Scale
	for c, d in fitted do
		if c.Parent then
			local hi, lo = UiKit.textRange(d[1], d[2], UI.Scale)
			c.MaxTextSize = hi
			c.MinTextSize = lo
		end
	end
end

local function fitScale(gui: ScreenGui, scale: UIScale)
	local function fit()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local v = gui.AbsoluteSize
		if v.X < 2 or v.Y < 2 then
			v = cam.ViewportSize
		end
		scale.Scale = UI.scaleFor(v)
		UI.Scale = scale.Scale
		refitText()
		local l = v / scale.Scale
		-- rounded so "Logical.Y >= 600" holds exactly on screens held at the 600 canvas
		local logical = Vector2.new(math.floor(l.X * 1000 + 0.5) / 1000, math.floor(l.Y * 1000 + 0.5) / 1000)
		if logical ~= UI.Logical then
			UI.Logical = logical
			UI.Resized:Fire()
		end
	end
	fit()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
end

UI.Logical = Vector2.new(800, 400)
UI.Resized = Instance.new("BindableEvent") -- fires after UI.Logical changes (a window resized, a phone turned)
UI.ButtonWord = nil :: ((label: TextLabel) -> ())? -- HudArt installs it: owner word pictures on buttons
UI.Scale = 1 -- current UIScale of every layer (they share the viewport)

-- Touch floor in REAL pixels. Theme.Size.Touch (44) is logical and UIScale goes down to 0.8 on small phones, so a
-- 44 logical control can be 35 real px. UI.minTouch() is the logical size that is 44 real px right now.
function UI.minTouch(): number
	return math.max(TS.Touch, math.ceil(TS.Touch / math.max(UI.Scale, 0.1)))
end

-- On touch screens a button smaller than 44 real px gets invisible strips around it that take the tap too
-- (the drawn button and the layout stay as designed). Sized in scale units of the button, so any UIScale above it
-- (layer, modal pop-in, press dip) is already included in AbsoluteSize.
local TOUCH_PAD = UserInputService.TouchEnabled
local function touchPad(b: GuiButton, fire: () -> (), press: ((boolean) -> ())?)
	if not TOUCH_PAD then
		return
	end
	local strips: { [string]: TextButton } = {}
	for _, side in { "Top", "Bottom", "Left", "Right" } do
		local s = Instance.new("TextButton")
		s.Name = "TouchPad" .. side
		s.Text = ""
		s.BackgroundTransparency = 1
		s.BorderSizePixel = 0
		s.AutoButtonColor = false
		s.Selectable = false
		s.Visible = false
		s.Parent = b
		s.Activated:Connect(fire)
		if press then
			s.MouseButton1Down:Connect(function()
				press(true)
			end)
			s.MouseButton1Up:Connect(function()
				press(false)
			end)
			s.MouseLeave:Connect(function()
				press(false)
			end)
		end
		strips[side] = s
	end
	local function fit()
		local a = b.AbsoluteSize
		if a.X < 1 or a.Y < 1 then
			return
		end
		local real = TS.Touch
		local fy = math.max(0, (real - a.Y) / 2) / a.Y
		local fx = math.max(0, (real - a.X) / 2) / a.X
		strips.Top.Visible = fy > 0
		strips.Bottom.Visible = fy > 0
		strips.Top.Position = UDim2.fromScale(0, -fy)
		strips.Top.Size = UDim2.fromScale(1, fy)
		strips.Bottom.Position = UDim2.fromScale(0, 1)
		strips.Bottom.Size = UDim2.fromScale(1, fy)
		strips.Left.Visible = fx > 0
		strips.Right.Visible = fx > 0
		strips.Left.Position = UDim2.fromScale(-fx, -fy)
		strips.Left.Size = UDim2.fromScale(fx, 1 + 2 * fy)
		strips.Right.Position = UDim2.fromScale(1, -fy)
		strips.Right.Size = UDim2.fromScale(fx, 1 + 2 * fy)
	end
	fit()
	b:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
end
UI.touchPad = touchPad

local function layer(name: string, order: number): ScreenGui
	local have = layers[name]
	if have and have.Parent then
		return have
	end
	local sg = Instance.new("ScreenGui")
	sg.Name = name
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = false
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	sg.DisplayOrder = order
	sg.Parent = player:WaitForChild("PlayerGui")
	local scale = Instance.new("UIScale")
	scale.Name = "Scale"
	scale.Parent = sg
	fitScale(sg, scale)
	layers[name] = sg
	return sg
end

-- HUD layer (the loading screen waits for this ScreenGui by name).
function UI.screen(): ScreenGui
	return layer("CrackTheRocks", 5)
end
-- Primary menus and the reveal.
function UI.overlay(): ScreenGui
	return layer("CrackTheRocksModal", 20)
end
-- Confirmation dialogs, above any menu.
function UI.dialogLayer(): ScreenGui
	return layer("CrackTheRocksDialog", 25)
end
-- Notifications, above everything (so a message is never hidden behind a menu).
function UI.noticeLayer(): ScreenGui
	return layer("CrackTheRocksNotice", 30)
end

function UI.isPortrait(): boolean
	return UI.Logical.Y > UI.Logical.X
end

-- Compact phones: logical height under ~480 (landscape phones).
function UI.isShort(): boolean
	return not UI.isPortrait() and UI.Logical.Y < 480
end

-- Builders -----------------------------------------------------------------------------

local function apply(obj: Instance, props: { [string]: any }?)
	if props then
		for k, v in props do
			(obj :: any)[k] = v
		end
	end
end
UI.apply = apply

function UI.corner(parent: Instance, r: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or T.Radius)
	c.Parent = parent
	return c
end

-- Border around a frame or button (never on text: text outlines come from UI.outline).
function UI.stroke(parent: Instance, color: Color3?, thick: number?)
	local s = Instance.new("UIStroke")
	s.Name = "Border"
	s.Color = color or TC.PanelEdge
	s.Thickness = thick or TS.BorderThin
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = parent
	return s
end

-- Black outline on a text object (strength: "Strong" | "Normal" | "Light").
function UI.outline(label: Instance, strength: string?)
	local old = label:FindFirstChild("Outline")
	if old then
		old:Destroy()
	end
	local s = Instance.new("UIStroke")
	s.Name = "Outline"
	s.Color = TC.Outline
	local base = Theme.Outline[strength or "Normal"] or Theme.Outline.Normal
	s.Thickness = base
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = label
	-- contrast floor: light words carry at least UiKit.LightOutline px of dark outline, also after a recolour
	if label:IsA("TextLabel") or label:IsA("TextButton") or label:IsA("TextBox") then
		local tl = label :: any
		local function thick()
			if s.Parent == (label :: Instance) then
				s.Thickness = UiKit.outlineFor(tl.TextColor3, base)
			end
		end
		thick()
		label:GetPropertyChangedSignal("TextColor3"):Connect(thick)
	end
	-- the stroke ignores TextTransparency, so hidden text would still draw as a black blob: keep them in step
	if label:IsA("TextLabel") or label:IsA("TextButton") or label:IsA("TextBox") then
		local tl = label :: any
		s.Transparency = tl.TextTransparency
		label:GetPropertyChangedSignal("TextTransparency"):Connect(function()
			if s.Parent == (label :: Instance) then
				s.Transparency = tl.TextTransparency
			end
		end)
	end
	return s
end

function UI.pad(parent: Instance, px: number, py: number?)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, py or px)
	p.PaddingBottom = UDim.new(0, py or px)
	p.Parent = parent
	return p
end

function UI.list(parent: Instance, dir: Enum.FillDirection?, gap: number?, align: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?)
	local l = Instance.new("UIListLayout")
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, gap or T.Gap)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = align or Enum.HorizontalAlignment.Left
	l.VerticalAlignment = valign or Enum.VerticalAlignment.Top
	l.Parent = parent
	return l
end

function UI.frame(parent: Instance, props: { [string]: any }?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = TC.Panel
	f.BorderSizePixel = 0
	apply(f, props)
	f.Parent = parent
	return f
end

-- Fits text into its box: designed size when it fits, shrinks otherwise (see top comment).
function UI.fit(label: any, size: number, minSize: number?)
	local c = label:FindFirstChild("Fit") :: UITextSizeConstraint?
	if not c then
		local nc = Instance.new("UITextSizeConstraint")
		nc.Name = "Fit"
		nc.Parent = label
		c = nc
	end
	-- the text floor (UiKit.textRange): designed at 14 px or more, and never drawn under 12 REAL px at the current scale
	local hi, lo = UiKit.textRange(size, minSize, UI.Scale)
	;(c :: UITextSizeConstraint).MaxTextSize = hi
	;(c :: UITextSizeConstraint).MinTextSize = lo
	label.TextScaled = true
	fitted[c :: UITextSizeConstraint] = { size, minSize }
end

-- A one-line label: no wrapping, and the scaled text shrinks to show the whole line instead of wrapping and hiding
-- its second half in a one-line box. Studio check 2026-10-16: with TextTruncate on, scaled text stopped shrinking
-- and showed "GOLDEN..." in a box wide enough for the whole name, so truncation stays off; and a long name may go
-- under the usual text floor (down to `minSize`, default 8) rather than lose letters.
function UI.oneLine(label: TextLabel, minSize: number?)
	label.TextWrapped = false
	label.TextTruncate = Enum.TextTruncate.None
	label.TextScaled = true
	local c = label:FindFirstChild("Fit") :: UITextSizeConstraint?
	if c then
		fitted[c] = nil -- a scale change must not lift the floor back up
		c.MinTextSize = math.min(c.MinTextSize, minSize or 8)
	end
end

-- Text label. props.TextSize is the designed size (default Body). props.Outline = "Strong" | "Normal" | "Light" |
-- false (default: Strong for the display font, Light otherwise; none on dark-on-gold text).
function UI.text(parent: Instance, text: string, props: { [string]: any }?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = UI.Body
	t.TextColor3 = TC.Text
	t.Text = text
	t.TextWrapped = true
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	local size = T.Body
	local outline: any = nil
	if props then
		if props.TextSize then
			size = props.TextSize
		end
		if props.Outline ~= nil then
			outline = props.Outline
		end
		props = table.clone(props)
		props.Outline = nil
	end
	t.Size = UDim2.new(1, 0, 0, math.ceil(size * 1.35))
	apply(t, props)
	UI.fit(t, size)
	if outline == nil then
		-- dark text (on gold, or navy notes on a white sheet) never takes the dark outline: it would turn the letters
		-- into one blot
		outline = if t.TextColor3 == TC.DarkText or (Theme.PetStyle and not UiKit.isLight(t.TextColor3)) then false elseif t.Font == UI.Head then "Strong" else "Light"
	end
	if outline == "Normal" and size <= T.Small then
		outline = "Light" -- small body text under the full outline reads heavy and blotted
	end
	if not outline and UiKit.isLight(t.TextColor3) then
		outline = "Light" -- contrast floor: light words over colour always get a dark outline (UI.outline: 2 px or more)
	end
	if outline then
		UI.outline(t, outline)
	else
		-- dark words recoloured light later (row hover, state colours) get their outline then
		t:GetPropertyChangedSignal("TextColor3"):Connect(function()
			if UiKit.isLight(t.TextColor3) and not t:FindFirstChild("Outline") then
				UI.outline(t, "Light")
			end
		end)
	end
	if t.Font == UI.Head and UI.Head ~= UI.Bold then
		-- the display font is drawn in capitals only (its lower case reads as odd small caps); the pet style's one
		-- round font keeps its mixed case
		local function caps()
			local u = UI.caps(t.Text)
			if u ~= t.Text then
				t.Text = u
			end
		end
		caps()
		t:GetPropertyChangedSignal("Text"):Connect(caps)
	end
	t.Parent = parent
	return t
end

-- "PET BOOK" -> "Pet Book" (a title given in capitals for the old bubble font); mixed case stays as it is.
function UI.titleCase(s: string): string
	if s ~= string.upper(s) then
		return s
	end
	local out = {}
	for word in string.gmatch(string.lower(s), "%S+") do
		table.insert(out, string.upper(string.sub(word, 1, 1)) .. string.sub(word, 2))
	end
	return table.concat(out, " ")
end

-- Upper case outside rich-text tags ("Find the <font color=...>geode</font>" keeps its tag intact).
function UI.caps(s: string): string
	local parts = {}
	local i = 1
	while i <= #s do
		local a = string.find(s, "<", i, true)
		if not a then
			table.insert(parts, string.upper(string.sub(s, i)))
			break
		end
		table.insert(parts, string.upper(string.sub(s, i, a - 1)))
		local b = string.find(s, ">", a, true) or #s
		table.insert(parts, string.sub(s, a, b))
		i = b + 1
	end
	return table.concat(parts)
end

-- One number formatter for coins: commas below 100,000 ("12,345"), short above ("123K", "1.2M", "3.4B").
function UI.num(n: number): string
	local v = math.floor(n)
	local neg = v < 0
	v = math.abs(v)
	local out: string
	if v < 100000 then
		local s = tostring(v)
		out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
		if out:sub(1, 1) == "," then
			out = out:sub(2)
		end
	else
		local sizes = { 1e9, 1e6, 1e3 }
		local names = { "B", "M", "K" }
		out = tostring(v)
		for i, size in sizes do
			if v >= size then
				local x = v / size
				local t = if x >= 100 then tostring(math.floor(x)) else string.format("%.1f", math.floor(x * 10) / 10)
				out = (string.gsub(t, "%.0$", "")) .. names[i]
				break
			end
		end
	end
	return if neg then "-" .. out else out
end

function UI.money(n: number): string
	return UI.num(n) .. " coins"
end

-- Icons ------------------------------------------------------------------------------------
-- One illustrated family drawn from rounded blocks: flat fills, one black outline weight (size / 16), a
-- lighter top facet where it helps. props.Color tints the main shape (muted / disabled glyphs).
-- kinds: cash rubble basket rock tray queue hammer jackhammer hand machine press crusher geode gem gear party user
-- shop home exit results lock sell arrow back close plus check star crown clock trophy pickaxe book calendar music
-- speaker camera motion sparkle hint display storage tier1..tier5 warn info

local TIER_COLORS = {
	{ Color3.fromRGB(205, 120, 70), Color3.fromRGB(150, 76, 40) }, -- bronze
	{ Color3.fromRGB(200, 210, 222), Color3.fromRGB(130, 140, 156) }, -- silver
	{ Color3.fromRGB(255, 200, 40), Color3.fromRGB(196, 132, 10) }, -- gold
	{ Color3.fromRGB(240, 96, 60), Color3.fromRGB(150, 40, 24) }, -- volcanic
	{ Color3.fromRGB(150, 110, 255), Color3.fromRGB(80, 50, 170) }, -- meteor
}
UI.TierColors = TIER_COLORS

function UI.icon(parent: Instance, kind: string, size: number, props: { [string]: any }?): Frame
	local box = UI.frame(parent, { Name = "Icon", Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	local tint: Color3? = nil
	local noOutline = false
	if props then
		tint = props.Color
		noOutline = props.Flat == true
		props = table.clone(props)
		props.Color, props.Accent, props.Bg, props.Flat = nil, nil, nil, nil
	end
	apply(box, props)
	if kind == "cash" then
		-- the kit coin picture (UiKit icon_coin) replaces the drawn coin stack once it has an id
		local k = UiKit.skinFor("icon_coin")
		if k then
			local il = Instance.new("ImageLabel")
			il.Name = "KitIcon"
			il.BackgroundTransparency = 1
			il.Size = UDim2.fromScale(1, 1)
			il.Image = k.Image
			il.ScaleType = Enum.ScaleType.Fit
			il.ZIndex = box.ZIndex
			if tint then
				il.ImageColor3 = tint
			end
			il.Parent = box
			return box
		end
	end
	local lw = math.max(1, size / 16)
	local function sq(x: number, y: number, w: number, h: number, color: Color3, rot: number?, round: number?, line: boolean?): Frame
		local f = UI.frame(box, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, y),
			Size = UDim2.fromScale(w, h),
			BackgroundColor3 = tint or color,
			Rotation = rot or 0,
		})
		UI.corner(f, round or math.max(1, math.floor(size * 0.1)))
		if line ~= false and not noOutline then
			UI.stroke(f, TC.Outline, lw)
		end
		return f
	end
	local function disc(x: number, y: number, d: number, color: Color3, line: boolean?)
		return sq(x, y, d, d, color, 0, 999, line)
	end
	local function glyph(text: string, color: Color3, scale: number?)
		local g = UI.text(box, text, { Name = "Glyph", Size = UDim2.fromScale(1, 1), TextSize = math.max(8, size * (scale or 0.62)), Font = UI.Head, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = color, Outline = "Normal" })
		return g
	end
	local WHITE = Color3.fromRGB(250, 250, 250)
	local STEEL = Color3.fromRGB(150, 160, 172)
	local STEEL_HI = Color3.fromRGB(200, 208, 218)
	local WOOD = Color3.fromRGB(168, 104, 52)
	local STONE = Color3.fromRGB(128, 132, 140)
	local STONE_HI = Color3.fromRGB(170, 174, 182)
	local WICKER = Color3.fromRGB(214, 150, 66)
	local WICKER_D = Color3.fromRGB(160, 98, 36)
	local PURPLE = Color3.fromRGB(160, 80, 240)
	local PURPLE_HI = Color3.fromRGB(214, 168, 255)
	local GOLD = TC.Gold
	if kind == "cash" then
		-- a gold coin (the currency is COINS; a bill read as a different money)
		disc(0.54, 0.56, 0.84, Color3.fromRGB(214, 140, 28))
		disc(0.48, 0.48, 0.84, GOLD)
		disc(0.48, 0.48, 0.56, Color3.fromRGB(255, 214, 92), false)
		sq(0.48, 0.48, 0.12, 0.34, Color3.fromRGB(214, 140, 28), 0, 2, false)
	elseif kind == "egg" or string.sub(kind, 1, 4) == "egg_" then
		-- an egg (shop tiers: egg_basic / egg_rare / egg_mythic). Tiers differ in shell and spot colour AND in the gold
		-- marks on top (none / one / three), so they never rely on colour alone.
		local tier = string.sub(kind, 5)
		local shell = if tier == "rare" then Color3.fromRGB(120, 196, 255) elseif tier == "mythic" then Color3.fromRGB(196, 140, 255) else Color3.fromRGB(255, 244, 222)
		local spot = if tier == "rare" then Color3.fromRGB(40, 120, 220) elseif tier == "mythic" then Color3.fromRGB(255, 206, 70) else Color3.fromRGB(120, 200, 110)
		sq(0.5, 0.54, 0.64, 0.86, shell, 0, 999)
		disc(0.38, 0.62, 0.16, spot, false)
		disc(0.62, 0.72, 0.12, spot, false)
		disc(0.6, 0.44, 0.1, spot, false)
		sq(0.4, 0.32, 0.1, 0.2, WHITE, -20, 999, false)
		local marks: { number } = if tier == "rare" then { 0.5 } elseif tier == "mythic" then { 0.3, 0.5, 0.7 } else {}
		for _, x in marks do
			sq(x, 0.12, 0.18, 0.18, GOLD, 45, 2)
		end
	elseif kind == "rubble" then
		-- the candy the eggs leave (old rubble id): a wrapped sweet, pink with a white stripe
		local pink, pinkD = Color3.fromRGB(255, 120, 190), Color3.fromRGB(220, 70, 150)
		sq(0.18, 0.5, 0.26, 0.3, pinkD, 45, 2)
		sq(0.82, 0.5, 0.26, 0.3, pinkD, 45, 2)
		sq(0.5, 0.5, 0.52, 0.52, pink, 0, 999)
		sq(0.5, 0.5, 0.1, 0.5, WHITE, 30, 2, false)
	elseif kind == "basket" then
		local handle = sq(0.5, 0.36, 0.6, 0.5, WICKER_D, 0, 999)
		handle.BackgroundTransparency = 1
		local hs = handle:FindFirstChild("Border") :: UIStroke?
		if hs then
			hs.Color = WICKER_D
			hs.Thickness = math.max(2, size / 10)
		end
		sq(0.36, 0.42, 0.24, 0.2, STONE, 30)
		sq(0.62, 0.42, 0.26, 0.22, STONE_HI, -20)
		sq(0.5, 0.7, 0.86, 0.44, WICKER, 0, 3)
		sq(0.5, 0.52, 0.92, 0.1, WICKER_D, 0, 2)
		sq(0.5, 0.72, 0.7, 0.05, WICKER_D, 0, 1, false)
	elseif kind == "rock" then
		sq(0.5, 0.62, 0.86, 0.6, STONE, 0, math.floor(size * 0.22))
		sq(0.42, 0.44, 0.5, 0.32, STONE_HI, -12, math.floor(size * 0.14), false)
	elseif kind == "tray" or kind == "queue" then
		sq(0.32, 0.46, 0.3, 0.28, STONE, 30)
		sq(0.66, 0.44, 0.32, 0.3, STONE_HI, -20)
		sq(0.5, 0.74, 0.94, 0.24, WOOD, 0, 3)
	elseif kind == "hammer" then
		sq(0.42, 0.62, 0.16, 0.72, WOOD, 40, 3)
		sq(0.64, 0.32, 0.56, 0.28, STEEL, 40, 3)
		sq(0.64, 0.28, 0.4, 0.1, STEEL_HI, 40, 2, false)
	elseif kind == "jackhammer" then
		sq(0.5, 0.14, 0.76, 0.14, Color3.fromRGB(60, 62, 68), 0, 4)
		sq(0.5, 0.44, 0.46, 0.42, GOLD, 0, 5)
		sq(0.5, 0.84, 0.12, 0.3, STEEL, 0, 2)
	elseif kind == "hand" then
		-- a work glove: palm, four fingers, thumb
		local GLOVE = Color3.fromRGB(255, 206, 60)
		for i = 0, 3 do
			sq(0.3 + i * 0.13, 0.3, 0.12, 0.4, GLOVE, 0, 999)
		end
		sq(0.18, 0.56, 0.12, 0.34, GLOVE, -40, 999)
		sq(0.48, 0.62, 0.56, 0.44, GLOVE, 0, math.floor(size * 0.16))
		sq(0.48, 0.86, 0.5, 0.12, Color3.fromRGB(206, 150, 30), 0, 2)
	elseif kind == "machine" then
		sq(0.5, 0.62, 0.86, 0.5, GOLD, 0, 4)
		sq(0.5, 0.26, 0.4, 0.22, Color3.fromRGB(60, 62, 68), 0, 3)
		disc(0.3, 0.62, 0.2, Color3.fromRGB(60, 62, 68))
		disc(0.7, 0.62, 0.2, Color3.fromRGB(60, 62, 68))
	elseif kind == "press" then
		sq(0.5, 0.12, 0.84, 0.16, Color3.fromRGB(60, 62, 68), 0, 3)
		sq(0.5, 0.34, 0.16, 0.3, STEEL, 0, 2)
		sq(0.5, 0.56, 0.6, 0.14, GOLD, 0, 3)
		sq(0.5, 0.86, 0.86, 0.16, Color3.fromRGB(60, 62, 68), 0, 3)
	elseif kind == "crusher" then
		sq(0.5, 0.78, 0.86, 0.28, GOLD, 0, 4)
		disc(0.3, 0.4, 0.4, STEEL)
		disc(0.7, 0.4, 0.4, STEEL)
	elseif kind == "geode" then
		sq(0.5, 0.54, 0.86, 0.8, STONE, 0, 999)
		sq(0.5, 0.56, 0.58, 0.54, PURPLE, 0, 999)
		sq(0.42, 0.5, 0.16, 0.24, PURPLE_HI, 20, 2, false)
		sq(0.6, 0.6, 0.14, 0.2, PURPLE_HI, -25, 2, false)
	elseif kind == "gem" then
		sq(0.5, 0.52, 0.62, 0.62, PURPLE, 45, 4)
		sq(0.42, 0.42, 0.2, 0.2, PURPLE_HI, 45, 2, false)
	elseif kind == "gear" then
		for i = 0, 3 do
			sq(0.5, 0.5, 0.92, 0.22, WHITE, i * 45, 2, false)
		end
		disc(0.5, 0.5, 0.66, WHITE)
		disc(0.5, 0.5, 0.26, Color3.fromRGB(44, 45, 49))
	elseif kind == "party" then
		disc(0.32, 0.28, 0.3, Color3.fromRGB(70, 140, 255))
		sq(0.32, 0.72, 0.46, 0.44, Color3.fromRGB(70, 140, 255), 0, 6)
		disc(0.7, 0.32, 0.28, Color3.fromRGB(240, 70, 60))
		sq(0.7, 0.74, 0.42, 0.4, Color3.fromRGB(240, 70, 60), 0, 6)
	elseif kind == "user" then
		disc(0.5, 0.3, 0.38, Color3.fromRGB(170, 174, 182))
		sq(0.5, 0.78, 0.74, 0.42, Color3.fromRGB(170, 174, 182), 0, 8)
	elseif kind == "shop" then
		sq(0.42, 0.62, 0.16, 0.72, WOOD, 40, 3)
		sq(0.64, 0.32, 0.56, 0.28, STEEL, 40, 3)
	elseif kind == "home" or kind == "exit" then
		sq(0.42, 0.52, 0.56, 0.8, WOOD, 0, 3)
		sq(0.42, 0.52, 0.36, 0.64, Color3.fromRGB(60, 40, 22), 0, 2, false)
		sq(0.78, 0.52, 0.34, 0.14, GOLD, 0, 2)
		sq(0.84, 0.44, 0.14, 0.18, GOLD, 45, 2, false)
		sq(0.84, 0.6, 0.14, 0.18, GOLD, -45, 2, false)
	elseif kind == "results" then
		sq(0.5, 0.5, 0.72, 0.88, WHITE, 0, 4)
		for i = 0, 2 do
			sq(0.5, 0.3 + i * 0.2, 0.44, 0.08, if i == 0 then GOLD else STONE, 0, 1, false)
		end
	elseif kind == "lock" then
		local sh = sq(0.5, 0.34, 0.46, 0.46, STEEL, 0, 999)
		sh.BackgroundTransparency = 1
		local s = sh:FindFirstChild("Border") :: UIStroke?
		if s then
			s.Color = STEEL
			s.Thickness = math.max(2, size / 9)
		end
		sq(0.5, 0.68, 0.72, 0.5, GOLD, 0, 4)
		disc(0.5, 0.66, 0.12, Color3.fromRGB(60, 40, 10), false)
	elseif kind == "sell" then
		sq(0.5, 0.74, 0.86, 0.3, WICKER, 0, 4)
		sq(0.5, 0.36, 0.5, 0.3, Color3.fromRGB(70, 196, 64), -8)
	elseif kind == "arrow" then
		sq(0.5, 0.6, 0.18, 0.6, WHITE, 0, 3)
		sq(0.36, 0.36, 0.18, 0.46, WHITE, 45, 3)
		sq(0.64, 0.36, 0.18, 0.46, WHITE, -45, 3)
	elseif kind == "back" then
		sq(0.42, 0.36, 0.18, 0.5, WHITE, 45, 3)
		sq(0.42, 0.64, 0.18, 0.5, WHITE, -45, 3)
	elseif kind == "close" then
		sq(0.5, 0.5, 0.2, 0.82, WHITE, 45, 2)
		sq(0.5, 0.5, 0.2, 0.82, WHITE, -45, 2)
		sq(0.5, 0.5, 0.2, 0.82, WHITE, 45, 2, false)
	elseif kind == "plus" then
		sq(0.5, 0.5, 0.18, 0.72, WHITE, 0, 3)
		sq(0.5, 0.5, 0.72, 0.18, WHITE, 0, 3)
		sq(0.5, 0.5, 0.18, 0.72, WHITE, 0, 3, false)
	elseif kind == "check" then
		disc(0.5, 0.5, 0.92, Color3.fromRGB(70, 190, 70))
		sq(0.38, 0.56, 0.12, 0.3, WHITE, -45, 2, false)
		sq(0.58, 0.48, 0.12, 0.5, WHITE, 45, 2, false)
	elseif kind == "star" then
		sq(0.5, 0.5, 0.6, 0.6, GOLD, 0, 2)
		sq(0.5, 0.5, 0.6, 0.6, GOLD, 45, 2)
	elseif kind == "crown" then
		sq(0.5, 0.7, 0.8, 0.26, GOLD, 0, 3)
		sq(0.24, 0.44, 0.18, 0.4, GOLD, -12, 3)
		sq(0.5, 0.38, 0.18, 0.46, GOLD, 0, 3)
		sq(0.76, 0.44, 0.18, 0.4, GOLD, 12, 3)
		sq(0.5, 0.7, 0.8, 0.26, GOLD, 0, 3, false)
	elseif kind == "clock" then
		disc(0.5, 0.5, 0.86, WHITE)
		sq(0.5, 0.36, 0.08, 0.32, Color3.fromRGB(44, 45, 49), 0, 2, false)
		sq(0.62, 0.52, 0.28, 0.08, Color3.fromRGB(44, 45, 49), 0, 2, false)
	elseif kind == "trophy" then
		sq(0.5, 0.36, 0.6, 0.5, GOLD, 0, 8)
		sq(0.5, 0.7, 0.14, 0.22, GOLD, 0, 2)
		sq(0.5, 0.86, 0.5, 0.12, Color3.fromRGB(196, 132, 10), 0, 2)
	elseif kind == "pickaxe" then
		sq(0.5, 0.56, 0.12, 0.8, WOOD, 40, 3)
		sq(0.5, 0.36, 0.86, 0.16, STEEL, -12, 999)
	elseif kind == "book" then
		-- the Pet Book: a red cover with its page edge showing and a gold paw-pad on the front
		sq(0.5, 0.52, 0.74, 0.84, Color3.fromRGB(214, 64, 56), 0, 3)
		sq(0.79, 0.52, 0.1, 0.74, WHITE, 0, 1, false)
		sq(0.2, 0.52, 0.1, 0.84, Color3.fromRGB(150, 36, 32), 0, 2, false)
		disc(0.47, 0.56, 0.3, GOLD)
		disc(0.36, 0.36, 0.12, GOLD, false)
		disc(0.58, 0.36, 0.12, GOLD, false)
	elseif kind == "calendar" then
		sq(0.5, 0.56, 0.84, 0.74, WHITE, 0, 4)
		sq(0.5, 0.28, 0.84, 0.2, Color3.fromRGB(240, 70, 60), 0, 3)
		for i = 0, 2 do
			for j = 0, 1 do
				sq(0.28 + i * 0.22, 0.54 + j * 0.2, 0.12, 0.1, Color3.fromRGB(70, 140, 255), 0, 1, false)
			end
		end
	elseif kind == "music" then
		disc(0.32, 0.76, 0.3, WHITE)
		disc(0.74, 0.66, 0.3, WHITE)
		sq(0.42, 0.44, 0.08, 0.6, WHITE, 0, 1, false)
		sq(0.84, 0.36, 0.08, 0.6, WHITE, 0, 1, false)
		sq(0.63, 0.16, 0.5, 0.12, WHITE, -12, 1)
	elseif kind == "speaker" then
		sq(0.26, 0.5, 0.24, 0.32, WHITE, 0, 2)
		sq(0.44, 0.5, 0.26, 0.58, WHITE, 0, 3)
		sq(0.72, 0.5, 0.08, 0.32, WHITE, 0, 2)
		sq(0.88, 0.5, 0.08, 0.54, WHITE, 0, 2)
	elseif kind == "camera" then
		sq(0.5, 0.58, 0.9, 0.62, WHITE, 0, 5)
		sq(0.5, 0.24, 0.34, 0.14, WHITE, 0, 2)
		disc(0.5, 0.58, 0.38, Color3.fromRGB(44, 45, 49))
		disc(0.5, 0.58, 0.18, WHITE, false)
	elseif kind == "motion" then
		disc(0.6, 0.18, 0.22, WHITE)
		sq(0.52, 0.48, 0.18, 0.42, WHITE, 20, 4)
		sq(0.36, 0.8, 0.14, 0.36, WHITE, 30, 3)
		sq(0.66, 0.8, 0.14, 0.34, WHITE, -25, 3)
		sq(0.18, 0.4, 0.22, 0.07, WHITE, 0, 1, false)
		sq(0.14, 0.54, 0.2, 0.07, WHITE, 0, 1, false)
	elseif kind == "sparkle" then
		sq(0.42, 0.52, 0.18, 0.7, GOLD, 0, 999)
		sq(0.42, 0.52, 0.7, 0.18, GOLD, 0, 999)
		sq(0.76, 0.24, 0.1, 0.34, WHITE, 0, 999)
		sq(0.76, 0.24, 0.34, 0.1, WHITE, 0, 999)
	elseif kind == "hint" then
		disc(0.5, 0.4, 0.62, GOLD)
		sq(0.5, 0.78, 0.32, 0.18, STEEL, 0, 2)
	elseif kind == "display" then
		sq(0.5, 0.74, 0.92, 0.22, WOOD, 0, 3)
		for i = 0, 2 do
			sq(0.22 + i * 0.28, 0.46, 0.22, 0.32, Color3.fromRGB(60, 62, 68), 0, 3)
		end
	elseif kind == "storage" then
		sq(0.5, 0.56, 0.84, 0.74, WOOD, 0, 3)
		sq(0.5, 0.56, 0.84, 0.08, Color3.fromRGB(120, 70, 30), 0, 1, false)
		sq(0.5, 0.56, 0.08, 0.74, Color3.fromRGB(120, 70, 30), 0, 1, false)
	elseif string.sub(kind, 1, 4) == "tier" then
		local n = tonumber(string.sub(kind, 5)) or 1
		local col = TIER_COLORS[math.clamp(n, 1, #TIER_COLORS)]
		sq(0.5, 0.5, 0.74, 0.74, col[2], 45, 4)
		sq(0.5, 0.5, 0.5, 0.5, col[1], 45, 3, false)
		sq(0.44, 0.42, 0.16, 0.16, Color3.new(1, 1, 1), 45, 2, false).BackgroundTransparency = 0.45
	elseif kind == "boostCoins" then
		-- pet type icons (Coins / Speed / Luck): procedural stand-ins. REPLACE with the owner's icon art when uploaded.
		disc(0.5, 0.5, 0.9, Color3.fromRGB(255, 196, 40))
		disc(0.5, 0.5, 0.6, Color3.fromRGB(255, 226, 120), false)
		sq(0.5, 0.5, 0.14, 0.38, Color3.fromRGB(200, 140, 20), 0, 2, false)
	elseif kind == "boostSpeed" then
		disc(0.5, 0.5, 0.9, Color3.fromRGB(40, 120, 200))
		sq(0.58, 0.32, 0.16, 0.42, Color3.fromRGB(150, 230, 255), 25, 1, false)
		sq(0.5, 0.5, 0.42, 0.12, Color3.fromRGB(150, 230, 255), -20, 1, false)
		sq(0.42, 0.68, 0.16, 0.42, Color3.fromRGB(150, 230, 255), 25, 1, false)
	elseif kind == "boostLuck" then
		local LEAF = Color3.fromRGB(96, 220, 110)
		disc(0.5, 0.5, 0.9, Color3.fromRGB(30, 110, 50))
		disc(0.36, 0.36, 0.3, LEAF, false)
		disc(0.64, 0.36, 0.3, LEAF, false)
		disc(0.36, 0.62, 0.3, LEAF, false)
		disc(0.64, 0.62, 0.3, LEAF, false)
	elseif kind == "statPower" then
		-- pet stat icons (PetStatView): POWER (the one big number) = a gold bolt on red, Attack = a sword,
		-- Health = a heart, attack speed = two chevrons
		disc(0.5, 0.5, 0.9, Color3.fromRGB(226, 52, 60))
		sq(0.56, 0.3, 0.16, 0.42, GOLD, 25, 1, false)
		sq(0.5, 0.5, 0.42, 0.14, GOLD, -20, 1, false)
		sq(0.44, 0.7, 0.16, 0.42, GOLD, 25, 1, false)
	elseif kind == "statAttack" then
		disc(0.5, 0.5, 0.9, Color3.fromRGB(240, 120, 40))
		sq(0.54, 0.46, 0.16, 0.56, WHITE, 45, 2, false)
		sq(0.36, 0.64, 0.34, 0.12, Color3.fromRGB(120, 60, 20), 45, 2, false)
		sq(0.3, 0.7, 0.12, 0.2, Color3.fromRGB(120, 60, 20), 45, 2, false)
	elseif kind == "statHealth" then
		local HEART = Color3.fromRGB(240, 60, 90)
		disc(0.5, 0.5, 0.9, Color3.fromRGB(255, 200, 210))
		disc(0.38, 0.42, 0.3, HEART, false)
		disc(0.62, 0.42, 0.3, HEART, false)
		sq(0.5, 0.56, 0.3, 0.3, HEART, 45, 2, false)
	elseif kind == "statSpeed" then
		disc(0.5, 0.5, 0.9, Color3.fromRGB(150, 90, 220))
		sq(0.36, 0.4, 0.12, 0.3, WHITE, -45, 2, false)
		sq(0.36, 0.6, 0.12, 0.3, WHITE, 45, 2, false)
		sq(0.6, 0.4, 0.12, 0.3, WHITE, -45, 2, false)
		sq(0.6, 0.6, 0.12, 0.3, WHITE, 45, 2, false)
	elseif kind == "warn" then
		disc(0.5, 0.5, 0.9, TC.Red)
		glyph("!", WHITE, 0.62)
	elseif kind == "info" then
		disc(0.5, 0.5, 0.9, Color3.fromRGB(70, 140, 255))
		glyph("i", WHITE, 0.6)
	end
	return box
end

-- Buttons -----------------------------------------------------------------------------------
-- Styles: "gold" primary (dark text), "gray" secondary, "red" destructive / close, "green" confirm-ready,
-- "blue" lobby HUD tiles and the DAILY button.
-- Legacy names map: yellow / orange -> gold, dark / light -> gray. States: hover (lighter), pressed (dip),
-- selected (gold ring, UI.setSelected), disabled (flat gray, no input: UI.setEnabled), pending (UI.pending).

type ButtonStyle = { Fill: Color3, Hover: Color3, Line: Color3, Text: Color3, Flat: boolean? }
-- Pet style (Theme.PetStyle): the primary is the clip's lime, the secondary a flat navy, HUD tiles cyan; every
-- caption white with the dark outline.
local STYLE: { [string]: ButtonStyle } = if Theme.PetStyle then {
	gold = { Fill = PET.Lime, Hover = PET.LimeHover, Line = PET.LimeEdge, Text = TC.Text },
	gray = { Fill = PET.TabBar, Hover = TC.GrayHover, Line = PET.TabBarEdge, Text = PET.TabText, Flat = true },
	red = { Fill = PET.Red, Hover = PET.RedTop, Line = PET.RedEdge, Text = TC.Text },
	green = { Fill = PET.Price, Hover = PET.PriceTop, Line = PET.PriceEdge, Text = TC.Text },
	blue = { Fill = PET.Cyan, Hover = PET.CyanTop, Line = PET.CyanEdge, Text = TC.Text }, -- lobby HUD tiles
} else {
	gold = { Fill = TC.Gold, Hover = TC.GoldHover, Line = TC.GoldDeep, Text = TC.DarkText },
	-- secondary: flat desaturated slate with a thin edge, no gloss or lip, never a kit picture (UiKit.ButtonFor), so a
	-- filter or a locked reward never reads like the primary button next to it (Studio check 2026-10-14)
	gray = { Fill = Color3.fromRGB(70, 80, 100), Hover = Color3.fromRGB(88, 100, 124), Line = Color3.fromRGB(34, 40, 54), Text = TC.Text, Flat = true },
	red = { Fill = TC.Red, Hover = Color3.fromRGB(240, 80, 70), Line = TC.RedDeep, Text = TC.Text },
	green = { Fill = TC.Green, Hover = Color3.fromRGB(110, 220, 104), Line = TC.GreenDeep, Text = TC.Text },
	blue = { Fill = TC.Hud, Hover = Color3.fromRGB(70, 132, 240), Line = TC.PanelEdge, Text = TC.Text }, -- lobby HUD tiles
}
local ALIAS = { yellow = "gold", orange = "gold", primary = "gold", dark = "gray", light = "gray", secondary = "gray", destructive = "red" }

local function styleOf(style: string?): string
	local s = style or "gold"
	s = ALIAS[s] or s
	return if STYLE[s] then s else "gold"
end
UI.styleOf = styleOf

-- Cartoon button look: a darker lip along the bottom (the gradient multiplies whatever fill the button has).
function UI.bevel(b: GuiObject): UIGradient
	local old = b:FindFirstChild("Bevel")
	if old and old:IsA("UIGradient") then
		return old
	end
	local g = Instance.new("UIGradient")
	g.Name = "Bevel"
	g.Rotation = 90
	local lip = Theme.Button.Lip
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Button.TopShade),
		ColorSequenceKeypoint.new(0.35, Theme.Button.TopShade),
		ColorSequenceKeypoint.new(lip - 0.02, Theme.Button.MidShade),
		ColorSequenceKeypoint.new(lip, Theme.Button.LipShade),
		ColorSequenceKeypoint.new(1, Theme.Button.LipShade),
	})
	g.Parent = b
	return g
end

-- UI kit skins (shared/UiKit, "Polygon Adventure" pictures) ------------------------------------------------------
-- One ImageLabel "KitSkin" under an object's children draws the kit picture (9-slice or whole); the drawn fill,
-- border strokes and gloss step aside while it shows. An entry whose id is 0 (UiKit.skinFor nil) removes the picture
-- and gives the drawn look back. The owner's earlier HUD pictures (HudArt.skin) win: they set "OwnerSkin".

-- The drawn look (fill, border strokes, gloss) on or off under a kit picture.
local function kitDrawn(obj: GuiObject, on: boolean)
	obj.BackgroundTransparency = if on then ((obj:GetAttribute("KitBgT") :: number?) or 0) else 1
	for _, c in obj:GetChildren() do
		if c:IsA("UIStroke") then
			if on and c:GetAttribute("KitOff") then
				c.Enabled = true
				c:SetAttribute("KitOff", nil)
			elseif not on and c.Enabled then
				c.Enabled = false
				c:SetAttribute("KitOff", true)
			end
		elseif c.Name == "Gloss" and c:IsA("GuiObject") then
			c.Visible = on
		end
	end
end

-- Fits a kit picture to its object after layout (AbsoluteSize, UIScale removed): the slice scale per element
-- (UiKit.fitScale: corners never overlap or stretch; a menu panel's corners also shrink on short screens), the drawn
-- look instead when the picture's shape does not suit the object (UiKit.fits), and for a menu panel the inner content
-- rect (UiKit.contentInset): a "KitPad" UIPadding puts header, tabs, body and footer inside the rim, the picture
-- itself spans the whole panel and the solid backing fills exactly the content rect.
local function kitFit(obj: GuiObject, img: ImageLabel, skin: UiKit.Skin)
	if skin.ScaleType ~= "Slice" then
		return
	end
	local sc = math.max(UI.Scale, 0.01)
	local w = if obj.AbsoluteSize.X > 0 then obj.AbsoluteSize.X / sc else obj.Size.X.Offset
	local h = if obj.AbsoluteSize.Y > 0 then obj.AbsoluteSize.Y / sc else obj.Size.Y.Offset
	-- AbsoluteSize also holds the panel's pop-in UIScale: measure at rest
	local enter = obj:FindFirstChild("Enter")
	if enter and enter:IsA("UIScale") and enter.Scale > 0.01 then
		w /= enter.Scale
		h /= enter.Scale
	end
	local panel = obj:GetAttribute("KitPanel") == true
	local fits = UiKit.fits(skin, w, h)
	if img.Visible ~= fits then
		img.Visible = fits
		kitDrawn(obj, not fits)
	end
	local s = UiKit.fitScale(skin, w, h, if panel then UiKit.panelCap(UI.Logical.Y) else nil)
	if img.SliceScale ~= s then
		img.SliceScale = s
	end
	if not panel then
		return
	end
	local l, t, r, b = UiKit.contentInset(skin, s)
	local rimT = t
	if obj:GetAttribute("KitHeaderOnRim") then
		t = 0 -- a menu's header (title tab, coins, X) sits on the top rim by design; the body starts under it
	end
	local pad = obj:FindFirstChild("KitPad") :: UIPadding?
	if not pad then
		local n = Instance.new("UIPadding")
		n.Name = "KitPad"
		n.Parent = obj
		pad = n
	end
	local p = pad :: UIPadding
	p.PaddingLeft = UDim.new(0, l)
	p.PaddingTop = UDim.new(0, t)
	p.PaddingRight = UDim.new(0, r)
	p.PaddingBottom = UDim.new(0, b)
	img.Position = UDim2.fromOffset(-l, -t)
	img.Size = UDim2.new(1, l + r, 1, t + b)
	local back = obj:FindFirstChild("KitBacking")
	if back and back:IsA("GuiObject") then
		-- the fill stays inside the rim even when the header sits on it: filling up to the panel's top edge showed a
		-- white strip above the header plate wherever the rim picture is see-through (Daily, Egg Shrine walkthrough)
		local top = UiKit.backingTop(t, rimT)
		back.Position = UDim2.fromOffset(0, top)
		back.Size = UDim2.new(1, 0, 1, -top)
	end
end

-- The content insets a kit panel uses now (0s while it is drawn): panels that place things against the panel's own
-- edge read this instead of guessing the rim.
function UI.kitInset(panel: Instance): (number, number, number, number)
	local p = panel:FindFirstChild("KitPad")
	if p and p:IsA("UIPadding") then
		return p.PaddingLeft.Offset, p.PaddingTop.Offset, p.PaddingRight.Offset, p.PaddingBottom.Offset
	end
	return 0, 0, 0, 0
end

-- A menu panel's kit picture plus a solid fill under its middle (a panel must hide the HUD behind it even where the
-- picture's middle is light or soft). Returns true when the picture shows.
function UI.kitPanel(panel: GuiObject, key: string): boolean
	panel:SetAttribute("KitPanel", true)
	local on = UI.kitSkin(panel, key)
	if on and not panel:FindFirstChild("KitBacking") then
		local f = Instance.new("Frame")
		f.Name = "KitBacking"
		f.BorderSizePixel = 0
		f.BackgroundColor3 = panel.BackgroundColor3
		f.BackgroundTransparency = (panel:GetAttribute("KitBgT") :: number?) or 0
		f.ZIndex = -2
		f.Active = false
		f.Parent = panel
		local img = panel:FindFirstChild("KitSkin") :: ImageLabel
		local s = UiKit.skinFor(key)
		if s then
			kitFit(panel, img, s)
		end
		-- panels recoloured after this (PanelSkin) keep the fill in their colour
		panel:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
			f.BackgroundColor3 = panel.BackgroundColor3
		end)
	end
	return on
end

-- Draws kit picture `key` behind `obj`'s children (pressed: the _pressed picture when the kit has one). Returns true
-- when a picture shows. Safe to call again on every state change: it only updates the one ImageLabel.
function UI.kitSkin(obj: GuiObject, key: string?, pressed: boolean?): boolean
	-- the pet style draws everything itself: no kit picture ever shows (Theme.PetStyle)
	local skin = if obj:GetAttribute("OwnerSkin") or Theme.PetStyle then nil else UiKit.skinFor(key)
	local img = obj:FindFirstChild("KitSkin") :: ImageLabel?
	if not skin then
		if img then
			-- back to the drawn look
			img:Destroy()
			for _, n in { "KitBacking", "KitPad" } do
				local c = obj:FindFirstChild(n)
				if c then
					c:Destroy()
				end
			end
			kitDrawn(obj, true)
			obj:SetAttribute("KitOn", nil)
		end
		return false
	end
	local s = skin :: UiKit.Skin
	if not img then
		local n = Instance.new("ImageLabel")
		n.Name = "KitSkin"
		n.BackgroundTransparency = 1
		n.Size = UDim2.fromScale(1, 1)
		n.ZIndex = -1 -- under the shine sweep (ZIndex 0), the caption and every other child
		n.Active = false
		n.Parent = obj
		img = n
		obj:SetAttribute("KitBgT", obj.BackgroundTransparency)
		obj:SetAttribute("KitOn", true)
		kitDrawn(obj, false)
		obj:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			local cur = UiKit.skinFor(obj:GetAttribute("KitKey") :: string?)
			if cur and n.Parent then
				kitFit(obj, n, cur)
			end
		end)
	end
	local i = img :: ImageLabel
	obj:SetAttribute("KitKey", key)
	i.Image = if pressed and s.Pressed then s.Pressed else s.Image
	i.ScaleType = if s.ScaleType == "Slice" then Enum.ScaleType.Slice else Enum.ScaleType.Fit
	local rect, center = UiKit.crop(s)
	i.ImageRectOffset = Vector2.zero
	i.ImageRectSize = if rect ~= s.Pixels then rect else Vector2.zero -- zero: the whole picture
	i.SliceCenter = center
	kitFit(obj, i, s)
	return true
end

-- The kit picture a UI.button shows now: its "Kit" attribute (tabs: "tab", the selected one "tab_active"; the close X
-- "close_x"), else its style's button (UiKit.ButtonFor). Pressed swaps in the _pressed picture; disabled tints grey.
local function kitPaint(b: GuiButton)
	local base = b:GetAttribute("Kit")
	local key: string?
	if base == "tab" then
		key = if b:GetAttribute("Style") == "gold" or b:GetAttribute("Selected") == true then "tab_active" else "tab"
	elseif type(base) == "string" then
		key = base
	else
		key = UiKit.buttonKey(b:GetAttribute("Style") :: string?)
	end
	local disabled = b:GetAttribute("Disabled") == true
	if UI.kitSkin(b, key, b:GetAttribute("Pressed") == true and not disabled) then
		local img = b:FindFirstChild("KitSkin") :: ImageLabel
		img.ImageColor3 = if disabled then Color3.fromRGB(150, 150, 150) elseif b:GetAttribute("Hover") == true then Color3.new(1, 1, 1) else Color3.fromRGB(242, 242, 242)
	end
end

local function paint(b: GuiButton)
	local st = STYLE[styleOf(b:GetAttribute("Style") :: string?)]
	local disabled = b:GetAttribute("Disabled") == true
	local hover = b:GetAttribute("Hover") == true and not disabled
	local label = b:FindFirstChild("Label") :: TextLabel?
	local line = b:FindFirstChild("Border") :: UIStroke?
	b.BackgroundColor3 = if disabled then (b:GetAttribute("DisabledFill") :: Color3? or TC.Disabled) elseif hover then st.Hover else st.Fill
	if b:GetAttribute("Pressed") == true and not disabled then
		b.BackgroundColor3 = b.BackgroundColor3:Lerp(Color3.new(0, 0, 0), 0.22) -- darker while the finger is down
	end
	local flat = st.Flat == true
	if line then
		line.Color = if b:GetAttribute("Selected") then TC.Text elseif disabled then TC.GrayDeep else st.Line
		line.Thickness = if b:GetAttribute("Selected") then (if flat then 2.5 else 3) elseif flat then 1.5 else TS.BorderThin
	end
	if flat and b:GetAttribute("Selected") and not disabled then
		b.BackgroundColor3 = if Theme.PetStyle then PET.Blue else Color3.fromRGB(112, 128, 160) -- the picked filter: lighter with a white edge
	end
	-- flat: no gloss band and no lip gradient (they follow the style, so a restyled button gets them back)
	local gl = b:FindFirstChild("Gloss")
	if gl and gl:IsA("GuiObject") and not b:GetAttribute("KitOn") then
		gl.Visible = not flat
	end
	local bev = b:FindFirstChild("Bevel")
	if bev and bev:IsA("UIGradient") then
		bev.Enabled = not flat
	end
	if label then
		local fg = if disabled then (b:GetAttribute("DisabledText") :: Color3? or TC.DisabledText) else st.Text
		label.TextColor3 = fg
		local o = label:FindFirstChild("Outline") :: UIStroke?
		if o then
			o.Enabled = fg ~= TC.DarkText
		end
	end
	kitPaint(b) -- the kit picture follows style, press, hover and disabled (fallback: the drawn look above)
end
UI.paint = paint

-- Button with a caption child "Label" (fitted, outlined unless dark-on-gold). onClick runs on Activated (mouse,
-- touch, gamepad A and keyboard selection alike) and never while the button is disabled or pending.
function UI.button(parent: Instance, text: string, style: string?, onClick: (() -> ())?, props: { [string]: any }?): TextButton
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Text = ""
	b.BorderSizePixel = 0
	b.Size = UDim2.fromOffset(140, TS.Button)
	b:SetAttribute("Style", styleOf(style))
	local size = T.Head
	local word = true -- props.Word = false keeps the caption as text even when the word has a picture
	if props and (props.TextSize or props.Word ~= nil) then
		size = props.TextSize or size
		word = props.Word ~= false
		props = table.clone(props)
		props.TextSize = nil
		props.Word = nil
	end
	apply(b, props)
	UI.corner(b, T.Radius)
	UI.stroke(b, TC.PanelEdge, TS.BorderThin)
	-- sheen and glint sit under the caption (ZIndex 0)
	UI.gloss(b)
	UI.shine(b)
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -12, 1, -6)
	label.Position = UDim2.fromOffset(6, 3)
	label.Font = UI.Head
	label.TextWrapped = true
	label.Text = text
	label.Parent = b
	UI.fit(label, size)
	if word and UI.ButtonWord then
		UI.ButtonWord(label) -- the owner's word picture when this word has one (HudArt sets the hook)
	end
	UI.outline(label, "Normal")
	-- display-font captions are capitals only (a caller may switch the label to the body font for mixed case)
	local function caps()
		if label.Font == UI.Head and UI.Head ~= UI.Bold then
			local u = UI.caps(label.Text)
			if u ~= label.Text then
				label.Text = u
			end
		end
	end
	caps()
	label:GetPropertyChangedSignal("Text"):Connect(caps)
	UI.bevel(b)
	paint(b)
	b.Parent = parent
	UI.squashScale(b)
	-- press: quick dip, release: spring back past 1 and settle (Theme.Spring)
	local function press(on: boolean)
		UI.squash(b, on)
		b:SetAttribute("Pressed", on)
		paint(b)
	end
	b.MouseButton1Down:Connect(function()
		if not b:GetAttribute("Disabled") then
			press(true)
		end
	end)
	b.MouseButton1Up:Connect(function()
		press(false)
	end)
	b.MouseEnter:Connect(function()
		b:SetAttribute("Hover", true)
		paint(b)
		if UserInputService.MouseEnabled and not b:GetAttribute("Disabled") then
			UI.spring(UI.squashScale(b), Theme.Spring.Release, { Scale = Theme.Loop.HoverScale })
		end
	end)
	b.MouseLeave:Connect(function()
		b:SetAttribute("Hover", false)
		paint(b)
		press(false)
	end)
	b.SelectionGained:Connect(function()
		b:SetAttribute("Hover", true)
		paint(b)
	end)
	b.SelectionLost:Connect(function()
		b:SetAttribute("Hover", false)
		paint(b)
	end)
	if onClick then
		local function fire()
			if b:GetAttribute("Disabled") then
				Audio.play("Denied", { Key = "ui:denied" }) -- a greyed-out button: soft "not yet" bonk
				return
			end
			Audio.button()
			onClick()
		end
		b.Activated:Connect(fire)
		touchPad(b, fire, function(on: boolean)
			if not on or not b:GetAttribute("Disabled") then
				press(on)
			end
		end)
	end
	return b
end

-- One caption size for a row of buttons: the largest size (<= `size`) at which every button's caption fits its
-- label box, so a long caption (SKIP TUTORIAL) no longer shrinks alone next to a short one (LOBBY).
-- Re-checked when the row resizes; measured in logical px (UI.Scale removed).
function UI.sameTextSize(row: GuiObject, size: number)
	local function layout()
		local labels: { TextLabel } = {}
		for _, b in row:GetChildren() do
			local l = if b:IsA("GuiButton") then b:FindFirstChild("Label") else nil
			if l and l:IsA("TextLabel") then
				table.insert(labels, l)
			end
		end
		local k = math.max(UI.Scale, 0.01)
		local best = math.floor(size)
		for _, l in labels do
			-- the button's own squash scale is undone too, so a press never re-sizes the row
			local sq = (l.Parent :: Instance):FindFirstChild("Squash") :: UIScale?
			local f = k * (if sq then math.max(sq.Scale, 0.01) else 1)
			local w, h = l.AbsoluteSize.X / f, l.AbsoluteSize.Y / f
			if w <= 0 or h <= 0 then
				return
			end
			while best > T.MinText do
				local need = TextService:GetTextSize(l.Text, best, l.Font, Vector2.new(w, 10000))
				if need.X <= w and need.Y <= h then
					break
				end
				best -= 1
			end
		end
		for _, l in labels do
			UI.fit(l, best, T.MinText)
		end
	end
	row:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
	task.defer(layout)
end

function UI.setText(b: GuiButton, text: string)
	local l = b:FindFirstChild("Label") :: TextLabel?
	if l then
		l.Text = text
	end
end

-- Disabled buttons look flat gray and do not accept input (Activated is ignored, AutoButtonColor off).
function UI.setEnabled(b: GuiButton, enabled: boolean, style: string?)
	if style then
		b:SetAttribute("Style", styleOf(style))
	end
	b:SetAttribute("Disabled", not enabled)
	b.Selectable = enabled
	paint(b)
end

function UI.setStyle(b: GuiButton, style: string)
	b:SetAttribute("Style", styleOf(style))
	paint(b)
end

-- Selected ring (tabs, slots, chosen options).
function UI.setSelected(b: GuiButton, on: boolean)
	b:SetAttribute("Selected", on)
	paint(b)
end

-- Marks a button as waiting for the server: disabled with `text` until done() runs or `timeout` seconds pass
-- (default 4), and a refusal notice (kind "warn") ends it at once. Returns done. Safe if the button was rebuilt.
UI.Notice = Instance.new("BindableEvent") -- (text, kind): every notification, so panels can react
function UI.pending(b: GuiButton, text: string, timeout: number?): () -> ()
	local label = b:FindFirstChild("Label") :: TextLabel?
	local before = if label then label.Text else ""
	local wasDisabled = b:GetAttribute("Disabled") == true
	UI.setEnabled(b, false)
	b:SetAttribute("Pending", true)
	if label then
		label.Text = text
	end
	local finished = false
	local conn: RBXScriptConnection? = nil
	local function done()
		if finished then
			return
		end
		finished = true
		if conn then
			conn:Disconnect()
		end
		if b.Parent then
			b:SetAttribute("Pending", nil)
			if label then
				label.Text = before
			end
			UI.setEnabled(b, not wasDisabled)
		end
	end
	conn = UI.Notice.Event:Connect(function(_, kind)
		if kind == "warn" then
			done()
		end
	end)
	task.delay(timeout or 4, done)
	return done
end

-- Red close square with a white X (44 px hit area).
function UI.closeButton(parent: Instance, onClick: () -> (), props: { [string]: any }?): TextButton
	local x = UI.button(parent, "", "red", onClick, { Name = "Close", Size = UDim2.fromOffset(TS.Close, TS.Close) })
	apply(x, props)
	local l = x:FindFirstChild("Label")
	if l then
		l:Destroy()
	end
	local xIcon = UI.icon(x, "close", math.floor(TS.Close * 0.55), { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
	x:SetAttribute("Kit", "close_x")
	paint(x)
	if x:GetAttribute("KitOn") then
		xIcon.Visible = false -- the kit picture has its own X
	end
	-- the square is 40 px (smaller on notices), the touch area at least 44 (plus the real-px pad from UI.button)
	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.AnchorPoint = Vector2.new(0.5, 0.5)
	hit.Position = UDim2.fromScale(0.5, 0.5)
	hit.Size = UDim2.new(1, 6, 1, 6)
	hit.Selectable = false
	local minHit = Instance.new("UISizeConstraint")
	minHit.MinSize = Vector2.new(TS.Touch, TS.Touch)
	minHit.Parent = hit
	hit.Parent = x
	hit.Activated:Connect(function()
		Audio.button()
		onClick()
	end)
	-- the X squashes on press and bounces back like every button
	hit.MouseButton1Down:Connect(function()
		UI.squash(x, true)
	end)
	hit.MouseButton1Up:Connect(function()
		UI.squash(x, false)
	end)
	hit.MouseLeave:Connect(function()
		UI.squash(x, false)
	end)
	return x
end

-- Components -------------------------------------------------------------------------------

-- Card. tone: "inset" (dark row inside a panel, default) | "panel" (charcoal) | "hud" (floating HUD card).
function UI.card(parent: Instance, tone: string?, props: { [string]: any }?): Frame
	local t = tone or "inset"
	local f = UI.frame(parent, {
		BackgroundColor3 = if t == "panel" then TC.Panel elseif t == "hud" then TC.Hud else TC.Inset,
		BackgroundTransparency = if t == "hud" then 0.1 else 0,
	})
	apply(f, props)
	UI.corner(f, T.Radius)
	UI.stroke(f, if t == "inset" then TC.InsetEdge elseif t == "panel" then TC.PanelRim else TC.PanelEdge, if t == "inset" then 2 else TS.BorderThin)
	if t ~= "inset" then
		UI.panelShade(f)
	end
	return f
end

-- Progress bar. Returns (track, fill); set fill.Size = UDim2.fromScale(v, 1).
function UI.bar(parent: Instance, props: { [string]: any }?, color: Color3?): (Frame, Frame)
	local track = UI.frame(parent, { Name = "Bar", Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = TC.Inset })
	apply(track, props)
	UI.corner(track, 4)
	UI.stroke(track, if Theme.PetStyle then PET.QuestEdge else TC.Outline, 1.5)
	local fill = UI.frame(track, { Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = color or (if Theme.PetStyle then TC.Green else TC.Gold) })
	UI.corner(fill, 4)
	-- kit progress pictures (drawn bar while their ids are 0)
	UI.kitSkin(track, "progress_bg")
	UI.kitSkin(fill, "progress_fill")
	-- shine sweep: a light band runs along the fill each time it grows (not while one is still running)
	fill.ClipsDescendants = true
	local shine = UI.frame(fill, { Name = "Shine", BackgroundColor3 = Theme.Fx.Shine, BackgroundTransparency = 0.25, Position = UDim2.fromScale(-0.5, 0), Size = UDim2.fromScale(0.4, 1), Visible = false })
	local sg = Instance.new("UIGradient")
	sg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) })
	sg.Parent = shine
	local last, sweeping = 0, false
	fill:GetPropertyChangedSignal("Size"):Connect(function()
		local v = fill.Size.X.Scale
		local grew = v > last + 0.001
		last = v
		if not grew or sweeping or UI.Reduced or v <= 0 then
			return
		end
		sweeping = true
		shine.Position = UDim2.fromScale(-0.5, 0)
		shine.Visible = true
		local tw = TweenService:Create(shine, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Position = UDim2.fromScale(1.1, 0) })
		tw.Completed:Connect(function()
			shine.Visible = false
			sweeping = false
		end)
		tw:Play()
	end)
	return track, fill
end

-- Cash readout: cash-stack icon + green outlined amount. Returns (frame, set(n)).
function UI.cash(parent: Instance, size: number, props: { [string]: any }?): (Frame, (number) -> ())
	local f = UI.frame(parent, { Name = "Cash", BackgroundTransparency = 1, Size = UDim2.fromOffset(size * 5.4, size) })
	apply(f, props)
	if Theme.PetStyle then
		-- the clip's readout: a navy pill with the coin over its left end and white digits
		f.BackgroundTransparency = 0
		f.BackgroundColor3 = PET.TabBar
		UI.corner(f, 999)
		UI.stroke(f, PET.TabBarEdge, 2)
	else
		UI.kitSkin(f, "coin_pill") -- kit coin pill behind the readout (none while its id is 0)
	end
	UI.icon(f, "cash", size, { Position = UDim2.fromOffset(if Theme.PetStyle then 2 else 0, 0) })
	local l = UI.text(f, "0", { Name = "Amount", Font = UI.Head, TextSize = size * 0.92, TextColor3 = if Theme.PetStyle then TC.Text else TC.Cash, Outline = "Strong", Position = UDim2.fromOffset(size + 6, 0), Size = UDim2.new(1, -(size + 10), 1, 0) })
	l.TextWrapped = false
	local last: number? = nil
	return f, function(n: number)
		-- the amount counts up (or down) to the new value instead of jumping
		UiJuice.countTo(l, last or n, n, UI.num)
		if last and n > last then
			UI.pop(l, 0.85) -- the readout bumps when coins arrive
		end
		last = n
	end
end

-- Icon + caption + value card for the HUD ("CARRIED 3/5"). Returns (card, set(value, cap?)).
function UI.counter(parent: Instance, icon: string, caption: string, props: { [string]: any }?): (Frame, (number, number?) -> ())
	local f = UI.card(parent, "hud", { Name = "Counter", Size = UDim2.fromOffset(124, 50) })
	apply(f, props)
	UI.icon(f, icon, 30, { Position = UDim2.fromOffset(7, 13) })
	UI.text(f, caption, { Name = "Caption", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = TC.Text, Outline = "Normal", Position = UDim2.fromOffset(44, 3), Size = UDim2.new(1, -48, 0, 17) })
	local v = UI.text(f, "", { Name = "Value", Font = UI.Head, TextSize = T.Count, TextColor3 = TC.Count, Outline = "Strong", Position = UDim2.fromOffset(44, 19), Size = UDim2.new(1, -48, 0, 28) })
	v.TextWrapped = false
	return f, function(n: number, cap: number?)
		local txt = if cap then (tostring(n) .. "/" .. tostring(cap)) else tostring(n)
		if txt ~= v.Text and v.Text ~= "" then
			UI.pop(v, 1.25) -- the number pops when it changes
		end
		v.Text = txt
		v.TextColor3 = if cap and n >= cap then TC.Warn else TC.Count
	end
end

-- Tab words: designed size and the readable floor (Studio sweep #177: words shrank to about 8 px on a phone).
-- (#230 / #237: still small on a phone, so body size with a body-size floor, and bigger tab icons)
local TAB_TEXT = T.Body + 2
local TAB_MIN = T.Body
local TAB_ICON = TS.Tab - 8

-- A button with a picture left of its word: the picture shows only while the word still fits beside it at `minSize`
-- (measured in logical px); otherwise it hides and the word takes the whole width. Re-checked when the button resizes.
function UI.iconWord(b: GuiObject, l: TextLabel, icon: GuiObject, iconW: number, minSize: number)
	local x0 = l.Position.X.Offset
	local w0 = l.Size.X.Offset
	local function layout()
		local w = b.AbsoluteSize.X / math.max(UI.Scale, 0.01)
		if w <= 0 then
			return
		end
		local need = TextService:GetTextSize(l.Text, minSize, l.Font, Vector2.new(2000, 100)).X
		local room = w + w0 - (iconW + 6) - 2
		local show = need <= room
		icon.Visible = show
		if show then
			l.Position = UDim2.new(l.Position.X.Scale, x0 + iconW + 6, l.Position.Y.Scale, l.Position.Y.Offset)
			l.Size = UDim2.new(l.Size.X.Scale, w0 - (iconW + 6), l.Size.Y.Scale, l.Size.Y.Offset)
		else
			l.Position = UDim2.new(l.Position.X.Scale, x0, l.Position.Y.Scale, l.Position.Y.Offset)
			l.Size = UDim2.new(l.Size.X.Scale, w0, l.Size.Y.Scale, l.Size.Y.Offset)
		end
	end
	layout()
	b:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
end

-- A tab's picture and word as one centred group (the picture at the left edge pushed the word off-centre, Studio):
-- the word is measured at its current fitted size and the pair sits in the middle of the tab. The picture hides when
-- the word would not fit beside it at the readable minimum. Re-placed on resize and when the bar's text size changes.
function UI.tabIconWord(b: GuiObject, l: TextLabel, icon: GuiObject, iconSize: number?, minText: number?)
	local gap = 6
	local ICON = iconSize or TAB_ICON
	local MIN = minText or TAB_MIN
	local function place()
		local w = b.AbsoluteSize.X / math.max(UI.Scale, 0.01)
		if w <= 0 then
			return
		end
		local fc = l:FindFirstChild("Fit") :: UITextSizeConstraint?
		local size = if fc then fc.MaxTextSize else TAB_TEXT
		local room = w - 8 - (ICON + gap)
		local show = TextService:GetTextSize(l.Text, MIN, l.Font, Vector2.new(2000, 100)).X <= room
		icon.Visible = show
		if show then
			local tw = math.min(TextService:GetTextSize(l.Text, size, l.Font, Vector2.new(2000, 100)).X, room)
			local left = math.floor((w - (ICON + gap + tw)) / 2)
			icon.Position = UDim2.new(0, left, 0.5, 0)
			l.TextXAlignment = Enum.TextXAlignment.Left
			l.Position = UDim2.new(0, left + ICON + gap, 0.5, -13)
			l.Size = UDim2.new(0, math.max(1, w - 4 - (left + ICON + gap)), 0, 26)
		else
			l.TextXAlignment = Enum.TextXAlignment.Center
			l.Position = UDim2.new(0, 4, 0.5, -13)
			l.Size = UDim2.new(1, -8, 0, 26)
		end
	end
	place()
	b:GetPropertyChangedSignal("AbsoluteSize"):Connect(place)
	local fc = l:FindFirstChild("Fit")
	if fc then
		fc:GetPropertyChangedSignal("MaxTextSize"):Connect(place)
	end
end

-- Segmented tabs: gray pills, the selected one gold. `items` = { { Id, Label } }. Up to five share the row;
-- more scroll sideways. Returns the row.
function UI.tabs(parent: Instance, items: { { string } }, current: string, onPick: (string) -> (), props: { [string]: any }?): Frame
	local row = UI.frame(parent, { Name = "Tabs", Size = UDim2.new(1, 0, 0, TS.Tab), BackgroundTransparency = 1 })
	apply(row, props)
	if Theme.PetStyle then
		-- the clip's tab bar: a navy strip, the picked tab a lime pill, the others plain words on the navy
		row.BackgroundTransparency = 0
		row.BackgroundColor3 = PET.TabBar
		UI.corner(row, 999)
		UI.stroke(row, PET.TabBarEdge, 2.5)
		UI.pad(row, 4, 4)
	end
	local n = #items
	-- an upright phone with five or more tabs: fixed-width tabs in a sideways strip (the last one peeks out, so it
	-- reads as "slide for more") instead of words squeezed too small to read
	local crowded = UI.isPortrait() and n >= 5
	local strip: GuiObject = row
	if crowded then
		local sc = Instance.new("ScrollingFrame")
		sc.Name = "Strip"
		sc.BackgroundTransparency = 1
		sc.BorderSizePixel = 0
		sc.Size = UDim2.fromScale(1, 1)
		sc.ScrollingDirection = Enum.ScrollingDirection.X
		sc.AutomaticCanvasSize = Enum.AutomaticSize.X
		sc.CanvasSize = UDim2.new()
		sc.ScrollBarThickness = 0
		sc.Parent = row
		strip = sc
	end
	UI.list(strip, Enum.FillDirection.Horizontal, 6)
	local curIndex: number? = nil
	for i, it in items do
		if it[1] == current then
			curIndex = i
		end
	end
	for i, it in items do
		local id, label = it[1], it[2]
		local on = id == current
		local tb = UI.button(strip, label, if on then "gold" else "gray", function()
			if not on then
				local host = row.Parent
				local before: { [Instance]: boolean } = {}
				if host then
					for _, c in host:GetChildren() do
						before[c] = true
					end
				end
				onPick(id)
				-- the new tab's content slides in from the side of the tab that was tapped (right of the old tab: from
				-- the right; left of it: from the left); only content the pick just built moves (persistent headers
				-- and bars stay put and never drift on quick taps), never inside a layout
				if host and not host:FindFirstChildWhichIsA("UIGridStyleLayout") then
					local fresh: { GuiObject } = {}
					for _, c in host:GetChildren() do
						if c:IsA("GuiObject") and not before[c] and c.Name ~= "Tabs" and c ~= row then
							table.insert(fresh, c)
						end
					end
					UiJuice.slideIn(fresh, UiMotion.slideFrom(curIndex, i, 28))
				end
			end
		end, { Name = "Tab_" .. id, LayoutOrder = i, TextSize = T.Small + 1, Size = if crowded then UDim2.new(0, 96, 1, 0) else UDim2.new(1 / n, -math.ceil(6 * (n - 1) / n), 1, 0) })
		tb:SetAttribute("Selected", false)
		tb:SetAttribute("Kit", "tab") -- kit tab pictures (tab / tab_active) instead of the button ones
		paint(tb)
		if Theme.PetStyle then
			UI.corner(tb, 999)
			local border = tb:FindFirstChild("Border")
			if border and border:IsA("UIStroke") then
				border.Enabled = on -- an unpicked tab is just its word on the strip
			end
			local gl = tb:FindFirstChild("Gloss")
			if gl and gl:IsA("GuiObject") then
				gl.Visible = false
			end
		end
		local l = tb:FindFirstChild("Label") :: TextLabel?
		if l then
			l.Font = UI.Bold
			l.Text = label -- mixed case in the body font
			l.TextWrapped = false
			-- one line only: a box too short for two lines makes TextScaled shrink the word instead of splitting it
			l.Size = UDim2.new(1, -8, 0, 26)
			l.Position = UDim2.new(0, 4, 0.5, -13)
			UI.fit(l, TAB_TEXT, TAB_MIN)
			l.TextWrapped = false
			-- optional third entry: an uploaded icon id drawn left of the word (HudArt low-poly icons); it steps aside
			-- whenever the word would not fit beside it at a readable size (UI.iconWord)
			-- (an entry that is not an rbxassetid is a drawn UI.icon kind: the fallback while an upload is missing)
			local pic = it[3]
			if pic and pic ~= "" and not string.match(pic, "^rbxassetid://0$") then
				local img: GuiObject
				if string.match(pic, "^rbxassetid://") then
					local il = Instance.new("ImageLabel")
					il.BackgroundTransparency = 1
					il.Image = pic
					il.ScaleType = Enum.ScaleType.Fit
					il.Size = UDim2.fromOffset(TAB_ICON, TAB_ICON)
					il.Parent = tb
					img = il
				else
					img = UI.icon(tb, pic, TAB_ICON)
				end
				img.Name = "TabIcon"
				img.AnchorPoint = Vector2.new(0, 0.5)
				img.Position = UDim2.new(0, 4, 0.5, 0)
				img.ZIndex = l.ZIndex
				UI.tabIconWord(tb, l, img)
			end
		end
	end
	-- one text size for the whole bar: the designed size when every word fits its tab, else the readable minimum
	-- for all of them (measured, so a tab never shrinks its word below T.Small)
	local function equalize()
		if not row.Parent then
			return
		end
		local labels: { TextLabel } = {}
		local all = true
		for _, tb in strip:GetChildren() do
			local l = tb:FindFirstChild("Label")
			if l and l:IsA("TextLabel") and l:FindFirstChild("Fit") and tb:IsA("GuiObject") then
				table.insert(labels, l)
				local w = l.AbsoluteSize.X / math.max(UI.Scale, 0.01)
				if w > 0 and TextService:GetTextSize(l.Text, TAB_TEXT, l.Font, Vector2.new(2000, 100)).X > w then
					all = false
				end
			end
		end
		for _, l in labels do
			UI.fit(l, if all then TAB_TEXT else TAB_MIN, TAB_MIN) -- also keeps the real-pixel floor and re-fits on a scale change
		end
	end
	task.defer(equalize)
	row:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		task.defer(equalize)
	end)
	return row
end
UI.tabBar = UI.tabs

-- Catalog row: thumbnail on the left, title, a status line and an optional small badge button on the right.
-- opts = { Name, Title, Sub, SubColor, Selected, Thumb = fn(container), Badge, BadgeStyle, OnBadge, OnSelect, Height }
function UI.catalogRow(parent: Instance, order: number, opts: { [string]: any }): TextButton
	local h = opts.Height or TS.Row
	local b = Instance.new("TextButton")
	b.Name = opts.Name or ("Row_" .. order)
	b.Text = ""
	b.AutoButtonColor = false
	b.LayoutOrder = order
	b.Size = UDim2.new(1, -6, 0, h)
	b.BackgroundColor3 = TC.Inset
	b.BorderSizePixel = 0
	b.Parent = parent
	UI.corner(b, T.Radius)
	local edge = UI.stroke(b, if opts.Selected then TC.Gold else TC.InsetEdge, if opts.Selected then 3.5 else 1.5)
	UI.kitSkin(b, if opts.Selected then "card_selected" else "card") -- kit card picture (drawn row while id 0)
	b.MouseEnter:Connect(function()
		b.BackgroundColor3 = TC.InsetHover
		UiJuice.sweep(b, T.Radius) -- one shine across the row on hover
	end)
	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = TC.Inset
	end)
	local thumb = UI.frame(b, { Name = "Thumb", BackgroundTransparency = 1, Position = UDim2.fromOffset(6, 4), Size = UDim2.fromOffset(h - 8, h - 8) })
	if opts.Thumb then
		opts.Thumb(thumb)
	end
	local badgeW = if opts.Badge then (if UI.isShort() then 78 else 92) else 0
	local textW = -(h + 6 + badgeW + (if badgeW > 0 then 8 else 4))
	local hasSub = opts.Sub ~= nil and opts.Sub ~= ""
	local title = UI.text(b, opts.Title or "", { Name = "Title", Font = UI.Bold, TextSize = T.Body, Outline = "Normal", Position = UDim2.fromOffset(h + 4, if hasSub then 4 else 0), Size = UDim2.new(1, textW, 0, if hasSub then math.floor(h * 0.5) - 2 else h) })
	title.TextWrapped = false
	title.TextTruncate = Enum.TextTruncate.AtEnd
	if hasSub and opts.SubPill then
		-- status as a small badge (Owned / Equipped): tinted pill in the status colour
		-- sized from the measured text (nested AutomaticSize left the pill narrower than its word)
		local col: Color3 = opts.SubColor or TC.Muted
		-- body-size word in a pill as tall as the row's lower half allows (#237: "Equipped" / "Current" were tiny)
		local pillH = math.max(22, math.floor(h * 0.5) - 3)
		local textSize = math.min(T.Body, pillH - 4)
		local need = TextService:GetTextSize(opts.Sub, textSize, UI.Bold, Vector2.new(1000, 1000))
		local pill = UI.frame(b, { Name = "SubPill", Position = UDim2.fromOffset(h + 4, math.floor(h * 0.5) + 1), Size = UDim2.fromOffset(math.ceil(need.X) + 20, pillH), BackgroundColor3 = col, BackgroundTransparency = 0 })
		UI.corner(pill, 8)
		-- solid light pill with dark words (a see-through pill in its own colour was unreadable on the blue row, Studio)
		UI.stroke(pill, col:Lerp(Color3.new(0, 0, 0), 0.45), 2)
		local st = UI.text(pill, opts.Sub, { Name = "Sub", Font = UI.Bold, TextSize = textSize, TextColor3 = TC.DarkText, Outline = false, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
		st.TextWrapped = false
	elseif hasSub then
		-- prices: a strong dark outline so green / pale words read on the blue row
		UI.text(b, opts.Sub, { Name = "Sub", Font = UI.Bold, TextSize = T.Small, TextColor3 = opts.SubColor or TC.Muted, Outline = "Strong", Position = UDim2.fromOffset(h + 4, math.floor(h * 0.5)), Size = UDim2.new(1, textW, 0, math.floor(h * 0.5) - 4) })
	end
	if opts.Selected and not opts.Badge then
		-- picked row: a small gold arrow at the right edge points at the detail side
		local arrow = UI.text(b, "\u{25B6}", { Name = "PickedArrow", Font = UI.Bold, TextSize = T.Body, TextColor3 = TC.Gold, Outline = "Light", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(18, 22), TextXAlignment = Enum.TextXAlignment.Center })
		arrow.TextWrapped = false
	end
	if opts.Badge then
		local bb = UI.button(b, opts.Badge, opts.BadgeStyle or "gold", opts.OnBadge or opts.OnSelect, {
			Name = "Badge", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(badgeW, math.min(32, h - 12)), TextSize = T.Small,
		})
		if opts.BadgeEnabled == false then
			UI.setEnabled(bb, false)
		end
	end
	b.Activated:Connect(function()
		if opts.OnSelect then
			Audio.button()
			opts.OnSelect()
		end
	end)
	if opts.OnSelect then
		UI.bouncy(b)
	end
	if opts.Selected then
		task.defer(UiJuice.sweep, b, T.Radius) -- the picked row shines once
	end
	b:SetAttribute("Selected", opts.Selected == true)
	local _ = edge
	return b
end

-- Square specimen card: picture (fn(container)) over a caption; gold ring when selected; "Empty" style when
-- opts.Empty. opts = { Name, Caption, Picture, Selected, Empty, OnSelect, CaptionColor, RarityColor, Shimmer }
function UI.specimenCard(parent: Instance, order: number, opts: { [string]: any }): TextButton
	local b = Instance.new("TextButton")
	b.Name = opts.Name or ("Card_" .. order)
	b.Text = ""
	b.AutoButtonColor = false
	b.LayoutOrder = order
	b.BackgroundColor3 = TC.Inset
	b.BorderSizePixel = 0
	b.Parent = parent
	UI.corner(b, T.Radius)
	UI.stroke(b, if opts.Selected then TC.Gold else TC.InsetEdge, if opts.Selected then 2.5 else 1.5)
	if Theme.PetStyle and not opts.Empty then
		-- the clip's pet tiles: a blue gradient square with a white edge (gold when picked)
		b.BackgroundColor3 = Color3.new(1, 1, 1)
		local tg = Instance.new("UIGradient")
		tg.Name = "Tile"
		tg.Rotation = 90
		tg.Color = ColorSequence.new(PET.BlueTop, PET.Blue)
		tg.Parent = b
		local bs = b:FindFirstChild("Border")
		if bs and bs:IsA("UIStroke") and not opts.Selected then
			bs.Color = Color3.new(1, 1, 1)
			bs.Thickness = 2
		end
	end
	-- kit card picture: selected frame, else the rarity frame (opts.Rarity), else the plain card
	local kitted = UI.kitSkin(b, UiKit.cardKey(opts.Selected == true, opts.Rarity))
	local rarityFramed = kitted and not opts.Selected and opts.Rarity ~= nil and UiKit.RarityFor[opts.Rarity] ~= nil
	if opts.Glow then
		-- pet type glow: the card's lower part washes into the type colour (opts.Glow), under the picture
		local glow = UI.frame(b, { Name = "TypeGlow", BackgroundColor3 = opts.Glow, BackgroundTransparency = 0, Position = UDim2.fromOffset(2, 2), Size = UDim2.new(1, -4, 1, -4) })
		UI.corner(glow, T.Radius)
		local gr = Instance.new("UIGradient")
		gr.Rotation = 90
		gr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 0.85), NumberSequenceKeypoint.new(1, 0.45) })
		gr.Parent = glow
	end
	local pic = UI.frame(b, { Name = "Picture", BackgroundTransparency = 1, Position = UDim2.new(0, 4, 0, 4), Size = UDim2.new(1, -8, 1, -26) })
	if opts.Picture then
		opts.Picture(pic)
	elseif opts.Empty then
		-- an open frame with a "+" (a grey rock blob read as something in the slot, Studio #183)
		b.BackgroundTransparency = 0.55
		local well = UI.frame(pic, { Name = "EmptyWell", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -8, 1, -4), BackgroundTransparency = 1 })
		UI.corner(well, T.RadiusSm)
		local ws = UI.stroke(well, TC.Faint, 2)
		ws.Transparency = 0.35
		local plus = UI.text(well, "+", { Name = "Plus", Font = UI.Head, TextSize = T.Title + 8, TextColor3 = TC.Faint, Outline = "Light", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
		plus.TextWrapped = false
	end
	local cap = UI.text(b, opts.Caption or "", { Name = "Caption", Font = UI.Bold, TextSize = T.Tiny, TextColor3 = opts.CaptionColor or (if opts.Empty then TC.Faint else TC.Text), Outline = "Light", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 4, 1, -3), Size = UDim2.new(1, -8, 0, 18), TextXAlignment = Enum.TextXAlignment.Center })
	UI.oneLine(cap) -- "Skeleton Thunderstrut" wrapped and showed only "Skeleton"; it shrinks, never "..."
	if opts.TypeIcon then
		UI.icon(b, opts.TypeIcon, 18, { Name = "TypeIcon", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -22) })
	end
	-- rarity glow: the border in the rarity colour (the selected gold ring wins), shimmering for the rarest
	if opts.RarityColor and not opts.Selected and not rarityFramed then
		local g = UI.rarityGlow(b, opts.RarityColor, opts.Shimmer == true)
		if opts.Thick then
			g.Thickness = 4.5
		end
	end
	b.Activated:Connect(function()
		if opts.OnSelect then
			Audio.button()
			opts.OnSelect()
		end
	end)
	if opts.OnSelect then
		UI.bouncy(b)
		b.MouseEnter:Connect(function()
			UiJuice.sweep(b, T.Radius) -- one shine across the card on hover
		end)
	end
	if opts.Selected then
		task.defer(UiJuice.sweep, b, T.Radius) -- the picked card shines once
	end
	return b
end

-- Label left, value right (stats). `emphasis` = the value in the display font and count colour.
function UI.statRow(parent: Instance, order: number, label: string, value: string, emphasis: boolean?): Frame
	local row = UI.card(parent, "inset", { Name = "Stat", Size = UDim2.new(1, -6, 0, 40), LayoutOrder = order })
	UI.text(row, label, { Name = "Label", Font = UI.Bold, TextSize = T.Body, Outline = "Normal", Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.62, -12, 1, 0) })
	UI.text(row, value, { Name = "Value", Font = if emphasis then UI.Head else UI.Bold, TextSize = if emphasis then T.Head else T.Body, TextColor3 = if emphasis then TC.Count else TC.Text, Outline = "Normal", Position = UDim2.new(0.62, 0, 0, 0), Size = UDim2.new(0.38, -12, 1, 0), TextXAlignment = Enum.TextXAlignment.Right })
	return row
end

-- Empty state: picture, headline, one line, optional action button. Returns (frame, button?).
function UI.emptyState(parent: Instance, title: string, message: string, icon: string?, props: { [string]: any }?, action: { Text: string, OnClick: () -> () }?): (Frame, TextButton?)
	local f = UI.frame(parent, { Name = "Empty", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, if action then 186 else 128) })
	apply(f, props)
	UI.list(f, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	UI.icon(f, icon or "egg", 54, { LayoutOrder = 1 })
	UI.text(f, title, { Name = "Headline", Font = UI.Head, TextSize = T.Head, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Center })
	UI.text(f, message, { Name = "Message", Font = UI.Bold, TextSize = T.Small, TextColor3 = TC.Muted, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
	local btn: TextButton? = nil
	if action then
		local gap = UI.frame(f, { BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 4), LayoutOrder = 4 })
		local _ = gap
		btn = UI.button(f, action.Text, "gold", action.OnClick, { Name = "Action", LayoutOrder = 5, Size = UDim2.fromOffset(220, 46) })
	end
	return f, btn
end

-- Loading state: one line and three dots (the dots step unless Reduce Motion). Returns the frame.
function UI.loadingState(parent: Instance, text: string, props: { [string]: any }?): Frame
	local f = UI.frame(parent, { Name = "Loading", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 70) })
	apply(f, props)
	UI.text(f, text, { Name = "Text", Font = UI.Head, TextSize = T.Head, Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center })
	local dots = {}
	for i = 1, 3 do
		local d = UI.frame(f, { Name = "Dot" .. i, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, (i - 2) * 22, 0, 40), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = if i == 1 then TC.Gold else TC.Gray })
		UI.corner(d, 7)
		UI.stroke(d, TC.Outline, 1.5)
		dots[i] = d
	end
	if not UI.Reduced then
		task.spawn(function()
			local k = 1
			while f.Parent do
				task.wait(0.35)
				k = k % 3 + 1
				for i, d in dots do
					d.BackgroundColor3 = if i == k then TC.Gold else TC.Gray
				end
			end
		end)
	end
	return f
end

-- Error state: a headline, an optional line and RETRY / CLOSE (CLOSE only when onClose is given).
function UI.errorState(parent: Instance, title: string, message: string?, onRetry: () -> (), onClose: (() -> ())?, props: { [string]: any }?): Frame
	local f = UI.frame(parent, { Name = "Error", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, if message then 122 else 98) })
	apply(f, props)
	UI.text(f, title, { Name = "Headline", Font = UI.Head, TextSize = T.Head, Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center })
	if message then
		UI.text(f, message, { Name = "Message", Font = UI.Bold, TextSize = T.Small, TextColor3 = TC.Muted, Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Center })
	end
	local row = UI.frame(f, { Name = "Buttons", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.new(1, 0, 0, 46) })
	UI.list(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	local r = UI.button(row, "RETRY", "gold", onRetry, { Name = "Retry", Size = UDim2.fromOffset(140, 46), LayoutOrder = 1 })
	local _ = r
	if onClose then
		UI.button(row, "CLOSE", "gray", onClose, { Name = "CloseState", Size = UDim2.fromOffset(140, 46), LayoutOrder = 2 })
	end
	return f
end

-- Slider (0..1 in 0.05 steps). Drag with mouse or touch; the camera never sees the drag because the panel blocks
-- input. Returns (holder, set(v)). onChange(v, final).
function UI.slider(parent: Instance, value: number, onChange: (number, boolean) -> (), props: { [string]: any }?): (TextButton, (number) -> ())
	local hit = Instance.new("TextButton")
	hit.Name = "Slider"
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.BackgroundTransparency = 1
	hit.Size = UDim2.new(0.5, 0, 0, T.Touch)
	apply(hit, props)
	-- invisible drag box: hold it to 44 real px on small phones (the track stays centred)
	if hit.Size.Y.Scale == 0 then
		hit.Size = UDim2.new(hit.Size.X.Scale, hit.Size.X.Offset, 0, math.max(hit.Size.Y.Offset, UI.minTouch()))
	end
	hit.Parent = parent
	local track = UI.frame(hit, { Name = "Track", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.new(1, -20, 0, 12), BackgroundColor3 = TC.Inset })
	UI.corner(track, 6)
	UI.stroke(track, TC.Outline, 1.5)
	local fill = UI.frame(track, { Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = TC.Gold })
	UI.corner(fill, 6)
	local knob = UI.frame(track, { Name = "Knob", AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = Color3.fromRGB(245, 245, 245) })
	UI.corner(knob, 11)
	UI.stroke(knob, TC.Outline, 2)
	local v = math.clamp(value, 0, 1)
	local function show()
		fill.Size = UDim2.fromScale(v, 1)
		knob.Position = UDim2.fromScale(v, 0.5)
	end
	local function setFrom(x: number, final: boolean)
		local w = math.max(track.AbsoluteSize.X, 1)
		v = math.clamp(math.floor((x - track.AbsolutePosition.X) / w * 20 + 0.5) / 20, 0, 1)
		show()
		onChange(v, final)
	end
	local dragging: InputObject? = nil
	hit.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = input
			setFrom(input.Position.X, false)
		end
	end)
	local c1 = UserInputService.InputChanged:Connect(function(input: InputObject)
		if dragging and (input == dragging or input.UserInputType == Enum.UserInputType.MouseMovement) then
			setFrom(input.Position.X, false)
		end
	end)
	local c2 = UserInputService.InputEnded:Connect(function(input: InputObject)
		if dragging and (input == dragging or input.UserInputType == Enum.UserInputType.MouseButton1) then
			dragging = nil
			onChange(v, true)
		end
	end)
	-- gamepad / keyboard: left and right step the value while the slider is selected
	hit.SelectionImageObject = nil :: any -- no selection ring (the API type is not optional)
	local c3 = UserInputService.InputBegan:Connect(function(input)
		if GuiService.SelectedObject ~= hit then
			return
		end
		local step = if input.KeyCode == Enum.KeyCode.DPadRight or input.KeyCode == Enum.KeyCode.Right then 0.05 elseif input.KeyCode == Enum.KeyCode.DPadLeft or input.KeyCode == Enum.KeyCode.Left then -0.05 else 0
		if step ~= 0 then
			v = math.clamp(math.floor((v + step) * 20 + 0.5) / 20, 0, 1)
			show()
			onChange(v, true)
		end
	end)
	hit.Destroying:Connect(function()
		c1:Disconnect()
		c2:Disconnect()
		c3:Disconnect()
	end)
	show()
	return hit, function(nv: number)
		v = math.clamp(nv, 0, 1)
		show()
	end
end

-- ON / OFF switch (green when on). Returns (button, set(on)).
function UI.toggle(parent: Instance, on: boolean, onChange: (boolean) -> (), props: { [string]: any }?): (TextButton, (boolean) -> ())
	local hit = Instance.new("TextButton")
	hit.Name = "Switch"
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.BackgroundTransparency = 1
	hit.Size = UDim2.fromOffset(84, T.Touch)
	apply(hit, props)
	hit.Parent = parent
	local sw = UI.frame(hit, { Name = "Track", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(78, 32) })
	UI.corner(sw, 16)
	UI.stroke(sw, TC.Outline, 2)
	local knob = UI.frame(sw, { Name = "Knob", AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = Color3.fromRGB(245, 245, 245) })
	UI.corner(knob, 13)
	UI.stroke(knob, TC.Outline, 1.5)
	local word = UI.text(sw, "", { Name = "Word", Font = UI.Head, TextSize = T.Small, Outline = "Normal", Size = UDim2.new(0, 42, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
	local state = on
	local function show()
		sw.BackgroundColor3 = if state then TC.Green else TC.Gray
		knob.Position = if state then UDim2.new(1, -29, 0.5, 0) else UDim2.new(0, 3, 0.5, 0)
		word.Text = if state then "ON" else "OFF"
		word.Position = if state then UDim2.fromOffset(6, 0) else UDim2.new(1, -46, 0, 0)
	end
	local function flip()
		Audio.button()
		state = not state
		show()
		onChange(state)
	end
	hit.Activated:Connect(flip)
	touchPad(hit, flip)
	show()
	return hit, function(v: boolean)
		state = v
		show()
	end
end

-- Small tinted pill with text (rarity, status).
function UI.chip(parent: Instance, text: string, color: Color3, props: { [string]: any }?): Frame
	local f = UI.frame(parent, { Size = UDim2.fromOffset(96, 24), BackgroundColor3 = color })
	apply(f, props)
	UI.corner(f, T.Radius)
	UI.stroke(f, TC.Outline, 1.5)
	UI.text(f, text, { Name = "Text", Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0), TextSize = T.Tiny, Font = UI.Bold, Outline = "Normal", TextXAlignment = Enum.TextXAlignment.Center })
	return f
end

UI.ScrollBar = 6
UI.ScrollBarColor = if Theme.PetStyle then PET.Blue else Color3.fromRGB(24, 38, 82)

-- Scrolling area that grows with its content.
function UI.scroller(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local s = Instance.new("ScrollingFrame")
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	-- a dark navy bar, solid: it reads on cream, sky and gold panels alike (gold on a yellow-brown list vanished)
	s.ScrollBarThickness = UI.ScrollBar
	s.ScrollBarImageColor3 = UI.ScrollBarColor
	s.ScrollBarImageTransparency = 0
	s.VerticalScrollBarInset = Enum.ScrollBarInset.Always
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.CanvasSize = UDim2.new()
	s.Size = UDim2.fromScale(1, 1)
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	apply(s, props)
	s.Parent = parent
	return s
end

-- Sizes a scroller's canvas from its list layout instead of AutomaticCanvasSize (which Studio left short of the last
-- quest card, so it could not be scrolled fully into view): content + padding + `extra` (a card gap under the last
-- card, UiMotion.canvasHeight). Re-measured whenever the content or the scale changes.
function UI.fitCanvas(sc: ScrollingFrame, layout: UIListLayout, extra: number?)
	sc.AutomaticCanvasSize = Enum.AutomaticSize.None
	local function fit()
		local pad = sc:FindFirstChildOfClass("UIPadding")
		local top = if pad then pad.PaddingTop.Offset else 0
		local bottom = if pad then pad.PaddingBottom.Offset else 0
		local content = layout.AbsoluteContentSize.Y / math.max(UI.Scale, 0.01)
		sc.CanvasSize = UDim2.fromOffset(0, UiMotion.canvasHeight(content, top, bottom, extra))
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fit)
	sc:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	fit()
end

-- How much shorter (logical px) a scroll window should be (its height now plus `extra`) so that, scrolled to the top,
-- it ends on a whole row instead of cutting one mid-way (UiKit.snapCut over the bottoms of `sc`'s visible children). The panel
-- shows the strip it frees as bottom padding.
function UI.rowCut(sc: ScrollingFrame, extra: number?): number
	-- px per logical px right now: the layer's UIScale times any UIScale above (a menu's pop-in spring)
	local k = math.max(UI.Scale, 0.01)
	local a = sc.Parent
	while a and not a:IsA("ScreenGui") do
		local u = a:FindFirstChildOfClass("UIScale")
		if u and u.Scale > 0.01 then
			k *= u.Scale
		end
		a = a.Parent
	end
	local window = sc.AbsoluteWindowSize.Y / k + (extra or 0)
	local top = sc.AbsolutePosition.Y
	local bottoms: { number } = {}
	local heights: { number } = {}
	for _, c in sc:GetChildren() do
		if c:IsA("GuiObject") and c.Visible and c.AbsoluteSize.Y > 0 then
			table.insert(bottoms, (c.AbsolutePosition.Y + c.AbsoluteSize.Y - top) / k + sc.CanvasPosition.Y + 2)
			table.insert(heights, c.AbsoluteSize.Y / k)
		end
	end
	return UiKit.snapCut(bottoms, window, nil, heights)
end

-- Keeps a scroller's window ending on a whole row (UI.rowCut / UiKit.snapCut) instead of cutting one mid-way under a
-- footer, and gives its canvas at least `bottomPad` px of bottom padding (the height of whatever sits over the
-- bottom) so the last row can always scroll fully into view. Re-measured when the canvas or window changes.
function UI.endOnRow(sc: ScrollingFrame, bottomPad: number?)
	local base = sc.Size
	local cut = 0
	local busy = false
	local pad = sc:FindFirstChildOfClass("UIPadding")
	if pad and bottomPad and pad.PaddingBottom.Offset < bottomPad then
		pad.PaddingBottom = UDim.new(0, bottomPad)
	end
	local function measure()
		if busy or sc.AbsoluteWindowSize.Y <= 0 then
			return
		end
		busy = true
		local want = UI.rowCut(sc, cut)
		if want ~= cut then
			cut = want
			sc.Size = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, base.Y.Offset - cut)
		end
		busy = false
	end
	sc:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(function()
		task.defer(measure)
	end)
	sc:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(function()
		task.defer(measure)
	end)
	task.defer(measure)
end

-- A row inside a list layout (fixed height, full width).
function UI.row(parent: Instance, height: number, order: number, props: { [string]: any }?): Frame
	local f = UI.frame(parent, { Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, LayoutOrder = order })
	apply(f, props)
	return f
end

-- Input stack ----------------------------------------------------------------------------------
-- UI.block(key, on) holds gameplay input while any key is present (menus, dialogs, the reveal, results).
-- CameraMode listens (free cursor, suspended look / move, hidden touch controls) and restores first person once
-- when the last key goes.

UI.ModalChanged = Instance.new("BindableEvent") -- (name or nil): the primary menu
UI.BlockChanged = Instance.new("BindableEvent") -- (blocked)
local blockers: { [string]: true } = {}
local lastUnblocked = -math.huge

-- os.clock() of the moment the last blocking key was released (set synchronously, so an input that arrives in the
-- same frame as the close is already inside the grace window; CameraMode.mayAct reads it).
function UI.unblockedAt(): number
	return lastUnblocked
end

function UI.block(key: string, on: boolean)
	local was = next(blockers) ~= nil
	if on then
		blockers[key] = true
	else
		blockers[key] = nil
	end
	local blocked = next(blockers) ~= nil
	if was and not blocked then
		lastUnblocked = os.clock()
	end
	pcall(function()
		GuiService.TouchControlsEnabled = not blocked
	end)
	UI.BlockChanged:Fire(blocked)
end

function UI.blocked(): boolean
	return next(blockers) ~= nil
end

-- Modal shell ------------------------------------------------------------------------------------

local function shadeButton(root: Instance, name: string, transparency: number): TextButton
	local shade = Instance.new("TextButton")
	shade.Name = name
	shade.Text = ""
	shade.AutoButtonColor = false
	shade.BackgroundColor3 = TC.Shade
	shade.BackgroundTransparency = transparency
	shade.Size = UDim2.fromScale(1, 1)
	shade.Selectable = false
	shade.Parent = root
	return shade
end

-- Gamepad: navigation stays inside the panel and the first control is selected when the last input was a gamepad.
local function gamepadFocus(panel: GuiObject, isOpen: () -> boolean)
	pcall(function()
		panel.SelectionGroup = true
		panel.SelectionBehaviorUp = Enum.SelectionBehavior.Stop
		panel.SelectionBehaviorDown = Enum.SelectionBehavior.Stop
		panel.SelectionBehaviorLeft = Enum.SelectionBehavior.Stop
		panel.SelectionBehaviorRight = Enum.SelectionBehavior.Stop
	end)
	task.defer(function()
		pcall(function()
			if not isOpen() then
				return
			end
			if string.sub(UserInputService:GetLastInputType().Name, 1, 7) == "Gamepad" then
				local first: GuiObject? = nil
				for _, d in panel:GetDescendants() do
					if d:IsA("GuiButton") and d.Selectable and d.Name ~= "Close" and d.Name ~= "Hit" then
						first = d
						break
					end
				end
				if first then
					GuiService.SelectedObject = first
				end
			end
		end)
	end)
end

local function clearSelectionIn(root: Instance)
	pcall(function()
		local sel = GuiService.SelectedObject
		if sel and sel:IsDescendantOf(root) then
			GuiService.SelectedObject = nil
		end
	end)
end

-- Header: title on the left (display font, strong outline), optional cash readout, red close on the right.
-- Returns (header, setCash or nil, title label).
-- The shortest landscape phones (about 310 px tall: under 395 logical) get a compact header and title tab, and a
-- thinner outer margin, so the kit rim does not eat the menu's content.
function UI.compactMenus(): boolean
	return not UI.isPortrait() and UI.Logical.Y < 395 -- same cut as the panels' own "tight" layouts (ShopPanel, QuestPanel)
end
-- Height of the gold title tab that sits on a menu's top edge (PanelSkin).
function UI.headerTab(): number
	return if UI.compactMenus() then 46 else 56
end

local function headerHeight(): number
	return if UI.compactMenus() then 44 else 54
end
local function header(panel: Frame, title: string, opts: { [string]: any }, close: () -> ()): (Frame, ((number) -> ())?, TextLabel)
	local h = UI.frame(panel, { Name = "Header", Size = UDim2.new(1, 0, 0, headerHeight()), BackgroundTransparency = 1 })
	local right = if opts.NoClose then 12 else TS.Close + 18
	local cashW = if opts.Cash then 118 else 0
	local t: TextLabel
	if Theme.PetStyle then
		-- the clip's menus: the title floats over the sheet's top edge at the left (centred: over the middle), white
		-- with a deep blue edge and a dark copy under it; the red X sits on the top right corner, a little tilted
		local tw = UDim2.new(1, -(28 + right + cashW + 6), 0, 40)
		local tp = { Name = "Title", Font = UI.Head, TextSize = T.Title + 2, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromOffset(14, 18), Size = tw, ZIndex = 3, TextXAlignment = if opts.Center then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left }
		if opts.Center then
			tp.Position = UDim2.fromOffset(0, 18)
			tp.Size = UDim2.new(1, 0, 0, 40)
		end
		local sp = table.clone(tp)
		sp.Name = "TitleShadow"
		sp.Position = tp.Position + UDim2.fromOffset(0, 3)
		sp.TextColor3 = PET.TitleShadow
		sp.ZIndex = 2
		local shadow = UI.text(h, UI.titleCase(title), sp)
		shadow.TextWrapped = false
		local so = shadow:FindFirstChild("Outline")
		if so and so:IsA("UIStroke") then
			so.Color = PET.TitleShadow
			so.Thickness = 4
		end
		t = UI.text(h, UI.titleCase(title), tp)
		t.TextWrapped = false
		local o = t:FindFirstChild("Outline")
		if o and o:IsA("UIStroke") then
			o.Color = PET.TitleEdge
			o.Thickness = 3.4
		end
		t:GetPropertyChangedSignal("Text"):Connect(function()
			-- panels that retitle themselves ("PARTY 2/4") keep the mixed case and the dark copy in step
			local want = UI.titleCase(t.Text)
			if want ~= t.Text then
				t.Text = want
				return
			end
			shadow.Text = t.Text
		end)
	else
		t = UI.text(h, title, { Name = "Title", Font = UI.Head, TextSize = T.Title, Position = UDim2.fromOffset(16, 6), Size = UDim2.new(1, -(16 + right + cashW + 6), 0, 44), TextXAlignment = if opts.Center then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left })
		t.TextWrapped = false
	end
	local setCash: ((number) -> ())? = nil
	if opts.Cash then
		local _, set = UI.cash(h, 24, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -(right + 2), if Theme.PetStyle then 0 else 0.5, if Theme.PetStyle then 14 else 2), Size = UDim2.fromOffset(cashW, 24) })
		setCash = set
	end
	if not opts.NoClose then
		if Theme.PetStyle then
			UI.closeButton(h, close, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -10, 0, 4), Rotation = 4, ZIndex = 4 })
		else
			UI.closeButton(h, close, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 2) })
		end
	end
	return h, setCash, t
end

export type ModalOpts = {
	Dismissable: boolean?, -- tap outside closes (default true)
	Footer: number?, -- height reserved for footer buttons (returned as the 4th value)
	Fixed: boolean?, -- body is a plain Frame (the panel does its own scrolling)
	Subtitle: string?, -- one short line under the title
	NoClose: boolean?, -- no X (the panel offers its own way out)
	Cash: boolean?, -- cash readout in the header (UI.modalCash sets it)
	Center: boolean?, -- centred title
}

local current: { Close: () -> (), Name: string, SetCash: ((number) -> ())?, Panel: Frame, HeaderH: number }? = nil

-- Panel blur: a BlurEffect on the camera (a camera effect, Lighting is never touched) softens the world while a
-- menu is open. Closing one menu and opening the next in the same frame keeps it on.
local blurOn = false
local function setBlur(on: boolean)
	blurOn = on
	task.defer(function()
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local b = cam:FindFirstChild("MenuBlur") :: BlurEffect?
		if not b then
			if not blurOn then
				return
			end
			local n = Instance.new("BlurEffect")
			n.Name = "MenuBlur"
			n.Size = 0
			n.Parent = cam
			b = n
		end
		local blur = b :: BlurEffect
		local goal = if blurOn then Theme.Motion.Blur else 0
		if UI.Reduced then
			blur.Size = goal
		else
			TweenService:Create(blur, TweenInfo.new(Theme.Motion.BlurIn), { Size = goal }):Play()
		end
	end)
end
-- Closing a menu or dialog: the panel shrinks away (ease in, slightly past small) while the shade fades, then
-- both are destroyed. Input is cut at once so a tap during the shrink reaches nothing. Reduce Motion: instant.
local function shrinkAway(shade: GuiObject, panel: GuiObject)
	if UI.Reduced then
		shade:Destroy()
		return
	end
	shade.Name = "Closing" -- lookups by name never find the panel on its way out
	shade.Active = false
	shade.Interactable = false
	panel.Interactable = false
	local t = Theme.Motion.PanelShrink
	TweenService:Create(shade, TweenInfo.new(t), { BackgroundTransparency = 1 }):Play()
	local sc = panel:FindFirstChild("Enter") :: UIScale?
	if not sc then
		local n = Instance.new("UIScale")
		n.Name = "Enter"
		n.Parent = panel
		sc = n
	end
	local s = sc :: UIScale
	spr.stop(s)
	TweenService:Create(s, TweenInfo.new(t, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = Theme.Motion.PanelShrinkTo }):Play()
	task.delay(t + 0.05, function()
		shade:Destroy()
	end)
end
-- Keeps the notification column clear of open menu headers (defined with the notifications below).
local fitNotices: () -> () = function() end

-- The one primary menu. Opening one closes the previous one (and any dialog over it). Returns
-- (panel, body, close, footer). Sizes are min(available, wanted) so the panel always fits the safe area.
local MODAL_TOPLEFT_CLEAR = 130 -- studs from the screen's left edge that Roblox's menu + chat buttons occupy
local MODAL_TAB_DROP = 16 -- extra top gap that keeps the gold title tab off those buttons
-- how far the gold title tab (PanelSkin: centred 4 px below the header top, UI.headerTab() tall, 3 px edge) rises
-- above the header
local function tabOverhang(): number
	return UI.headerTab() / 2 - 4 + 3
end
function UI.modal(name: string, title: string, size: Vector2, opts: ModalOpts?): (Frame, any, () -> (), Frame?)
	UI.closeDialog()
	if current then
		current.Close()
	end
	local o: ModalOpts = opts or {}
	local root = UI.overlay()
	local shade = shadeButton(root, "Modal_" .. name, 0.5)
	-- upright phones: the panel spans the width, so it starts under Roblox's top bar buttons (menu, chat) and keeps
	-- 16 px from the bottom edge
	local ok, tl = pcall(function()
		return (GuiService:GetGuiInset())
	end)
	local insetY = if ok and typeof(tl) == "Vector2" then tl.Y else 0
	local topGap = 0
	if UI.isPortrait() then
		topGap = math.max(insetY / math.max(UI.Scale, 0.1), 44) + 30 -- + room for the gold title tab that sits half above the panel
	end
	if topGap == 0 and (UI.Logical.X - size.X) / 2 < MODAL_TOPLEFT_CLEAR then
		-- a narrow landscape phone: the panel's left edge (and the gold title tab that sticks out above it) sits under
		-- Roblox's menu and chat buttons at the top left, so the panel starts lower
		topGap = MODAL_TAB_DROP
	end
	local panel = UI.frame(shade, {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, topGap / 2),
		Size = UDim2.new(1, -24, 1, if topGap > 0 then -(topGap + 16) else -12),
		BackgroundColor3 = TC.Panel,
		Active = true,
	})
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = size
	limit.Parent = panel
	UI.corner(panel, T.RadiusLg)
	UI.stroke(panel, if Theme.PetStyle then TC.PanelRim else TC.PanelEdge, if Theme.PetStyle then 3 else TS.Border)
	UI.panelShade(panel)
	if Theme.PetStyle then
		UI.pattern(panel, PET.PanelPattern, 0.3, 46, size.X, size.Y, 160)
	end
	panel:SetAttribute("KitHeaderOnRim", true)
	UI.kitPanel(panel, "panel_large") -- the kit panel picture (drawn panel while its id is 0)
	-- every header stays inside the safe area (Studio check 2026-10-14: titles were clipped under the Roblox top bar on
	-- a 1434 x 658 window): the gap above the panel covers the GuiInset when this layer ignores it, plus whatever the
	-- header's title tab sticks out above the content rect's top edge
	local kitL, kitTop, kitR, kitB = UI.kitInset(panel)
	-- the content rect keeps the size the panel asked for where the screen has room: the rim comes on top
	limit.MaxSize = size + Vector2.new(kitL + kitR, kitTop + kitB)
	-- (the panel's top sits at least `edge` below the gap: Size leaves 2 * edge and the panel is centred under it)
	local edge = if UI.compactMenus() then 4 else 8
	local safe = UiKit.safeTop(insetY, root.IgnoreGuiInset, UI.Scale, tabOverhang() - kitTop - edge, UiKit.SafeTopMargin)
	if safe > topGap then
		topGap = safe
	end
	if topGap > 0 then
		panel.Position = UDim2.new(0.5, 0, 0.5, topGap / 2)
		panel.Size = UDim2.new(1, -24, 1, -(topGap + 2 * edge))
	end
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		Audio.play("UIWhooshSoft", { Pitch = 0.9, Volume = 0.8, Key = "ui:menuclose" })
		if current and current.Name == name then
			current = nil
		end
		UI.closeDialog()
		UI.block("modal", false)
		clearSelectionIn(shade)
		shrinkAway(shade, panel)
		setBlur(false)
		UI.ModalChanged:Fire(nil)
		fitNotices()
	end
	local _, setCash = header(panel, title, o :: any, close)
	local headerH = headerHeight()
	if o.Subtitle then
		UI.text(panel, o.Subtitle, {
			Name = "Subtitle", Font = UI.Bold, TextSize = T.Body + 1, Outline = "Normal", Position = UDim2.fromOffset(16, headerH - 6), Size = UDim2.new(1, -32, 0, 24),
			TextXAlignment = if o.Center then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left,
		})
		headerH += 22
	end
	local footerH = o.Footer or 0
	local body: GuiObject
	if o.Fixed then
		body = UI.frame(panel, { Name = "Body", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, headerH), Size = UDim2.new(1, 0, 1, -(headerH + footerH)) })
	else
		body = UI.scroller(panel, { Name = "Body", Position = UDim2.fromOffset(0, headerH), Size = UDim2.new(1, 0, 1, -(headerH + footerH)) })
	end
	local bodyPad = UI.pad(body, T.Pad, 6)
	if body:IsA("ScrollingFrame") then
		-- a scroll bar gap: rows stopped right against the bar (Daily list, Studio check 2026-10-14)
		bodyPad.PaddingRight = UDim.new(0, T.Pad + UI.ScrollBar)
	end
	local footer: Frame? = nil
	if footerH > 0 then
		footer = UI.frame(panel, { Name = "Footer", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, footerH), BackgroundTransparency = 1 })
		UI.pad(footer :: Frame, T.Pad, 8)
	end
	shade.Activated:Connect(function()
		if o.Dismissable ~= false then
			close()
		end
	end)
	if not UI.Reduced then
		-- springs in with a small overshoot (Theme.Spring.Panel)
		local s = Instance.new("UIScale")
		s.Name = "Enter"
		s.Scale = Theme.Spring.PanelFrom
		s.Parent = panel
		UI.spring(s, Theme.Spring.Panel, { Scale = 1 })
	end
	setBlur(true)
	Audio.play("UIWhooshSoft", { Volume = 0.8, Key = "ui:menuopen" })
	gamepadFocus(panel, function()
		return not closed and shade.Parent ~= nil
	end)
	current = { Close = close, Name = name, SetCash = setCash, Panel = panel, HeaderH = headerH }
	UI.block("modal", true)
	UI.ModalChanged:Fire(name)
	fitNotices()
	return panel, body, close, footer
end

-- Updates the cash readout of the open menu (when it has one).
function UI.modalCash(n: number)
	if current and current.SetCash then
		current.SetCash(n)
	end
end

-- The open menu's coin readout (where flying coins land while a menu with a cash header is open), or nil.
function UI.modalCashTarget(): GuiObject?
	local head = if current then current.Panel:FindFirstChild("Header") else nil
	local cash = if head then head:FindFirstChild("Cash") else nil
	if cash and cash:IsA("GuiObject") and cash.Visible and cash.AbsoluteSize.X > 0 then
		return cash
	end
	return nil
end

-- The open menu's coin readout flashes red and wiggles (tapped something you can't afford yet).
function UI.flashCash()
	local head = if current then current.Panel:FindFirstChild("Header") else nil
	local cash = if head then head:FindFirstChild("Cash") else nil
	local amt = if cash then cash:FindFirstChild("Amount", true) else nil
	if not (cash and cash:IsA("GuiObject") and amt and amt:IsA("TextLabel")) then
		return
	end
	local was = amt:GetAttribute("BaseColor")
	if typeof(was) ~= "Color3" then
		was = amt.TextColor3
		amt:SetAttribute("BaseColor", was)
	end
	amt.TextColor3 = TC.Red
	TweenService:Create(amt, TweenInfo.new(0.6), { TextColor3 = was :: Color3 }):Play()
	if not UI.Reduced then
		cash.Rotation = 6
		TweenService:Create(cash, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	end
end

function UI.closeModal()
	if current then
		current.Close()
	end
end

function UI.modalOpen(): string?
	return if current then current.Name else nil
end

-- A modal panel sized to its content: changes the cap of the panel's size constraint (the panel still shrinks to
-- fit small screens). Used by panels whose views differ a lot in size.
function UI.fitModal(panel: Instance, size: Vector2)
	local lim = panel:FindFirstChildOfClass("UISizeConstraint")
	if lim then
		local l, t, r, b = UI.kitInset(panel)
		lim.MaxSize = size + Vector2.new(l + r, t + b) -- the size is the content rect's; the kit rim comes on top
	end
	fitNotices()
end

-- Confirmation dialogs -------------------------------------------------------------------------------------
-- Stacked above the current menu (its own layer and block key): the menu keeps its state, closing the dialog
-- returns to it. Nothing runs until CONFIRM is activated.
-- opts = { Name, Title, Message, Icon (kind) | Picture (fn(container)), Price (number, shows the cash line),
--          Confirm = "CONFIRM", Cancel = "CANCEL", Style = "gold" | "red", OnConfirm, OnCancel, NoCancel,
--          Sticky (a tap outside or Escape does not close it; only its buttons do) }
local dialog: { Close: () -> (), Cancel: () -> (), Name: string, Panel: Frame, Sticky: boolean? }? = nil

function UI.closeDialog()
	if dialog then
		dialog.Close()
	end
end

function UI.dialogOpen(): string?
	return if dialog then dialog.Name else nil
end

-- What gamepad B / Escape closes: the dialog first, then the menu. On a dialog it is the same as CANCEL or a tap
-- outside: OnCancel runs (a party invite closed with Escape is declined, not left pending; audit 18).
-- UI.closeDialog stays silent (code closing a card it replaces).
function UI.closeTop()
	if dialog and dialog.Sticky then
		return
	end
	if dialog then
		dialog.Cancel()
	elseif current then
		current.Close()
	end
end

function UI.topOpen(): string?
	return if dialog then dialog.Name elseif current then current.Name else nil
end

-- Restylers PanelSkin installs at load (UI cannot require it: PanelSkin requires UI). nil = the plain look.
UI.DialogDress = nil :: ((panel: Frame) -> ())?
UI.NoticeDress = nil :: ((card: Frame, kind: string) -> ())?

function UI.confirm(opts: { [string]: any }): () -> ()
	UI.closeDialog()
	local name = opts.Name or "Confirm"
	local root = UI.dialogLayer()
	local shade = shadeButton(root, "Dialog_" .. name, 0.45)
	shade.Active = not opts.Sticky -- a Sticky dialog ignores taps outside it (an inactive button never fires Activated)
	local w = 420 -- the cap; below it the dialog is (screen - 24) wide
	local hasPic = opts.Icon ~= nil or opts.Picture ~= nil
	-- the message box grows with its text (2 to 5 lines) instead of the fitter shrinking long text to a tiny size
	local msgH = 0
	if type(opts.Message) == "string" then
		local _, breaks = string.gsub(opts.Message, "\n", "")
		msgH = math.clamp(math.max(breaks + 1, math.ceil(#opts.Message / 34)) * 22, 44, 110)
	end
	local inputH = if opts.Input then 48 else 0
	local priceH = if opts.Price then 30 else 0
	local h = 56 + msgH + priceH + inputH + 64
	local panel = UI.frame(shade, {
		Name = "Panel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -24, 0, h), BackgroundColor3 = TC.Panel, Active = true,
	})
	local dlim = Instance.new("UISizeConstraint")
	dlim.MaxSize = Vector2.new(w, h)
	dlim.Parent = panel
	UI.corner(panel, T.RadiusLg)
	UI.stroke(panel, TC.PanelEdge, TS.Border)
	UI.panelShade(panel)
	UI.kitPanel(panel, "panel_small") -- the kit dialog picture (drawn panel while its id is 0)
	do
		-- the content sits inside the kit rim (KitPad): the dialog grows by the rim so its rows keep their room
		local _, kt, _, kb = UI.kitInset(panel)
		if kt + kb > 0 then
			panel.Size = UDim2.new(1, -24, 0, h + kt + kb)
			dlim.MaxSize = Vector2.new(w, h + kt + kb)
		end
	end
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		if dialog and dialog.Name == name then
			dialog = nil
		end
		clearSelectionIn(shade)
		shrinkAway(shade, panel)
		UI.block("dialog", false)
		fitNotices()
	end
	local left = 16
	if hasPic then
		local pic = UI.frame(panel, { Name = "Picture", BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(64, 64) })
		if opts.Picture then
			opts.Picture(pic)
		else
			UI.icon(pic, opts.Icon, 54, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		end
		left = 84
	end
	local t = UI.text(panel, opts.Title or "Are you sure?", { Name = "Title", Font = UI.Head, TextSize = T.Head + 2, Position = UDim2.fromOffset(left, 10), Size = UDim2.new(1, -(left + TS.Close + 18), 0, 36) })
	t.TextWrapped = false
	if not opts.Sticky then -- a Sticky card has one way out (its own buttons), so no red X next to LEAVE
		UI.closeButton(panel, function()
			close()
			if opts.OnCancel then
				opts.OnCancel()
			end
		end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8) })
	end
	local y = 50
	if opts.Message then
		UI.text(panel, opts.Message, { Name = "Message", Font = UI.Bold, TextSize = T.Body, TextColor3 = TC.Muted, Outline = "Light", Position = UDim2.fromOffset(left, y), Size = UDim2.new(1, -(left + 14), 0, msgH), TextYAlignment = Enum.TextYAlignment.Top })
		y += msgH
	end
	if opts.Price then
		local _, set = UI.cash(panel, 22, { Name = "Price", Position = UDim2.fromOffset(left, y + 2), Size = UDim2.fromOffset(170, 24) })
		set(opts.Price)
		y += priceH
	end
	-- opts.Input = { Text, Placeholder, MaxLength }: one text box; OnConfirm receives what was typed
	local box: TextBox? = nil
	if opts.Input then
		local inp = opts.Input
		local tb = Instance.new("TextBox")
		tb.Name = "Input"
		tb.Text = tostring(inp.Text or "")
		tb.PlaceholderText = tostring(inp.Placeholder or "")
		tb.PlaceholderColor3 = TC.Faint
		tb.ClearTextOnFocus = false
		tb.TextColor3 = TC.Text
		tb.Font = UI.Bold
		tb.TextSize = T.Body
		tb.TextXAlignment = Enum.TextXAlignment.Left
		tb.BackgroundColor3 = TC.Inset
		tb.BorderSizePixel = 0
		tb.Position = UDim2.fromOffset(left, y + 4)
		tb.Size = UDim2.new(1, -(left + 14), 0, 40)
		tb.Parent = panel
		UI.corner(tb, T.RadiusSm)
		UI.stroke(tb, TC.InsetEdge, 1.5)
		UI.pad(tb, 10, 0)
		local maxLen = tonumber(inp.MaxLength)
		if maxLen then
			tb:GetPropertyChangedSignal("Text"):Connect(function()
				local n = utf8.len(tb.Text)
				if n and n > maxLen then
					tb.Text = string.sub(tb.Text, 1, (utf8.offset(tb.Text, maxLen + 1) or (#tb.Text + 1)) - 1)
				end
			end)
		end
		box = tb
		y += inputH
	end
	local row = UI.frame(panel, { Name = "Buttons", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -10), Size = UDim2.new(1, -24, 0, 46) })
	UI.list(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	local cb = UI.button(row, opts.Confirm or "CONFIRM", opts.Style or "gold", function()
		local typed = if box then box.Text else nil
		close()
		if opts.OnConfirm then
			opts.OnConfirm(typed)
		end
	end, { Name = "Confirm", Size = UDim2.new(if opts.NoCancel then 1 else 0.5, -5, 1, 0), LayoutOrder = 1 })
	local _ = cb
	if not opts.NoCancel then
		UI.button(row, opts.Cancel or "CANCEL", "gray", function()
			close()
			if opts.OnCancel then
				opts.OnCancel()
			end
		end, { Name = "Cancel", Size = UDim2.new(0.5, -5, 1, 0), LayoutOrder = 2 })
	end
	local function cancel()
		if closed then
			return
		end
		close()
		if opts.OnCancel then
			opts.OnCancel()
		end
	end
	shade.Activated:Connect(cancel)
	if UI.DialogDress then
		UI.DialogDress(panel)
	end
	if not UI.Reduced then
		local s = Instance.new("UIScale")
		s.Name = "Enter"
		s.Scale = Theme.Spring.PanelFrom
		s.Parent = panel
		UI.spring(s, Theme.Spring.Panel, { Scale = 1 })
	end
	gamepadFocus(panel, function()
		return not closed
	end)
	dialog = { Close = close, Cancel = cancel, Name = name, Panel = panel, Sticky = opts.Sticky }
	UI.block("dialog", true)
	fitNotices()
	return close
end

-- Notifications -------------------------------------------------------------------------------------
-- Compact cards at the top centre, above every menu. Coalesced: the same text (or the same `Tag`) refreshes the
-- card already showing instead of stacking another; at most three at a time (the oldest leaves first).
-- kinds: info | ok | warn | cash | geode | material. opts = { Tag, Long (stay longer), Title }
-- Owner picture for the "ok" toast tick (HudArt sets it from the CheckGreen slot once uploaded); nil = drawn tick.
UI.OkPicture = nil :: string?
UI.OkPictureReady = false -- HudArt sets it once the tick picture has been fetched (the toast then shows it at once)

-- success toasts ("Bought!", "Equipped!") are a short confirmation: gone after about 3.5 s with the slide out
local OK_HOLD = 3.2

local KIND_ICON = { ok = "check", warn = "warn", cash = "cash", geode = "egg", material = "egg", basket = "basket", info = nil }
local noticeHolder: Frame? = nil
local noticeSeq = 0

local function holder(): Frame
	if noticeHolder and noticeHolder.Parent then
		return noticeHolder :: Frame
	end
	local root = UI.noticeLayer()
	local f = UI.frame(root, { Name = "Notices", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 64), Size = UDim2.new(1, -24, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 })
	local lim = Instance.new("UISizeConstraint")
	lim.MaxSize = Vector2.new(320, 600) -- small: a phone toast must not cover the player and their name tag
	lim.Parent = f
	UI.list(f, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	noticeHolder = f
	local function refit()
		task.defer(fitNotices)
	end
	f.ChildAdded:Connect(refit)
	f.ChildRemoved:Connect(refit)
	f:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	fitNotices()
	return f
end

-- Moves the notification column (the HUD keeps it under its top bar).
-- `left` / `right` (optional) keep the column between the HUD's side columns (portrait phones).
local noticeBase = { Y = 64, L = 12, R = 12 }
UI.MaxNotices = 3

function UI.placeNotices(y: number, left: number?, right: number?)
	noticeBase = { Y = y, L = left or 12, R = right or 12 }
	fitNotices()
end

-- Logical rectangle (top, height, width) of a centred panel whose size is min(available, its size constraint).
local function panelRect(panel: Frame): (number, number, number)
	local lim = panel:FindFirstChildOfClass("UISizeConstraint")
	local maxS = if lim then lim.MaxSize else Vector2.new(math.huge, math.huge)
	local sz = panel.Size
	local w = math.min(UI.Logical.X * sz.X.Scale + sz.X.Offset, maxS.X)
	local hgt = math.min(UI.Logical.Y * sz.Y.Scale + sz.Y.Offset, maxS.Y)
	return (UI.Logical.Y - hgt) / 2, hgt, w
end

-- Height of the notification column in logical units (cards wrap, so measure when the layout has run).
local function noticeHeight(h: Frame): number
	local n = 0
	for _, c in h:GetChildren() do
		if c:IsA("Frame") then
			n += 1
		end
	end
	if n == 0 then
		return 0
	end
	local sc = h:FindFirstAncestorOfClass("ScreenGui")
	local ui = sc and sc:FindFirstChildOfClass("UIScale")
	local measured = if ui and ui.Scale > 0 then h.AbsoluteSize.Y / ui.Scale else 0
	return math.max(measured, n * 52 - 6)
end

-- Notices never cover an open menu's header (title, cash, X) or a confirmation dialog. Wide screens (PC,
-- tablets) with room beside the menu put the column there, level with the menu top. Otherwise candidate tops, in
-- order: the HUD's own spot (no menu open), the top edge, just under the menu header, just under the dialog;
-- the first one whose column misses every protected band wins. Short phones (the menu fills the height) get the
-- column under the header, over the top of the menu body, where it still has its own X and leaves on its own.
local SIDE_MIN = NoticeLayout.SideMin -- logical width beside a menu that takes the notification column

fitNotices = function()
	local h = noticeHolder
	if not h then
		return
	end
	local l, r = noticeBase.L, noticeBase.R
	local y = noticeBase.Y
	local bands: { { number } } = {}
	local starts: { number } = {}
	local width = math.huge
	if current and current.Panel.Parent then
		local top, _, w = panelRect(current.Panel)
		-- the header and the tab row under it (Pet Book: Book / Records / Stats) stay uncovered
		local head = current.HeaderH + T.Tab + T.Gap * 2
		table.insert(bands, { top - 4, top + head })
		table.insert(starts, 8)
		table.insert(starts, top + head + 4)
		width = w - 24
	end
	local side = 0
	local menuOpen = current ~= nil and current.Panel.Parent ~= nil
	local dialogOpen = dialog ~= nil and dialog.Panel.Parent ~= nil
	local mode = "hud"
	if current and menuOpen then
		local _, _, mw = panelRect(current.Panel)
		mode = NoticeLayout.mode(true, dialogOpen, (UI.Logical.X - mw) / 2)
	end
	if current and mode == "side" then
		local top, _, w = panelRect(current.Panel)
		local gap = (UI.Logical.X - w) / 2
		if gap >= SIDE_MIN then
			side = math.min(gap - 20, 380)
			h:SetAttribute("Top", top)
			h.AnchorPoint = Vector2.new(0, 0)
			-- (pet style: the red X sticks out of the sheet's top right corner, so the stack starts a little lower and
			-- further right)
			h.Position = UDim2.fromOffset((UI.Logical.X + w) / 2 + (if Theme.PetStyle then 22 else 10), top + (if Theme.PetStyle then 18 else 0))
			h.Size = UDim2.new(0, side, 0, 0)
			return
		end
	end
	if dialog and dialog.Panel.Parent then
		local top, hgt, w = panelRect(dialog.Panel)
		table.insert(bands, { top - 4, top + hgt + 4 })
		table.insert(starts, 8)
		table.insert(starts, top + hgt + 8)
		width = math.min(width, math.max(w, 300))
	end
	if current and mode == "corner" then
		-- a menu fills the screen: one narrow card in the top-right corner, just under the menu header
		local top = panelRect(current.Panel)
		local cw = math.min(260, UI.Logical.X - 24)
		h:SetAttribute("Top", top + current.HeaderH + 4)
		h.AnchorPoint = Vector2.new(1, 0)
		h.Position = UDim2.new(1, -12, 0, top + current.HeaderH + 4)
		h.Size = UDim2.new(0, cw, 0, 0)
		return
	end
	if #bands > 0 then
		local need = noticeHeight(h)
		local pick = starts[#starts]
		for _, s0 in starts do
			local clear = s0 + need <= UI.Logical.Y - 8
			for _, b in bands do
				if s0 < b[2] and s0 + need > b[1] then
					clear = false
				end
			end
			if clear then
				pick = s0
				break
			end
		end
		y = pick
		l, r = 12, 12
	end
	h:SetAttribute("Top", y)
	h.AnchorPoint = Vector2.new(0.5, 0)
	h.Position = UDim2.new(0.5, (l - r) / 2, 0, y)
	local wcap = math.min(UI.Logical.X - (l + r), width)
	h.Size = UDim2.new(0, math.max(wcap, 200), 0, 0)
end

local function noticeTag(text: string): string
	return string.lower(text)
end

-- While a fight is on screen (FightCam) toasts wait and show when it ends, so nothing covers the fight (Studio
-- 2026-10-15: "New in your Pet Book" toasts drew over the fight). opts.Fight = true shows one anyway.
local noticesHeld = false
type HeldNotice = { Text: string, Kind: string?, Opts: { [string]: any }?, Tag: string }
local heldNotices: { HeldNotice } = {}
local function noticesWait(): boolean
	return noticesHeld or not PopupGate.free("Toast") -- one rule for every popup (shared/PopupRules)
end
function UI.holdNotices(on: boolean)
	noticesHeld = on
	if not noticesWait() then
		local queue = heldNotices
		heldNotices = {}
		for _, n in queue do
			UI.notify(n.Text, n.Kind, n.Opts)
		end
	end
end

function UI.notify(text: string, kind: string?, opts: { [string]: any }?)
	if type(text) ~= "string" or text == "" then
		return
	end
	local k = kind or "info"
	local o: { [string]: any } = opts or {}
	local tag = o.Tag or noticeTag(text)
	if o.Fight ~= true and noticesWait() then
		for i, n in heldNotices do
			if n.Tag == tag then
				table.remove(heldNotices, i) -- the newest of the same message wins
				break
			end
		end
		table.insert(heldNotices, { Text = text, Kind = kind, Opts = opts, Tag = tag })
		if #heldNotices > 5 then
			table.remove(heldNotices, 1)
		end
		return
	end
	local h = holder()
	UI.Notice:Fire(text, k)
	noticeSeq += 1
	local seq = noticeSeq
	local hold = if o.Long or k == "geode" then Theme.Motion.ToastHoldLong elseif k == "ok" then OK_HOLD else Theme.Motion.ToastHold
	for _, c in h:GetChildren() do
		if c:IsA("Frame") and c:GetAttribute("Tag") == tag then
			-- coalesce: same message again refreshes the card already on screen; the exact same text counts up (x2, x3)
			local label = c:FindFirstChild("Text", true) :: TextLabel?
			local n = if c:GetAttribute("Text") == text then (tonumber(c:GetAttribute("Count")) or 1) + 1 else 1
			c:SetAttribute("Text", text)
			c:SetAttribute("Count", n)
			if label then
				label.Text = if n > 1 then text .. "  x" .. n else text
			end
			c:SetAttribute("Seq", seq)
			c.LayoutOrder = seq
			task.delay(hold, function()
				if c.Parent and c:GetAttribute("Seq") == seq then
					c:Destroy()
				end
			end)
			return
		end
	end
	local icon = KIND_ICON[k]
	-- slot in the column (laid out by the list) holding the visible card, so the card can slide in from the side
	local slot = UI.frame(h, { Name = "Notice", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = seq, BackgroundTransparency = 1 })
	slot:SetAttribute("Tag", tag)
	slot:SetAttribute("Text", text)
	slot:SetAttribute("Kind", k)
	slot:SetAttribute("Seq", seq)
	-- the card is as wide as its words (up to the column width) and centred, so a short notice is one line with no
	-- empty space on its right
	local f = UI.card(slot, "panel", { Name = "Card", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(0, 200, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	local edge = f:FindFirstChild("Border") :: UIStroke?
	if edge and (k == "ok" or k == "geode") then
		edge.Color = TC.Green
		edge.Thickness = 2.5
	elseif edge and k == "warn" then
		edge.Color = TC.Red
		edge.Thickness = 2.5
	end
	local left = 10
	if icon then
		-- drawn icon first; the owner's tick picture sits on top of it and only hides it once the picture has loaded
		-- (a picture that never loads left an empty gap on the toast's left)
		local drawn = UI.icon(f, icon, 24, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0) })
		left = 38
		local pic = UI.OkPicture
		if k == "ok" and pic then
			local img = Instance.new("ImageLabel")
			img.Name = "Icon"
			img.BackgroundTransparency = 1
			img.Image = pic
			img.ScaleType = Enum.ScaleType.Fit
			img.AnchorPoint = Vector2.new(0, 0.5)
			img.Position = UDim2.new(0, 6, 0.5, 0)
			img.Size = UDim2.fromOffset(28, 28)
			-- already fetched (HudArt preloads it): the picture shows from the first frame, no drawn tick first
			-- kept Visible but see-through until loaded (Roblox does not fetch a hidden image)
			img.ImageTransparency = if UI.OkPictureReady then 0 else 1
			drawn.Visible = not UI.OkPictureReady
			img.Parent = f
			local function shown()
				if img.IsLoaded then
					img.ImageTransparency = 0
					drawn.Visible = false
				end
			end
			img:GetPropertyChangedSignal("IsLoaded"):Connect(shown)
			shown()
		end
	end
	local label = UI.text(f, text, { Name = "Text", Font = UI.Bold, TextSize = T.Small, Outline = "Normal", Position = UDim2.fromOffset(left, 0), Size = UDim2.new(1, -(left + 38), 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	label.TextScaled = false
	label.TextSize = T.Small
	local fitC = label:FindFirstChild("Fit")
	if fitC then
		fitC:Destroy()
	end
	-- card width: the text's one-line width plus the icon and X room, capped at the column width (wraps past that)
	local side = left + 38
	local function sizeCard()
		local hw = h.Size.X.Offset
		local maxW = math.max(160, (if hw > 0 then math.min(hw, 320) else 320) - side)
		local need = TextService:GetTextSize(label.Text, T.Small, UI.Bold, Vector2.new(maxW, 1000))
		f.Size = UDim2.new(0, math.ceil(math.min(need.X + 4, maxW)) + side, 0, 0)
	end
	sizeCard()
	label:GetPropertyChangedSignal("Text"):Connect(sizeCard)
	UI.pad(f, 0, 6)
	if UI.NoticeDress then
		UI.NoticeDress(f, k)
	end
	local x = UI.closeButton(f, function()
		slot:Destroy()
	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -5, 0.5, 0), Size = UDim2.fromOffset(28, 28) })
	local _ = x
	-- at most UI.MaxNotices (the HUD lowers it to two during a search): the oldest leaves first
	local cards = {}
	for _, c in h:GetChildren() do
		if c:IsA("Frame") then
			table.insert(cards, c)
		end
	end
	table.sort(cards, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	-- one at a time over an open menu (a 10-egg buy stacked its Pet Book notices over the shop)
	local max = NoticeLayout.maxCards(current ~= nil and current.Panel.Parent ~= nil, UI.MaxNotices)
	while #cards > max do
		local old = table.remove(cards, 1)
		if old then
			old:Destroy()
		end
	end
	if not UI.Reduced then
		-- slides in from the right edge with a small overshoot
		f.Position = UDim2.new(1.5, 40, 0, 0)
		TweenService:Create(f, TweenInfo.new(Theme.Motion.ToastSlide, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0) }):Play()
	end
	task.delay(hold, function()
		if slot.Parent and slot:GetAttribute("Seq") == seq then
			if UI.Reduced then
				slot:Destroy()
				return
			end
			-- slides back out the way it came
			local tw = TweenService:Create(f, TweenInfo.new(Theme.Motion.Toast, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(1.5, 40, 0, 0) })
			tw.Completed:Connect(function()
				slot:Destroy()
			end)
			tw:Play()
		end
	end)
end

-- Removes notifications whose tag starts with `prefix` ("" = all).
function UI.dismissNotices(prefix: string)
	local h = noticeHolder
	if not h then
		return
	end
	for _, c in h:GetChildren() do
		local t = c:GetAttribute("Tag")
		if c:IsA("Frame") and type(t) == "string" and string.sub(t, 1, #prefix) == prefix then
			c:Destroy()
		end
	end
end

-- Texts of the notifications on screen (checks).
function UI.noticeTexts(): { string }
	local out = {}
	local h = noticeHolder
	if h then
		for _, c in h:GetChildren() do
			local l = c:FindFirstChild("Text", true)
			if l and l:IsA("TextLabel") then
				table.insert(out, l.Text)
			end
		end
	end
	return out
end

-- big cards come one at a time: a menu or another big card on screen keeps the next one waiting (shared/PopupRules)
PopupGate.onScreen = function(): boolean
	if current ~= nil then
		return true
	end
	local d = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
	local layerGui = d and d:FindFirstChild("CrackTheRocksDialog")
	if layerGui then
		for _, n in PopupRules.Cards do
			if layerGui:FindFirstChild(n) then
				return true
			end
		end
	end
	return false
end

-- held toasts show as soon as the popup gate frees (a fight or tower climb ended)
PopupGate.Changed.Event:Connect(function()
	if #heldNotices > 0 and not noticesWait() then
		UI.holdNotices(noticesHeld)
	end
end)

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="383">
            <Properties>
              <string name="Name">UiJuice</string>
              <string name="Source"><![CDATA[--!strict
-- UI juice primitives shared by every panel and the HUD (the 2026-10-14 juice pass). UI.luau wires them into its
-- builders (buttons, cards, red dots, tab bars, cash readouts); Juice.luau builds the bigger effects (coin flights)
-- on top. Only TweenService: nothing here runs a per-frame loop while the screen is idle (a running tween is the
-- engine's job and stops on its own; the claim glow is one repeating tween on a stroke).
-- Reduce Motion (the game setting UI.Reduced, or Roblox's own ReducedMotion) skips every motion: the end state is
-- set at once. Pure numbers live in shared/UiMotion (tested offline).

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UiMotion = require(Shared.UiMotion)
local Theme = require(script.Parent.Theme)

local UiJuice = {}

-- UI installs the game's Reduce Motion flag here (UI requires this module, not the other way round).
UiJuice.gameReduced = function(): boolean
	return false
end

local function systemReduced(): boolean
	local ok, v = pcall(function()
		return (settings() :: any).ReducedMotion
	end)
	return ok and v == true
end

-- True when effects should be skipped (either reduced-motion setting is on).
function UiJuice.still(): boolean
	return not UiMotion.animate(UiJuice.gameReduced(), systemReduced())
end

-- Card shine: one white band sweeps across `obj` once (hover or select), then the band is removed. Rounded like
-- the card, on top of its picture, never takes input.
function UiJuice.sweep(obj: GuiObject, radius: number?)
	if UiJuice.still() or not obj.Parent or obj:FindFirstChild("Sweep") then
		return
	end
	local f = Instance.new("Frame")
	f.Name = "Sweep"
	f.BackgroundColor3 = Theme.Fx.Shine
	f.BorderSizePixel = 0
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = obj.ZIndex + 6
	f.Active = false
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	c.Parent = f
	local g = Instance.new("UIGradient")
	g.Rotation = 25
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.4, 1),
		NumberSequenceKeypoint.new(0.5, 0.45),
		NumberSequenceKeypoint.new(0.6, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	g.Offset = Vector2.new(-1.1, 0)
	g.Parent = f
	f.Parent = obj
	local tw = TweenService:Create(g, TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Offset = Vector2.new(1.1, 0) })
	tw.Completed:Connect(function()
		f:Destroy()
	end)
	tw:Play()
end

-- Claimable glow: a ring frame over `b` whose stroke breathes (thicker and fainter, back again) while `b` exists.
-- Its own frame, so the button's border stroke stays as UI.paint draws it. Static ring under reduced motion.
function UiJuice.pulse(b: GuiObject, color: Color3?, radius: number?): Frame
	local old = b:FindFirstChild("ClaimGlow")
	if old and old:IsA("Frame") then
		return old
	end
	local ring = Instance.new("Frame")
	ring.Name = "ClaimGlow"
	ring.BackgroundTransparency = 1
	ring.BorderSizePixel = 0
	ring.Size = UDim2.fromScale(1, 1)
	ring.ZIndex = b.ZIndex
	ring.Active = false
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	c.Parent = ring
	local st = Instance.new("UIStroke")
	st.Color = color or Color3.fromRGB(255, 236, 130)
	st.Thickness = 3
	st.Transparency = 0.15
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = ring
	ring.Parent = b
	if not UiJuice.still() then
		TweenService:Create(st, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Thickness = 6, Transparency = 0.6 }):Play()
	end
	return ring
end

-- Red-dot wiggle: the badge tilts and springs back (elastic) when it appears or its number changes. Rotation only,
-- so it never fights the appear pop (scale) or the idle hop (position).
function UiJuice.wiggle(obj: GuiObject)
	if UiJuice.still() then
		obj.Rotation = 0
		return
	end
	obj.Rotation = -22
	TweenService:Create(obj, TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
end

-- Tab switch: freshly built content starts `dx` studs to the side (UiMotion.slideFrom: the side of the tab that was
-- tapped) and glides home.
function UiJuice.slideIn(objs: { GuiObject }, dx: number)
	if dx == 0 or UiJuice.still() then
		return
	end
	local info = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, c in objs do
		local to = c.Position
		c.Position = to + UDim2.fromOffset(dx, 0)
		TweenService:Create(c, info, { Position = to }):Play()
	end
end

-- Number counter: `label` counts from `from` to `to` (up or down) over `duration` seconds, text from `fmt`. One
-- tween per label (a new value cancels the running count and starts from what is shown). Reduce Motion: instant.
local counting: { [TextLabel]: Tween } = {}
function UiJuice.countTo(label: TextLabel, from: number, to: number, fmt: (number) -> string, duration: number?)
	local running = counting[label]
	if running then
		running:Cancel()
		counting[label] = nil
	end
	if from == to or UiJuice.still() then
		label.Text = fmt(to)
		return
	end
	local a = Instance.new("NumberValue")
	a.Value = 0
	a.Changed:Connect(function(v: number)
		if label.Parent then
			label.Text = fmt(UiMotion.countValue(from, to, v))
		end
	end)
	local tw = TweenService:Create(a, TweenInfo.new(duration or 0.45, Enum.EasingStyle.Linear), { Value = 1 })
	counting[label] = tw
	tw.Completed:Connect(function(state: Enum.PlaybackState)
		if counting[label] == tw then
			counting[label] = nil
		end
		if state == Enum.PlaybackState.Completed and label.Parent then
			label.Text = fmt(to)
		end
		a:Destroy()
	end)
	label.Text = fmt(from)
	tw:Play()
end

return UiJuice
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="384">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
