	m.Name = modelName
	for _, row in KITS[name].parts do
		local p = s[row[1]]:Clone()
		local off, size = row[3], row[4]
		p.Name = row[2]
		p.TextureID = ""
		p.Size = Vector3.new(size[1] * sv.X, size[2] * sv.Y, size[3] * sv.Z)
		p.CFrame = cf * CFrame.new(off[1] * sv.X, off[2] * sv.Y, off[3] * sv.Z) * FLIP
		local ok, mat = pcall(function()
			return (Enum.Material :: any)[row[5]]
		end)
