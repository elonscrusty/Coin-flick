-- Import 3D brings each mesh in turned 180 degrees about its own centre; FLIP turns it back
-- (set to CFrame.identity if a piece ever shows its back).
local FLIP = CFrame.Angles(0, math.pi, 0)

local TowerRoomKit = {}

local sources: { [string]: MeshPart }? = nil
local function src(): { [string]: MeshPart }
	if sources then
		return sources
	end
	local found: { [string]: MeshPart } = {}
	local root = ServerStorage:FindFirstChild("TowerRoomKit")
	if root then
		for _, d in root:GetDescendants() do
			if d:IsA("MeshPart") then
				local base = string.gsub(d.Name, "%.%d+$", "")
				found[base] = found[base] or d
			end
		end
	end
	sources = found
	return found
end

function TowerRoomKit.has(name: string): boolean
	local k = KITS[name]
	if not k then
		return false
	end
	local s = src()
	for _, row in k.parts do
		if not s[row[1]] then
			return false
		end
	end
	return true
end

-- natural size in studs
function TowerRoomKit.size(name: string): Vector3
	local s = KITS[name].size
	return Vector3.new(s[1], s[2], s[3])
end

-- cf = base centre on the floor (its -Z is the front), scale = number (uniform) or Vector3 (per axis).
