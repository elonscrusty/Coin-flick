		p.Color = Color3.fromHex(row[6])
		p.Anchored = true
		local solid = solidRoles ~= nil and solidRoles[row[2]] == true
		p.CanCollide = solid
		p.CanQuery = solid
		p.CanTouch = false
		p.CastShadow = p.Size.Magnitude > 4
		p.Parent = m
	end
	m.Parent = parent
	return m
end

