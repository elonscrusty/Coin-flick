--!strict
-- Loads the uploaded meshes at boot (InsertService) into ReplicatedStorage.Assets. Anything not uploaded
-- (id 0) or that fails to load (Studio without asset access, offline preview) is simply absent, and the
-- procedural Part stand-ins in GeodeModel / WorldBuilder / StationModels are used instead.
--
-- Two kinds of asset (ids in shared/MeshIds, generated by tools/gen_mesh_catalog.py):
--   * Legacy single meshes (CT_Rocks_*, tools/gen_meshes.py): one MeshPart template each,
--     ReplicatedStorage.Assets.<Name>; its pivot is the mesh file's origin.
--   * Blender kit models (blender/build.py, listed in shared/MeshCatalog): one Model each,
--     ReplicatedStorage.Assets.Kit.<Name>. The uploaded FBX holds one uncoloured mesh per piece; this
--     service paints every MeshPart from the catalog (Color, Material, Transparency), places it at its
--     recorded offset from the model origin, and adds an invisible anchored Root part at the origin
--     (PrimaryPart, WorldPivot = origin) carrying one Attachment per catalog Attach point. Animated
--     pieces get attributes Anim (string) and Pivot (Vector3, joint relative to the piece centre).
--     Clone the Model and PivotTo the wanted floor-centre CFrame. Model attributes: Sheet, Ready.
-- Convention: studs, +Y up, front -Z, origin = floor centre unless the catalog's Origin says otherwise.

local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MeshIds = require(Shared:WaitForChild("MeshIds")) :: { [string]: number }
local MeshCatalog = require(Shared:WaitForChild("MeshCatalog"))

local MeshService = {}

local RETRIES = 3
local OPTIONAL_PIECES: { [string]: boolean } = { Fill = true }
local pendingCount = 0 -- assets still loading
local started = false

local MATERIALS: { [string]: Enum.Material } = {
	SmoothPlastic = Enum.Material.SmoothPlastic,
	Plastic = Enum.Material.Plastic,
	Metal = Enum.Material.Metal,
	DiamondPlate = Enum.Material.DiamondPlate,
	Wood = Enum.Material.Wood,
	WoodPlanks = Enum.Material.WoodPlanks,
	Glass = Enum.Material.Glass,
	Neon = Enum.Material.Neon,
	Slate = Enum.Material.Slate,
	Concrete = Enum.Material.Concrete,
	Rock = Enum.Material.Rock,
	Rubber = Enum.Material.Rubber,
}

local function vec(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

local function fetch(name: string, id: number): Instance?
	for attempt = 1, RETRIES do
		local ok, result = pcall(function()
			return InsertService:LoadAsset(id)
		end)
		if ok and result then
			return result :: Instance
		end
		if attempt < RETRIES then
			task.wait(attempt)
		else
			warn(("[MeshService] %s (%d) failed to load: %s"):format(name, id, tostring(result)))
		end
	end
	return nil
end

local function strip(p: BasePart)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
end

-- Legacy single-mesh template.
local function loadLegacy(name: string, id: number): BasePart?
	local asset = fetch(name, id)
	if not asset then
		return nil
	end
	local found: BasePart? = nil
	for _, d in asset:GetDescendants() do
		if d:IsA("MeshPart") then
			found = d
			break
		end
	end
	local clone = if found then found:Clone() else nil
	asset:Destroy()
	if not clone then
		warn(("[MeshService] %s (%d) loaded but holds no MeshPart"):format(name, id))
		return nil
	end
	clone.Name = name
	strip(clone)
	return clone
end

-- Blender kit model: rebuild the uploaded pieces as a coloured Model around an origin Root part.
local function loadKit(name: string, id: number, entry: MeshCatalog.Model): Model?
	local asset = fetch(name, id)
	if not asset then
		return nil
	end
	local byName: { [string]: MeshPart } = {}
	for _, d in asset:GetDescendants() do
		if d:IsA("MeshPart") then
			local clean = string.gsub(d.Name, "%.%d+$", "")
			if not byName[clean] then
				byName[clean] = d
			end
		end
	end
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("Sheet", entry.Sheet)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.CFrame = CFrame.new()
	strip(root)
	root.Parent = model
	for pointName, p in entry.Attach do
		local a = Instance.new("Attachment")
		a.Name = pointName
		a.Position = vec(p)
		a.Parent = root
	end
	local missing = 0
	for _, piece in entry.Pieces do
		local mesh = byName[piece.Name]
		if not mesh then
			if OPTIONAL_PIECES[piece.Name] then
				-- cosmetic fill pieces that the uploaded FBX does not contain (Station_RubbleBin.Fill:
				-- the game fills the bin itself); the rest of the model is still usable
				continue
			end
			missing += 1
			warn(("[MeshService] %s is missing piece %s"):format(name, piece.Name))
			continue
		end
		local part = mesh:Clone()
		for _, child in part:GetChildren() do
			child:Destroy() -- imported welds / attachments / SurfaceAppearance
		end
		part.Name = piece.Name
		strip(part)
		part.CastShadow = true
		part.TextureID = ""
		part.Color = piece.Color
		part.Material = MATERIALS[piece.Material] or Enum.Material.SmoothPlastic
		part.Transparency = piece.Transparency or 0
		-- The FBX node may carry the Y-up axis rotation over Z-up vertex data. If the importer kept it on
		-- the MeshPart instead of baking it, keep that rotation and express the catalog size in its axes.
		local rot = mesh.CFrame.Rotation
		local size = vec(piece.Size)
		if rot.UpVector.Y < 0.99 then
			local v = rot:VectorToObjectSpace(size)
			size = Vector3.new(math.abs(v.X), math.abs(v.Y), math.abs(v.Z))
			part:SetAttribute("ImportRotation", rot)
		end
		part.Size = size
		part.CFrame = CFrame.new(vec(piece.Offset)) * rot
		if piece.Anim then
			part:SetAttribute("Anim", piece.Anim)
		end
		if piece.Pivot then
			part:SetAttribute("Pivot", vec(piece.Pivot))
		end
		part.Parent = model
	end
	asset:Destroy()
	if missing > 0 then
		model:Destroy()
		return nil
	end
	model.PrimaryPart = root
	model.WorldPivot = CFrame.new()
	model:SetAttribute("Ready", true)
	return model
end

local function ensureFolder(parent: Instance, name: string): Instance
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Template Model for a Blender kit asset (ReplicatedStorage.Assets.Kit.<name>), or nil when absent.
function MeshService.kit(name: string): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local kit = assets and assets:FindFirstChild("Kit")
	local m = kit and kit:FindFirstChild(name)
	if m and m:IsA("Model") and m:GetAttribute("Ready") then
		return m
	end
	return nil
end

-- Loads every uploaded template in parallel; returns how many arrived. Safe to call once at boot.
function MeshService.start(): number
	if started then
		return 0
	end
	started = true
	local folder = ensureFolder(ReplicatedStorage, "Assets")
	local kitFolder = ensureFolder(folder, "Kit")
	local catalog = MeshCatalog :: { [string]: MeshCatalog.Model }
	local loaded = 0
	for name, id in MeshIds do
		local entry = catalog[name]
		local target = if entry then kitFolder else folder
		if id > 0 and not target:FindFirstChild(name) then
			pendingCount += 1
			task.spawn(function()
				local ok, res = pcall(function(): Instance?
					return if entry then loadKit(name, id, entry) else loadLegacy(name, id)
				end)
				local inst: Instance? = if ok then res else nil
				if not ok then
					warn(("[MeshService] %s failed: %s"):format(name, tostring(res)))
				end
				if inst then
					inst.Parent = target
					loaded += 1
				end
				pendingCount -= 1
			end)
		end
	end
	-- wait briefly so the first lobby build sees the templates; stragglers still appear later
	local waited = 0
	while pendingCount > 0 and waited < 8 do
		task.wait(0.25)
		waited += 0.25
	end
	return loaded
end

-- Waits (at most `timeout` seconds, never errors) until every asset that was started has either
-- loaded or failed; true when nothing is pending. Callers that build kit-based models (arenas)
-- use it so the first build after boot does not fall back to Parts just because a load was slow.
function MeshService.waitReady(timeout: number?): boolean
	local limit = timeout or 5
	local waited = 0
	while pendingCount > 0 and waited < limit do
		task.wait(0.25)
		waited += 0.25
	end
	return pendingCount <= 0
end

return MeshService
